#!/usr/bin/env bash
# opencode-dev — OpenCode with approvals heavily reduced, confined in a Linux
# container whose only path to the internet is a proxy it cannot reconfigure.
# The boundary, its limits and the platform notes: tools/agent-dev/README.md.
#
# Usage (verb style, like `opencode`):
#   opencode-dev [options] [-- <opencode args>]  run OpenCode confined (default)
#   opencode-dev build                         build the image (first time)
#   opencode-dev update [--all]                update OpenCode (--all: every layer)
#   opencode-dev access [options]              print what the next session can access — bind mounts, egress, per-host traffic record — launch nothing
#   opencode-dev cleanup [--all]               remove what this tool left behind: dead session objects, superseded images
#                                              (--all: also engine-wide — every unused image, stopped container, network, volume, build cache)
#   opencode-dev help                          show this help
#
# Options:
#   --rw PATH        extra writable dir/file (repeatable); CWD is always writable
#   --ro PATH        extra read-only dir/file (repeatable)
#   --allow DOMAIN   extra egress domain, this run only (repeatable)
#   --open-egress    drop the domain allow-list; the proxy, its log and its
#                    host/LAN/metadata deny stay
#   --allowlist-egress  force allow-list mode, overriding [egress] mode = "open"
#   --ow, --open-weight
#                    run on the open-weight peer declared in [open-weight]. The
#                    proxy gains a reverse port to it that admits POST
#                    /v1/chat/completions only. The session gets the provider's
#                    base URL, a placeholder key and the [open-weight.models]
#                    map, and a data directory apart from the one that holds
#                    the project's login. A :cloud tag is served by the
#                    peer's vendor, outside this proxy's log.
#   -h, --help
#
# Any other flag goes to `opencode` inside: --continue, --model, --agent. Use
# `-- <flag>` when a name collides with one above (e.g. `-- --help`). The
# project mounts at its own path, so a session started on the host finds the
# same project here — run it from that project.
#
# Permissions are OpenCode's own: the launcher injects no permission mode.
# The container and the proxy are the boundary, sized to hold whatever the
# session is allowed to do.
#
# Egress is default-deny: the session's only route out is a squid proxy that
# allows CONNECT to :443 for the [egress] allow domains and refuses host, LAN
# and metadata addresses. --ow adds one plain-HTTP path to the [open-weight] peer,
# read and filtered by the same proxy. To see what a session asked for and did
# not get:
# `opencode-dev access` (per-host counts), or the raw record:
# grep TCP_DENIED ~/.config/opencode-dev/last-egress.log
#
# Login: run /connect once inside each project. The credential and the session
# history persist in that project's private shadow of ~/.local/share/opencode,
# separate under --ow and never in a host path. The config, state and cache
# directories are discarded when the session exits.
#
# Layout when installed:
#   ~/.local/bin/opencode-dev                the command (on PATH)
#   ~/.config/opencode-dev/Dockerfile        the image definition
#   ~/.config/opencode-dev/opencode-dev.toml the operator's policy: [mounts],
#                                            [egress] and [open-weight]; read as data,
#                                            never executed; documents its own keys
#   ~/.config/opencode-dev/state/            the per-project private data directories
#   ~/.config/opencode-dev/last-egress.log   the proxy's access log, saved on exit
#
# Env: OPENCODE_DEV_HOME             data dir (default ~/.config/opencode-dev)
#      OPENCODE_DEV_OPENCODE_VERSION opencode version to build/update (default latest)
# The engine also reads the data-dir variable of every other agent-dev tool,
# only to keep that directory out of this session. OPENCODE_DEV_HOME relocates
# the config, the Dockerfile and the engine and python modules this script runs
# ON THE HOST — pointing it at a directory outside the operator's control is
# equivalent to running that directory's code. No project file is ever read,
# so a repo steers nothing.
set -euo pipefail

# This file is the opencode-dev command: it names the tool and hands everything
# else to the shared agent-dev engine. The engine holds the confinement, prints
# this header as the help text, and decides where this file may run from. The
# engine beside this file runs when there is one (a source checkout), the
# installed one otherwise.
AGENT_DEV_HOME="${OPENCODE_DEV_HOME:-$HOME/.config/opencode-dev}"
ENGINE="$(dirname "$0")/agent-dev"
[ -f "$ENGINE" ] || ENGINE="$AGENT_DEV_HOME/agent-dev"
[ -f "$ENGINE" ] || { printf 'opencode-dev: missing agent-dev (looked beside %s and in %s) — run install.sh\n' "$0" "$AGENT_DEV_HOME" >&2; exit 1; }
export AGENT_DEV_TOOL=opencode AGENT_DEV_CMD=opencode-dev AGENT_DEV_HOME AGENT_DEV_SHIM="$0"
exec "$ENGINE" "$@"
