+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      https://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for the specialty directory derived by {@link SpecialtyDirectoryEntry}.
+ */
+class SpecialtyDirectoryEntryTests {
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private int nextId = 1;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() {
+		Specialty dentistry = aSpecialtyNamed(DENTISTRY);
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Specialty surgery = aSpecialtyNamed(SURGERY);
+		Vet helen = aVeterinarianNamed("Helen", "Leary", radiology);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry
+			.directoryOf(List.of(dentistry, radiology, surgery), List.of(helen));
+
+		assertThat(directory).extracting(SpecialtyDirectoryEntry::specialtyName)
+			.containsExactlyInAnyOrder(DENTISTRY, RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEverySpecialtyHeld() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Specialty surgery = aSpecialtyNamed(SURGERY);
+		Vet helen = aVeterinarianNamed("Helen", "Leary", radiology, surgery);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(radiology, surgery),
+				List.of(helen));
+
+		assertThat(directory).containsExactly(anEntryFor(RADIOLOGY, helen), anEntryFor(SURGERY, helen));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Vet helen = aVeterinarianNamed("Helen", "Leary", radiology);
+		Vet james = aVeterinarianNamed("James", "Carter");
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(radiology),
+				List.of(helen, james));
+
+		assertThat(directory).flatExtracting(SpecialtyDirectoryEntry::veterinarians).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Specialty surgery = aSpecialtyNamed(SURGERY);
+		Vet helen = aVeterinarianNamed("Helen", "Leary", radiology);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(radiology, surgery),
+				List.of(helen));
+
+		assertThat(directory).containsExactly(anEntryFor(RADIOLOGY, helen), anEntryFor(SURGERY));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderWhenNoSpecialtyExists() {
+		Vet james = aVeterinarianNamed("James", "Carter");
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(), List.of(james));
+
+		assertThat(directory).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesAndVeterinariansStably() {
+		Specialty surgery = aSpecialtyNamed(SURGERY);
+		Specialty dentistry = aSpecialtyNamed(DENTISTRY);
+		Vet linda = aVeterinarianNamed("Linda", "Douglas", surgery, dentistry);
+		Vet henry = aVeterinarianNamed("Henry", "Stevens", surgery);
+		Vet sharon = aVeterinarianNamed("Sharon", "Jenkins", surgery);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(surgery, dentistry),
+				List.of(henry, linda, sharon));
+
+		assertThat(directory).containsExactly(anEntryFor(DENTISTRY, linda), anEntryFor(SURGERY, linda, sharon, henry));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansSharingALastNameByFirstNameThenId() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Vet helenLeary = aVeterinarianNumbered(20, "Helen", "Leary", radiology);
+		Vet annaLeary = aVeterinarianNumbered(30, "Anna", "Leary", radiology);
+		Vet theOtherAnnaLeary = aVeterinarianNumbered(10, "Anna", "Leary", radiology);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(radiology),
+				List.of(helenLeary, annaLeary, theOtherAnnaLeary));
+
+		assertThat(directory).containsExactly(anEntryFor(RADIOLOGY, theOtherAnnaLeary, annaLeary, helenLeary));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotMatchAnUnsavedSpecialtyToAStoredOne() {
+		Specialty storedRadiology = aSpecialtyNamed(RADIOLOGY);
+		Vet helen = aVeterinarianNamed("Helen", "Leary", anUnsavedSpecialtyNamed(RADIOLOGY));
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(storedRadiology),
+				List.of(helen));
+
+		assertThat(directory).containsExactly(anEntryFor(RADIOLOGY));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldLeaveTheCollectionsItReadsUntouched() {
+		Specialty surgery = aSpecialtyNamed(SURGERY);
+		Specialty dentistry = aSpecialtyNamed(DENTISTRY);
+		Vet linda = aVeterinarianNamed("Linda", "Douglas", surgery, dentistry);
+		Vet henry = aVeterinarianNamed("Henry", "Stevens", surgery);
+		List<Specialty> storedSpecialties = new ArrayList<>(List.of(surgery, dentistry));
+		List<Vet> cachedVeterinarians = new ArrayList<>(List.of(henry, linda));
+
+		SpecialtyDirectoryEntry.directoryOf(storedSpecialties, cachedVeterinarians);
+
+		assertThat(storedSpecialties).containsExactly(surgery, dentistry);
+		assertThat(cachedVeterinarians).containsExactly(henry, linda);
+	}
+
+	private Specialty aSpecialtyNamed(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	/**
+	 * A specialty the clinic never stored: it carries a name but no identity, so nothing
+	 * may match it to a stored specialty of the same name.
+	 */
+	private Specialty anUnsavedSpecialtyNamed(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet aVeterinarianNamed(String firstName, String lastName, Specialty... specialties) {
+		return aVeterinarianNumbered(this.nextId++, firstName, lastName, specialties);
+	}
+
+	private Vet aVeterinarianNumbered(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(id);
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		Arrays.stream(specialties).forEach(veterinarian::addSpecialty);
+		return veterinarian;
+	}
+
+	private SpecialtyDirectoryEntry anEntryFor(String specialtyName, Vet... veterinarians) {
+		return new SpecialtyDirectoryEntry(specialtyName, List.of(veterinarians));
+	}
+
+}
