+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * One specialty of the clinic together with the veterinarians holding it.
+ *
+ * <p>
+ * The clinic stores the association from veterinarian to specialty only, so the directory
+ * shape is derived rather than queried: {@link #directoryOf} pairs every stored specialty
+ * with its holders, keeps a specialty nobody holds, drops a veterinarian holding none,
+ * and fixes the order the page renders. Ordering lives here rather than in a repository
+ * query so that it is exercisable without a database.
+ */
+record SpecialtyDirectoryEntry(String specialtyName, List<Vet> veterinarians) {
+
+	private static final Comparator<Specialty> BY_STORED_NAME = Comparator.comparing(Specialty::getName);
+
+	private static final Comparator<Vet> BY_LAST_NAME_FIRST_NAME_ID = Comparator
+		.comparing((Vet veterinarian) -> veterinarian.getLastName())
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	public SpecialtyDirectoryEntry {
+		Objects.requireNonNull(specialtyName, "specialtyName");
+		veterinarians = List.copyOf(veterinarians);
+	}
+
+	/**
+	 * Derive the whole specialty directory from everything the clinic stores.
+	 * <p>
+	 * Both arguments are read without being modified: the veterinarian collection may be
+	 * the cached instance {@link VetRepository#findAll()} returns, and reordering it in
+	 * place would corrupt that cache for every later request.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians every veterinarian of the clinic
+	 * @return one entry per specialty, ordered by stored specialty name, each holding its
+	 * veterinarians ordered by last name, first name, then identity
+	 */
+	public static List<SpecialtyDirectoryEntry> directoryOf(Collection<Specialty> specialties,
+			Collection<Vet> veterinarians) {
+		return specialties.stream()
+			.sorted(BY_STORED_NAME)
+			.map(specialty -> new SpecialtyDirectoryEntry(specialty.getName(), holdersOf(specialty, veterinarians)))
+			.toList();
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> veterinarians) {
+		return veterinarians.stream()
+			.filter(veterinarian -> holds(veterinarian, specialty))
+			.sorted(BY_LAST_NAME_FIRST_NAME_ID)
+			.toList();
+	}
+
+	private static boolean holds(Vet veterinarian, Specialty specialty) {
+		return veterinarian.getSpecialties()
+			.stream()
+			.anyMatch(held -> !held.isNew() && held.getId().equals(specialty.getId()));
+	}
+
+}
