+ * <p>
+ * Results are deliberately not cached: a new cache would have to be declared alongside
+ * the vet cache and would inherit its unresolved eviction question.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve all <code>Specialty</code>s from the data store, in no particular order.
+	 * @return a <code>Collection</code> of <code>Specialty</code>s
+	 */
+	@Transactional(readOnly = true)
+	Collection<Specialty> findAll() throws DataAccessException;
+
+}
