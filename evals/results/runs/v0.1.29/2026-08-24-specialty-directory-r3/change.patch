+package org.springframework.samples.petclinic.vet;
+
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.annotation.Bean;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageImpl;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}.
+ * <p>
+ * The clinic it serves stores three specialties — dentistry and radiology are held,
+ * surgery is held by nobody — and two veterinarians, of whom James Carter holds no
+ * specialty.
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+class SpecialtyControllerTests {
+
+	private static final String HELD_SPECIALTY = "radiology";
+
+	private static final String UNHELD_SPECIALTY = "surgery";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attributeExists("specialtyDirectory"))
+			.andExpect(content().string(containsString("dentistry")))
+			.andExpect(content().string(containsString(HELD_SPECIALTY)))
+			.andExpect(content().string(containsString(UNHELD_SPECIALTY)))
+			.andExpect(content().string(not(containsString("/specialties.html?page="))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowSpecialtyNamesAsStored() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString(HELD_SPECIALTY)))
+			.andExpect(content().string(not(containsString("??" + HELD_SPECIALTY))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachVeterinarianFirstNameThenLastName() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString("Helen Leary")))
+			.andExpect(content().string(not(containsString("Leary Helen"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() throws Exception {
+		mockMvc.perform(get("/specialties.html")).andExpect(content().string(not(containsString("James Carter"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString(UNHELD_SPECIALTY)))
+			.andExpect(content().string(not(containsString("none"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarrySiteNavigationWithoutBeingLinked() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString("/vets.html")))
+			.andExpect(content().string(not(containsString("href=\"/specialties.html\""))))
+			.andExpect(content().string(not(containsString("nav-link active"))));
+	}
+
+	private static Specialty aSpecialtyNamed(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet aVeterinarianNamed(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(id);
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		Arrays.stream(specialties).forEach(veterinarian::addSpecialty);
+		return veterinarian;
+	}
+
+	@TestConfiguration
+	static class StoredClinicRecords {
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return () -> List.of(aSpecialtyNamed(1, HELD_SPECIALTY), aSpecialtyNamed(2, "dentistry"),
+					aSpecialtyNamed(3, UNHELD_SPECIALTY));
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new VetRepository() {
+				@Override
+				public Collection<Vet> findAll() {
+					return List.of(aVeterinarianNamed(1, "Helen", "Leary", aSpecialtyNamed(1, HELD_SPECIALTY),
+							aSpecialtyNamed(2, "dentistry")), aVeterinarianNamed(2, "James", "Carter"));
+				}
+
+				@Override
+				public Page<Vet> findAll(Pageable pageable) {
+					return new PageImpl<>(List.copyOf(findAll()));
+				}
+			};
+		}
+
+	}
+
+}
