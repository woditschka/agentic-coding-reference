+/**
+ * Visit correction against a real database.
+ * <p>
+ * {@link VisitControllerTests} stubs the repository, so a save that wrote a second visit
+ * row would raise nothing there. This test drives the same route through the real
+ * repository and reads the visits back from the database, which is the only place the
+ * "corrects in place, adds nothing" guarantee can be observed.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+@Transactional
+class VisitControllerIntegrationTests {
+
+	private static final int OWNER_WITH_A_BOOKED_VISIT_ID = 6;
+
+	private static final int PET_WITH_A_BOOKED_VISIT_ID = 7;
+
+	private static final LocalDate CORRECTED_VISIT_DATE = LocalDate.now().plusDays(9);
+
+	private static final String CORRECTED_VISIT_DESCRIPTION = "rabies shot and dental check";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private OwnerRepository owners;
+
+	@PersistenceContext
+	private EntityManager entityManager;
+
+	@Test
+	void theVisitCorrectionShouldReplaceTheVisitRowWithoutAddingAnother() throws Exception {
+		Pet bookedPet = petWithABookedVisit();
+		int bookedVisitCount = bookedPet.getVisits().size();
+		Integer correctedVisitId = bookedPet.getVisits().iterator().next().getId();
+
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit", OWNER_WITH_A_BOOKED_VISIT_ID,
+					PET_WITH_A_BOOKED_VISIT_ID, correctedVisitId)
+				.param("date", CORRECTED_VISIT_DATE.toString())
+				.param("description", CORRECTED_VISIT_DESCRIPTION))
+			.andExpect(status().is3xxRedirection());
+
+		this.entityManager.flush();
+		this.entityManager.clear();
+
+		Pet correctedPet = petWithABookedVisit();
+		assertThat(correctedPet.getVisits()).hasSize(bookedVisitCount);
+		assertThat(correctedPet.getVisit(correctedVisitId)).extracting(Visit::getDate, Visit::getDescription)
+			.containsExactly(CORRECTED_VISIT_DATE, CORRECTED_VISIT_DESCRIPTION);
+	}
+
+	private Pet petWithABookedVisit() {
+		Owner owner = this.owners.findById(OWNER_WITH_A_BOOKED_VISIT_ID)
+			.orElseThrow(() -> new IllegalStateException(
+					"Seed data is missing owner " + OWNER_WITH_A_BOOKED_VISIT_ID + " with a booked visit"));
+		return owner.getPet(PET_WITH_A_BOOKED_VISIT_ID);
+	}
+
+}
