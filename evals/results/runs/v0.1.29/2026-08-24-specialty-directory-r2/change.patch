+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+
+import org.springframework.dao.DataAccessException;
+import org.springframework.data.repository.Repository;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Repository for <code>Specialty</code> lookup values. It is the only path to a specialty
+ * no veterinarian holds, which the veterinarian graph cannot reach.
+ * <p>
+ * It extends the bare {@link Repository} interface and declares reads only, so no write
+ * path to a specialty exists (NG-2). Ordering is not requested here: the specialty
+ * directory orders in Java so the page does not vary with database collation.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve every <code>Specialty</code> from the data store, in no particular order.
+	 * @return a <code>Collection</code> of <code>Specialty</code> objects
+	 */
+	@Transactional(readOnly = true)
+	Collection<Specialty> findAll() throws DataAccessException;
+
+}
