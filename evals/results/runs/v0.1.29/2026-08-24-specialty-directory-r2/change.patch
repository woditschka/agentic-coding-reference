+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.boot.test.context.SpringBootTest.WebEnvironment.RANDOM_PORT;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.resttestclient.TestRestTemplate;
+import org.springframework.boot.resttestclient.autoconfigure.AutoConfigureTestRestTemplate;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.web.server.LocalServerPort;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.jdbc.Sql;
+import org.springframework.test.context.jdbc.Sql.ExecutionPhase;
+
+/**
+ * Tests for the specialty directory page (REQ-VET-003), served against the seeded
+ * database with no mocks. The seed data holds three specialties: radiology (Helen Leary,
+ * Henry Stevens), surgery (Linda Douglas, Rafael Ortega) and dentistry (Linda Douglas).
+ * James Carter and Sharon Jenkins hold no specialty. Every seeded specialty has a
+ * veterinarian, so the one test that needs a specialty nobody holds adds and removes it
+ * around itself.
+ */
+@SpringBootTest(webEnvironment = RANDOM_PORT)
+@AutoConfigureTestRestTemplate
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_DIRECTORY_PATH = "/specialties.html";
+
+	/**
+	 * A specialty the seed data does not give to anybody. The seeded rows all have a
+	 * veterinarian, so the "specialty no veterinarian holds" criterion needs one added.
+	 */
+	private static final String UNHELD_SPECIALTY = "exotic animal medicine";
+
+	private static final String ADD_UNHELD_SPECIALTY = "INSERT INTO specialties (name) VALUES ('" + UNHELD_SPECIALTY
+			+ "')";
+
+	private static final String REMOVE_UNHELD_SPECIALTY = "DELETE FROM specialties WHERE name = '" + UNHELD_SPECIALTY
+			+ "'";
+
+	@LocalServerPort
+	private int port;
+
+	@Autowired
+	private TestRestTemplate rest;
+
+	@Test
+	void theSpecialtyDirectoryShouldBeServedAtItsOwnAddress() {
+		ResponseEntity<String> page = getSpecialtyDirectory();
+
+		assertThat(page.getStatusCode()).isEqualTo(HttpStatus.OK);
+		assertThat(page.getBody()).contains("radiology", "surgery", "dentistry");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachVeterinarianFirstNameThenLastName() {
+		ResponseEntity<String> page = getSpecialtyDirectory();
+
+		assertThat(page.getBody()).contains("Helen Leary");
+		assertThat(page.getBody()).containsSubsequence("dentistry", "Linda Douglas", "radiology", "Helen Leary",
+				"Henry Stevens", "surgery", "Linda Douglas", "Rafael Ortega");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		ResponseEntity<String> page = getSpecialtyDirectory();
+
+		assertThat(page.getBody()).doesNotContain("James Carter", "Sharon Jenkins");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEverySpecialtyOnOnePage() {
+		ResponseEntity<String> page = getSpecialtyDirectory();
+
+		assertThat(page.getBody()).contains("radiology", "surgery", "dentistry");
+		assertThat(page.getBody()).doesNotContain(SPECIALTY_DIRECTORY_PATH + "?page=");
+	}
+
+	/**
+	 * The added row is removed again after the method so it cannot reach the other tests
+	 * sharing this database, whose expectations are written against the seed data alone.
+	 */
+	@Test
+	@Sql(statements = ADD_UNHELD_SPECIALTY)
+	@Sql(statements = REMOVE_UNHELD_SPECIALTY, executionPhase = ExecutionPhase.AFTER_TEST_METHOD)
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		ResponseEntity<String> page = getSpecialtyDirectory();
+
+		assertThat(page.getBody()).contains(UNHELD_SPECIALTY);
+		assertThat(rowFor(page.getBody(), UNHELD_SPECIALTY)).doesNotContain("<li");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheStandardNavigationWithoutLinkingToItself() {
+		ResponseEntity<String> page = getSpecialtyDirectory();
+
+		assertThat(page.getBody()).contains("/vets.html", "/owners/find");
+		assertThat(page.getBody()).doesNotContain("href=\"" + SPECIALTY_DIRECTORY_PATH + "\"");
+	}
+
+	@Test
+	void noOtherPageShouldCarryALinkToTheSpecialtyDirectory() {
+		assertThatPageDoesNotMentionTheSpecialtyDirectory("/");
+		assertThatPageDoesNotMentionTheSpecialtyDirectory("/vets.html");
+	}
+
+	/**
+	 * Asserts the page at the given path really was served and that its body nowhere
+	 * names the specialty directory's address — the navigation is a shared layout
+	 * fragment, so a page carrying no mention of the address carries no link to it in any
+	 * form.
+	 */
+	private void assertThatPageDoesNotMentionTheSpecialtyDirectory(String path) {
+		ResponseEntity<String> page = getPage(path);
+
+		assertThat(page.getStatusCode()).as("status of %s", path).isEqualTo(HttpStatus.OK);
+		assertThat(page.getBody()).as("body of %s", path).contains("/vets.html", "/owners/find");
+		assertThat(page.getBody()).as("body of %s", path).doesNotContain(SPECIALTY_DIRECTORY_PATH);
+	}
+
+	private ResponseEntity<String> getSpecialtyDirectory() {
+		return getPage(SPECIALTY_DIRECTORY_PATH);
+	}
+
+	private ResponseEntity<String> getPage(String path) {
+		HttpHeaders headers = new HttpHeaders();
+		headers.setAccept(List.of(MediaType.TEXT_HTML));
+		return this.rest.exchange("http://localhost:" + this.port + path, HttpMethod.GET, new HttpEntity<>(headers),
+				String.class);
+	}
+
+	/**
+	 * The rendered table row for the named specialty: everything from its name cell up to
+	 * the row's closing tag, which is where that specialty's veterinarians are listed.
+	 */
+	private static String rowFor(String body, String specialtyName) {
+		int nameCell = body.indexOf(specialtyName);
+		assertThat(nameCell).as("specialty '%s' is not on the page", specialtyName).isNotNegative();
+		int rowEnd = body.indexOf("</tr>", nameCell);
+		assertThat(rowEnd).as("the row for '%s' is not closed", specialtyName).isNotNegative();
+		return body.substring(nameCell, rowEnd);
+	}
+
+}
