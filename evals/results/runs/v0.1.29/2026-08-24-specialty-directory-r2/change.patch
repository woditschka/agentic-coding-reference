+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatIllegalArgumentException;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Tests for {@link SpecialtyDirectory}: the specialty side of the unidirectional
+ * veterinarian-specialty association, inverted in memory (REQ-VET-003).
+ */
+class SpecialtyDirectoryTests {
+
+	private int nextId = 1;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyWithTheVeterinariansHoldingIt() {
+		Specialty radiology = createASpecialtyNamed("radiology");
+		Specialty surgery = createASpecialtyNamed("surgery");
+		Vet leary = createAVetNamed("Helen", "Leary", radiology);
+		Vet ortega = createAVetNamed("Rafael", "Ortega", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.group(List.of(radiology, surgery), List.of(leary, ortega));
+
+		assertThat(directory.getSpecialties()).containsExactly(radiology, surgery);
+		assertThat(directory.veterinariansHolding(radiology)).containsExactly(leary);
+		assertThat(directory.veterinariansHolding(surgery)).containsExactly(ortega);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowAVeterinarianUnderEverySpecialtyTheyHold() {
+		Specialty dentistry = createASpecialtyNamed("dentistry");
+		Specialty surgery = createASpecialtyNamed("surgery");
+		Vet douglas = createAVetNamed("Linda", "Douglas", dentistry, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.group(List.of(dentistry, surgery), List.of(douglas));
+
+		assertThat(directory.veterinariansHolding(dentistry)).containsExactly(douglas);
+		assertThat(directory.veterinariansHolding(surgery)).containsExactly(douglas);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialtyNamed("radiology");
+		Vet leary = createAVetNamed("Helen", "Leary", radiology);
+		Vet jenkins = createAVetNamed("Sharon", "Jenkins");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.group(List.of(radiology), List.of(leary, jenkins));
+
+		assertThat(directory.veterinariansHolding(radiology)).doesNotContain(jenkins);
+		assertThat(directory.getSpecialties()).hasSize(1);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = createASpecialtyNamed("radiology");
+		Specialty heldByNobody = createASpecialtyNamed("dentistry");
+		Vet leary = createAVetNamed("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.group(List.of(radiology, heldByNobody), List.of(leary));
+
+		assertThat(directory.getSpecialties()).contains(heldByNobody);
+		assertThat(directory.veterinariansHolding(heldByNobody)).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchSpecialtiesReadSeparatelyFromTheirVeterinarians() {
+		Specialty radiologyHeldByAVet = createASpecialtyNamed("radiology");
+		Specialty radiologyReadOnItsOwn = readAgain(radiologyHeldByAVet);
+		Vet leary = createAVetNamed("Helen", "Leary", radiologyHeldByAVet);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.group(List.of(radiologyReadOnItsOwn), List.of(leary));
+
+		assertThat(directory.veterinariansHolding(radiologyReadOnItsOwn)).containsExactly(leary);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByName() {
+		Specialty surgery = createASpecialtyNamed("surgery");
+		Specialty radiology = createASpecialtyNamed("radiology");
+		Specialty dentistry = createASpecialtyNamed("dentistry");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.group(List.of(surgery, radiology, dentistry), List.of());
+
+		assertThat(directory.getSpecialties()).containsExactly(dentistry, radiology, surgery);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastNameThenFirstName() {
+		Specialty surgery = createASpecialtyNamed("surgery");
+		Vet lindaDouglas = createAVetNamed("Linda", "Douglas", surgery);
+		Vet rafaelOrtega = createAVetNamed("Rafael", "Ortega", surgery);
+		Vet adamDouglas = createAVetNamed("Adam", "Douglas", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.group(List.of(surgery),
+				List.of(rafaelOrtega, lindaDouglas, adamDouglas));
+
+		assertThat(directory.veterinariansHolding(surgery)).containsExactly(adamDouglas, lindaDouglas, rafaelOrtega);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotObserveLaterChangesToTheCollectionsItWasBuiltFrom() {
+		Specialty radiology = createASpecialtyNamed("radiology");
+		Vet leary = createAVetNamed("Helen", "Leary", radiology);
+		List<Specialty> specialtiesRead = new ArrayList<>(List.of(radiology));
+		List<Vet> veterinariansRead = new ArrayList<>(List.of(leary));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.group(specialtiesRead, veterinariansRead);
+		specialtiesRead.add(createASpecialtyNamed("dentistry"));
+		veterinariansRead.add(createAVetNamed("Rafael", "Ortega", radiology));
+
+		assertThat(directory.getSpecialties()).containsExactly(radiology);
+		assertThat(directory.veterinariansHolding(radiology)).containsExactly(leary);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldIgnoreASpecialtyTheSpecialtyReadDidNotReturn() {
+		Specialty radiology = createASpecialtyNamed("radiology");
+		Specialty withdrawnSinceTheVeterinariansWereRead = createASpecialtyNamed("dentistry");
+		Vet leary = createAVetNamed("Helen", "Leary", radiology, withdrawnSinceTheVeterinariansWereRead);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.group(List.of(radiology), List.of(leary));
+
+		assertThat(directory.getSpecialties()).containsExactly(radiology);
+		assertThat(directory.veterinariansHolding(radiology)).containsExactly(leary);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRejectASpecialtyItDoesNotList() {
+		Specialty radiology = createASpecialtyNamed("radiology");
+		Specialty absentFromTheDirectory = createASpecialtyNamed("dentistry");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.group(List.of(radiology), List.of());
+
+		assertThatIllegalArgumentException().isThrownBy(() -> directory.veterinariansHolding(absentFromTheDirectory))
+			.withMessageContaining(absentFromTheDirectory.getName());
+	}
+
+	private Specialty createASpecialtyNamed(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	/**
+	 * A second instance of the same stored specialty, as a separate read of the specialty
+	 * table produces: same identity, different object.
+	 */
+	private Specialty readAgain(Specialty specialty) {
+		Specialty reread = new Specialty();
+		reread.setId(specialty.getId());
+		reread.setName(specialty.getName());
+		return reread;
+	}
+
+	private Vet createAVetNamed(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
