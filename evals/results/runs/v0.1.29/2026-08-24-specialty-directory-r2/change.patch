+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * Every specialty the clinic knows, each with the veterinarians holding it.
+ * <p>
+ * The veterinarian-specialty association is unidirectional: a {@link Vet} holds
+ * specialties and a {@link Specialty} holds nothing. The two sides are therefore read
+ * independently and inverted here, which is also what makes a specialty no veterinarian
+ * holds reachable. See ADR 2026-08-23, "Specialty-side reads invert the vet-specialty
+ * association in memory".
+ * <p>
+ * Because the two sides come from separate reads, the same stored specialty arrives as
+ * two distinct objects; they are matched by stored identity, not by object identity.
+ */
+public final class SpecialtyDirectory {
+
+	/**
+	 * Ordering is fixed here rather than in SQL so the page reads the same on every
+	 * supported database vendor, whose collations differ.
+	 */
+	private static final Comparator<Specialty> BY_NAME = Comparator.comparing(NamedEntity::getName);
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator
+		.comparing((Vet veterinarian) -> veterinarian.getLastName())
+		.thenComparing(Person::getFirstName);
+
+	private final List<Specialty> specialties;
+
+	private final Map<Integer, List<Vet>> veterinariansBySpecialtyId;
+
+	private SpecialtyDirectory(List<Specialty> specialties, Map<Integer, List<Vet>> veterinariansBySpecialtyId) {
+		this.specialties = List.copyOf(specialties);
+		this.veterinariansBySpecialtyId = Map.copyOf(veterinariansBySpecialtyId);
+	}
+
+	/**
+	 * Invert the two independently read sides into a directory.
+	 * @param specialties every specialty the clinic knows; one no veterinarian holds is
+	 * listed with no veterinarian against it
+	 * @param veterinarians every veterinarian; one holding no specialty appears in no
+	 * entry
+	 * @return the directory
+	 */
+	public static SpecialtyDirectory group(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Specialty specialty : specialties) {
+			holders.put(specialty.getId(), new ArrayList<>());
+		}
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				List<Vet> holdersOfSpecialty = holders.get(held.getId());
+				// The two sides are read separately, and the veterinarian side is served
+				// from a cache that is never evicted, so a veterinarian may still hold a
+				// specialty the specialty read no longer returns. It is not listed.
+				if (holdersOfSpecialty != null) {
+					holdersOfSpecialty.add(veterinarian);
+				}
+			}
+		}
+		Map<Integer, List<Vet>> orderedHolders = new HashMap<>();
+		holders.forEach((specialtyId, holdersOfSpecialty) -> orderedHolders.put(specialtyId,
+				holdersOfSpecialty.stream().sorted(BY_LAST_THEN_FIRST_NAME).toList()));
+		return new SpecialtyDirectory(specialties.stream().sorted(BY_NAME).toList(), orderedHolders);
+	}
+
+	/**
+	 * Every specialty in the directory.
+	 */
+	public List<Specialty> getSpecialties() {
+		return this.specialties;
+	}
+
+	/**
+	 * The veterinarians holding the given specialty, empty when none do.
+	 * @param specialty a specialty of this directory
+	 * @throws IllegalArgumentException if the specialty is not in this directory
+	 */
+	public List<Vet> veterinariansHolding(Specialty specialty) {
+		List<Vet> holders = this.veterinariansBySpecialtyId.get(specialty.getId());
+		if (holders == null) {
+			throw new IllegalArgumentException("Specialty '" + specialty.getName() + "' (id " + specialty.getId()
+					+ ") is not in this specialty directory");
+		}
+		return holders;
+	}
+
+	@Override
+	public boolean equals(Object other) {
+		if (this == other) {
+			return true;
+		}
+		if (!(other instanceof SpecialtyDirectory that)) {
+			return false;
+		}
+		return this.specialties.equals(that.specialties)
+				&& this.veterinariansBySpecialtyId.equals(that.veterinariansBySpecialtyId);
+	}
+
+	@Override
+	public int hashCode() {
+		return Objects.hash(this.specialties, this.veterinariansBySpecialtyId);
+	}
+
+}
