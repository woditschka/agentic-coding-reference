+package org.springframework.samples.petclinic.owner;
+
+import java.util.Locale;
+
+import org.springframework.context.MessageSource;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.servlet.mvc.support.RedirectAttributes;
+
+/**
+ * Cancels an upcoming visit from an owner's record.
+ * <p>
+ * Deliberately separate from {@link VisitController}: that controller's
+ * {@code @ModelAttribute} attaches a blank {@link Visit} to the loaded pet before every
+ * one of its handlers, which the save here would cascade-persist.
+ */
+@Controller
+class VisitCancellationController {
+
+	private final OwnerRepository owners;
+
+	private final MessageSource messages;
+
+	VisitCancellationController(OwnerRepository owners, MessageSource messages) {
+		this.owners = owners;
+		this.messages = messages;
+	}
+
+	/**
+	 * Cancels the visit named by the path, and reports the outcome on the owner's record.
+	 * <p>
+	 * The aggregate decides: a pet that is not this owner's, a visit that is not that
+	 * pet's or was cancelled already, and a visit that is no longer upcoming are one
+	 * refusal, worded alike so the record cannot be used to discover what exists under
+	 * another owner.
+	 */
+	@PostMapping("/owners/{ownerId}/pets/{petId}/visits/{visitId}/cancel")
+	public String processVisitCancellation(@PathVariable int ownerId, @PathVariable int petId,
+			@PathVariable int visitId, Locale locale, RedirectAttributes redirectAttributes) {
+
+		Owner owner = this.owners.findById(ownerId)
+			.orElseThrow(() -> new IllegalArgumentException(
+					"Owner not found with id: " + ownerId + ". Please ensure the ID is correct "));
+
+		if (owner.cancelVisit(petId, visitId)) {
+			this.owners.save(owner);
+			redirectAttributes.addFlashAttribute("message", text("visitCancelled", locale));
+		}
+		else {
+			redirectAttributes.addFlashAttribute("error", text("visitCancellationRefused", locale));
+		}
+
+		return "redirect:/owners/{ownerId}";
+	}
+
+	private String text(String code, Locale locale) {
+		return this.messages.getMessage(code, null, locale);
+	}
+
+}
