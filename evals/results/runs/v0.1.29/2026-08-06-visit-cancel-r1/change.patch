+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link Visit}.
+ */
+class VisitTests {
+
+	@Test
+	void theVisitDatedAfterTodayShouldBeUpcoming() {
+		Visit tomorrowsVisit = visitOn(LocalDate.now().plusDays(1));
+
+		assertThat(tomorrowsVisit.isUpcoming()).isTrue();
+	}
+
+	@Test
+	void theVisitDatedTodayShouldNotBeUpcoming() {
+		Visit todaysVisit = visitOn(LocalDate.now());
+
+		assertThat(todaysVisit.isUpcoming()).isFalse();
+	}
+
+	@Test
+	void theVisitDatedBeforeTodayShouldNotBeUpcoming() {
+		Visit yesterdaysVisit = visitOn(LocalDate.now().minusDays(1));
+
+		assertThat(yesterdaysVisit.isUpcoming()).isFalse();
+	}
+
+	@Test
+	void theVisitWithoutADateShouldNotBeUpcoming() {
+		Visit undatedVisit = visitOn(null);
+
+		assertThat(undatedVisit.isUpcoming()).isFalse();
+	}
+
+	private Visit visitOn(LocalDate date) {
+		Visit visit = new Visit();
+		visit.setDate(date);
+		return visit;
+	}
+
+}
