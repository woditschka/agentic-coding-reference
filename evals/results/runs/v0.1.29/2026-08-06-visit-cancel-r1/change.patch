+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for the cancellation behaviour of the {@link Owner} aggregate.
+ */
+class OwnerTests {
+
+	private static final int MAX_ID = 1;
+
+	private static final int BASIL_ID = 2;
+
+	private static final int LUCKY_ID = 3;
+
+	private static final int UPCOMING_VISIT_ID = 10;
+
+	private static final int PAST_VISIT_ID = 11;
+
+	@Test
+	void theCancelledVisitShouldLeaveThePetRecord() {
+		Owner george = georgeWithMax();
+		Pet max = george.getPet(MAX_ID);
+
+		boolean cancelled = george.cancelVisit(MAX_ID, UPCOMING_VISIT_ID);
+
+		assertThat(cancelled).isTrue();
+		assertThat(max.getVisits()).extracting(Visit::getId).doesNotContain(UPCOMING_VISIT_ID);
+	}
+
+	@Test
+	void theCancellationShouldLeaveTheOtherVisitsOfThePetUntouched() {
+		Owner george = georgeWithMax();
+		Pet max = george.getPet(MAX_ID);
+
+		george.cancelVisit(MAX_ID, UPCOMING_VISIT_ID);
+
+		assertThat(max.getVisits()).extracting(Visit::getId).containsExactly(PAST_VISIT_ID);
+		assertThat(george.getPets()).containsExactly(max);
+	}
+
+	@Test
+	void theCancellationOfAPastVisitShouldBeRefused() {
+		Owner george = georgeWithMax();
+		Pet max = george.getPet(MAX_ID);
+
+		boolean cancelled = george.cancelVisit(MAX_ID, PAST_VISIT_ID);
+
+		assertThat(cancelled).isFalse();
+		assertThat(max.getVisits()).extracting(Visit::getId).contains(PAST_VISIT_ID);
+	}
+
+	@Test
+	void theCancellationOfAnotherOwnersVisitShouldBeRefused() {
+		Owner george = georgeWithMax();
+		Pet basil = bettyWithBasil().getPet(BASIL_ID);
+
+		boolean cancelled = george.cancelVisit(basil.getId(), UPCOMING_VISIT_ID);
+
+		assertThat(cancelled).isFalse();
+		assertThat(george.getPet(MAX_ID).getVisits()).extracting(Visit::getId).contains(UPCOMING_VISIT_ID);
+	}
+
+	@Test
+	void theRepeatedCancellationShouldBeRefused() {
+		Owner george = georgeWithMax();
+
+		assertThat(george.cancelVisit(MAX_ID, UPCOMING_VISIT_ID)).isTrue();
+
+		assertThat(george.cancelVisit(MAX_ID, UPCOMING_VISIT_ID)).isFalse();
+	}
+
+	@Test
+	void theCancellationOfAVisitOfAnotherPetOfTheSameOwnerShouldBeRefused() {
+		Owner george = georgeWithMax();
+		Pet lucky = petOf(george, "Lucky", LUCKY_ID);
+
+		boolean cancelled = george.cancelVisit(lucky.getId(), UPCOMING_VISIT_ID);
+
+		assertThat(cancelled).isFalse();
+		assertThat(george.getPet(MAX_ID).getVisits()).extracting(Visit::getId).contains(UPCOMING_VISIT_ID);
+	}
+
+	private Owner georgeWithMax() {
+		Owner george = new Owner();
+		george.setId(1);
+		george.setFirstName("George");
+		george.setLastName("Franklin");
+		Pet max = petOf(george, "Max", MAX_ID);
+		max.addVisit(visit(UPCOMING_VISIT_ID, LocalDate.now().plusDays(1)));
+		max.addVisit(visit(PAST_VISIT_ID, LocalDate.now()));
+		return george;
+	}
+
+	private Owner bettyWithBasil() {
+		Owner betty = new Owner();
+		betty.setId(2);
+		betty.setFirstName("Betty");
+		betty.setLastName("Davis");
+		petOf(betty, "Basil", BASIL_ID);
+		return betty;
+	}
+
+	private Pet petOf(Owner owner, String name, int id) {
+		Pet pet = new Pet();
+		pet.setName(name);
+		owner.addPet(pet);
+		pet.setId(id);
+		return pet;
+	}
+
+	private Visit visit(int id, LocalDate date) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		visit.setDate(date);
+		visit.setDescription("checkup");
+		return visit;
+	}
+
+}
