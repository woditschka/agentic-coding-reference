+import java.time.LocalDate;
+import java.util.Locale;
+import java.util.Optional;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.MessageSource;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+
+/**
+ * Test class for {@link VisitCancellationController}.
+ */
+@WebMvcTest(VisitCancellationController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class VisitCancellationControllerTests {
+
+	private static final int TEST_OWNER_ID = 1;
+
+	private static final int TEST_PET_ID = 1;
+
+	private static final int UPCOMING_VISIT_ID = 10;
+
+	private static final int PAST_VISIT_ID = 11;
+
+	private static final int FOREIGN_PET_ID = 99;
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private MessageSource messages;
+
+	@MockitoBean
+	private OwnerRepository owners;
+
+	private Owner george;
+
+	@BeforeEach
+	void setup() {
+		this.george = new Owner();
+		this.george.setId(TEST_OWNER_ID);
+		this.george.setFirstName("George");
+		this.george.setLastName("Franklin");
+		Pet max = new Pet();
+		max.setName("Max");
+		this.george.addPet(max);
+		max.setId(TEST_PET_ID);
+		max.addVisit(visit(UPCOMING_VISIT_ID, LocalDate.now().plusDays(1)));
+		max.addVisit(visit(PAST_VISIT_ID, LocalDate.now()));
+		given(this.owners.findById(TEST_OWNER_ID)).willReturn(Optional.of(this.george));
+	}
+
+	@Test
+	void theCancellationShouldConfirmOnTheOwnerRecord() throws Exception {
+		cancel(TEST_PET_ID, UPCOMING_VISIT_ID).andExpect(status().is3xxRedirection())
+			.andExpect(redirectedUrl("/owners/" + TEST_OWNER_ID))
+			.andExpect(flash().attribute("message", englishText("visitCancelled")))
+			.andExpect(flash().attributeCount(1));
+
+		verify(this.owners).save(this.george);
+	}
+
+	@Test
+	void theCancelledVisitShouldLeaveThePetRecord() throws Exception {
+		cancel(TEST_PET_ID, UPCOMING_VISIT_ID);
+
+		assertThat(this.george.getPet(TEST_PET_ID).getVisits()).extracting(Visit::getId).containsExactly(PAST_VISIT_ID);
+	}
+
+	@Test
+	void theCancellationOfAPastVisitShouldBeRefused() throws Exception {
+		cancel(TEST_PET_ID, PAST_VISIT_ID).andExpect(redirectedUrl("/owners/" + TEST_OWNER_ID))
+			.andExpect(flash().attribute("error", englishText("visitCancellationRefused")))
+			.andExpect(flash().attributeCount(1));
+
+		assertThat(this.george.getPet(TEST_PET_ID).getVisits()).extracting(Visit::getId).contains(PAST_VISIT_ID);
+		verify(this.owners, never()).save(this.george);
+	}
+
+	@Test
+	void theCancellationOfAnotherOwnersVisitShouldBeRefused() throws Exception {
+		cancel(FOREIGN_PET_ID, UPCOMING_VISIT_ID).andExpect(redirectedUrl("/owners/" + TEST_OWNER_ID))
+			.andExpect(flash().attribute("error", englishText("visitCancellationRefused")));
+
+		assertThat(this.george.getPet(TEST_PET_ID).getVisits()).extracting(Visit::getId).contains(UPCOMING_VISIT_ID);
+		verify(this.owners, never()).save(this.george);
+	}
+
+	@Test
+	void theRepeatedCancellationShouldBeRefused() throws Exception {
+		cancel(TEST_PET_ID, UPCOMING_VISIT_ID).andExpect(flash().attribute("message", englishText("visitCancelled")));
+
+		cancel(TEST_PET_ID, UPCOMING_VISIT_ID).andExpect(redirectedUrl("/owners/" + TEST_OWNER_ID))
+			.andExpect(flash().attribute("error", englishText("visitCancellationRefused")));
+	}
+
+	@Test
+	void theConfirmationShouldBeWordedInTheLanguageTheReaderChose() throws Exception {
+		String germanConfirmation = this.messages.getMessage("visitCancelled", null, Locale.GERMAN);
+		assertThat(germanConfirmation).isNotEqualTo(englishText("visitCancelled"));
+
+		this.mockMvc
+			.perform(post("/owners/{ownerId}/pets/{petId}/visits/{visitId}/cancel", TEST_OWNER_ID, TEST_PET_ID,
+					UPCOMING_VISIT_ID)
+				.param("lang", "de"))
+			.andExpect(flash().attribute("message", germanConfirmation));
+	}
+
+	private ResultActions cancel(int petId, int visitId) throws Exception {
+		return this.mockMvc
+			.perform(post("/owners/{ownerId}/pets/{petId}/visits/{visitId}/cancel", TEST_OWNER_ID, petId, visitId));
+	}
+
+	private String englishText(String code) {
+		return this.messages.getMessage(code, null, Locale.ENGLISH);
+	}
+
+	private Visit visit(int id, LocalDate date) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		visit.setDate(date);
+		visit.setDescription("checkup");
+		return visit;
+	}
+
+}
