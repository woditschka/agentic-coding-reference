+	 * Retrieve the <code>Vet</code>s holding the named specialty. The whole name must
+	 * match; letter case is folded in the query rather than left to the store, so the
+	 * rule holds on every supported vendor.
+	 * <p>
+	 * Deliberately not <code>@Cacheable</code>: the name is caller-supplied text arriving
+	 * on an unauthenticated route, and the <code>vets</code> cache is bounded by neither
+	 * size nor eviction. Caching it would open the key space to callers.
+	 * @param name the specialty name to match, case-insensitively
+	 * @return a <code>Collection</code> of matching <code>Vet</code>s, empty if none hold
+	 * the specialty
+	 */
+	@Transactional(readOnly = true)
+	Collection<Vet> findBySpecialtiesNameIgnoreCase(String name) throws DataAccessException;
+
+	/**
+	 * Retrieve, in Pages, the <code>Vet</code>s holding the named specialty. Matching
+	 * follows {@link #findBySpecialtiesNameIgnoreCase(String)}, and the same reasoning
+	 * keeps this read out of the <code>vets</code> cache.
+	 * @param name the specialty name to match, case-insensitively
+	 * @param pageable the page to retrieve
+	 * @return a <code>Page</code> of matching <code>Vet</code>s, empty if none hold the
+	 * specialty
+	 */
+	@Transactional(readOnly = true)
+	Page<Vet> findBySpecialtiesNameIgnoreCase(String name, Pageable pageable) throws DataAccessException;
+
 }
