+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.Locale;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.MessageSource;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.samples.petclinic.vet.VetFixtures.fullName;
+import static org.springframework.samples.petclinic.vet.VetFixtures.specialty;
+import static org.springframework.samples.petclinic.vet.VetFixtures.vetHolding;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final Locale REQUEST_LOCALE = Locale.ENGLISH;
+
+	private static final Specialty RADIOLOGY = specialty(1, "radiology");
+
+	private static final Specialty SURGERY = specialty(2, "surgery");
+
+	private static final Specialty DENTISTRY = specialty(3, "dentistry");
+
+	private static final Specialty ONCOLOGY = specialty(4, "oncology");
+
+	private final Vet carter = vetHolding("James", "Carter");
+
+	private final Vet leary = vetHolding("Helen", "Leary", RADIOLOGY);
+
+	private final Vet douglas = vetHolding("Linda", "Douglas", DENTISTRY, SURGERY);
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private MessageSource messages;
+
+	@MockitoBean
+	private SpecialtyRepository specialties;
+
+	@MockitoBean
+	private VetRepository vets;
+
+	@BeforeEach
+	void setup() {
+		given(this.specialties.findSpecialties()).willReturn(List.of(DENTISTRY, RADIOLOGY, SURGERY, ONCOLOGY));
+		given(this.vets.findAll()).willReturn(List.of(this.carter, this.leary, this.douglas));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() throws Exception {
+		this.mockMvc.perform(specialtyDirectoryRequest())
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(content().string(containsString(DENTISTRY.getName())))
+			.andExpect(content().string(containsString(RADIOLOGY.getName())))
+			.andExpect(content().string(containsString(SURGERY.getName())))
+			.andExpect(content().string(containsString(ONCOLOGY.getName())));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowHoldingVeterinariansByFullName() throws Exception {
+		this.mockMvc.perform(specialtyDirectoryRequest())
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(fullName(this.leary))))
+			.andExpect(content().string(containsString(fullName(this.douglas))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() throws Exception {
+		this.mockMvc.perform(specialtyDirectoryRequest())
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString(fullName(this.carter)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowNoVeterinarianUnderASpecialtyNobodyHolds() throws Exception {
+		String page = renderedSpecialtyDirectory();
+
+		assertThat(rowFor(page, ONCOLOGY)).contains(this.messages.getMessage("none", null, REQUEST_LOCALE))
+			.doesNotContain(fullName(this.leary), fullName(this.douglas));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEverySpecialtyOnOnePage() throws Exception {
+		this.mockMvc.perform(specialtyDirectoryRequest())
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(DENTISTRY.getName())))
+			.andExpect(content().string(containsString(RADIOLOGY.getName())))
+			.andExpect(content().string(containsString(SURGERY.getName())))
+			.andExpect(content().string(containsString(ONCOLOGY.getName())))
+			.andExpect(content().string(not(containsString("?page="))));
+	}
+
+	private static MockHttpServletRequestBuilder specialtyDirectoryRequest() {
+		return get("/specialties.html").locale(REQUEST_LOCALE);
+	}
+
+	private String renderedSpecialtyDirectory() throws Exception {
+		return this.mockMvc.perform(specialtyDirectoryRequest())
+			.andExpect(status().isOk())
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+	}
+
+	/**
+	 * The table row the page devotes to one specialty: everything from the specialty's
+	 * name up to the end of its row, which is the cell listing its veterinarians.
+	 */
+	private static String rowFor(String page, Specialty specialty) {
+		int nameAt = page.indexOf(specialty.getName());
+		assertThat(nameAt).as("start of the row for specialty %s", specialty.getName()).isNotNegative();
+		int rowEnd = page.indexOf("</tr>", nameAt);
+		assertThat(rowEnd).as("end of the row for specialty %s", specialty.getName()).isNotNegative();
+		return page.substring(nameAt, rowEnd);
+	}
+
+}
