+package org.springframework.samples.petclinic.vet;
+
+/**
+ * Veterinarian and specialty fixtures shared by the tests in this package.
+ */
+final class VetFixtures {
+
+	private VetFixtures() {
+	}
+
+	static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	/**
+	 * The specialties a veterinarian holds reach the directory as instances distinct from
+	 * the ones the store lists, so each held specialty is copied into a separate instance
+	 * carrying the same identity.
+	 */
+	static Vet vetHolding(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty(specialty.getId(), specialty.getName()));
+		}
+		return vet;
+	}
+
+	/**
+	 * The name a veterinarian is presented under, as the specialty directory renders it.
+	 */
+	static String fullName(Vet vet) {
+		return vet.getFirstName() + " " + vet.getLastName();
+	}
+
+}
