+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * The clinic's specialties, each with the veterinarians who hold it.
+ * <p>
+ * The veterinarian-specialty association is mapped on {@link Vet} alone, so a specialty
+ * no veterinarian holds is unreachable from the veterinarian side. This directory is
+ * therefore derived from both sides: the specialties the clinic knows, and the
+ * veterinarians read separately. A specialty nobody holds still gets an entry, with no
+ * veterinarian under it; a veterinarian holding nothing enters no entry at all.
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	/**
+	 * Veterinarians are presented last name first so that two veterinarians sharing a
+	 * last name still fall in a fixed order.
+	 */
+	private static final Comparator<Vet> BY_NAME = Comparator.<Vet, String>comparing(Person::getLastName)
+		.thenComparing(Person::getFirstName);
+
+	public SpecialtyDirectory {
+		Objects.requireNonNull(entries, "entries must not be null");
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Group the given veterinarians under the given specialties.
+	 * @param specialties the specialties the clinic knows, in the order they are to be
+	 * presented
+	 * @param veterinarians the clinic's veterinarians, in any order
+	 * @return one entry per given specialty, each holding the veterinarians who hold that
+	 * specialty ordered by last name then first name
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Objects.requireNonNull(specialties, "specialties must not be null");
+		Objects.requireNonNull(veterinarians, "veterinarians must not be null");
+
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+		List<Entry> entries = new ArrayList<>(specialties.size());
+		for (Specialty specialty : specialties) {
+			Objects.requireNonNull(specialty, "specialties must not contain null");
+			List<Vet> holders = holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of());
+			entries.add(new Entry(specialty.getName(), holders.stream().sorted(BY_NAME).toList()));
+		}
+		return new SpecialtyDirectory(entries);
+	}
+
+	/**
+	 * A veterinarian's own {@link Specialty} instances are distinct objects from the ones
+	 * the specialty side reads, so the two sides are matched by identity rather than by
+	 * object.
+	 */
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			Objects.requireNonNull(veterinarian, "veterinarians must not contain null");
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holders;
+	}
+
+	/**
+	 * One specialty, under the name it is stored as, with the veterinarians holding it.
+	 */
+	public record Entry(String name, List<Vet> veterinarians) {
+
+		public Entry {
+			Objects.requireNonNull(name, "name must not be null");
+			Objects.requireNonNull(veterinarians, "veterinarians must not be null");
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+}
