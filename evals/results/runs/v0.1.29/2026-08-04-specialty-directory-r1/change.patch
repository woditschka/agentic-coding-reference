+
+/**
+ * Test class for {@link SpecialtyDirectory}, the grouping of the clinic's veterinarians
+ * under the specialties they hold.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final Specialty RADIOLOGY = specialty(1, "radiology");
+
+	private static final Specialty SURGERY = specialty(2, "surgery");
+
+	private static final Specialty DENTISTRY = specialty(3, "dentistry");
+
+	@Test
+	void theSpecialtyDirectoryShouldListAnUnheldSpecialtyWithNoVeterinarians() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(RADIOLOGY), List.of());
+
+		assertThat(directory.entries()).singleElement().satisfies(entry -> {
+			assertThat(entry.name()).isEqualTo("radiology");
+			assertThat(entry.veterinarians()).isEmpty();
+		});
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowAVeterinarianUnderEachSpecialtyTheyHold() {
+		Vet linda = vetHolding("Linda", "Douglas", DENTISTRY, SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(DENTISTRY, SURGERY), List.of(linda));
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::name)
+			.containsExactly("dentistry", "surgery");
+		assertThat(directory.entries()).allSatisfy(entry -> assertThat(entry.veterinarians()).containsExactly(linda));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentSpecialtiesAndVeterinariansInAStableOrder() {
+		Vet henry = vetHolding("Henry", "Stevens", RADIOLOGY);
+		Vet helen = vetHolding("Helen", "Leary", RADIOLOGY);
+		Vet rafael = vetHolding("Rafael", "Ortega", SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(SURGERY, RADIOLOGY),
+				List.of(henry, helen, rafael));
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::name)
+			.containsExactly("surgery", "radiology");
+		assertThat(directory.entries().get(1).veterinarians()).containsExactly(helen, henry);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRejectNullArguments() {
+		assertThatNullPointerException().isThrownBy(() -> SpecialtyDirectory.of(null, List.of()));
+		assertThatNullPointerException().isThrownBy(() -> SpecialtyDirectory.of(List.of(RADIOLOGY), null));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotBeModifiableThroughTheCollectionsItExposes() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(RADIOLOGY),
+				List.of(vetHolding("Helen", "Leary", RADIOLOGY)));
+
+		assertThatExceptionOfType(UnsupportedOperationException.class).isThrownBy(() -> directory.entries().clear());
+		assertThatExceptionOfType(UnsupportedOperationException.class)
+			.isThrownBy(() -> directory.entries().get(0).veterinarians().clear());
+	}
+
+}
