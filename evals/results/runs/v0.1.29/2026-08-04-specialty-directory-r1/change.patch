+package org.springframework.samples.petclinic.vet;
+
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.GetMapping;
+
+/**
+ * Publishes the veterinarian-specialty directory from the specialty side: every specialty
+ * the clinic knows, with the veterinarians holding it.
+ */
+@Controller
+class SpecialtyController {
+
+	private static final String VIEW_SPECIALTY_LIST = "vets/specialtyList";
+
+	private final SpecialtyRepository specialties;
+
+	private final VetRepository vets;
+
+	public SpecialtyController(SpecialtyRepository specialties, VetRepository vets) {
+		this.specialties = specialties;
+		this.vets = vets;
+	}
+
+	@GetMapping("/specialties.html")
+	public String showSpecialtyDirectory(Model model) {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(this.specialties.findSpecialties(), this.vets.findAll());
+		model.addAttribute("specialtyDirectory", directory);
+		return VIEW_SPECIALTY_LIST;
+	}
+
+}
