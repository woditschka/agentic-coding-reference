+	 * Normalizes the specialty a request names: surrounding whitespace is stripped, and a
+	 * missing, empty or whitespace-only value becomes {@code null}, meaning no specialty
+	 * was named. That is the convention the empty owner search follows. Both vet list
+	 * routes normalize through this one method so they cannot drift apart on it.
+	 * <p>
+	 * A {@code null} return must reach the unnarrowed {@code findAll}, never the narrowed
+	 * query: the narrowing matches a whole specialty name, so an empty name would match
+	 * no veterinarian at all rather than every one of them.
+	 * @param specialty the specialty named in the request, possibly {@code null}
+	 * @return the specialty to narrow the listing to, or {@code null} to list every
+	 * veterinarian
+	 */
+	private String namedSpecialty(String specialty) {
+		if (specialty == null) {
+			return null;
+		}
+		String stripped = specialty.strip();
+		return stripped.isEmpty() ? null : stripped;
+	}
+
 }
