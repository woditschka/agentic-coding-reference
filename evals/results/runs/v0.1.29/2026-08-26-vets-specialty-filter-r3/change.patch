+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Collection;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.data.domain.Pageable;
+
+/**
+ * Tests of the specialty-narrowing reads on {@link VetRepository}, against a real
+ * database and the specialties it is seeded with.
+ * <p>
+ * Case-insensitive matching and whole-name-rather-than-prefix matching live in the SQL
+ * the derived query generates, so a stubbed repository cannot observe them and
+ * {@link VetControllerTests} cannot assert them. They are asserted here.
+ */
+@DataJpaTest
+// Ensure that if the mysql profile is active we connect to the real database:
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VetRepositoryTests {
+
+	private static final String HELD_SPECIALTY_IN_ANOTHER_CASE = "RaDiOlOgY";
+
+	private static final String PREFIX_OF_A_HELD_SPECIALTY = "radio";
+
+	private static final List<String> VETS_HOLDING_THAT_SPECIALTY = List.of("Leary", "Stevens");
+
+	private static final Pageable ANY_PAGE = PageRequest.of(0, 10);
+
+	@Autowired
+	private VetRepository vets;
+
+	@Test
+	void theVetDirectoryShouldMatchTheSpecialtyNameIgnoringCase() {
+		List<Vet> narrowed = this.vets.findBySpecialtiesNameIgnoreCase(HELD_SPECIALTY_IN_ANOTHER_CASE, ANY_PAGE)
+			.getContent();
+
+		assertThat(narrowed).extracting(Vet::getLastName)
+			.containsExactlyInAnyOrderElementsOf(VETS_HOLDING_THAT_SPECIALTY);
+	}
+
+	@Test
+	void theVetDirectoryShouldNotMatchPartOfASpecialtyName() {
+		List<Vet> narrowed = this.vets.findBySpecialtiesNameIgnoreCase(PREFIX_OF_A_HELD_SPECIALTY, ANY_PAGE)
+			.getContent();
+
+		assertThat(narrowed).isEmpty();
+	}
+
+	@Test
+	void theMachineReadableVetListShouldMatchTheSpecialtyNameIgnoringCase() {
+		Collection<Vet> narrowed = this.vets.findBySpecialtiesNameIgnoreCase(HELD_SPECIALTY_IN_ANOTHER_CASE);
+
+		assertThat(narrowed).extracting(Vet::getLastName)
+			.containsExactlyInAnyOrderElementsOf(VETS_HOLDING_THAT_SPECIALTY);
+	}
+
+	@Test
+	void theMachineReadableVetListShouldNotMatchPartOfASpecialtyName() {
+		Collection<Vet> narrowed = this.vets.findBySpecialtiesNameIgnoreCase(PREFIX_OF_A_HELD_SPECIALTY);
+
+		assertThat(narrowed).isEmpty();
+	}
+
+}
