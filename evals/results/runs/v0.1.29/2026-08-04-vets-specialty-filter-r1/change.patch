+
+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Collection;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageRequest;
+
+/**
+ * Tests for the specialty filter on {@link VetRepository}, run against a real database.
+ * <p>
+ * Whole-name matching and case folding are properties of the emitted query, so they are
+ * asserted here rather than through a mocked repository. The seeded data records Helen
+ * Leary and Henry Stevens under <code>radiology</code>, Linda Douglas and Rafael Ortega
+ * under <code>surgery</code>, and Linda Douglas alone under <code>dentistry</code>.
+ */
+@DataJpaTest
+// Ensure that if the mysql profile is active we connect to the real database:
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VetRepositoryTests {
+
+	private static final PageRequest FIRST_PAGE_OF_TEN = PageRequest.of(0, 10);
+
+	@Autowired
+	private VetRepository vets;
+
+	@Test
+	void theSpecialtyFilterShouldMatchTheWholeSpecialtyName() {
+		Collection<Vet> radiologists = this.vets.findDistinctBySpecialtiesNameIgnoreCase("radiology");
+
+		assertThat(radiologists).extracting(Vet::getLastName).containsExactlyInAnyOrder("Leary", "Stevens");
+	}
+
+	@Test
+	void theSpecialtyFilterShouldIgnoreLetterCase() {
+		Collection<Vet> radiologists = this.vets.findDistinctBySpecialtiesNameIgnoreCase("RaDioLogY");
+
+		assertThat(radiologists).extracting(Vet::getLastName).containsExactlyInAnyOrder("Leary", "Stevens");
+	}
+
+	@Test
+	void theSpecialtyFilterShouldNotMatchAPartialSpecialtyName() {
+		Collection<Vet> matches = this.vets.findDistinctBySpecialtiesNameIgnoreCase("radio");
+
+		assertThat(matches).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyFilterShouldYieldAnEmptyDirectoryWhenNoVetHoldsTheSpecialty() {
+		Collection<Vet> matches = this.vets.findDistinctBySpecialtiesNameIgnoreCase("cardiology");
+
+		assertThat(matches).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyFilterShouldFindAVetUnderEachSpecialtyItHolds() {
+		Collection<Vet> surgeons = this.vets.findDistinctBySpecialtiesNameIgnoreCase("surgery");
+		Collection<Vet> dentists = this.vets.findDistinctBySpecialtiesNameIgnoreCase("dentistry");
+
+		assertThat(surgeons).extracting(Vet::getLastName).contains("Douglas");
+		assertThat(dentists).extracting(Vet::getLastName).contains("Douglas");
+	}
+
+	@Test
+	void theNarrowedPageShouldCountOnlyTheMatchingVets() {
+		Page<Vet> radiologists = this.vets.findDistinctBySpecialtiesNameIgnoreCase("radiology", FIRST_PAGE_OF_TEN);
+
+		assertThat(radiologists.getTotalElements()).isEqualTo(2);
+		assertThat(radiologists.getContent()).extracting(Vet::getLastName)
+			.containsExactlyInAnyOrder("Leary", "Stevens");
+	}
+
+	@Test
+	void theNarrowedPageShouldSpanTheNarrowedDirectoryOnly() {
+		Page<Vet> firstOfOne = this.vets.findDistinctBySpecialtiesNameIgnoreCase("radiology", PageRequest.of(0, 1));
+
+		assertThat(firstOfOne.getTotalPages()).isEqualTo(2);
+		assertThat(firstOfOne.getContent()).hasSize(1);
+	}
+
+}
