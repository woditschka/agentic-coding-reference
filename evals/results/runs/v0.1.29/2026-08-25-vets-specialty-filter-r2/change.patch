+	 * A missing, empty or whitespace-only specialty means the whole directory, mirroring
+	 * the empty owner search; any other value is matched with its padding stripped.
+	 */
+	private String normalizeSpecialty(String specialty) {
+		return specialty == null ? "" : specialty.strip();
+	}
