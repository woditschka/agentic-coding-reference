+import java.util.Map;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.entry;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the in-memory inversion of the
+ * veterinarian-specialty association.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int DENTISTRY_ID = 3;
+
+	private static final String SOME_SPECIALTY_NAME = "radiology";
+
+	private Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private Map<String, List<String>> namesBySpecialty(SpecialtyDirectory directory) {
+		Map<String, List<String>> names = new LinkedHashMap<>();
+		for (SpecialtyDirectory.Holding holding : directory.holdings()) {
+			names.put(holding.specialty().getName(), fullNames(holding.veterinarians()));
+		}
+		return names;
+	}
+
+	private List<String> fullNames(Collection<Vet> veterinarians) {
+		return veterinarians.stream().map(vet -> vet.getFirstName() + " " + vet.getLastName()).toList();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEverySpecialtyHeld() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, "radiology");
+		Specialty surgery = createASpecialty(SURGERY_ID, "surgery");
+		Vet helen = createAVet("Helen", "Leary", radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(namesBySpecialty(directory)).containsExactly(entry("radiology", List.of("Helen Leary")),
+				entry("surgery", List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, "radiology");
+		Specialty dentistry = createASpecialty(DENTISTRY_ID, "dentistry");
+		Vet helen = createAVet("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, radiology), List.of(helen));
+
+		assertThat(namesBySpecialty(directory)).containsExactly(entry("dentistry", List.of()),
+				entry("radiology", List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, SOME_SPECIALTY_NAME);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+		Vet james = createAVet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, james));
+
+		assertThat(namesBySpecialty(directory)).containsExactly(entry(SOME_SPECIALTY_NAME, List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastNameThenFirstName() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, SOME_SPECIALTY_NAME);
+		Vet rafael = createAVet("Rafael", "Ortega", radiology);
+		Vet helenLeary = createAVet("Helen", "Leary", radiology);
+		Vet adamLeary = createAVet("Adam", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(rafael, helenLeary, adamLeary));
+
+		assertThat(namesBySpecialty(directory))
+			.containsExactly(entry(SOME_SPECIALTY_NAME, List.of("Adam Leary", "Helen Leary", "Rafael Ortega")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepTheGivenSpecialtyOrder() {
+		Specialty dentistry = createASpecialty(DENTISTRY_ID, "dentistry");
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, "radiology");
+		Specialty surgery = createASpecialty(SURGERY_ID, "surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, radiology, surgery), List.of());
+
+		assertThat(directory.holdings()).extracting(listed -> listed.specialty().getName())
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenTheClinicKnowsNoSpecialty() {
+		Vet james = createAVet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(james));
+
+		assertThat(directory.holdings()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchASpecialtyLoadedAsASeparateInstance() {
+		Specialty listedRadiology = createASpecialty(RADIOLOGY_ID, SOME_SPECIALTY_NAME);
+		Specialty heldRadiology = createASpecialty(RADIOLOGY_ID, SOME_SPECIALTY_NAME);
+		Vet helen = createAVet("Helen", "Leary", heldRadiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(listedRadiology), List.of(helen));
+
+		assertThat(namesBySpecialty(directory)).containsExactly(entry(SOME_SPECIALTY_NAME, List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotChangeWhenTheGivenCollectionsChange() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, SOME_SPECIALTY_NAME);
+		List<Specialty> specialties = new ArrayList<>(List.of(radiology));
+		List<Vet> veterinarians = new ArrayList<>(List.of(createAVet("Helen", "Leary", radiology)));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, veterinarians);
+		specialties.add(createASpecialty(SURGERY_ID, "surgery"));
+		veterinarians.add(createAVet("Linda", "Douglas", radiology));
+
+		assertThat(namesBySpecialty(directory)).containsExactly(entry(SOME_SPECIALTY_NAME, List.of("Helen Leary")));
+	}
+
+}
