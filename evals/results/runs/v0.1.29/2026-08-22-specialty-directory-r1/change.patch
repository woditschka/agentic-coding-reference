+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * The veterinarian-specialty association seen from the specialty side: every specialty
+ * the clinic knows, each paired with the veterinarians holding it.
+ * <p>
+ * The JPA mapping runs the other way — {@link Vet} owns the association and
+ * {@link Specialty} cannot reach back — so the inverse direction is derived here in
+ * memory rather than by a query or an inverse mapping. See {@code
+ * docs/adr/2026-08-22-in-memory-specialty-to-veterinarian-inversion.md}.
+ * <p>
+ * The type is public because Thymeleaf reads model attributes through SpEL reflection,
+ * which cannot see accessors declared on a package-private class.
+ *
+ * @param holdings one per specialty, in the order the specialties were supplied
+ */
+public record SpecialtyDirectory(List<Holding> holdings) {
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator
+		.<Vet, String>comparing(Person::getLastName)
+		.thenComparing(Person::getFirstName);
+
+	public SpecialtyDirectory {
+		holdings = List.copyOf(holdings);
+	}
+
+	/**
+	 * Pair each specialty with the veterinarians holding it.
+	 * <p>
+	 * Specialties keep the order they are given in; the veterinarians under each are
+	 * ordered by last name then first name, because {@code VetRepository.findAll()}
+	 * returns an unordered collection and a veterinarian's specialties are held in a
+	 * {@link java.util.HashSet}.
+	 * @param specialties every specialty to list, in presentation order
+	 * @param veterinarians the clinic's veterinarians, with their specialties loaded
+	 * @return the directory; empty when no specialty is given
+	 */
+	public static SpecialtyDirectory of(List<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = holdersBySpecialtyId(veterinarians);
+		List<Holding> holdings = specialties.stream()
+			.map(specialty -> new Holding(specialty, holdersOf(specialty, holders)))
+			.toList();
+		return new SpecialtyDirectory(holdings);
+	}
+
+	/**
+	 * Index the veterinarians by the identity of each specialty they hold. The
+	 * specialties a veterinarian carries and those being listed are separately loaded
+	 * instances of the same rows — the veterinarians come from a cached query — so they
+	 * are matched by persisted identity rather than by object identity.
+	 */
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holders;
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Map<Integer, List<Vet>> holders) {
+		return holders.getOrDefault(specialty.getId(), List.of()).stream().sorted(BY_LAST_THEN_FIRST_NAME).toList();
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it.
+	 *
+	 * @param specialty the specialty, named as the clinic stores it
+	 * @param veterinarians those holding it, by last name then first name; empty when
+	 * nobody holds it
+	 */
+	public record Holding(Specialty specialty, List<Vet> veterinarians) {
+
+		public Holding {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+}
