+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+import org.springframework.transaction.annotation.Transactional;
+
+import jakarta.persistence.EntityManager;
+import jakarta.persistence.PersistenceContext;
+
+/**
+ * Tests for correcting a booked visit (REQ-VIS-003), driven through the real web stack
+ * against the seeded H2 database. The criterion that matters — a correction leaves the
+ * pet with the same number of visits — is invisible to a stubbed repository, so no
+ * repository stub is used here.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+@Transactional
+class VisitCorrectionIntegrationTests {
+
+	private static final int OWNER_WITH_A_BOOKED_VISIT = 6;
+
+	private static final int PET_WITH_A_BOOKED_VISIT = 7;
+
+	private static final int THE_OWNERS_OTHER_PET = 8;
+
+	private static final int OWNER_OF_ANOTHER_PET = 1;
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private OwnerRepository owners;
+
+	@PersistenceContext
+	private EntityManager entityManager;
+
+	@Test
+	void theVisitCorrectionFormShouldShowTheRecordedDateAndDescription() throws Exception {
+		Visit booked = bookedVisit();
+
+		mockMvc
+			.perform(get("/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit", OWNER_WITH_A_BOOKED_VISIT,
+					PET_WITH_A_BOOKED_VISIT, booked.getId()))
+			.andExpect(status().isOk())
+			.andExpect(view().name("pets/createOrUpdateVisitForm"))
+			.andExpect(content().string(containsString("value=\"" + booked.getDate() + "\"")))
+			.andExpect(content().string(containsString("value=\"" + booked.getDescription() + "\"")));
+	}
+
+	@Test
+	void theVisitCorrectionShouldReplaceTheDetailsInPlace() throws Exception {
+		Visit booked = bookedVisit();
+		LocalDate correctedDate = LocalDate.now().plusWeeks(1);
+
+		correct(booked, correctedDate.toString(), "booster shot").andExpect(status().is3xxRedirection())
+			.andExpect(view().name("redirect:/owners/{ownerId}"));
+
+		flushAndClear();
+		Visit corrected = pet().getVisit(booked.getId());
+		assertThat(corrected.getDate()).isEqualTo(correctedDate);
+		assertThat(corrected.getDescription()).isEqualTo("booster shot");
+	}
+
+	@Test
+	void theVisitCorrectionShouldNotAddASecondVisitToThePet() throws Exception {
+		int visitsBeforeTheCorrection = pet().getVisits().size();
+		Visit booked = bookedVisit();
+
+		correct(booked, LocalDate.now().plusWeeks(1).toString(), "booster shot").andExpect(status().is3xxRedirection());
+
+		flushAndClear();
+		assertThat(pet().getVisits()).hasSize(visitsBeforeTheCorrection);
+	}
+
+	@Test
+	void theVisitCorrectionShouldBeRefusedWhenTheDescriptionIsBlank() throws Exception {
+		Visit booked = bookedVisit();
+		LocalDate recordedDate = booked.getDate();
+		String recordedDescription = booked.getDescription();
+
+		correct(booked, LocalDate.now().plusWeeks(1).toString(), "").andExpect(status().isOk())
+			.andExpect(view().name("pets/createOrUpdateVisitForm"))
+			.andExpect(model().attributeHasFieldErrors("visit", "description"));
+
+		assertThatTheVisitStillReads(booked.getId(), recordedDate, recordedDescription);
+	}
+
+	@Test
+	void theVisitCorrectionShouldBeRefusedWhenTheDateIsNotInTheFuture() throws Exception {
+		Visit booked = bookedVisit();
+		LocalDate recordedDate = booked.getDate();
+		String recordedDescription = booked.getDescription();
+
+		correct(booked, LocalDate.now().toString(), "booster shot").andExpect(status().isOk())
+			.andExpect(view().name("pets/createOrUpdateVisitForm"))
+			.andExpect(model().attributeHasFieldErrorCode("visit", "date", "typeMismatch.visitDate"));
+
+		assertThatTheVisitStillReads(booked.getId(), recordedDate, recordedDescription);
+	}
+
+	@Test
+	void theVisitCorrectionShouldBeRefusedWhenThePetDoesNotBelongToTheOwner() {
+		Visit booked = bookedVisit();
+
+		assertThatExceptionOfType(Exception.class)
+			.isThrownBy(() -> this.mockMvc.perform(get("/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit",
+					OWNER_OF_ANOTHER_PET, PET_WITH_A_BOOKED_VISIT, booked.getId())))
+			.withRootCauseInstanceOf(IllegalArgumentException.class);
+	}
+
+	@Test
+	void theVisitCorrectionShouldBeRefusedWhenTheVisitDoesNotBelongToThePet() {
+		Visit anotherPetsVisit = visitOfTheOtherPet();
+
+		assertThatExceptionOfType(Exception.class)
+			.isThrownBy(() -> correct(anotherPetsVisit, LocalDate.now().plusWeeks(1).toString(), "booster shot"))
+			.withRootCauseInstanceOf(IllegalArgumentException.class);
+	}
+
+	/**
+	 * Asserts that the recorded visit is untouched. The persistence context is emptied
+	 * without flushing first, so what the refused request left in memory is discarded and
+	 * the assertions read the row.
+	 */
+	private void assertThatTheVisitStillReads(Integer visitId, LocalDate date, String description) {
+		this.entityManager.clear();
+		Visit recorded = pet().getVisit(visitId);
+		assertThat(recorded.getDate()).isEqualTo(date);
+		assertThat(recorded.getDescription()).isEqualTo(description);
+	}
+
+	private ResultActions correct(Visit visit, String date, String description) throws Exception {
+		return this.mockMvc
+			.perform(post("/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit", OWNER_WITH_A_BOOKED_VISIT,
+					PET_WITH_A_BOOKED_VISIT, visit.getId())
+				.param("date", date)
+				.param("description", description));
+	}
+
+	/**
+	 * Forces the pending changes to the database and empties the persistence context, so
+	 * that the assertions that follow read rows rather than the instances the request
+	 * left behind.
+	 */
+	private void flushAndClear() {
+		this.entityManager.flush();
+		this.entityManager.clear();
+	}
+
+	private Visit bookedVisit() {
+		Pet pet = pet();
+		return pet.getVisits().stream().min(Comparator.comparing(Visit::getId)).orElseThrow();
+	}
+
+	/**
+	 * A visit of the owner's other pet — booked under the same owner, but not under the
+	 * pet the correction addresses.
+	 */
+	private Visit visitOfTheOtherPet() {
+		Owner owner = this.owners.findById(OWNER_WITH_A_BOOKED_VISIT).orElseThrow();
+		Pet otherPet = owner.getPet(THE_OWNERS_OTHER_PET);
+		return otherPet.getVisits().stream().min(Comparator.comparing(Visit::getId)).orElseThrow();
+	}
+
+	private Pet pet() {
+		Owner owner = this.owners.findById(OWNER_WITH_A_BOOKED_VISIT).orElseThrow();
+		Pet pet = owner.getPet(PET_WITH_A_BOOKED_VISIT);
+		assertThat(pet.getVisits()).isNotEmpty();
+		return pet;
+	}
+
+}
