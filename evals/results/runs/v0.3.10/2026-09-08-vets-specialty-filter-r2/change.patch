+
+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Collection;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageRequest;
+
+/**
+ * Tests the matching rule for narrowing the veterinarian directory to one specialty. The
+ * rule lives inside the derived query, so these tests run against the real repository and
+ * the seeded database rather than a double.
+ */
+@DataJpaTest
+// Ensure that if the mysql profile is active we connect to the real database:
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VetRepositoryTests {
+
+	private static final String A_SPECIALTY_TWO_VETS_HOLD = "radiology";
+
+	private static final List<String> VETS_HOLDING_RADIOLOGY = List.of("Leary", "Stevens");
+
+	private static final String A_SPECIALTY_HELD_ALONGSIDE_ANOTHER = "surgery";
+
+	private static final List<String> VETS_HOLDING_SURGERY = List.of("Douglas", "Ortega");
+
+	private static final String THE_OTHER_SPECIALTY_OF_THE_SURGERY_VET = "dentistry";
+
+	private static final List<String> VETS_HOLDING_DENTISTRY = List.of("Douglas");
+
+	private static final String A_SPECIALTY_NO_VET_HOLDS = "cardiology";
+
+	private static final int ONE_VET_PER_PAGE = 1;
+
+	private static final int FIRST_PAGE = 0;
+
+	@Autowired
+	private VetRepository vets;
+
+	@Test
+	void theVetDirectoryShouldListOnlyVetsHoldingTheRequestedSpecialty() {
+		Collection<Vet> found = this.vets.findBySpecialtiesNameIgnoreCase(A_SPECIALTY_TWO_VETS_HOLD);
+
+		assertThat(lastNamesOf(found)).containsExactlyInAnyOrderElementsOf(VETS_HOLDING_RADIOLOGY);
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { "RADIOLOGY", "Radiology", "rAdIoLoGy" })
+	void theVetDirectoryShouldMatchTheSpecialtyRegardlessOfLetterCase(String differentlyCasedSpecialty) {
+		Collection<Vet> found = this.vets.findBySpecialtiesNameIgnoreCase(differentlyCasedSpecialty);
+
+		assertThat(lastNamesOf(found)).containsExactlyInAnyOrderElementsOf(VETS_HOLDING_RADIOLOGY);
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { "radio", "ology", "radiologyy" })
+	void theVetDirectoryShouldNotMatchPartOfASpecialtyName(String notTheWholeSpecialtyName) {
+		Collection<Vet> found = this.vets.findBySpecialtiesNameIgnoreCase(notTheWholeSpecialtyName);
+
+		assertThat(found).isEmpty();
+	}
+
+	// The narrowest reading of an open product question: a padded value is matched as
+	// given, unlike the owner search, which strips its search value first.
+	@ParameterizedTest
+	@ValueSource(strings = { " radiology", "radiology " })
+	void theVetDirectoryShouldNotMatchASpecialtyNamePaddedWithSpaces(String paddedSpecialtyName) {
+		Collection<Vet> found = this.vets.findBySpecialtiesNameIgnoreCase(paddedSpecialtyName);
+
+		assertThat(found).isEmpty();
+	}
+
+	@Test
+	void theVetDirectoryShouldListNobodyWhenNoVetHoldsTheSpecialty() {
+		Collection<Vet> found = this.vets.findBySpecialtiesNameIgnoreCase(A_SPECIALTY_NO_VET_HOLDS);
+
+		assertThat(found).isEmpty();
+	}
+
+	@Test
+	void theVetDirectoryShouldListAVetHoldingSeveralSpecialtiesUnderEachOfThem() {
+		Collection<Vet> holdingSurgery = this.vets.findBySpecialtiesNameIgnoreCase(A_SPECIALTY_HELD_ALONGSIDE_ANOTHER);
+		Collection<Vet> holdingDentistry = this.vets
+			.findBySpecialtiesNameIgnoreCase(THE_OTHER_SPECIALTY_OF_THE_SURGERY_VET);
+
+		assertThat(lastNamesOf(holdingSurgery)).containsExactlyInAnyOrderElementsOf(VETS_HOLDING_SURGERY);
+		assertThat(lastNamesOf(holdingDentistry)).containsExactlyInAnyOrderElementsOf(VETS_HOLDING_DENTISTRY);
+	}
+
+	@Test
+	void thePagedVetDirectoryShouldCountOnlyVetsHoldingTheRequestedSpecialty() {
+		Page<Vet> firstPage = this.vets.findBySpecialtiesNameIgnoreCase(A_SPECIALTY_HELD_ALONGSIDE_ANOTHER,
+				PageRequest.of(FIRST_PAGE, ONE_VET_PER_PAGE));
+
+		assertThat(firstPage.getContent()).hasSize(ONE_VET_PER_PAGE);
+		assertThat(firstPage.getTotalElements()).isEqualTo(VETS_HOLDING_SURGERY.size());
+	}
+
+	private List<String> lastNamesOf(Collection<Vet> found) {
+		return found.stream().map(Vet::getLastName).toList();
+	}
+
+}
