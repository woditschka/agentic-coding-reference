+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link Pet}, covering the visit lookup a correction request resolves
+ * through.
+ */
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 2;
+
+	private static final int UNBOOKED_VISIT_ID = 8;
+
+	/**
+	 * A visit that was never saved carries no identifier, so a lookup for none would find
+	 * it if the identifier alone decided the match.
+	 */
+	private static final Integer NO_VISIT_ID = null;
+
+	private static final LocalDate ANY_VISIT_DATE = LocalDate.now().plusDays(1);
+
+	private static final String ANY_VISIT_DESCRIPTION = "Annual rabies shot";
+
+	@Test
+	void thePetShouldReturnTheVisitBookedUnderTheGivenIdentifier() {
+		Visit bookedVisit = createAVisitBookedUnder(BOOKED_VISIT_ID);
+		Pet pet = createAPetHolding(bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldReturnNoVisitForAnIdentifierItDoesNotHold() {
+		Pet pet = createAPetHolding(createAVisitBookedUnder(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(UNBOOKED_VISIT_ID)).isNull();
+	}
+
+	@Test
+	void thePetShouldReturnNoVisitThatHasNotBeenSavedYet() {
+		Pet pet = createAPetHolding(createAnUnsavedVisit());
+
+		assertThat(pet.getVisit(NO_VISIT_ID)).isNull();
+	}
+
+	private Pet createAPetHolding(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+	private Visit createAVisitBookedUnder(int visitId) {
+		Visit visit = createAnUnsavedVisit();
+		visit.setId(visitId);
+		return visit;
+	}
+
+	private Visit createAnUnsavedVisit() {
+		Visit visit = new Visit();
+		visit.setDate(ANY_VISIT_DATE);
+		visit.setDescription(ANY_VISIT_DESCRIPTION);
+		return visit;
+	}
+
+}
