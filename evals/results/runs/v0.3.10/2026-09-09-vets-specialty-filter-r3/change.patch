+	 * the requirement states — whole name, case ignored — so a controller test can show
+	 * that the controller hands the caller's value to that rule untouched.
+	 */
+	private static final class InMemoryVetRepository implements VetRepository {
+
+		private final List<Vet> veterinarians;
+
+		private InMemoryVetRepository(List<Vet> veterinarians) {
+			this.veterinarians = List.copyOf(veterinarians);
+		}
+
+		@Override
+		public Collection<Vet> findAll() {
+			return this.veterinarians;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			return pageOf(this.veterinarians, pageable);
+		}
+
+		@Override
+		public Collection<Vet> findDistinctBySpecialtiesNameIgnoreCase(String specialtyName) {
+			return holdersOf(specialtyName);
+		}
+
+		@Override
+		public Page<Vet> findDistinctBySpecialtiesNameIgnoreCase(String specialtyName, Pageable pageable) {
+			return pageOf(holdersOf(specialtyName), pageable);
+		}
+
+		private List<Vet> holdersOf(String specialtyName) {
+			return this.veterinarians.stream().filter(veterinarian -> holds(veterinarian, specialtyName)).toList();
+		}
+
+		private static boolean holds(Vet veterinarian, String specialtyName) {
+			return veterinarian.getSpecialties()
+				.stream()
+				.anyMatch(specialty -> specialty.getName().equalsIgnoreCase(specialtyName));
+		}
+
+		private static Page<Vet> pageOf(List<Vet> matches, Pageable pageable) {
+			int from = Math.min((int) pageable.getOffset(), matches.size());
+			int to = Math.min(from + pageable.getPageSize(), matches.size());
+			return new PageImpl<>(new ArrayList<>(matches.subList(from, to)), pageable, matches.size());
+		}
+
 	}
 
