+package org.springframework.samples.petclinic.vet;
+
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Construction vocabulary shared by the veterinarian test suites. Identifiers are
+ * generated so that separately built fixtures never collide, which matters because the
+ * specialty directory matches a veterinarian to a specialty by stored identity.
+ */
+final class VetFixtures {
+
+	private static final AtomicInteger NEXT_ID = new AtomicInteger(1);
+
+	private static final String ANY_FIRST_NAME = "Some";
+
+	private static final String ANY_LAST_NAME = "Veterinarian";
+
+	private VetFixtures() {
+	}
+
+	static Specialty aSpecialtyNamed(String name) {
+		Specialty specialty = anUnsavedSpecialtyNamed(name);
+		specialty.setId(NEXT_ID.getAndIncrement());
+		return specialty;
+	}
+
+	static Specialty anUnsavedSpecialtyNamed(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return specialty;
+	}
+
+	static Vet aVeterinarian(String firstName, String lastName, Specialty... specialtiesHeld) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(NEXT_ID.getAndIncrement());
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		for (Specialty specialty : specialtiesHeld) {
+			veterinarian.addSpecialty(specialty);
+		}
+		return veterinarian;
+	}
+
+	static Vet aVeterinarianHolding(Specialty... specialtiesHeld) {
+		int distinguisher = NEXT_ID.getAndIncrement();
+		return aVeterinarian(ANY_FIRST_NAME + distinguisher, ANY_LAST_NAME + distinguisher, specialtiesHeld);
+	}
+
+}
