+	private static final String NON_HOLDER_FULL_NAME = NON_HOLDER_FIRST_NAME + " " + NON_HOLDER_LAST_NAME;
+
+	private static final String NO_HOLDER_WORDING_IN_ENGLISH = "none";
+
+	private static final String SPECIALTIES_HEADING_IN_GERMAN = "Fachgebiete";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	void theSpecialtyPageShouldShowEverySpecialtyWithItsHoldersByFullName() throws Exception {
+		MvcResult result = mockMvc.perform(get(SPECIALTY_DIRECTORY_URL))
+			.andExpect(status().isOk())
+			.andExpect(view().name(SPECIALTY_LIST_VIEW))
+			.andReturn();
+
+		assertThat(result.getResponse().getContentAsString()).contains(RADIOLOGY, SURGERY, HOLDER_FULL_NAME);
+	}
+
+	@Test
+	void theSpecialtyPageShouldShowNoVeterinarianWhoHoldsNoSpecialty() throws Exception {
+		String page = renderedPageAt(SPECIALTY_DIRECTORY_URL);
+
+		assertThat(page).doesNotContain(NON_HOLDER_FULL_NAME);
+	}
+
+	@Test
+	void theSpecialtyPageShouldShowASpecialtyNoVeterinarianHoldsAsHeldByNobody() throws Exception {
+		String page = renderedPageAt(SPECIALTY_DIRECTORY_URL);
+
+		assertThat(page).contains(SPECIALTY_NO_ONE_HOLDS, NO_HOLDER_WORDING_IN_ENGLISH);
+	}
+
+	@Test
+	void theSpecialtyPageShouldFitEverySpecialtyOnOnePageWithoutPagingControls() throws Exception {
+		String page = renderedPageAt(SPECIALTY_DIRECTORY_URL);
+
+		assertThat(page).contains(RADIOLOGY, SURGERY, SPECIALTY_NO_ONE_HOLDS).doesNotContain(PAGING_QUERY_MARKER);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryNavigationWithoutALinkToItself() throws Exception {
+		String page = renderedPageAt(SPECIALTY_DIRECTORY_URL);
+
+		assertThat(page).contains(LINK_TO_THE_VET_LIST, LINK_TO_FINDING_OWNERS)
+			.doesNotContain(LINK_TO_THE_SPECIALTY_DIRECTORY);
+	}
+
+	@Test
+	void theSpecialtyPageShouldPresentItsWordingInTheRequestedLanguage() throws Exception {
+		String page = renderedPageAt(SPECIALTY_DIRECTORY_URL + GERMAN_LANGUAGE_QUERY);
+
+		assertThat(page).contains(SPECIALTIES_HEADING_IN_GERMAN);
+	}
+
+	private String renderedPageAt(String url) throws Exception {
+		return mockMvc.perform(get(url)).andExpect(status().isOk()).andReturn().getResponse().getContentAsString();
+	}
+
+	@TestConfiguration
+	static class ClinicWithOneSpecialtyNobodyHolds {
+
+		private final Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+
+		private final Specialty surgery = aSpecialtyNamed(SURGERY);
+
+		private final Specialty unheldSpecialty = aSpecialtyNamed(SPECIALTY_NO_ONE_HOLDS);
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return () -> List.of(unheldSpecialty, radiology, surgery);
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new StoredVeterinarians(
+					List.of(aVeterinarian(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, radiology, surgery),
+							aVeterinarian(NON_HOLDER_FIRST_NAME, NON_HOLDER_LAST_NAME)));
+		}
+
+	}
+
+	/**
+	 * Hand-written stand-in for the veterinarian store: the specialty directory reads
+	 * every veterinarian and never pages, so the paged read is left unsupported rather
+	 * than answered with an empty page.
+	 */
+	private record StoredVeterinarians(Collection<Vet> veterinarians) implements VetRepository {
+
+		@Override
+		public Collection<Vet> findAll() {
+			return this.veterinarians;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("the specialty directory does not page veterinarians");
+		}
+
+	}
+
+}
