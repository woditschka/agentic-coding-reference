+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * The clinic's specialties, each paired with the veterinarians holding it. A specialty
+ * nobody holds keeps its place with an empty list of veterinarians, and a veterinarian
+ * holding no specialty appears nowhere.
+ * <p>
+ * The association is mapped from {@link Vet} to {@link Specialty} only, so the holders of
+ * a specialty are found by reading the veterinarians rather than by asking the specialty.
+ */
+public record SpecialtyDirectory(List<Listing> listings) {
+
+	/**
+	 * Veterinarians are ordered by name so that a specialty's holders read the same way
+	 * on every request; the persisted order of the association is not defined.
+	 */
+	private static final Comparator<Vet> BY_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	public SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	/**
+	 * Pairs each of the given specialties with the veterinarians holding it, keeping the
+	 * order the specialties are given in.
+	 * @param specialties every specialty the clinic knows, each already stored
+	 * @param veterinarians the veterinarians to look for among the holders
+	 * @throws IllegalArgumentException if a specialty carries no stored identity, which
+	 * leaves its holders undeterminable
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		List<Vet> candidateHolders = veterinarians.stream().sorted(BY_NAME).toList();
+		return new SpecialtyDirectory(
+				specialties.stream().map(specialty -> listingFor(specialty, candidateHolders)).toList());
+	}
+
+	private static Listing listingFor(Specialty specialty, List<Vet> candidateHolders) {
+		if (specialty.isNew()) {
+			throw new IllegalArgumentException("Specialty '" + specialty.getName()
+					+ "' has no stored identity, so the veterinarians holding it cannot be determined");
+		}
+		return new Listing(specialty,
+				candidateHolders.stream().filter(veterinarian -> holds(veterinarian, specialty)).toList());
+	}
+
+	private static boolean holds(Vet veterinarian, Specialty specialty) {
+		return veterinarian.getSpecialties().stream().anyMatch(held -> specialty.getId().equals(held.getId()));
+	}
+
+	/**
+	 * One specialty together with the veterinarians holding it, in the order the page
+	 * lists them.
+	 */
+	public record Listing(Specialty specialty, List<Vet> veterinarians) {
+
+		public Listing {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+}
