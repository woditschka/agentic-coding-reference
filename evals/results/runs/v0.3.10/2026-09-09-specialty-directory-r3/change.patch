+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatIllegalArgumentException;
+import static org.springframework.samples.petclinic.vet.VetFixtures.aSpecialtyNamed;
+import static org.springframework.samples.petclinic.vet.VetFixtures.aVeterinarian;
+import static org.springframework.samples.petclinic.vet.VetFixtures.aVeterinarianHolding;
+import static org.springframework.samples.petclinic.vet.VetFixtures.anUnsavedSpecialtyNamed;
+
+/**
+ * Test class for {@link SpecialtyDirectory}.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String LAST_NAME_EARLY_IN_THE_ALPHABET = "Douglas";
+
+	private static final String LAST_NAME_LATE_IN_THE_ALPHABET = "Leary";
+
+	private static final String ANY_FIRST_NAME = "Helen";
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyWithTheVeterinariansHoldingIt() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Specialty surgery = aSpecialtyNamed(SURGERY);
+		Vet radiologist = aVeterinarianHolding(radiology);
+		Vet surgeon = aVeterinarianHolding(surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery),
+				List.of(radiologist, surgeon));
+
+		assertThat(directory.listings()).containsExactly(aListingOf(radiology, radiologist),
+				aListingOf(surgery, surgeon));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEverySpecialtyTheyHold() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Specialty surgery = aSpecialtyNamed(SURGERY);
+		Vet holderOfBoth = aVeterinarianHolding(radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(holderOfBoth));
+
+		assertThat(directory.listings()).containsExactly(aListingOf(radiology, holderOfBoth),
+				aListingOf(surgery, holderOfBoth));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Vet radiologist = aVeterinarianHolding(radiology);
+		Vet holderOfNoSpecialty = aVeterinarianHolding();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(radiologist, holderOfNoSpecialty));
+
+		assertThat(directory.listings()).containsExactly(aListingOf(radiology, radiologist));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty dentistry = aSpecialtyNamed(DENTISTRY);
+		Vet holderOfNoSpecialty = aVeterinarianHolding();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry), List.of(holderOfNoSpecialty));
+
+		assertThat(directory.listings()).containsExactly(aListingOf(dentistry));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderTheVeterinariansUnderASpecialtyByName() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Vet lateInTheAlphabet = aVeterinarian(ANY_FIRST_NAME, LAST_NAME_LATE_IN_THE_ALPHABET, radiology);
+		Vet earlyInTheAlphabet = aVeterinarian(ANY_FIRST_NAME, LAST_NAME_EARLY_IN_THE_ALPHABET, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(lateInTheAlphabet, earlyInTheAlphabet));
+
+		assertThat(directory.listings()).containsExactly(aListingOf(radiology, earlyInTheAlphabet, lateInTheAlphabet));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRejectASpecialtyThatWasNeverStored() {
+		Specialty unstoredRadiology = anUnsavedSpecialtyNamed(RADIOLOGY);
+		Vet holderOfNoSpecialty = aVeterinarianHolding();
+
+		assertThatIllegalArgumentException()
+			.isThrownBy(() -> SpecialtyDirectory.of(List.of(unstoredRadiology), List.of(holderOfNoSpecialty)))
+			.withMessageContaining(RADIOLOGY);
+	}
+
+	private static SpecialtyDirectory.Listing aListingOf(Specialty specialty, Vet... veterinarians) {
+		return new SpecialtyDirectory.Listing(specialty, List.of(veterinarians));
+	}
+
+}
