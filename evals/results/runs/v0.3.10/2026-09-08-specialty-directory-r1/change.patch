+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.annotation.Bean;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String HELEN_FIRST_NAME = "Helen";
+
+	private static final String LEARY_LAST_NAME = "Leary";
+
+	private static final String SOME_FIRST_NAME = "James";
+
+	private static final String SOME_LAST_NAME = "Carter";
+
+	private static final List<String> MORE_SPECIALTY_NAMES_THAN_THE_VET_LIST_SHOWS_PER_PAGE = List.of("radiology",
+			"surgery", "dentistry", "cardiology", "oncology", "neurology");
+
+	private final AtomicInteger nextIdentity = new AtomicInteger(1);
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private SpecialtyRepositoryStub specialties;
+
+	@Autowired
+	private VetRepositoryStub veterinarians;
+
+	@BeforeEach
+	void emptyTheClinic() {
+		this.specialties.store(List.of());
+		this.veterinarians.store(List.of());
+	}
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextIdentity.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private List<Specialty> createSpecialties(List<String> names) {
+		return names.stream().map(this::createASpecialty).toList();
+	}
+
+	private Vet createAVeterinarian(String firstName, String lastName, Specialty... heldSpecialties) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(this.nextIdentity.getAndIncrement());
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		for (Specialty specialty : heldSpecialties) {
+			veterinarian.addSpecialty(specialty);
+		}
+		return veterinarian;
+	}
+
+	private Vet createAVeterinarianHoldingNoSpecialty() {
+		return createAVeterinarian(SOME_FIRST_NAME, SOME_LAST_NAME);
+	}
+
+	@Test
+	void theSpecialtyDirectoryPageShouldRenderEachSpecialtyWithItsHolders() throws Exception {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		this.specialties.store(List.of(radiology, surgery));
+		this.veterinarians.store(List.of(createAVeterinarian(HELEN_FIRST_NAME, LEARY_LAST_NAME, radiology),
+				createAVeterinarianHoldingNoSpecialty()));
+
+		String page = this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attributeExists("specialtyDirectory"))
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+
+		assertThat(page).contains(RADIOLOGY, SURGERY, HELEN_FIRST_NAME + " " + LEARY_LAST_NAME)
+			.doesNotContain(SOME_FIRST_NAME + " " + SOME_LAST_NAME);
+	}
+
+	@Test
+	void theSpecialtyDirectoryPageShouldRenderEverySpecialtyOnOnePage() throws Exception {
+		this.specialties.store(createSpecialties(MORE_SPECIALTY_NAMES_THAN_THE_VET_LIST_SHOWS_PER_PAGE));
+
+		String page = this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+
+		assertThat(page).contains(MORE_SPECIALTY_NAMES_THAN_THE_VET_LIST_SHOWS_PER_PAGE.toArray(new String[0]));
+	}
+
+	@TestConfiguration
+	static class ClinicStubs {
+
+		@Bean
+		SpecialtyRepositoryStub specialtyRepository() {
+			return new SpecialtyRepositoryStub();
+		}
+
+		@Bean
+		VetRepositoryStub vetRepository() {
+			return new VetRepositoryStub();
+		}
+
+	}
+
+	static class SpecialtyRepositoryStub implements SpecialtyRepository {
+
+		private final List<Specialty> stored = new ArrayList<>();
+
+		void store(Collection<Specialty> specialties) {
+			this.stored.clear();
+			this.stored.addAll(specialties);
+		}
+
+		@Override
+		public Collection<Specialty> findAll() {
+			return List.copyOf(this.stored);
+		}
+
+	}
+
+	static class VetRepositoryStub implements VetRepository {
+
+		private final List<Vet> stored = new ArrayList<>();
+
+		void store(Collection<Vet> veterinarians) {
+			this.stored.clear();
+			this.stored.addAll(veterinarians);
+		}
+
+		@Override
+		public Collection<Vet> findAll() {
+			return List.copyOf(this.stored);
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("the specialty directory reads the whole roster, never a page");
+		}
+
+	}
+
+}
