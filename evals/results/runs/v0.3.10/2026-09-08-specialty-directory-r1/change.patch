+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.SpecialtyListing;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the specialty side of the veterinarian
+ * directory.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String HELEN_FIRST_NAME = "Helen";
+
+	private static final String LEARY_LAST_NAME = "Leary";
+
+	private static final String ADA_FIRST_NAME = "Ada";
+
+	private static final String RAFAEL_FIRST_NAME = "Rafael";
+
+	private static final String ORTEGA_LAST_NAME = "Ortega";
+
+	private static final String SOME_FIRST_NAME = "James";
+
+	private static final String SOME_LAST_NAME = "Carter";
+
+	private static final List<Vet> NO_VETERINARIANS = List.of();
+
+	private static final List<Specialty> NO_SPECIALTIES = List.of();
+
+	private final AtomicInteger nextIdentity = new AtomicInteger(1);
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextIdentity.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVeterinarian(String firstName, String lastName, Specialty... heldSpecialties) {
+		return createAVeterinarian(this.nextIdentity.getAndIncrement(), firstName, lastName, heldSpecialties);
+	}
+
+	private Vet createAVeterinarianHoldingNoSpecialty() {
+		return createAVeterinarian(SOME_FIRST_NAME, SOME_LAST_NAME);
+	}
+
+	private Vet createAVeterinarian(int identity, String firstName, String lastName, Specialty... heldSpecialties) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(identity);
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		for (Specialty specialty : heldSpecialties) {
+			veterinarian.addSpecialty(specialty);
+		}
+		return veterinarian;
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByItsStoredName() {
+		SpecialtyDirectory directory = SpecialtyDirectory
+			.of(List.of(createASpecialty(RADIOLOGY), createASpecialty(SURGERY)), NO_VETERINARIANS);
+
+		assertThat(directory.listings()).extracting(SpecialtyListing::specialtyName)
+			.containsExactly(RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenTheClinicKnowsNoSpecialty() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(NO_SPECIALTIES, NO_VETERINARIANS);
+
+		assertThat(directory.listings()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachHolderFirstNameThenLastName() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVeterinarian(HELEN_FIRST_NAME, LEARY_LAST_NAME, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory.listings())
+			.containsExactly(new SpecialtyListing(RADIOLOGY, List.of(HELEN_FIRST_NAME + " " + LEARY_LAST_NAME)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVeterinarian(HELEN_FIRST_NAME, LEARY_LAST_NAME, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(helen, createAVeterinarianHoldingNoSpecialty()));
+
+		assertThat(directory.listings()).flatExtracting(SpecialtyListing::holderNames)
+			.containsExactly(HELEN_FIRST_NAME + " " + LEARY_LAST_NAME);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet helen = createAVeterinarian(HELEN_FIRST_NAME, LEARY_LAST_NAME, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(directory.listings()).contains(new SpecialtyListing(SURGERY, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentSpecialtiesInAStableOrder() {
+		List<Specialty> inAnArbitraryOrder = List.of(createASpecialty(SURGERY), createASpecialty(DENTISTRY),
+				createASpecialty(RADIOLOGY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(inAnArbitraryOrder, NO_VETERINARIANS);
+
+		assertThat(directory.listings()).extracting(SpecialtyListing::specialtyName)
+			.containsExactly(DENTISTRY, RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentTheHoldersOfASpecialtyInAStableOrder() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		List<Vet> inAnArbitraryOrder = List.of(createAVeterinarian(RAFAEL_FIRST_NAME, ORTEGA_LAST_NAME, radiology),
+				createAVeterinarian(HELEN_FIRST_NAME, LEARY_LAST_NAME, radiology),
+				createAVeterinarian(ADA_FIRST_NAME, LEARY_LAST_NAME, radiology));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), inAnArbitraryOrder);
+
+		assertThat(directory.listings()).flatExtracting(SpecialtyListing::holderNames)
+			.containsExactly(ADA_FIRST_NAME + " " + LEARY_LAST_NAME, HELEN_FIRST_NAME + " " + LEARY_LAST_NAME,
+					RAFAEL_FIRST_NAME + " " + ORTEGA_LAST_NAME);
+	}
+
+}
