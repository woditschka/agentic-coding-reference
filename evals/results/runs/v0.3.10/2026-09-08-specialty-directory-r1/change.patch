+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The specialties the clinic knows, each with the veterinarians holding it.
+ */
+public record SpecialtyDirectory(List<SpecialtyListing> listings) {
+
+	// The render order is applied here rather than taken from the query, so it cannot
+	// vary with the database's collation from one vendor to the next.
+	private static final Comparator<Specialty> BY_STORED_NAME = Comparator.comparing(Specialty::getName);
+
+	private static final Comparator<Vet> BY_LAST_NAME_THEN_FIRST_NAME_THEN_IDENTITY = Comparator
+		.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	/**
+	 * One specialty and the veterinarians holding it, named as they are rendered.
+	 */
+	public record SpecialtyListing(String specialtyName, List<String> holderNames) {
+
+		public SpecialtyListing {
+			holderNames = List.copyOf(holderNames);
+		}
+
+	}
+
+	public SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	/**
+	 * Invert the veterinarian directory: every specialty the clinic knows, each with its
+	 * holders.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians the veterinarians whose held specialties are inverted
+	 * @return a directory listing each of the given specialties
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyIdentity = holdersBySpecialtyIdentity(veterinarians);
+		List<SpecialtyListing> listings = specialties.stream()
+			.sorted(BY_STORED_NAME)
+			.map(specialty -> new SpecialtyListing(specialty.getName(),
+					fullNamesOf(holdersBySpecialtyIdentity.getOrDefault(specialty.getId(), List.of()))))
+			.toList();
+		return new SpecialtyDirectory(listings);
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyIdentity(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), identity -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holders;
+	}
+
+	private static List<String> fullNamesOf(List<Vet> holders) {
+		return holders.stream()
+			.sorted(BY_LAST_NAME_THEN_FIRST_NAME_THEN_IDENTITY)
+			.map(holder -> holder.getFirstName() + " " + holder.getLastName())
+			.toList();
+	}
+
+}
