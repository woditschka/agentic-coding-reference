+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 5;
+
+	private static final int VISIT_ID_OF_ANOTHER_PET = 6;
+
+	private static final String SOME_DESCRIPTION = "annual check-up";
+
+	@Test
+	void thePetShouldOfferTheVisitCarryingTheGivenId() {
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWith(bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldOfferNoVisitForAnIdItDoesNotHold() {
+		Pet pet = createAPetWith(createABookedVisit(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(VISIT_ID_OF_ANOTHER_PET)).isNull();
+	}
+
+	@Test
+	void thePetShouldOfferNoVisitWhenNoIdIsGiven() {
+		Pet pet = createAPetWith(createAnUnbookedVisit());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	private static Pet createAPetWith(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+	private static Visit createABookedVisit(int id) {
+		Visit visit = createAnUnbookedVisit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnbookedVisit() {
+		Visit visit = new Visit();
+		visit.setDescription(SOME_DESCRIPTION);
+		return visit;
+	}
+
+}
