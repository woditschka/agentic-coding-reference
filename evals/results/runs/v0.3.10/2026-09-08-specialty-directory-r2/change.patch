+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.SpecialtyEntry;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.InstanceOfAssertFactories.list;
+import static org.springframework.samples.petclinic.vet.VetFixtures.createSpecialty;
+import static org.springframework.samples.petclinic.vet.VetFixtures.createVeterinarian;
+
+/**
+ * Test class for {@link SpecialtyDirectory}.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int SOME_VET_ID = 7;
+
+	private static final int ANOTHER_VET_ID = 8;
+
+	private static final String SOME_FIRST_NAME = "Linda";
+
+	private static final String SOME_LAST_NAME = "Douglas";
+
+	private static final String HOLDER_FIRST_NAME = "Helen";
+
+	private static final String HOLDER_LAST_NAME = "Leary";
+
+	private static final int HOLDER_ID = 2;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByItsStoredName() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(
+				List.of(createSpecialty(RADIOLOGY, RADIOLOGY_ID), createSpecialty(SURGERY, SURGERY_ID)),
+				List.of(createVeterinarian(SOME_FIRST_NAME, SOME_LAST_NAME, SOME_VET_ID)));
+
+		assertThat(directory.entries()).extracting(entry -> entry.specialty().getName())
+			.containsExactly(RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Vet holder = createVeterinarian(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, HOLDER_ID,
+				createSpecialty(RADIOLOGY, RADIOLOGY_ID));
+		Vet withoutSpecialty = createVeterinarian(SOME_FIRST_NAME, SOME_LAST_NAME, SOME_VET_ID);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(createSpecialty(RADIOLOGY, RADIOLOGY_ID)),
+				List.of(withoutSpecialty, holder));
+
+		assertThat(directory.entries()).flatExtracting(SpecialtyEntry::veterinarians).containsExactly(holder);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameAVeterinarianUnderEverySpecialtyTheyHold() {
+		// The specialties the directory lists and the ones the veterinarian holds come
+		// from two separate reads, so they are separate instances of the same rows.
+		Vet holder = createVeterinarian(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, HOLDER_ID,
+				createSpecialty(RADIOLOGY, RADIOLOGY_ID), createSpecialty(SURGERY, SURGERY_ID));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(
+				List.of(createSpecialty(RADIOLOGY, RADIOLOGY_ID), createSpecialty(SURGERY, SURGERY_ID)),
+				List.of(holder));
+
+		assertThat(directory.entries()).flatExtracting(SpecialtyEntry::veterinarians).containsExactly(holder, holder);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNobodyWithNoVeterinarian() {
+		Vet holder = createVeterinarian(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, HOLDER_ID,
+				createSpecialty(RADIOLOGY, RADIOLOGY_ID));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(createSpecialty(SURGERY, SURGERY_ID)),
+				List.of(holder));
+
+		assertThat(directory.entries()).singleElement()
+			.extracting(SpecialtyEntry::veterinarians, list(Vet.class))
+			.isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentSpecialtiesAndVeterinariansInAStableOrder() {
+		String earlierLastName = "Carter";
+		String laterLastName = "Leary";
+		Vet earlier = createVeterinarian(SOME_FIRST_NAME, earlierLastName, SOME_VET_ID,
+				createSpecialty(RADIOLOGY, RADIOLOGY_ID));
+		Vet later = createVeterinarian(SOME_FIRST_NAME, laterLastName, ANOTHER_VET_ID,
+				createSpecialty(RADIOLOGY, RADIOLOGY_ID));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(
+				List.of(createSpecialty(SURGERY, SURGERY_ID), createSpecialty(RADIOLOGY, RADIOLOGY_ID)),
+				List.of(later, earlier));
+
+		assertThat(directory.entries()).extracting(entry -> entry.specialty().getName())
+			.containsExactly(RADIOLOGY, SURGERY);
+		assertThat(directory.entries()).flatExtracting(SpecialtyEntry::veterinarians).containsExactly(earlier, later);
+	}
+
+}
