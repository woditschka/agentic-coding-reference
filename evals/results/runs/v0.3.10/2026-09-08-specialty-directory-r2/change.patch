+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+/**
+ * The clinic's published view of every {@link Specialty} it knows, each shown with the
+ * veterinarians holding it.
+ */
+public record SpecialtyDirectory(List<SpecialtyDirectory.SpecialtyEntry> entries) {
+
+	private static final Comparator<Specialty> BY_SPECIALTY_NAME = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> BY_VETERINARIAN_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = holdersBySpecialtyId(veterinarians);
+		return new SpecialtyDirectory(specialties.stream()
+			.sorted(BY_SPECIALTY_NAME)
+			.map(specialty -> new SpecialtyEntry(specialty, holders.getOrDefault(specialty.getId(), List.of())))
+			.toList());
+	}
+
+	// Keyed by identifier rather than by Specialty: the specialties read here and the
+	// ones the veterinarians hold come from separate reads, and a persisted type equates
+	// by object identity, so the same row arrives as two unequal instances.
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		return veterinarians.stream()
+			.sorted(BY_VETERINARIAN_NAME)
+			.flatMap(veterinarian -> veterinarian.getSpecialties()
+				.stream()
+				.map(specialty -> Map.entry(specialty.getId(), veterinarian)))
+			.collect(Collectors.groupingBy(Map.Entry::getKey,
+					Collectors.mapping(Map.Entry::getValue, Collectors.toList())));
+	}
+
+	/**
+	 * One specialty of the directory together with the veterinarians holding it.
+	 */
+	public record SpecialtyEntry(Specialty specialty, List<Vet> veterinarians) {
+
+		public SpecialtyEntry {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+}
