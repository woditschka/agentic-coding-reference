+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}.
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String DIRECTORY_PATH = "/specialties.html";
+
+	private static final String DIRECTORY_VIEW = "vets/specialtyList";
+
+	private static final String PAGING_PARAMETER = "page=";
+
+	private static final String HELD_SPECIALTY = "radiology";
+
+	private static final int HELD_SPECIALTY_ID = 1;
+
+	private static final String UNHELD_SPECIALTY = "surgery";
+
+	private static final int UNHELD_SPECIALTY_ID = 2;
+
+	private static final String HOLDER_FIRST_NAME = "Helen";
+
+	private static final String HOLDER_LAST_NAME = "Leary";
+
+	private static final int HOLDER_ID = 2;
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachHoldingVeterinarianInFull() throws Exception {
+		mockMvc.perform(get(DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(view().name(DIRECTORY_VIEW))
+			.andExpect(content().string(containsString(HOLDER_FIRST_NAME + " " + HOLDER_LAST_NAME)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEverySpecialtyOnOnePage() throws Exception {
+		mockMvc.perform(get(DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(content().string(allOf(containsString(HELD_SPECIALTY), containsString(UNHELD_SPECIALTY))))
+			.andExpect(content().string(not(containsString(PAGING_PARAMETER))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOfferNoNavigationEntryToItself() throws Exception {
+		mockMvc.perform(get(DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString("href=\"" + DIRECTORY_PATH + "\""))));
+	}
+
+	@TestConfiguration
+	static class ClinicRecords {
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return new InMemorySpecialtyRepository(List.of(createSpecialty(HELD_SPECIALTY, HELD_SPECIALTY_ID),
+					createSpecialty(UNHELD_SPECIALTY, UNHELD_SPECIALTY_ID)));
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new InMemoryVetRepository(List.of(createVeterinarian(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, HOLDER_ID,
+					createSpecialty(HELD_SPECIALTY, HELD_SPECIALTY_ID))));
+		}
+
+	}
+
+	private record InMemorySpecialtyRepository(List<Specialty> stored) implements SpecialtyRepository {
+
+		@Override
+		public Collection<Specialty> findAll() {
+			return this.stored;
+		}
+
+	}
+
+	private record InMemoryVetRepository(List<Vet> stored) implements VetRepository {
+
+		@Override
+		public Collection<Vet> findAll() {
+			return this.stored;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			return new PageImpl<>(this.stored);
+		}
+
+	}
+
+}
