+package org.springframework.samples.petclinic.vet;
+
+import java.util.stream.Stream;
+
+/**
+ * Construction vocabulary shared by the vet package's tests.
+ */
+final class VetFixtures {
+
+	private VetFixtures() {
+	}
+
+	static Specialty createSpecialty(String name, int id) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		specialty.setId(id);
+		return specialty;
+	}
+
+	static Vet createVeterinarian(String firstName, String lastName, int id, Specialty... specialties) {
+		Vet veterinarian = new Vet();
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		veterinarian.setId(id);
+		Stream.of(specialties).forEach(veterinarian::addSpecialty);
+		return veterinarian;
+	}
+
+}
