+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.redirectedUrl;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
+
+/**
+ * Tests for correcting a booked visit (REQ-VIS-003).
+ * <p>
+ * These tests drive the real repository against the embedded database rather than a
+ * stubbed one, because two of the requirement's criteria — that a correction leaves the
+ * pet with exactly one visit, and that a refused correction leaves the stored visit
+ * untouched — are claims about persisted state that a stub cannot witness. No test
+ * transaction wraps the requests, so the owner graph detaches between them exactly as it
+ * does in production, where {@code spring.jpa.open-in-view} is disabled.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+class VisitCorrectionIntegrationTests {
+
+	private static final LocalDate TODAY = LocalDate.now();
+
+	private static final LocalDate STORED_VISIT_DATE = TODAY.plusDays(7);
+
+	private static final LocalDate PAST_STORED_VISIT_DATE = TODAY.minusDays(7);
+
+	private static final String STORED_VISIT_DESCRIPTION = "annual check-up";
+
+	private static final LocalDate CORRECTED_VISIT_DATE = TODAY.plusDays(14);
+
+	private static final String CORRECTED_VISIT_DESCRIPTION = "annual check-up and dental scaling";
+
+	private static final String BLANK_DESCRIPTION = "   ";
+
+	private static final String SOME_TELEPHONE = "1234567890";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private OwnerRepository owners;
+
+	@Autowired
+	private PetTypeRepository petTypes;
+
+	private int ownerId;
+
+	private int petId;
+
+	private int visitId;
+
+	@BeforeEach
+	void bookAVisit() {
+		bookAVisitOn(STORED_VISIT_DATE);
+	}
+
+	private void bookAVisitOn(LocalDate date) {
+		Owner owner = anOwnerWithAVisitOn(date);
+		this.ownerId = owner.getId();
+		Pet pet = owner.getPets().get(0);
+		this.petId = pet.getId();
+		this.visitId = pet.getVisits().iterator().next().getId();
+	}
+
+	@Test
+	void theVisitCorrectionFormShouldOfferTheStoredDateAndDescription() throws Exception {
+		MvcResult result = mockMvc
+			.perform(get("/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit", ownerId, petId, visitId))
+			.andExpect(status().isOk())
+			.andExpect(view().name("pets/createOrUpdateVisitForm"))
+			.andReturn();
+
+		Visit offered = (Visit) result.getModelAndView().getModel().get("visit");
+		assertThat(offered.getId()).isEqualTo(visitId);
+		assertThat(offered.getDate()).isEqualTo(STORED_VISIT_DATE);
+		assertThat(offered.getDescription()).isEqualTo(STORED_VISIT_DESCRIPTION);
+	}
+
+	@Test
+	void theVisitCorrectionShouldBeRefusedWhenTheVisitBelongsToAnotherPet() {
+		Owner anotherOwner = anOwnerWithABookedVisit();
+		int foreignVisitId = anotherOwner.getPets().get(0).getVisits().iterator().next().getId();
+
+		assertThatThrownBy(() -> mockMvc
+			.perform(get("/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit", ownerId, petId, foreignVisitId)))
+			.hasRootCauseInstanceOf(IllegalArgumentException.class);
+	}
+
+	@Test
+	void theVisitCorrectionShouldReplaceTheStoredValuesInPlace() throws Exception {
+		mockMvc.perform(aCorrectionOf(CORRECTED_VISIT_DATE.toString(), CORRECTED_VISIT_DESCRIPTION));
+
+		Visit stored = theStoredVisit();
+		assertThat(stored.getId()).isEqualTo(visitId);
+		assertThat(stored.getDate()).isEqualTo(CORRECTED_VISIT_DATE);
+		assertThat(stored.getDescription()).isEqualTo(CORRECTED_VISIT_DESCRIPTION);
+	}
+
+	@Test
+	void theVisitCorrectionShouldNotAddASecondVisitToThePet() throws Exception {
+		mockMvc.perform(aCorrectionOf(CORRECTED_VISIT_DATE.toString(), CORRECTED_VISIT_DESCRIPTION));
+
+		assertThat(theStoredPet().getVisits()).hasSize(1);
+	}
+
+	@Test
+	void theVisitCorrectionShouldReturnToTheOwnerRecordOnSuccess() throws Exception {
+		mockMvc.perform(aCorrectionOf(CORRECTED_VISIT_DATE.toString(), CORRECTED_VISIT_DESCRIPTION))
+			.andExpect(status().is3xxRedirection())
+			.andExpect(redirectedUrl("/owners/" + ownerId));
+	}
+
+	@Test
+	void theVisitCorrectionShouldBeRefusedWhenTheDescriptionIsBlank() throws Exception {
+		mockMvc.perform(aCorrectionOf(CORRECTED_VISIT_DATE.toString(), BLANK_DESCRIPTION))
+			.andExpect(status().isOk())
+			.andExpect(view().name("pets/createOrUpdateVisitForm"))
+			.andExpect(model().attributeHasFieldErrors("visit", "description"));
+
+		assertThatTheStoredVisitIsUnchanged(STORED_VISIT_DATE);
+	}
+
+	@Test
+	void theVisitCorrectionShouldBeRefusedWhenTheDateIsNotLaterThanToday() throws Exception {
+		mockMvc.perform(aCorrectionOf(TODAY.toString(), CORRECTED_VISIT_DESCRIPTION))
+			.andExpect(status().isOk())
+			.andExpect(view().name("pets/createOrUpdateVisitForm"))
+			.andExpect(model().attributeHasFieldErrorCode("visit", "date", "typeMismatch.visitDate"));
+
+		assertThatTheStoredVisitIsUnchanged(STORED_VISIT_DATE);
+	}
+
+	@Test
+	void theVisitCorrectionShouldBeRefusedWhenTheStoredDateHasAlreadyPassed() throws Exception {
+		// A date that has already passed is one the booking form would refuse, so this
+		// stored history can only be set up by persisting it directly.
+		bookAVisitOn(PAST_STORED_VISIT_DATE);
+
+		mockMvc.perform(aCorrectionOf(PAST_STORED_VISIT_DATE.toString(), CORRECTED_VISIT_DESCRIPTION))
+			.andExpect(status().isOk())
+			.andExpect(view().name("pets/createOrUpdateVisitForm"))
+			.andExpect(model().attributeHasFieldErrorCode("visit", "date", "typeMismatch.visitDate"));
+
+		assertThatTheStoredVisitIsUnchanged(PAST_STORED_VISIT_DATE);
+	}
+
+	@Test
+	void theOwnerRecordShouldOfferNoRouteToAVisitCorrection() throws Exception {
+		String ownerRecord = mockMvc.perform(get("/owners/{ownerId}", ownerId))
+			.andExpect(status().isOk())
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+
+		assertThat(ownerRecord).doesNotContainPattern("visits/\\d+/edit");
+	}
+
+	private MockHttpServletRequestBuilder aCorrectionOf(String date, String description) {
+		return post("/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit", ownerId, petId, visitId).param("date", date)
+			.param("description", description);
+	}
+
+	private void assertThatTheStoredVisitIsUnchanged(LocalDate bookedDate) {
+		Visit stored = theStoredVisit();
+		assertThat(stored.getDate()).isEqualTo(bookedDate);
+		assertThat(stored.getDescription()).isEqualTo(STORED_VISIT_DESCRIPTION);
+	}
+
+	private Pet theStoredPet() {
+		return owners.findById(ownerId).orElseThrow().getPet(petId);
+	}
+
+	private Visit theStoredVisit() {
+		return theStoredPet().getVisits().iterator().next();
+	}
+
+	private Owner anOwnerWithABookedVisit() {
+		return anOwnerWithAVisitOn(STORED_VISIT_DATE);
+	}
+
+	/**
+	 * Persists an owner with one pet and one visit on the given date, straight through
+	 * the repository, so the stored history is set up without going through the booking
+	 * form and its date validation.
+	 */
+	private Owner anOwnerWithAVisitOn(LocalDate date) {
+		Owner owner = new Owner();
+		owner.setFirstName("Harold");
+		owner.setLastName("Vissering");
+		owner.setAddress("110 W. Liberty St.");
+		owner.setCity("Madison");
+		owner.setTelephone(SOME_TELEPHONE);
+
+		Pet pet = new Pet();
+		pet.setName("Nero");
+		pet.setBirthDate(LocalDate.now().minusYears(2));
+		pet.setType(petTypes.findPetTypes().get(0));
+		owner.addPet(pet);
+
+		Visit visit = new Visit();
+		visit.setDate(date);
+		visit.setDescription(STORED_VISIT_DESCRIPTION);
+		pet.addVisit(visit);
+
+		return owners.save(owner);
+	}
+
+}
