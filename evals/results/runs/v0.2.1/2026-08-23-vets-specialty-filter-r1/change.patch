+	}
+
+	private List<String> listedVetLastNames(MvcResult page) {
+		@SuppressWarnings("unchecked")
+		List<Vet> listed = (List<Vet>) model(page).get("listVets");
+		return listed.stream().map(Vet::getLastName).toList();
+	}
+
+	private Map<String, Object> model(MvcResult page) {
+		ModelAndView modelAndView = page.getModelAndView();
+		assertThat(modelAndView).isNotNull();
+		return modelAndView.getModel();
+	}
+
+	private int everyVetCount() {
+		return this.vets.findAll().size();
+	}
