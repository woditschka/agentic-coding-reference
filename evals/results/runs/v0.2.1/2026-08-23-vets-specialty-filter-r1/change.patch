+/**
+ * Tests the specialty filter published on both veterinarian directory routes
+ * (REQ-VET-003), driving the real dispatch, the real Thymeleaf rendering and the real
+ * seeded database rather than a stubbed repository.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+class VetSpecialtyFilterIntegrationTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String RADIOLOGY_IN_MIXED_CASE = "RaDiOlOgY";
+
+	private static final String RADIOLOGY_PADDED_WITH_SPACES = "  radiology  ";
+
+	private static final String PREFIX_OF_RADIOLOGY = "radio";
+
+	private static final String SPECIALTY_NO_VET_HOLDS = "cardiology";
+
+	private static final String BLANK_SPECIALTY = "   ";
+
+	private static final String LEARY = "Leary";
+
+	private static final String STEVENS = "Stevens";
+
+	/**
+	 * The page size the veterinarian directory paginates by; the seeded schema ships more
+	 * veterinarians than this, so an unfiltered listing always spans more than one page.
+	 */
+	private static final int VETS_PER_PAGE = 5;
+
+	private static final String UNFILTERED_PAGE_TWO_LINK = "href=\"/vets.html?page=2\"";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private VetRepository vets;
+
+	@Test
+	void theVetPageShouldListOnlyVetsHoldingTheNamedSpecialty() throws Exception {
+		MvcResult page = requestVetPage(RADIOLOGY);
+
+		assertThat(listedVetLastNames(page)).containsExactlyInAnyOrder(LEARY, STEVENS);
+	}
+
+	@Test
+	void theVetPageShouldMatchTheSpecialtyNameRegardlessOfLetterCase() throws Exception {
+		MvcResult page = requestVetPage(RADIOLOGY_IN_MIXED_CASE);
+
+		assertThat(listedVetLastNames(page)).containsExactlyInAnyOrder(LEARY, STEVENS);
+	}
+
+	@Test
+	void theVetPageShouldDisregardSpacesAroundTheSpecialtyName() throws Exception {
+		MvcResult page = requestVetPage(RADIOLOGY_PADDED_WITH_SPACES);
+
+		assertThat(listedVetLastNames(page)).containsExactlyInAnyOrder(LEARY, STEVENS);
+	}
+
+	@Test
+	void theVetPageShouldNotMatchAPartialSpecialtyName() throws Exception {
+		MvcResult page = requestVetPage(PREFIX_OF_RADIOLOGY);
+
+		assertThat(listedVetLastNames(page)).isEmpty();
+	}
+
+	@Test
+	void theVetPageShouldRenderAnEmptyListWhenNoVetHoldsTheSpecialty() throws Exception {
+		MvcResult page = requestVetPage(SPECIALTY_NO_VET_HOLDS);
+
+		assertThat(listedVetLastNames(page)).isEmpty();
+	}
+
+	@Test
+	void theVetPageShouldListEveryVetWhenTheSpecialtyIsBlank() throws Exception {
+		MvcResult page = requestVetPage(BLANK_SPECIALTY);
+
+		assertThat(model(page).get("totalItems")).isEqualTo((long) everyVetCount());
+	}
+
+	@Test
+	void theVetJsonListShouldReturnOnlyVetsHoldingTheNamedSpecialty() throws Exception {
+		this.mockMvc.perform(get("/vets").param("specialty", RADIOLOGY).accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList[*].lastName", containsInAnyOrder(LEARY, STEVENS)));
+	}
+
+	@Test
+	void theVetJsonListShouldReturnAnEmptyListWhenNoVetHoldsTheSpecialty() throws Exception {
+		this.mockMvc.perform(get("/vets").param("specialty", SPECIALTY_NO_VET_HOLDS).accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList", hasSize(0)));
+	}
+
+	@Test
+	void theVetJsonListShouldReturnEveryVetWhenTheSpecialtyIsBlank() throws Exception {
+		this.mockMvc.perform(get("/vets").param("specialty", BLANK_SPECIALTY).accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList", hasSize(everyVetCount())));
+	}
+
+	@Test
+	void theVetJsonListShouldReturnEveryVetWhenNoSpecialtyIsNamed() throws Exception {
+		this.mockMvc.perform(get("/vets").accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList", hasSize(everyVetCount())));
+	}
+
+	@Test
+	void theVetPagePaginationShouldOmitTheSpecialtyWhenTheListIsUnfiltered() throws Exception {
+		assertThat(everyVetCount()).isGreaterThan(VETS_PER_PAGE);
+
+		this.mockMvc.perform(get("/vets.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(UNFILTERED_PAGE_TWO_LINK)));
+	}
+
+	private MvcResult requestVetPage(String specialty) throws Exception {
+		return this.mockMvc.perform(get("/vets.html").param("specialty", specialty))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/vetList"))
