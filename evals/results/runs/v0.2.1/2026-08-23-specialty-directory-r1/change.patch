+package org.springframework.samples.petclinic.vet;
+
+import org.springframework.dao.DataAccessException;
+import org.springframework.data.repository.Repository;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.Collection;
+
+/**
+ * Repository class for <code>Specialty</code> domain objects.
+ * <p>
+ * <code>Vet.specialties</code> is unidirectional, so a specialty no veterinarian holds is
+ * reachable only from here. Deliberately uncached: <code>CacheConfiguration</code>
+ * declares the <code>vets</code> cache alone, and the JCache cache manager does not
+ * create an unknown cache on demand.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve all <code>Specialty</code>s from the data store.
+	 * @return a <code>Collection</code> of <code>Specialty</code>s
+	 */
+	@Transactional(readOnly = true)
+	Collection<Specialty> findAll() throws DataAccessException;
+
+}
