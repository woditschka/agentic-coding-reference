+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * One specialty paired with the veterinarians holding it.
+ * <p>
+ * {@link Vet#getSpecialties()} is the only association between the two, and it is
+ * unidirectional, so a specialty no veterinarian holds cannot be reached from the
+ * veterinarian side. {@link #directory(Collection, Collection)} therefore inverts a
+ * complete specialty list against a complete veterinarian list, which is what lets an
+ * unheld specialty still appear — paired with no one.
+ */
+public record SpecialtyHolders(Specialty specialty, List<Vet> veterinarians) {
+
+	public SpecialtyHolders {
+		Objects.requireNonNull(specialty, "specialty");
+		veterinarians = List.copyOf(veterinarians);
+	}
+
+	/**
+	 * Pair every given specialty with the given veterinarians holding it.
+	 * <p>
+	 * A veterinarian holding no specialty appears in no pairing; one holding several
+	 * appears in each. Veterinarians are read, never modified: instances served from the
+	 * vet cache are detached and shared across requests. The result is in no defined
+	 * order.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians every veterinarian the clinic employs
+	 * @return one pairing per given specialty
+	 */
+	public static List<SpecialtyHolders> directory(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet vet : veterinarians) {
+			for (Specialty held : vet.getSpecialties()) {
+				// Keyed by identifier: BaseEntity defines no equals/hashCode, so two
+				// instances of one specialty are never equal, and specialties.name
+				// carries no uniqueness constraint.
+				holdersBySpecialtyId.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(vet);
+			}
+		}
+		return specialties.stream()
+			.map(specialty -> new SpecialtyHolders(specialty,
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+	}
+
+}
