+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyHolders}, the specialty-to-veterinarian inversion behind
+ * the specialty directory. The directory imposes no order, so no test asserts one.
+ */
+class SpecialtyHoldersTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private int nextId = 1;
+
+	private Specialty createASpecialty(String name) {
+		return createASpecialty(this.nextId++, name);
+	}
+
+	private Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private List<Vet> holdersOf(List<SpecialtyHolders> directory, Specialty specialty) {
+		return directory.stream()
+			.filter(holders -> holders.specialty() == specialty)
+			.findFirst()
+			.orElseThrow(() -> new AssertionError(specialty.getName() + " is missing from the directory"))
+			.veterinarians();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiology, surgery), List.of());
+
+		assertThat(directory).extracting(holders -> holders.specialty().getName())
+			.containsExactlyInAnyOrder(RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHoldingVetByFullName() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiology), List.of(helen));
+
+		assertThat(holdersOf(directory, radiology)).extracting(vet -> vet.getFirstName() + " " + vet.getLastName())
+			.containsExactly("Helen Leary");
+	}
+
+	/**
+	 * The specialty list and the veterinarians are loaded independently — the vet cache
+	 * serves detached instances — so the specialty a vet holds is a different object from
+	 * the identically identified one in the specialty list. Since {@code BaseEntity}
+	 * defines no equals/hashCode, only identifier-based grouping pairs the two.
+	 */
+	@Test
+	void theSpecialtyDirectoryShouldShowAHoldingVetWhoseSpecialtyIsASeparateInstance() {
+		Specialty listedRadiology = createASpecialty(RADIOLOGY);
+		Specialty heldRadiology = createASpecialty(listedRadiology.getId(), RADIOLOGY);
+		Vet helen = createAVet("Helen", "Leary", heldRadiology);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(listedRadiology), List.of(helen));
+
+		assertThat(heldRadiology).isNotSameAs(listedRadiology);
+		assertThat(holdersOf(directory, listedRadiology)).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVetHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+		Vet james = createAVet("James", "Carter");
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiology), List.of(helen, james));
+
+		assertThat(directory).flatExtracting(SpecialtyHolders::veterinarians).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVet() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(holdersOf(directory, surgery)).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowAVetUnderEachSpecialtyTheyHold() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Vet helen = createAVet("Helen", "Leary", radiology, dentistry);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiology, dentistry), List.of(helen));
+
+		assertThat(holdersOf(directory, radiology)).containsExactly(helen);
+		assertThat(holdersOf(directory, dentistry)).containsExactly(helen);
+	}
+
+}
