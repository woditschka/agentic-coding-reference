+package org.springframework.samples.petclinic.vet;
+
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.GetMapping;
+
+/**
+ * Serves the specialty directory: every specialty the clinic knows, each with the
+ * veterinarians holding it. Read-only, unpaged, and reached by its address alone — no
+ * page links to it.
+ */
+@Controller
+class SpecialtyController {
+
+	private final SpecialtyRepository specialties;
+
+	private final VetRepository veterinarians;
+
+	SpecialtyController(SpecialtyRepository specialties, VetRepository veterinarians) {
+		this.specialties = specialties;
+		this.veterinarians = veterinarians;
+	}
+
+	@GetMapping("/specialties.html")
+	public String showSpecialtyDirectory(Model model) {
+		SpecialtyDirectory directory = new SpecialtyDirectory(this.specialties.findSpecialties(),
+				this.veterinarians.findAll());
+		model.addAttribute("specialtyDirectory", directory);
+		return "vets/specialtyDirectory";
+	}
+
+}
