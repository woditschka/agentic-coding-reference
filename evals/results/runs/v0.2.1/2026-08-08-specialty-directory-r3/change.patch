+package org.springframework.samples.petclinic.vet;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * The specialty directory is reached by its address alone: no page of the system links to
+ * it. This walks every template and holds that line, so a later change has to break a
+ * test rather than quietly add an entry point.
+ */
+class SpecialtyDirectoryLinkTests {
+
+	private static final Path TEMPLATE_ROOT = Path.of("src/main/resources/templates");
+
+	private static final Pattern LINK_TARGET = Pattern.compile("(?:th:)?href\\s*=\\s*\"([^\"]*)\"");
+
+	private static final String SPECIALTY_DIRECTORY_ROUTE = "/specialties.html";
+
+	/**
+	 * The veterinarian directory is linked from the shared navigation. Finding it proves
+	 * the scan below reads link targets, so the absence of the specialty directory means
+	 * something.
+	 */
+	private static final String VETERINARIAN_DIRECTORY_ROUTE = "/vets.html";
+
+	private List<String> linkTargetsInTemplates() throws IOException {
+		List<Path> templates;
+		try (Stream<Path> tree = Files.walk(TEMPLATE_ROOT)) {
+			templates = tree.filter(path -> path.toString().endsWith(".html")).toList();
+		}
+		List<String> targets = new ArrayList<>();
+		for (Path template : templates) {
+			Matcher links = LINK_TARGET.matcher(Files.readString(template));
+			while (links.find()) {
+				targets.add(links.group(1));
+			}
+		}
+		return targets;
+	}
+
+	@Test
+	void noPageShouldLinkToTheSpecialtyDirectory() throws IOException {
+		List<String> targets = linkTargetsInTemplates();
+
+		assertThat(targets).anyMatch(target -> target.contains(VETERINARIAN_DIRECTORY_ROUTE));
+		assertThat(targets).noneMatch(target -> target.contains(SPECIALTY_DIRECTORY_ROUTE));
+	}
+
+}
