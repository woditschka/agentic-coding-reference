+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * The clinic's specialties, each paired with the veterinarians holding it.
+ * <p>
+ * The {@link Vet}-to-{@link Specialty} association runs one way only, so the holders of a
+ * specialty cannot be read from the specialty. This type builds that inverse reading in
+ * memory from two separate reads, which is why a specialty nobody holds survives: it is
+ * listed with no holders rather than being absent. A veterinarian holding no specialty
+ * appears nowhere.
+ * <p>
+ * This is an immutable value object that the persistence framework never instantiates, so
+ * the entity exception in the architecture principles does not cover it: both input
+ * collections are copied at construction and only unmodifiable views are handed out. The
+ * {@code Specialty} and {@code Vet} instances themselves are referenced, not copied —
+ * they are the entities loaded for one read-only request.
+ */
+public final class SpecialtyDirectory {
+
+	/**
+	 * Holders are ordered by name so that two renders of unchanged records agree. Neither
+	 * read that feeds this directory promises an order for the veterinarians, and the
+	 * cached veterinarian read can hide that from a test.
+	 */
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.<Vet, String>comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	private final List<ListedSpecialty> listedSpecialties;
+
+	/**
+	 * Pairs each specialty with its holders.
+	 * @param specialties every specialty to list, in the order they should appear; each
+	 * must carry the identity the store assigned it
+	 * @param veterinarians the veterinarians to draw holders from; one holding none of
+	 * the given specialties is left out
+	 */
+	public SpecialtyDirectory(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Objects.requireNonNull(specialties, "specialties to list must not be null");
+		Objects.requireNonNull(veterinarians, "veterinarians to draw holders from must not be null");
+		Map<Integer, List<Vet>> holders = holdersBySpecialtyId(veterinarians);
+		List<ListedSpecialty> paired = new ArrayList<>(specialties.size());
+		for (Specialty specialty : specialties) {
+			paired.add(new ListedSpecialty(specialty, holders.getOrDefault(identityOf(specialty), List.of())));
+		}
+		this.listedSpecialties = List.copyOf(paired);
+	}
+
+	/**
+	 * @return every specialty as this directory publishes it, in the order the directory
+	 * was given them
+	 */
+	public List<ListedSpecialty> getListedSpecialties() {
+		return this.listedSpecialties;
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			Objects.requireNonNull(veterinarian, "a veterinarian to draw holders from was null");
+			for (Specialty held : veterinarian.getSpecialties()) {
+				// A specialty the store never assigned an identity to is not one of the
+				// stored specialties this directory lists, so it matches nothing listed.
+				if (held.getId() != null) {
+					holders.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(veterinarian);
+				}
+			}
+		}
+		holders.values().forEach(held -> held.sort(HOLDER_ORDER));
+		return holders;
+	}
+
+	/**
+	 * Holders are matched by the identity the store assigned, not by object equality:
+	 * {@link Specialty} inherits none, and the two reads that feed the directory need not
+	 * return the same instances.
+	 */
+	private static Integer identityOf(Specialty specialty) {
+		Objects.requireNonNull(specialty, "a specialty to list was null");
+		if (specialty.getId() == null) {
+			throw new IllegalArgumentException("specialty '" + specialty.getName()
+					+ "' carries no identity, so the veterinarians holding it cannot be found");
+		}
+		return specialty.getId();
+	}
+
+	@Override
+	public boolean equals(Object other) {
+		return this == other || (other instanceof SpecialtyDirectory directory
+				&& this.listedSpecialties.equals(directory.listedSpecialties));
+	}
+
+	@Override
+	public int hashCode() {
+		return this.listedSpecialties.hashCode();
+	}
+
+	@Override
+	public String toString() {
+		return "SpecialtyDirectory" + this.listedSpecialties;
+	}
+
+	/**
+	 * One specialty of the directory together with the veterinarians holding it, which
+	 * may be none.
+	 */
+	public static final class ListedSpecialty {
+
+		private final Specialty specialty;
+
+		private final List<Vet> holders;
+
+		private ListedSpecialty(Specialty specialty, List<Vet> holders) {
+			this.specialty = specialty;
+			this.holders = List.copyOf(holders);
+		}
+
+		public Specialty getSpecialty() {
+			return this.specialty;
+		}
+
+		/**
+		 * @return the veterinarians holding this specialty, ordered by name; empty when
+		 * nobody holds it
+		 */
+		public List<Vet> getHolders() {
+			return this.holders;
+		}
+
+		@Override
+		public boolean equals(Object other) {
+			return this == other || (other instanceof ListedSpecialty listed && this.specialty.equals(listed.specialty)
+					&& this.holders.equals(listed.holders));
+		}
+
+		@Override
+		public int hashCode() {
+			return Objects.hash(this.specialty, this.holders);
+		}
+
+		@Override
+		public String toString() {
+			return this.specialty.getName() + "=" + this.holders.size() + " holder(s)";
+		}
+
+	}
+
+}
