+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.annotation.Import;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}.
+ * <p>
+ * The repositories are hand-written stubs rather than mocks: both are small enough to
+ * implement, and a stub keeps the test readable as a statement about stored records.
+ */
+@WebMvcTest(SpecialtyController.class)
+@Import({ SpecialtyControllerTests.StoredSpecialties.class, SpecialtyControllerTests.EmployedVets.class })
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_DIRECTORY_PAGE = "/specialties.html";
+
+	private static final String SPECIALTY_DIRECTORY_VIEW = "vets/specialtyDirectory";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private StoredSpecialties specialties;
+
+	@Autowired
+	private EmployedVets veterinarians;
+
+	private int nextId = 1;
+
+	/**
+	 * The stubs are context beans, so they outlive one test method. Each test states the
+	 * records it needs from empty.
+	 */
+	@BeforeEach
+	void emptyTheRecords() {
+		this.specialties.store();
+		this.veterinarians.employ();
+	}
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVetHolding(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() throws Exception {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		this.specialties.store(radiology, surgery, dentistry);
+		this.veterinarians.employ(createAVetHolding("Helen", "Leary", radiology));
+
+		this.mockMvc.perform(get(SPECIALTY_DIRECTORY_PAGE))
+			.andExpect(status().isOk())
+			.andExpect(view().name(SPECIALTY_DIRECTORY_VIEW))
+			.andExpect(content().string(containsString(RADIOLOGY)))
+			.andExpect(content().string(containsString(SURGERY)))
+			.andExpect(content().string(containsString(DENTISTRY)))
+			.andExpect(model().attributeDoesNotExist("currentPage", "totalPages"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHolderByFullName() throws Exception {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		this.specialties.store(radiology);
+		this.veterinarians.employ(createAVetHolding("Helen", "Leary", radiology),
+				createAVetHolding("Linda", "Douglas", radiology));
+
+		this.mockMvc.perform(get(SPECIALTY_DIRECTORY_PAGE))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("Helen Leary")))
+			.andExpect(content().string(containsString("Linda Douglas")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheNavigationEveryPageCarries() throws Exception {
+		this.specialties.store(createASpecialty(RADIOLOGY));
+
+		this.mockMvc.perform(get(SPECIALTY_DIRECTORY_PAGE))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("/owners/find")))
+			.andExpect(content().string(containsString("/vets.html")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEmptyWhenNoSpecialtyIsStored() throws Exception {
+		this.veterinarians.employ(createAVetHolding("James", "Carter"));
+
+		this.mockMvc.perform(get(SPECIALTY_DIRECTORY_PAGE))
+			.andExpect(status().isOk())
+			.andExpect(view().name(SPECIALTY_DIRECTORY_VIEW))
+			.andExpect(model().attribute("specialtyDirectory", new SpecialtyDirectory(List.of(), List.of())));
+	}
+
+	/**
+	 * Stands in for the stored specialties.
+	 */
+	static class StoredSpecialties implements SpecialtyRepository {
+
+		private List<Specialty> stored = List.of();
+
+		void store(Specialty... specialties) {
+			this.stored = List.of(specialties);
+		}
+
+		@Override
+		public List<Specialty> findSpecialties() {
+			return this.stored;
+		}
+
+	}
+
+	/**
+	 * Stands in for the veterinarians the clinic employs.
+	 */
+	static class EmployedVets implements VetRepository {
+
+		private Collection<Vet> employed = List.of();
+
+		void employ(Vet... veterinarians) {
+			this.employed = List.of(veterinarians);
+		}
+
+		@Override
+		public Collection<Vet> findAll() {
+			return this.employed;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("the specialty directory reads every veterinarian, unpaged");
+		}
+
+	}
+
+}
