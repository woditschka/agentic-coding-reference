+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatIllegalArgumentException;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the projection that reads the veterinarian
+ * association backwards: every stored specialty with the veterinarians holding it.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private int nextId = 1;
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	/**
+	 * A second object standing for the same stored specialty, as the second of the two
+	 * reads feeding the directory would return it.
+	 */
+	private Specialty createASeparateInstanceOf(Specialty stored) {
+		Specialty separate = new Specialty();
+		separate.setId(stored.getId());
+		separate.setName(stored.getName());
+		return separate;
+	}
+
+	private Vet createAVetHolding(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private List<Vet> holdersOf(SpecialtyDirectory directory, String specialtyName) {
+		return directory.getListedSpecialties()
+			.stream()
+			.filter(listed -> listed.getSpecialty().getName().equals(specialtyName))
+			.findFirst()
+			.orElseThrow(() -> new AssertionError("specialty " + specialtyName + " is not listed"))
+			.getHolders();
+	}
