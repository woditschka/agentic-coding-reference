+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for visit lookup on {@link Pet}.
+ */
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	private static final int VISIT_ID_OF_ANOTHER_PET = 99;
+
+	/** A visit that has never been saved carries no id. */
+	private static final Integer ID_OF_AN_UNSAVED_VISIT = null;
+
+	private Pet createAPetWith(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+	private Visit createABookedVisit(int visitId) {
+		Visit visit = new Visit();
+		visit.setId(visitId);
+		return visit;
+	}
+
+	private Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+	@Test
+	void thePetShouldReturnTheVisitBookedUnderTheGivenId() {
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWith(bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldReturnNoVisitForAnIdItHasNotBooked() {
+		Pet pet = createAPetWith(createABookedVisit(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(VISIT_ID_OF_ANOTHER_PET)).isNull();
+	}
+
+	@Test
+	void thePetShouldReturnNoVisitForTheIdOfAStillUnsavedVisit() {
+		Pet pet = createAPetWith(createAnUnsavedVisit());
+
+		assertThat(pet.getVisit(ID_OF_AN_UNSAVED_VISIT)).isNull();
+	}
+
+}
