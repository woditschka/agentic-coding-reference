+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for the future-date rule on {@link Visit}.
+ */
+class VisitTests {
+
+	private static final LocalDate REFERENCE_DATE = LocalDate.of(2026, 3, 1);
+
+	private static final LocalDate DATE_AFTER_REFERENCE = REFERENCE_DATE.plusDays(1);
+
+	private static final LocalDate DATE_BEFORE_REFERENCE = REFERENCE_DATE.minusDays(1);
+
+	private Visit createAVisitDatedOn(LocalDate date) {
+		Visit visit = new Visit();
+		visit.setDate(date);
+		return visit;
+	}
+
+	@Test
+	void theVisitShouldBeDatedAfterAnEarlierReferenceDate() {
+		Visit visit = createAVisitDatedOn(DATE_AFTER_REFERENCE);
+
+		assertThat(visit.isDatedAfter(REFERENCE_DATE)).isTrue();
+	}
+
+	@Test
+	void theVisitShouldNotBeDatedAfterTheReferenceDateItFallsOn() {
+		Visit visit = createAVisitDatedOn(REFERENCE_DATE);
+
+		assertThat(visit.isDatedAfter(REFERENCE_DATE)).isFalse();
+	}
+
+	@Test
+	void theVisitShouldNotBeDatedAfterALaterReferenceDate() {
+		Visit visit = createAVisitDatedOn(DATE_BEFORE_REFERENCE);
+
+		assertThat(visit.isDatedAfter(REFERENCE_DATE)).isFalse();
+	}
+
+}
