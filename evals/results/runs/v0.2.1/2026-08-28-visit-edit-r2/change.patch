+		}
+
+		this.owners.save(owner);
+		return "redirect:/owners/{ownerId}";
+	}
+
+	/**
+	 * Rejects the submitted date unless it falls after today. Booking and correction
+	 * share the one rule, so both processing methods reject through here.
+	 * @param visit the submitted visit, whose date is null when the field was left empty
+	 * and already carries a binding error
+	 * @param result the binding result the rejection is recorded on
+	 */
+	private void rejectDateNotInFuture(Visit visit, BindingResult result) {
+		if (visit.getDate() != null && !visit.isDatedAfter(LocalDate.now())) {
+			result.rejectValue("date", "typeMismatch.visitDate");
+		}
+	}
+
 }
