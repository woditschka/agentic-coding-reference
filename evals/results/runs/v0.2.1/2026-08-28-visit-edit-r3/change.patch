+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+import java.util.Optional;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.validation.BeanPropertyBindingResult;
+import org.springframework.validation.BindingResult;
+
+import jakarta.persistence.EntityManager;
+import jakarta.persistence.PersistenceContext;
+
+/**
+ * Tests that a visit correction submitted to {@link VisitController} reaches the real
+ * database. {@link VisitControllerTests} drives the same handler over a mocked repository
+ * and can only observe the in-memory object graph, so the write itself is unverifiable
+ * there.
+ */
+@DataJpaTest
+// Ensure that if the mysql profile is active we connect to the real database:
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VisitCorrectionPersistenceTests {
+
+	private static final int OWNER_ID = 6;
+
+	private static final int PET_ID = 7;
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	@Autowired
+	private OwnerRepository owners;
+
+	@PersistenceContext
+	private EntityManager entityManager;
+
+	@Test
+	@Transactional
+	void theCorrectionHandlerShouldPersistTheCorrectedVisit() {
+		final LocalDate correctedDate = LocalDate.now().plusDays(1);
+		final String correctedDescription = "rabies shot, rescheduled";
+
+		Optional<Owner> optionalOwner = this.owners.findById(OWNER_ID);
+		assertThat(optionalOwner).isPresent();
+		Owner owner = optionalOwner.get();
+		Pet pet = owner.getPet(PET_ID);
+		int booked = pet.getVisits().size();
+		Visit visit = pet.getVisit(BOOKED_VISIT_ID);
+		assertThat(visit).isNotNull();
+
+		// The form is submitted in a request of its own, so the handler receives a graph
+		// detached from the persistence context: only its own save can write.
+		this.entityManager.clear();
+		visit.setDate(correctedDate);
+		visit.setDescription(correctedDescription);
+		BindingResult result = new BeanPropertyBindingResult(visit, "visit");
+		new VisitController(this.owners).processVisitCorrectionForm(owner, visit, result);
+		this.entityManager.flush();
+		this.entityManager.clear();
+
+		optionalOwner = this.owners.findById(OWNER_ID);
+		assertThat(optionalOwner).isPresent();
+		Pet reloadedPet = optionalOwner.get().getPet(PET_ID);
+		assertThat(reloadedPet.getVisits()).hasSize(booked);
+		assertThat(reloadedPet.getVisit(BOOKED_VISIT_ID)).isNotNull()
+			.extracting(Visit::getDate, Visit::getDescription)
+			.containsExactly(correctedDate, correctedDescription);
+	}
+
+}
