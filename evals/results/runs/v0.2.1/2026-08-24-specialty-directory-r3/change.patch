+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Immutable read model pairing every specialty the clinic knows with the veterinarians
+ * holding it.
+ *
+ * <p>
+ * {@link Specialty} carries no association back to {@link Vet}, so the pairing is
+ * assembled here rather than mapped. A specialty no veterinarian holds keeps its entry
+ * with an empty veterinarian list; a veterinarian holding no specialty appears in no
+ * entry. Specialties are matched by identity, never by name, so two specialties stored
+ * under one name stay two entries.
+ *
+ * <p>
+ * See {@code docs/adr/2026-08-24-specialty-directory-as-a-derived-read-model.md} for why
+ * the pairing is derived rather than mapped.
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Specialty> BY_NAME_THEN_ID = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> BY_LAST_NAME_THEN_FIRST_NAME_THEN_ID = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * One directory entry: a specialty and the veterinarians holding it, in that order.
+	 */
+	public record Entry(Specialty specialty, List<Vet> veterinarians) {
+
+		public Entry {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+	/**
+	 * Assemble the directory from every stored specialty and every veterinarian.
+	 * <p>
+	 * Both collections are read only: neither they nor the entities they hold are
+	 * modified, which matters because veterinarians are shared through the {@code vets}
+	 * cache.
+	 * @param specialties every specialty the clinic knows, each with an identity and a
+	 * name
+	 * @param veterinarians every veterinarian the clinic employs, each with an identity
+	 * and a name
+	 * @return a directory listing each specialty by name then identity, and the
+	 * veterinarians under each by last name, first name, then identity
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_NAME_THEN_ID)
+			.map(specialty -> new Entry(specialty,
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())
+						.stream()
+						.sorted(BY_LAST_NAME_THEN_FIRST_NAME_THEN_ID)
+						.toList()))
+			.toList();
+
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty specialty : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holders;
+	}
+
+}
