+
+/**
+ * Test class for the {@link SpecialtyDirectory} read model, which pairs every stored
+ * specialty with the veterinarians holding it.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final AtomicInteger nextGeneratedId = new AtomicInteger(1);
+
+	private static Specialty specialty(String name) {
+		return specialty(nextGeneratedId.getAndIncrement(), name);
+	}
+
+	/**
+	 * Use only where the identity itself drives the assertion; otherwise let it be
+	 * generated.
+	 */
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet vet(String firstName, String lastName, Specialty... specialties) {
+		return vet(nextGeneratedId.getAndIncrement(), firstName, lastName, specialties);
+	}
+
+	/**
+	 * Use only where the identity itself drives the assertion; otherwise let it be
+	 * generated.
+	 */
+	private static Vet vet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private static List<String> specialtyNamesOf(SpecialtyDirectory directory) {
+		return directory.entries().stream().map(entry -> entry.specialty().getName()).toList();
+	}
+
+	private static List<String> fullNamesOf(SpecialtyDirectory.Entry entry) {
+		return entry.veterinarians().stream().map(vet -> vet.getFirstName() + " " + vet.getLastName()).toList();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		Specialty radiology = specialty("radiology");
+		Specialty surgery = specialty("surgery");
+		Vet helen = vet("Helen", "Leary", radiology);
+		Vet rafael = vet("Rafael", "Ortega", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen, rafael));
+
+		assertThat(specialtyNamesOf(directory)).containsExactly("radiology", "surgery");
+		assertThat(fullNamesOf(directory.entries().get(0))).containsExactly("Helen Leary");
+		assertThat(fullNamesOf(directory.entries().get(1))).containsExactly("Rafael Ortega");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByNameThenIdentity() {
+		Specialty surgery = specialty(3, "surgery");
+		Specialty dentistry = specialty(4, "dentistry");
+		Specialty secondDentistry = specialty(2, "dentistry");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, secondDentistry), List.of());
+
+		assertThat(specialtyNamesOf(directory)).containsExactly("dentistry", "dentistry", "surgery");
+		assertThat(directory.entries().stream().map(entry -> entry.specialty().getId()).toList()).containsExactly(2, 4,
+				3);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = specialty("radiology");
+		Specialty surgery = specialty("surgery");
+		Vet helen = vet("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(specialtyNamesOf(directory)).containsExactly("radiology", "surgery");
+		assertThat(directory.entries().get(1).veterinarians()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = specialty("radiology");
+		Vet helen = vet("Helen", "Leary", radiology);
+		Vet james = vet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(james, helen));
+
+		assertThat(fullNamesOf(directory.entries().get(0))).containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldHoldNoEntriesWhenTheClinicKnowsNoSpecialty() {
+		Vet james = vet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(james));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepSameNamedSpecialtiesAsSeparateEntries() {
+		Specialty dentistry = specialty("dentistry");
+		Specialty secondDentistry = specialty("dentistry");
+		Vet helen = vet("Helen", "Leary", dentistry);
+		Vet rafael = vet("Rafael", "Ortega", secondDentistry);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, secondDentistry),
+				List.of(helen, rafael));
+
+		assertThat(specialtyNamesOf(directory)).containsExactly("dentistry", "dentistry");
+		assertThat(List.of(fullNamesOf(directory.entries().get(0)), fullNamesOf(directory.entries().get(1))))
+			.containsExactlyInAnyOrder(List.of("Helen Leary"), List.of("Rafael Ortega"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastNameThenFirstName() {
+		Specialty radiology = specialty("radiology");
+		Vet helenLeary = vet(1, "Helen", "Leary", radiology);
+		Vet lindaDouglas = vet(2, "Linda", "Douglas", radiology);
+		Vet adamLeary = vet(3, "Adam", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(helenLeary, lindaDouglas, adamLeary));
+
+		assertThat(fullNamesOf(directory.entries().get(0))).containsExactly("Linda Douglas", "Adam Leary",
+				"Helen Leary");
+	}
+
+}
