+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the read model behind the specialty
+ * directory page.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int DENTISTRY_ID = 3;
+
+	private static final int LOWER_VET_ID = 2;
+
+	private static final int HIGHER_VET_ID = 9;
+
+	private static int nextVetId = 1;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByItsStoredName() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology(), surgery(), dentistry()), List.of());
+
+		assertThat(directory.specialties()).extracting(SpecialtyDirectory.SpecialtyHolders::specialtyName)
+			.containsExactlyInAnyOrder("radiology", "surgery", "dentistry");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachVeterinarianUnderTheSpecialtyHeld() {
+		Specialty radiology = radiology();
+		Specialty surgery = surgery();
+		Vet helen = vetHolding("Helen", "Leary", radiology);
+		Vet linda = vetHolding("Linda", "Douglas", radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen, linda));
+
+		assertThat(holdersOf(directory, "radiology")).containsExactlyInAnyOrder(helen, linda);
+		assertThat(holdersOf(directory, "surgery")).containsExactly(linda);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = radiology();
+		Vet helen = vetHolding("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, dentistry()), List.of(helen));
+
+		assertThat(holdersOf(directory, "dentistry")).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = radiology();
+		Vet helen = vetHolding("Helen", "Leary", radiology);
+		Vet james = vetHolding("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, james));
+
+		assertThat(everyHolderIn(directory)).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldGroupOnTheStoredIdentityRatherThanTheSpecialtyInstance() {
+		Vet helen = vetHolding("Helen", "Leary", radiology());
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology()), List.of(helen));
+
+		assertThat(directory.specialties()).hasSize(1);
+		assertThat(holdersOf(directory, "radiology")).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListSpecialtiesInNameOrder() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery(), dentistry(), radiology()), List.of());
+
+		assertThat(directory.specialties()).extracting(SpecialtyDirectory.SpecialtyHolders::specialtyName)
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListHoldersByLastNameThenFirstName() {
+		Specialty radiology = radiology();
+		Vet helenLeary = vetHolding("Helen", "Leary", radiology);
+		Vet lindaDouglas = vetHolding("Linda", "Douglas", radiology);
+		Vet adaDouglas = vetHolding("Ada", "Douglas", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(helenLeary, lindaDouglas, adaDouglas));
+
+		assertThat(holdersOf(directory, "radiology")).containsExactly(adaDouglas, lindaDouglas, helenLeary);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderHoldersSharingANameByTheirIdentifier() {
+		Specialty radiology = radiology();
+		Vet higherIdHelenLeary = vetHolding(HIGHER_VET_ID, "Helen", "Leary", radiology);
+		Vet lowerIdHelenLeary = vetHolding(LOWER_VET_ID, "Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(higherIdHelenLeary, lowerIdHelenLeary));
+
+		assertThat(holdersOf(directory, "radiology")).containsExactly(lowerIdHelenLeary, higherIdHelenLeary);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldHoldNoEntryWhenTheClinicKnowsNoSpecialty() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(vetHolding("James", "Carter")));
+
+		assertThat(directory.specialties()).isEmpty();
+		assertThat(directory.isEmpty()).isTrue();
+	}
+
+	private static List<Vet> holdersOf(SpecialtyDirectory directory, String specialtyName) {
+		return directory.specialties()
+			.stream()
+			.filter(held -> specialtyName.equals(held.specialtyName()))
+			.findFirst()
+			.orElseThrow(() -> new AssertionError("no entry for specialty " + specialtyName))
+			.holders();
+	}
+
+	private static List<Vet> everyHolderIn(SpecialtyDirectory directory) {
+		return directory.specialties().stream().flatMap(held -> held.holders().stream()).distinct().toList();
+	}
+
+	private static Specialty radiology() {
+		return specialty(RADIOLOGY_ID, "radiology");
+	}
+
+	private static Specialty surgery() {
+		return specialty(SURGERY_ID, "surgery");
+	}
+
+	private static Specialty dentistry() {
+		return specialty(DENTISTRY_ID, "dentistry");
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet vetHolding(String firstName, String lastName, Specialty... specialties) {
+		return vetHolding(nextVetId++, firstName, lastName, specialties);
+	}
+
+	private static Vet vetHolding(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
