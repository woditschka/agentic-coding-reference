+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The specialty directory: every specialty the clinic knows, each with the veterinarians
+ * holding it.
+ * <p>
+ * The store holds the association from {@link Vet} to {@link Specialty} and no inverse,
+ * so this listing is assembled in memory from a specialty read and a veterinarian read
+ * rather than read from the store. A specialty no veterinarian holds is listed with no
+ * holders.
+ *
+ * @param specialties every specialty the clinic knows, each with its holders
+ */
+public record SpecialtyDirectory(List<SpecialtyHolders> specialties) {
+
+	/**
+	 * Specialties are listed alphabetically by their stored name, with the identifier as
+	 * a tie-break. The order is settled here rather than by the store so that it does not
+	 * depend on the database vendor's collation.
+	 */
+	private static final Comparator<Specialty> BY_SPECIALTY_NAME = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	/**
+	 * Holders are listed by last name, then first name, with the identifier as a
+	 * tie-break so that two veterinarians sharing a name still hold a settled order.
+	 */
+	private static final Comparator<Vet> BY_HOLDER_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyDirectory {
+		specialties = List.copyOf(specialties);
+	}
+
+	/**
+	 * Assemble the directory from the two reads.
+	 * <p>
+	 * Holders are grouped by the stored specialty identifier, never by the
+	 * {@link Specialty} object: the entities here inherit identity equality, and the two
+	 * reads return separate instances of the same row. Neither argument nor anything
+	 * reachable from it is modified — the veterinarian read may be served from a shared
+	 * cache.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians every veterinarian the clinic employs
+	 * @return the assembled directory
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		holdersBySpecialtyId.values().forEach(holders -> holders.sort(BY_HOLDER_NAME));
+		List<SpecialtyHolders> listing = specialties.stream()
+			.sorted(BY_SPECIALTY_NAME)
+			.map(specialty -> new SpecialtyHolders(specialty.getName(),
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+		return new SpecialtyDirectory(listing);
+	}
+
+	/**
+	 * @return whether the clinic knows no specialty at all
+	 */
+	public boolean isEmpty() {
+		return this.specialties.isEmpty();
+	}
+
+	/**
+	 * One specialty of the directory together with the veterinarians holding it.
+	 *
+	 * @param specialtyName the stored name of the specialty
+	 * @param holders the veterinarians holding it, empty when none does
+	 */
+	public record SpecialtyHolders(String specialtyName, List<Vet> holders) {
+
+		public SpecialtyHolders {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+}
