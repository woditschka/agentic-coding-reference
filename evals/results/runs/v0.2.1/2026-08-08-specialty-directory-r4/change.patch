diff --git a/src/main/resources/templates/vets/specialtyList.html b/src/main/resources/templates/vets/specialtyList.html
new file mode 100644
index 0000000..c8474c6
--- /dev/null
+++ b/src/main/resources/templates/vets/specialtyList.html
@@ -0,0 +1,34 @@
+<!DOCTYPE html>
+
+<!-- The menu key below matches no entry in the shared navigation on purpose: this page
+     carries the navigation, and nothing in the navigation points at this page. -->
+<html xmlns:th="https://www.thymeleaf.org" th:replace="~{fragments/layout :: layout (~{::body},'specialties')}">
+
+<body>
+
+  <h2 th:text="#{specialties}">Specialties</h2>
+
+  <p id="no-specialties" th:if="${specialtyDirectory.empty}" th:text="#{noSpecialties}">No specialties are on
+    record.</p>
+
+  <table id="specialties" class="table table-striped" th:unless="${specialtyDirectory.empty}">
+    <thead>
+      <tr>
+        <th th:text="#{name}">Name</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="held : ${specialtyDirectory.specialties}">
+        <td th:text="${held.specialtyName}"></td>
+        <td>
+          <span th:each="holder : ${held.holders}"
+            th:text="${holder.firstName + ' ' + holder.lastName + ' '}" /> <span
+            class="specialty-without-holders" th:if="${held.holders.empty}" th:text="#{none}">none</span>
+        </td>
+      </tr>
+    </tbody>
+  </table>
+</body>
+
+</html>
