+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}, which serves the specialty directory
+ * page.
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_DIRECTORY = "/specialties.html";
+
+	private static int nextVetId = 1;
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@MockitoBean
+	private SpecialtyRepository specialties;
+
+	@MockitoBean
+	private VetRepository vets;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByItsStoredName() throws Exception {
+		givenTheClinicKnows(List.of(radiology(), surgery(), dentistry()), List.of());
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attributeExists("specialtyDirectory"))
+			.andExpect(content().string(containsString("radiology")))
+			.andExpect(content().string(containsString("surgery")))
+			.andExpect(content().string(containsString("dentistry")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachHolderByFirstAndLastName() throws Exception {
+		Specialty radiology = radiology();
+		givenTheClinicKnows(List.of(radiology), List.of(vetHolding("Helen", "Leary", radiology)));
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() throws Exception {
+		Specialty radiology = radiology();
+		givenTheClinicKnows(List.of(radiology),
+				List.of(vetHolding("Helen", "Leary", radiology), vetHolding("James", "Carter")));
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("Helen Leary")))
+			.andExpect(content().string(not(containsString("James"))))
+			.andExpect(content().string(not(containsString("Carter"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() throws Exception {
+		Specialty radiology = radiology();
+		givenTheClinicKnows(List.of(radiology, dentistry()), List.of(vetHolding("Helen", "Leary", radiology)));
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("dentistry")))
+			.andExpect(content().string(containsString("class=\"specialty-without-holders\"")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEverySpecialtyOnOnePage() throws Exception {
+		givenTheClinicKnows(List.of(radiology(), surgery(), dentistry()), List.of());
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("radiology")))
+			.andExpect(content().string(containsString("surgery")))
+			.andExpect(content().string(containsString("dentistry")))
+			.andExpect(content().string(not(containsString("?page="))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldReportThatThereIsNoneWhenTheClinicKnowsNoSpecialty() throws Exception {
+		givenTheClinicKnows(List.of(), List.of(vetHolding("James", "Carter")));
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("id=\"no-specialties\"")))
+			.andExpect(content().string(containsString("No specialties are on record")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheSharedNavigationWithoutLinkingToItself() throws Exception {
+		givenTheClinicKnows(List.of(radiology()), List.of());
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("/vets.html")))
+			.andExpect(content().string(containsString("/owners/find")))
+			.andExpect(content().string(not(containsString(SPECIALTY_DIRECTORY))));
+	}
+
+	private void givenTheClinicKnows(List<Specialty> knownSpecialties, List<Vet> employedVets) {
+		given(this.specialties.findAll()).willReturn(knownSpecialties);
+		given(this.vets.findAll()).willReturn(employedVets);
+	}
+
+	private static Specialty radiology() {
+		return specialty(1, "radiology");
+	}
+
+	private static Specialty surgery() {
+		return specialty(2, "surgery");
+	}
+
+	private static Specialty dentistry() {
+		return specialty(3, "dentistry");
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet vetHolding(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(nextVetId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
