+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the specialty-to-veterinarian inversion.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	/**
+	 * A second stored row sharing the name "radiology", so only the id can break the tie.
+	 */
+	private static final int SECOND_RADIOLOGY_ID = 3;
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private static SpecialtyDirectory.Entry entryOf(String specialtyName, SpecialtyDirectory.Holder... holders) {
+		return new SpecialtyDirectory.Entry(specialtyName, List.of(holders));
+	}
+
+	private static SpecialtyDirectory.Holder holderOf(String firstName, String lastName) {
+		return new SpecialtyDirectory.Holder(firstName, lastName);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, "radiology");
+		Specialty surgery = createASpecialty(SURGERY_ID, "surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of());
+
+		assertThat(directory.getEntries()).extracting(SpecialtyDirectory.Entry::getSpecialtyName)
+			.containsExactly("radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHolderByFullName() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, "radiology");
+		Vet helen = createAVet(1, "Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory.getEntries()).containsExactly(entryOf("radiology", holderOf("Helen", "Leary")));
+		assertThat(directory.getEntries().get(0).getHolders().get(0).getFullName()).isEqualTo("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldGroupHoldersByStoredIdAcrossSeparateInstances() {
+		Specialty radiologyFromTheSpecialtyQuery = createASpecialty(RADIOLOGY_ID, "radiology");
+		Specialty radiologyFromTheVetCache = createASpecialty(RADIOLOGY_ID, "radiology");
+		Vet helen = createAVet(1, "Helen", "Leary", radiologyFromTheVetCache);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiologyFromTheSpecialtyQuery), List.of(helen));
+
+		assertThat(directory.getEntries()).containsExactly(entryOf("radiology", holderOf("Helen", "Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesAndHoldersStably() {
+		Specialty surgery = createASpecialty(SURGERY_ID, "surgery");
+		Specialty radiologyStoredFirst = createASpecialty(RADIOLOGY_ID, "radiology");
+		Specialty radiologyStoredSecond = createASpecialty(SECOND_RADIOLOGY_ID, "radiology");
+		Vet linda = createAVet(1, "Linda", "Douglas", surgery);
+		Vet helen = createAVet(2, "Helen", "Leary", surgery, radiologyStoredFirst);
+		Vet rafael = createAVet(3, "Rafael", "Ortega", surgery);
+		Vet alice = createAVet(4, "Alice", "Leary", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory
+			.of(List.of(surgery, radiologyStoredSecond, radiologyStoredFirst), List.of(rafael, helen, alice, linda));
+
+		assertThat(directory.getEntries()).containsExactly(entryOf("radiology", holderOf("Helen", "Leary")),
+				entryOf("radiology"), entryOf("surgery", holderOf("Linda", "Douglas"), holderOf("Alice", "Leary"),
+						holderOf("Helen", "Leary"), holderOf("Rafael", "Ortega")));
+		SpecialtyDirectory reopened = SpecialtyDirectory
+			.of(List.of(radiologyStoredFirst, surgery, radiologyStoredSecond), List.of(linda, alice, rafael, helen));
+		assertThat(reopened).isEqualTo(directory);
+	}
+
+	/**
+	 * Two veterinarians may share a full name. A holder is projected from the two names
+	 * alone, so the two are indistinguishable once projected and their relative order
+	 * cannot be asserted; what the page must not do is show the specialty as held once.
+	 */
+	@Test
+	void theSpecialtyDirectoryShouldListEachVeterinarianWhenTwoShareAFullName() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, "radiology");
+		Vet helenHiredFirst = createAVet(1, "Helen", "Leary", radiology);
+		Vet helenHiredLater = createAVet(5, "Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(helenHiredLater, helenHiredFirst));
+
+		assertThat(directory.getEntries())
+			.containsExactly(entryOf("radiology", holderOf("Helen", "Leary"), holderOf("Helen", "Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, "radiology");
+		Specialty surgery = createASpecialty(SURGERY_ID, "surgery");
+		Vet helen = createAVet(1, "Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(directory.getEntries()).containsExactly(entryOf("radiology", holderOf("Helen", "Leary")),
+				entryOf("surgery"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, "radiology");
+		Vet helen = createAVet(1, "Helen", "Leary", radiology);
+		Vet james = createAVet(2, "James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(james, helen));
+
+		assertThat(directory.getEntries()).containsExactly(entryOf("radiology", holderOf("Helen", "Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderWhenTheClinicKnowsNoSpecialty() {
+		Vet james = createAVet(1, "James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(james));
+
+		assertThat(directory.getEntries()).isEmpty();
+	}
+
+}
