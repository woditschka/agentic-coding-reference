+/*
+ * Copyright 2012-2025 the original author or authors.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      https://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * Immutable projection listing every {@link Specialty} the clinic knows, each with the
+ * veterinarians holding it.
+ * <p>
+ * {@link Specialty} carries no inverse mapping to {@link Vet}, so the directory inverts
+ * the association in memory. Grouping keys on the stored id rather than on the
+ * {@code Specialty} object: entities inherit no {@code equals}, and the two collections
+ * reach this class from different sources - specialties from a fresh query, vets from the
+ * {@code "vets"} cache - so the same stored row arrives as two distinct instances.
+ * <p>
+ * The directory carries projected values only, never entity references, and is built by a
+ * pure function of its two arguments.
+ * <p>
+ * Both orders are applied here rather than by a SQL {@code ORDER BY}: string ordering in
+ * the database depends on the vendor's collation, which has already made one page behave
+ * differently across vendors. Comparing the stored strings in the JVM keeps the page's
+ * order the same everywhere and independent of the reader's language.
+ */
+public final class SpecialtyDirectory {
+
+	/**
+	 * Ascending by stored name, then by stored id. Two specialties may share a name, and
+	 * the id then decides which entry the page lists first.
+	 */
+	private static final Comparator<Specialty> BY_NAME = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	/**
+	 * Ascending by last name, then first name, then stored id. The id step decides
+	 * nothing a reader can see: a holder carries the two names alone, so two
+	 * veterinarians sharing a full name project to equal holders. It is kept so the sort
+	 * stays deterministic whatever order the repository returns.
+	 */
+	private static final Comparator<Vet> BY_LAST_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	private final List<Entry> entries;
+
+	private SpecialtyDirectory(List<Entry> entries) {
+		this.entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Invert the veterinarian-to-specialty association.
+	 * @param specialties every specialty the clinic knows; a specialty no veterinarian
+	 * holds still yields an entry, with no holders
+	 * @param vets every veterinarian; one holding no specialty contributes no holder
+	 * @return the directory, one entry per given specialty
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<Holder>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet vet : vets.stream().sorted(BY_LAST_NAME).toList()) {
+			for (Specialty held : vet.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(held.getId(), id -> new ArrayList<>())
+					.add(new Holder(vet.getFirstName(), vet.getLastName()));
+			}
+		}
+		List<Entry> entries = new ArrayList<>();
+		for (Specialty specialty : specialties.stream().sorted(BY_NAME).toList()) {
+			List<Holder> holders = holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of());
+			entries.add(new Entry(specialty.getName(), holders));
+		}
+		return new SpecialtyDirectory(entries);
+	}
+
+	public List<Entry> getEntries() {
+		return this.entries;
+	}
+
+	@Override
+	public boolean equals(Object other) {
+		return other instanceof SpecialtyDirectory directory && this.entries.equals(directory.entries);
+	}
+
+	@Override
+	public int hashCode() {
+		return this.entries.hashCode();
+	}
+
+	@Override
+	public String toString() {
+		return "SpecialtyDirectory" + this.entries;
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it.
+	 */
+	public static final class Entry {
+
+		private final String specialtyName;
+
+		private final List<Holder> holders;
+
+		Entry(String specialtyName, List<Holder> holders) {
+			this.specialtyName = specialtyName;
+			this.holders = List.copyOf(holders);
+		}
+
+		public String getSpecialtyName() {
+			return this.specialtyName;
+		}
+
+		public List<Holder> getHolders() {
+			return this.holders;
+		}
+
+		@Override
+		public boolean equals(Object other) {
+			return other instanceof Entry entry && Objects.equals(this.specialtyName, entry.specialtyName)
+					&& this.holders.equals(entry.holders);
+		}
+
+		@Override
+		public int hashCode() {
+			return Objects.hash(this.specialtyName, this.holders);
+		}
+
+		@Override
+		public String toString() {
+			return this.specialtyName + this.holders;
+		}
+
+	}
+
+	/**
+	 * A veterinarian holding a specialty, named as the page shows them.
+	 */
+	public static final class Holder {
+
+		private final String firstName;
+
+		private final String lastName;
+
+		Holder(String firstName, String lastName) {
+			this.firstName = firstName;
+			this.lastName = lastName;
+		}
+
+		/**
+		 * @return the display form, first name then last name
+		 */
+		public String getFullName() {
+			return this.firstName + " " + this.lastName;
+		}
+
+		@Override
+		public boolean equals(Object other) {
+			return other instanceof Holder holder && Objects.equals(this.firstName, holder.firstName)
+					&& Objects.equals(this.lastName, holder.lastName);
+		}
+
+		@Override
+		public int hashCode() {
+			return Objects.hash(this.firstName, this.lastName);
+		}
+
+		@Override
+		public String toString() {
+			return getFullName();
+		}
+
+	}
+
+}
