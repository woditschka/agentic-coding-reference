+	void theSpecialtyDirectoryPageShouldExposeTheDirectoryToItsView() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(model().attributeExists("specialtyDirectory"))
+			.andExpect(view().name("vets/specialtyList"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryPageShouldShowEachSpecialtyWithItsHolders() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(stringContainsInOrder("radiology", "Helen Leary", "surgery", "none")))
+			.andExpect(content().string(not(containsString("James"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryPageShouldOfferNoSearchNoFilterAndNoPageControl() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(not(containsString("<input"))))
+			.andExpect(content().string(not(containsString("<select"))))
+			.andExpect(content().string(not(containsString("<form"))))
+			.andExpect(content().string(not(containsString("page="))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryPageShouldOfferNoLinkToItself() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(not(containsString("/specialties.html"))))
+			.andExpect(content().string(not(containsString("nav-link active"))));
+	}
+
+}
