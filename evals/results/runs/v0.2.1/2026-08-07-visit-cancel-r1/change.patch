+package org.springframework.samples.petclinic.owner;
+
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+
+/**
+ * Withdraws a visit from an owner's record.
+ * <p>
+ * This handler is deliberately kept out of {@link VisitController}, which declares a
+ * {@code @ModelAttribute} that adds a fresh {@link Visit} to the pet before every handler
+ * in that class; saving the owner here would persist that phantom visit.
+ */
+@Controller
+class VisitCancellationController {
+
+	private final OwnerRepository owners;
+
+	public VisitCancellationController(OwnerRepository owners) {
+		this.owners = owners;
+	}
+
+	/**
+	 * Cancels the named visit and returns to the owner's record.
+	 * <p>
+	 * The owner's record is shown again whatever the outcome. A cancellation the
+	 * aggregate refuses — a visit the owner does not hold, or one that is no longer
+	 * upcoming — leaves the record unchanged and unsaved.
+	 */
+	@PostMapping("/owners/{ownerId}/pets/{petId}/visits/{visitId}/cancel")
+	public String cancelVisit(@PathVariable int ownerId, @PathVariable int petId, @PathVariable int visitId) {
+		this.owners.findById(ownerId).ifPresent(owner -> {
+			if (owner.cancelVisit(petId, visitId)) {
+				this.owners.save(owner);
+			}
+		});
+		return "redirect:/owners/{ownerId}";
+	}
+
+}
