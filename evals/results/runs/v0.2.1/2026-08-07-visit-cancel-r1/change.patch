+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link Pet}.
+ */
+class PetTests {
+
+	private static final int UPCOMING_VISIT_ID = 10;
+
+	private static final int TODAYS_VISIT_ID = 11;
+
+	private static final int VISIT_NO_LONGER_HELD_ID = 99;
+
+	private Pet max;
+
+	@BeforeEach
+	void setup() {
+		this.max = new Pet();
+		this.max.setName("Max");
+		this.max.setId(1);
+		this.max.addVisit(visit(UPCOMING_VISIT_ID, LocalDate.now().plusDays(3), "vaccination"));
+		this.max.addVisit(visit(TODAYS_VISIT_ID, LocalDate.now(), "nail trim"));
+	}
+
+	@Test
+	void cancellingAnUpcomingVisitShouldRemoveItAndReportTheCancellation() {
+		assertThat(this.max.cancelVisit(UPCOMING_VISIT_ID)).isTrue();
+
+		assertThat(visitIds()).containsExactly(TODAYS_VISIT_ID);
+	}
+
+	@Test
+	void cancellingAVisitDatedTodayOrEarlierShouldBeRefusedAndLeaveItInPlace() {
+		assertThat(this.max.cancelVisit(TODAYS_VISIT_ID)).isFalse();
+
+		assertThat(visitIds()).containsExactly(UPCOMING_VISIT_ID, TODAYS_VISIT_ID);
+	}
+
+	@Test
+	void cancellingAVisitThePetDoesNotHoldShouldBeRefused() {
+		assertThat(this.max.cancelVisit(VISIT_NO_LONGER_HELD_ID)).isFalse();
+
+		assertThat(visitIds()).containsExactly(UPCOMING_VISIT_ID, TODAYS_VISIT_ID);
+	}
+
+	private List<Integer> visitIds() {
+		return this.max.getVisits().stream().map(Visit::getId).toList();
+	}
+
+	private static Visit visit(int id, LocalDate date, String description) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		visit.setDate(date);
+		visit.setDescription(description);
+		return visit;
+	}
+
+}
