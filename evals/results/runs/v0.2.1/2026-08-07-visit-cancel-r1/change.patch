+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link Visit}.
+ */
+class VisitTests {
+
+	@Test
+	void aVisitDatedLaterThanTodayShouldBeUpcoming() {
+		assertThat(visitDatedFor(LocalDate.now().plusDays(1)).isUpcoming()).isTrue();
+	}
+
+	@Test
+	void aVisitDatedTodayShouldNoLongerBeUpcoming() {
+		assertThat(visitDatedFor(LocalDate.now()).isUpcoming()).isFalse();
+	}
+
+	@Test
+	void aVisitDatedBeforeTodayShouldNoLongerBeUpcoming() {
+		assertThat(visitDatedFor(LocalDate.now().minusDays(1)).isUpcoming()).isFalse();
+	}
+
+	@Test
+	void aVisitWithoutADateShouldNotBeUpcoming() {
+		assertThat(visitDatedFor(null).isUpcoming()).isFalse();
+	}
+
+	private static Visit visitDatedFor(LocalDate date) {
+		Visit visit = new Visit();
+		visit.setDate(date);
+		visit.setDescription("vaccination");
+		return visit;
+	}
+
+}
