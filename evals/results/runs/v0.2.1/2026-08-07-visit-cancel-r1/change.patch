+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.BDDMockito.given;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.redirectedUrl;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Optional;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+
+/**
+ * Test class for {@link VisitCancellationController}
+ */
+@WebMvcTest(VisitCancellationController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class VisitCancellationControllerTests {
+
+	private static final int GEORGE_ID = 1;
+
+	private static final int MAX_ID = 1;
+
+	private static final int ROSY_ID = 3;
+
+	private static final int MAX_UPCOMING_VISIT_ID = 10;
+
+	private static final int MAX_LATER_VISIT_ID = 11;
+
+	private static final int MAX_TODAYS_VISIT_ID = 12;
+
+	private static final int ROSY_ONLY_VISIT_ID = 30;
+
+	private static final int HAROLDS_PET_ID = 5;
+
+	private static final int HAROLDS_PETS_VISIT_ID = 50;
+
+	private static final int VISIT_NO_LONGER_HELD_ID = 99;
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@MockitoBean
+	private OwnerRepository owners;
+
+	private Owner george;
+
+	private Owner harold;
+
+	@BeforeEach
+	void setup() {
+		this.george = owner(GEORGE_ID, "George", "Franklin");
+		Pet max = petOf(this.george, MAX_ID, "Max");
+		max.addVisit(visit(MAX_UPCOMING_VISIT_ID, LocalDate.now().plusDays(3), "vaccination"));
+		max.addVisit(visit(MAX_LATER_VISIT_ID, LocalDate.now().plusDays(9), "check-up"));
+		max.addVisit(visit(MAX_TODAYS_VISIT_ID, LocalDate.now(), "nail trim"));
+		Pet rosy = petOf(this.george, ROSY_ID, "Rosy");
+		rosy.addVisit(visit(ROSY_ONLY_VISIT_ID, LocalDate.now().plusDays(5), "worming"));
+
+		this.harold = owner(2, "Harold", "Davis");
+		Pet iggy = petOf(this.harold, HAROLDS_PET_ID, "Iggy");
+		iggy.addVisit(visit(HAROLDS_PETS_VISIT_ID, LocalDate.now().plusDays(4), "scale rot"));
+
+		given(this.owners.findById(GEORGE_ID)).willReturn(Optional.of(this.george));
+	}
+
+	@Test
+	void cancellingAnUpcomingVisitShouldRemoveItFromThePetsRecord() throws Exception {
+		cancel(GEORGE_ID, MAX_ID, MAX_UPCOMING_VISIT_ID).andExpect(status().is3xxRedirection())
+			.andExpect(redirectedUrl("/owners/" + GEORGE_ID));
+
+		assertThat(visitIdsOf(MAX_ID)).doesNotContain(MAX_UPCOMING_VISIT_ID);
+		verify(this.owners).save(this.george);
+	}
+
+	@Test
+	void cancellingAnUpcomingVisitShouldLeaveOtherVisitsUntouched() throws Exception {
+		cancel(GEORGE_ID, MAX_ID, MAX_UPCOMING_VISIT_ID);
+
+		assertThat(visitIdsOf(MAX_ID)).containsExactly(MAX_LATER_VISIT_ID, MAX_TODAYS_VISIT_ID);
+		assertThat(visitIdsOf(ROSY_ID)).containsExactly(ROSY_ONLY_VISIT_ID);
+	}
+
+	@Test
+	void cancellingAPetsOnlyVisitShouldLeaveThePetWithNoVisits() throws Exception {
+		cancel(GEORGE_ID, ROSY_ID, ROSY_ONLY_VISIT_ID);
+
+		assertThat(visitIdsOf(ROSY_ID)).isEmpty();
+		assertThat(this.george.getPet("Rosy")).isNotNull();
+	}
+
+	@Test
+	void cancellingAVisitDatedTodayOrEarlierShouldBeRefused() throws Exception {
+		cancel(GEORGE_ID, MAX_ID, MAX_TODAYS_VISIT_ID).andExpect(status().is3xxRedirection())
+			.andExpect(redirectedUrl("/owners/" + GEORGE_ID));
+
+		assertThat(visitIdsOf(MAX_ID)).contains(MAX_TODAYS_VISIT_ID);
+		verify(this.owners, never()).save(any());
+	}
+
+	@Test
+	void cancellingAVisitOfAnotherOwnersPetShouldBeRefused() throws Exception {
+		cancel(GEORGE_ID, HAROLDS_PET_ID, HAROLDS_PETS_VISIT_ID).andExpect(status().is3xxRedirection())
+			.andExpect(redirectedUrl("/owners/" + GEORGE_ID));
+
+		assertThat(this.harold.getPet(HAROLDS_PET_ID).getVisits()).extracting(Visit::getId)
+			.containsExactly(HAROLDS_PETS_VISIT_ID);
+		verify(this.owners, never()).save(any());
+	}
+
+	@Test
+	void cancellingAVisitNoLongerHeldShouldLeaveTheRecordUnchanged() throws Exception {
+		cancel(GEORGE_ID, MAX_ID, VISIT_NO_LONGER_HELD_ID).andExpect(status().is3xxRedirection())
+			.andExpect(redirectedUrl("/owners/" + GEORGE_ID));
+
+		assertThat(visitIdsOf(MAX_ID)).containsExactly(MAX_UPCOMING_VISIT_ID, MAX_LATER_VISIT_ID, MAX_TODAYS_VISIT_ID);
+		verify(this.owners, never()).save(any());
+	}
+
+	private ResultActions cancel(int ownerId, int petId, int visitId) throws Exception {
+		return this.mockMvc
+			.perform(post("/owners/{ownerId}/pets/{petId}/visits/{visitId}/cancel", ownerId, petId, visitId));
+	}
+
+	private List<Integer> visitIdsOf(int petId) {
+		return this.george.getPet(petId).getVisits().stream().map(Visit::getId).toList();
+	}
+
+	private static Owner owner(int id, String firstName, String lastName) {
+		Owner owner = new Owner();
+		owner.setId(id);
+		owner.setFirstName(firstName);
+		owner.setLastName(lastName);
+		owner.setAddress("110 W. Liberty St.");
+		owner.setCity("Madison");
+		owner.setTelephone("6085551023");
+		return owner;
+	}
+
+	private static Pet petOf(Owner owner, int id, String name) {
+		Pet pet = new Pet();
+		pet.setName(name);
+		owner.addPet(pet);
+		pet.setId(id);
+		return pet;
+	}
+
+	private static Visit visit(int id, LocalDate date, String description) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		visit.setDate(date);
+		visit.setDescription(description);
+		return visit;
+	}
+
+}
