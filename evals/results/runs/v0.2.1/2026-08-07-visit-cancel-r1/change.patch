+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link Owner}.
+ */
+class OwnerTests {
+
+	private static final int MAX_ID = 1;
+
+	private static final int MAX_UPCOMING_VISIT_ID = 10;
+
+	private static final int PET_NOT_HELD_ID = 5;
+
+	private Owner george;
+
+	@BeforeEach
+	void setup() {
+		this.george = new Owner();
+		this.george.setId(1);
+		this.george.setFirstName("George");
+		this.george.setLastName("Franklin");
+		Pet max = new Pet();
+		max.setName("Max");
+		this.george.addPet(max);
+		max.setId(MAX_ID);
+		max.addVisit(visit(MAX_UPCOMING_VISIT_ID, LocalDate.now().plusDays(3), "vaccination"));
+	}
+
+	@Test
+	void cancellingThroughTheOwnerShouldWithdrawTheNamedPetsVisit() {
+		assertThat(this.george.cancelVisit(MAX_ID, MAX_UPCOMING_VISIT_ID)).isTrue();
+
+		assertThat(this.george.getPet(MAX_ID).getVisits()).isEmpty();
+	}
+
+	@Test
+	void cancellingForAPetTheOwnerDoesNotHoldShouldBeRefused() {
+		assertThat(this.george.cancelVisit(PET_NOT_HELD_ID, MAX_UPCOMING_VISIT_ID)).isFalse();
+
+		assertThat(this.george.getPet(MAX_ID).getVisits()).extracting(Visit::getId)
+			.containsExactly(MAX_UPCOMING_VISIT_ID);
+	}
+
+	private static Visit visit(int id, LocalDate date, String description) {
