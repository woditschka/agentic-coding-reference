+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.Repository;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Repository class for <code>Specialty</code> domain objects. Reaches specialties on
+ * their own, including those no <code>Vet</code> holds, which are unreachable through
+ * {@link VetRepository}. Read-only: it extends the <code>Repository</code> marker rather
+ * than a store-writing interface, so no write operation is exposed.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve all {@link Specialty}s from the data store, ordered by name.
+	 * @return a List of {@link Specialty}s.
+	 */
+	@Transactional(readOnly = true)
+	@Query("SELECT specialty FROM Specialty specialty ORDER BY specialty.name")
+	List<Specialty> findSpecialties();
+
+}
