+class SpecialtyControllerTests {
+
+	private static final String DIRECTORY_URL = "/specialties.html";
+
+	private static final String DIRECTORY_ATTRIBUTE = "specialtyDirectory";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String HELEN_FIRST_NAME = "Helen";
+
+	private static final String HELEN_LAST_NAME = "Leary";
