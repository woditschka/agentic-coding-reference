+package org.springframework.samples.petclinic.vet;
+
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.GetMapping;
+
+/**
+ * Serves the specialty directory: every specialty the clinic knows, each with the
+ * veterinarians holding it. Read-only, and separate from {@link VetController} so the
+ * veterinarian list keeps its own dependencies.
+ */
+@Controller
+class SpecialtyController {
+
+	private final SpecialtyRepository specialtyRepository;
+
+	private final VetRepository vetRepository;
+
+	SpecialtyController(SpecialtyRepository specialtyRepository, VetRepository vetRepository) {
+		this.specialtyRepository = specialtyRepository;
+		this.vetRepository = vetRepository;
+	}
+
+	@GetMapping("/specialties.html")
+	public String showSpecialtyDirectory(Model model) {
+		model.addAttribute("specialtyDirectory", SpecialtyDirectoryEntry
+			.directoryOf(this.specialtyRepository.findSpecialties(), this.vetRepository.findAll()));
+		return "vets/specialtyList";
+	}
+
+}
