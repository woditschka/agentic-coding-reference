+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.stream.Collectors;
+
+/**
+ * One line of the specialty directory: a specialty's stored name together with the full
+ * names of the veterinarians holding it.
+ *
+ * @param name the specialty's stored name
+ * @param veterinarians the holders' full names, first name then last name, ordered by
+ * last name then first name
+ */
+public record SpecialtyDirectoryEntry(String name, List<String> veterinarians) {
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	public SpecialtyDirectoryEntry {
+		Objects.requireNonNull(name, "A directory entry needs the specialty's stored name");
+		veterinarians = List.copyOf(veterinarians);
+	}
+
+	/**
+	 * Projects the stored specialties and the veterinarian roster into one entry per
+	 * specialty, in the order the specialties are given. A specialty no veterinarian
+	 * holds keeps its place with no holder named, and a veterinarian holding no specialty
+	 * appears in no entry.
+	 * @param specialties every specialty the clinic knows, in presentation order
+	 * @param veterinarians the veterinarian roster, in any order
+	 * @return one entry per given specialty
+	 */
+	public static List<SpecialtyDirectoryEntry> directoryOf(Collection<Specialty> specialties,
+			Collection<Vet> veterinarians) {
+		Map<Integer, List<String>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+		return specialties.stream()
+			.map(specialty -> new SpecialtyDirectoryEntry(specialty.getName(),
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+	}
+
+	/**
+	 * Groups the holders' full names by specialty identity. Specialties are grouped by id
+	 * rather than by instance because the entities carry no value equality, and a
+	 * specialty reached through a veterinarian is a different instance from the same
+	 * specialty read on its own. A specialty that carries no id yet is not stored, so no
+	 * entry can match it and its holders are left out.
+	 */
+	private static Map<Integer, List<String>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		return veterinarians.stream()
+			.sorted(BY_LAST_THEN_FIRST_NAME)
+			.flatMap(veterinarian -> veterinarian.getSpecialties()
+				.stream()
+				.filter(specialty -> specialty.getId() != null)
+				.map(specialty -> Map.entry(specialty.getId(), fullNameOf(veterinarian))))
+			.collect(Collectors.groupingBy(Map.Entry::getKey,
+					Collectors.mapping(Map.Entry::getValue, Collectors.toList())));
+	}
+
+	private static String fullNameOf(Vet veterinarian) {
+		return veterinarian.getFirstName() + " " + veterinarian.getLastName();
+	}
+
+}
