+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for the specialty directory projection {@link SpecialtyDirectoryEntry}.
+ */
+class SpecialtyDirectoryEntryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPreserveTheSpecialtyOrderItIsGiven() {
+		List<Specialty> orderedByName = List.of(createASpecialty(RADIOLOGY_ID, RADIOLOGY),
+				createASpecialty(SURGERY_ID, SURGERY));
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(orderedByName, List.of());
+
+		assertThat(directory).containsExactly(new SpecialtyDirectoryEntry(RADIOLOGY, List.of()),
+				new SpecialtyDirectoryEntry(SURGERY, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderHoldersByLastThenFirstName() {
+		List<Specialty> radiology = List.of(createASpecialty(RADIOLOGY_ID, RADIOLOGY));
+		List<Vet> unorderedHolders = List.of(createAVet("Linda", "Douglas", createASpecialty(RADIOLOGY_ID, RADIOLOGY)),
+				createAVet("Helen", "Leary", createASpecialty(RADIOLOGY_ID, RADIOLOGY)),
+				createAVet("Adam", "Douglas", createASpecialty(RADIOLOGY_ID, RADIOLOGY)));
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(radiology, unorderedHolders);
+
+		assertThat(directory).containsExactly(
+				new SpecialtyDirectoryEntry(RADIOLOGY, List.of("Adam Douglas", "Linda Douglas", "Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldGroupHoldersOnSpecialtyIdRatherThanInstance() {
+		List<Specialty> storedSpecialties = List.of(createASpecialty(RADIOLOGY_ID, RADIOLOGY));
+		Vet holderWithADistinctSpecialtyInstance = createAVet("Helen", "Leary",
+				createASpecialty(RADIOLOGY_ID, RADIOLOGY));
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(storedSpecialties,
+				List.of(holderWithADistinctSpecialtyInstance));
