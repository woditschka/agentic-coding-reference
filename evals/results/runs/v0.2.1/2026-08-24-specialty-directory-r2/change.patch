+		assertThat(pageAt(template, "/vets.html")).doesNotContain("specialties.html");
+	}
+
+	private String pageAt(RestTemplate template, String path) {
+		ResponseEntity<String> result = template.exchange(RequestEntity.get(path).build(), String.class);
+		assertThat(result.getStatusCode()).isEqualTo(HttpStatus.OK);
+		return result.getBody();
+	}
+
