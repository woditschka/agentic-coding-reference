+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Tests for {@link SpecialtyDirectory}, the projection that lists every specialty with
+ * the veterinarians holding it.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	/** Also an i18n message key: messages.properties maps welcome=Welcome. */
+	private static final String NAME_COLLIDING_WITH_A_MESSAGE_KEY = "welcome";
+
+	/** "chirurgie reparatrice", accent escaped to keep this source ASCII. */
+	private static final String NAME_WITH_NON_ASCII_CHARACTERS = "chirurgie r\u00e9paratrice";
+
+	private int nextId = 1;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+
+		SpecialtyDirectory directory = createADirectory(List.of(radiology, surgery),
+				List.of(createAVet("Helen", "Leary", radiology)));
+
+		assertThat(directory.getEntries()).extracting(entry -> entry.getSpecialty().getName())
+			.containsExactly(RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryEverySpecialtyNameVerbatim() {
+		// A specialty name is stored data, never translated wording: it passes
+		// through untouched even when it doubles as a message key or holds
+		// characters a translation would rewrite. Rendering: VetControllerTests.
+		Specialty messageKeyName = createASpecialty(NAME_COLLIDING_WITH_A_MESSAGE_KEY);
+		Specialty nonAsciiName = createASpecialty(NAME_WITH_NON_ASCII_CHARACTERS);
+
+		SpecialtyDirectory directory = createADirectory(List.of(messageKeyName, nonAsciiName), List.of());
+
+		assertThat(directory.getEntries()).extracting(entry -> entry.getSpecialty().getName())
+			.containsExactly(NAME_WITH_NON_ASCII_CHARACTERS, NAME_COLLIDING_WITH_A_MESSAGE_KEY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByName() {
+		Specialty surgery = createASpecialty(SURGERY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Specialty radiology = createASpecialty(RADIOLOGY);
+
+		SpecialtyDirectory directory = createADirectory(List.of(surgery, dentistry, radiology), List.of());
+
+		assertThat(directory.getEntries()).extracting(entry -> entry.getSpecialty().getName())
+			.containsExactly(DENTISTRY, RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastNameThenFirstName() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVet("Helen", "Leary", radiology);
+		Vet jamesCarter = createAVet("James", "Carter", radiology);
+		Vet lindaCarter = createAVet("Linda", "Carter", radiology);
+
+		SpecialtyDirectory directory = createADirectory(List.of(radiology),
+				List.of(helenLeary, lindaCarter, jamesCarter));
+
+		assertThat(entryFor(directory, RADIOLOGY).getVeterinarians()).containsExactly(jamesCarter, lindaCarter,
+				helenLeary);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldProjectTheSameOrderEveryTime() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		List<Specialty> storedSpecialties = List.of(radiology, dentistry);
+		List<Vet> storedVets = List.of(createAVet("Helen", "Leary", radiology),
+				createAVet("James", "Carter", radiology, dentistry));
+
+		SpecialtyDirectory firstReading = createADirectory(storedSpecialties, storedVets);
+		SpecialtyDirectory secondReading = createADirectory(storedSpecialties, storedVets);
+
+		assertThat(firstReading).isEqualTo(secondReading);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVet("Helen", "Leary", radiology);
+		Vet jamesCarter = createAVet("James", "Carter");
+
+		SpecialtyDirectory directory = createADirectory(List.of(radiology), List.of(jamesCarter, helenLeary));
+
+		assertThat(directory.getEntries()).flatExtracting(SpecialtyDirectory.Entry::getVeterinarians)
+			.containsExactly(helenLeary);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+
+		SpecialtyDirectory directory = createADirectory(List.of(radiology, surgery),
+				List.of(createAVet("Helen", "Leary", radiology)));
+
+		assertThat(entryFor(directory, SURGERY).getVeterinarians()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEverySpecialtyHeld() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet helenLeary = createAVet("Helen", "Leary", radiology, surgery);
+
+		SpecialtyDirectory directory = createADirectory(List.of(radiology, surgery), List.of(helenLeary));
+
+		assertThat(entryFor(directory, RADIOLOGY).getVeterinarians()).containsExactly(helenLeary);
+		assertThat(entryFor(directory, SURGERY).getVeterinarians()).containsExactly(helenLeary);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldHaveNoEntriesWhenTheClinicKnowsNoSpecialty() {
+		SpecialtyDirectory directory = createADirectory(List.of(), List.of(createAVet("James", "Carter")));
+
+		assertThat(directory.getEntries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCopyTheCollectionsItIsGiven() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVet("Helen", "Leary", radiology);
+		List<Specialty> storedSpecialties = new ArrayList<>(List.of(radiology));
+		List<Vet> storedVets = new ArrayList<>(List.of(helenLeary));
+
+		SpecialtyDirectory directory = createADirectory(storedSpecialties, storedVets);
+		storedSpecialties.add(createASpecialty(SURGERY));
+		storedVets.clear();
+
+		assertThat(directory.getEntries()).extracting(entry -> entry.getSpecialty().getName())
+			.containsExactly(RADIOLOGY);
+		assertThat(entryFor(directory, RADIOLOGY).getVeterinarians()).containsExactly(helenLeary);
+	}
+
+	private SpecialtyDirectory createADirectory(List<Specialty> specialties, List<Vet> veterinarians) {
+		return SpecialtyDirectory.of(specialties, veterinarians);
+	}
+
+	private SpecialtyDirectory.Entry entryFor(SpecialtyDirectory directory, String specialtyName) {
+		return directory.getEntries()
+			.stream()
+			.filter(entry -> specialtyName.equals(entry.getSpecialty().getName()))
+			.findFirst()
+			.orElseThrow(() -> new AssertionError("no entry for specialty " + specialtyName));
+	}
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
