+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * Lists every specialty the clinic knows together with the veterinarians holding it - the
+ * inverse of the veterinarian directory.
+ *
+ * <p>
+ * The stored association runs one way only: a {@link Vet} owns its specialties and a
+ * {@link Specialty} carries no collection back, so a specialty nobody holds cannot be
+ * derived from the veterinarians alone. Both collections are therefore read separately
+ * and grouped here rather than in the database or in an inverse mapping (see
+ * {@code docs/adr/2026-08-24-in-memory-specialty-projection.md}).
+ *
+ * <p>
+ * The projection is a value: it copies the collections it is given, orders specialties by
+ * stored name and veterinarians by last name, and so answers with the same order every
+ * time the same data is read.
+ */
+public final class SpecialtyDirectory {
+
+	private static final Comparator<Specialty> BY_STORED_NAME = Comparator
+		.comparing(Specialty::getName, Comparator.nullsLast(Comparator.naturalOrder()))
+		.thenComparing(Specialty::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	private static final Comparator<Vet> BY_PERSON_NAME = Comparator
+		.comparing(Vet::getLastName, Comparator.nullsLast(Comparator.naturalOrder()))
+		.thenComparing(Vet::getFirstName, Comparator.nullsLast(Comparator.naturalOrder()))
+		.thenComparing(Vet::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	private final List<Entry> entries;
+
+	private SpecialtyDirectory(List<Entry> entries) {
+		this.entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Group the given veterinarians under the given specialties.
+	 * @param specialties every specialty the clinic knows; one entry results from each,
+	 * whether or not a veterinarian holds it
+	 * @param veterinarians the veterinarians to group; one holding no specialty appears
+	 * in no entry
+	 * @return a directory ordered by specialty name, each entry's veterinarians ordered
+	 * by last name
+	 */
+	public static SpecialtyDirectory of(Iterable<Specialty> specialties, Iterable<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+		List<Entry> entries = new ArrayList<>();
+		for (Specialty specialty : sorted(specialties, BY_STORED_NAME)) {
+			entries.add(new Entry(specialty, holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())));
+		}
+		return new SpecialtyDirectory(entries);
+	}
+
+	/**
+	 * Index the veterinarians by the id of each specialty they hold. Specialties are
+	 * matched by id rather than by instance: veterinarians are read through the
+	 * {@code vets} cache while specialties are read uncached, so the two readings need
+	 * not hand back the same objects.
+	 */
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Iterable<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : sorted(veterinarians, BY_PERSON_NAME)) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holders;
+	}
+
+	private static <T> List<T> sorted(Iterable<T> values, Comparator<T> order) {
+		List<T> copy = new ArrayList<>();
+		for (T value : values) {
+			copy.add(Objects.requireNonNull(value, "the directory reads no null entry"));
+		}
+		copy.sort(order);
+		return copy;
+	}
+
+	/**
+	 * @return one entry per specialty, in stored-name order
+	 */
+	public List<Entry> getEntries() {
+		return this.entries;
+	}
+
+	@Override
+	public boolean equals(Object other) {
+		return other instanceof SpecialtyDirectory directory && this.entries.equals(directory.entries);
+	}
+
+	@Override
+	public int hashCode() {
+		return this.entries.hashCode();
+	}
+
+	/**
+	 * One specialty together with the veterinarians holding it, which may be none.
+	 */
+	public static final class Entry {
+
+		private final Specialty specialty;
+
+		private final List<Vet> veterinarians;
+
+		private Entry(Specialty specialty, List<Vet> veterinarians) {
+			this.specialty = specialty;
+			this.veterinarians = List.copyOf(veterinarians);
+		}
+
+		public Specialty getSpecialty() {
+			return this.specialty;
+		}
+
+		/**
+		 * @return the veterinarians holding this specialty, ordered by last name, then
+		 * first name, then id; empty when nobody holds it
+		 */
+		public List<Vet> getVeterinarians() {
+			return this.veterinarians;
+		}
+
+		@Override
+		public boolean equals(Object other) {
+			return other instanceof Entry entry && this.specialty.equals(entry.specialty)
+					&& this.veterinarians.equals(entry.veterinarians);
+		}
+
+		@Override
+		public int hashCode() {
+			return Objects.hash(this.specialty, this.veterinarians);
+		}
+
+	}
+
+}
