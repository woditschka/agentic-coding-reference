+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	private static final int UNKNOWN_VISIT_ID = 2;
+
+	private static final Integer UNASSIGNED_ID = null;
+
+	@Test
+	void thePetShouldResolveItsPersistedVisitByIdentity() {
+		Visit bookedVisit = createAPersistedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWith(bookedVisit);
+
+		Visit resolved = pet.getVisit(BOOKED_VISIT_ID);
+
+		assertThat(resolved).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldResolveNoVisitForAnIdentityItDoesNotHold() {
+		Pet pet = createAPetWith(createAPersistedVisit(BOOKED_VISIT_ID));
+
+		Visit resolved = pet.getVisit(UNKNOWN_VISIT_ID);
+
+		assertThat(resolved).isNull();
+	}
+
+	@Test
+	void thePetShouldResolveNoVisitThatIsNotYetPersisted() {
+		Pet pet = createAPetWith(createANewVisit());
+
+		Visit resolved = pet.getVisit(UNASSIGNED_ID);
+
+		assertThat(resolved).isNull();
+	}
+
+	private static Pet createAPetWith(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+	private static Visit createAPersistedVisit(int id) {
+		Visit visit = createANewVisit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createANewVisit() {
+		return new Visit();
+	}
+
+}
