+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.junit.jupiter.params.provider.Arguments.arguments;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.context.MessageSource;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.http.MediaType;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
+
+import com.jayway.jsonpath.JsonPath;
+
+/**
+ * Narrowing the veterinarian directory to one specialty, driven through both directory
+ * surfaces against the seeded database. The seed is the fixture: radiology is held by two
+ * veterinarians, one veterinarian holds dentistry and surgery, and two hold none.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+@DisabledInNativeImage
+@DisabledInAotMode
+class VetDirectoryFilterIntegrationTests {
+
+	private static final MediaType JSON = MediaType.APPLICATION_JSON;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String RADIOLOGY_IN_UPPER_CASE = RADIOLOGY.toUpperCase(Locale.ROOT);
+
+	private static final String RADIOLOGY_IN_MIXED_CASE = "RaDiOlOgY";
+
+	private static final String PREFIX_OF_RADIOLOGY = RADIOLOGY.substring(0, RADIOLOGY.length() - 1);
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String SPECIALTY_NO_VET_HOLDS = "cardiology";
+
+	private static final String EMPTY = "";
+
+	private static final String WHITESPACE_ONLY = " \t ";
+
+	private static final List<ListedVet> RADIOLOGISTS = List.of(listedVet("Helen Leary", RADIOLOGY),
+			listedVet("Henry Stevens", RADIOLOGY));
+
+	private static final ListedVet LINDA_DOUGLAS = listedVet("Linda Douglas", DENTISTRY, SURGERY);
+
+	private static final List<ListedVet> NO_VETS = List.of();
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private MessageSource messages;
+
+	@Test
+	void theVetDirectoryShouldListOnlyVetsHoldingTheNamedSpecialty() throws Exception {
+		Map<String, Object> page = directoryPage(RADIOLOGY);
+
+		assertThat(vetsListedOn(page)).containsExactlyInAnyOrderElementsOf(RADIOLOGISTS);
+		assertThat(page).containsEntry("totalItems", (long) RADIOLOGISTS.size()).containsEntry("totalPages", 1);
+	}
+
+	@Test
+	void theMachineReadableVetListShouldReturnOnlyVetsHoldingTheNamedSpecialty() throws Exception {
+		List<ListedVet> listed = vetsInTheDocument(RADIOLOGY);
+
+		assertThat(listed).containsExactlyInAnyOrderElementsOf(RADIOLOGISTS);
+	}
+
+	@ParameterizedTest
+	@MethodSource("radiologyNamedWholeOrInPart")
+	void theSpecialtyFilterShouldMatchTheWholeNameIgnoringCase(String specialty, List<ListedVet> expected)
+			throws Exception {
+		List<ListedVet> onPage = vetsListedOn(directoryPage(specialty));
+		List<ListedVet> inDocument = vetsInTheDocument(specialty);
+
+		assertThat(onPage).containsExactlyInAnyOrderElementsOf(expected);
+		assertThat(inDocument).containsExactlyInAnyOrderElementsOf(expected);
+	}
+
+	static Stream<Arguments> radiologyNamedWholeOrInPart() {
+		return Stream.of(arguments(RADIOLOGY_IN_UPPER_CASE, RADIOLOGISTS),
+				arguments(RADIOLOGY_IN_MIXED_CASE, RADIOLOGISTS), arguments(PREFIX_OF_RADIOLOGY, NO_VETS));
+	}
+
+	@Test
+	void theSpecialtyFilterShouldYieldAnEmptyListWhenNoVetHoldsTheSpecialty() throws Exception {
+		List<ListedVet> onPage = vetsListedOn(directoryPage(SPECIALTY_NO_VET_HOLDS));
+		List<ListedVet> inDocument = vetsInTheDocument(SPECIALTY_NO_VET_HOLDS);
+
+		assertThat(onPage).isEmpty();
+		assertThat(inDocument).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyFilterShouldListAVetWithSeveralSpecialtiesOnceWithAllOfThem() throws Exception {
+		List<ListedVet> onPage = vetsListedOn(directoryPage(DENTISTRY));
+		List<ListedVet> inDocument = vetsInTheDocument(DENTISTRY);
+
+		assertThat(onPage).containsExactly(LINDA_DOUGLAS);
+		assertThat(inDocument).containsExactly(LINDA_DOUGLAS);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldNeverMatchAVetHoldingNoSpecialty() throws Exception {
+		String wordShownForNoSpecialty = messages.getMessage("none", null, Locale.ENGLISH);
+
+		List<ListedVet> onPage = vetsListedOn(directoryPage(wordShownForNoSpecialty));
+		List<ListedVet> inDocument = vetsInTheDocument(wordShownForNoSpecialty);
+
+		assertThat(onPage).isEmpty();
+		assertThat(inDocument).isEmpty();
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { EMPTY, WHITESPACE_ONLY })
+	void theSpecialtyFilterShouldBeIgnoredWhenBlank(String blankSpecialty) throws Exception {
+		String pageWithBlank = responseTo(get("/vets.html").param("specialty", blankSpecialty));
+		String documentWithBlank = responseTo(get("/vets").param("specialty", blankSpecialty).accept(JSON));
+
+		assertThat(pageWithBlank).isEqualTo(responseTo(get("/vets.html")));
+		assertThat(documentWithBlank).isEqualTo(responseTo(get("/vets").accept(JSON)));
+	}
+
+	private String responseTo(MockHttpServletRequestBuilder request) throws Exception {
+		return mockMvc.perform(request).andExpect(status().isOk()).andReturn().getResponse().getContentAsString();
+	}
+
+	private Map<String, Object> directoryPage(String specialty) throws Exception {
+		return mockMvc.perform(get("/vets.html").param("specialty", specialty))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/vetList"))
+			.andReturn()
+			.getModelAndView()
+			.getModel();
+	}
+
+	private static List<ListedVet> vetsListedOn(Map<String, Object> page) {
+		return ((List<?>) page.get("listVets")).stream()
+			.map(Vet.class::cast)
+			.map(vet -> new ListedVet(vet.getFirstName() + " " + vet.getLastName(),
+					vet.getSpecialties().stream().map(Specialty::getName).toList()))
+			.toList();
+	}
+
+	private List<ListedVet> vetsInTheDocument(String specialty) throws Exception {
+		String document = responseTo(get("/vets").param("specialty", specialty).accept(JSON));
+		List<Map<String, Object>> vets = JsonPath.read(document, "$.vetList");
+		return vets.stream().map(VetDirectoryFilterIntegrationTests::listedVetInTheDocument).toList();
+	}
+
+	private static ListedVet listedVetInTheDocument(Map<String, Object> vet) {
+		List<String> specialties = JsonPath.read(vet, "$.specialties[*].name");
+		return new ListedVet(vet.get("firstName") + " " + vet.get("lastName"), specialties);
+	}
+
+	private static ListedVet listedVet(String name, String... specialties) {
+		return new ListedVet(name, List.of(specialties));
+	}
+
+	/**
+	 * A veterinarian as a directory reader sees them: full name and held specialties in
+	 * the order shown. Both surfaces reduce to it, so one expectation serves both.
+	 */
+	private record ListedVet(String name, List<String> specialties) {
+	}
+
+}
