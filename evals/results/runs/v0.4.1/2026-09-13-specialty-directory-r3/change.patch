+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class SpecialtyHoldersTests {
+
+	// Above the boxed-Integer cache, so a match written with == on the identifiers fails.
+	private static final int IDENTIFIER_BEYOND_THE_INTEGER_CACHE = 1000;
+
+	private static final AtomicInteger ANY_SEQUENCE = new AtomicInteger();
+
+	@Test
+	void theSpecialtyHoldersShouldMatchAHolderByTheSpecialtyIdentifierNotItsInstance() {
+		Specialty specialty = createASpecialty(IDENTIFIER_BEYOND_THE_INTEGER_CACHE);
+		Vet holder = createAVetHolding(aSeparatelyLoadedCopyOf(specialty));
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.of(List.of(specialty), List.of(holder));
+
+		assertThat(directory).containsExactly(holdersOf(specialty, holder));
+	}
+
+	@Test
+	void theSpecialtyHoldersShouldKeepAnEmptyHolderListForASpecialtyNoVeterinarianHolds() {
+		Specialty held = createASpecialty();
+		Specialty unheld = createASpecialty();
+		Vet holder = createAVetHolding(held);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.of(List.of(held, unheld), List.of(holder));
+
+		assertThat(directory).containsExactlyInAnyOrder(holdersOf(held, holder), holdersOf(unheld));
+	}
+
+	@Test
+	void theSpecialtyHoldersShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty first = createASpecialty();
+		Specialty second = createASpecialty();
+		Vet holderOfBoth = createAVetHolding(first, second);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.of(List.of(first, second), List.of(holderOfBoth));
+
+		assertThat(directory).containsExactlyInAnyOrder(holdersOf(first, holderOfBoth),
+				holdersOf(second, holderOfBoth));
+	}
+
+	@Test
+	void theSpecialtyHoldersShouldLeaveOutAVeterinarianHoldingNoSpecialty() {
+		Specialty specialty = createASpecialty();
+		Vet holder = createAVetHolding(specialty);
+		Vet holdingNone = createAVetHolding();
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.of(List.of(specialty), List.of(holder, holdingNone));
+
+		assertThat(directory).containsExactly(holdersOf(specialty, holder));
+	}
+
+	@Test
+	void theSpecialtyHoldersShouldKeepItsHoldersWhenTheGivenListLaterChanges() {
+		Specialty specialty = createASpecialty();
+		Vet holder = createAVetHolding(specialty);
+		List<Vet> givenHolders = new ArrayList<>(List.of(holder));
+		SpecialtyHolders specialtyHolders = createSpecialtyHolders(specialty, givenHolders);
+
+		givenHolders.add(createAVetHolding(specialty));
+
+		assertThat(specialtyHolders).isEqualTo(holdersOf(specialty, holder));
+	}
+
+	private static Specialty createASpecialty() {
+		return createASpecialty(ANY_SEQUENCE.incrementAndGet());
+	}
+
+	private static Specialty createASpecialty(int identifier) {
+		Specialty specialty = new Specialty();
+		specialty.setId(identifier);
+		specialty.setName("any specialty " + ANY_SEQUENCE.incrementAndGet());
+		return specialty;
+	}
+
+	private static Specialty aSeparatelyLoadedCopyOf(Specialty specialty) {
+		// Unboxed and re-boxed: a separate load carries its own Integer instance.
+		int identifier = specialty.getId();
+		Specialty copy = new Specialty();
+		copy.setId(identifier);
+		copy.setName(specialty.getName());
+		return copy;
+	}
+
+	private static Vet createAVetHolding(Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(ANY_SEQUENCE.incrementAndGet());
+		vet.setFirstName("any first name " + ANY_SEQUENCE.incrementAndGet());
+		vet.setLastName("any last name " + ANY_SEQUENCE.incrementAndGet());
+		Arrays.stream(specialties).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static SpecialtyHolders holdersOf(Specialty specialty, Vet... holders) {
+		return createSpecialtyHolders(specialty, List.of(holders));
+	}
+
+	private static SpecialtyHolders createSpecialtyHolders(Specialty specialty, List<Vet> holders) {
+		return new SpecialtyHolders(specialty, holders);
+	}
+
+}
