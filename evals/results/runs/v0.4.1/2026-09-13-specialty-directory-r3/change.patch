+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * One {@link Specialty} paired with the {@link Vet veterinarians} holding it. A specialty
+ * no veterinarian holds keeps an empty holder list.
+ * <p>
+ * Public because the specialty page template reads its accessors reflectively.
+ */
+public record SpecialtyHolders(Specialty specialty, List<Vet> holders) {
+
+	public SpecialtyHolders {
+		holders = List.copyOf(holders);
+	}
+
+	/**
+	 * Pairs every given specialty with the given veterinarians holding it.
+	 * <p>
+	 * A holder is matched by the specialty's identifier, never by instance: the
+	 * specialties a veterinarian holds come from a separate load, and entities define no
+	 * equality of their own.
+	 */
+	static List<SpecialtyHolders> of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		return specialties.stream()
+			.map(specialty -> new SpecialtyHolders(specialty, holdersOf(specialty, vets)))
+			.toList();
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream().filter(vet -> holds(vet, specialty)).toList();
+	}
+
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+}
