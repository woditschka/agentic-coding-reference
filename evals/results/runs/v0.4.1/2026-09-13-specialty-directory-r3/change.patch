+	// Carries a markup character, so an unescaped or rewritten name fails the page parse.
+	private static final String STORED_NAME = "Oral & Maxillofacial Surgery";
+
+	private static final String HOLDER_FIRST_NAME = "Helen";
+
+	private static final String HOLDER_LAST_NAME = "Leary";
+
+	private static final String HOLDER_FULL_NAME = HOLDER_FIRST_NAME + " " + HOLDER_LAST_NAME;
+
+	private static final String NON_HOLDER_FIRST_NAME = "James";
+
+	private static final String NON_HOLDER_LAST_NAME = "Carter";
+
+	private static final String SPECIALTY_PAGE = "/specialties.html";
+
+	private static final String LANGUAGE_PARAMETER = "lang";
+
+	private static final String MESSAGE_BUNDLES = "src/main/resources/messages";
+
+	private static final Pattern TRANSLATED_BUNDLE = Pattern.compile("messages_(?<languageCode>\\w+)\\.properties");
+
+	private static final String SPECIALTY_TABLE_OPENING = "<table id=\"specialties\"";
+
+	private static final String TABLE_CLOSING = "</table>";
+
+	private static final String SPECIALTY_ROWS = "/table/tbody/tr";
+
+	private static final String SPECIALTY_NAME_CELL = "td[1]";
+
+	private static final String HOLDER_ITEMS = "td[2]//li";
+
+	private static final AtomicInteger ANY_IDENTIFIER = new AtomicInteger();
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private InMemorySpecialtyRepository specialties;
+
+	@Autowired
+	private InMemoryVetRepository vets;
+
+	@Test
+	void theSpecialtyPageShouldListEverySpecialtyOnOnePage() throws Exception {
+		theClinicKnows(List.of(createASpecialty(RADIOLOGY), createASpecialty(SURGERY), createASpecialty(DENTISTRY)),
+				List.of());
+
+		String page = openTheSpecialtyPage();
+
+		assertThat(specialtyDirectoryOn(page)).containsOnlyKeys(RADIOLOGY, SURGERY, DENTISTRY);
+	}
+
+	@Test
+	void theSpecialtyPageShouldShowEachSpecialtyByItsStoredName() throws Exception {
+		theClinicKnows(List.of(createASpecialty(STORED_NAME)), List.of());
+
+		String page = openTheSpecialtyPage();
+
+		assertThat(specialtyDirectoryOn(page)).containsOnlyKeys(STORED_NAME);
+	}
+
+	@Test
+	void theSpecialtyPageShouldListEachHolderByFirstThenLastName() throws Exception {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		theClinicKnows(List.of(radiology), List.of(createAVet(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, radiology)));
+
+		String page = openTheSpecialtyPage();
+
+		assertThat(specialtyDirectoryOn(page)).isEqualTo(Map.of(RADIOLOGY, Set.of(HOLDER_FULL_NAME)));
+	}
+
+	@Test
+	void theSpecialtyPageShouldOmitAVeterinarianHoldingNoSpecialty() throws Exception {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		theClinicKnows(List.of(radiology), List.of(createAVet(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, radiology),
+				createAVet(NON_HOLDER_FIRST_NAME, NON_HOLDER_LAST_NAME)));
+
+		String page = openTheSpecialtyPage();
+
+		assertThat(specialtyDirectoryOn(page)).isEqualTo(Map.of(RADIOLOGY, Set.of(HOLDER_FULL_NAME)));
+		assertThat(page).doesNotContain(NON_HOLDER_LAST_NAME);
+	}
+
+	@Test
+	void theSpecialtyPageShouldListAVeterinarianUnderEachSpecialtyTheyHold() throws Exception {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		theClinicKnows(List.of(radiology, surgery),
+				List.of(createAVet(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, radiology, surgery)));
+
+		String page = openTheSpecialtyPage();
+
+		assertThat(specialtyDirectoryOn(page))
+			.isEqualTo(Map.of(RADIOLOGY, Set.of(HOLDER_FULL_NAME), SURGERY, Set.of(HOLDER_FULL_NAME)));
+	}
+
+	@Test
+	void theSpecialtyPageShouldListASpecialtyThatNoVeterinarianHolds() throws Exception {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		theClinicKnows(List.of(radiology, dentistry),
+				List.of(createAVet(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, radiology)));
+
+		String page = openTheSpecialtyPage();
+
+		assertThat(specialtyDirectoryOn(page))
+			.isEqualTo(Map.of(RADIOLOGY, Set.of(HOLDER_FULL_NAME), DENTISTRY, Set.of()));
+	}
+
+	@ParameterizedTest
+	@MethodSource("supportedLanguages")
+	void theSpecialtyNameShouldReadAsStoredInEverySupportedLanguage(String languageCode) throws Exception {
+		theClinicKnows(List.of(createASpecialty(STORED_NAME)), List.of());
+
+		String page = openTheSpecialtyPageIn(languageCode);
+
+		assertThat(specialtyDirectoryOn(page)).containsOnlyKeys(STORED_NAME);
+	}
+
+	// Derived from the translated bundles, so a newly added language is covered without
+	// editing this test.
+	static List<String> supportedLanguages() throws IOException {
+		try (Stream<Path> bundles = Files.list(Path.of(MESSAGE_BUNDLES))) {
+			return bundles.map(bundle -> TRANSLATED_BUNDLE.matcher(bundle.getFileName().toString()))
+				.filter(Matcher::matches)
+				.map(bundle -> bundle.group("languageCode"))
+				.toList();
+		}
+	}
+
+	private void theClinicKnows(List<Specialty> knownSpecialties, List<Vet> knownVets) {
+		this.specialties.holdOnly(knownSpecialties);
+		this.vets.holdOnly(knownVets);
+	}
+
+	private String openTheSpecialtyPage() throws Exception {
+		return render(get(SPECIALTY_PAGE));
+	}
+
+	private String openTheSpecialtyPageIn(String languageCode) throws Exception {
+		return render(get(SPECIALTY_PAGE).param(LANGUAGE_PARAMETER, languageCode));
+	}
+
+	private String render(MockHttpServletRequestBuilder request) throws Exception {
+		return this.mockMvc.perform(request)
+			.andExpect(status().isOk())
+			.andReturn()
+			.getResponse()
+			.getContentAsString(StandardCharsets.UTF_8);
+	}
+
+	/**
+	 * Reads the rendered specialty table into each specialty name and the full names of
+	 * its holders. Holders are a set because the page promises no order.
+	 */
+	private static Map<String, Set<String>> specialtyDirectoryOn(String page) throws Exception {
+		int tableStart = page.indexOf(SPECIALTY_TABLE_OPENING);
+		String table = page.substring(tableStart, page.indexOf(TABLE_CLOSING, tableStart) + TABLE_CLOSING.length());
+		DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
+		factory.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, true);
+		Document document = factory.newDocumentBuilder().parse(new InputSource(new StringReader(table)));
+		XPath xpath = XPathFactory.newInstance().newXPath();
+		Map<String, Set<String>> directory = new HashMap<>();
+		for (Node row : nodesOf(xpath.evaluate(SPECIALTY_ROWS, document, XPathConstants.NODESET))) {
+			Set<String> holders = nodesOf(xpath.evaluate(HOLDER_ITEMS, row, XPathConstants.NODESET)).stream()
+				.map(Node::getTextContent)
+				.collect(Collectors.toSet());
+			directory.put(xpath.evaluate(SPECIALTY_NAME_CELL, row), holders);
+		}
+		return directory;
+	}
+
+	private static List<Node> nodesOf(Object nodeSet) {
+		NodeList nodes = (NodeList) nodeSet;
+		return IntStream.range(0, nodes.getLength()).mapToObj(nodes::item).toList();
+	}
+
+	private static Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(ANY_IDENTIFIER.incrementAndGet());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(String firstName, String lastName, Specialty... heldSpecialties) {
+		Vet vet = new Vet();
+		vet.setId(ANY_IDENTIFIER.incrementAndGet());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		Arrays.stream(heldSpecialties).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	@TestConfiguration
+	static class InMemoryRepositories {
+
+		@Bean
+		InMemorySpecialtyRepository specialtyRepository() {
+			return new InMemorySpecialtyRepository();
+		}
+
+		@Bean
+		InMemoryVetRepository vetRepository() {
+			return new InMemoryVetRepository();
+		}
+
+	}
+
+	static class InMemorySpecialtyRepository implements SpecialtyRepository {
+
+		private List<Specialty> specialties = List.of();
+
+		void holdOnly(List<Specialty> specialties) {
+			this.specialties = List.copyOf(specialties);
+		}
+
+		@Override
+		public Collection<Specialty> findAll() {
+			return this.specialties;
+		}
+
+	}
+
+	static class InMemoryVetRepository implements VetRepository {
+
+		private List<Vet> vets = List.of();
+
+		void holdOnly(List<Vet> vets) {
+			this.vets = List.copyOf(vets);
+		}
+
+		@Override
+		public Collection<Vet> findAll() {
+			return this.vets;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			return new PageImpl<>(this.vets);
+		}
+
+	}
+
+}
