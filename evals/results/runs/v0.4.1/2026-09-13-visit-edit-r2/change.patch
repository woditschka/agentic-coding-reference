+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int VISIT_ID = 3;
+
+	private static final int ANOTHER_VISIT_ID = 4;
+
+	private static final int UNKNOWN_VISIT_ID = 99;
+
+	@Test
+	void thePetShouldFindOneOfItsVisitsByIdentity() {
+		Visit visit = createStoredVisit(VISIT_ID);
+		Pet pet = createPetWithVisits(createStoredVisit(ANOTHER_VISIT_ID), visit);
+
+		Visit found = pet.getVisit(VISIT_ID);
+
+		assertThat(found).isSameAs(visit);
+	}
+
+	@Test
+	void thePetShouldFindNoVisitForAnIdentityItDoesNotHold() {
+		Pet pet = createPetWithVisits(createStoredVisit(VISIT_ID));
+
+		Visit found = pet.getVisit(UNKNOWN_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	private static Pet createPetWithVisits(Visit... visits) {
+		Pet pet = new Pet();
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+	private static Visit createStoredVisit(int id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+}
