+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Every specialty the clinic knows, each with the veterinarians who hold it. Specialties
+ * are in name order and, under each, holders in last-name-then-first-name order. It
+ * carries names only, never entity references, so nothing reached through it can alter
+ * the shared veterinarian cache.
+ *
+ * @param specialties every listed specialty with its holders
+ */
+record SpecialtyDirectory(List<SpecialtyHolders> specialties) {
+
+	SpecialtyDirectory {
+		specialties = specialties.stream().sorted(Comparator.comparing(SpecialtyHolders::specialtyName)).toList();
+	}
+
+	/**
+	 * Lists each of the given specialties with those of the given veterinarians who hold
+	 * it. Neither collection is modified.
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		return new SpecialtyDirectory(specialties.stream()
+			.map(specialty -> new SpecialtyHolders(specialty.getName(), holdersOf(specialty, vets)))
+			.toList());
+	}
+
+	private static List<Veterinarian> holdersOf(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream()
+			.filter(vet -> holds(vet, specialty))
+			.map(vet -> new Veterinarian(vet.getFirstName(), vet.getLastName()))
+			.toList();
+	}
+
+	// Persisted types do not compare by value, and the veterinarians come from a cache
+	// while the specialties come from a fresh query. One specialty therefore arrives as
+	// distinct instances, and only its persisted id pairs them.
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+	/**
+	 * One specialty by its recorded name, with the veterinarians who hold it; an empty
+	 * {@code heldBy} means no veterinarian holds it.
+	 *
+	 * @param specialtyName the specialty's name as recorded
+	 * @param heldBy the holders, in last-name-then-first-name order
+	 */
+	record SpecialtyHolders(String specialtyName, List<Veterinarian> heldBy) {
+
+		SpecialtyHolders {
+			heldBy = heldBy.stream()
+				.sorted(Comparator.comparing(Veterinarian::lastName).thenComparing(Veterinarian::firstName))
+				.toList();
+		}
+
+	}
+
+	/**
+	 * A veterinarian as the directory shows one: by first and last name.
+	 *
+	 * @param firstName the veterinarian's first name as recorded
+	 * @param lastName the veterinarian's last name as recorded
+	 */
+	record Veterinarian(String firstName, String lastName) {
+
+	}
+
+}
