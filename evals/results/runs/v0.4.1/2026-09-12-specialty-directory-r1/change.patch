+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.SpecialtyHolders;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Veterinarian;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class SpecialtyDirectoryTests {
+
+	private static final int DENTISTRY_ID = 1;
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final int RADIOLOGY_ID = 2;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final int SURGERY_ID = 3;
+
+	private static final String SURGERY = "surgery";
+
+	private static final String HELEN = "Helen";
+
+	private static final String LEARY = "Leary";
+
+	private static final String EARLIER_FIRST_NAME = "Alice";
+
+	private static final String LATER_FIRST_NAME = "James";
+
+	private static final String EARLIER_LAST_NAME = "Carter";
+
+	private static final String LATER_LAST_NAME = "Douglas";
+
+	private static final String ANY_FIRST_NAME = "Sharon";
+
+	private static final String ANY_LAST_NAME = "Jenkins";
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY_ID, SURGERY);
+		Vet helen = createAVet(HELEN, LEARY, radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(directory).isEqualTo(directoryOf(holdersOf(RADIOLOGY, veterinarian(HELEN, LEARY)),
+				holdersOf(SURGERY, veterinarian(HELEN, LEARY))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListNoVeterinarianWhoHoldsNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet helen = createAVet(HELEN, LEARY, radiology);
+		Vet nonHolder = createAVet(ANY_FIRST_NAME, ANY_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, nonHolder));
+
+		assertThat(directory).isEqualTo(directoryOf(holdersOf(RADIOLOGY, veterinarian(HELEN, LEARY))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarianWithNoHolders() {
+		Specialty dentistry = createASpecialty(DENTISTRY_ID, DENTISTRY);
+		Vet nonHolder = createAVet(ANY_FIRST_NAME, ANY_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry), List.of(nonHolder));
+
+		assertThat(directory).isEqualTo(directoryOf(holdersOf(DENTISTRY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByNameAndVeterinariansByLastThenFirstName() {
+		Specialty dentistry = createASpecialty(DENTISTRY_ID, DENTISTRY);
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY_ID, SURGERY);
+		Vet earlierFirstLaterLast = createAVet(EARLIER_FIRST_NAME, LATER_LAST_NAME, radiology);
+		Vet laterFirstEarlierLast = createAVet(LATER_FIRST_NAME, EARLIER_LAST_NAME, radiology);
+		Vet earlierFirstEarlierLast = createAVet(EARLIER_FIRST_NAME, EARLIER_LAST_NAME, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology),
+				List.of(earlierFirstLaterLast, laterFirstEarlierLast, earlierFirstEarlierLast));
+
+		assertThat(directory.specialties()).extracting(SpecialtyHolders::specialtyName)
+			.containsExactly(DENTISTRY, RADIOLOGY, SURGERY);
+		assertThat(directory.specialties()).flatExtracting(SpecialtyHolders::heldBy)
+			.containsExactly(veterinarian(EARLIER_FIRST_NAME, EARLIER_LAST_NAME),
+					veterinarian(LATER_FIRST_NAME, EARLIER_LAST_NAME),
+					veterinarian(EARLIER_FIRST_NAME, LATER_LAST_NAME));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPairAVeterinarianWithASpecialtyByIdentityRatherThanByInstance() {
+		Specialty listedRadiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty heldRadiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet helen = createAVet(HELEN, LEARY, heldRadiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(listedRadiology), List.of(helen));
+
+		assertThat(directory).isEqualTo(directoryOf(holdersOf(RADIOLOGY, veterinarian(HELEN, LEARY))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldLeaveTheCallersCollectionsInTheirOriginalOrder() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY_ID, SURGERY);
+		Vet laterLast = createAVet(ANY_FIRST_NAME, LATER_LAST_NAME, radiology);
+		Vet earlierLast = createAVet(ANY_FIRST_NAME, EARLIER_LAST_NAME, radiology);
+		List<Specialty> specialties = new ArrayList<>(List.of(surgery, radiology));
+		List<Vet> vets = new ArrayList<>(List.of(laterLast, earlierLast));
+
+		SpecialtyDirectory.of(specialties, vets);
+
+		assertThat(specialties).containsExactly(surgery, radiology);
+		assertThat(vets).containsExactly(laterLast, earlierLast);
+	}
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(String firstName, String lastName, Specialty... heldSpecialties) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		Arrays.stream(heldSpecialties).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static SpecialtyDirectory directoryOf(SpecialtyHolders... specialties) {
+		return new SpecialtyDirectory(List.of(specialties));
+	}
+
+	private static SpecialtyHolders holdersOf(String specialtyName, Veterinarian... heldBy) {
+		return new SpecialtyHolders(specialtyName, List.of(heldBy));
+	}
+
+	private static Veterinarian veterinarian(String firstName, String lastName) {
+		return new Veterinarian(firstName, lastName);
+	}
+
+}
