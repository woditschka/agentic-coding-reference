+    <thead>
+      <tr>
+        <th th:text="#{name}">Name</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="specialty : ${specialtyDirectory.specialties}">
+        <td th:text="${specialty.specialtyName}"></td>
+        <td>
+          <ul th:unless="${specialty.heldBy.isEmpty()}" class="list-unstyled mb-0">
+            <li th:each="vet : ${specialty.heldBy}" th:text="${vet.firstName + ' ' + vet.lastName}"></li>
+          </ul>
+          <span th:if="${specialty.heldBy.isEmpty()}" th:text="#{none}">none</span>
+        </td>
+      </tr>
+    </tbody>
+  </table>
+</body>
+
+</html>
