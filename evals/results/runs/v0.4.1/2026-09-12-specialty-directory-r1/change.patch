+		mockMvc.perform(get(SPECIALTY_DIRECTORY))
+			.andExpect(status().isOk())
+			.andExpect(content().string(allOf(containsString(renderedVeterinarian(HELEN, LEARY)),
+					not(containsString(renderedVeterinarian(LEARY, HELEN))))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEverySpecialtyOnOnePageWithoutPaging() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY).param(PAGE_PARAMETER, A_PAGE_BEYOND_THE_FIRST))
+			.andExpect(status().isOk())
+			.andExpect(content()
+				.string(allOf(stringContainsInOrder(renderedSpecialty(DENTISTRY), renderedSpecialty(RADIOLOGY),
+						renderedSpecialty(SURGERY_HELD_BY_NONE)), not(containsString(ANY_PAGE_LINK)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowASpecialtyHeldByNoVeterinarianAsHeldByNone() throws Exception {
+		String heldByNone = messages.getMessage(HELD_BY_NONE_MESSAGE_KEY, null, Locale.ENGLISH);
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY).locale(Locale.ENGLISH))
+			.andExpect(status().isOk())
+			.andExpect(content().string(
+					stringContainsInOrder(renderedSpecialty(SURGERY_HELD_BY_NONE), renderedHeldByNone(heldByNone))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheSiteNavigation() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY))
+			.andExpect(status().isOk())
+			.andExpect(content()
+				.string(allOf(containsString(OWNER_SEARCH_LINK), containsString(VETERINARIAN_DIRECTORY_LINK),
+						not(containsString(SPECIALTY_DIRECTORY_LINK)), not(containsString(ACTIVE_NAVIGATION_ITEM)))));
+	}
+
+	private static String renderedSpecialty(String name) {
+		return "<td>" + name + "</td>";
+	}
+
+	private static String renderedVeterinarian(String firstName, String lastName) {
+		return "<li>" + firstName + " " + lastName + "</li>";
+	}
+
+	private static String renderedHeldByNone(String marker) {
+		return "<span>" + marker + "</span>";
+	}
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(String firstName, String lastName, Specialty... heldSpecialties) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		Arrays.stream(heldSpecialties).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	// Each call builds fresh instances, as a query and a cache hit would, so the page
+	// pairs a veterinarian's specialty with the listed one across distinct objects.
+	@TestConfiguration
+	static class InMemoryRepositories {
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return () -> List.of(createASpecialty(SURGERY_ID, SURGERY_HELD_BY_NONE),
+					createASpecialty(DENTISTRY_ID, DENTISTRY), createASpecialty(RADIOLOGY_ID, RADIOLOGY));
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new VetRepository() {
+
+				@Override
+				public Collection<Vet> findAll() {
+					return List.of(createAVet(LINDA, DOUGLAS, createASpecialty(DENTISTRY_ID, DENTISTRY)),
+							createAVet(HELEN, LEARY, createASpecialty(RADIOLOGY_ID, RADIOLOGY)),
+							createAVet(ANY_FIRST_NAME, ANY_LAST_NAME));
+				}
+
+				@Override
+				public Page<Vet> findAll(Pageable pageable) {
+					throw new UnsupportedOperationException("the specialty directory reads veterinarians unpaged");
+				}
+
+			};
+		}
+
+	}
+
+}
