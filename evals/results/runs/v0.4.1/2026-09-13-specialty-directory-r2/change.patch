+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+
+/**
+ * Every specialty the clinic knows, each with the full names of the veterinarians holding
+ * it. Holds names only, never the entities they were read from, so the directory stays
+ * immutable whatever happens to those entities afterward.
+ */
+record SpecialtyDirectory(List<Listing> listings) {
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		return new SpecialtyDirectory(specialties.stream()
+			.sorted(Comparator.comparing(NamedEntity::getName))
+			.map(specialty -> new Listing(specialty.getName(), holderNames(specialty, vets)))
+			.toList());
+	}
+
+	private static List<String> holderNames(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream()
+			.filter(vet -> holds(vet, specialty))
+			.sorted(BY_LAST_THEN_FIRST_NAME)
+			.map(vet -> vet.getFirstName() + " " + vet.getLastName())
+			.toList();
+	}
+
+	// Compared by identifier because entities define no equality, and a cached
+	// veterinarian's specialties are different instances from the freshly loaded ones.
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+	/**
+	 * One specialty by its stored name, with the full names of its holders; the list is
+	 * empty when no veterinarian holds it.
+	 */
+	record Listing(String specialtyName, List<String> holderNames) {
+
+		Listing {
+			holderNames = List.copyOf(holderNames);
+		}
+
+	}
+
+}
