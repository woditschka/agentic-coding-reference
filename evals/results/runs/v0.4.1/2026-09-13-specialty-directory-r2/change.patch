+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+
+import org.springframework.dao.DataAccessException;
+import org.springframework.data.repository.Repository;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Read-only access to the specialties the clinic knows. Declares no write method because
+ * specialties are not managed through the application.
+ */
+interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve every {@link Specialty}, in no promised order.
+	 * @return every specialty the clinic knows
+	 */
+	@Transactional(readOnly = true)
+	Collection<Specialty> findAll() throws DataAccessException;
+
+}
