+		Specialty surgery = createSpecialty(SURGERY_ID, SURGERY);
+		Vet helenLeary = createVet(HELEN, LEARY, heldRadiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(listedRadiology, surgery), List.of(helenLeary));
+
+		assertThat(directory).isEqualTo(aDirectory(aListing(RADIOLOGY, fullName(HELEN, LEARY)), aListing(SURGERY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyHeld() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty surgery = createSpecialty(SURGERY_ID, SURGERY);
+		Vet helenLeary = createVet(HELEN, LEARY, createSpecialty(RADIOLOGY_ID, RADIOLOGY),
+				createSpecialty(SURGERY_ID, SURGERY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helenLeary));
+
+		assertThat(directory).isEqualTo(
+				aDirectory(aListing(RADIOLOGY, fullName(HELEN, LEARY)), aListing(SURGERY, fullName(HELEN, LEARY))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepASpecialtyHeldByNoVeterinarianWithNoHolders() {
+		Specialty surgery = createSpecialty(SURGERY_ID, SURGERY);
+		Vet jamesCarter = createVet(JAMES, CARTER);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery), List.of(jamesCarter));
+
+		assertThat(directory).isEqualTo(aDirectory(aListing(SURGERY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesAndVeterinariansByName() {
+		Specialty surgery = createSpecialty(SURGERY_ID, SURGERY);
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty dentistry = createSpecialty(DENTISTRY_ID, DENTISTRY);
+		Vet helenLeary = createVet(HELEN, LEARY, createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+		Vet annaLeary = createVet(ANNA, LEARY, createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+		Vet lindaDouglas = createVet(LINDA, DOUGLAS, createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, radiology, dentistry),
+				List.of(helenLeary, annaLeary, lindaDouglas));
+
+		assertThat(directory).isEqualTo(aDirectory(aListing(DENTISTRY),
+				aListing(RADIOLOGY, fullName(LINDA, DOUGLAS), fullName(ANNA, LEARY), fullName(HELEN, LEARY)),
+				aListing(SURGERY)));
+	}
+
+	@ParameterizedTest
+	@ValueSource(ints = { 0, 1, 25 })
+	void theSpecialtyDirectoryShouldListEverySpecialtyWhateverTheirNumber(int specialtyCount) {
+		List<Specialty> specialties = createSpecialties(specialtyCount);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, NO_VETS);
+
+		assertThat(directory.listings()).hasSize(specialtyCount);
+	}
+
+	private static List<Specialty> createSpecialties(int count) {
+		return IntStream.rangeClosed(FIRST_SPECIALTY_ID, count)
+			.mapToObj(id -> createSpecialty(id, ANY_SPECIALTY_NAME + id))
+			.toList();
+	}
+
+	private static Specialty createSpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createVet(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(held).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static SpecialtyDirectory aDirectory(SpecialtyDirectory.Listing... listings) {
+		return new SpecialtyDirectory(List.of(listings));
+	}
+
+	private static SpecialtyDirectory.Listing aListing(String specialtyName, String... holderNames) {
+		return new SpecialtyDirectory.Listing(specialtyName, List.of(holderNames));
+	}
+
+	private static String fullName(String firstName, String lastName) {
+		return firstName + FULL_NAME_SEPARATOR + lastName;
+	}
+
+}
