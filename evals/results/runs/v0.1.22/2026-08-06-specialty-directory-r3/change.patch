+	/**
+	 * Assemble the specialty view: the stored specialty set is the axis (so a specialty
+	 * held by no veterinarian still appears), and the cached veterinarian collection is
+	 * joined in to attach, under each specialty, the veterinarians who hold it.
+	 * Specialties are ordered by stored name; the veterinarians under each by last name
+	 * then first name.
+	 */
+	private List<SpecialtyListing> findSpecialtyListings() {
+		Collection<Vet> allVets = this.vetRepository.findAll();
+		return this.specialtyRepository.findAll()
+			.stream()
+			.sorted(Comparator.comparing(NamedEntity::getName))
+			.map(specialty -> new SpecialtyListing(specialty.getName(), veterinariansHolding(specialty, allVets)))
+			.toList();
+	}
+
+	private List<Vet> veterinariansHolding(Specialty specialty, Collection<Vet> allVets) {
+		return allVets.stream()
+			.filter(vet -> vet.getSpecialties().stream().anyMatch(held -> held.getId().equals(specialty.getId())))
+			.sorted(Comparator.comparing(Person::getLastName).thenComparing(Person::getFirstName))
+			.toList();
+	}
+
