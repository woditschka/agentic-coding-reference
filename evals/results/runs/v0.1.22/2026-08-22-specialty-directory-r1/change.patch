+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.InstanceOfAssertFactories.list;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyGrouping.SpecialtyHolders;
+
+/**
+ * Unit tests for {@link SpecialtyGrouping} — the pure grouping and ordering logic behind
+ * the specialty directory, exercised at the base of the pyramid without booting Spring.
+ */
+class SpecialtyGroupingTests {
+
+	@Test
+	void theGroupingShouldOrderSpecialtiesByStoredName() {
+		Specialty radiology = specialty(1, "radiology");
+		Specialty dentistry = specialty(2, "dentistry");
+		Specialty surgery = specialty(3, "surgery");
+
+		List<SpecialtyHolders> grouped = SpecialtyGrouping.groupHoldersBySpecialty(List.of(),
+				List.of(radiology, dentistry, surgery));
+
+		assertThat(grouped).extracting(holders -> holders.specialty().getName())
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theGroupingShouldOrderVeterinariansByLastNameThenFirstName() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet stevens = vet("Henry", "Stevens", radiology);
+		Vet leary = vet("Helen", "Leary", radiology);
+		Vet abbottLeary = vet("Abby", "Leary", radiology);
+
+		List<SpecialtyHolders> grouped = SpecialtyGrouping.groupHoldersBySpecialty(List.of(stevens, leary, abbottLeary),
+				List.of(radiology));
+
+		assertThat(grouped).singleElement()
+			.extracting(holders -> holders.veterinarians())
+			.asInstanceOf(list(Vet.class))
+			.extracting(vet -> vet.getFirstName() + " " + vet.getLastName())
+			.containsExactly("Abby Leary", "Helen Leary", "Henry Stevens");
+	}
+
+	@Test
+	void theGroupingShouldListASpecialtyHeldByNoVeterinarianWithEmptyHolders() {
+		Specialty radiology = specialty(1, "radiology");
+		Specialty nutrition = specialty(2, "nutrition");
+		Vet leary = vet("Helen", "Leary", radiology);
+
