+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+
+/**
+ * Pure grouping and ordering logic behind the specialty directory. Pairs every stored
+ * specialty with the veterinarians who hold it, ordering specialties by stored name and
+ * veterinarians within each by last name then first name. Kept free of the web and
+ * persistence layers so it is unit-testable without booting Spring.
+ */
+final class SpecialtyGrouping {
+
+	private SpecialtyGrouping() {
+	}
+
+	/**
+	 * Pairs every stored specialty with its holders. A specialty held by no veterinarian
+	 * keeps an empty holder list; a veterinarian holding no specialty appears in no list.
+	 * @param vets every veterinarian, each carrying the specialties it holds
+	 * @param specialties every stored specialty, including those held by no veterinarian
+	 * @return specialties ordered by stored name, each with holders ordered by last name
+	 * then first name
+	 */
+	static List<SpecialtyHolders> groupHoldersBySpecialty(Collection<Vet> vets, Collection<Specialty> specialties) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet vet : vets) {
+			for (Specialty specialty : vet.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(vet);
+			}
+		}
+
+		Comparator<Vet> byLastThenFirstName = Comparator.comparing(Vet::getLastName).thenComparing(Vet::getFirstName);
+		return specialties.stream().sorted(Comparator.comparing(NamedEntity::getName)).map(specialty -> {
+			List<Vet> holders = holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())
+				.stream()
+				.sorted(byLastThenFirstName)
+				.toList();
+			return new SpecialtyHolders(specialty, holders);
+		}).toList();
+	}
+
+	/**
+	 * View pairing of a specialty with the veterinarians who hold it, ready for the
+	 * template to render.
+	 */
+	record SpecialtyHolders(Specialty specialty, List<Vet> veterinarians) {
+	}
+
+}
