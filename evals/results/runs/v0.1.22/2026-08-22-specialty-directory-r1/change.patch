+package org.springframework.samples.petclinic.vet;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.hamcrest.Matchers.stringContainsInOrder;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.cache.CacheManager;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Integration tests for {@link SpecialtyController}. Mock-free: real seeded H2 data
+ * driven through the in-process web harness (MockMvc), the one sanctioned system-boundary
+ * stand-in per docs/testing-principles.md.
+ *
+ * <p>
+ * The specialties fetch is cached in production (VetRepository.findSpecialties is
+ * {@code @Cacheable("specialties")}). These tests evict that cache before each test so a
+ * specialty inserted mid-test is read live, and so no stale entry leaks between tests.
+ *
+ * <p>
+ * Seed data these tests derive expectations from:
+ *
+ * <ul>
+ * <li>radiology &rarr; Helen Leary, Henry Stevens
+ * <li>surgery &rarr; Linda Douglas, Rafael Ortega
+ * <li>dentistry &rarr; Linda Douglas
+ * <li>James Carter and Sharon Jenkins hold no specialty
+ * </ul>
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+class SpecialtyControllerTests {
+
+	private static final List<String> STORED_SPECIALTIES_IN_NAME_ORDER = List.of("dentistry", "radiology", "surgery");
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private JdbcTemplate jdbcTemplate;
+
+	@Autowired
+	private CacheManager cacheManager;
+
+	@BeforeEach
+	void evictSpecialtiesCache() {
+		cacheManager.getCache("specialties").clear();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachSpecialtyByStoredNameWithItsVeterinarians() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("specialties/specialtyList"))
+			.andExpect(content().string(stringContainsInOrder(STORED_SPECIALTIES_IN_NAME_ORDER)))
+			.andExpect(content().string(containsString("Helen Leary")))
+			.andExpect(content().string(containsString("Henry Stevens")))
+			.andExpect(content().string(containsString("Linda Douglas")))
+			.andExpect(content().string(containsString("Rafael Ortega")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowVeterinariansByFullName() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastNameThenFirstName() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(stringContainsInOrder("radiology", "Leary", "Stevens")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString("James Carter"))))
+			.andExpect(content().string(not(containsString("Sharon Jenkins"))));
+	}
+
+	@Test
+	@Transactional
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarianAsHeldByNone() throws Exception {
+		String unheldSpecialty = "nutrition";
+		jdbcTemplate.update("INSERT INTO specialties (name) VALUES (?)", unheldSpecialty);
+
+		// "none" must fall between the unheld specialty and the next specialty in stored
+		// name order (radiology), anchoring the marker to the unheld specialty's
+		// veterinarians cell rather than a stray "none" elsewhere in the document.
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(stringContainsInOrder(unheldSpecialty, "none", "radiology")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderAllSpecialtiesOnOnePageWithoutPaging() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(stringContainsInOrder(STORED_SPECIALTIES_IN_NAME_ORDER)))
+			.andExpect(content().string(not(containsString("page="))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldHaveNoInboundLinkFromAnotherPage() throws Exception {
+		mockMvc.perform(get("/vets.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString("/specialties.html"))));
+	}
+
+}
