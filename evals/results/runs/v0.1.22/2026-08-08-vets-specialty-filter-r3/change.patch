+	/**
+	 * Retrieve the <code>Vet</code>s holding a specialty whose whole name matches the
+	 * given value, ignoring letter case. The <code>Vet.specialties</code> many-to-many
+	 * join can repeat a row, so the query is <code>distinct</code>. Not cached: the
+	 * caller-supplied specialty is an unbounded cache key.
+	 * @param name the whole specialty name to match, case-insensitively
+	 * @return the matching <code>Vet</code>s, empty when none hold the specialty
+	 */
+	@Transactional(readOnly = true)
+	Collection<Vet> findDistinctBySpecialtiesNameIgnoreCase(String name) throws DataAccessException;
+
+	/**
+	 * Retrieve, a page at a time, the <code>Vet</code>s holding a specialty whose whole
+	 * name matches the given value, ignoring letter case. <code>distinct</code> so the
+	 * many-to-many join does not repeat a <code>Vet</code>; the returned
+	 * <code>Page</code> carries the filtered totals. Not cached, as above.
+	 * @param name the whole specialty name to match, case-insensitively
+	 * @param pageable the page to retrieve
+	 * @return a page of the matching <code>Vet</code>s, empty when none hold the
+	 * specialty
+	 */
+	@Transactional(readOnly = true)
+	Page<Vet> findDistinctBySpecialtiesNameIgnoreCase(String name, Pageable pageable) throws DataAccessException;
+
 }
