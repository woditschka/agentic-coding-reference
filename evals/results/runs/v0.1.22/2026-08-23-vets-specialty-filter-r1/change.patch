+	 * @param specialty the raw request parameter, possibly {@code null}
+	 * @return the stripped specialty, or {@code null} when no filter should be applied
+	 */
+	private String normalizeSpecialty(String specialty) {
+		if (specialty == null) {
+			return null;
+		}
+		String stripped = specialty.strip();
+		return stripped.isEmpty() ? null : stripped;
+	}
+
+	/**
+	 * Reads the cached full veterinarian list and returns a new list narrowed to those
+	 * holding the given specialty. The cached collection is never mutated.
+	 * @param specialty the normalized specialty, or {@code null} for no filter
+	 * @return a new list of matching veterinarians
+	 */
+	private List<Vet> findMatchingVets(String specialty) {
+		List<Vet> allVets = new ArrayList<>(this.vetRepository.findAll());
+		if (specialty == null) {
+			return allVets;
+		}
+		return allVets.stream().filter(vet -> vet.holdsSpecialty(specialty)).toList();
+	}
+
+	private Page<Vet> paginate(int page, List<Vet> vets) {
+		Pageable pageable = PageRequest.of(page - 1, PAGE_SIZE);
+		int start = (int) pageable.getOffset();
+		int end = Math.min(start + PAGE_SIZE, vets.size());
+		List<Vet> pageContent = (start >= vets.size()) ? List.of() : vets.subList(start, end);
+		return new PageImpl<>(pageContent, pageable, vets.size());
+	}
+
 }
