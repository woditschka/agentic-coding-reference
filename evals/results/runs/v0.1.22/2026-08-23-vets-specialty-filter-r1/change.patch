+	/**
+	 * Tests whether this veterinarian holds a specialty with the given name, matching the
+	 * whole name and disregarding letter case (not a prefix match).
+	 * @param specialtyName the specialty name to look for
+	 * @return {@code true} if this veterinarian holds a specialty whose name equals the
+	 * given name ignoring case
+	 */
+	public boolean holdsSpecialty(String specialtyName) {
+		if (specialtyName == null) {
+			return false;
+		}
+		return getSpecialtiesInternal().stream()
