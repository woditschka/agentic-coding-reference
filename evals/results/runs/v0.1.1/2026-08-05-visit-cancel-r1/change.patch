@@ -17,6 +17,7 @@ package org.springframework.samples.petclinic.owner;
 
 import java.time.LocalDate;
 import java.util.Map;
+import java.util.Objects;
 import java.util.Optional;
 
 import org.springframework.stereotype.Controller;
@@ -111,4 +112,43 @@ class VisitController {
 		return "redirect:/owners/{ownerId}";
 	}
 
+	// Spring MVC calls method loadPetWithVisit(...) before processCancelVisitForm is
+	// called
+	@PostMapping("/owners/{ownerId}/pets/{petId}/visits/{visitId}/cancel")
+	public String processCancelVisitForm(@ModelAttribute Owner owner, @PathVariable int petId,
+			@PathVariable int visitId, @ModelAttribute("visit") Visit stagedVisit,
+			RedirectAttributes redirectAttributes) {
+		// loadPetWithVisit() resolves the pet through the aggregate (it already refuses a
+		// pet that does not belong to this owner) and stages a blank Visit on it for the
+		// booking form; drop that transient visit so a cancellation never persists it.
+		Pet pet = owner.getPet(petId);
+		pet.removeVisit(stagedVisit);
+
+		Visit visit = findVisit(pet, visitId);
+		if (visit.getDate() == null || !visit.getDate().isAfter(LocalDate.now())) {
+			// Guard A (findVisit / owner.getPet above) refuses ids that do not resolve
+			// within the aggregate by throwing. This is guard B: the visit resolves but
+			// is
+			// no longer upcoming, a business-rule refusal for a stale page. Refuse with a
+			// redirect and the 'error' flash slot instead of a server error.
+			redirectAttributes.addFlashAttribute("error",
+					"The visit could not be cancelled because it is no longer upcoming.");
+			return "redirect:/owners/{ownerId}";
+		}
+
+		pet.removeVisit(visit);
+		this.owners.save(owner);
+		redirectAttributes.addFlashAttribute("message", "The visit has been cancelled");
+		return "redirect:/owners/{ownerId}";
+	}
+
+	private Visit findVisit(Pet pet, int visitId) {
+		return pet.getVisits()
+			.stream()
+			.filter(candidate -> Objects.equals(candidate.getId(), visitId))
+			.findFirst()
+			.orElseThrow(() -> new IllegalArgumentException(
+					"Visit " + visitId + " does not belong to pet " + pet.getId() + "."));
+	}
+
 }
