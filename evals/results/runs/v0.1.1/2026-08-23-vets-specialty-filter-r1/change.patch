+	static class InMemoryVetRepository implements VetRepository {
+
+		private final List<Vet> vets;
+
+		InMemoryVetRepository(List<Vet> vets) {
+			this.vets = List.copyOf(vets);
+		}
+
+		@Override
+		public Collection<Vet> findAll() throws DataAccessException {
+			return this.vets;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) throws DataAccessException {
+			int start = (int) pageable.getOffset();
+			if (start >= this.vets.size()) {
+				return new PageImpl<>(List.of(), pageable, this.vets.size());
+			}
+			int end = Math.min(start + pageable.getPageSize(), this.vets.size());
+			return new PageImpl<>(this.vets.subList(start, end), pageable, this.vets.size());
+		}
