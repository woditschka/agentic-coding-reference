+	private static Vet aVetHolding(int id, String... specialtyNames) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName("Vet" + id);
+		vet.setLastName("Number" + id);
+		int specialtyId = 1;
+		for (String specialtyName : specialtyNames) {
+			Specialty specialty = new Specialty();
+			specialty.setId(specialtyId++);
+			specialty.setName(specialtyName);
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
