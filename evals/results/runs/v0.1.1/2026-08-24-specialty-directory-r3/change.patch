+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * Immutable read projection backing the specialty directory page. Given the stored
+ * specialties (already ordered by name at the query) and every veterinarian, the factory
+ * buckets each veterinarian under the specialties it holds. A specialty with no holder
+ * still yields a row with an empty holder list; a veterinarian holding no specialty
+ * appears in no bucket and is therefore absent.
+ */
+record SpecialtyListing(List<SpecialtyHolders> specialties) {
+
+	SpecialtyListing {
+		specialties = List.copyOf(specialties);
+	}
+
+	/**
+	 * One directory row: a specialty by its stored name and the full names of the
+	 * veterinarians holding it, ordered by last name then first name.
+	 */
+	record SpecialtyHolders(String name, List<String> veterinarians) {
+
+		SpecialtyHolders {
+			veterinarians = List.copyOf(veterinarians);
+		}
+	}
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	/**
+	 * Assemble the directory view model.
+	 * @param specialties the stored specialties in the order they should be listed
+	 * @param vets every veterinarian in the clinic
+	 * @return an immutable listing with one row per specialty, holders in name order
+	 */
+	static SpecialtyListing from(List<Specialty> specialties, Collection<Vet> vets) {
+		List<SpecialtyHolders> rows = specialties.stream()
+			.map(specialty -> new SpecialtyHolders(specialty.getName(), holdersOf(specialty, vets)))
+			.toList();
+		return new SpecialtyListing(rows);
+	}
+
+	private static List<String> holdersOf(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream()
+			.filter(vet -> holds(vet, specialty))
+			.sorted(BY_LAST_THEN_FIRST_NAME)
+			.map(vet -> vet.getFirstName() + " " + vet.getLastName())
+			.toList();
+	}
+
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> held.getId().equals(specialty.getId()));
+	}
+
+}
