+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Mock-free unit tests for the {@link SpecialtyListing} read projection. The factory
+ * assembles the specialty directory view model from the stored specialties and the
+ * veterinarians holding them, so these tests own the grouping and within-specialty
+ * ordering acceptance criteria without the web layer.
+ */
+class SpecialtyListingTests {
+
+	private Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet vet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredNameOnOnePage() {
+		Specialty radiology = specialty(1, "radiology");
+		Specialty surgery = specialty(2, "surgery");
+		Vet helen = vet(1, "Helen", "Leary", radiology);
+
+		SpecialtyListing listing = SpecialtyListing.from(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(listing.specialties()).extracting(SpecialtyListing.SpecialtyHolders::name)
+			.containsExactly("radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachVeterinarianInFull() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet helen = vet(1, "Helen", "Leary", radiology);
+
+		SpecialtyListing listing = SpecialtyListing.from(List.of(radiology), List.of(helen));
+
+		assertThat(listing.specialties()).singleElement()
+			.extracting(SpecialtyListing.SpecialtyHolders::veterinarians)
+			.isEqualTo(List.of("Helen Leary"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAllHoldersUnderASpecialty() {
+		Specialty surgery = specialty(2, "surgery");
+		Vet linda = vet(1, "Linda", "Douglas", surgery);
+		Vet rafael = vet(2, "Rafael", "Ortega", surgery);
+
+		SpecialtyListing listing = SpecialtyListing.from(List.of(surgery), List.of(linda, rafael));
+
+		assertThat(listing.specialties()).singleElement()
+			.extracting(SpecialtyListing.SpecialtyHolders::veterinarians)
+			.isEqualTo(List.of("Linda Douglas", "Rafael Ortega"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowASpecialtyWithNoHolders() {
+		Specialty dentistry = specialty(3, "dentistry");
+		Vet james = vet(1, "James", "Carter");
+
+		SpecialtyListing listing = SpecialtyListing.from(List.of(dentistry), List.of(james));
+
+		assertThat(listing.specialties()).singleElement().satisfies(row -> {
+			assertThat(row.name()).isEqualTo("dentistry");
+			assertThat(row.veterinarians()).isEmpty();
+		});
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet helen = vet(1, "Helen", "Leary", radiology);
+		Vet james = vet(2, "James", "Carter");
+
+		SpecialtyListing listing = SpecialtyListing.from(List.of(radiology), List.of(helen, james));
+
+		assertThat(listing.specialties()).flatExtracting(SpecialtyListing.SpecialtyHolders::veterinarians)
+			.containsExactly("Helen Leary")
+			.doesNotContain("James Carter");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansWithinASpecialtyByLastThenFirstName() {
