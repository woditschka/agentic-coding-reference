+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.GetMapping;
+
+/**
+ * Serves the read-only specialty directory: every specialty held by at least one
+ * veterinarian, each with the veterinarians holding it. The directory is derived from the
+ * cached veterinarian roster rather than a specialties store (see ADR
+ * 2026-08-22-specialty-directory-derived-from-veterinarians).
+ */
+@Controller
+class SpecialtyController {
+
+	private final VetRepository vetRepository;
+
+	SpecialtyController(VetRepository vetRepository) {
+		this.vetRepository = vetRepository;
+	}
+
+	@GetMapping("/specialties.html")
+	public String showSpecialtyList(Model model) {
+		model.addAttribute("specialties", directory());
+		return "specialties/specialtyList";
+	}
+
+	private List<SpecialtyView> directory() {
+		Map<String, List<Vet>> holdersBySpecialtyName = new TreeMap<>();
+		for (Vet vet : vetRepository.findAll()) {
+			for (Specialty specialty : vet.getSpecialties()) {
+				holdersBySpecialtyName.computeIfAbsent(specialty.getName(), name -> new ArrayList<>()).add(vet);
+			}
+		}
+
+		Comparator<Vet> byFamilyThenGivenName = Comparator.comparing(Vet::getLastName).thenComparing(Vet::getFirstName);
+		List<SpecialtyView> directory = new ArrayList<>();
+		for (Map.Entry<String, List<Vet>> entry : holdersBySpecialtyName.entrySet()) {
+			List<String> holders = entry.getValue()
+				.stream()
+				.sorted(byFamilyThenGivenName)
+				.map(vet -> vet.getFirstName() + " " + vet.getLastName())
+				.toList();
+			directory.add(new SpecialtyView(entry.getKey(), holders));
+		}
+		return directory;
+	}
+
+}
