+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+/**
+ * Immutable read-model for one row of the specialty directory: a specialty by its stored
+ * name together with the ordered full names of the veterinarians holding it.
+ */
+record SpecialtyView(String name, List<String> holders) {
+
+	SpecialtyView {
+		holders = List.copyOf(holders);
+	}
+}
