+
+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.annotation.Import;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+
+/** Test class for the {@link SpecialtyController}. */
+@WebMvcTest(SpecialtyController.class)
+@Import(SpecialtyControllerTests.InMemoryVetRepository.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private InMemoryVetRepository vets;
+
+	private Vet aVet(String firstName, String lastName, String... specialtyNames) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (String specialtyName : specialtyNames) {
+			Specialty specialty = new Specialty();
+			specialty.setName(specialtyName);
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	@BeforeEach
+	void setup() {
+		vets.store(aVet("James", "Carter"), aVet("Helen", "Leary", "radiology"), aVet("Henry", "Stevens", "radiology"),
+				aVet("Linda", "Douglas", "surgery", "dentistry"), aVet("Rafael", "Ortega", "surgery"));
+	}
+
+	@SuppressWarnings("unchecked")
+	private List<SpecialtyView> renderDirectory() throws Exception {
+		return (List<SpecialtyView>) mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("specialties/specialtyList"))
+			.andReturn()
+			.getModelAndView()
+			.getModel()
+			.get("specialties");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() throws Exception {
+		List<SpecialtyView> directory = renderDirectory();
+
+		assertThat(directory).extracting(SpecialtyView::name).containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowHoldersByFullNameGivenNameFirst() throws Exception {
+		List<SpecialtyView> directory = renderDirectory();
+
+		assertThat(directory).contains(new SpecialtyView("radiology", List.of("Helen Leary", "Henry Stevens")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderTiedHoldersByGivenName() throws Exception {
+		vets.store(aVet("Helen", "Leary", "radiology"), aVet("Anna", "Leary", "radiology"));
+
+		List<SpecialtyView> directory = renderDirectory();
+
+		assertThat(directory).contains(new SpecialtyView("radiology", List.of("Anna Leary", "Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderAllSpecialtiesOnOnePage() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("specialties/specialtyList"))
+			.andExpect(model().attributeDoesNotExist("totalPages"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderNoRowsGivenAnEmptyRoster() throws Exception {
+		vets.store();
+
+		List<SpecialtyView> directory = renderDirectory();
+
+		assertThat(directory).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() throws Exception {
+		List<SpecialtyView> directory = renderDirectory();
+
+		assertThat(directory).flatExtracting(SpecialtyView::holders).doesNotContain("James Carter");
+	}
+
+	/**
+	 * Hand-written in-memory {@link VetRepository} double backed by a list each test
+	 * controls, so empty, tie-break, and normal rosters can be exercised without Mockito
+	 * and without depending on seed data.
+	 */
+	static class InMemoryVetRepository implements VetRepository {
+
+		private final List<Vet> vets = new ArrayList<>();
+
+		void store(Vet... vets) {
+			this.vets.clear();
+			this.vets.addAll(List.of(vets));
+		}
+
+		@Override
+		public Collection<Vet> findAll() {
+			return List.copyOf(vets);
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("Specialty directory reads the full roster, not pages");
+		}
+
+	}
+
+}
