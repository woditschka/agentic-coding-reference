+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.springframework.samples.petclinic.model.BaseEntity;
+
+/**
+ * Immutable read model behind the specialty directory page: every specialty the clinic
+ * knows, each with the veterinarians holding it.
+ * <p>
+ * The mapping from {@link Vet} to {@link Specialty} is unidirectional, so the two sides
+ * are read separately and joined here. They are joined on the identifier: the reads run
+ * in separate persistence contexts, and {@link BaseEntity} declares neither
+ * {@code equals} nor {@code hashCode}, so a stored specialty is never the same instance
+ * as the one inside {@link Vet#getSpecialties()}.
+ */
+public final class SpecialtyDirectory {
+
+	private static final Comparator<Specialty> BY_NAME = Comparator.comparing(Specialty::getName)
+		// Nothing forbids two specialties sharing a name; the identifier keeps the order
+		// total, and therefore the same on every request.
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> BY_LAST_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		// Two veterinarians can share a full name; see BY_NAME.
+		.thenComparing(Vet::getId);
+
+	private final List<Entry> entries;
+
+	private SpecialtyDirectory(List<Entry> entries) {
+		this.entries = entries;
+	}
+
+	/**
+	 * Group the given veterinarians under the given specialties.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians the whole roster; a veterinarian holding no specialty is left
+	 * out of the directory
+	 * @return a directory listing each specialty once, holders and specialties alike in a
+	 * stable order
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_NAME)
+			.map(specialty -> new Entry(specialty.getName(),
+					holderNames(holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of()))))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holders;
+	}
+
+	private static List<String> holderNames(List<Vet> holders) {
+		return holders.stream()
+			.sorted(BY_LAST_NAME)
+			.map(holder -> holder.getFirstName() + " " + holder.getLastName())
+			.toList();
+	}
+
+	/**
+	 * @return one entry per specialty, empty when the clinic knows no specialty
+	 */
+	public List<Entry> getEntries() {
+		return this.entries;
+	}
+
+	/**
+	 * One specialty as the page shows it: the name it is stored under, and the
+	 * veterinarians holding it.
+	 */
+	public static final class Entry {
+
+		private final String specialtyName;
+
+		private final List<String> veterinarianNames;
+
+		private Entry(String specialtyName, List<String> veterinarianNames) {
+			this.specialtyName = specialtyName;
+			this.veterinarianNames = veterinarianNames;
+		}
+
+		public String getSpecialtyName() {
+			return this.specialtyName;
+		}
+
+		/**
+		 * @return the holders, each by first name then last name, empty when no
+		 * veterinarian holds this specialty
+		 */
+		public List<String> getVeterinarianNames() {
+			return this.veterinarianNames;
+		}
+
+	}
+
+}
