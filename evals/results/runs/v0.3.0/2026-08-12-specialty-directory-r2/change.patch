+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return () -> List.of(createSpecialty(RADIOLOGY_ID, RADIOLOGY), createSpecialty(SURGERY_ID, SURGERY),
+					createSpecialty(DENTISTRY_ID, DENTISTRY));
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new VetRepository() {
+
+				@Override
+				public Collection<Vet> findAll() {
+					return List.of(createVet(HELEN_ID, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, RADIOLOGY)),
+							createVet(JAMES_ID, "James", "Carter"),
+							createVet(LINDA_ID, "Linda", "Douglas", createSpecialty(SURGERY_ID, SURGERY)));
+				}
+
+				@Override
+				public Page<Vet> findAll(Pageable pageable) {
+					throw new UnsupportedOperationException(
+							"the specialty directory reads the whole roster, never a page of it");
+				}
+
+			};
+		}
+
+	}
+
+}
