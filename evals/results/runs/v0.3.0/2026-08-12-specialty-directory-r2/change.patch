+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the read model behind the specialty
+ * directory page.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int DENTISTRY_ID = 3;
+
+	private static final int OTHER_SURGERY_ID = 4;
+
+	private static final int HELEN_ID = 10;
+
+	private static final int JAMES_ID = 11;
+
+	private static final int LINDA_ID = 12;
+
+	private static final int RAFAEL_ID = 13;
+
+	@Test
+	void theSpecialtyDirectoryShouldGroupHoldersUnderTheSpecialtyTheyShareAnIdentifierWith() {
+		// The stored specialty and the one the veterinarian holds are distinct instances:
+		// the two reads run in separate persistence contexts and BaseEntity declares no
+		// equals, so the identifier is the only thing that can join them.
+		Specialty storedRadiology = createSpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet helen = createVet(HELEN_ID, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(storedRadiology), List.of(helen));
+
+		assertThat(directory.getEntries()).singleElement().satisfies(entry -> {
+			assertThat(entry.getSpecialtyName()).isEqualTo(RADIOLOGY);
+			assertThat(entry.getVeterinarianNames()).containsExactly("Helen Leary");
+		});
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepASpecialtyNoVeterinarianHoldsWithNoHolders() {
+		Specialty heldByNobody = createSpecialty(DENTISTRY_ID, DENTISTRY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(heldByNobody), List.of());
+
+		assertThat(directory.getEntries()).singleElement().satisfies(entry -> {
+			assertThat(entry.getSpecialtyName()).isEqualTo(DENTISTRY);
+			assertThat(entry.getVeterinarianNames()).isEmpty();
+		});
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldLeaveOutAVeterinarianHoldingNoSpecialty() {
+		Vet jamesHoldingNothing = createVet(JAMES_ID, "James", "Carter");
+		Vet helen = createVet(HELEN_ID, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(createSpecialty(RADIOLOGY_ID, RADIOLOGY)),
+				List.of(jamesHoldingNothing, helen));
+
+		assertThat(directory.getEntries()).flatExtracting(SpecialtyDirectory.Entry::getVeterinarianNames)
+			.containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenTheClinicKnowsNoSpecialties() {
+		Vet helen = createVet(HELEN_ID, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(helen));
+
+		assertThat(directory.getEntries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByName() {
+		List<Specialty> storedOutOfOrder = List.of(createSpecialty(SURGERY_ID, SURGERY),
+				createSpecialty(DENTISTRY_ID, DENTISTRY), createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(storedOutOfOrder, List.of());
+
+		assertThat(directory.getEntries()).extracting(SpecialtyDirectory.Entry::getSpecialtyName)
+			.containsExactly(DENTISTRY, RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesSharingANameByIdentifier() {
+		Vet helen = createVet(HELEN_ID, "Helen", "Leary", createSpecialty(OTHER_SURGERY_ID, SURGERY));
+		Vet james = createVet(JAMES_ID, "James", "Carter", createSpecialty(SURGERY_ID, SURGERY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(
+				List.of(createSpecialty(OTHER_SURGERY_ID, SURGERY), createSpecialty(SURGERY_ID, SURGERY)),
+				List.of(helen, james));
+
+		assertThat(directory.getEntries()).flatExtracting(SpecialtyDirectory.Entry::getVeterinarianNames)
+			.containsExactly("James Carter", "Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderHoldersByLastNameThenFirstName() {
+		Vet helenLeary = createVet(HELEN_ID, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+		Vet lindaDouglas = createVet(LINDA_ID, "Linda", "Douglas", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+		Vet rafaelDouglas = createVet(RAFAEL_ID, "Rafael", "Douglas", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(createSpecialty(RADIOLOGY_ID, RADIOLOGY)),
+				List.of(helenLeary, rafaelDouglas, lindaDouglas));
+
+		assertThat(directory.getEntries()).singleElement()
+			.satisfies(entry -> assertThat(entry.getVeterinarianNames()).containsExactly("Linda Douglas",
+					"Rafael Douglas", "Helen Leary"));
+	}
+
+	private static Specialty createSpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createVet(int id, String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
