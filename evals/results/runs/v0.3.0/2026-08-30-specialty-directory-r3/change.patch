+package org.springframework.samples.petclinic.vet;
+
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.stream.Stream;
+
+/**
+ * Builders for the stored veterinarians and specialties the tests in this package read
+ * back.
+ */
+final class VetFixtures {
+
+	/**
+	 * Stored identities are irrelevant to the assertions that use these fixtures, but
+	 * they must be distinct: a directory matches a veterinarian's specialty to a stored
+	 * specialty by identity, because the two reads that feed it may return separate
+	 * instances of the same row.
+	 */
+	private static final AtomicInteger NEXT_STORED_ID = new AtomicInteger(1);
+
+	private VetFixtures() {
+	}
+
+	/**
+	 * Build a specialty stored under an identity of no significance.
+	 * @param name the stored name
+	 * @return the specialty
+	 */
+	static Specialty specialtyNamed(String name) {
+		return specialtyWithId(NEXT_STORED_ID.getAndIncrement(), name);
+	}
+
+	/**
+	 * Build a specialty stored under a caller-chosen identity, so a test can construct a
+	 * second instance of a row it already holds.
+	 * @param storedId the stored identity
+	 * @param name the stored name
+	 * @return the specialty
+	 */
+	static Specialty specialtyWithId(Integer storedId, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(storedId);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	/**
+	 * Build a veterinarian holding the given specialties.
+	 * @param firstName the stored first name
+	 * @param lastName the stored last name
+	 * @param specialties the specialties held, possibly none
+	 * @return the veterinarian
+	 */
+	static Vet veterinarianNamed(String firstName, String lastName, Specialty... specialties) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(NEXT_STORED_ID.getAndIncrement());
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		Stream.of(specialties).forEach(veterinarian::addSpecialty);
+		return veterinarian;
+	}
+
+}
