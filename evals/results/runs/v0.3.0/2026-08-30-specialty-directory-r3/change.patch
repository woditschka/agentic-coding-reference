+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.tuple;
+import static org.springframework.samples.petclinic.vet.VetFixtures.specialtyNamed;
+import static org.springframework.samples.petclinic.vet.VetFixtures.specialtyWithId;
+import static org.springframework.samples.petclinic.vet.VetFixtures.veterinarianNamed;
+
+/**
+ * Test class for the {@link SpecialtyDirectory} read model.
+ */
+class SpecialtyDirectoryTests {
+
+	@Test
+	void theSpecialtyDirectoryShouldListEveryStoredSpecialtyByName() {
+		Specialty radiology = specialtyNamed("radiology");
+		Specialty surgery = specialtyNamed("surgery");
+		Vet helenLeary = veterinarianNamed("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helenLeary));
+
+		assertThat(directory.getEntries()).extracting(SpecialtyDirectory.Entry::getSpecialtyName)
+			.containsExactly("radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowAVeterinarianUnderEachSpecialtyHeld() {
+		Specialty dentistry = specialtyNamed("dentistry");
+		Specialty surgery = specialtyNamed("surgery");
+		Vet lindaDouglas = veterinarianNamed("Linda", "Douglas", dentistry, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, surgery), List.of(lindaDouglas));
+
+		assertThat(directory.getEntries())
+			.extracting(SpecialtyDirectory.Entry::getSpecialtyName, SpecialtyDirectoryTests::holderNames)
+			.containsExactly(tuple("dentistry", List.of("Linda Douglas")), tuple("surgery", List.of("Linda Douglas")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		Specialty dentistry = specialtyNamed("dentistry");
+		Vet helenLeary = veterinarianNamed("Helen", "Leary", specialtyNamed("radiology"));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry), List.of(helenLeary));
+
+		assertThat(directory.getEntries())
+			.extracting(SpecialtyDirectory.Entry::getSpecialtyName, SpecialtyDirectoryTests::holderNames)
+			.containsExactly(tuple("dentistry", List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = specialtyNamed("radiology");
+		Vet helenLeary = veterinarianNamed("Helen", "Leary", radiology);
+		Vet jamesCarterHoldingNoSpecialty = veterinarianNamed("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(jamesCarterHoldingNoSpecialty, helenLeary));
+
+		assertThat(directory.getEntries())
+			.extracting(SpecialtyDirectory.Entry::getSpecialtyName, SpecialtyDirectoryTests::holderNames)
+			.containsExactly(tuple("radiology", List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderItsEntriesStably() {
+		Specialty surgery = specialtyNamed("surgery");
+		Specialty dentistry = specialtyNamed("dentistry");
+		Specialty radiology = specialtyNamed("radiology");
+		Vet henryStevens = veterinarianNamed("Henry", "Stevens", radiology);
+		Vet rafaelOrtega = veterinarianNamed("Rafael", "Ortega", surgery);
+		Vet helenLeary = veterinarianNamed("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology),
+				List.of(henryStevens, rafaelOrtega, helenLeary));
+
+		assertThat(directory.getEntries())
+			.extracting(SpecialtyDirectory.Entry::getSpecialtyName, SpecialtyDirectoryTests::holderNames)
+			.containsExactly(tuple("dentistry", List.of()), tuple("radiology", List.of("Helen Leary", "Henry Stevens")),
+					tuple("surgery", List.of("Rafael Ortega")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchHoldersAcrossSeparateInstancesOfTheSameSpecialty() {
+		Specialty radiologyAsRead = specialtyNamed("radiology");
+		// The veterinarian read returns its own instance of the same stored row, and
+		// Specialty defines no equality: only the stored identity joins the two.
+		Specialty radiologyAsHeld = specialtyWithId(radiologyAsRead.getId(), radiologyAsRead.getName());
+		Vet helenLeary = veterinarianNamed("Helen", "Leary", radiologyAsHeld);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiologyAsRead), List.of(helenLeary));
+
+		assertThat(directory.getEntries())
+			.extracting(SpecialtyDirectory.Entry::getSpecialtyName, SpecialtyDirectoryTests::holderNames)
+			.containsExactly(tuple("radiology", List.of("Helen Leary")));
+	}
+
+	private static List<String> holderNames(SpecialtyDirectory.Entry entry) {
+		return entry.getVeterinarians().stream().map(vet -> vet.getFirstName() + " " + vet.getLastName()).toList();
+	}
+
+}
