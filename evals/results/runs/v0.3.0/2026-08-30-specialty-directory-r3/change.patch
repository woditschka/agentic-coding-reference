+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.springframework.samples.petclinic.model.BaseEntity;
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * Immutable read model listing every specialty the clinic knows, each with the
+ * veterinarians holding it.
+ * <p>
+ * It is projected in the application rather than read as one query: {@link Specialty}
+ * carries no inverse association back to {@link Vet}, so the two collections are read
+ * independently and joined here.
+ */
+public final class SpecialtyDirectory {
+
+	/**
+	 * Specialties read in stored-name order. Sorting happens here rather than in a query
+	 * so the rendered order is identical on every supported database vendor.
+	 */
+	private static final Comparator<Specialty> BY_STORED_NAME = Comparator
+		.<Specialty, String>comparing(NamedEntity::getName)
+		.thenComparing(BaseEntity::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	/** Holders read as a directory reads: by last name, then first name. */
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator
+		.<Vet, String>comparing(Person::getLastName)
+		.thenComparing(Person::getFirstName)
+		.thenComparing(BaseEntity::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	private final List<Entry> entries;
+
+	private SpecialtyDirectory(List<Entry> entries) {
+		this.entries = entries;
+	}
+
+	/**
+	 * Project the directory from the two independent reads that feed it.
+	 * @param specialties every specialty the clinic knows, including one no veterinarian
+	 * holds
+	 * @param veterinarians every veterinarian, including one holding no specialty
+	 * @return the directory, listing each specialty with its holders
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = indexHoldersBySpecialtyId(veterinarians);
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_STORED_NAME)
+			.map(specialty -> new Entry(specialty.getName(),
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	/**
+	 * Index the holders by the stored identity of the specialty they hold. Identity is
+	 * the only reliable key here: the specialty read and the veterinarian read may return
+	 * separate instances of the same row, and {@code Specialty} defines no equality.
+	 */
+	private static Map<Integer, List<Vet>> indexHoldersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty specialty : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holders;
+	}
+
+	public List<Entry> getEntries() {
+		return this.entries;
+	}
+
+	/**
+	 * One specialty of the directory, named as it is stored, with the veterinarians
+	 * holding it.
+	 */
+	public static final class Entry {
+
+		private final String specialtyName;
+
+		private final List<Vet> veterinarians;
+
+		private Entry(String specialtyName, List<Vet> veterinarians) {
+			this.specialtyName = specialtyName;
+			this.veterinarians = veterinarians.stream().sorted(BY_LAST_THEN_FIRST_NAME).toList();
+		}
+
+		public String getSpecialtyName() {
+			return this.specialtyName;
+		}
+
+		public List<Vet> getVeterinarians() {
+			return this.veterinarians;
+		}
+
+	}
+
+}
