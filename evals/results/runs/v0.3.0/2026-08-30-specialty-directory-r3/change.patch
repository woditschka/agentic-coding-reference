+			.andExpect(content().string(containsString("Helen Leary")))
+			.andExpect(content().string(containsString("Linda Douglas")))
+			.andExpect(content().string(not(containsString("James Carter"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryNoNavigationEntryToItself() throws Exception {
+		this.mockMvc.perform(get(SPECIALTY_DIRECTORY_URL))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString(SPECIALTY_DIRECTORY_URL))));
+	}
+
+}
