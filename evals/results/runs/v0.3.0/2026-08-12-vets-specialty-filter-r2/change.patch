+
+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Collection;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+
+/**
+ * Tests the specialty filter of {@link VetRepository} against the real schema and seed
+ * data, where the matching rules of the derived query can actually be observed.
+ */
+@DataJpaTest
+// Ensure that if the mysql profile is active we connect to the real database:
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VetRepositoryTests {
+
+	// Seed data (src/main/resources/db/*/data.sql): radiology is held by Leary and
+	// Stevens, surgery by Douglas and Ortega, and Douglas holds dentistry as well.
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY_IN_MIXED_CASE = "RaDiOlOgY";
+
+	private static final String OPENING_LETTERS_OF_RADIOLOGY = "radio";
+
+	private static final String RADIOLOGIST = "Leary";
+
+	private static final String OTHER_RADIOLOGIST = "Stevens";
+
+	private static final String VET_HOLDING_SURGERY_AND_DENTISTRY = "Douglas";
+
+	private static final String OTHER_SURGEON = "Ortega";
+
+	@Autowired
+	private VetRepository vets;
+
+	private final Pageable allOnOnePage = Pageable.unpaged();
+
+	@Test
+	void theVetDirectoryShouldListOnlyVetsHoldingTheNamedSpecialty() {
+		Page<Vet> radiologists = this.vets.findBySpecialtiesNameIgnoreCase(RADIOLOGY, this.allOnOnePage);
+
+		assertThat(radiologists).extracting(Vet::getLastName).containsExactlyInAnyOrder(RADIOLOGIST, OTHER_RADIOLOGIST);
+	}
+
+	@Test
+	void theVetDirectoryShouldMatchTheSpecialtyNameIgnoringCase() {
+		Page<Vet> radiologists = this.vets.findBySpecialtiesNameIgnoreCase(RADIOLOGY_IN_MIXED_CASE, this.allOnOnePage);
+
+		assertThat(radiologists).extracting(Vet::getLastName).containsExactlyInAnyOrder(RADIOLOGIST, OTHER_RADIOLOGIST);
+	}
+
+	@Test
+	void theVetDirectoryShouldNotMatchASpecialtyNamePrefix() {
+		Page<Vet> matches = this.vets.findBySpecialtiesNameIgnoreCase(OPENING_LETTERS_OF_RADIOLOGY, this.allOnOnePage);
+
+		assertThat(matches).isEmpty();
+	}
+
+	@Test
+	void theVetDirectoryShouldListAMultiSpecialtyVetUnderEachOfItsSpecialties() {
+		Page<Vet> surgeons = this.vets.findBySpecialtiesNameIgnoreCase(SURGERY, this.allOnOnePage);
+		Page<Vet> dentists = this.vets.findBySpecialtiesNameIgnoreCase(DENTISTRY, this.allOnOnePage);
+
+		assertThat(surgeons).extracting(Vet::getLastName)
+			.containsExactlyInAnyOrder(VET_HOLDING_SURGERY_AND_DENTISTRY, OTHER_SURGEON);
+		assertThat(dentists).extracting(Vet::getLastName).containsExactly(VET_HOLDING_SURGERY_AND_DENTISTRY);
+	}
+
+	@Test
+	void theWholeVetDirectoryShouldListOnlyVetsHoldingTheNamedSpecialty() {
+		Collection<Vet> radiologists = this.vets.findBySpecialtiesNameIgnoreCase(RADIOLOGY);
+
+		assertThat(radiologists).extracting(Vet::getLastName).containsExactlyInAnyOrder(RADIOLOGIST, OTHER_RADIOLOGIST);
+	}
+
+}
