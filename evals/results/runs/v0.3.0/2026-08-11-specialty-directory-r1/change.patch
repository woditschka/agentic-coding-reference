+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Immutable listing pairing every known {@link Specialty} with the veterinarians holding
+ * it, as the specialty directory page renders them.
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	/**
+	 * Total orderings, so that repeated requests present the same page. Each falls back
+	 * to the stored identity, because names alone tie: two specialties may share a stored
+	 * name, and two veterinarians may share a full name.
+	 */
+	private static final Comparator<Specialty> BY_STORED_NAME = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Builds the directory from every known specialty and every veterinarian.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians every veterinarian; one holding no specialty appears nowhere
+	 * @return the directory, holding one entry per specialty
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = holdersBySpecialtyId(veterinarians);
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_STORED_NAME)
+			.map(specialty -> new Entry(specialty.getName(),
+					displayNamesOf(holders.getOrDefault(specialty.getId(), List.of()))))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	/**
+	 * Groups the holders by specialty identity. Identity is the only reliable key here:
+	 * the entities inherit neither <code>equals</code> nor <code>hashCode</code>, the
+	 * veterinarians and the specialties are read through separate paths and so carry
+	 * distinct instances of the same row, and two specialties may share a stored name.
+	 */
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), specialtyId -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holders;
+	}
+
+	private static List<String> displayNamesOf(List<Vet> veterinarians) {
+		return veterinarians.stream()
+			.sorted(BY_LAST_THEN_FIRST_NAME)
+			.map(veterinarian -> veterinarian.getFirstName() + " " + veterinarian.getLastName())
+			.toList();
+	}
+
+	/**
+	 * One line of the directory: a specialty under its stored name, and the display names
+	 * of the veterinarians holding it. The list is empty when no veterinarian holds it.
+	 */
+	public record Entry(String specialtyName, List<String> veterinarianNames) {
+
+		public Entry {
+			veterinarianNames = List.copyOf(veterinarianNames);
+		}
+
+	}
+
+}
