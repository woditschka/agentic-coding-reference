+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.annotation.Bean;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}, driving the rendered specialty
+ * directory page.
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private StoredSpecialties specialties;
+
+	@Autowired
+	private EmployedVeterinarians veterinarians;
+
+	private int nextId = 1;
+
+	@BeforeEach
+	void emptyTheClinic() {
+		this.specialties.contain();
+		this.veterinarians.employ();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() throws Exception {
+		this.specialties.contain(createASpecialty("radiology"), createASpecialty("surgery"),
+				createASpecialty("dentistry"));
+
+		String page = renderSpecialtyDirectory();
+
+		assertThat(page).contains("radiology", "surgery", "dentistry");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHolderByFullName() throws Exception {
+		Specialty radiology = createASpecialty("radiology");
+		this.specialties.contain(radiology);
+		this.veterinarians.employ(createAVeterinarian("Helen", "Leary", radiology));
+
+		String page = renderSpecialtyDirectory();
+
+		assertThat(page).contains("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() throws Exception {
+		Specialty radiology = createASpecialty("radiology");
+		this.specialties.contain(radiology);
+		this.veterinarians.employ(createAVeterinarian("Helen", "Leary", radiology),
+				createAVeterinarian("James", "Carter"));
+
+		String page = renderSpecialtyDirectory();
+
+		assertThat(page).contains("Helen Leary").doesNotContain("James Carter");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() throws Exception {
+		Specialty radiology = createASpecialty("radiology");
+		this.specialties.contain(radiology, createASpecialty("surgery"));
+		this.veterinarians.employ(createAVeterinarian("Helen", "Leary", radiology));
+
+		String page = renderSpecialtyDirectory();
+
+		assertThat(page).containsSubsequence("radiology", "Helen Leary", "surgery").containsOnlyOnce("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOpenEmptyWhenNoSpecialtyExists() throws Exception {
+		this.veterinarians.employ(createAVeterinarian("Helen", "Leary", createASpecialty("radiology")));
+
+		String page = renderSpecialtyDirectory();
+
+		assertThat(page).doesNotContain("Helen Leary", "radiology");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentEntriesInAStableOrder() throws Exception {
+		Specialty radiology = createASpecialty("radiology");
+		this.specialties.contain(createASpecialty("surgery"), radiology, createASpecialty("dentistry"));
+		this.veterinarians.employ(createAVeterinarian("Linda", "Douglas", radiology),
+				createAVeterinarian("Helen", "Carter", radiology));
+
+		String page = renderSpecialtyDirectory();
+
+		assertThat(page).containsSubsequence("dentistry", "radiology", "Helen Carter", "Linda Douglas", "surgery");
+	}
+
+	private String renderSpecialtyDirectory() throws Exception {
+		return this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+	}
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVeterinarian(String firstName, String lastName, Specialty... held) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(this.nextId++);
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		for (Specialty specialty : held) {
+			veterinarian.addSpecialty(specialty);
+		}
+		return veterinarian;
+	}
+
+	@TestConfiguration
+	static class ClinicRecords {
+
+		@Bean
+		StoredSpecialties storedSpecialties() {
+			return new StoredSpecialties();
+		}
+
+		@Bean
+		EmployedVeterinarians employedVeterinarians() {
+			return new EmployedVeterinarians();
+		}
+
+	}
+
+	/**
+	 * Hand-written stand-in for the specialty store, holding what the clinic knows.
+	 */
+	static class StoredSpecialties implements SpecialtyRepository {
+
+		private List<Specialty> stored = List.of();
+
+		void contain(Specialty... specialties) {
+			this.stored = List.of(specialties);
+		}
+
+		@Override
+		public List<Specialty> findSpecialties() {
+			return this.stored;
+		}
+
+	}
+
+	/**
+	 * Hand-written stand-in for the veterinarian store. The specialty directory is
+	 * unpaged, so the paged read is never reached from this surface.
+	 */
+	static class EmployedVeterinarians implements VetRepository {
+
+		private List<Vet> employed = List.of();
+
+		void employ(Vet... veterinarians) {
+			this.employed = List.of(veterinarians);
+		}
+
+		@Override
+		public Collection<Vet> findAll() {
+			return this.employed;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("the specialty directory is unpaged");
+		}
+
+	}
+
+}
