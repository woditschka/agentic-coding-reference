+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the grouping behind the specialty directory
+ * page.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String SOME_SPECIALTY = "dentistry";
+
+	private int nextId = 1;
+
+	@Test
+	void theDirectoryShouldPairEachSpecialtyWithItsHolders() {
+		Specialty radiology = createASpecialty("radiology");
+		Specialty surgery = createASpecialty("surgery");
+		Vet helen = createAVeterinarian("Helen", "Leary", radiology);
+		Vet rafael = createAVeterinarian("Rafael", "Ortega", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen, rafael));
+
+		assertThat(directory.entries()).containsExactly(anEntry("radiology", "Helen Leary"),
+				anEntry("surgery", "Rafael Ortega"));
+	}
+
+	@Test
+	void theDirectoryShouldMatchHoldersOnSpecialtyIdentityRatherThanInstance() {
+		Specialty radiology = createASpecialty("radiology");
+		Specialty sameRowFreshlyLoaded = createSpecialty(radiology.getName(), radiology.getId());
+		Vet helen = createAVeterinarian("Helen", "Leary", sameRowFreshlyLoaded);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory.entries()).containsExactly(anEntry("radiology", "Helen Leary"));
+	}
+
+	@Test
+	void theDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = createASpecialty("radiology");
+		Specialty surgery = createASpecialty("surgery");
+		Vet helen = createAVeterinarian("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(directory.entries()).containsExactly(anEntry("radiology", "Helen Leary"), anEntry("surgery"));
+	}
+
+	@Test
+	void theDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty dentistry = createASpecialty(SOME_SPECIALTY);
+		Vet james = createAVeterinarian("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry), List.of(james));
+
+		assertThat(directory.entries()).containsExactly(anEntry(SOME_SPECIALTY));
+	}
+
+	@Test
+	void theDirectoryShouldBeEmptyWhenNoSpecialtyExists() {
+		Vet james = createAVeterinarian("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(james));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theDirectoryShouldKeepTwoSpecialtiesSharingAStoredNameApart() {
+		Specialty surgery = createASpecialty("surgery");
+		Specialty surgeryRecordedTwice = createASpecialty("surgery");
+		Vet helen = createAVeterinarian("Helen", "Leary", surgery);
+		Vet rafael = createAVeterinarian("Rafael", "Ortega", surgeryRecordedTwice);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, surgeryRecordedTwice),
+				List.of(helen, rafael));
+
+		assertThat(directory.entries()).containsExactly(anEntry("surgery", "Helen Leary"),
+				anEntry("surgery", "Rafael Ortega"));
+	}
+
+	@Test
+	void theDirectoryShouldOrderEntriesByStoredName() {
+		Specialty surgeryRecordedSecond = createSpecialty("surgery", 30);
+		Specialty surgeryRecordedFirst = createSpecialty("surgery", 20);
+		Specialty radiology = createSpecialty("radiology", 10);
+
+		SpecialtyDirectory directory = SpecialtyDirectory
+			.of(List.of(surgeryRecordedSecond, surgeryRecordedFirst, radiology), List.of());
+
+		assertThat(directory.entries()).containsExactly(anEntry("radiology"), anEntry("surgery"), anEntry("surgery"));
+	}
+
+	@Test
+	void theDirectoryShouldOrderHoldersByLastNameThenFirstName() {
+		Specialty radiology = createASpecialty("radiology");
+		Vet linda = createAVeterinarian("Linda", "Douglas", radiology);
+		Vet helen = createAVeterinarian("Helen", "Douglas", radiology);
+		Vet rafael = createAVeterinarian("Rafael", "Carter", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(linda, helen, rafael));
+
+		assertThat(directory.entries())
+			.containsExactly(anEntry("radiology", "Rafael Carter", "Helen Douglas", "Linda Douglas"));
+	}
+
+	@Test
+	void theDirectoryShouldListBothVeterinariansSharingAFullName() {
+		Specialty radiology = createASpecialty("radiology");
+		Vet helenHiredSecond = createVeterinarian("Helen", "Leary", 200, radiology);
+		Vet helenHiredFirst = createVeterinarian("Helen", "Leary", 100, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(helenHiredSecond, helenHiredFirst));
+
+		assertThat(directory.entries()).containsExactly(anEntry("radiology", "Helen Leary", "Helen Leary"));
+	}
+
+	private SpecialtyDirectory.Entry anEntry(String specialtyName, String... veterinarianNames) {
+		return new SpecialtyDirectory.Entry(specialtyName, List.of(veterinarianNames));
+	}
+
+	private Specialty createASpecialty(String name) {
+		return createSpecialty(name, this.nextId++);
+	}
+
+	private Specialty createSpecialty(String name, Integer id) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVeterinarian(String firstName, String lastName, Specialty... held) {
+		return createVeterinarian(firstName, lastName, this.nextId++, held);
+	}
+
+	private Vet createVeterinarian(String firstName, String lastName, Integer id, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
