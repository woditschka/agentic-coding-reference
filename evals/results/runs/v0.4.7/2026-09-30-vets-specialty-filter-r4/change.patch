+
+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.InstanceOfAssertFactories.list;
+
+import java.util.Collection;
+import java.util.List;
+
+import jakarta.persistence.EntityManager;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.samples.petclinic.model.NamedEntity;
+
+/**
+ * Specialty narrowing of the veterinarian list, run against the seeded database: surgery
+ * is held by Linda Douglas and Rafael Ortega, Douglas also holds dentistry, and James
+ * Carter and Sharon Jenkins hold no specialty.
+ */
+@DataJpaTest
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VetRepositoryTests {
+
+	private static final String SURGERY = "surgery";
+
+	private static final String SURGERY_IN_UPPER_CASE = "SURGERY";
+
+	private static final String SURGERY_IN_MIXED_CASE = "Surgery";
+
+	private static final String PREFIX_OF_SURGERY = "surg";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String SPECIALTY_NO_VET_HOLDS = "cardiology";
+
+	private static final String DOUGLAS = "Douglas";
+
+	private static final String ORTEGA = "Ortega";
+
+	private static final List<String> SURGERY_HOLDERS = List.of(DOUGLAS, ORTEGA);
+
+	private static final int LINDA_DOUGLAS_ID = 3;
+
+	private static final int FIRST_PAGE = 0;
+
+	private static final int ONE_VET_PER_PAGE = 1;
+
+	@Autowired
+	private VetRepository vets;
+
+	@Autowired
+	private EntityManager entityManager;
+
+	@ParameterizedTest
+	@ValueSource(strings = { SURGERY, SURGERY_IN_UPPER_CASE, SURGERY_IN_MIXED_CASE })
+	void theSpecialtyFilterShouldMatchTheWholeNameIgnoringCase(String specialty) {
+		Collection<Vet> narrowed = this.vets.findDistinctBySpecialtiesNameIgnoreCase(specialty);
+
+		assertThat(narrowed).extracting(Vet::getLastName).containsExactlyInAnyOrderElementsOf(SURGERY_HOLDERS);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldNotMatchAPrefixOfTheName() {
+		Collection<Vet> narrowed = this.vets.findDistinctBySpecialtiesNameIgnoreCase(PREFIX_OF_SURGERY);
+
+		assertThat(narrowed).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyFilterShouldYieldAnEmptyVetListWhenNoVetHoldsTheSpecialty() {
+		Collection<Vet> narrowed = this.vets.findDistinctBySpecialtiesNameIgnoreCase(SPECIALTY_NO_VET_HOLDS);
+
+		assertThat(narrowed).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyFilterShouldKeepEverySpecialtyOfAMatchedVet() {
+		Collection<Vet> narrowed = this.vets.findDistinctBySpecialtiesNameIgnoreCase(DENTISTRY);
+
+		assertThat(narrowed).singleElement()
+			.extracting(Vet::getSpecialties)
+			.asInstanceOf(list(Specialty.class))
+			.extracting(NamedEntity::getName)
+			.containsExactly(DENTISTRY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldListAVetOnceWhenTwoOfTheirSpecialtiesMatchTheName() {
+		givenLindaDouglasAlsoHolds(createASpecialty(SURGERY_IN_UPPER_CASE));
+
+		Page<Vet> narrowed = this.vets.findDistinctBySpecialtiesNameIgnoreCase(SURGERY,
+				PageRequest.of(FIRST_PAGE, SURGERY_HOLDERS.size()));
+
+		assertThat(narrowed.getTotalElements()).isEqualTo(SURGERY_HOLDERS.size());
+		assertThat(narrowed.getContent()).extracting(Vet::getLastName)
+			.containsExactlyInAnyOrderElementsOf(SURGERY_HOLDERS);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldPageOverTheNarrowedList() {
+		Page<Vet> firstPage = this.vets.findDistinctBySpecialtiesNameIgnoreCase(SURGERY,
+				PageRequest.of(FIRST_PAGE, ONE_VET_PER_PAGE));
+
+		assertThat(firstPage.getContent()).hasSize(ONE_VET_PER_PAGE);
+		assertThat(firstPage.getTotalElements()).isEqualTo(SURGERY_HOLDERS.size());
+		assertThat(firstPage.getTotalPages()).isEqualTo(SURGERY_HOLDERS.size() / ONE_VET_PER_PAGE);
+	}
+
+	private void givenLindaDouglasAlsoHolds(Specialty specialty) {
+		this.entityManager.persist(specialty);
+		this.entityManager.find(Vet.class, LINDA_DOUGLAS_ID).addSpecialty(specialty);
+		this.entityManager.flush();
+		this.entityManager.clear();
+	}
+
+	private static Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return specialty;
+	}
+
+}
