+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	private static final int UNKNOWN_VISIT_ID = 2;
+
+	private static final Integer UNSAVED_VISIT_ID = null;
+
+	@Test
+	void thePetShouldFindItsBookedVisitById() {
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWith(bookedVisit);
+
+		Visit found = pet.getVisit(BOOKED_VISIT_ID);
+
+		assertThat(found).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldFindNoVisitForAnIdItDoesNotHold() {
+		Pet pet = createAPetWith(createABookedVisit(BOOKED_VISIT_ID));
+
+		Visit found = pet.getVisit(UNKNOWN_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	@Test
+	void thePetShouldNotFindAVisitThatIsNotYetSaved() {
+		Pet pet = createAPetWith(createAnUnsavedVisit());
+
+		Visit found = pet.getVisit(UNSAVED_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	private static Pet createAPetWith(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+	private static Visit createABookedVisit(int id) {
+		Visit visit = createAnUnsavedVisit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+}
