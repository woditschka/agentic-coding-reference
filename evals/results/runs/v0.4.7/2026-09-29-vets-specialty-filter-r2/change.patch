diff --git a/src/test/java/org/springframework/samples/petclinic/vet/VetControllerIntegrationTests.java b/src/test/java/org/springframework/samples/petclinic/vet/VetControllerIntegrationTests.java
new file mode 100644
index 0000000..fb39ede
--- /dev/null
+++ b/src/test/java/org/springframework/samples/petclinic/vet/VetControllerIntegrationTests.java
@@ -0,0 +1,238 @@
+/*
