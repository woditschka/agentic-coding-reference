 	@Cacheable("vets")
 	Page<Vet> findAll(Pageable pageable) throws DataAccessException;
 
+	/**
+	 * Retrieve the <code>Vet</code>s holding the named specialty. The whole name must
+	 * match, disregarding letter case; a prefix matches nothing. Each <code>Vet</code>
+	 * appears once and carries every specialty it holds. Not cached: the name is chosen
+	 * by the caller, and the vet cache declares no size limit.
+	 * @param specialtyName the specialty name to match
+	 * @param pageable the page to return, or {@link Pageable#unpaged()} for all matches
+	 * @return the matching <code>Vet</code>s, empty when none holds the specialty
+	 */
