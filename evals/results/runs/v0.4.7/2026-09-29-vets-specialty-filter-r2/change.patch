+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.contains;
+import static org.hamcrest.Matchers.containsInAnyOrder;
+import static org.hamcrest.Matchers.empty;
+import static org.hamcrest.Matchers.everyItem;
+import static org.hamcrest.Matchers.hasItem;
+import static org.hamcrest.Matchers.hasProperty;
+import static org.hamcrest.Matchers.hasSize;
+import static org.hamcrest.Matchers.is;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.http.MediaType;
+import org.springframework.test.context.jdbc.Sql;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.regex.Pattern;
+import java.util.stream.Stream;
+
+import org.hamcrest.Matcher;
+
+/**
+ * Specialty narrowing of both veterinarian list surfaces, run against the real repository
+ * and the seeded veterinarians. Every test rolls back, so fixture rows never outlive the
+ * test that adds them.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+@Transactional
+class VetControllerIntegrationTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String RADIOLOGY_IN_CAPITALS = "RADIOLOGY";
+
+	private static final String RADIOLOGY_PREFIX = "radio";
+
+	private static final String[] RADIOLOGIST_LAST_NAMES = { "Leary", "Stevens" };
+
+	private static final String[] NO_LAST_NAMES = {};
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String UNHELD_SPECIALTY = "anesthesia";
+
+	private static final String UNLISTED_SPECIALTY = "cardiology";
+
+	private static final String EMPTY = "";
+
+	private static final String ALL_SPACES = "   ";
+
+	/** The directory's page size, stated here so a production change fails visibly. */
+	private static final int PAGE_SIZE = 5;
+
+	/** Two full pages of added radiologists push the seeded ones onto a third page. */
+	private static final int ADDED_RADIOLOGISTS = 2 * PAGE_SIZE;
+
+	private static final String ANY_FIRST_NAME = "Added";
+
+	private static final String ADDED_RADIOLOGIST_LAST_NAME = "Radiologist";
+
+	private static final int FIRST_PAGE = 1;
+
+	private static final int MIDDLE_PAGE = 2;
+
+	private static final int LAST_PAGE = 3;
+
+	private static final String ADD_RADIOLOGISTS = "INSERT INTO vets (first_name, last_name)" + " SELECT '"
+			+ ANY_FIRST_NAME + "', '" + ADDED_RADIOLOGIST_LAST_NAME + "' FROM SYSTEM_RANGE(1, " + ADDED_RADIOLOGISTS
+			+ ")";
+
+	private static final String GIVE_ADDED_RADIOLOGISTS_RADIOLOGY = "INSERT INTO vet_specialties (vet_id, specialty_id)"
+			+ " SELECT v.id, s.id FROM vets v, specialties s WHERE v.last_name = '" + ADDED_RADIOLOGIST_LAST_NAME
+			+ "' AND s.name = '" + RADIOLOGY + "'";
+
+	private static final Pattern PAGE_LINK = Pattern.compile("href=\"(/vets\\.html\\?[^\"]*)\"");
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	void theVetDirectoryShouldListOnlyVetsHoldingTheNamedSpecialty() throws Exception {
+		mockMvc.perform(get("/vets.html").param("specialty", RADIOLOGY))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute("listVets", vetsWithLastNames(RADIOLOGIST_LAST_NAMES)));
+	}
+
+	@Test
+	void theFilteredVetDirectoryShouldShowEverySpecialtyAListedVetHolds() throws Exception {
+		mockMvc.perform(get("/vets.html").param("specialty", DENTISTRY))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute("listVets",
+					contains(hasProperty("specialties", contains(named(DENTISTRY), named(SURGERY))))));
+	}
+
+	@Test
+	void theVetResourceShouldListOnlyVetsHoldingTheNamedSpecialty() throws Exception {
+		mockMvc.perform(get("/vets").param("specialty", RADIOLOGY).accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList[*].lastName", containsInAnyOrder(RADIOLOGIST_LAST_NAMES)));
+	}
+
+	static Stream<Arguments> specialtySpellings() {
+		return Stream.of(Arguments.of(RADIOLOGY_IN_CAPITALS, RADIOLOGIST_LAST_NAMES),
+				Arguments.of(RADIOLOGY_PREFIX, NO_LAST_NAMES));
+	}
+
+	@ParameterizedTest
+	@MethodSource("specialtySpellings")
+	void theSpecialtyFilterShouldMatchWholeNamesIgnoringCase(String specialty, String[] expectedLastNames)
+			throws Exception {
+		mockMvc.perform(get("/vets").param("specialty", specialty).accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList[*].lastName", containsInAnyOrder(expectedLastNames)));
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { UNHELD_SPECIALTY, UNLISTED_SPECIALTY })
+	@Sql(statements = "INSERT INTO specialties (name) VALUES ('" + UNHELD_SPECIALTY + "')")
+	void theSpecialtyFilterShouldReturnAnEmptyListWhenNoVetHoldsTheSpecialty(String specialty) throws Exception {
+		mockMvc.perform(get("/vets").param("specialty", specialty).accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList", empty()));
+		mockMvc.perform(get("/vets.html").param("specialty", specialty))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute("listVets", empty()));
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { EMPTY, ALL_SPACES })
+	void theSpecialtyFilterShouldBeIgnoredWhenBlank(String blank) throws Exception {
+		String unfilteredDirectory = contentOf(get("/vets.html"));
+		String unfilteredResource = contentOf(get("/vets").accept(MediaType.APPLICATION_JSON));
+
+		String blankFilteredDirectory = contentOf(get("/vets.html").param("specialty", blank));
+		String blankFilteredResource = contentOf(
+				get("/vets").param("specialty", blank).accept(MediaType.APPLICATION_JSON));
+
+		assertThat(blankFilteredDirectory).isEqualTo(unfilteredDirectory);
+		assertThat(blankFilteredResource).isEqualTo(unfilteredResource);
+	}
+
+	@Test
+	@Sql(statements = { ADD_RADIOLOGISTS, GIVE_ADDED_RADIOLOGISTS_RADIOLOGY })
+	void theFilteredVetDirectoryShouldPageOnlyTheMatchingVets() throws Exception {
+		int matchingRadiologists = ADDED_RADIOLOGISTS + RADIOLOGIST_LAST_NAMES.length;
+
+		mockMvc.perform(get("/vets.html").param("specialty", RADIOLOGY).param("page", String.valueOf(LAST_PAGE)))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute("totalPages", LAST_PAGE))
+			.andExpect(model().attribute("totalItems", (long) matchingRadiologists))
+			.andExpect(model().attribute("listVets", hasSize(matchingRadiologists - (LAST_PAGE - 1) * PAGE_SIZE)))
+			.andExpect(model().attribute("listVets", everyItem(hasProperty("specialties", hasItem(named(RADIOLOGY))))));
+	}
+
+	@Test
+	@Sql(statements = { ADD_RADIOLOGISTS, GIVE_ADDED_RADIOLOGISTS_RADIOLOGY })
+	void theFilteredVetDirectoryShouldKeepTheSpecialtyInEveryPageLink() throws Exception {
+		String middlePage = contentOf(
+				get("/vets.html").param("specialty", RADIOLOGY).param("page", String.valueOf(MIDDLE_PAGE)));
+
+		assertThat(pageLinksIn(middlePage)).containsExactly(radiologyPageLink(FIRST_PAGE), radiologyPageLink(LAST_PAGE),
+				radiologyPageLink(FIRST_PAGE), radiologyPageLink(MIDDLE_PAGE - 1), radiologyPageLink(MIDDLE_PAGE + 1),
+				radiologyPageLink(LAST_PAGE));
+	}
+
+	@Test
+	void theUnfilteredVetDirectoryShouldKeepPageLinksWithoutASpecialty() throws Exception {
+		int secondAndLastPage = FIRST_PAGE + 1;
+
+		String firstPage = contentOf(get("/vets.html"));
+
+		assertThat(pageLinksIn(firstPage)).containsExactly(unfilteredPageLink(secondAndLastPage),
+				unfilteredPageLink(secondAndLastPage), unfilteredPageLink(secondAndLastPage));
+	}
+
+	private String contentOf(MockHttpServletRequestBuilder request) throws Exception {
+		return mockMvc.perform(request).andExpect(status().isOk()).andReturn().getResponse().getContentAsString();
+	}
+
+	private static List<String> pageLinksIn(String html) {
+		return PAGE_LINK.matcher(html).results().map(link -> link.group(1)).toList();
+	}
+
+	private static String radiologyPageLink(int page) {
+		return unfilteredPageLink(page) + "&amp;specialty=" + RADIOLOGY;
+	}
+
+	private static String unfilteredPageLink(int page) {
+		return "/vets.html?page=" + page;
+	}
+
+	private static Matcher<Object> named(String name) {
+		return hasProperty("name", is(name));
+	}
+
+	private static Matcher<Iterable<?>> vetsWithLastNames(String... lastNames) {
+		List<Matcher<? super Object>> byLastName = Arrays.stream(lastNames)
+			.<Matcher<? super Object>>map(lastName -> hasProperty("lastName", is(lastName)))
+			.toList();
+		return containsInAnyOrder(byLastName);
+	}
+
+}
