 	@GetMapping({ "/vets" })
-	public @ResponseBody Vets showResourcesVetList() {
+	public @ResponseBody Vets showResourcesVetList(@RequestParam(required = false) String specialty) {
 		// Here we are returning an object of type 'Vets' rather than a collection of Vet
 		// objects so it is simpler for JSon/Object mapping
 		Vets vets = new Vets();
-		vets.getVetList().addAll(this.vetRepository.findAll());
+		vets.getVetList().addAll(findVets(narrowingOf(specialty)));
 		return vets;
 	}
 
+	private Collection<Vet> findVets(String narrowedTo) {
+		if (narrowedTo == null) {
+			return vetRepository.findAll();
+		}
+		return vetRepository.findDistinctBySpecialtiesNameIgnoreCase(narrowedTo, Pageable.unpaged()).getContent();
+	}
+
+	/**
+	 * A blank specialty narrows nothing, like an empty owner search; any other value is
+	 * matched as given.
+	 * @return the specialty to narrow to, or {@code null} for the whole list
+	 */
+	private static String narrowingOf(String specialty) {
+		return StringUtils.hasText(specialty) ? specialty : null;
+	}
+
 }
