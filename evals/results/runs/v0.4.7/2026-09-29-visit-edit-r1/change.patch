+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int HELD_VISIT_ID = 1;
+
+	private static final int OTHER_PETS_VISIT_ID = 2;
+
+	private static final int UNKNOWN_VISIT_ID = 99;
+
+	@Test
+	void thePetShouldFindItsOwnPersistedVisitByIdentity() {
+		Visit heldVisit = createAPersistedVisit(HELD_VISIT_ID);
+		Pet pet = createAPetHolding(heldVisit);
+
+		assertThat(pet.getVisit(HELD_VISIT_ID)).isSameAs(heldVisit);
+	}
+
+	@Test
+	void thePetShouldNotFindAVisitHeldByAnotherPet() {
+		Pet pet = createAPetHolding(createAPersistedVisit(HELD_VISIT_ID));
+		createAPetHolding(createAPersistedVisit(OTHER_PETS_VISIT_ID));
+
+		assertThat(pet.getVisit(OTHER_PETS_VISIT_ID)).isNull();
+	}
+
+	@Test
+	void thePetShouldFindNoVisitForAnUnknownIdentity() {
+		Pet pet = createAPetHolding(createAPersistedVisit(HELD_VISIT_ID));
+
+		assertThat(pet.getVisit(UNKNOWN_VISIT_ID)).isNull();
+	}
+
+	@Test
+	void thePetShouldNotFindAVisitThatIsNotYetPersisted() {
+		Pet pet = createAPetHolding(createANewVisit());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	private static Pet createAPetHolding(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+	private static Visit createAPersistedVisit(int id) {
+		Visit visit = createANewVisit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createANewVisit() {
+		return new Visit();
+	}
+
+}
