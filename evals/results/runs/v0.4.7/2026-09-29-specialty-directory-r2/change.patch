+package org.springframework.samples.petclinic.vet;
+
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.WebDataBinder;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.InitBinder;
+
+/**
+ * Serves the specialty directory as a single unpaged page. The page binds no request
+ * input.
+ */
+@Controller
+class SpecialtyController {
+
+	private final SpecialtyRepository specialties;
+
+	private final VetRepository vets;
+
+	SpecialtyController(SpecialtyRepository specialties, VetRepository vets) {
+		this.specialties = specialties;
+		this.vets = vets;
+	}
+
+	/**
+	 * Keeps the mass-assignment disallow list every controller declares, so a form added
+	 * to this controller later cannot bind an identifier.
+	 */
+	@InitBinder
+	public void setAllowedFields(WebDataBinder dataBinder) {
+		dataBinder.setDisallowedFields("id", "*.id");
+	}
+
+	@GetMapping("/specialties.html")
+	public String showSpecialtyDirectory(Model model) {
+		model.addAttribute("specialtyDirectory",
+				SpecialtyDirectory.of(this.specialties.findAll(), this.vets.findAll()));
+		return "vets/specialtyDirectory";
+	}
+
+}
