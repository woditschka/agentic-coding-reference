+
+	private static final String SPECIALTY_DIRECTORY_ATTRIBUTE = "specialtyDirectory";
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String HELEN = "Helen";
+
+	private static final String LEARY = "Leary";
+
+	private static final String SOME_SPECIALTY_NAME_PREFIX = "specialty-";
+
+	private static final int MORE_SPECIALTIES_THAN_A_PAGE_WOULD_HOLD = 30;
+
+	private static final String PAGE_LINK_PARAMETER = "page=";
+
+	private static final List<String> ALL_SPECIALTY_NAMES = Stream
+		.concat(Stream.of(RADIOLOGY),
+				IntStream.rangeClosed(1, MORE_SPECIALTIES_THAN_A_PAGE_WOULD_HOLD)
+					.mapToObj(number -> SOME_SPECIALTY_NAME_PREFIX + number))
+		.toList();
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	void theSpecialtyDirectoryPageShouldRenderEachSpecialtyWithItsHolders() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(view().name(SPECIALTY_DIRECTORY_VIEW))
+			.andExpect(model().attributeExists(SPECIALTY_DIRECTORY_ATTRIBUTE))
+			.andExpect(content().string(allOf(containsString(RADIOLOGY), containsString(HELEN + " " + LEARY))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEverySpecialtyOnOnePage() throws Exception {
+		List<Matcher<? super String>> everySpecialtyRendered = ALL_SPECIALTY_NAMES.stream()
+			.<Matcher<? super String>>map(Matchers::containsString)
+			.toList();
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(content().string(allOf(everySpecialtyRendered)))
+			.andExpect(content().string(not(containsString(PAGE_LINK_PARAMETER))));
+	}
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(held).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	@TestConfiguration
+	static class FakeRepositories {
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			List<Specialty> specialties = IntStream.range(0, ALL_SPECIALTY_NAMES.size())
+				.mapToObj(index -> createASpecialty(RADIOLOGY_ID + index, ALL_SPECIALTY_NAMES.get(index)))
+				.toList();
+			return () -> specialties;
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new FakeVetRepository(List.of(createAVet(HELEN, LEARY, createASpecialty(RADIOLOGY_ID, RADIOLOGY))));
+		}
+
+	}
+
+	private record FakeVetRepository(List<Vet> vets) implements VetRepository {
+
+		@Override
+		public Collection<Vet> findAll() {
+			return vets;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			return new PageImpl<>(vets, pageable, vets.size());
+		}
+
+	}
+
+}
