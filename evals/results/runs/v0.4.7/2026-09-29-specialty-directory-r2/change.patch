+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The clinic's specialty directory: every specialty it knows, by recorded name, each with
+ * the veterinarians who hold it. A veterinarian holding no specialty is listed under
+ * none, so the directory is not a full roster.
+ *
+ * @param listings one listing per specialty, in the order the specialties were given
+ */
+record SpecialtyDirectory(List<Listing> listings) {
+
+	SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	/**
+	 * Inverts the veterinarians' specialties into the directory. Specialties are matched
+	 * by identifier because a {@link Specialty} has no value equality, and the
+	 * veterinarians may carry different instances of the same specialty rows.
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<String>> holderNamesBySpecialtyId = holderNamesBySpecialtyId(vets);
+		List<Listing> listings = specialties.stream()
+			.map(specialty -> new Listing(specialty.getName(),
+					holderNamesBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+		return new SpecialtyDirectory(listings);
+	}
+
+	private static Map<Integer, List<String>> holderNamesBySpecialtyId(Collection<Vet> vets) {
+		Map<Integer, List<String>> holderNamesBySpecialtyId = new HashMap<>();
+		for (Vet vet : vets) {
+			String holderName = vet.getFirstName() + " " + vet.getLastName();
+			for (Specialty held : vet.getSpecialties()) {
+				holderNamesBySpecialtyId.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(holderName);
+			}
+		}
+		return holderNamesBySpecialtyId;
+	}
+
+	/**
+	 * One specialty in the directory with the names of its holders, first name then last
+	 * name. The holder list is empty for a specialty no veterinarian holds.
+	 */
+	record Listing(String specialtyName, List<String> holderNames) {
+
+		Listing {
+			holderNames = List.copyOf(holderNames);
+		}
+
+	}
+
+}
