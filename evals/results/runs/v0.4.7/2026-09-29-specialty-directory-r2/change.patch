+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Listing;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Specialties compare by identity, and in production the vets' specialties and the
+ * specialty list are separate instances of the same rows. Each factory call below
+ * therefore builds a fresh instance, so a directory that matched by instance instead of
+ * by identifier would list nobody.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int DENTISTRY_ID = 3;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String HELEN = "Helen";
+
+	private static final String LEARY = "Leary";
+
+	private static final String LINDA = "Linda";
+
+	private static final String DOUGLAS = "Douglas";
+
+	private static final String JAMES = "James";
+
+	private static final String CARTER = "Carter";
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByRecordedName() {
+		List<Specialty> specialties = List.of(radiology(), surgery(), dentistry());
+		List<Vet> vets = List.of(createAVet(HELEN, LEARY, radiology()), createAVet(LINDA, DOUGLAS, surgery()));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, vets);
+
+		assertThat(directory.listings()).extracting(Listing::specialtyName)
+			.containsExactlyInAnyOrder(RADIOLOGY, SURGERY, DENTISTRY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderByFirstThenLastName() {
+		List<Specialty> specialties = List.of(radiology());
+		List<Vet> vets = List.of(createAVet(HELEN, LEARY, radiology()));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, vets);
+
+		assertThat(directory.listings()).containsExactly(createAListing(RADIOLOGY, HELEN + " " + LEARY));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVetUnderEachSpecialtyTheyHold() {
+		List<Specialty> specialties = List.of(surgery(), dentistry());
+		List<Vet> vets = List.of(createAVet(LINDA, DOUGLAS, surgery(), dentistry()));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, vets);
+
+		assertThat(directory.listings()).containsExactlyInAnyOrder(createAListing(SURGERY, LINDA + " " + DOUGLAS),
+				createAListing(DENTISTRY, LINDA + " " + DOUGLAS));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVetHoldingNoSpecialty() {
+		List<Specialty> specialties = List.of(radiology());
+		List<Vet> vets = List.of(createAVet(JAMES, CARTER), createAVet(HELEN, LEARY, radiology()));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, vets);
+
+		assertThat(directory.listings()).flatExtracting(Listing::holderNames).doesNotContain(JAMES + " " + CARTER);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVetHolds() {
+		List<Specialty> specialties = List.of(radiology(), dentistry());
+		List<Vet> vets = List.of(createAVet(HELEN, LEARY, radiology()));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, vets);
+
+		assertThat(directory.listings()).contains(createAListing(DENTISTRY));
+	}
+
+	private static Specialty radiology() {
+		return createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+	}
+
+	private static Specialty surgery() {
+		return createASpecialty(SURGERY_ID, SURGERY);
+	}
+
+	private static Specialty dentistry() {
+		return createASpecialty(DENTISTRY_ID, DENTISTRY);
+	}
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(held).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static Listing createAListing(String specialtyName, String... holderNames) {
+		return new Listing(specialtyName, List.of(holderNames));
+	}
+
+}
