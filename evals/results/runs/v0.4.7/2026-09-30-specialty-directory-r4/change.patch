+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery(), radiology(), dentistry()),
+				List.of(laterLastName, earlierLastLaterFirstName, earlierLastEarlierFirstName));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(dentistry()),
+				entry(radiology(), earlierLastEarlierFirstName, earlierLastLaterFirstName, laterLastName),
+				entry(surgery())));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSameNamedSpecialtiesByStoredIdentifier() {
+		Specialty storedFirst = specialty(LOWER_SPECIALTY_ID, SHARED_SPECIALTY_NAME);
+		Specialty storedSecond = specialty(HIGHER_SPECIALTY_ID, SHARED_SPECIALTY_NAME);
+		Vet holderOfSecond = aVetHolding(specialty(HIGHER_SPECIALTY_ID, SHARED_SPECIALTY_NAME));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(storedSecond, storedFirst),
+				List.of(holderOfSecond));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(storedFirst), entry(storedSecond, holderOfSecond)));
+	}
+
+	private static Specialty radiology() {
+		return specialty(RADIOLOGY_ID, "radiology");
+	}
+
+	private static Specialty surgery() {
+		return specialty(SURGERY_ID, "surgery");
+	}
+
+	private static Specialty dentistry() {
+		return specialty(DENTISTRY_ID, "dentistry");
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet aVetHolding(Specialty... held) {
+		return vet(ANY_FIRST_NAME + nextVetId, ANY_LAST_NAME + nextVetId, held);
+	}
+
+	private Vet vet(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(nextVetId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		Stream.of(held).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static SpecialtyDirectory directoryOf(Entry... entries) {
+		return new SpecialtyDirectory(List.of(entries));
+	}
+
+	private static Entry entry(Specialty specialty, Vet... holders) {
+		return new Entry(specialty.getName(),
+				Stream.of(holders).map(vet -> new Holder(vet.getFirstName(), vet.getLastName())).toList());
+	}
+
+}
