+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Every specialty the clinic knows, each paired with the veterinarians holding it.
+ * Specialties run in name order and holders in last-then-first-name order; ties fall back
+ * to the stored identifier so the order is the same on every request.
+ * <p>
+ * The directory copies names out of the entities, so no mutable entity escapes into it.
+ */
+record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Builds the directory from the full specialty list, so a specialty no veterinarian
+	 * holds still gets an entry. Holders are matched by stored identifier because the
+	 * roster comes from the vet cache while the specialties are loaded fresh, and the
+	 * entities carry no value equality.
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> roster) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(roster);
+		return new SpecialtyDirectory(specialties.stream()
+			.sorted(SPECIALTY_ORDER)
+			.map(specialty -> Entry.of(specialty, holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList());
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> roster) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet vet : roster) {
+			for (Specialty specialty : vet.getSpecialties()) {
+				holders.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(vet);
+			}
+		}
+		return holders;
+	}
+
+	/**
+	 * One specialty, under its stored name, with the veterinarians holding it.
+	 */
+	record Entry(String specialty, List<Holder> holders) {
+
+		Entry {
+			holders = List.copyOf(holders);
+		}
+
+		private static Entry of(Specialty specialty, List<Vet> holders) {
+			return new Entry(specialty.getName(), holders.stream().sorted(HOLDER_ORDER).map(Holder::of).toList());
+		}
+
+	}
+
+	/**
+	 * A veterinarian listed under a specialty they hold.
+	 */
+	record Holder(String firstName, String lastName) {
+
+		private static Holder of(Vet vet) {
+			return new Holder(vet.getFirstName(), vet.getLastName());
+		}
+
+	}
+
+}
