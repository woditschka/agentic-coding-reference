+package org.springframework.samples.petclinic.owner;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class PetTests {
+
+	private static final Integer RECORDED_VISIT_ID = 1;
+
+	private static final Integer UNRECORDED_VISIT_ID = 2;
+
+	@Test
+	void thePetShouldFindARecordedVisitById() {
+		Visit recordedVisit = createAPersistedVisit(RECORDED_VISIT_ID);
+		Pet pet = createAPetWith(recordedVisit);
+
+		Visit found = pet.getVisit(RECORDED_VISIT_ID);
+
+		assertThat(found).isSameAs(recordedVisit);
+	}
+
+	@Test
+	void thePetShouldNotFindAVisitIdItDoesNotRecord() {
+		Pet pet = createAPetWith(createAPersistedVisit(RECORDED_VISIT_ID));
+
+		Visit found = pet.getVisit(UNRECORDED_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	@Test
+	void thePetShouldNotFindAnUnsavedVisit() {
+		Visit unsavedVisit = createAnUnsavedVisit();
+		Pet pet = createAPetWith(unsavedVisit);
+
+		Visit found = pet.getVisit(unsavedVisit.getId());
+
+		assertThat(found).isNull();
+	}
+
+	private static Pet createAPetWith(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+	private static Visit createAPersistedVisit(Integer id) {
+		Visit visit = createAnUnsavedVisit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+}
