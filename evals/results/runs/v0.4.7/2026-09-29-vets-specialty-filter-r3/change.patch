+				get(VET_DIRECTORY).param(SPECIALTY_PARAMETER, SPECIALTY_WITH_RESERVED_URL_CHARACTERS)
+					.param(PAGE_PARAMETER, String.valueOf(middlePage)));
+
+		// The middle page renders every link kind: the numbered, first, and previous
+		// links
+		// lead to the page before it; the numbered, next, and last links to the one
+		// after.
+		assertThat(pageLinks(renderedPage)).containsExactlyInAnyOrder(filteredPageLink(middlePage - 1),
+				filteredPageLink(middlePage - 1), filteredPageLink(middlePage - 1), filteredPageLink(lastPage),
+				filteredPageLink(lastPage), filteredPageLink(lastPage));
+	}
