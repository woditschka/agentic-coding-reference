+	private Specialty persistSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		this.entityManager.persist(specialty);
+		return specialty;
+	}
+
+	private Vet persistVetHolding(Specialty specialty) {
+		Vet vet = new Vet();
+		vet.setFirstName(ANY_VET_FIRST_NAME);
+		vet.setLastName(ANY_VET_LAST_NAME);
+		vet.addSpecialty(specialty);
+		this.entityManager.persist(vet);
+		return vet;
+	}
+
+	private List<Vet> persistVetsHolding(Specialty specialty, int count) {
+		return IntStream.range(0, count).mapToObj(ignored -> persistVetHolding(specialty)).toList();
+	}
+
+	private String render(MockHttpServletRequestBuilder request) throws Exception {
+		return mockMvc.perform(request).andExpect(status().isOk()).andReturn().getResponse().getContentAsString();
+	}
+
+	private static List<String> pageLinks(String renderedPage) {
+		return PAGE_LINK.matcher(renderedPage).results().map(link -> link.group(1)).toList();
+	}
+
+	private static String filteredPageLink(int page) {
+		return VET_DIRECTORY + "?" + PAGE_PARAMETER + "=" + page + "&amp;" + SPECIALTY_PARAMETER + "="
+				+ URL_ENCODED_SPECIALTY_WITH_RESERVED_URL_CHARACTERS;
+	}
