+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int HELD_VISIT_ID = 7;
+
+	private static final int UNHELD_VISIT_ID = 8;
+
+	@Test
+	void thePetShouldFindTheVisitItHoldsByIdentity() {
+		Visit heldVisit = createAVisit(HELD_VISIT_ID);
+		Pet pet = createAPetHolding(createAVisitNotYetSaved(), heldVisit);
+
+		Visit found = pet.getVisit(HELD_VISIT_ID);
+
+		assertThat(found).isSameAs(heldVisit);
+	}
+
+	@Test
+	void thePetShouldFindNoVisitForAnIdItDoesNotHold() {
+		Pet pet = createAPetHolding(createAVisitNotYetSaved(), createAVisit(HELD_VISIT_ID));
+
+		Visit found = pet.getVisit(UNHELD_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	private static Pet createAPetHolding(Visit... visits) {
+		Pet pet = new Pet();
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+	private static Visit createAVisit(int id) {
+		Visit visit = createAVisitNotYetSaved();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAVisitNotYetSaved() {
+		return new Visit();
+	}
+
+}
