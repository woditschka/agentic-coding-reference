+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The specialty directory: every specialty the clinic records, each with the
+ * veterinarians holding it. Ties on specialty name are broken by persisted id so the
+ * order is stable across requests.
+ */
+record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<Holder>> holdersBySpecialtyId = holdersBySpecialtyId(vets);
+		List<Entry> entries = specialties.stream()
+			.sorted(SPECIALTY_ORDER)
+			.map(specialty -> new Entry(specialty.getName(),
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	// Keyed by id, not by instance: Specialty has identity equality, and each cached Vet
+	// carries its own Specialty instances.
+	private static Map<Integer, List<Holder>> holdersBySpecialtyId(Collection<Vet> vets) {
+		Map<Integer, List<Holder>> holders = new HashMap<>();
+		vets.stream()
+			.sorted(HOLDER_ORDER)
+			.forEach(vet -> vet.getSpecialties()
+				.forEach(specialty -> holders.computeIfAbsent(specialty.getId(), id -> new ArrayList<>())
+					.add(new Holder(vet.getFirstName(), vet.getLastName()))));
+		return holders;
+	}
+
+	/**
+	 * One specialty, by its stored name, with its holders in last-name, then first-name
+	 * order.
+	 */
+	record Entry(String specialty, List<Holder> holders) {
+
+		Entry {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+	/**
+	 * A veterinarian holding a specialty, by name only.
+	 */
+	record Holder(String firstName, String lastName) {
+
+	}
+
+}
