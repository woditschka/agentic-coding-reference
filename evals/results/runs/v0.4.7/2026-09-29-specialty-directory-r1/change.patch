+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return () -> List.of(createASpecialty(SOME_SPECIALTY_ID, HELD_SPECIALTY),
+					createASpecialty(ANOTHER_SPECIALTY_ID, UNHELD_SPECIALTY));
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new VetRepository() {
+
+				@Override
+				public Collection<Vet> findAll() {
+					return List.of(createAVeterinarian(HOLDER_FIRST_NAME, HOLDER_LAST_NAME,
+							createASpecialty(SOME_SPECIALTY_ID, HELD_SPECIALTY)));
+				}
+
+				@Override
+				public Page<Vet> findAll(Pageable pageable) {
+					throw new UnsupportedOperationException("the specialty directory never pages");
+				}
+
+			};
+		}
+
+	}
+
+}
