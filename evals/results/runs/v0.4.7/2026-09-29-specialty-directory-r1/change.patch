+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Entry;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Holder;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class SpecialtyDirectoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String SOME_SPECIALTY = "some specialty";
+
+	private static final String SOME_FIRST_NAME = "Some";
+
+	private static final String SOME_LAST_NAME = "Vet";
+
+	private static final String EARLIER_FIRST_NAME = "Ashley";
+
+	private static final String LATER_FIRST_NAME = "Linda";
+
+	private static final String EARLIER_LAST_NAME = "Douglas";
+
+	private static final String LATER_LAST_NAME = "Stevens";
+
+	private int lastGeneratedId;
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet holder = createAVeterinarian(SOME_FIRST_NAME, SOME_LAST_NAME, radiology);
+		Vet holdingNothing = createAVeterinarian(SOME_FIRST_NAME, SOME_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(holder, holdingNothing));
+
+		assertThat(directory)
+			.isEqualTo(new SpecialtyDirectory(List.of(new Entry(RADIOLOGY, List.of(holderOf(holder))))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListVeterinarianUnderEachSpecialtyHeld() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet holdingBoth = createAVeterinarian(SOME_FIRST_NAME, SOME_LAST_NAME, radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(holdingBoth));
+
+		assertThat(directory)
+			.isEqualTo(new SpecialtyDirectory(List.of(new Entry(RADIOLOGY, List.of(holderOf(holdingBoth))),
+					new Entry(SURGERY, List.of(holderOf(holdingBoth))))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListSpecialtyHeldByNoVeterinarian() {
+		Specialty unheld = createASpecialty(SOME_SPECIALTY);
+		Vet holdingNothing = createAVeterinarian(SOME_FIRST_NAME, SOME_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(unheld), List.of(holdingNothing));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(List.of(new Entry(SOME_SPECIALTY, List.of()))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesAndHoldersByName() {
+		Specialty surgery = createASpecialty(SURGERY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Vet laterFirstEarlierLast = createAVeterinarian(LATER_FIRST_NAME, EARLIER_LAST_NAME, dentistry);
+		Vet earlierFirstLaterLast = createAVeterinarian(EARLIER_FIRST_NAME, LATER_LAST_NAME, dentistry);
+		Vet earlierFirstEarlierLast = createAVeterinarian(EARLIER_FIRST_NAME, EARLIER_LAST_NAME, dentistry);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry),
+				List.of(earlierFirstLaterLast, laterFirstEarlierLast, earlierFirstEarlierLast));
+
+		assertThat(directory)
+			.isEqualTo(
+					new SpecialtyDirectory(List.of(
+							new Entry(DENTISTRY, List.of(holderOf(earlierFirstEarlierLast),
+									holderOf(laterFirstEarlierLast), holderOf(earlierFirstLaterLast))),
+							new Entry(SURGERY, List.of()))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBreakNameTiesByPersistedId() {
+		Specialty firstRecorded = createASpecialty(SOME_SPECIALTY);
+		Specialty secondRecorded = createASpecialty(SOME_SPECIALTY);
+		Vet holdingFirst = createAVeterinarian(EARLIER_FIRST_NAME, EARLIER_LAST_NAME, firstRecorded);
+		Vet holdingSecond = createAVeterinarian(LATER_FIRST_NAME, LATER_LAST_NAME, secondRecorded);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(secondRecorded, firstRecorded),
+				List.of(holdingFirst, holdingSecond));
+
+		assertThat(directory)
+			.isEqualTo(new SpecialtyDirectory(List.of(new Entry(SOME_SPECIALTY, List.of(holderOf(holdingFirst))),
+					new Entry(SOME_SPECIALTY, List.of(holderOf(holdingSecond))))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPairHoldersWithSpecialtiesByPersistedId() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet holder = createAVeterinarian(SOME_FIRST_NAME, SOME_LAST_NAME, aDetachedCopyOf(radiology));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(holder));
+
+		assertThat(directory)
+			.isEqualTo(new SpecialtyDirectory(List.of(new Entry(RADIOLOGY, List.of(holderOf(holder))))));
+	}
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(++lastGeneratedId);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	// Mirrors production, where each cached Vet carries its own Specialty instances,
+	// distinct from those the specialty repository returns.
+	private static Specialty aDetachedCopyOf(Specialty specialty) {
+		Specialty copy = new Specialty();
+		copy.setId(specialty.getId());
+		copy.setName(specialty.getName());
+		return copy;
+	}
+
+	private Vet createAVeterinarian(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(++lastGeneratedId);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(held).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static Holder holderOf(Vet vet) {
+		return new Holder(vet.getFirstName(), vet.getLastName());
+	}
+
+}
