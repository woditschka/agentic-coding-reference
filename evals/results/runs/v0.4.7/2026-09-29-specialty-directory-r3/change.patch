+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Test vocabulary for veterinarians, specialties, and the specialty directory.
+ */
+final class VetFixtures {
+
+	static final String ANY_FIRST_NAME = "AnyFirstName";
+
+	static final String ANY_LAST_NAME = "AnyLastName";
+
+	static final String ANY_SPECIALTY_NAME = "any specialty";
+
+	// Starts above every id a test pins explicitly, so generated and pinned ids never
+	// collide.
+	private static final AtomicInteger NEXT_ID = new AtomicInteger(1_000);
+
+	private VetFixtures() {
+	}
+
+	static Specialty aSpecialty(String name) {
+		return aSpecialty(NEXT_ID.getAndIncrement(), name);
+	}
+
+	static Specialty aSpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	static Vet aVeterinarian(String firstName, String lastName, Specialty... heldSpecialties) {
+		Vet vet = new Vet();
+		vet.setId(NEXT_ID.getAndIncrement());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty held : heldSpecialties) {
+			// Cached veterinarians carry their own specialty instances, never the ones
+			// the specialty read returns; a copy sharing only the id reproduces that.
+			vet.addSpecialty(aSpecialty(held.getId(), held.getName()));
+		}
+		return vet;
+	}
+
+	static String fullNameOf(Vet vet) {
+		return vet.getFirstName() + " " + vet.getLastName();
+	}
+
+	static SpecialtyDirectory aDirectoryOf(SpecialtyDirectory.Entry... entries) {
+		return new SpecialtyDirectory(List.of(entries));
+	}
+
+	static SpecialtyDirectory.Entry anEntry(String specialtyName, String... veterinarianNames) {
+		return new SpecialtyDirectory.Entry(specialtyName, List.of(veterinarianNames));
+	}
+
+}
