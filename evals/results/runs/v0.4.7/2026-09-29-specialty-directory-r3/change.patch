+
+package org.springframework.samples.petclinic.vet;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.springframework.samples.petclinic.vet.VetFixtures.ANY_FIRST_NAME;
+import static org.springframework.samples.petclinic.vet.VetFixtures.ANY_LAST_NAME;
+import static org.springframework.samples.petclinic.vet.VetFixtures.ANY_SPECIALTY_NAME;
+import static org.springframework.samples.petclinic.vet.VetFixtures.aDirectoryOf;
+import static org.springframework.samples.petclinic.vet.VetFixtures.aSpecialty;
+import static org.springframework.samples.petclinic.vet.VetFixtures.aVeterinarian;
+import static org.springframework.samples.petclinic.vet.VetFixtures.anEntry;
+import static org.springframework.samples.petclinic.vet.VetFixtures.fullNameOf;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.List;
+import java.util.stream.IntStream;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.annotation.Bean;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageImpl;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.web.servlet.MockMvc;
+
+/**
+ * The specialty directory page and its absence from the navigation. The directory's
+ * grouping and ordering rules are specified in {@link SpecialtyDirectoryTests}.
+ */
+@WebMvcTest({ SpecialtyController.class, VetController.class })
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_DIRECTORY_ADDRESS = "/specialties.html";
+
+	private static final String VETERINARIAN_DIRECTORY_ADDRESS = "/vets.html";
+
+	private static final String DIRECTORY_MODEL_ATTRIBUTE = "specialtyDirectory";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private RecordedSpecialties specialties;
+
+	@Autowired
+	private RecordedVeterinarians veterinarians;
+
+	@BeforeEach
+	void startFromAClinicRecordingNothing() {
+		specialties.record();
+		veterinarians.record();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachSpecialtyWithTheVeterinariansHoldingIt() throws Exception {
+		String specialtyName = "radiology";
+		Specialty radiology = aSpecialty(specialtyName);
+		Vet radiologist = aVeterinarian(ANY_FIRST_NAME, ANY_LAST_NAME, radiology);
+		specialties.record(radiology);
+		veterinarians.record(radiologist);
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attribute(DIRECTORY_MODEL_ATTRIBUTE,
+					aDirectoryOf(anEntry(specialtyName, fullNameOf(radiologist)))))
+			.andExpect(content().string(containsString(specialtyName)))
+			.andExpect(content().string(containsString(fullNameOf(radiologist))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() throws Exception {
+		int moreSpecialtiesThanOneVeterinarianDirectoryPageHolds = 6;
+		Specialty[] recorded = IntStream.rangeClosed(1, moreSpecialtiesThanOneVeterinarianDirectoryPageHolds)
+			.mapToObj(ordinal -> aSpecialty(ANY_SPECIALTY_NAME + ordinal))
+			.toArray(Specialty[]::new);
+		specialties.record(recorded);
+		SpecialtyDirectory.Entry[] everySpecialtyWithNoHolder = Arrays.stream(recorded)
+			.map(specialty -> anEntry(specialty.getName()))
+			.toArray(SpecialtyDirectory.Entry[]::new);
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute(DIRECTORY_MODEL_ATTRIBUTE, aDirectoryOf(everySpecialtyWithNoHolder)));
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { SPECIALTY_DIRECTORY_ADDRESS, VETERINARIAN_DIRECTORY_ADDRESS })
+	void theNavigationShouldCarryNoEntryForTheSpecialtyDirectory(String renderedPage) throws Exception {
+		mockMvc.perform(get(renderedPage))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString("href=\"" + SPECIALTY_DIRECTORY_ADDRESS))));
+	}
+
+	@TestConfiguration
+	static class RecordedClinic {
+
+		@Bean
+		RecordedSpecialties specialtyRepository() {
+			return new RecordedSpecialties();
+		}
+
+		@Bean
+		RecordedVeterinarians vetRepository() {
+			return new RecordedVeterinarians();
+		}
+
+	}
+
+	/**
+	 * Hand-written stand-in for the specialty read; each test records what the clinic
+	 * holds.
+	 */
+	static class RecordedSpecialties implements SpecialtyRepository {
+
+		private final List<Specialty> recorded = new ArrayList<>();
+
+		void record(Specialty... specialties) {
+			recorded.clear();
+			recorded.addAll(List.of(specialties));
+		}
+
+		@Override
+		public List<Specialty> findSpecialties() {
+			return List.copyOf(recorded);
+		}
+
+	}
+
+	/**
+	 * Hand-written stand-in for the veterinarian reads; each test records what the clinic
+	 * holds.
+	 */
+	static class RecordedVeterinarians implements VetRepository {
+
+		private final List<Vet> recorded = new ArrayList<>();
+
+		void record(Vet... veterinarians) {
+			recorded.clear();
+			recorded.addAll(List.of(veterinarians));
+		}
+
+		@Override
+		public Collection<Vet> findAll() {
+			return List.copyOf(recorded);
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			return new PageImpl<>(List.copyOf(recorded));
+		}
+
+	}
+
+}
