+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Every specialty the clinic records, each paired with the full names of the
+ * veterinarians holding it. Specialties are ordered by name, then identity; the
+ * veterinarians under each by last name, first name, then identity, so the directory
+ * reads the same on every request.
+ */
+record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> VETERINARIAN_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Builds the directory from every recorded specialty and every veterinarian. A
+	 * holding is matched by specialty identity, never by instance: the veterinarians
+	 * arrive with their own specialty instances.
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+		List<Entry> entries = specialties.stream()
+			.sorted(SPECIALTY_ORDER)
+			.map(specialty -> Entry.of(specialty, holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet vet : veterinarians) {
+			for (Specialty held : vet.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(vet);
+			}
+		}
+		return holders;
+	}
+
+	/**
+	 * One specialty by its stored name and the full names of the veterinarians holding
+	 * it.
+	 */
+	record Entry(String specialtyName, List<String> veterinarianNames) {
+
+		Entry {
+			veterinarianNames = List.copyOf(veterinarianNames);
+		}
+
+		private static Entry of(Specialty specialty, List<Vet> holders) {
+			List<String> names = holders.stream().sorted(VETERINARIAN_ORDER).map(Entry::fullNameOf).toList();
+			return new Entry(specialty.getName(), names);
+		}
+
+		private static String fullNameOf(Vet vet) {
+			return vet.getFirstName() + " " + vet.getLastName();
+		}
+
+	}
+
+}
