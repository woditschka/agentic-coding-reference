+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.samples.petclinic.vet.VetFixtures.ANY_FIRST_NAME;
+import static org.springframework.samples.petclinic.vet.VetFixtures.ANY_LAST_NAME;
+import static org.springframework.samples.petclinic.vet.VetFixtures.ANY_SPECIALTY_NAME;
+import static org.springframework.samples.petclinic.vet.VetFixtures.aDirectoryOf;
+import static org.springframework.samples.petclinic.vet.VetFixtures.aSpecialty;
+import static org.springframework.samples.petclinic.vet.VetFixtures.aVeterinarian;
+import static org.springframework.samples.petclinic.vet.VetFixtures.anEntry;
+import static org.springframework.samples.petclinic.vet.VetFixtures.fullNameOf;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+class SpecialtyDirectoryTests {
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachVeterinarianByFirstThenLastName() {
+		String firstName = "Helen";
+		String lastName = "Leary";
+		Specialty radiology = aSpecialty(ANY_SPECIALTY_NAME);
+		Vet helenLeary = aVeterinarian(firstName, lastName, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary));
+
+		assertThat(directory).isEqualTo(aDirectoryOf(anEntry(ANY_SPECIALTY_NAME, firstName + " " + lastName)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = aSpecialty(ANY_SPECIALTY_NAME);
+		Vet holder = aVeterinarian("Helen", "Leary", radiology);
+		Vet holdingNone = aVeterinarian(ANY_FIRST_NAME, ANY_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(holder, holdingNone));
+
+		assertThat(directory).isEqualTo(aDirectoryOf(anEntry(ANY_SPECIALTY_NAME, fullNameOf(holder))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty radiology = aSpecialty(RADIOLOGY);
+		Specialty surgery = aSpecialty(SURGERY);
+		Vet holderOfBoth = aVeterinarian(ANY_FIRST_NAME, ANY_LAST_NAME, radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(holderOfBoth));
+
+		assertThat(directory).isEqualTo(
+				aDirectoryOf(anEntry(RADIOLOGY, fullNameOf(holderOfBoth)), anEntry(SURGERY, fullNameOf(holderOfBoth))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		Specialty dentistry = aSpecialty(DENTISTRY);
+		Specialty radiology = aSpecialty(RADIOLOGY);
+		Vet radiologist = aVeterinarian(ANY_FIRST_NAME, ANY_LAST_NAME, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, radiology), List.of(radiologist));
+
+		assertThat(directory).isEqualTo(aDirectoryOf(anEntry(DENTISTRY), anEntry(RADIOLOGY, fullNameOf(radiologist))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOpenWithNoSpecialtyWhenTheClinicRecordsNone() {
+		Vet holdingNone = aVeterinarian(ANY_FIRST_NAME, ANY_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(holdingNone));
+
+		assertThat(directory).isEqualTo(aDirectoryOf());
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentItsEntriesInAStableOrder() {
+		int lowerSurgeryId = 1;
+		int higherSurgeryId = 2;
+		Specialty dentistry = aSpecialty(DENTISTRY);
+		Specialty lowerIdSurgery = aSpecialty(lowerSurgeryId, SURGERY);
+		Specialty higherIdSurgery = aSpecialty(higherSurgeryId, SURGERY);
+		Vet rafaelOrtega = aVeterinarian("Rafael", "Ortega", dentistry, higherIdSurgery);
+		Vet lindaDouglas = aVeterinarian("Linda", "Douglas", dentistry);
+		Vet henryDouglas = aVeterinarian("Henry", "Douglas", dentistry, lowerIdSurgery);
+		SpecialtyDirectory expected = aDirectoryOf(
+				anEntry(DENTISTRY, fullNameOf(henryDouglas), fullNameOf(lindaDouglas), fullNameOf(rafaelOrtega)),
+				anEntry(SURGERY, fullNameOf(henryDouglas)), anEntry(SURGERY, fullNameOf(rafaelOrtega)));
+
+		SpecialtyDirectory fromOneReadOrder = SpecialtyDirectory.of(List.of(higherIdSurgery, dentistry, lowerIdSurgery),
+				List.of(rafaelOrtega, lindaDouglas, henryDouglas));
+		SpecialtyDirectory fromAnotherReadOrder = SpecialtyDirectory
+			.of(List.of(lowerIdSurgery, higherIdSurgery, dentistry), List.of(henryDouglas, rafaelOrtega, lindaDouglas));
+
+		assertThat(fromOneReadOrder).isEqualTo(expected);
+		assertThat(fromAnotherReadOrder).isEqualTo(expected);
+	}
+
+}
