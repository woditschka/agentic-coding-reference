+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.Repository;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Read-only repository for {@link Specialty} lookup values. Uncached: the specialty
+ * directory reads every specialty fresh on each request.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve every {@link Specialty}, including those no veterinarian holds.
+	 * @return all specialties in name order, identity breaking ties
+	 */
+	@Transactional(readOnly = true)
+	@Query("SELECT specialty FROM Specialty specialty ORDER BY specialty.name, specialty.id")
+	List<Specialty> findSpecialties();
+
+}
