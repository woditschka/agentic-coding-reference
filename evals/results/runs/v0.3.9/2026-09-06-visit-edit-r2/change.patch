+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Unit tests for {@link Pet}.
+ */
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 10;
+
+	private static final int VISIT_ID_OF_ANOTHER_PET = 99;
+
+	private static final String ANY_DESCRIPTION = "Some description";
+
+	@Test
+	void thePetShouldFindABookedVisitByItsId() {
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetHolding(bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldNotFindAVisitItDoesNotHold() {
+		Pet pet = createAPetHolding(createABookedVisit(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(VISIT_ID_OF_ANOTHER_PET)).isNull();
+	}
+
+	@Test
+	void thePetShouldNotFindAVisitThatIsNotBookedYet() {
+		Pet pet = createAPetHolding(createAnUnbookedVisit());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	private static Visit createABookedVisit(int id) {
+		Visit visit = createAnUnbookedVisit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnbookedVisit() {
+		Visit visit = new Visit();
+		visit.setDescription(ANY_DESCRIPTION);
+		return visit;
+	}
+
+	private static Pet createAPetHolding(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+}
