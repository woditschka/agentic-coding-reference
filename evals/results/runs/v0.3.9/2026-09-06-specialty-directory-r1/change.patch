+
+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.SpecialtyHolders;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the derivation behind the specialty
+ * directory page. Runs without a Spring context.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private final AtomicInteger nextId = new AtomicInteger(1);
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Specialty createACopyOf(Specialty specialty) {
+		Specialty copy = new Specialty();
+		copy.setId(specialty.getId());
+		copy.setName(specialty.getName());
+		return copy;
+	}
+
+	private Vet createAVeterinarian(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId.getAndIncrement());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(held).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private SpecialtyDirectory createADirectoryFrom(List<SpecialtyHolders> listings) {
+		return new SpecialtyDirectory(listings);
+	}
+
+	private List<String> specialtyNamesIn(SpecialtyDirectory directory) {
+		return directory.listings().stream().map(listing -> listing.specialty().getName()).toList();
+	}
+
+	private List<String> holderNamesUnder(SpecialtyDirectory directory, String specialtyName) {
+		return directory.listings()
+			.stream()
+			.filter(listing -> listing.specialty().getName().equals(specialtyName))
+			.flatMap(listing -> listing.holders().stream())
+			.map(holder -> holder.getFirstName() + " " + holder.getLastName())
+			.toList();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyInNameOrder() {
+		Specialty surgery = createASpecialty(SURGERY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Specialty radiology = createASpecialty(RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology), List.of());
+
+		assertThat(specialtyNamesIn(directory)).containsExactly(DENTISTRY, RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderHoldersByLastNameThenFirstName() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", radiology);
+		Vet lindaDouglas = createAVeterinarian("Linda", "Douglas", radiology);
+		Vet adaDouglas = createAVeterinarian("Ada", "Douglas", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(helenLeary, lindaDouglas, adaDouglas));
+
+		assertThat(holderNamesUnder(directory, RADIOLOGY)).containsExactly("Ada Douglas", "Linda Douglas",
+				"Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, radiology), List.of(helenLeary));
+
+		assertThat(specialtyNamesIn(directory)).containsExactly(DENTISTRY, RADIOLOGY);
+		assertThat(holderNamesUnder(directory, DENTISTRY)).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", radiology);
+		Vet jamesCarter = createAVeterinarian("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary, jamesCarter));
+
+		assertThat(holderNamesUnder(directory, RADIOLOGY)).containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldHoldNothingWhenTheClinicKnowsNoSpecialty() {
+		Vet jamesCarter = createAVeterinarian("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(jamesCarter));
+
+		assertThat(directory.listings()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPairASpecialtyWithHoldersReadSeparately() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", createACopyOf(radiology));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary));
+
+		assertThat(holderNamesUnder(directory, RADIOLOGY)).containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRejectChangesToItsListings() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of());
+
+		assertThat(directory.listings()).isUnmodifiable();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldEqualAnotherBuiltFromTheSameReads() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", radiology);
+		List<SpecialtyHolders> listings = SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary)).listings();
+
+		SpecialtyDirectory sameDirectory = SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary));
+
+		assertThat(sameDirectory).isEqualTo(createADirectoryFrom(listings));
+	}
+
+}
