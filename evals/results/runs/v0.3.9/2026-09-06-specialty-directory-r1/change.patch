+	}
+
+	private void givenTheClinicKnows(List<Specialty> knownSpecialties, List<Vet> employedVeterinarians) {
+		given(this.specialties.findSpecialties()).willReturn(knownSpecialties);
+		given(this.vets.findAll()).willReturn(employedVeterinarians);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() throws Exception {
+		Specialty surgery = createASpecialty(SURGERY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		givenTheClinicKnows(List.of(dentistry, radiology, surgery), List.of());
+
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attributeExists("specialtyDirectory"))
+			.andExpect(content().string(stringContainsInOrder(DENTISTRY, RADIOLOGY, SURGERY)))
+			.andExpect(content().string(not(containsString("specialties.html?page="))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowHoldingVeterinariansByFullName() throws Exception {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", radiology);
+		givenTheClinicKnows(List.of(radiology), List.of(helenLeary));
+
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() throws Exception {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", radiology);
+		Vet jamesCarter = createAVeterinarian("James", "Carter");
+		givenTheClinicKnows(List.of(radiology), List.of(helenLeary, jamesCarter));
+
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("Helen Leary")))
+			.andExpect(content().string(not(containsString("James Carter"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() throws Exception {
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", radiology);
+		givenTheClinicKnows(List.of(dentistry, radiology), List.of(helenLeary));
+
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(DENTISTRY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderWhenNoSpecialtyExists() throws Exception {
+		Vet jamesCarter = createAVeterinarian("James", "Carter");
+		givenTheClinicKnows(List.of(), List.of(jamesCarter));
+
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(content().string(containsString("Specialties")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheSiteNavigationWithoutAnEntryOfItsOwn() throws Exception {
+		givenTheClinicKnows(List.of(createASpecialty(RADIOLOGY)), List.of());
+
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("/vets.html")))
+			.andExpect(content().string(not(containsString("/specialties.html"))));
+	}
+
+}
