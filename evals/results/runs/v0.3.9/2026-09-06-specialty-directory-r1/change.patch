+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * The clinic's published listing of every {@link Specialty}, each shown with the
+ * {@link Vet}s who hold it.
+ * <p>
+ * A specialty no veterinarian holds is listed with no holder; a veterinarian holding no
+ * specialty appears nowhere. {@link Vet} owns the only mapping of the holding
+ * relationship, so the directory is paired in memory from two independent reads rather
+ * than by giving {@link Specialty} an inverse association.
+ */
+public record SpecialtyDirectory(List<SpecialtyHolders> listings) {
+
+	private static final Comparator<Specialty> BY_SPECIALTY_NAME = Comparator.comparing(NamedEntity::getName);
+
+	private static final Comparator<Vet> BY_VETERINARIAN_NAME = Comparator.<Vet, String>comparing(Person::getLastName)
+		.thenComparing(Person::getFirstName);
+
+	public SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	/**
+	 * Pair each specialty with the veterinarians holding it.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians every veterinarian the clinic employs
+	 * @return the directory, specialties in name order and holders in last-name then
+	 * first-name order
+	 */
+	public static SpecialtyDirectory of(Iterable<Specialty> specialties, Iterable<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+		List<SpecialtyHolders> listings = new ArrayList<>();
+		for (Specialty specialty : sorted(specialties, BY_SPECIALTY_NAME)) {
+			List<Vet> holders = holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of());
+			listings.add(new SpecialtyHolders(specialty, sorted(holders, BY_VETERINARIAN_NAME)));
+		}
+		return new SpecialtyDirectory(listings);
+	}
+
+	/**
+	 * A specialty read separately from the veterinarians holding it arrives as a distinct
+	 * instance, so the two sides are paired by specialty identity rather than by
+	 * instance.
+	 */
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Iterable<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holdersBySpecialtyId;
+	}
+
+	private static <T> List<T> sorted(Iterable<T> values, Comparator<T> order) {
+		List<T> sorted = new ArrayList<>();
+		values.forEach(sorted::add);
+		sorted.sort(order);
+		return List.copyOf(sorted);
+	}
+
+	/**
+	 * One specialty with the veterinarians holding it, in a stable order.
+	 *
+	 * @param specialty the specialty being listed
+	 * @param holders the veterinarians holding it, possibly none
+	 */
+	public record SpecialtyHolders(Specialty specialty, List<Vet> holders) {
+
+		public SpecialtyHolders {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+}
