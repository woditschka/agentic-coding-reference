+
+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.springframework.samples.petclinic.vet.VetTestData.createASpecialty;
+import static org.springframework.samples.petclinic.vet.VetTestData.createAVet;
+
+/**
+ * Test class for {@link SpecialtyHolders}, the specialty-to-holders derivation behind the
+ * specialty page.
+ */
+class SpecialtyHoldersTests {
+
+	@Test
+	void theDirectoryShouldPlaceEachVeterinarianUnderTheSpecialtyTheyHold() {
+		Specialty radiology = createASpecialty("radiology");
+		Vet helen = createAVet("Helen", "Leary", radiology);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directoryOf(List.of(radiology), List.of(helen));
+
+		assertThat(directory).singleElement().satisfies(entry -> {
+			assertThat(entry.specialty()).isEqualTo(radiology);
+			assertThat(entry.holders()).containsExactly(helen);
+		});
+	}
+
+	@Test
+	void theDirectoryShouldListASpecialtyNoVeterinarianHoldsWithNoHolders() {
+		Specialty dentistry = createASpecialty("dentistry");
+		Vet unrelated = createAVet("James", "Carter", createASpecialty("radiology"));
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directoryOf(List.of(dentistry), List.of(unrelated));
+
+		assertThat(directory).singleElement().satisfies(entry -> {
+			assertThat(entry.specialty()).isEqualTo(dentistry);
+			assertThat(entry.holders()).isEmpty();
+		});
+	}
+
+	@Test
+	void theDirectoryShouldLeaveOutAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty("radiology");
+		Vet helen = createAVet("Helen", "Leary", radiology);
+		Vet holdsNothing = createAVet("James", "Carter");
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directoryOf(List.of(radiology),
+				List.of(helen, holdsNothing));
+
+		assertThat(directory).flatExtracting(SpecialtyHolders::holders).containsExactly(helen);
+	}
+
+	@Test
+	void theDirectoryShouldRepeatAVeterinarianUnderEverySpecialtyTheyHold() {
+		Specialty radiology = createASpecialty("radiology");
+		Specialty surgery = createASpecialty("surgery");
+		Vet linda = createAVet("Linda", "Douglas", radiology, surgery);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directoryOf(List.of(radiology, surgery), List.of(linda));
+
+		assertThat(directory).extracting(SpecialtyHolders::holders).containsExactly(List.of(linda), List.of(linda));
+	}
+
+	@Test
+	void theDirectoryShouldKeepTheSpecialtyOrderItWasGiven() {
+		Specialty dentistry = createASpecialty("dentistry");
+		Specialty radiology = createASpecialty("radiology");
+		Specialty surgery = createASpecialty("surgery");
+		Vet anyVet = createAVet("Helen", "Leary", radiology);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directoryOf(List.of(dentistry, radiology, surgery),
+				List.of(anyVet));
+
+		assertThat(directory).extracting(entry -> entry.specialty().getName())
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theDirectoryShouldOrderHoldersByLastNameThenFirstName() {
+		Specialty surgery = createASpecialty("surgery");
+		Vet rafaelOrtega = createAVet("Rafael", "Ortega", surgery);
+		Vet lindaDouglas = createAVet("Linda", "Douglas", surgery);
+		Vet aliceDouglas = createAVet("Alice", "Douglas", surgery);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directoryOf(List.of(surgery),
+				List.of(rafaelOrtega, lindaDouglas, aliceDouglas));
+
+		assertThat(directory.get(0).holders()).containsExactly(aliceDouglas, lindaDouglas, rafaelOrtega);
+	}
+
+	@Test
+	void theDirectoryShouldRefuseChangesToTheHoldersItPublishes() {
+		Specialty radiology = createASpecialty("radiology");
+		Vet helen = createAVet("Helen", "Leary", radiology);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directoryOf(List.of(radiology), List.of(helen));
+
+		assertThatThrownBy(() -> directory.get(0).holders().add(createAVet("James", "Carter")))
+			.isInstanceOf(UnsupportedOperationException.class);
+	}
+
+	@Test
+	void theDirectoryShouldBeEmptyWhenTheClinicKnowsNoSpecialty() {
+		Vet anyVet = createAVet("James", "Carter");
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directoryOf(List.of(), List.of(anyVet));
+
+		assertThat(directory).isEmpty();
+	}
+
+	@Test
+	void theDirectoryShouldRefuseASpecialtyThatWasNeverStored() {
+		Specialty neverStored = VetTestData.createAnUnstoredSpecialty("radiology");
+
+		assertThatThrownBy(() -> SpecialtyHolders.directoryOf(List.of(neverStored), List.of()))
+			.isInstanceOf(IllegalArgumentException.class)
+			.hasMessageContaining("radiology");
+	}
+
+	// Two specialties can be stored under one name, and NamedEntity carries no value
+	// equality, so holders must be matched by stored identity rather than by name.
+	@Test
+	void theDirectoryShouldTellApartTwoSpecialtiesStoredUnderTheSameName() {
+		Specialty oneSurgery = createASpecialty("surgery");
+		Specialty anotherSurgery = createASpecialty("surgery");
+		Vet helen = createAVet("Helen", "Leary", oneSurgery);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directoryOf(List.of(oneSurgery, anotherSurgery),
+				List.of(helen));
+
+		assertThat(directory).extracting(SpecialtyHolders::specialty).containsExactly(oneSurgery, anotherSurgery);
+		assertThat(directory.get(0).holders()).containsExactly(helen);
+		assertThat(directory.get(1).holders()).isEmpty();
+	}
+
+}
