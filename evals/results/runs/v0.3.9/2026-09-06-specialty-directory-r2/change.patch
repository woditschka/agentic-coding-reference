+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * One {@link Specialty} together with the {@link Vet}s holding it, as the specialty page
+ * presents it.
+ * <p>
+ * The pairing is a value: the holder list is copied at construction and published
+ * unmodifiable, so nothing can reach back into the derivation through it.
+ */
+public record SpecialtyHolders(Specialty specialty, List<Vet> holders) {
+
+	private static final Comparator<String> STORED_NAME_ORDER = Comparator.nullsLast(Comparator.naturalOrder());
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator
+		.<Vet, String>comparing(Person::getLastName, STORED_NAME_ORDER)
+		.thenComparing(Person::getFirstName, STORED_NAME_ORDER);
+
+	public SpecialtyHolders {
+		Objects.requireNonNull(specialty, "specialty");
+		holders = List.copyOf(holders);
+	}
+
+	/**
+	 * Pair every given specialty with the veterinarians holding it, keeping the order the
+	 * specialties were given in.
+	 * <p>
+	 * A specialty no veterinarian holds keeps an empty holder list rather than dropping
+	 * out, and a veterinarian holding no specialty appears nowhere: the result lists
+	 * specialties, not the veterinarian roster. A veterinarian holding several
+	 * specialties appears under each of them.
+	 * @param specialties the specialties to list, in the order they should be presented
+	 * @param veterinarians the veterinarians to draw holders from
+	 * @return one entry per given specialty, holders ordered by last name then first name
+	 * @throws IllegalArgumentException if a specialty has no stored id, since holders are
+	 * matched by stored identity
+	 */
+	public static List<SpecialtyHolders> directoryOf(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersById = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holdersById.computeIfAbsent(storedIdOf(held), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+
+		List<SpecialtyHolders> directory = new ArrayList<>(specialties.size());
+		for (Specialty specialty : specialties) {
+			List<Vet> holders = new ArrayList<>(holdersById.getOrDefault(storedIdOf(specialty), List.of()));
+			holders.sort(BY_LAST_THEN_FIRST_NAME);
+			directory.add(new SpecialtyHolders(specialty, holders));
+		}
+		return List.copyOf(directory);
+	}
+
+	/**
+	 * Two specialties may be stored under one name and {@code Specialty} carries no value
+	 * equality, so the stored id is the only sound way to match a holder to a specialty.
+	 */
+	private static Integer storedIdOf(Specialty specialty) {
+		Integer id = specialty.getId();
+		if (id == null) {
+			throw new IllegalArgumentException("Cannot build the specialty directory: specialty \""
+					+ specialty.getName() + "\" has not been stored, so it has no id to match veterinarians against");
+		}
+		return id;
+	}
+
+}
