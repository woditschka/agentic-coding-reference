+/**
+ * Test class for the {@link SpecialtyController}.
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_PAGE = "/specialties.html";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@MockitoBean
+	private SpecialtyRepository specialties;
+
+	@MockitoBean
+	private VetRepository vets;
+
+	private final Specialty dentistry = createASpecialty("dentistry");
+
+	private final Specialty radiology = createASpecialty("radiology");
+
+	private final Specialty surgery = createASpecialty("surgery");
+
+	private final Vet helenLeary = createAVet("Helen", "Leary", radiology);
+
+	private final Vet lindaDouglas = createAVet("Linda", "Douglas", radiology, surgery);
+
+	private final Vet jamesCarterWhoHoldsNoSpecialty = createAVet("James", "Carter");
+
+	@BeforeEach
+	void setup() {
+		// dentistry is the specialty nobody holds; James Carter is the veterinarian who
+		// holds nothing.
+		given(this.specialties.findSpecialties()).willReturn(List.of(dentistry, radiology, surgery));
+		given(this.vets.findAll()).willReturn(List.of(helenLeary, lindaDouglas, jamesCarterWhoHoldsNoSpecialty));
+	}
+
+	@Test
+	void theSpecialtyPageShouldListEverySpecialtyWithItsVeterinarians() throws Exception {
+		String page = renderSpecialtyPage();
+
+		assertThat(page).containsSubsequence("dentistry", "radiology", "Linda Douglas", "Helen Leary", "surgery",
+				"Linda Douglas");
+	}
+
+	@Test
+	void theSpecialtyPageShouldShowEachVeterinarianByFullName() throws Exception {
+		String page = renderSpecialtyPage();
+
+		assertThat(page).contains("Helen Leary").contains("Linda Douglas");
+	}
+
+	@Test
+	void theSpecialtyPageShouldListASpecialtyNoVeterinarianHolds() throws Exception {
+		String page = renderSpecialtyPage();
+
+		assertThat(page).containsSubsequence("dentistry", "none", "radiology");
+	}
+
+	@Test
+	void theSpecialtyPageShouldOmitAVeterinarianWithNoSpecialty() throws Exception {
+		String page = renderSpecialtyPage();
+
+		assertThat(page).doesNotContain("Carter");
+	}
+
+	@Test
+	void theSpecialtyPageShouldCarryTheUsualNavigationWithoutAnEntryOfItsOwn() throws Exception {
+		String page = renderSpecialtyPage();
+
+		assertThat(page).contains("/vets.html").doesNotContain(SPECIALTY_PAGE);
+	}
+
+	@Test
+	void theSpecialtyPageShouldRenderAStoredNameAsTextRatherThanMarkup() throws Exception {
+		Specialty nameCarryingMarkup = createASpecialty("<script>alert(1)</script>");
+		given(this.specialties.findSpecialties()).willReturn(List.of(nameCarryingMarkup));
+
+		String page = renderSpecialtyPage();
+
+		assertThat(page).doesNotContain("<script>alert(1)</script>").contains("&lt;script&gt;");
+	}
+
+	private String renderSpecialtyPage() throws Exception {
+		return mockMvc.perform(get(SPECIALTY_PAGE))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andReturn()
