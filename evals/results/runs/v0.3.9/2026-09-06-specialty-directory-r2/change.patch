+ */
+
+package org.springframework.samples.petclinic.vet;
+
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Factories for the veterinarian-directory test data. Ids are generated so that two
+ * specialties built in the same test are distinct entities without the test having to say
+ * so.
+ */
+final class VetTestData {
+
+	private static final AtomicInteger NEXT_ID = new AtomicInteger(1);
+
+	private VetTestData() {
+	}
+
+	static Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(NEXT_ID.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	/** A specialty that has never reached the data store, so it carries no id. */
+	static Specialty createAnUnstoredSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return specialty;
+	}
+
+	static Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(NEXT_ID.getAndIncrement());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
