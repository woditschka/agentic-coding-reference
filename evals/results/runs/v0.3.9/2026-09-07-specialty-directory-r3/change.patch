+		assertThat(page).contains("radiology", "surgery", "dentistry");
+	}
+
+	@Test
+	void theSpecialtyViewShouldListEachSpecialtysVeterinariansByFullName() throws Exception {
+		String page = renderSpecialtyView();
+
+		assertThat(page).contains("Helen Leary", "Linda Douglas");
+	}
+
+	@Test
+	void theSpecialtyViewShouldOmitAVeterinarianHoldingNoSpecialty() throws Exception {
+		String page = renderSpecialtyView();
+
+		assertThat(page).doesNotContain("James", "Carter");
+	}
+
+	@Test
+	void theSpecialtyViewShouldListASpecialtyNoVeterinarianHolds() throws Exception {
+		String page = renderSpecialtyView();
+
+		assertThat(page).containsSubsequence("dentistry", "none");
+	}
+
+	@Test
+	void theSpecialtyViewShouldRenderEverySpecialtyOnOnePage() throws Exception {
+		List<Specialty> everySpecialty = aRunOfSpecialties(MORE_THAN_ONE_SCREEN);
+		given(this.specialties.findSpecialties()).willReturn(everySpecialty);
+
+		String page = renderSpecialtyView();
+
+		// "?page=" is how the paginated veterinarian view links its further screens.
+		assertThat(page).contains(namesOf(everySpecialty)).doesNotContain("?page=");
+	}
+
+	@Test
+	void theSpecialtyViewShouldCarryTheStandardNavigationWithNoEntryMarkedActive() throws Exception {
+		String page = renderSpecialtyView();
+
+		assertThat(page).contains("navbar", "/owners/find", "/vets.html").doesNotContain("nav-link active");
+	}
+
+	@Test
+	void noOtherPageShouldCarryALinkToTheSpecialtyView() throws IOException {
+		try (Stream<Path> templates = Files.walk(TEMPLATES)) {
+			List<Path> linkingPages = templates.filter(Files::isRegularFile)
+				.filter(SpecialtyControllerTests::mentionsTheSpecialtyView)
+				.toList();
+
+			assertThat(linkingPages).isEmpty();
+		}
+	}
+
+}
