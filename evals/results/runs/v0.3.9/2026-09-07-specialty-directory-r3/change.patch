+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.assertj.core.api.Assertions.tuple;
+
+/**
+ * Test class for {@link SpecialtyHolders}, the read model behind the specialty view.
+ */
+class SpecialtyHoldersTests {
+
+	private static final int IRRELEVANT_ID = 99;
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet vet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private static SpecialtyHolders aSpecialtyHolding(Specialty specialty, List<Vet> veterinarians) {
+		return new SpecialtyHolders(specialty, veterinarians);
+	}
+
+	@Test
+	void theSpecialtyListingShouldPairASpecialtyWithHoldersReachedThroughADifferentInstance() {
+		Specialty radiologyFromSpecialtyRead = specialty(1, "radiology");
+		Specialty radiologyFromVetRead = specialty(1, "radiology");
+		Vet helen = vet(2, "Helen", "Leary", radiologyFromVetRead);
+
+		List<SpecialtyHolders> listing = SpecialtyHolders.assemble(List.of(radiologyFromSpecialtyRead), List.of(helen));
+
+		assertThat(listing).singleElement()
+			.satisfies(holding -> assertThat(holding.veterinarians()).containsExactly(helen));
+	}
+
+	@Test
+	void theSpecialtyListingShouldLeaveASpecialtyNoVeterinarianHoldsWithoutHolders() {
+		Specialty radiology = specialty(1, "radiology");
+		Specialty surgery = specialty(2, "surgery");
+		Vet helen = vet(3, "Helen", "Leary", specialty(1, "radiology"));
+
+		List<SpecialtyHolders> listing = SpecialtyHolders.assemble(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(listing).extracting(holding -> holding.specialty().getName(), SpecialtyHolders::veterinarians)
+			.containsExactly(tuple("radiology", List.of(helen)), tuple("surgery", List.of()));
+	}
+
+	@Test
+	void theSpecialtyListingShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet james = vet(2, "James", "Carter");
+
+		List<SpecialtyHolders> listing = SpecialtyHolders.assemble(List.of(radiology), List.of(james));
+
+		assertThat(listing).flatExtracting(SpecialtyHolders::veterinarians).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyListingShouldOrderSpecialtiesByName() {
+		Specialty surgery = specialty(1, "surgery");
+		Specialty dentistry = specialty(2, "dentistry");
+		Specialty radiology = specialty(3, "radiology");
+
+		List<SpecialtyHolders> listing = SpecialtyHolders.assemble(List.of(surgery, dentistry, radiology), List.of());
+
+		assertThat(listing).extracting(holding -> holding.specialty().getName())
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyListingShouldOrderVeterinariansByLastNameThenFirstName() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet helenLeary = vet(2, "Helen", "Leary", specialty(1, "radiology"));
+		Vet jamesCarter = vet(3, "James", "Carter", specialty(1, "radiology"));
+		Vet adaCarter = vet(4, "Ada", "Carter", specialty(1, "radiology"));
+
+		List<SpecialtyHolders> listing = SpecialtyHolders.assemble(List.of(radiology),
+				List.of(helenLeary, jamesCarter, adaCarter));
+
+		assertThat(listing).singleElement()
+			.satisfies(
+					holding -> assertThat(holding.veterinarians()).containsExactly(adaCarter, jamesCarter, helenLeary));
+	}
+
+	@Test
+	void theSpecialtyListingShouldOrderNamesakeVeterinariansByIdentifier() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet theLaterHelen = vet(9, "Helen", "Leary", specialty(1, "radiology"));
+		Vet theEarlierHelen = vet(4, "Helen", "Leary", specialty(1, "radiology"));
+
+		List<SpecialtyHolders> listing = SpecialtyHolders.assemble(List.of(radiology),
+				List.of(theLaterHelen, theEarlierHelen));
+
+		assertThat(listing).singleElement()
+			.satisfies(holding -> assertThat(holding.veterinarians()).containsExactly(theEarlierHelen, theLaterHelen));
+	}
+
+	@Test
+	void theSpecialtyHoldingShouldRefuseMutationOfItsVeterinarians() {
+		SpecialtyHolders holding = aSpecialtyHolding(specialty(IRRELEVANT_ID, "radiology"), List.of());
+
+		assertThatThrownBy(() -> holding.veterinarians().add(vet(IRRELEVANT_ID, "Helen", "Leary")))
+			.isInstanceOf(UnsupportedOperationException.class);
+	}
+
+}
