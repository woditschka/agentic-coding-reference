+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * Read model pairing one {@link Specialty} with the {@link Vet}s holding it. The whole
+ * listing behind the specialty view is assembled by {@link #assemble}.
+ *
+ * @param specialty the specialty being held
+ * @param veterinarians its holders, ordered by last name, then first name, then
+ * identifier
+ */
+public record SpecialtyHolders(Specialty specialty, List<Vet> veterinarians) {
+
+	private static final Comparator<Specialty> BY_NAME = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> BY_FULL_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyHolders {
+		Objects.requireNonNull(specialty, "specialty");
+		veterinarians = List.copyOf(veterinarians);
+	}
+
+	/**
+	 * Assemble the specialty listing from two independent reads.
+	 * <p>
+	 * The two reads return distinct {@link Specialty} instances for the same row — the
+	 * veterinarian read is cached and each read runs in its own transaction — and the
+	 * persisted types inherit identity equality, so holders are matched by identifier
+	 * rather than by object equality. A veterinarian holding no listed specialty
+	 * contributes to no entry: the listing is of specialties, not of veterinarians.
+	 * @param specialties every specialty to list
+	 * @param veterinarians the veterinarians to distribute across them
+	 * @return one entry per specialty, ordered by specialty name
+	 */
+	public static List<SpecialtyHolders> assemble(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Specialty specialty : specialties) {
+			holdersBySpecialtyId.put(specialty.getId(), new ArrayList<>());
+		}
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				List<Vet> holders = holdersBySpecialtyId.get(held.getId());
+				if (holders != null) {
+					holders.add(veterinarian);
+				}
+			}
+		}
+		return specialties.stream().sorted(BY_NAME).map(specialty -> {
+			List<Vet> holders = new ArrayList<>(holdersBySpecialtyId.get(specialty.getId()));
+			holders.sort(BY_FULL_NAME);
+			return new SpecialtyHolders(specialty, holders);
+		}).toList();
+	}
+
+}
