+	@GetMapping("/specialties.html")
+	public String showSpecialtyList(Model model) {
+		// SpecialtyRepository is the authoritative specialty list, so a
+		// specialty held by no vet is still enumerated. The Vet->Specialty
+		// association is unidirectional, so the vets holding each specialty
+		// are derived by inverting the vet read in-memory.
+		Collection<Vet> vets = this.vetRepository.findAll();
+
+		// Group vets by specialty id, never by object reference: BaseEntity
+		// overrides neither equals nor hashCode, and the two reads need not
+		// return the same Specialty instances, so reference keying would
+		// silently drop veterinarians.
+		Map<Integer, List<Vet>> vetsBySpecialtyId = new HashMap<>();
+		for (Vet vet : vets) {
+			for (Specialty specialty : vet.getSpecialties()) {
+				vetsBySpecialtyId.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(vet);
+			}
+		}
+
+		Comparator<Vet> byFullName = Comparator.comparing(Vet::getLastName).thenComparing(Vet::getFirstName);
+		Map<Specialty, List<Vet>> directory = new LinkedHashMap<>();
+		for (Specialty specialty : this.specialtyRepository.findAll()) {
+			List<Vet> holders = new ArrayList<>(vetsBySpecialtyId.getOrDefault(specialty.getId(), List.of()));
+			holders.sort(byFullName);
+			directory.put(specialty, holders);
+		}
+
+		model.addAttribute("specialties", directory);
+		return "vets/specialtyList";
+	}
+
