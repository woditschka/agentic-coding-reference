+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.Map;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.context.WebApplicationContext;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Integration test for the specialty directory page, exercising {@link VetController}
+ * against the real {@link SpecialtyRepository} and {@link VetRepository} backed by the
+ * seeded H2 database rather than framework stubs. Covers the specialty-directory
+ * behaviors that the seed data can express; the unheld-specialty, empty-directory, and
+ * distinct-instance grouping behaviors, which the seed cannot produce, remain focused
+ * controller tests in {@link VetControllerTests}.
+ */
+@SpringBootTest
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyDirectoryIntegrationTests {
+
+	@Autowired
+	private WebApplicationContext context;
+
+	private MockMvc mockMvc;
+
+	@BeforeEach
+	void setup() {
+		this.mockMvc = MockMvcBuilders.webAppContextSetup(this.context).build();
+	}
+
+	@SuppressWarnings("unchecked")
+	private Map<Specialty, List<Vet>> directoryModel(MvcResult result) {
+		return (Map<Specialty, List<Vet>>) result.getModelAndView().getModel().get("specialties");
+	}
+
+	private List<Vet> vetsHolding(Map<Specialty, List<Vet>> directory, String specialtyName) {
+		return directory.entrySet()
+			.stream()
+			.filter(entry -> entry.getKey().getName().equals(specialtyName))
+			.map(Map.Entry::getValue)
+			.findFirst()
+			.orElseThrow(() -> new AssertionError("specialty not in directory: " + specialtyName));
+	}
+
+	@Test
+	void theSpecialtyListShouldRespondOkWithSpecialtiesModel() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(model().attributeExists("specialties"))
+			.andExpect(view().name("vets/specialtyList"));
+	}
+
+	@Test
+	void theSpecialtyListShouldContainEveryStoredSpecialtyOnOnePage() throws Exception {
+		MvcResult result = mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(model().attributeDoesNotExist("totalPages", "currentPage"))
+			.andReturn();
+
+		Map<Specialty, List<Vet>> directory = directoryModel(result);
+		assertThat(directory.keySet()).extracting(Specialty::getName)
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyListShouldShowVetsByFirstNameThenLastName() throws Exception {
+		MvcResult result = mockMvc.perform(get("/specialties.html")).andExpect(status().isOk()).andReturn();
+
+		assertThat(result.getResponse().getContentAsString()).contains("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyListShouldOmitVetsHoldingNoSpecialty() throws Exception {
+		MvcResult result = mockMvc.perform(get("/specialties.html")).andExpect(status().isOk()).andReturn();
+
+		// James Carter and Sharon Jenkins are seed-data vets with no specialty.
+		String[] vetsWithoutSpecialty = { "James Carter", "Sharon Jenkins" };
+		assertThat(result.getResponse().getContentAsString()).doesNotContain(vetsWithoutSpecialty);
+
+		Map<Specialty, List<Vet>> directory = directoryModel(result);
+		assertThat(directory.values().stream().flatMap(List::stream))
+			.noneMatch(vet -> "James".equals(vet.getFirstName()));
+	}
+
+}
