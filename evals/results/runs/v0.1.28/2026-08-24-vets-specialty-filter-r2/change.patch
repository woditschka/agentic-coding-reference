+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Collection;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.data.domain.Pageable;
+
+/**
+ * Integration tests for the specialty match contract on {@link VetRepository}, exercising
+ * the real Spring Data derived query against the seeded H2 database.
+ */
+@DataJpaTest
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VetRepositoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	@Autowired
+	private VetRepository vets;
+
+	@Test
+	void theSpecialtyFilterShouldMatchTheWholeNameCaseInsensitively() {
+		Collection<Vet> matches = this.vets.findDistinctBySpecialties_NameIgnoreCase("RaDiOlOgY");
+
+		assertThat(matches).extracting(Vet::getLastName).containsExactlyInAnyOrder("Leary", "Stevens");
+	}
+
+	@Test
+	void theSpecialtyFilterShouldNotMatchAPrefix() {
+		Collection<Vet> matches = this.vets.findDistinctBySpecialties_NameIgnoreCase("radio");
+
+		assertThat(matches).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyFilterShouldReturnEachMatchingVetOnce() {
+		Collection<Vet> matches = this.vets.findDistinctBySpecialties_NameIgnoreCase(RADIOLOGY);
+
+		assertThat(matches).extracting(Vet::getLastName).doesNotHaveDuplicates();
+	}
+
+	@Test
+	void theSpecialtyFilterShouldReturnNoVetsForAnUnheldSpecialty() {
+		Collection<Vet> matches = this.vets.findDistinctBySpecialties_NameIgnoreCase("cardiology");
+
+		assertThat(matches).isEmpty();
+	}
+
+	@Test
+	void thePagedSpecialtyFilterShouldPageTheFilteredVetsAtTheDatabase() {
+		Pageable firstPageOfOne = PageRequest.of(0, 1);
+
+		Page<Vet> firstPage = this.vets.findDistinctBySpecialties_NameIgnoreCase(RADIOLOGY, firstPageOfOne);
+
+		assertThat(firstPage.getTotalElements()).isEqualTo(2);
+		assertThat(firstPage.getTotalPages()).isEqualTo(2);
+		assertThat(firstPage.getContent()).hasSize(1);
+	}
+
+}
