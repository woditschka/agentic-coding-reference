+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Collection;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+
+/**
+ * Persistence-layer test pinning the case-insensitive whole-name equality semantics of
+ * {@link VetRepository#findBySpecialtiesNameIgnoreCase} against real H2. The seed data
+ * assigns the {@code radiology} specialty to Helen Leary; these tests prove the derived
+ * query encodes equality (not a prefix match) and that H2 folds letter case, the two
+ * guarantees central to REQ-VET-003's contract.
+ */
+@DataJpaTest
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VetRepositoryTests {
+
+	@Autowired
+	private VetRepository vets;
+
+	private final Pageable pageable = Pageable.unpaged();
+
+	@Test
+	void theWholeSpecialtyNameInMixedCaseShouldMatchTheHoldingVetOnThePagedOverload() {
+		Page<Vet> matches = this.vets.findBySpecialtiesNameIgnoreCase("Radiology", pageable);
+
+		assertThat(matches).extracting(Vet::getLastName).contains("Leary");
+	}
+
+	@Test
+	void aSpecialtyPrefixShouldMatchNoVetOnThePagedOverload() {
+		Page<Vet> matches = this.vets.findBySpecialtiesNameIgnoreCase("rad", pageable);
+
+		assertThat(matches).isEmpty();
+	}
+
+	@Test
+	void theWholeSpecialtyNameInMixedCaseShouldMatchTheHoldingVetOnTheCollectionOverload() {
+		Collection<Vet> matches = this.vets.findBySpecialtiesNameIgnoreCase("Radiology");
+
+		assertThat(matches).extracting(Vet::getLastName).contains("Leary");
+	}
+
+	@Test
+	void aSpecialtyPrefixShouldMatchNoVetOnTheCollectionOverload() {
+		Collection<Vet> matches = this.vets.findBySpecialtiesNameIgnoreCase("rad");
+
+		assertThat(matches).isEmpty();
+	}
+
+}
