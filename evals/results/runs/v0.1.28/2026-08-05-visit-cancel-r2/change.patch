+		assertThat(response.getStatusCode().is3xxRedirection()).isTrue();
+
+		Owner reloaded = owners.findById(1).orElseThrow();
+		Pet reloadedPet = reloaded.getPet(petId);
+		assertThat(reloadedPet.getVisits()).hasSize(visitCountBeforeCancel - 1);
+		assertThat(reloadedPet.getVisits()).noneMatch(visit -> visit.getId().equals(visitId));
+		assertThat(reloadedPet.getVisits()).noneMatch(visit -> visit.getDate() == null);
