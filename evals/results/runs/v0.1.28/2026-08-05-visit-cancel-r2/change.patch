+		Integer petId = pet.getId();
+		int visitCountBeforeCancel = pet.getVisits().size() + 1;
+		Set<Integer> visitIdsBeforeSeed = pet.getVisits().stream().map(Visit::getId).collect(Collectors.toSet());
+
+		Visit upcoming = new Visit();
+		upcoming.setDate(LocalDate.now().plusDays(7));
+		upcoming.setDescription("vaccination");
