+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatIllegalArgumentException;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Tests for the {@link Owner} aggregate, focused on cancelling a visit through the
+ * aggregate root. These use real domain objects (no mocks) so the removal is exercised at
+ * the aggregate level, where the past-visit and unrelated-pet integrity checks live.
+ */
+class OwnerTests {
+
+	private static final int PET_ID = 1;
+
+	private static final int UNRELATED_PET_ID = 99;
+
+	private static final int SOME_UPCOMING_VISIT_ID = 10;
+
+	private static final int SOME_PAST_VISIT_ID = 20;
+
+	private static final int ANY_NONEXISTENT_VISIT_ID = 999;
+
+	private Owner ownerWithPet() {
+		Owner owner = new Owner();
+		Pet pet = new Pet();
+		owner.addPet(pet);
+		pet.setId(PET_ID);
+		return owner;
+	}
+
+	private Visit visitOn(LocalDate date, int id) {
+		Visit visit = new Visit();
+		visit.setDate(date);
+		visit.setDescription("checkup");
+		visit.setId(id);
+		return visit;
+	}
+
+	@Test
+	void cancellingUpcomingVisitShouldRemoveItFromPetRecord() {
+		Owner owner = ownerWithPet();
+		Pet pet = owner.getPet(PET_ID);
+		Visit upcoming = visitOn(LocalDate.now().plusDays(2), SOME_UPCOMING_VISIT_ID);
+		pet.addVisit(upcoming);
+
+		owner.cancelVisit(PET_ID, SOME_UPCOMING_VISIT_ID);
+
+		assertThat(pet.getVisits()).isEmpty();
+	}
+
+	@Test
+	void cancellingPastVisitShouldLeaveItOnRecord() {
+		Owner owner = ownerWithPet();
+		Pet pet = owner.getPet(PET_ID);
+		// A visit dated exactly today is past: today is not after today.
+		Visit past = visitOn(LocalDate.now(), SOME_PAST_VISIT_ID);
+		pet.addVisit(past);
+
+		assertThatIllegalArgumentException().isThrownBy(() -> owner.cancelVisit(PET_ID, SOME_PAST_VISIT_ID));
+
+		assertThat(pet.getVisits()).contains(past);
+	}
+
+	@Test
+	void cancellingNonexistentVisitShouldBeRefused() {
+		Owner owner = ownerWithPet();
+		Pet pet = owner.getPet(PET_ID);
+		Visit upcoming = visitOn(LocalDate.now().plusDays(2), SOME_UPCOMING_VISIT_ID);
+		pet.addVisit(upcoming);
+
+		assertThatIllegalArgumentException().isThrownBy(() -> owner.cancelVisit(PET_ID, ANY_NONEXISTENT_VISIT_ID));
+
+		assertThat(pet.getVisits()).contains(upcoming);
+	}
+
+	@Test
+	void cancellingVisitOnUnrelatedPetIdShouldBeRefused() {
+		Owner owner = ownerWithPet();
+		Pet pet = owner.getPet(PET_ID);
+		Visit upcoming = visitOn(LocalDate.now().plusDays(2), SOME_UPCOMING_VISIT_ID);
+		pet.addVisit(upcoming);
+
+		assertThatIllegalArgumentException()
+			.isThrownBy(() -> owner.cancelVisit(UNRELATED_PET_ID, SOME_UPCOMING_VISIT_ID));
+
+		assertThat(pet.getVisits()).contains(upcoming);
+	}
+
+}
