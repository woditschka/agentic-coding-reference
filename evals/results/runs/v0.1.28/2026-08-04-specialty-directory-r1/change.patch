 package org.springframework.samples.petclinic.vet;
 
+import java.util.Collection;
+import java.util.Comparator;
 import java.util.List;
 
 import org.springframework.data.domain.Page;
 import org.springframework.data.domain.PageRequest;
 import org.springframework.data.domain.Pageable;
+import org.springframework.samples.petclinic.model.NamedEntity;
 import org.springframework.stereotype.Controller;
 import org.springframework.ui.Model;
 import org.springframework.web.bind.annotation.GetMapping;
@@ -71,4 +74,40 @@ class VetController {
 		return vets;
 	}
 
+	@GetMapping("/specialties.html")
+	public String showSpecialtyDirectory(Model model) {
+		model.addAttribute("specialties", buildSpecialtyDirectory());
+		return "vets/specialtyList";
+	}
+
+	/**
+	 * Inverts the {@link Vet}-to-{@link Specialty} association into a specialty-keyed
+	 * directory. Specialty has no back-reference to Vet, so this presentation grouping is
+	 * built here rather than on the entity. Ordering is deterministic: specialties by
+	 * stored name ascending, veterinarians within a specialty by last name then first
+	 * name. Every specialty is included, so one held by no veterinarian still appears
+	 * with an empty list.
+	 */
+	private List<SpecialtyDirectoryEntry> buildSpecialtyDirectory() {
+		Collection<Vet> allVets = this.vetRepository.findAll();
+		Comparator<Vet> byName = Comparator.comparing(Vet::getLastName).thenComparing(Vet::getFirstName);
+		return this.vetRepository.findSpecialties()
+			.stream()
+			.sorted(Comparator.comparing(NamedEntity::getName))
+			.map(specialty -> new SpecialtyDirectoryEntry(specialty.getName(),
+					allVets.stream().filter(vet -> holdsSpecialty(vet, specialty)).sorted(byName).toList()))
+			.toList();
+	}
+
+	private static boolean holdsSpecialty(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> held.getId().equals(specialty.getId()));
+	}
+
+	/**
+	 * A single row of the specialty directory: one specialty by its stored name and the
+	 * veterinarians holding it, ordered for display.
+	 */
+	record SpecialtyDirectoryEntry(String name, List<Vet> veterinarians) {
+	}
+
 }
