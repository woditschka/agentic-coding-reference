+<!DOCTYPE html>
+
+<html xmlns:th="https://www.thymeleaf.org" th:replace="~{fragments/layout :: layout (~{::body},'vets')}">
+
+<body>
+
+  <h2 th:text="#{specialties}">Specialties</h2>
+
+  <table id="specialties" class="table table-striped">
+    <thead>
+      <tr>
+        <th th:text="#{specialties}">Specialties</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="entry : ${specialties}">
+        <td th:text="${entry.key}"></td>
+        <td>
+          <span th:each="vet : ${entry.value}" th:text="${vet.firstName + ' ' + vet.lastName + ' '}" />
+        </td>
+      </tr>
+      <tr>
+        <td th:text="#{noSpecialty}">No specialty</td>
+        <td>
+          <span th:each="vet : ${noSpecialtyVets}" th:text="${vet.firstName + ' ' + vet.lastName + ' '}" />
+        </td>
+      </tr>
+    </tbody>
+  </table>
+</body>
+
+</html>
