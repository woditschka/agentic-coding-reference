+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+
+/**
+ * Integration test of {@link SpecialtyRepository} against the seeded data store. The seed
+ * data inserts specialties in a non-alphabetical order (radiology, surgery, dentistry),
+ * so a test asserting name order fails the moment the {@code ORDER BY s.name} clause is
+ * dropped and the query falls back to insertion order.
+ */
+@DataJpaTest
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class SpecialtyRepositoryTests {
+
+	@Autowired
+	private SpecialtyRepository specialties;
+
+	@Test
+	void theSpecialtyRepositoryShouldReturnSpecialtiesInNameOrder() {
+		List<String> names = this.specialties.findSpecialties().stream().map(Specialty::getName).toList();
+
+		assertThat(names).contains("dentistry", "radiology", "surgery").isSorted();
+	}
+
+}
