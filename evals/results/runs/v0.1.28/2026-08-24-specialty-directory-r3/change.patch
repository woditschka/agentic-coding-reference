+	@GetMapping("/specialties.html")
+	public String showSpecialtyList(Model model) {
+		Comparator<Vet> byFullName = Comparator.comparing(Vet::getLastName).thenComparing(Vet::getFirstName);
+
+		// Seed the map from the name-ordered specialty set so unheld specialties still
+		// appear (with an empty holder list) and the iteration order stays stable.
+		Map<String, List<Vet>> vetsBySpecialty = new LinkedHashMap<>();
+		for (Specialty specialty : this.specialtyRepository.findSpecialties()) {
+			vetsBySpecialty.put(specialty.getName(), new ArrayList<>());
+		}
+
+		List<Vet> noSpecialtyVets = new ArrayList<>();
+		for (Vet vet : this.vetRepository.findAll()) {
+			if (vet.getNrOfSpecialties() == 0) {
+				noSpecialtyVets.add(vet);
+			}
+			else {
+				for (Specialty specialty : vet.getSpecialties()) {
+					vetsBySpecialty.computeIfAbsent(specialty.getName(), name -> new ArrayList<>()).add(vet);
+				}
+			}
+		}
+
+		vetsBySpecialty.values().forEach(holders -> holders.sort(byFullName));
+		noSpecialtyVets.sort(byFullName);
+
+		model.addAttribute("specialties", vetsBySpecialty);
+		model.addAttribute("noSpecialtyVets", noSpecialtyVets);
+		return "vets/specialtyList";
+	}
