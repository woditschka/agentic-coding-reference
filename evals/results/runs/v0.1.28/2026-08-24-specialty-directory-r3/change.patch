+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+
+/**
+ * Repository class for <code>Specialty</code> domain objects. Surfaces every specialty
+ * the clinic knows, including those held by no veterinarian, which the vet graph alone
+ * cannot reach.
+ */
+public interface SpecialtyRepository extends JpaRepository<Specialty, Integer> {
+
+	/**
+	 * Retrieve all {@link Specialty}s from the data store, in name order.
+	 * @return a Collection of {@link Specialty}s.
+	 */
+	@Query("SELECT s FROM Specialty s ORDER BY s.name")
+	List<Specialty> findSpecialties();
+
+}
