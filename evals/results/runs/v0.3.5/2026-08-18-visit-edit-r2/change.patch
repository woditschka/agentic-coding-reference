+	// called, so the submitted values are already bound onto the booked visit
+	@PostMapping("/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit")
+	public String processUpdateVisitForm(@ModelAttribute Owner owner, @Valid Visit visit, BindingResult result,
+			RedirectAttributes redirectAttributes) {
+		rejectDateNotInFuture(visit, result);
+
+		if (result.hasErrors()) {
+			return VIEWS_VISITS_CREATE_OR_UPDATE_FORM;
+		}
+
+		this.owners.save(owner);
+		redirectAttributes.addFlashAttribute("message", "Your visit has been updated");
+		return "redirect:/owners/{ownerId}";
+	}
+
+	/**
+	 * A visit is always booked ahead of time, whether it is being booked or corrected.
+	 */
+	private void rejectDateNotInFuture(Visit visit, BindingResult result) {
+		if (visit.getDate() != null && !visit.getDate().isAfter(LocalDate.now())) {
+			result.rejectValue("date", "typeMismatch.visitDate");
+		}
+	}
+
 }
