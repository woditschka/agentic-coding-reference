+
+  <table id="specialties" class="table table-striped">
+    <thead>
+      <tr>
+        <th th:text="#{name}">Name</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="entry : ${specialtyDirectory.entries}">
+        <td th:text="${entry.specialty.name}"></td>
+        <td>
+          <span th:each="veterinarian : ${entry.veterinarians}"
+            th:text="${veterinarian.firstName + ' ' + veterinarian.lastName + ' '}" /> <span
+            th:if="${entry.veterinarians.empty}" th:text="#{none}">none</span>
+        </td>
+      </tr>
+    </tbody>
+  </table>
+</body>
+
+</html>
