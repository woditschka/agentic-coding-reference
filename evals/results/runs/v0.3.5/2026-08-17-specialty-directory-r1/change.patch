+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.BaseEntity;
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * Read model for the specialty directory page: every specialty the clinic knows, each
+ * paired with the veterinarians holding it.
+ * <p>
+ * {@link Vet} maps to {@link Specialty} in one direction only, so the page's inverse view
+ * is derived here rather than read from the store. Derivation is a pure function over the
+ * two collections; nothing they contain is mutated.
+ */
+public final class SpecialtyDirectory {
+
+	private static final Comparator<Specialty> BY_NAME = Comparator.comparing(NamedEntity::getName);
+
+	/**
+	 * Total order: two veterinarians sharing a full name are still separated, by the id
+	 * the store assigned them. Without the last key their relative order would depend on
+	 * the order the repository happened to return.
+	 */
+	private static final Comparator<Vet> BY_FULL_NAME = Comparator.<Vet, String>comparing(Person::getLastName)
+		.thenComparing(Person::getFirstName)
+		.thenComparing(BaseEntity::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	private final List<SpecialtyDirectoryEntry> entries;
+
+	private SpecialtyDirectory(List<SpecialtyDirectoryEntry> entries) {
+		this.entries = entries;
+	}
+
+	/**
+	 * Pair every given specialty with the veterinarians holding it.
+	 * @param specialties every specialty the clinic knows, including any no veterinarian
+	 * holds
+	 * @param veterinarians every veterinarian; one holding no specialty appears in no
+	 * entry
+	 * @return the directory
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Objects.requireNonNull(specialties, "specialties must not be null");
+		Objects.requireNonNull(veterinarians, "veterinarians must not be null");
+		return new SpecialtyDirectory(specialties.stream()
+			.sorted(BY_NAME)
+			.map(specialty -> new SpecialtyDirectoryEntry(specialty, holdersOf(specialty, veterinarians)))
+			.toList());
+	}
+
+	public List<SpecialtyDirectoryEntry> getEntries() {
+		return this.entries;
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> veterinarians) {
+		return veterinarians.stream()
+			.filter(veterinarian -> holds(veterinarian, specialty))
+			.sorted(BY_FULL_NAME)
+			.toList();
+	}
+
+	private static boolean holds(Vet veterinarian, Specialty specialty) {
+		return veterinarian.getSpecialties().stream().anyMatch(held -> isSameSpecialty(held, specialty));
+	}
+
+	/**
+	 * The veterinarians and the specialties are read separately, and the veterinarian
+	 * read is cached, so the two sides can hand out different instances of the same
+	 * stored row. Identity settles the common case; the stored id settles the rest. An
+	 * unsaved specialty has no id and matches by identity alone.
+	 */
+	private static boolean isSameSpecialty(Specialty held, Specialty specialty) {
+		return held == specialty || (specialty.getId() != null && specialty.getId().equals(held.getId()));
+	}
+
+	@Override
+	public boolean equals(Object other) {
+		if (this == other) {
+			return true;
+		}
+		if (!(other instanceof SpecialtyDirectory directory)) {
+			return false;
+		}
+		return this.entries.equals(directory.entries);
+	}
+
+	@Override
+	public int hashCode() {
+		return this.entries.hashCode();
+	}
+
+	@Override
+	public String toString() {
+		return this.entries.toString();
+	}
+
+}
