+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.samples.petclinic.vet.VetFixtures.createASpecialty;
+import static org.springframework.samples.petclinic.vet.VetFixtures.createAVet;
+import static org.springframework.samples.petclinic.vet.VetFixtures.createAnEntry;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the read model behind the specialty
+ * directory page.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyWithItsVeterinarians() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet helenLeary = createAVet("Helen", "Leary", radiology);
+		Vet rafaelOrtega = createAVet("Rafael", "Ortega", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery),
+				List.of(helenLeary, rafaelOrtega));
+
+		assertThat(directory.getEntries()).containsExactly(createAnEntry(radiology, helenLeary),
+				createAnEntry(surgery, rafaelOrtega));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet helenLeary = createAVet("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helenLeary));
+
+		assertThat(directory.getEntries()).containsExactly(createAnEntry(radiology, helenLeary),
+				createAnEntry(surgery));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVet("Helen", "Leary", radiology);
+		Vet jamesCarter = createAVet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary, jamesCarter));
+
+		assertThat(directory.getEntries()).containsExactly(createAnEntry(radiology, helenLeary));
+	}
+
+	/**
+	 * The veterinarian read is cached, so a directory that sorted or trimmed the
+	 * instances it was handed would corrupt what every later render sees.
+	 */
+	@Test
+	void theSpecialtyDirectoryShouldLeaveTheVeterinariansItReadsUnchanged() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet helenLeary = createAVet("Helen", "Leary", radiology);
+
+		SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helenLeary));
+
+		assertThat(helenLeary.getSpecialties()).containsExactly(radiology);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderItsEntriesTheSameOnEveryRender() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet helenLeary = createAVet("Helen", "Leary", surgery, radiology);
+		Vet lindaDouglas = createAVet("Linda", "Douglas", surgery);
+		Vet sharonJenkins = createAVet("Sharon", "Jenkins", surgery);
+
+		SpecialtyDirectory firstRender = SpecialtyDirectory.of(List.of(surgery, radiology),
+				List.of(helenLeary, lindaDouglas, sharonJenkins));
+		SpecialtyDirectory secondRender = SpecialtyDirectory.of(List.of(radiology, surgery),
+				List.of(sharonJenkins, helenLeary, lindaDouglas));
+
+		assertThat(firstRender).isEqualTo(secondRender);
+		assertThat(firstRender.getEntries()).containsExactly(createAnEntry(radiology, helenLeary),
+				createAnEntry(surgery, lindaDouglas, sharonJenkins, helenLeary));
+	}
+
+}
