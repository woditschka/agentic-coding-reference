+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.stream.Collectors;
+
+/**
+ * One line of the specialty directory: a {@link Specialty} paired with the veterinarians
+ * holding it, in the order the page renders them. The list is empty when no veterinarian
+ * holds the specialty.
+ *
+ * @param specialty the specialty this line describes
+ * @param veterinarians the veterinarians holding it, in render order; empty when none do
+ */
+public record SpecialtyDirectoryEntry(Specialty specialty, List<Vet> veterinarians) {
+
+	public SpecialtyDirectoryEntry {
+		Objects.requireNonNull(specialty, "specialty must not be null");
+		veterinarians = List.copyOf(Objects.requireNonNull(veterinarians, "veterinarians must not be null"));
+	}
+
+	@Override
+	public String toString() {
+		// Vet inherits no toString, so spell the names out: this string is what an
+		// assertion failure or a debug log shows.
+		return this.specialty + " -> "
+				+ this.veterinarians.stream()
+					.map(veterinarian -> veterinarian.getFirstName() + " " + veterinarian.getLastName())
+					.collect(Collectors.joining(", ", "[", "]"));
+	}
+
+}
