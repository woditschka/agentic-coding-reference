+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+import static org.springframework.samples.petclinic.vet.VetFixtures.createASpecialty;
+import static org.springframework.samples.petclinic.vet.VetFixtures.createAVet;
+
+/**
+ * Test class for the {@link SpecialtyController}.
+ * <p>
+ * The fixture is the smallest one covering every case the page must show: radiology is
+ * held by one veterinarian, surgery by none, and James Carter holds nothing.
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_HELD_BY_ONE = "radiology";
+
+	private static final String SPECIALTY_HELD_BY_NONE = "surgery";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@MockitoBean
+	private SpecialtyRepository specialties;
+
+	@MockitoBean
+	private VetRepository vets;
+
+	@BeforeEach
+	void setup() {
+		Specialty radiology = createASpecialty(SPECIALTY_HELD_BY_ONE);
+		Specialty surgery = createASpecialty(SPECIALTY_HELD_BY_NONE);
+		given(this.specialties.findSpecialties()).willReturn(List.of(radiology, surgery));
+		given(this.vets.findAll())
+			.willReturn(List.of(createAVet("Helen", "Leary", radiology), createAVet("James", "Carter")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachVeterinarianByFullName() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(content().string(containsString("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarianAsHeldByNone() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString(SPECIALTY_HELD_BY_NONE)))
+			.andExpect(content().string(containsString(">none<")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEverySpecialtyOnOnePageWithoutPaging() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString(SPECIALTY_HELD_BY_ONE)))
+			.andExpect(content().string(containsString(SPECIALTY_HELD_BY_NONE)))
+			.andExpect(content().string(not(containsString("specialties.html?page="))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheSharedNavigationWithoutAnEntryOfItsOwn() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString("/owners/find")))
+			.andExpect(content().string(containsString("/vets.html")))
+			.andExpect(content().string(not(containsString("/specialties.html"))))
+			.andExpect(content().string(not(containsString("nav-link active"))));
+	}
+
+}
