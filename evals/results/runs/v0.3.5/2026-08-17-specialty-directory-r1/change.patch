+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Construction of veterinarian-package fixtures for tests.
+ */
+final class VetFixtures {
+
+	// The store assigns identity on insert; tests get the same guarantee — unique and
+	// never null — from here, so two fixtures are never mistaken for the same row.
+	private static final AtomicInteger NEXT_ID = new AtomicInteger(1);
+
+	private VetFixtures() {
+	}
+
+	static Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(NEXT_ID.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	static Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(NEXT_ID.getAndIncrement());
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			veterinarian.addSpecialty(specialty);
+		}
+		return veterinarian;
+	}
+
+	static SpecialtyDirectoryEntry createAnEntry(Specialty specialty, Vet... veterinarians) {
+		return new SpecialtyDirectoryEntry(specialty, List.of(veterinarians));
+	}
+
+}
