+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for the specialty directory built by {@link SpecialtyHolders}.
+ */
+class SpecialtyHoldersTests {
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByItsStoredName() {
+		Specialty radiology = specialty(1, "radiology");
+		Specialty surgery = specialty(2, "surgery");
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(surgery, radiology), List.of());
+
+		assertThat(directory).extracting(entry -> entry.specialty().getName()).containsExactly("radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderByFirstAndLastName() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet helen = vet(2, "Helen", "Leary", radiology);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiology), List.of(helen));
+
+		Vet holder = directory.get(0).holders().get(0);
+		assertThat(holder.getFirstName()).isEqualTo("Helen");
+		assertThat(holder.getLastName()).isEqualTo("Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		Specialty heldByNobody = specialty(3, "dentistry");
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(heldByNobody), List.of());
+
+		assertThat(directory).hasSize(1);
+		assertThat(directory.get(0).specialty().getName()).isEqualTo("dentistry");
+		assertThat(directory.get(0).holders()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet helen = vet(2, "Helen", "Leary", radiology);
+		Vet holdsNoSpecialty = vet(1, "James", "Carter");
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiology),
+				List.of(holdsNoSpecialty, helen));
+
+		assertThat(directory.get(0).holders()).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEverySpecialtyHeld() {
+		Specialty radiology = specialty(1, "radiology");
+		Specialty surgery = specialty(2, "surgery");
+		Vet linda = vet(3, "Linda", "Douglas", radiology, surgery);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiology, surgery), List.of(linda));
+
+		assertThat(directory).allSatisfy(entry -> assertThat(entry.holders()).containsExactly(linda));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchHoldersOnTheStoredIdentifier() {
+		// The specialty read and the veterinarian read can return distinct instances of
+		// the same stored row; matching on object identity would silently drop holders.
+		Specialty radiologyFromTheSpecialtyRead = specialty(1, "radiology");
+		Specialty radiologyReachedThroughTheVet = specialty(1, "radiology");
+		Vet helen = vet(2, "Helen", "Leary", radiologyReachedThroughTheVet);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiologyFromTheSpecialtyRead),
+				List.of(helen));
+
+		assertThat(directory.get(0).holders()).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderHoldersByLastNameThenFirstNameThenIdentifier() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet fourthByName = vet(1, "Rafael", "Ortega", radiology);
+		Vet secondOfTheSharedName = vet(3, "Helen", "Leary", radiology);
+		Vet firstOfTheSharedName = vet(2, "Helen", "Leary", radiology);
+		Vet thirdByName = vet(4, "Linda", "Ortega", radiology);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiology),
+				List.of(fourthByName, secondOfTheSharedName, thirdByName, firstOfTheSharedName));
+
+		assertThat(directory.get(0).holders()).containsExactly(firstOfTheSharedName, secondOfTheSharedName, thirdByName,
+				fourthByName);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotBeAlteredThroughItsHolderList() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet helen = vet(2, "Helen", "Leary", radiology);
+
+		List<Vet> holders = SpecialtyHolders.directory(List.of(radiology), List.of(helen)).get(0).holders();
+
+		assertThat(holders).isUnmodifiable();
+	}
