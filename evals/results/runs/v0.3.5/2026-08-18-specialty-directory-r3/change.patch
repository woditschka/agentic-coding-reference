+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.BaseEntity;
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * One specialty together with the veterinarians holding it, as the specialty directory
+ * presents them. An immutable value: it is built from persisted entities but holds no
+ * persisted state of its own.
+ */
+public record SpecialtyHolders(Specialty specialty, List<Vet> holders) {
+
+	private static final Comparator<Specialty> BY_SPECIALTY_NAME = Comparator.comparing(NamedEntity::getName);
+
+	/**
+	 * Names are not unique among veterinarians, so the identifier keeps the order total
+	 * and therefore stable across requests.
+	 */
+	private static final Comparator<Vet> BY_HOLDER_NAME = Comparator.<Vet, String>comparing(Person::getLastName)
+		.thenComparing(Person::getFirstName)
+		.thenComparing(BaseEntity::getId);
+
+	public SpecialtyHolders {
+		Objects.requireNonNull(specialty, "specialty must not be null");
+		holders = List.copyOf(holders);
+	}
+
+	/**
+	 * Build the whole directory: every given specialty, in name order, each with the
+	 * veterinarians holding it. A specialty nobody holds is present with no holders; a
+	 * veterinarian holding no specialty appears nowhere.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians every veterinarian the clinic employs
+	 * @return one entry per specialty, ordered by specialty name
+	 */
+	public static List<SpecialtyHolders> directory(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = groupBySpecialtyId(veterinarians);
+		return specialties.stream()
+			.sorted(BY_SPECIALTY_NAME)
+			.map(specialty -> new SpecialtyHolders(specialty,
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+	}
+
+	/**
+	 * Match on the stored identifier: the specialty read and the veterinarian read can
+	 * return distinct instances of the same row, and the persisted types inherit identity
+	 * equality from {@link BaseEntity}.
+	 */
+	private static Map<Integer, List<Vet>> groupBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		holdersBySpecialtyId.values().forEach(holders -> holders.sort(BY_HOLDER_NAME));
+		return holdersBySpecialtyId;
+	}
+
+}
