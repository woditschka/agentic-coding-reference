+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.GetMapping;
+
+/**
+ * Serves the read-only specialty directory: every specialty the clinic knows, each with
+ * the veterinarians holding it. The page is reachable by its address alone, with no
+ * navigation entry and no link from another page.
+ */
+@Controller
+class SpecialtyController {
+
+	private final SpecialtyRepository specialtyRepository;
+
+	private final VetRepository vetRepository;
+
+	private final GroupVeterinariansBySpecialty groupVeterinariansBySpecialty;
+
+	SpecialtyController(SpecialtyRepository specialtyRepository, VetRepository vetRepository,
+			GroupVeterinariansBySpecialty groupVeterinariansBySpecialty) {
+		this.specialtyRepository = specialtyRepository;
+		this.vetRepository = vetRepository;
+		this.groupVeterinariansBySpecialty = groupVeterinariansBySpecialty;
+	}
+
+	@GetMapping("/specialties.html")
+	public String showSpecialtyDirectory(Model model) {
+		List<SpecialtyHolders> directory = this.groupVeterinariansBySpecialty
+			.group(this.specialtyRepository.findSpecialties(), this.vetRepository.findAll());
+		model.addAttribute("listSpecialties", directory);
+		return "vets/specialtyList";
+	}
+
+}
