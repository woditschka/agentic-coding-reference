+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.annotation.Import;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController} and the page it renders. The grouping
+ * service is the real one, so these tests exercise the page end to end from the two
+ * repository reads down to the rendered markup.
+ */
+@WebMvcTest(SpecialtyController.class)
+@Import(GroupVeterinariansBySpecialty.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String DIRECTORY_ADDRESS = "/specialties.html";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@MockitoBean
+	private SpecialtyRepository specialties;
+
+	@MockitoBean
+	private VetRepository vets;
+
+	private int nextId = 1;
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	@BeforeEach
+	void setup() {
+		Specialty radiology = createASpecialty("radiology");
+		Specialty surgery = createASpecialty("surgery");
+		Specialty dentistryNobodyHolds = createASpecialty("dentistry");
+		given(this.specialties.findSpecialties()).willReturn(List.of(radiology, surgery, dentistryNobodyHolds));
+		given(this.vets.findAll()).willReturn(List.of(createAVet("Helen", "Leary", radiology),
+				createAVet("Rafael", "Ortega", surgery), createAVet("James", "Carter")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeServedAtItsOwnAddress() throws Exception {
+		this.mockMvc.perform(get(DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(model().attributeExists("listSpecialties"))
+			.andExpect(view().name("vets/specialtyList"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHolderByFirstThenLastName() throws Exception {
+		this.mockMvc.perform(get(DIRECTORY_ADDRESS))
+			.andExpect(content().string(containsString("Helen Leary")))
+			.andExpect(content().string(containsString("Rafael Ortega")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEverySpecialtyOnOnePage() throws Exception {
+		this.mockMvc.perform(get(DIRECTORY_ADDRESS))
+			.andExpect(content().string(containsString("radiology")))
+			.andExpect(content().string(containsString("surgery")))
+			.andExpect(content().string(containsString("dentistry")))
+			.andExpect(content().string(not(containsString("specialties.html?page"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowASpecialtyNobodyHoldsAsHeldByNone() throws Exception {
+		this.mockMvc.perform(get(DIRECTORY_ADDRESS)).andExpect(content().string(containsString("none")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() throws Exception {
+		this.mockMvc.perform(get(DIRECTORY_ADDRESS)).andExpect(content().string(not(containsString("James Carter"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEmptyWhenTheClinicKnowsNoSpecialty() throws Exception {
+		given(this.specialties.findSpecialties()).willReturn(List.of());
+
+		this.mockMvc.perform(get(DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString("Helen Leary"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderAStoredNameAsTextRatherThanMarkup() throws Exception {
+		Specialty specialtyNamedWithMarkup = createASpecialty("<script>specialty</script>");
+		given(this.specialties.findSpecialties()).willReturn(List.of(specialtyNamedWithMarkup));
+		given(this.vets.findAll())
+			.willReturn(List.of(createAVet("Helen", "<script>holder</script>", specialtyNamedWithMarkup)));
+
+		this.mockMvc.perform(get(DIRECTORY_ADDRESS))
+			.andExpect(content().string(not(containsString("<script>specialty</script>"))))
+			.andExpect(content().string(not(containsString("<script>holder</script>"))))
+			.andExpect(content().string(containsString("&lt;script&gt;specialty&lt;/script&gt;")))
+			.andExpect(content().string(containsString("&lt;script&gt;holder&lt;/script&gt;")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryNoNavigationEntryOfItsOwn() throws Exception {
+		this.mockMvc.perform(get(DIRECTORY_ADDRESS))
+			.andExpect(content().string(not(containsString("href=\"" + DIRECTORY_ADDRESS + "\""))));
+	}
+
+}
