+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link GroupVeterinariansBySpecialty}, the read model behind the
+ * specialty directory page.
+ */
+class GroupVeterinariansBySpecialtyTests {
+
+	private static final String ANY_FIRST_NAME = "Any";
+
+	private static final String ANY_LAST_NAME = "Body";
+
+	private final GroupVeterinariansBySpecialty group = new GroupVeterinariansBySpecialty();
+
+	private int nextId = 1;
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVetHolding(Specialty... specialties) {
+		return createAVet(ANY_FIRST_NAME, ANY_LAST_NAME, specialties);
+	}
+
+	private Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private SpecialtyHolders createHoldersOf(Specialty specialty, Vet... holders) {
+		return new SpecialtyHolders(specialty, List.of(holders));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		Specialty radiology = createASpecialty("radiology");
+		Specialty surgery = createASpecialty("surgery");
+
+		List<SpecialtyHolders> directory = this.group.group(List.of(radiology, surgery),
+				List.of(createAVetHolding(radiology)));
+
+		assertThat(directory).extracting(holders -> holders.specialty().getName())
+			.containsExactly("radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListTheVeterinariansHoldingEachSpecialty() {
+		Specialty radiology = createASpecialty("radiology");
+		Specialty surgery = createASpecialty("surgery");
+		Vet helen = createAVet("Helen", "Leary", radiology);
+		Vet rafael = createAVet("Rafael", "Ortega", surgery);
+
+		List<SpecialtyHolders> directory = this.group.group(List.of(radiology, surgery), List.of(helen, rafael));
+
+		assertThat(directory).containsExactly(createHoldersOf(radiology, helen), createHoldersOf(surgery, rafael));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowASpecialtyNobodyHoldsAsHeldByNone() {
+		Specialty dentistry = createASpecialty("dentistry");
+
+		List<SpecialtyHolders> directory = this.group.group(List.of(dentistry), List.of(createAVetHolding()));
+
+		assertThat(directory).containsExactly(createHoldersOf(dentistry));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty("radiology");
+		Vet helen = createAVet("Helen", "Leary", radiology);
+		Vet jamesHoldingNoSpecialty = createAVet("James", "Carter");
+
+		List<SpecialtyHolders> directory = this.group.group(List.of(radiology),
+				List.of(helen, jamesHoldingNoSpecialty));
+
+		assertThat(directory).flatExtracting(SpecialtyHolders::holders).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEmptyWhenTheClinicKnowsNoSpecialty() {
+		List<SpecialtyHolders> directory = this.group.group(List.of(), List.of(createAVetHolding()));
+
+		assertThat(directory).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListSpecialtiesInAStableOrder() {
+		Specialty surgery = createASpecialty("surgery");
+		Specialty dentistry = createASpecialty("dentistry");
+		Specialty radiology = createASpecialty("radiology");
+
+		List<SpecialtyHolders> directory = this.group.group(List.of(surgery, dentistry, radiology), List.of());
+
+		assertThat(directory).extracting(holders -> holders.specialty().getName())
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListTheHoldersOfASpecialtyInAStableOrder() {
+		Specialty surgery = createASpecialty("surgery");
+		Vet rafael = createAVet("Rafael", "Ortega", surgery);
+		Vet linda = createAVet("Linda", "Douglas", surgery);
+		Vet henryDouglas = createAVet("Henry", "Douglas", surgery);
+
+		List<SpecialtyHolders> directory = this.group.group(List.of(surgery), List.of(rafael, linda, henryDouglas));
+
+		assertThat(directory).containsExactly(createHoldersOf(surgery, henryDouglas, linda, rafael));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepTwoHoldersSharingAFullNameApart() {
+		Specialty surgery = createASpecialty("surgery");
+		Vet oneRafaelOrtega = createAVet("Rafael", "Ortega", surgery);
+		Vet anotherRafaelOrtega = createAVet("Rafael", "Ortega", surgery);
+
+		// Handed in reversed, so the order below comes from the sort, not the input.
+		List<SpecialtyHolders> directory = this.group.group(List.of(surgery),
+				List.of(anotherRafaelOrtega, oneRafaelOrtega));
+
+		assertThat(directory).containsExactly(createHoldersOf(surgery, oneRafaelOrtega, anotherRafaelOrtega));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepTwoSpecialtiesStoredUnderOneNameApart() {
+		Specialty oneSurgery = createASpecialty("surgery");
+		Specialty anotherSurgery = createASpecialty("surgery");
+		Vet helen = createAVet("Helen", "Leary", oneSurgery);
+		Vet rafael = createAVet("Rafael", "Ortega", anotherSurgery);
+
+		List<SpecialtyHolders> directory = this.group.group(List.of(oneSurgery, anotherSurgery),
+				List.of(helen, rafael));
+
+		assertThat(directory).containsExactly(createHoldersOf(oneSurgery, helen),
+				createHoldersOf(anotherSurgery, rafael));
+	}
+
+}
