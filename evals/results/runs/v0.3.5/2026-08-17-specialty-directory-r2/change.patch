+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * One specialty together with the veterinarians holding it, as the specialty directory
+ * page shows it. The holder list is empty when no veterinarian holds the specialty.
+ *
+ * @param specialty the specialty the clinic knows
+ * @param holders the veterinarians holding it, in the order the page lists them
+ */
+public record SpecialtyHolders(Specialty specialty, List<Vet> holders) {
+
+	public SpecialtyHolders {
+		Objects.requireNonNull(specialty, "specialty must not be null");
+		Objects.requireNonNull(holders, "holders must not be null");
+		// A copy, so the value stays immutable however the caller treats its own list.
+		holders = List.copyOf(holders);
+	}
+
+}
