+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+import org.springframework.stereotype.Component;
+
+/**
+ * Inverts the veterinarian-to-specialty direction into the specialty directory's read
+ * model. The association is mapped from {@link Vet} to {@link Specialty} only, and a
+ * specialty nobody holds is reachable from no veterinarian, so the directory is assembled
+ * from the two collections rather than read off an entity. See
+ * docs/adr/2026-08-17-specialty-directory-read-model.md.
+ */
+@Component
+class GroupVeterinariansBySpecialty {
+
+	/**
+	 * Stored identity breaks the tie, so two specialties sharing a name still list in the
+	 * same order on every request.
+	 */
+	private static final Comparator<Specialty> BY_NAME = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	/**
+	 * Stored identity breaks the tie here too, so two veterinarians sharing a full name
+	 * still list in the same order on every request.
+	 */
+	private static final Comparator<Vet> BY_FULL_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	/**
+	 * Group the veterinarians under the specialties they hold.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians every veterinarian of the clinic
+	 * @return one entry per given specialty, each with the veterinarians holding it
+	 */
+	List<SpecialtyHolders> group(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		return specialties.stream()
+			.sorted(BY_NAME)
+			.map(specialty -> new SpecialtyHolders(specialty, holdersOf(specialty, veterinarians)))
+			.toList();
+	}
+
+	private List<Vet> holdersOf(Specialty specialty, Collection<Vet> veterinarians) {
+		return veterinarians.stream().filter(vet -> holds(vet, specialty)).sorted(BY_FULL_NAME).toList();
+	}
+
+	private boolean holds(Vet vet, Specialty specialty) {
+		// Compared by stored identity, never by name: two specialties may share a name
+		// and stay two entries.
+		return vet.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+}
