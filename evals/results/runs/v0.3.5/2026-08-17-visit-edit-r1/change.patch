+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link Pet}.
+ */
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	private static final int VISIT_ID_OF_ANOTHER_PET = 2;
+
+	@Test
+	void thePetShouldReturnTheVisitCarryingTheGivenId() {
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetHolding(bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldReturnNoVisitForAnIdItDoesNotHold() {
+		Pet pet = createAPetHolding(createABookedVisit(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(VISIT_ID_OF_ANOTHER_PET)).isNull();
+	}
+
+	@Test
+	void thePetShouldNotReturnAVisitThatIsNotBookedYet() {
+		Pet pet = createAPetHolding(createABookedVisit(BOOKED_VISIT_ID), createAnUnbookedVisit());
+
+		// A visit not yet booked carries no id of its own, so an absent id must not
+		// match it.
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	private static Pet createAPetHolding(Visit... visits) {
+		Pet pet = new Pet();
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+	private static Visit createABookedVisit(int id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnbookedVisit() {
+		return new Visit();
+	}
+
+}
