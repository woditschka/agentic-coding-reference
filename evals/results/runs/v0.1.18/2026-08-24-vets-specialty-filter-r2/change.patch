+	/**
+	 * Normalizes a requested specialty the way the empty owner search is normalized: a
+	 * null, blank, or spaces-only value means no filter; a real value is trimmed of
+	 * surrounding whitespace.
+	 */
+	private String normalizeSpecialty(String specialty) {
+		if (specialty == null) {
+			return null;
+		}
+		String trimmed = specialty.strip();
+		return trimmed.isEmpty() ? null : trimmed;
+	}
+
+	private List<Vet> filterBySpecialty(Collection<Vet> vets, String specialty) {
+		return vets.stream()
+			.filter(vet -> vet.getSpecialties().stream().anyMatch(sp -> sp.getName().equalsIgnoreCase(specialty)))
+			.toList();
+	}
