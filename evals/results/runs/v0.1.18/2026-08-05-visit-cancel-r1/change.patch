+	 * @param redirectAttributes carries the success or error flash message
+	 * @return a redirect back to the owner's record
+	 */
+	@PostMapping("/owners/{ownerId}/pets/{petId}/visits/{visitId}/cancel")
+	public String cancelVisit(@ModelAttribute("owner") Owner owner, @PathVariable("petId") int petId,
+			@PathVariable("visitId") int visitId, RedirectAttributes redirectAttributes) {
+		if (owner.removeVisit(petId, visitId)) {
+			this.owners.save(owner);
+			redirectAttributes.addFlashAttribute("message", "The visit has been cancelled");
+		}
+		else {
+			redirectAttributes.addFlashAttribute("error", "The visit could not be cancelled");
+		}
+		return "redirect:/owners/{ownerId}";
+	}
