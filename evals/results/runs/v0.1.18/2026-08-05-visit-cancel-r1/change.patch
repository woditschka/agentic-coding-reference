+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Unit tests for the visit-cancellation invariants on the {@link Owner} aggregate.
+ */
+class OwnerTests {
+
+	private static final int PET_ID = 1;
+
+	private static final int UNOWNED_PET_ID = 2;
+
+	private static final int UPCOMING_VISIT_ID = 10;
+
+	private static final int SECOND_UPCOMING_VISIT_ID = 11;
+
+	private static final int TODAY_VISIT_ID = 20;
+
+	private static final int PAST_VISIT_ID = 21;
+
+	private static final int ANY_UNKNOWN_VISIT_ID = 999;
+
+	private Owner ownerWithMax() {
+		Owner owner = new Owner();
+		Pet max = new Pet();
+		max.setName("Max");
+		owner.addPet(max);
+		max.setId(PET_ID);
+		owner.setId(1);
+		return owner;
+	}
+
+	private Visit visit(int id, LocalDate date) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		visit.setDate(date);
+		visit.setDescription("checkup");
+		return visit;
+	}
+
+	@Test
+	void theOwnerAggregateShouldRemoveAnUpcomingVisitFromThePetRecord() {
+		Owner owner = ownerWithMax();
+		Pet max = owner.getPet(PET_ID);
+		max.getVisits().add(visit(UPCOMING_VISIT_ID, LocalDate.now().plusDays(1)));
+
+		boolean removed = owner.removeVisit(PET_ID, UPCOMING_VISIT_ID);
+
+		assertThat(removed).isTrue();
+		assertThat(max.getVisits()).isEmpty();
+	}
+
+	@Test
+	void theOwnerAggregateShouldRefuseACancelForAPastOrSameDayVisit() {
+		Owner owner = ownerWithMax();
+		Pet max = owner.getPet(PET_ID);
+		Visit today = visit(TODAY_VISIT_ID, LocalDate.now());
+		Visit past = visit(PAST_VISIT_ID, LocalDate.now().minusDays(1));
+		max.getVisits().add(today);
+		max.getVisits().add(past);
+
+		assertThat(owner.removeVisit(PET_ID, TODAY_VISIT_ID)).isFalse();
+		assertThat(owner.removeVisit(PET_ID, PAST_VISIT_ID)).isFalse();
+		assertThat(max.getVisits()).containsExactlyInAnyOrder(today, past);
+	}
+
+	@Test
+	void theOwnerAggregateShouldRefuseACancelForAVisitNotBelongingToItsPet() {
+		Owner owner = ownerWithMax();
+		Pet max = owner.getPet(PET_ID);
+		Visit upcoming = visit(UPCOMING_VISIT_ID, LocalDate.now().plusDays(1));
+		max.getVisits().add(upcoming);
+
+		boolean removed = owner.removeVisit(PET_ID, ANY_UNKNOWN_VISIT_ID);
+
+		assertThat(removed).isFalse();
+		assertThat(max.getVisits()).containsExactly(upcoming);
+	}
+
+	@Test
+	void theOwnerAggregateShouldRefuseACancelForAPetItDoesNotOwn() {
+		Owner owner = ownerWithMax();
+		Pet max = owner.getPet(PET_ID);
+		Visit upcoming = visit(UPCOMING_VISIT_ID, LocalDate.now().plusDays(1));
+		max.getVisits().add(upcoming);
+
+		boolean removed = owner.removeVisit(UNOWNED_PET_ID, UPCOMING_VISIT_ID);
+
+		assertThat(removed).isFalse();
+		assertThat(max.getVisits()).containsExactly(upcoming);
+	}
+
+	@Test
+	void theOwnerAggregateShouldLeaveRemainingVisitsIntactAfterACancel() {
+		Owner owner = ownerWithMax();
+		Pet max = owner.getPet(PET_ID);
+		Visit kept = visit(SECOND_UPCOMING_VISIT_ID, LocalDate.now().plusDays(2));
+		max.getVisits().add(visit(UPCOMING_VISIT_ID, LocalDate.now().plusDays(1)));
+		max.getVisits().add(kept);
+
+		boolean removed = owner.removeVisit(PET_ID, UPCOMING_VISIT_ID);
+
+		assertThat(removed).isTrue();
+		assertThat(max.getVisits()).containsExactly(kept);
+	}
+
+}
