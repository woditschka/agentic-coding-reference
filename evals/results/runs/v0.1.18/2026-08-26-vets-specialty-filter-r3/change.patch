+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+
+/**
+ * Full-stack, real-I/O tests for the optional {@code specialty} filter on the two
+ * veterinarian-list surfaces (REQ-VET-003 HTML page, REQ-VET-004 JSON resource). The
+ * whole application context is loaded against the seeded H2 database — no mocked
+ * collaborators — so the case-insensitive whole-name matching is exercised through the
+ * real repository.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+@DisabledInAotMode
+class VetSpecialtyFilterIntegrationTests {
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	// --- HTML directory surface (REQ-VET-003) ---
+
+	@Test
+	void theVetPageShouldListOnlyVetsHoldingTheGivenSpecialty() throws Exception {
+		mockMvc.perform(get("/vets.html").param("specialty", "surgery"))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute("listVets", hasSize(2)))
+			.andExpect(model().attribute("listVets",
+					containsInAnyOrder(hasProperty("lastName", is("Douglas")), hasProperty("lastName", is("Ortega")))));
+	}
+
+	@Test
+	void theVetPageSpecialtyFilterShouldIgnoreLetterCase() throws Exception {
+		mockMvc.perform(get("/vets.html").param("specialty", "SuRgErY"))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute("listVets",
+					containsInAnyOrder(hasProperty("lastName", is("Douglas")), hasProperty("lastName", is("Ortega")))));
+	}
+
+	@Test
+	void theVetPageSpecialtyFilterShouldRequireTheWholeName() throws Exception {
+		mockMvc.perform(get("/vets.html").param("specialty", "surg"))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute("listVets", hasSize(0)));
+	}
+
+	@Test
+	void theVetPageShouldPageWithinTheFilteredResults() throws Exception {
+		mockMvc.perform(get("/vets.html").param("specialty", "surgery"))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute("totalItems", 2L))
+			.andExpect(model().attribute("specialty", "surgery"));
+	}
+
+	@Test
+	void theVetPageShouldIgnoreABlankSpecialty() throws Exception {
+		mockMvc.perform(get("/vets.html").param("specialty", "   "))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute("totalItems", 6L))
+			.andExpect(model().attributeDoesNotExist("specialty"));
+	}
+
+	@Test
+	void theVetPageShouldShowAnEmptyListForAnUnheldSpecialty() throws Exception {
+		mockMvc.perform(get("/vets.html").param("specialty", "cardiology"))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute("listVets", hasSize(0)));
+	}
+
+	@Test
+	void theVetPageShouldTreatAPaddedSpecialtyAsALiteralValue() throws Exception {
+		// No trimming is applied: the padded " surgery " is matched literally and finds
+		// nothing, even though the un-padded "surgery" would match two vets.
+		mockMvc.perform(get("/vets.html").param("specialty", " surgery "))
+			.andExpect(status().isOk())
+			.andExpect(model().attribute("listVets", hasSize(0)));
+	}
+
+	// --- JSON resource surface (REQ-VET-004) ---
+
+	@Test
+	void theVetsResourceShouldReturnOnlyVetsHoldingTheGivenSpecialty() throws Exception {
+		mockMvc.perform(get("/vets").param("specialty", "surgery").accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(content().contentType(MediaType.APPLICATION_JSON))
+			.andExpect(jsonPath("$.vetList.length()").value(2))
+			.andExpect(jsonPath("$.vetList[*].lastName", containsInAnyOrder("Douglas", "Ortega")));
+	}
+
+	@Test
+	void theVetsResourceSpecialtyFilterShouldIgnoreLetterCase() throws Exception {
+		mockMvc.perform(get("/vets").param("specialty", "SuRgErY").accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList.length()").value(2))
+			.andExpect(jsonPath("$.vetList[*].lastName", containsInAnyOrder("Douglas", "Ortega")));
+	}
+
+	@Test
+	void theVetsResourceShouldReturnAnEmptyListForAnUnheldSpecialty() throws Exception {
+		mockMvc.perform(get("/vets").param("specialty", "cardiology").accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList.length()").value(0));
+	}
+
+	@Test
+	void theVetsResourceShouldIgnoreABlankSpecialty() throws Exception {
+		mockMvc.perform(get("/vets").param("specialty", "   ").accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList.length()").value(6));
+	}
+
+	@Test
+	void theVetsResourceShouldTreatAPaddedSpecialtyAsALiteralValue() throws Exception {
+		// No trimming is applied: the padded " surgery " is matched literally and finds
+		// nothing, even though the un-padded "surgery" would match two vets.
+		mockMvc.perform(get("/vets").param("specialty", " surgery ").accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList.length()").value(0));
+	}
+
+}
