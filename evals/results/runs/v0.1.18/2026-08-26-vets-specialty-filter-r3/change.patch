+	/**
+	 * Retrieve the <code>Vet</code>s holding the specialty with the given name, one page
+	 * at a time. Matching is on the whole specialty name and ignores letter case; a value
+	 * that is only part of a specialty name matches no <code>Vet</code>.
+	 * <code>Distinct</code> collapses the duplicate rows the vet_specialties join would
+	 * otherwise produce. Left uncached: the filtered listing is not hot and must not
+	 * share the "vets" cache.
+	 * @param specialtyName the whole specialty name to match, case-insensitively
+	 * @param pageable the page to retrieve
+	 * @return a page of matching <code>Vet</code>s (empty when none hold the specialty)
+	 */
+	@Transactional(readOnly = true)
+	Page<Vet> findDistinctBySpecialtiesNameIgnoreCase(String specialtyName, Pageable pageable)
+			throws DataAccessException;
+
+	/**
+	 * Retrieve every <code>Vet</code> holding the specialty with the given name. Shares
+	 * the matching rule of the paged overload above (whole name, case-insensitive,
+	 * distinct) so the JSON and HTML surfaces filter identically by construction. Left
+	 * uncached for the same reason.
+	 * @param specialtyName the whole specialty name to match, case-insensitively
+	 * @return a <code>Collection</code> of matching <code>Vet</code>s (empty when none
+	 * hold the specialty)
+	 */
+	@Transactional(readOnly = true)
+	Collection<Vet> findDistinctBySpecialtiesNameIgnoreCase(String specialtyName) throws DataAccessException;
+
 }
