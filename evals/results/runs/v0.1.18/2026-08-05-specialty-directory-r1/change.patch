+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.assertj.core.util.Lists;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}, the inverse of the veterinarian
+ * directory: specialties listed with the veterinarians who hold each.
+ */
+
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@MockitoBean
+	private SpecialtyRepository specialties;
+
+	@MockitoBean
+	private VetRepository vets;
+
+	private Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet vet(int id, String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private Specialty dentistry;
+
+	private Specialty radiology;
+
+	private Specialty surgery;
+
+	@BeforeEach
+	void setup() {
+		this.dentistry = specialty(1, "dentistry");
+		this.radiology = specialty(2, "radiology");
+		this.surgery = specialty(3, "surgery");
+		// surgery is stored but held by no veterinarian (edge case 2).
+		given(this.specialties.findSpecialties()).willReturn(List.of(this.dentistry, this.radiology, this.surgery));
+		// Two vets hold radiology, seeded in reverse of their sorted order (Ortega
+		// before Leary), so the within-specialty comparator has to reorder them.
+		// James Carter holds no specialty.
+		given(this.vets.findAll()).willReturn(
+				Lists.newArrayList(vet(1, "Rafael", "Ortega", this.radiology), vet(2, "Helen", "Leary", this.radiology),
+						vet(3, "Linda", "Douglas", this.dentistry), vet(4, "James", "Carter")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyWithItsVeterinarians() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("specialties/specialtyList"))
+			.andExpect(model().attributeExists("specialties"))
+			.andExpect(content().string(containsString("dentistry")))
+			.andExpect(content().string(containsString("radiology")))
+			// stored specialty with no holders still appears
+			.andExpect(content().string(containsString("surgery")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderSpecialtiesInTheOrderTheRepositoryReturns() throws Exception {
+		// Re-stub the repository in a deliberately non-alphabetical order; the
+		// controller must surface that order verbatim rather than re-sort, so an
+		// alphabetical rendering here would be a regression, not a coincidence.
+		given(this.specialties.findSpecialties()).willReturn(List.of(this.radiology, this.surgery, this.dentistry));
+
+		String body = renderDirectory();
+
+		assertRenderedInOrder(body, "radiology", "surgery", "dentistry");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowVeterinariansByFullName() throws Exception {
+		String body = renderDirectory();
+
+		assertThat(body).contains("Helen Leary", "Linda Douglas");
+		// Each vet renders under the specialty they hold: Linda Douglas between the
+		// dentistry and radiology headers, Helen Leary between radiology and surgery.
+		assertRenderedInOrder(body, "dentistry", "Linda Douglas", "radiology", "Helen Leary", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldSortVeterinariansWithinASpecialtyByName() throws Exception {
+		// Helen Leary and Rafael Ortega both hold radiology; despite Ortega being
+		// seeded first, Leary must render first (last name Leary sorts before Ortega).
+		String body = renderDirectory();
+
+		assertRenderedInOrder(body, "Helen Leary", "Rafael Ortega");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() throws Exception {
+		// James Carter holds no specialty and must not appear anywhere on the page.
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString("James"))))
+			.andExpect(content().string(not(containsString("Carter"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderAllSpecialtiesOnOnePage() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(model().attributeDoesNotExist("totalPages"))
+			.andExpect(model().attributeDoesNotExist("currentPage"))
+			.andExpect(content().string(containsString("dentistry")))
+			.andExpect(content().string(containsString("radiology")))
+			.andExpect(content().string(containsString("surgery")));
+	}
+
+	private String renderDirectory() throws Exception {
+		return mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+	}
+
+	/**
+	 * Asserts the fragments appear in the rendered body in the given relative order, each
+	 * strictly after the previous one.
+	 */
+	private void assertRenderedInOrder(String body, String... fragments) {
+		int previous = -1;
+		for (String fragment : fragments) {
+			int index = body.indexOf(fragment);
+			assertThat(index).as("'%s' should render after the previous fragment", fragment).isGreaterThan(previous);
+			previous = index;
+		}
+	}
+
+}
