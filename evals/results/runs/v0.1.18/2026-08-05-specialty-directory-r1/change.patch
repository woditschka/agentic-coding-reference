+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+import org.springframework.samples.petclinic.model.Person;
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.GetMapping;
+
+/**
+ * Serves the specialty directory, the inverse of the veterinarian directory: every stored
+ * specialty listed with the veterinarians who hold it. The veterinarian directory answers
+ * "which specialties does this veterinarian hold"; this page answers "which veterinarians
+ * hold this specialty".
+ */
+@Controller
+class SpecialtyController {
+
+	private final SpecialtyRepository specialtyRepository;
+
+	private final VetRepository vetRepository;
+
+	SpecialtyController(SpecialtyRepository specialtyRepository, VetRepository vetRepository) {
+		this.specialtyRepository = specialtyRepository;
+		this.vetRepository = vetRepository;
+	}
+
+	@GetMapping("/specialties.html")
+	public String showSpecialtyList(Model model) {
+		model.addAttribute("specialties", buildDirectory());
+		return "specialties/specialtyList";
+	}
+
+	/**
+	 * Inverts the vet-to-specialties relationship into a specialty-to-vets view model.
+	 * The stored specialty set drives the rows, so a specialty held by no veterinarian
+	 * still appears; a veterinarian holding no specialty appears under no row.
+	 */
+	private List<SpecialtyDirectoryEntry> buildDirectory() {
+		Collection<Vet> allVets = this.vetRepository.findAll();
+		return this.specialtyRepository.findSpecialties()
+			.stream()
+			.map(specialty -> new SpecialtyDirectoryEntry(specialty.getName(),
+					veterinariansHolding(specialty, allVets)))
+			.toList();
+	}
+
+	private List<Vet> veterinariansHolding(Specialty specialty, Collection<Vet> allVets) {
+		return allVets.stream()
+			.filter(vet -> holds(vet, specialty))
+			.sorted(Comparator.comparing(Person::getLastName).thenComparing(Person::getFirstName))
+			.toList();
+	}
+
+	private boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> held.getId().equals(specialty.getId()));
+	}
+
+	/**
+	 * View model for one directory row: a specialty name and the veterinarians who hold
+	 * it, in presentation order.
+	 */
+	record SpecialtyDirectoryEntry(String name, List<Vet> veterinarians) {
+	}
+
+}
