+
+	/**
+	 * Retrieve the <code>Vet</code>s holding the given specialty, matched by whole name
+	 * case-insensitively, from the data store. Unpaged variant for the machine-readable
+	 * list.
+	 * @param specialty the whole specialty name to match, case-insensitively
+	 * @return a <code>Collection</code> of matching <code>Vet</code>s (empty when none
+	 * hold the specialty)
+	 * @throws DataAccessException
+	 */
+	@Transactional(readOnly = true)
+	// Shares the 'vets' cache deliberately: SimpleKeyGenerator keys differ by arity from
+	// the findAll variants (no collision); specialty data is static seed data so per-key
+	// growth is bounded.
+	@Cacheable("vets")
+	Collection<Vet> findBySpecialtiesNameIgnoreCase(String specialty) throws DataAccessException;
+
 }
