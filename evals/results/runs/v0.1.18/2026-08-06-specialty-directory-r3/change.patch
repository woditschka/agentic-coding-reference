+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.GetMapping;
+
+/**
+ * Serves the specialty directory: the inverse of the veterinarian directory. It lists
+ * every specialty the clinic knows by its stored name, and under each the veterinarians
+ * who hold it, plus a grouping for veterinarians who hold no specialty.
+ */
+@Controller
+class SpecialtyController {
+
+	private final SpecialtyRepository specialtyRepository;
+
+	private final VetRepository vetRepository;
+
+	public SpecialtyController(SpecialtyRepository specialtyRepository, VetRepository vetRepository) {
+		this.specialtyRepository = specialtyRepository;
+		this.vetRepository = vetRepository;
+	}
+
+	@GetMapping("/specialties.html")
+	public String showSpecialtyList(Model model) {
+		// The catalog is the source of truth: every specialty, in name order, so a
+		// specialty held by no veterinarian still appears.
+		List<Specialty> catalog = this.specialtyRepository.findSpecialties();
+
+		// findAll() returns an unordered Collection, so sort explicitly for a stable
+		// presentation rather than relying on database or insertion order.
+		List<Vet> vets = this.vetRepository.findAll()
+			.stream()
+			.sorted(Comparator.comparing(Vet::getLastName).thenComparing(Vet::getFirstName))
+			.toList();
+
+		// Invert the unidirectional Vet -> Specialty mapping. Vet-side and catalog-side
+		// Specialty instances differ (no equals/hashCode), so group by id, not by object.
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		List<Vet> vetsWithoutSpecialty = new ArrayList<>();
+		for (Vet vet : vets) {
+			if (vet.getNrOfSpecialties() == 0) {
+				vetsWithoutSpecialty.add(vet);
+			}
+			else {
+				for (Specialty specialty : vet.getSpecialties()) {
+					holdersBySpecialtyId.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(vet);
+				}
+			}
+		}
+
+		List<SpecialtyDirectoryEntry> directory = catalog.stream()
+			.map(specialty -> new SpecialtyDirectoryEntry(specialty,
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+
+		model.addAttribute("directory", directory);
+		model.addAttribute("vetsWithoutSpecialty", vetsWithoutSpecialty);
+		return "vets/specialtyList";
+	}
+
+	/**
+	 * One row of the specialty directory: a specialty and the veterinarians who hold it
+	 * (empty when no veterinarian holds it).
+	 */
+	record SpecialtyDirectoryEntry(Specialty specialty, List<Vet> vets) {
+	}
+
+}
