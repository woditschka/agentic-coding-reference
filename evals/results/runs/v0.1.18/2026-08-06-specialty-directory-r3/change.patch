+<!DOCTYPE html>
+
+<html xmlns:th="https://www.thymeleaf.org" th:replace="~{fragments/layout :: layout (~{::body},'vets')}">
+
+<body>
+
+  <h2 th:text="#{specialties}">Specialties</h2>
+
+  <table id="specialties" class="table table-striped">
+    <thead>
+      <tr>
+        <th th:text="#{specialties}">Specialties</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="entry : ${directory}">
+        <td th:text="${entry.specialty.name}"></td>
+        <td>
+          <span th:each="vet : ${entry.vets}" th:text="${vet.firstName + ' ' + vet.lastName + ' '}" />
+        </td>
+      </tr>
+      <tr th:if="${not #lists.isEmpty(vetsWithoutSpecialty)}">
+        <td th:text="#{noSpecialties}">No specialties</td>
+        <td>
+          <span th:each="vet : ${vetsWithoutSpecialty}" th:text="${vet.firstName + ' ' + vet.lastName + ' '}" />
+        </td>
+      </tr>
+    </tbody>
+  </table>
+</body>
+
+</html>
