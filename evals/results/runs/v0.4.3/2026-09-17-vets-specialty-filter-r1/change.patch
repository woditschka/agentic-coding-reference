 	@Cacheable("vets")
 	Page<Vet> findAll(Pageable pageable) throws DataAccessException;
 
+	/**
+	 * Retrieve the <code>Vet</code>s holding one named specialty, in Pages. The whole
+	 * name must match, disregarding case; the comparison is expressed in the query so it
+	 * holds on every supported database.
+	 * <p>
+	 * Unlike the reads above this one is deliberately not cached: its key would be
+	 * caller-supplied text and the <code>vets</code> cache has no eviction policy. See
+	 * <code>docs/adr/2026-09-17-uncached-specialty-narrowed-vet-reads.md</code>.
+	 * @param specialtyName the whole name of the specialty to narrow to
+	 * @param pageable the page to retrieve
+	 * @return a page of the matching <code>Vet</code>s, empty if none match
+	 * @throws DataAccessException if the store cannot be read
+	 */
+	@Transactional(readOnly = true)
+	Page<Vet> findBySpecialtiesNameIgnoreCase(String specialtyName, Pageable pageable) throws DataAccessException;
+
 }
