+package org.springframework.samples.petclinic.owner;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class PetTests {
+
+	private static final Integer BOOKED_VISIT_ID = 1;
+
+	private static final Integer OTHER_VISIT_ID = 2;
+
+	private static final Integer UNKNOWN_VISIT_ID = 99;
+
+	private static final Integer UNSAVED_ID = null;
+
+	@Test
+	void theVisitLookupShouldFindThePetsVisitById() {
+		Pet pet = createAPet();
+		Visit bookedVisit = createAVisitOf(pet, BOOKED_VISIT_ID);
+		createAVisitOf(pet, OTHER_VISIT_ID);
+
+		Visit found = pet.getVisit(BOOKED_VISIT_ID);
+
+		assertThat(found).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void theVisitLookupShouldFindNothingForAnIdThePetHasNoVisitWith() {
+		Pet pet = createAPet();
+		createAVisitOf(pet, BOOKED_VISIT_ID);
+
+		Visit found = pet.getVisit(UNKNOWN_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	@Test
+	void theVisitLookupShouldIgnoreAVisitNotYetSaved() {
+		Pet pet = createAPet();
+		createAVisitOf(pet, UNSAVED_ID);
+
+		Visit found = pet.getVisit(UNSAVED_ID);
+
+		assertThat(found).isNull();
+	}
+
+	private static Pet createAPet() {
+		return new Pet();
+	}
+
+	private static Visit createAVisitOf(Pet pet, Integer visitId) {
+		Visit visit = new Visit();
+		visit.setId(visitId);
+		pet.addVisit(visit);
+		return visit;
+	}
+
+}
