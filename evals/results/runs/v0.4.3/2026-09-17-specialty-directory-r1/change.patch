+	private static final String DIRECTORY_PAGE = "/specialties.html";
+
+	private static final Path TEMPLATE_ROOT = Path.of("src/main/resources/templates");
+
+	private static final String LINK_ATTRIBUTE = "href";
+
+	private static final String DIRECTORY_VIEW = "vets/specialtyList";
+
+	private static final String DIRECTORY_MODEL_ATTRIBUTE = "specialtyDirectory";
+
+	private static final String HELD_SPECIALTY_NAME = "radiology";
+
+	private static final String HOLDER_FIRST_NAME = "Helen";
+
+	private static final String HOLDER_LAST_NAME = "Leary";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private StoredSpecialties specialties;
+
+	@Autowired
+	private StoredVeterinarians veterinarians;
+
+	private final AtomicInteger nextIdentifier = new AtomicInteger(1);
+
+	@BeforeEach
+	void emptyTheClinic() {
+		this.specialties.clear();
+		this.veterinarians.clear();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHoldingVeterinarianByFullName() throws Exception {
+		Specialty heldSpecialty = createASpecialty(HELD_SPECIALTY_NAME);
+		this.specialties.store(heldSpecialty);
+		this.veterinarians.store(createAVeterinarian(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, heldSpecialty));
+
+		this.mockMvc.perform(get(DIRECTORY_PAGE))
+			.andExpect(status().isOk())
+			.andExpect(view().name(DIRECTORY_VIEW))
+			.andExpect(content().string(containsString(HELD_SPECIALTY_NAME)))
+			.andExpect(content().string(containsString(HOLDER_FIRST_NAME + " " + HOLDER_LAST_NAME)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeLinkedFromNoPage() throws IOException {
+		try (Stream<Path> templates = Files.walk(TEMPLATE_ROOT)) {
+			assertThat(templates.filter(Files::isRegularFile).filter(SpecialtyControllerTests::linksTo)).isEmpty();
+		}
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEmptyWhenTheClinicKnowsNoSpecialty() throws Exception {
+		this.mockMvc.perform(get(DIRECTORY_PAGE))
+			.andExpect(status().isOk())
+			.andExpect(view().name(DIRECTORY_VIEW))
+			.andExpect(model().attribute(DIRECTORY_MODEL_ATTRIBUTE, SpecialtyDirectory.of(List.of(), List.of())));
+	}
+
+	private static boolean linksTo(Path template) {
+		return readLines(template).stream()
+			.anyMatch(line -> line.contains(LINK_ATTRIBUTE) && line.contains(DIRECTORY_PAGE));
+	}
+
+	private static List<String> readLines(Path template) {
+		try {
+			return Files.readAllLines(template);
+		}
+		catch (IOException unreadable) {
+			throw new UncheckedIOException("could not read template " + template, unreadable);
+		}
+	}
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextIdentifier.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVeterinarian(String firstName, String lastName, Specialty... held) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(this.nextIdentifier.getAndIncrement());
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		List.of(held).forEach(veterinarian::addSpecialty);
+		return veterinarian;
+	}
+
+	@TestConfiguration
+	static class ClinicStores {
+
+		@Bean
+		StoredSpecialties storedSpecialties() {
+			return new StoredSpecialties();
+		}
+
+		@Bean
+		StoredVeterinarians storedVeterinarians() {
+			return new StoredVeterinarians();
+		}
+
+	}
+
+	/**
+	 * Hand-written stand-in for the specialty store, answering in stored-name order as
+	 * the repository's query does.
+	 */
+	static class StoredSpecialties implements SpecialtyRepository {
+
+		private final List<Specialty> stored = new ArrayList<>();
+
+		void store(Specialty... specialties) {
+			this.stored.addAll(List.of(specialties));
+		}
+
+		void clear() {
+			this.stored.clear();
+		}
+
+		@Override
+		public List<Specialty> findSpecialties() {
+			return this.stored.stream().sorted(Comparator.comparing(NamedEntity::getName)).toList();
+		}
+
+	}
+
+	/**
+	 * Hand-written stand-in for the veterinarian store. The specialty directory reads
+	 * every veterinarian and never pages, so the paged read is unsupported here.
+	 */
+	static class StoredVeterinarians implements VetRepository {
+
+		private final List<Vet> stored = new ArrayList<>();
+
+		void store(Vet... veterinarians) {
+			this.stored.addAll(List.of(veterinarians));
+		}
+
+		void clear() {
+			this.stored.clear();
+		}
+
+		@Override
+		public Collection<Vet> findAll() {
+			return List.copyOf(this.stored);
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("the specialty directory never pages veterinarians");
+		}
+
+	}
+
+}
