+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Read model inverting the relation {@link Vet} owns: it lists each {@link Specialty}
+ * with the veterinarians holding it. Built per request by {@link #of}, never persisted.
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Vet> BY_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Invert the veterinarian-to-specialty relation.
+	 * @param specialties the specialties to list, in the order they are listed in
+	 * @param veterinarians the veterinarians to distribute over them; one holding no
+	 * listed specialty appears in no entry
+	 * @return an entry per given specialty, its holders ordered by last name then first
+	 * name
+	 */
+	public static SpecialtyDirectory of(List<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = holdersBySpecialtyIdentifier(veterinarians);
+		return new SpecialtyDirectory(specialties.stream()
+			.map(specialty -> new Entry(specialty, holders.getOrDefault(specialty.getId(), List.of())))
+			.toList());
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyIdentifier(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : veterinarians.stream().sorted(BY_NAME).toList()) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), identifier -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holders;
+	}
+
+	/**
+	 * One specialty with the veterinarians holding it, empty when none does.
+	 */
+	public record Entry(Specialty specialty, List<Vet> veterinarians) {
+
+		public Entry {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+}
