+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the inversion of the
+ * veterinarian-to-specialty relation.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final List<Vet> NO_VETERINARIANS = List.of();
+
+	private static final List<Specialty> NO_SPECIALTIES = List.of();
+
+	private static final String SOME_FIRST_NAME = "Rafael";
+
+	private static final String SOME_LAST_NAME = "Ortega";
+
+	private static final String EARLIER_FIRST_NAME = "Ada";
+
+	private static final String LATER_FIRST_NAME = "Linda";
+
+	private static final String EARLIER_LAST_NAME = "Douglas";
+
+	private static final String LATER_LAST_NAME = "Leary";
+
+	private static final String SHARED_SPECIALTY_NAME = "radiology";
+
+	private final AtomicInteger nextIdentifier = new AtomicInteger(1);
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() {
+		Specialty firstSpecialty = createASpecialty();
+		Specialty secondSpecialty = createASpecialty();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(firstSpecialty, secondSpecialty),
+				NO_VETERINARIANS);
+
+		assertThat(directory.entries()).containsExactly(entryFor(firstSpecialty), entryFor(secondSpecialty));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHoldingVeterinarianUnderThatSpecialty() {
+		Specialty heldSpecialty = createASpecialty();
+		Vet douglas = createAVeterinarian(SOME_FIRST_NAME, EARLIER_LAST_NAME, heldSpecialty);
+		Vet leary = createAVeterinarian(SOME_FIRST_NAME, LATER_LAST_NAME, heldSpecialty);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(heldSpecialty), List.of(leary, douglas));
+
+		assertThat(directory.entries()).containsExactly(entryFor(heldSpecialty, douglas, leary));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowAVeterinarianUnderEverySpecialtyTheyHold() {
+		Specialty firstSpecialty = createASpecialty();
+		Specialty secondSpecialty = createASpecialty();
+		Vet holder = createAVeterinarian(firstSpecialty, secondSpecialty);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(firstSpecialty, secondSpecialty), List.of(holder));
+
+		assertThat(directory.entries()).containsExactly(entryFor(firstSpecialty, holder),
+				entryFor(secondSpecialty, holder));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty heldSpecialty = createASpecialty();
+		Vet holder = createAVeterinarian(heldSpecialty);
+		Vet holdsNothing = createAVeterinarianHoldingNoSpecialty();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(heldSpecialty), List.of(holder, holdsNothing));
+
+		assertThat(directory.entries()).containsExactly(entryFor(heldSpecialty, holder));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty heldSpecialty = createASpecialty();
+		Specialty unheldSpecialty = createASpecialty();
+		Vet holder = createAVeterinarian(heldSpecialty);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(heldSpecialty, unheldSpecialty), List.of(holder));
+
+		assertThat(directory.entries()).containsExactly(entryFor(heldSpecialty, holder), entryFor(unheldSpecialty));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenTheClinicKnowsNoSpecialty() {
+		Vet holder = createAVeterinarian(createASpecialty());
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(NO_SPECIALTIES, List.of(holder));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchVeterinariansToSpecialtiesByIdentifier() {
+		Specialty storedSpecialty = createASpecialty();
+		Vet holder = createAVeterinarian(createACopyOf(storedSpecialty));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(storedSpecialty), List.of(holder));
+
+		assertThat(directory.entries()).containsExactly(entryFor(storedSpecialty, holder));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepApartSpecialtiesSharingAStoredName() {
+		Specialty heldSpecialty = createASpecialty(SHARED_SPECIALTY_NAME);
+		Specialty unheldSpecialty = createASpecialty(SHARED_SPECIALTY_NAME);
+		Vet holder = createAVeterinarian(heldSpecialty);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(heldSpecialty, unheldSpecialty), List.of(holder));
+
+		assertThat(directory.entries()).containsExactly(entryFor(heldSpecialty, holder), entryFor(unheldSpecialty));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastNameThenFirstName() {
+		Specialty heldSpecialty = createASpecialty();
+		Vet leary = createAVeterinarian(SOME_FIRST_NAME, LATER_LAST_NAME, heldSpecialty);
+		Vet lindaDouglas = createAVeterinarian(LATER_FIRST_NAME, EARLIER_LAST_NAME, heldSpecialty);
+		Vet adaDouglas = createAVeterinarian(EARLIER_FIRST_NAME, EARLIER_LAST_NAME, heldSpecialty);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(heldSpecialty),
+				List.of(leary, lindaDouglas, adaDouglas));
+
+		assertThat(directory.entries()).containsExactly(entryFor(heldSpecialty, adaDouglas, lindaDouglas, leary));
+	}
+
+	private SpecialtyDirectory.Entry entryFor(Specialty specialty, Vet... holders) {
+		return new SpecialtyDirectory.Entry(specialty, List.of(holders));
+	}
+
+	private Specialty createASpecialty() {
+		return createASpecialty("specialty-" + this.nextIdentifier.get());
+	}
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextIdentifier.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Specialty createACopyOf(Specialty specialty) {
+		Specialty copy = new Specialty();
+		copy.setId(specialty.getId());
+		copy.setName(specialty.getName());
+		return copy;
+	}
+
+	private Vet createAVeterinarianHoldingNoSpecialty() {
+		return createAVeterinarian();
+	}
+
+	private Vet createAVeterinarian(Specialty... held) {
+		return createAVeterinarian(SOME_FIRST_NAME, SOME_LAST_NAME, held);
+	}
+
+	private Vet createAVeterinarian(String firstName, String lastName, Specialty... held) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(this.nextIdentifier.getAndIncrement());
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		List.of(held).forEach(veterinarian::addSpecialty);
+		return veterinarian;
+	}
+
+}
