+		Visit found = pet.getVisit(WANTED_VISIT_ID);
+
+		assertThat(found).isSameAs(wantedVisit);
+	}
+
+	@Test
+	void thePetShouldFindNoVisitForAnIdItDoesNotHave() {
+		Pet pet = createAPetWith(createAVisit(ANY_OTHER_VISIT_ID));
+
+		Visit found = pet.getVisit(UNKNOWN_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	@Test
+	void thePetShouldFindNoVisitThatIsNotYetSaved() {
+		Pet pet = createAPetWith(createAnUnsavedVisit());
+
+		Visit found = pet.getVisit(UNSAVED_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	private static Visit createAVisit(Integer id) {
+		Visit visit = createAnUnsavedVisit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+	private static Pet createAPetWith(Visit... visits) {
+		Pet pet = new Pet();
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+}
