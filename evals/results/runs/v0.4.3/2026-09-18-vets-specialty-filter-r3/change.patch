+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.junit.jupiter.params.provider.Arguments.arguments;
+
+import java.util.Collection;
+import java.util.List;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageRequest;
+
+/**
+ * Specialty-filtered veterinarian reads against the seeded database: radiology is held by
+ * Leary and Stevens, surgery by Douglas and Ortega, and Douglas also holds dentistry.
+ */
+@DataJpaTest
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VetRepositoryTests {
+
+	private static final String SURGERY = "surgery";
+
+	private static final List<String> SURGEONS = List.of("Douglas", "Ortega");
+
+	private static final PageRequest FIRST_PAGE_LARGER_THAN_ANY_MATCH = PageRequest.of(0, 10);
+
+	@Autowired
+	private VetRepository vets;
+
+	static Stream<Arguments> specialtyFiltersAndTheVetsTheyMatch() {
+		String radiology = "radiology";
+		String radiologyInMixedCase = "RaDiOlOgY";
+		String startOfRadiology = "radio";
+		String specialtyTheClinicDoesNotHave = "cardiology";
+		List<String> radiologists = List.of("Leary", "Stevens");
+		List<String> noVets = List.of();
+		return Stream.of(arguments(radiology, radiologists), arguments(radiologyInMixedCase, radiologists),
+				arguments(startOfRadiology, noVets), arguments(specialtyTheClinicDoesNotHave, noVets));
+	}
+
+	@ParameterizedTest
+	@MethodSource("specialtyFiltersAndTheVetsTheyMatch")
+	void theSpecialtyFilterShouldMatchTheWholeNameIgnoringCase(String specialty, List<String> expectedLastNames) {
+		Collection<Vet> found = this.vets.findDistinctBySpecialtiesNameIgnoreCase(specialty);
+
+		assertThat(found).extracting(Vet::getLastName).containsExactlyInAnyOrderElementsOf(expectedLastNames);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldListAVetWithSeveralSpecialtiesOnce() {
+		Page<Vet> found = this.vets.findDistinctBySpecialtiesNameIgnoreCase(SURGERY, FIRST_PAGE_LARGER_THAN_ANY_MATCH);
+
+		assertThat(found.getContent()).extracting(Vet::getLastName).containsExactlyInAnyOrderElementsOf(SURGEONS);
+		assertThat(found.getTotalElements()).isEqualTo(SURGEONS.size());
+	}
+
+}
