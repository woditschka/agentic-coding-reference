+	@Test
+	void theSpecialtyDirectoryShouldNotLetCallersChangeItsEntries() {
+		Specialty specialty = createASpecialty();
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(specialty), List.of(createAVetHolding(specialty)));
+
+		assertThat(directory.entries()).isUnmodifiable();
