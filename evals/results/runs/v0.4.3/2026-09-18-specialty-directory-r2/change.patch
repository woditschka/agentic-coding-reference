+package org.springframework.samples.petclinic.vet;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import java.util.Collection;
+import java.util.List;
+import java.util.Locale;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.MessageSource;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.ComponentScan;
+import org.springframework.context.annotation.FilterType;
+import org.springframework.context.annotation.Import;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageImpl;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+
+/**
+ * Drives the specialty directory page, and the pages sharing the site navigation, over
+ * one fixed clinic: a held specialty with one holder and a specialty nobody holds.
+ */
+@WebMvcTest(controllers = { SpecialtyController.class, VetController.class },
+		includeFilters = @ComponentScan.Filter(type = FilterType.REGEX,
+				pattern = "org\\.springframework\\.samples\\.petclinic\\.system\\.WelcomeController"))
+@Import(SpecialtyControllerTests.ClinicDoubles.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_DIRECTORY_PATH = "/specialties.html";
+
+	private static final String SPECIALTY_DIRECTORY_VIEW = "vets/specialtyList";
+
+	private static final String HELD_BY_NONE_MESSAGE_KEY = "none";
+
+	private static final String HELD_SPECIALTY_NAME = "radiology";
+
+	private static final String UNHELD_SPECIALTY_NAME = "dentistry";
+
+	private static final String HOLDER_FIRST_NAME = "Helen";
+
+	private static final String HOLDER_LAST_NAME = "Leary";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private MessageSource messages;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredNameOnOnePage() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(view().name(SPECIALTY_DIRECTORY_VIEW))
+			.andExpect(content().string(containsString(HELD_SPECIALTY_NAME)))
+			.andExpect(content().string(containsString(UNHELD_SPECIALTY_NAME)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderByFullName() throws Exception {
+		String fullName = HOLDER_FIRST_NAME + " " + HOLDER_LAST_NAME;
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(fullName)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowAnUnheldSpecialtyAsHeldByNone() throws Exception {
+		String heldByNone = messages.getMessage(HELD_BY_NONE_MESSAGE_KEY, null, Locale.ENGLISH);
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH).locale(Locale.ENGLISH))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(">" + heldByNone + "<")));
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { "/", "/vets.html" })
+	void theSiteNavigationShouldNotLinkToTheSpecialtyDirectory(String pageWithSiteNavigation) throws Exception {
+		mockMvc.perform(get(pageWithSiteNavigation))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString(SPECIALTY_DIRECTORY_PATH))));
+	}
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(int id, String firstName, String lastName, Specialty held) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		vet.addSpecialty(held);
+		return vet;
+	}
+
+	@TestConfiguration
+	static class ClinicDoubles {
+
+		private static final int SOME_HELD_SPECIALTY_ID = 1;
+
+		private static final int SOME_UNHELD_SPECIALTY_ID = 2;
+
+		private static final int SOME_VET_ID = 1;
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			List<Specialty> specialties = List.of(createASpecialty(SOME_HELD_SPECIALTY_ID, HELD_SPECIALTY_NAME),
+					createASpecialty(SOME_UNHELD_SPECIALTY_ID, UNHELD_SPECIALTY_NAME));
+			return () -> specialties;
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			Specialty held = createASpecialty(SOME_HELD_SPECIALTY_ID, HELD_SPECIALTY_NAME);
+			return new FixedVetRepository(List.of(createAVet(SOME_VET_ID, HOLDER_FIRST_NAME, HOLDER_LAST_NAME, held)));
+		}
+
+	}
+
+	private record FixedVetRepository(List<Vet> vets) implements VetRepository {
+
+		@Override
+		public Collection<Vet> findAll() {
+			return vets;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			return new PageImpl<>(vets, pageable, vets.size());
+		}
+
+	}
+
+}
