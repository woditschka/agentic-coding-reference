+	private static Specialty createASpecialty() {
+		return createASpecialty("specialty-" + NEXT_ID.get());
+	}
+
+	private static Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(NEXT_ID.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Specialty aSeparateInstanceOf(Specialty specialty) {
+		Specialty copy = new Specialty();
+		copy.setId(specialty.getId());
+		copy.setName(specialty.getName());
+		return copy;
+	}
+
+	private static Vet createAVetHolding(Specialty... specialties) {
+		int id = NEXT_ID.get();
+		return createAVet("first-" + id, "last-" + id, specialties);
+	}
+
+	private static Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(NEXT_ID.getAndIncrement());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private static SpecialtyDirectory.SpecialtyHolders specialtyHoldersOf(Specialty specialty, Vet... holders) {
+		return new SpecialtyDirectory.SpecialtyHolders(specialty, List.of(holders));
+	}
