+	@Test
+	void theSpecialtyDirectoryShouldOrderHoldersByLastNameThenFirstName() {
+		String earlierLastName = "Adams";
+		String laterLastName = "Smith";
+		String earlierFirstName = "Ann";
+		String laterFirstName = "Zoe";
+		Specialty specialty = createASpecialty();
+		Vet laterLastLaterFirst = createAVet(laterFirstName, laterLastName, specialty);
