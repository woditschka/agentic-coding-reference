+		Vet holder = createAVetHolding(specialty);
+		Vet vetHoldingNone = createAVetHolding();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(specialty), List.of(holder, vetHoldingNone));
+
+		assertThat(directory.entries()).containsExactly(specialtyHoldersOf(specialty, holder));
+	}
