+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Every specialty the clinic knows, each paired with the veterinarians holding it.
+ * Specialties are ordered by name and holders by last name, then first name; identity
+ * breaks ties so the order never depends on how the inputs were loaded.
+ *
+ * @param entries one entry per specialty, in directory order
+ */
+record SpecialtyDirectory(List<SpecialtyHolders> entries) {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		return new SpecialtyDirectory(specialties.stream()
+			.sorted(SPECIALTY_ORDER)
+			.map(specialty -> new SpecialtyHolders(specialty, holdersOf(specialty, vets)))
+			.toList());
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream().filter(vet -> holds(vet, specialty)).sorted(HOLDER_ORDER).toList();
+	}
+
+	// The vets and the specialties are loaded separately (the vets through a cache), so
+	// the same specialty arrives as distinct instances, and entities define no value
+	// equality: match on identity instead.
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it; a specialty nobody holds has no
+	 * holders.
+	 *
+	 * @param specialty the specialty listed
+	 * @param holders the veterinarians holding it, in directory order
+	 */
+	record SpecialtyHolders(Specialty specialty, List<Vet> holders) {
+
+		SpecialtyHolders {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+}
