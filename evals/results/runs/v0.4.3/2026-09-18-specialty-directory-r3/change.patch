+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.List;
+
+/**
+ * Every specialty the clinic knows, each listed with the veterinarians holding it. A
+ * veterinarian holding several specialties is listed under each; one holding none is
+ * listed under none.
+ *
+ * @param listings one listing per specialty, in the order the specialties were given
+ */
+record SpecialtyDirectory(List<Listing> listings) {
+
+	SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	/**
+	 * Specialties are matched by id rather than by object: a veterinarian's specialty and
+	 * the listed specialty are distinct instances when loaded separately, and
+	 * {@link Specialty} defines no value equality.
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		return new SpecialtyDirectory(specialties.stream().map(specialty -> listingFor(specialty, vets)).toList());
+	}
+
+	private static Listing listingFor(Specialty specialty, Collection<Vet> vets) {
+		List<Vet> holders = vets.stream().filter(vet -> holds(vet, specialty)).toList();
+		return new Listing(specialty.getName(), holders);
+	}
+
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> held.getId().equals(specialty.getId()));
+	}
+
+	/**
+	 * One specialty, by its stored name, with the veterinarians holding it.
+	 *
+	 * @param specialtyName the specialty's stored name
+	 * @param veterinarians the veterinarians holding the specialty; empty when none does
+	 */
+	record Listing(String specialtyName, List<Vet> veterinarians) {
+
+		Listing {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+}
