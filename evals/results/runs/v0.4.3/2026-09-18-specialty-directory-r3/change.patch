+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Listing;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Specifies how the {@link SpecialtyDirectory} inverts veterinarians' specialties into
+ * the veterinarians holding each specialty.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final int SURGERY_ID = 2;
+
+	private static final String SURGERY = "surgery";
+
+	private static final int ANY_VET_ID = 7;
+
+	private static final int ANY_OTHER_VET_ID = 8;
+
+	private static final String ANY_FIRST_NAME = "Any";
+
+	private static final String ANY_LAST_NAME = "Veterinarian";
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEverySpecialtyTheyHold() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY_ID, SURGERY);
+		Vet vetHoldingBoth = createAVet(ANY_VET_ID, radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(vetHoldingBoth));
+
+		assertThat(directory.listings()).containsExactly(createAListing(RADIOLOGY, vetHoldingBoth),
+				createAListing(SURGERY, vetHoldingBoth));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListNoVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet radiologist = createAVet(ANY_VET_ID, radiology);
+		Vet vetHoldingNone = createAVet(ANY_OTHER_VET_ID);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(radiologist, vetHoldingNone));
+
+		assertThat(directory.listings()).containsExactly(createAListing(RADIOLOGY, radiologist));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty unheldSurgery = createASpecialty(SURGERY_ID, SURGERY);
+		Vet radiologist = createAVet(ANY_VET_ID, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, unheldSurgery), List.of(radiologist));
+
+		assertThat(directory.listings()).containsExactly(createAListing(RADIOLOGY, radiologist),
+				createAListing(SURGERY));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchAHeldSpecialtyToTheListedOneByItsId() {
+		Specialty listedRadiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty heldRadiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet radiologist = createAVet(ANY_VET_ID, heldRadiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(listedRadiology), List.of(radiologist));
+
+		assertThat(directory.listings()).containsExactly(createAListing(RADIOLOGY, radiologist));
+	}
+
+	private static Listing createAListing(String specialtyName, Vet... holders) {
+		return new Listing(specialtyName, List.of(holders));
+	}
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(int id, Specialty... heldSpecialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(ANY_FIRST_NAME);
+		vet.setLastName(ANY_LAST_NAME);
+		for (Specialty specialty : heldSpecialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
