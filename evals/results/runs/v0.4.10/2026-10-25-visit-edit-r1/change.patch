+package org.springframework.samples.petclinic.owner;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	private static final int OTHER_VISIT_ID = 2;
+
+	private static final int UNKNOWN_VISIT_ID = 99;
+
+	private static final Integer NO_ID = null;
+
+	@Test
+	void thePetShouldFindItsBookedVisitById() {
+		Visit bookedVisit = createAVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWith(createAVisit(OTHER_VISIT_ID), bookedVisit);
+
+		Visit found = pet.getVisit(BOOKED_VISIT_ID);
+
+		assertThat(found).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldFindNoVisitForAnIdItDoesNotHold() {
+		Pet pet = createAPetWith(createAVisit(BOOKED_VISIT_ID));
+
+		Visit found = pet.getVisit(UNKNOWN_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	@Test
+	void thePetShouldNotMatchAnUnsavedVisitToAMissingId() {
+		Pet pet = createAPetWith(createAVisit(NO_ID));
+
+		Visit found = pet.getVisit(NO_ID);
+
+		assertThat(found).isNull();
+	}
+
+	private static Visit createAVisit(Integer id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Pet createAPetWith(Visit... visits) {
+		Pet pet = new Pet();
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+}
