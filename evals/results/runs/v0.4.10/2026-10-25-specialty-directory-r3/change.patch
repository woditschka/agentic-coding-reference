 	private final VetRepository vetRepository;
 
-	public VetController(VetRepository vetRepository) {
+	private final SpecialtyRepository specialtyRepository;
+
+	public VetController(VetRepository vetRepository, SpecialtyRepository specialtyRepository) {
 		this.vetRepository = vetRepository;
+		this.specialtyRepository = specialtyRepository;
+	}
+
+	@GetMapping("/specialties.html")
+	public String showSpecialtyDirectory(Model model) {
+		model.addAttribute("specialtyDirectory", buildSpecialtyDirectory());
+		return "vets/specialtyList";
+	}
+
+	/**
+	 * Inverts the vet-to-specialty holding. Keyed by specialty identifier because the
+	 * vets and the specialties are read separately and {@code Specialty} has no value
+	 * equality. A holding whose specialty is no longer stored is dropped.
+	 */
+	private Map<Specialty, List<Vet>> buildSpecialtyDirectory() {
+		Map<Specialty, List<Vet>> directory = new LinkedHashMap<>();
+		Map<Integer, List<Vet>> holdersById = new HashMap<>();
+		for (Specialty specialty : this.specialtyRepository.findAll()) {
+			List<Vet> holders = new ArrayList<>();
+			directory.put(specialty, holders);
+			holdersById.put(specialty.getId(), holders);
+		}
+		for (Vet vet : this.vetRepository.findAll()) {
+			for (Specialty held : vet.getSpecialties()) {
+				List<Vet> holders = holdersById.get(held.getId());
+				if (holders != null) {
+					holders.add(vet);
+				}
+			}
+		}
+		return directory;
 	}
 
 	@GetMapping("/vets.html")
