+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The inverse of the vet list: each specialty with the full names of the veterinarians
+ * holding it. A specialty nobody holds is listed with no holders.
+ *
+ * @param entries one entry per specialty
+ */
+record SpecialtyDirectory(List<Entry> entries) {
+
+	SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Groups holders by specialty identity: the specialties and the vets come from
+	 * separate reads, so the same specialty is a different instance on each side.
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<String>> holdersBySpecialtyId = holdersBySpecialtyId(vets);
+		List<Entry> entries = specialties.stream()
+			.map(specialty -> new Entry(specialty.getName(),
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static Map<Integer, List<String>> holdersBySpecialtyId(Collection<Vet> vets) {
+		Map<Integer, List<String>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet vet : vets) {
+			String fullName = vet.getFirstName() + " " + vet.getLastName();
+			for (Specialty held : vet.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(fullName);
+			}
+		}
+		return holdersBySpecialtyId;
+	}
+
+	record Entry(String name, List<String> holders) {
+
+		Entry {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+}
