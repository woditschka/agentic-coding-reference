+package org.springframework.samples.petclinic.vet;
+
+/**
+ * Test-owned construction of veterinarians and specialties, shared by the vet package
+ * suites so a change to the entities touches one place.
+ */
+final class VetTestFactory {
+
+	private static final int SOME_VET_ID = 10;
+
+	private VetTestFactory() {
+	}
+
+	static Specialty createSpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	static Vet createVet(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(SOME_VET_ID);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
