+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.samples.petclinic.vet.VetTestFactory.createSpecialty;
+import static org.springframework.samples.petclinic.vet.VetTestFactory.createVet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+class SpecialtyDirectoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int DENTISTRY_ID = 3;
+
+	private static final String HELEN_FIRST_NAME = "Helen";
+
+	private static final String HELEN_LAST_NAME = "Leary";
+
+	private static final String HELEN_FULL_NAME = HELEN_FIRST_NAME + " " + HELEN_LAST_NAME;
+
+	private static final String JAMES_FIRST_NAME = "James";
+
+	private static final String JAMES_LAST_NAME = "Carter";
+
+	private static final String JAMES_FULL_NAME = JAMES_FIRST_NAME + " " + JAMES_LAST_NAME;
+
+	private SpecialtyDirectory.Entry entry(SpecialtyDirectory directory, String specialtyName) {
+		return directory.entries().stream().filter(e -> e.name().equals(specialtyName)).findFirst().orElseThrow();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredNameOnOnePage() {
+		List<Specialty> specialties = List.of(createSpecialty(RADIOLOGY_ID, RADIOLOGY),
+				createSpecialty(SURGERY_ID, SURGERY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, List.of());
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::name)
+			.containsExactlyInAnyOrder(RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenNoSpecialtyExists() {
+		Vet helen = createVet(HELEN_FIRST_NAME, HELEN_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(helen));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderByFirstThenLastName() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet helen = createVet(HELEN_FIRST_NAME, HELEN_LAST_NAME, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(entry(directory, RADIOLOGY))
+			.isEqualTo(new SpecialtyDirectory.Entry(RADIOLOGY, List.of(HELEN_FULL_NAME)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet helen = createVet(HELEN_FIRST_NAME, HELEN_LAST_NAME, radiology);
+		Vet james = createVet(JAMES_FIRST_NAME, JAMES_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, james));
+
+		assertThat(directory.entries().stream().flatMap(e -> e.holders().stream())).doesNotContain(JAMES_FULL_NAME);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAnUnheldSpecialtyWithNoVeterinarian() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty dentistry = createSpecialty(DENTISTRY_ID, DENTISTRY);
+		Vet helen = createVet(HELEN_FIRST_NAME, HELEN_LAST_NAME, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, dentistry), List.of(helen));
+
+		assertThat(entry(directory, DENTISTRY)).isEqualTo(new SpecialtyDirectory.Entry(DENTISTRY, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyHeld() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty surgery = createSpecialty(SURGERY_ID, SURGERY);
+		Vet helen = createVet(HELEN_FIRST_NAME, HELEN_LAST_NAME, radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(entry(directory, RADIOLOGY).holders()).containsExactly(HELEN_FULL_NAME);
+		assertThat(entry(directory, SURGERY).holders()).containsExactly(HELEN_FULL_NAME);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchHoldersToSpecialtiesByIdentityNotInstance() {
+		Specialty listedRadiology = createSpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty heldRadiology = createSpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet helen = createVet(HELEN_FIRST_NAME, HELEN_LAST_NAME, heldRadiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(listedRadiology), List.of(helen));
+
+		assertThat(entry(directory, RADIOLOGY).holders()).containsExactly(HELEN_FULL_NAME);
+	}
+
+}
