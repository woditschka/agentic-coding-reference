+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+class VisitTests {
+
+	private static final LocalDate TODAY = LocalDate.of(2026, 3, 15);
+
+	@Test
+	void theVisitShouldBeDatedOnOrBeforeTodayWhenDatedToday() {
+		Visit visit = createAVisitDated(TODAY);
+
+		assertThat(visit.isDatedOnOrBefore(TODAY)).isTrue();
+	}
+
+	@Test
+	void theVisitShouldBeDatedOnOrBeforeTodayWhenDatedEarlier() {
+		Visit visit = createAVisitDated(TODAY.minusDays(1));
+
+		assertThat(visit.isDatedOnOrBefore(TODAY)).isTrue();
+	}
+
+	@Test
+	void theVisitShouldNotBeDatedOnOrBeforeTodayWhenDatedLater() {
+		Visit visit = createAVisitDated(TODAY.plusDays(1));
+
+		assertThat(visit.isDatedOnOrBefore(TODAY)).isFalse();
+	}
+
+	@Test
+	void theVisitShouldNotBeDatedOnOrBeforeTodayWhenUndated() {
+		Visit visit = createAVisitDated(null);
+
+		assertThat(visit.isDatedOnOrBefore(TODAY)).isFalse();
+	}
+
+	private static Visit createAVisitDated(LocalDate date) {
+		Visit visit = new Visit();
+		visit.setDate(date);
+		return visit;
+	}
+
+}
