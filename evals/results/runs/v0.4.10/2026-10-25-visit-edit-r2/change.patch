+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Unit tests for the visit lookup of {@link Pet}.
+ */
+class PetTests {
+
+	private static final int HELD_VISIT_ID = 1;
+
+	private static final int UNHELD_VISIT_ID = 2;
+
+	@Test
+	void thePetShouldReturnTheVisitWithTheGivenId() {
+		Visit heldVisit = createAVisitWithId(HELD_VISIT_ID);
+		Pet pet = new Pet();
+		pet.addVisit(heldVisit);
+
+		assertThat(pet.getVisit(HELD_VISIT_ID)).isSameAs(heldVisit);
+	}
+
+	@Test
+	void thePetShouldReturnNoVisitForAnIdItDoesNotHold() {
+		Pet pet = new Pet();
+		pet.addVisit(createAVisitWithId(HELD_VISIT_ID));
+
+		assertThat(pet.getVisit(UNHELD_VISIT_ID)).isNull();
+	}
+
+	@Test
+	void thePetShouldNotReturnAnUnsavedVisitForANullId() {
+		Pet pet = new Pet();
+		pet.addVisit(new Visit());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	private static Visit createAVisitWithId(int visitId) {
+		Visit visit = new Visit();
+		visit.setId(visitId);
+		return visit;
+	}
+
+}
