+package org.springframework.samples.petclinic.vet;
+
+/**
+ * Construction of specialties and veterinarians shared by the specialty directory suites.
+ */
+final class SpecialtyTestData {
+
+	static final String RADIOLOGY = "radiology";
+
+	static final String SURGERY = "surgery";
+
+	static final String DENTISTRY = "dentistry";
+
+	static final String HOLDER_FIRST_NAME = "Helen";
+
+	static final String HOLDER_LAST_NAME = "Leary";
+
+	static final String HOLDER_FULL_NAME = HOLDER_FIRST_NAME + " " + HOLDER_LAST_NAME;
+
+	private SpecialtyTestData() {
+	}
+
+	static Specialty createSpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	static Vet createVet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
