@@ -0,0 +1,104 @@
+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.samples.petclinic.vet.SpecialtyTestData.DENTISTRY;
+import static org.springframework.samples.petclinic.vet.SpecialtyTestData.HOLDER_FIRST_NAME;
+import static org.springframework.samples.petclinic.vet.SpecialtyTestData.HOLDER_FULL_NAME;
+import static org.springframework.samples.petclinic.vet.SpecialtyTestData.HOLDER_LAST_NAME;
+import static org.springframework.samples.petclinic.vet.SpecialtyTestData.RADIOLOGY;
+import static org.springframework.samples.petclinic.vet.SpecialtyTestData.SURGERY;
+import static org.springframework.samples.petclinic.vet.SpecialtyTestData.createSpecialty;
+import static org.springframework.samples.petclinic.vet.SpecialtyTestData.createVet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+class SpecialtyDirectoryTests {
+
+	private static Specialty copyOf(Specialty specialty) {
+		return createSpecialty(specialty.getId(), specialty.getName());
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredNameOnOnePage() {
+		Specialty radiology = createSpecialty(1, RADIOLOGY);
+		Specialty surgery = createSpecialty(2, SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of());
+
+		assertThat(directory.listings()).containsExactly(new SpecialtyDirectory.Listing(radiology, List.of()),
+				new SpecialtyDirectory.Listing(surgery, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHolderByFirstThenLastName() {
+		Specialty radiology = createSpecialty(1, RADIOLOGY);
+		Vet helen = createVet(2, HOLDER_FIRST_NAME, HOLDER_LAST_NAME, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory.listings()).extracting(SpecialtyDirectory.Listing::holderNames)
+			.containsExactly(List.of(HOLDER_FULL_NAME));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianWithNoSpecialtyUnderNoSpecialty() {
+		Specialty radiology = createSpecialty(1, RADIOLOGY);
+		Vet james = createVet(1, "James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(james));
+
+		assertThat(directory.listings()).containsExactly(new SpecialtyDirectory.Listing(radiology, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty radiology = createSpecialty(1, RADIOLOGY);
+		Specialty surgery = createSpecialty(2, SURGERY);
+		Vet linda = createVet(3, "Linda", "Douglas", radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(linda));
+
+		assertThat(directory.listings()).containsExactly(new SpecialtyDirectory.Listing(radiology, List.of(linda)),
+				new SpecialtyDirectory.Listing(surgery, List.of(linda)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchHoldersBySpecialtyIdNotInstance() {
+		Specialty stored = createSpecialty(1, RADIOLOGY);
+		Vet helen = createVet(2, HOLDER_FIRST_NAME, HOLDER_LAST_NAME, copyOf(stored));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(stored), List.of(helen));
+
+		assertThat(directory.listings()).containsExactly(new SpecialtyDirectory.Listing(stored, List.of(helen)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowASpecialtyHeldByNoVeterinarianAsHeldByNone() {
+		Specialty radiology = createSpecialty(1, RADIOLOGY);
+		Specialty surgery = createSpecialty(2, SURGERY);
+		Vet helen = createVet(2, HOLDER_FIRST_NAME, HOLDER_LAST_NAME, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(directory.listings()).extracting(SpecialtyDirectory.Listing::holders)
+			.containsExactly(List.of(helen), List.of());
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByNameAndHoldersByLastThenFirstName() {
+		Specialty surgery = createSpecialty(2, SURGERY);
+		Specialty dentistry = createSpecialty(3, DENTISTRY);
+		Vet carterRita = createVet(4, "Rita", "Carter", surgery);
+		Vet carterJames = createVet(1, "James", "Carter", surgery);
+		Vet douglas = createVet(3, "Linda", "Douglas", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry),
+				List.of(douglas, carterRita, carterJames));
+
+		assertThat(directory.listings()).containsExactly(new SpecialtyDirectory.Listing(dentistry, List.of()),
+				new SpecialtyDirectory.Listing(surgery, List.of(carterJames, carterRita, douglas)));
+	}
+
+}
