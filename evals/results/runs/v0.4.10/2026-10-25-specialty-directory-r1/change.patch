+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderSpecialtiesWithHoldersAndNoPaginationControls() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(content().string(containsString(RADIOLOGY)))
+			.andExpect(content().string(containsString(HOLDER_FULL_NAME)))
+			.andExpect(content().string(not(containsString("fa-step-forward"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldEscapeStoredSpecialtyNames() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(content().string(containsString(ESCAPED_MARKUP_SPECIALTY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowASpecialtyHeldByNoVeterinarianAsHeldByNone() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH)).andExpect(content().string(containsString("<span>none</span>")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheStandardNavigation() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(content().string(containsString("/owners/find")))
+			.andExpect(content().string(containsString("/vets.html")));
+	}
+
+	@Test
+	void theExistingPagesShouldCarryNoLinkToTheSpecialtyDirectory() throws IOException {
+		List<Path> linkingTemplates;
+		try (Stream<Path> templates = Files.walk(Path.of("src/main/resources/templates"))) {
+			linkingTemplates = templates.filter(p -> p.toString().endsWith(".html"))
+				.filter(p -> !p.endsWith("specialtyList.html"))
+				.filter(p -> contains(p, "specialties.html"))
+				.toList();
+		}
+
+		assertThat(linkingTemplates).isEmpty();
+	}
+
+	private static boolean contains(Path file, String text) {
+		try {
+			return Files.readString(file).contains(text);
+		}
+		catch (IOException e) {
+			throw new IllegalStateException("Cannot read template " + file, e);
+		}
+	}
+
+}
