+package org.springframework.samples.petclinic.vet;
+
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.GetMapping;
+
+@Controller
+class SpecialtyController {
+
+	private final SpecialtyRepository specialtyRepository;
+
+	private final VetRepository vetRepository;
+
+	public SpecialtyController(SpecialtyRepository specialtyRepository, VetRepository vetRepository) {
+		this.specialtyRepository = specialtyRepository;
+		this.vetRepository = vetRepository;
+	}
+
+	@GetMapping("/specialties.html")
+	public String showSpecialtyDirectory(Model model) {
+		model.addAttribute("specialtyDirectory",
+				SpecialtyDirectory.of(this.specialtyRepository.findAll(), this.vetRepository.findAll()));
+		return "vets/specialtyList";
+	}
+
+}
diff --git a/src/main/java/org/springframework/samples/petclinic/vet/SpecialtyDirectory.java b/src/main/java/org/springframework/samples/petclinic/vet/SpecialtyDirectory.java
new file mode 100644
index 0000000..122c1d5
--- /dev/null
+++ b/src/main/java/org/springframework/samples/petclinic/vet/SpecialtyDirectory.java
@@ -0,0 +1,58 @@
+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+
+/**
+ * The inverse of the vet list: for each specialty, the veterinarians holding it.
+ * Specialties are ordered by name, holders by last name, then first name.
+ *
+ * @param listings one entry per specialty, including those no veterinarian holds
+ */
+public record SpecialtyDirectory(List<Listing> listings) {
+
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	public SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	/**
+	 * Holders are matched by specialty id: the stored specialties and those inside cached
+	 * veterinarians are distinct instances without value equality.
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		List<Listing> listings = specialties.stream()
+			.sorted(Comparator.comparing(NamedEntity::getName))
+			.map(specialty -> new Listing(specialty, holdersOf(specialty, vets)))
+			.toList();
+		return new SpecialtyDirectory(listings);
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream()
+			.filter(vet -> vet.getSpecialties().stream().anyMatch(held -> held.getId().equals(specialty.getId())))
+			.sorted(HOLDER_ORDER)
+			.toList();
+	}
+
+	/**
+	 * One specialty with the veterinarians holding it.
+	 */
+	public record Listing(Specialty specialty, List<Vet> holders) {
+
+		public Listing {
+			holders = List.copyOf(holders);
+		}
+
+		public List<String> holderNames() {
+			return holders.stream().map(vet -> vet.getFirstName() + " " + vet.getLastName()).toList();
+		}
+
+	}
+
+}
