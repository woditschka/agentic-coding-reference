+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.samples.petclinic.vet.SpecialtyTestData.DENTISTRY;
+import static org.springframework.samples.petclinic.vet.SpecialtyTestData.HOLDER_FULL_NAME;
+import static org.springframework.samples.petclinic.vet.SpecialtyTestData.RADIOLOGY;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+
+@SpringBootTest
+class SpecialtyDirectoryIntegrationTests {
+
+	@Autowired
+	private SpecialtyRepository specialties;
+
+	@Autowired
+	private VetRepository vets;
+
+	@Test
+	void theSpecialtyDirectoryShouldListSeededHoldersByNameUnderTheirSeededSpecialty() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties.findAll(), vets.findAll());
+
+		SpecialtyDirectory.Listing radiology = directory.listings()
+			.stream()
+			.filter(listing -> listing.specialty().getName().equals(RADIOLOGY))
+			.findFirst()
+			.orElseThrow();
+		assertThat(radiology.holderNames()).contains(HOLDER_FULL_NAME);
+		assertThat(directory.listings()).extracting(listing -> listing.specialty().getName()).contains(DENTISTRY);
+	}
+
+}
diff --git a/src/test/java/org/springframework/samples/petclinic/vet/SpecialtyDirectoryTests.java b/src/test/java/org/springframework/samples/petclinic/vet/SpecialtyDirectoryTests.java
