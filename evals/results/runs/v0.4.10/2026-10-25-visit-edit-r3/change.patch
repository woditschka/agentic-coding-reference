+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Unit tests for the visit lookup a {@link Pet} owns.
+ */
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	private static final int OTHER_PETS_VISIT_ID = 2;
+
+	private static final int UNKNOWN_VISIT_ID = 99;
+
+	private static Pet createAPet() {
+		return new Pet();
+	}
+
+	private static Visit createABookedVisit(int id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+	@Test
+	void theVisitLookupShouldResolveOneOfThePetsOwnBookedVisits() {
+		Pet pet = createAPet();
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		pet.addVisit(bookedVisit);
+
+		Visit found = pet.getVisit(BOOKED_VISIT_ID);
+
+		assertThat(found).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void theVisitLookupShouldResolveNothingForAnUnknownIdentifier() {
+		Pet pet = createAPet();
+		pet.addVisit(createABookedVisit(BOOKED_VISIT_ID));
+
+		Visit found = pet.getVisit(UNKNOWN_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	@Test
+	void theVisitLookupShouldResolveNothingForAVisitBookedForAnotherPet() {
+		Pet pet = createAPet();
+		pet.addVisit(createABookedVisit(BOOKED_VISIT_ID));
+		Pet otherPet = createAPet();
+		otherPet.addVisit(createABookedVisit(OTHER_PETS_VISIT_ID));
+
+		Visit found = pet.getVisit(OTHER_PETS_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	@Test
+	void theVisitLookupShouldNeverResolveAnUnsavedVisit() {
+		Pet pet = createAPet();
+		pet.addVisit(createAnUnsavedVisit());
+
+		Visit found = pet.getVisit(null);
+
+		assertThat(found).isNull();
+	}
+
+}
