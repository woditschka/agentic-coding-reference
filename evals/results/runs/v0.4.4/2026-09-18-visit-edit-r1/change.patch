+package org.springframework.samples.petclinic.owner;
+
+import org.junit.jupiter.api.Test;
+
+import java.time.LocalDate;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link Pet}.
+ */
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 7;
+
+	private static final int VISIT_ID_OF_ANOTHER_PET = 8;
+
+	private static final String SOME_DESCRIPTION = "Annual check-up";
+
+	private static final LocalDate SOME_FUTURE_DATE = LocalDate.now().plusDays(1);
+
+	@Test
+	void thePetShouldResolveItsBookedVisitById() {
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetHolding(bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldResolveNoVisitItDoesNotHold() {
+		Pet pet = createAPetHolding(createABookedVisit(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(VISIT_ID_OF_ANOTHER_PET)).isNull();
+	}
+
+	@Test
+	void thePetShouldResolveNoVisitThatIsNotYetBooked() {
+		Pet pet = createAPetHolding(createAnUnbookedVisit());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	private Pet createAPetHolding(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+	private Visit createABookedVisit(int visitId) {
+		Visit visit = createAnUnbookedVisit();
+		visit.setId(visitId);
+		return visit;
+	}
+
+	private Visit createAnUnbookedVisit() {
+		Visit visit = new Visit();
+		visit.setDate(SOME_FUTURE_DATE);
+		visit.setDescription(SOME_DESCRIPTION);
+		return visit;
+	}
+
+}
