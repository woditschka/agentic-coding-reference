+	 * @param specialtyName the whole name of the specialty, in any letter case
+	 * @return the matching <code>Vet</code>s, each with every specialty they hold
+	 */
+	@Transactional(readOnly = true)
+	Collection<Vet> findDistinctBySpecialtiesNameIgnoreCase(String specialtyName) throws DataAccessException;
+
+	/**
+	 * Retrieve one page of the <code>Vet</code>s holding the named {@link Specialty},
+	 * matching its whole name regardless of letter case. The page count covers only the
+	 * matching <code>Vet</code>s. Deliberately not cached, for the same reason as the
+	 * unpaged read.
+	 * @param specialtyName the whole name of the specialty, in any letter case
+	 * @param pageable the page to retrieve
+	 * @return the requested page of matching <code>Vet</code>s
+	 */
+	@Transactional(readOnly = true)
+	Page<Vet> findDistinctBySpecialtiesNameIgnoreCase(String specialtyName, Pageable pageable)
+			throws DataAccessException;
+
 }
