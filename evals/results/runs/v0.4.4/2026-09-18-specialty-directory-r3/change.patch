+	private InMemorySpecialties specialties;
+
+	@Autowired
+	private InMemoryVets vets;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredNameOnOnePage() throws Exception {
+		Specialty radiology = aSpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty dentistry = aSpecialty(DENTISTRY_ID, DENTISTRY);
+		specialties.hold(radiology, dentistry);
+		vets.hold(aVet(HELEN, LEARY, radiology));
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ROUTE))
+			.andExpect(status().isOk())
+			.andExpect(view().name(SPECIALTY_DIRECTORY_VIEW))
+			.andExpect(model().attribute(SPECIALTY_DIRECTORY_ATTRIBUTE,
+					directoryOf(entry(DENTISTRY), entry(RADIOLOGY, HELEN_LEARY))))
+			.andExpect(content()
+				.string(allOf(containsString(DENTISTRY), containsString(RADIOLOGY), containsString(HELEN_LEARY))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheStandardNavigation() throws Exception {
+		specialties.hold();
+		vets.hold();
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ROUTE))
+			.andExpect(content().string(allOf(containsString(OWNER_SEARCH_LINK), containsString(VET_DIRECTORY_LINK))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderStoredNamesAsText() throws Exception {
+		specialties.hold(aSpecialty(RADIOLOGY_ID, MARKUP_IN_STORED_NAME));
+		vets.hold();
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ROUTE))
+			.andExpect(content().string(
+					allOf(containsString(ESCAPED_MARKUP_IN_STORED_NAME), not(containsString(MARKUP_IN_STORED_NAME)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOfferNoWayToChangeVeterinariansOrSpecialties() throws Exception {
+		specialties.hold(aSpecialty(RADIOLOGY_ID, RADIOLOGY));
+		vets.hold();
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ROUTE)).andExpect(content().string(not(containsString(ANY_FORM))));
+		mockMvc.perform(post(SPECIALTY_DIRECTORY_ROUTE)).andExpect(status().isMethodNotAllowed());
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotBeLinkedFromNavigation() throws IOException {
+		List<Path> templatesLinkingTheDirectory;
+		try (Stream<Path> templates = Files.walk(TEMPLATES)) {
+			templatesLinkingTheDirectory = templates.filter(Files::isRegularFile)
+				.filter(template -> contentOf(template).contains(SPECIALTY_DIRECTORY_ROUTE))
+				.toList();
+		}
+
+		assertThat(templatesLinkingTheDirectory).isEmpty();
+	}
+
+	private static String contentOf(Path template) {
+		try {
+			return Files.readString(template);
+		}
+		catch (IOException ex) {
+			throw new IllegalStateException("Cannot read template " + template, ex);
+		}
+	}
+
+	private static Specialty aSpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet aVet(String firstName, String lastName, Specialty... specialtiesHeld) {
+		Vet vet = new Vet();
+		vet.setId(ANY_VET_ID);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(specialtiesHeld).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static SpecialtyDirectory directoryOf(SpecialtyDirectory.Entry... entries) {
+		return new SpecialtyDirectory(List.of(entries));
+	}
+
+	private static SpecialtyDirectory.Entry entry(String specialtyName, String... holderNames) {
+		return new SpecialtyDirectory.Entry(specialtyName, List.of(holderNames));
+	}
+
+	@TestConfiguration
+	static class InMemoryRepositories {
+
+		@Bean
+		InMemorySpecialties specialties() {
+			return new InMemorySpecialties();
+		}
+
+		@Bean
+		InMemoryVets vets() {
+			return new InMemoryVets();
+		}
+
+	}
+
+	static class InMemorySpecialties implements SpecialtyRepository {
+
+		private List<Specialty> held = List.of();
+
+		void hold(Specialty... specialties) {
+			held = List.of(specialties);
+		}
+
+		@Override
+		public Collection<Specialty> findAll() {
+			return held;
+		}
+
+	}
+
+	static class InMemoryVets implements VetRepository {
+
+		private List<Vet> held = List.of();
+
+		void hold(Vet... vets) {
+			held = List.of(vets);
+		}
+
+		@Override
+		public Collection<Vet> findAll() {
+			return held;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("The specialty directory reads no page of veterinarians");
+		}
+
+	}
+
+}
