+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The inverse of the vet list: every specialty the clinic knows, each with the full names
+ * of the veterinarians holding it.
+ *
+ * <p>
+ * Holders are grouped by specialty identity, never by instance: the specialties and the
+ * veterinarians come from separate reads, and {@link Specialty} defines no value
+ * equality. Every ordering ends in identity so that equal names still sort the same way
+ * on every request.
+ */
+record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(vets);
+		return new SpecialtyDirectory(specialties.stream()
+			.sorted(SPECIALTY_ORDER)
+			.map(specialty -> Entry.of(specialty, holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList());
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> vets) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet vet : vets) {
+			for (Specialty specialty : vet.getSpecialties()) {
+				holders.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(vet);
+			}
+		}
+		return holders;
+	}
+
+	/**
+	 * One specialty by its stored name, with its holders' full names.
+	 */
+	record Entry(String specialtyName, List<String> holderNames) {
+
+		Entry {
+			holderNames = List.copyOf(holderNames);
+		}
+
+		private static Entry of(Specialty specialty, List<Vet> holders) {
+			return new Entry(specialty.getName(), holders.stream().sorted(HOLDER_ORDER).map(Entry::fullName).toList());
+		}
+
+		private static String fullName(Vet vet) {
+			return vet.getFirstName() + " " + vet.getLastName();
+		}
+
+	}
+
+}
