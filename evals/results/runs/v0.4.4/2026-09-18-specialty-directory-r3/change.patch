+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+
+class SpecialtyDirectoryTests {
+
+	private static final AtomicInteger NEXT_ID = new AtomicInteger();
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String HELEN = "Helen";
+
+	private static final String LINDA = "Linda";
+
+	private static final String RAFAEL = "Rafael";
+
+	private static final String LEARY = "Leary";
+
+	private static final String DOUGLAS = "Douglas";
+
+	private static final String ORTEGA = "Ortega";
+
+	private static final String HELEN_LEARY = HELEN + " " + LEARY;
+
+	private static final String HELEN_DOUGLAS = HELEN + " " + DOUGLAS;
+
+	private static final String LINDA_DOUGLAS = LINDA + " " + DOUGLAS;
+
+	private static final String RAFAEL_ORTEGA = RAFAEL + " " + ORTEGA;
+
+	private static final String ANY_FIRST_NAME = "AnyFirstName";
+
+	private static final String ANY_LAST_NAME = "AnyLastName";
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderByFirstThenLastName() {
+		Specialty radiology = aSpecialty(RADIOLOGY);
+		Vet holder = aVet(HELEN, LEARY, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(holder));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(RADIOLOGY, HELEN + " " + LEARY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansWithoutSpecialty() {
+		Specialty radiology = aSpecialty(RADIOLOGY);
+		Vet holder = aVet(HELEN, LEARY, radiology);
+		Vet vetWithoutSpecialty = aVet(ANY_FIRST_NAME, ANY_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(holder, vetWithoutSpecialty));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(RADIOLOGY, HELEN_LEARY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListVeterinarianUnderEverySpecialtyHeld() {
+		Specialty dentistry = aSpecialty(DENTISTRY);
+		Specialty surgery = aSpecialty(SURGERY);
+		Vet holderOfBoth = aVet(LINDA, DOUGLAS, dentistry, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, surgery), List.of(holderOfBoth));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(DENTISTRY, LINDA_DOUGLAS), entry(SURGERY, LINDA_DOUGLAS)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListUnheldSpecialtyWithNoVeterinarian() {
+		Specialty unheld = aSpecialty(DENTISTRY);
+		Specialty radiology = aSpecialty(RADIOLOGY);
+		Vet holder = aVet(HELEN, LEARY, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(unheld, radiology), List.of(holder));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(DENTISTRY), entry(RADIOLOGY, HELEN_LEARY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldGroupHoldersBySpecialtyIdentityNotInstance() {
+		Specialty storedRadiology = aSpecialty(RADIOLOGY);
+		Vet holder = aVet(HELEN, LEARY, anotherInstanceOf(storedRadiology));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(storedRadiology), List.of(holder));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(RADIOLOGY, HELEN_LEARY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentEntriesInStableOrder() {
+		Specialty dentistry = aSpecialty(DENTISTRY);
+		Specialty earlierSurgery = aSpecialty(SURGERY);
+		Specialty laterSurgery = aSpecialty(SURGERY);
+		Vet rafaelOrtega = aVet(RAFAEL, ORTEGA, dentistry);
+		Vet lindaDouglas = aVet(LINDA, DOUGLAS, dentistry, laterSurgery);
+		Vet helenDouglas = aVet(HELEN, DOUGLAS, dentistry);
+		Vet helenLeary = aVet(HELEN, LEARY, earlierSurgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(laterSurgery, earlierSurgery, dentistry),
+				List.of(rafaelOrtega, lindaDouglas, helenLeary, helenDouglas));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(DENTISTRY, HELEN_DOUGLAS, LINDA_DOUGLAS, RAFAEL_ORTEGA),
+				entry(SURGERY, HELEN_LEARY), entry(SURGERY, LINDA_DOUGLAS)));
+	}
+
+	private static Specialty aSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(NEXT_ID.incrementAndGet());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Specialty anotherInstanceOf(Specialty specialty) {
+		Specialty copy = new Specialty();
+		copy.setId(specialty.getId());
+		copy.setName(specialty.getName());
+		return copy;
+	}
+
+	private static Vet aVet(String firstName, String lastName, Specialty... specialtiesHeld) {
+		Vet vet = new Vet();
+		vet.setId(NEXT_ID.incrementAndGet());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(specialtiesHeld).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static SpecialtyDirectory directoryOf(SpecialtyDirectory.Entry... entries) {
+		return new SpecialtyDirectory(List.of(entries));
+	}
+
+	private static SpecialtyDirectory.Entry entry(String specialtyName, String... holderNames) {
+		return new SpecialtyDirectory.Entry(specialtyName, List.of(holderNames));
+	}
+
+}
