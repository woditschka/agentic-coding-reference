+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	private static final int UNKNOWN_VISIT_ID = 99;
+
+	private static final Integer UNSAVED_VISIT_ID = null;
+
+	@Test
+	void thePetShouldResolveOneOfItsBookedVisitsByIdentity() {
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWith(bookedVisit);
+
+		Visit resolved = pet.getVisit(BOOKED_VISIT_ID);
+
+		assertThat(resolved).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldResolveNoVisitForAnIdItDoesNotHold() {
+		Pet pet = createAPetWith(createABookedVisit(BOOKED_VISIT_ID));
+
+		Visit resolved = pet.getVisit(UNKNOWN_VISIT_ID);
+
+		assertThat(resolved).isNull();
+	}
+
+	@Test
+	void thePetShouldResolveNoVisitWhenItHasNone() {
+		Pet pet = createAPetWithoutVisits();
+
+		Visit resolved = pet.getVisit(BOOKED_VISIT_ID);
+
+		assertThat(resolved).isNull();
+	}
+
+	@Test
+	void thePetShouldNeverResolveAVisitThatIsNotYetSaved() {
+		Pet pet = createAPetWith(createAnUnsavedVisit());
+
+		Visit resolved = pet.getVisit(UNSAVED_VISIT_ID);
+
+		assertThat(resolved).isNull();
+	}
+
+	private static Pet createAPetWith(Visit visit) {
+		Pet pet = createAPetWithoutVisits();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+	private static Pet createAPetWithoutVisits() {
+		return new Pet();
+	}
+
+	private static Visit createABookedVisit(int id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+}
