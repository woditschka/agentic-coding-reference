+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+
+/**
+ * One specialty of the clinic, paired with the veterinarians holding it. Built per
+ * request and persisted nowhere.
+ */
+public record SpecialtyHolders(String specialtyName, List<Vet> holders) {
+
+	private static final Comparator<Vet> BY_HOLDER_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	public SpecialtyHolders {
+		specialtyName = Objects.requireNonNull(specialtyName, "specialtyName");
+		holders = List.copyOf(holders);
+	}
+
+	/**
+	 * Pair every given specialty with the veterinarians holding it, in the directory's
+	 * order: specialties by stored name, then holders by last name, first name and
+	 * identity. A veterinarian holding none of the given specialties appears in no pair.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians every veterinarian of the clinic
+	 * @return one entry per specialty, holders included
+	 */
+	public static List<SpecialtyHolders> directory(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		return specialties.stream()
+			.sorted(Comparator.comparing(NamedEntity::getName))
+			.map(specialty -> new SpecialtyHolders(specialty.getName(), holdersOf(specialty, veterinarians)))
+			.toList();
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> veterinarians) {
+		return veterinarians.stream().filter(vet -> holds(vet, specialty)).sorted(BY_HOLDER_ORDER).toList();
+	}
+
+	/**
+	 * Whether the veterinarian holds the given specialty, matched by stored identity
+	 * rather than by object identity: veterinarians are read through a cache, so a cached
+	 * one can carry specialty instances the specialty read does not return.
+	 */
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+}
