+
+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+/**
+ * Test class for the specialty directory read model {@link SpecialtyHolders}.
+ */
+class SpecialtyHoldersTests {
+
+	private static final AtomicInteger NEXT_ID = new AtomicInteger(1);
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String EARLIER_FIRST_NAME = "Adam";
+
+	private static final String LATER_FIRST_NAME = "Linda";
+
+	private static final String EARLIER_LAST_NAME = "Douglas";
+
+	private static final String LATER_LAST_NAME = "Ortega";
+
+	private static final String SOME_FIRST_NAME = "Rafael";
+
+	private static final int LOWER_IDENTITY = 100;
+
+	private static final int HIGHER_IDENTITY = 101;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet radiologist = createAVetHolding(radiology);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiology, surgery),
+				List.of(radiologist));
+
+		assertThat(directory).containsExactly(holdersOf(RADIOLOGY, radiologist), holdersOf(SURGERY));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet radiologist = createAVetHolding(radiology);
+		Vet vetWithoutASpecialty = createAVetWithoutASpecialty();
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(radiology),
+				List.of(radiologist, vetWithoutASpecialty));
+
+		assertThat(directory).containsExactly(holdersOf(RADIOLOGY, radiologist));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentSpecialtiesInAStableOrder() {
+		Specialty surgery = createASpecialty(SURGERY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Vet lastByLastName = createAVet(SOME_FIRST_NAME, LATER_LAST_NAME, surgery);
+		Vet firstByFirstName = createAVet(EARLIER_FIRST_NAME, EARLIER_LAST_NAME, surgery);
+		Vet lowerIdentity = createAVetIdentifiedBy(LOWER_IDENTITY, LATER_FIRST_NAME, EARLIER_LAST_NAME, surgery);
+		Vet higherIdentity = createAVetIdentifiedBy(HIGHER_IDENTITY, LATER_FIRST_NAME, EARLIER_LAST_NAME, surgery);
+		Vet dentist = createAVetHolding(dentistry);
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(surgery, dentistry),
+				List.of(lastByLastName, higherIdentity, lowerIdentity, firstByFirstName, dentist));
+
+		assertThat(directory).containsExactly(holdersOf(DENTISTRY, dentist),
+				holdersOf(SURGERY, firstByFirstName, lowerIdentity, higherIdentity, lastByLastName));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderAnEmptyDirectoryWhenTheClinicKnowsNoSpecialty() {
+		Vet vetWithoutASpecialty = createAVetWithoutASpecialty();
+
+		List<SpecialtyHolders> directory = SpecialtyHolders.directory(List.of(), List.of(vetWithoutASpecialty));
+
+		assertThat(directory).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyHoldersShouldRejectChangesToItsHolderList() {
+		Vet radiologist = createAVetHolding(createASpecialty(RADIOLOGY));
+		List<Vet> holdersPassedIn = new ArrayList<>(List.of(radiologist));
+		SpecialtyHolders entry = createSpecialtyHolders(RADIOLOGY, holdersPassedIn);
+
+		holdersPassedIn.clear();
+
+		assertThat(entry.holders()).containsExactly(radiologist);
+		assertThatThrownBy(() -> entry.holders().add(radiologist)).isInstanceOf(UnsupportedOperationException.class);
+	}
+
+	private static SpecialtyHolders holdersOf(String specialtyName, Vet... holders) {
+		return createSpecialtyHolders(specialtyName, List.of(holders));
+	}
+
+	private static SpecialtyHolders createSpecialtyHolders(String specialtyName, List<Vet> holders) {
+		return new SpecialtyHolders(specialtyName, holders);
+	}
+
+	private static Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(NEXT_ID.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		return createAVetIdentifiedBy(NEXT_ID.getAndIncrement(), firstName, lastName, specialties);
+	}
+
+	private static Vet createAVetHolding(Specialty... specialties) {
+		int id = NEXT_ID.getAndIncrement();
+		return createAVetIdentifiedBy(id, "AnyFirstName" + id, "AnyLastName" + id, specialties);
+	}
+
+	private static Vet createAVetWithoutASpecialty() {
+		return createAVetHolding();
+	}
+
+	private static Vet createAVetIdentifiedBy(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
