+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.annotation.Bean;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_DIRECTORY_PATH = "/specialties.html";
+
+	private static final String VET_LIST_PATH = "/vets.html";
+
+	private static final String SPECIALTY_DIRECTORY_VIEW = "vets/specialtyList";
+
+	private static final String CURRENT_PAGE_ATTRIBUTE = "currentPage";
+
+	private static final String TOTAL_PAGES_ATTRIBUTE = "totalPages";
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int DENTISTRY_ID = 3;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGIST_FIRST_NAME = "Helen";
+
+	private static final String RADIOLOGIST_LAST_NAME = "Leary";
+
+	private static final String HELD_BY_NONE_WORDING = "none";
+
+	private static final AtomicInteger ANY_VET_ID = new AtomicInteger(1);
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHolderByFirstThenLastName() throws Exception {
+		String fullName = RADIOLOGIST_FIRST_NAME + " " + RADIOLOGIST_LAST_NAME;
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(fullName)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarianAsHeldByNone() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(content().string(containsString(SURGERY)))
+			.andExpect(content().string(containsString(HELD_BY_NONE_WORDING)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEverySpecialtyOnOnePage() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(view().name(SPECIALTY_DIRECTORY_VIEW))
+			.andExpect(model().attributeDoesNotExist(CURRENT_PAGE_ATTRIBUTE, TOTAL_PAGES_ATTRIBUTE))
+			.andExpect(content().string(containsString(DENTISTRY)))
+			.andExpect(content().string(containsString(RADIOLOGY)))
+			.andExpect(content().string(containsString(SURGERY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarrySiteNavigationWithoutAnEntryForItself() throws Exception {
+		String linkToTheDirectory = "href=\"" + SPECIALTY_DIRECTORY_PATH + "\"";
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(content().string(containsString(VET_LIST_PATH)))
+			.andExpect(content().string(not(containsString(linkToTheDirectory))));
+	}
+
+	@TestConfiguration(proxyBeanMethods = false)
+	static class ClinicStubs {
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return new SpecialtyRepositoryStub();
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new VetRepositoryStub();
+		}
+
+	}
+
+	private static final class SpecialtyRepositoryStub implements SpecialtyRepository {
+
+		@Override
+		public Collection<Specialty> findAll() {
+			return List.of(createASpecialty(RADIOLOGY_ID, RADIOLOGY), createASpecialty(SURGERY_ID, SURGERY),
+					createASpecialty(DENTISTRY_ID, DENTISTRY));
+		}
+
+	}
+
+	// The stub hands out fresh Specialty instances to each repository, as the cached vet
+	// read does in production: a holder is recognised by stored identity, not by object
+	// identity.
+	private static final class VetRepositoryStub implements VetRepository {
+
+		@Override
+		public Collection<Vet> findAll() {
+			return List.of(
+					createAVet(RADIOLOGIST_FIRST_NAME, RADIOLOGIST_LAST_NAME,
+							createASpecialty(RADIOLOGY_ID, RADIOLOGY)),
+					createAVetHolding(createASpecialty(DENTISTRY_ID, DENTISTRY)), createAVetWithoutASpecialty());
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("the specialty directory reads every veterinarian, unpaged");
+		}
+
+	}
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(ANY_VET_ID.getAndIncrement());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private static Vet createAVetHolding(Specialty... specialties) {
+		int id = ANY_VET_ID.get();
+		return createAVet("AnyFirstName" + id, "AnyLastName" + id, specialties);
+	}
+
+	private static Vet createAVetWithoutASpecialty() {
+		return createAVetHolding();
+	}
+
+}
