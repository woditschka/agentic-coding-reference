+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 7;
+
+	private static final int UNKNOWN_VISIT_ID = 99;
+
+	@Test
+	void thePetShouldResolveOneOfItsVisitsByIdentity() {
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWith(bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldResolveNoVisitForAnIdentityItDoesNotOwn() {
+		Pet pet = createAPetWith(createABookedVisit(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(UNKNOWN_VISIT_ID)).isNull();
+	}
+
+	private static Visit createABookedVisit(int id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Pet createAPetWith(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+}
