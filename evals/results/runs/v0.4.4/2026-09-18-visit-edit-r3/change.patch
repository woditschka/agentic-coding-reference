+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+
+class VisitTests {
+
+	private static final LocalDate REFERENCE_DAY = LocalDate.of(2026, 9, 18);
+
+	@ParameterizedTest
+	@CsvSource({ "-1, true", "0, true", "1, false" })
+	void theVisitShouldJudgeItsDateOnOrBeforeTheReferenceDay(long daysFromReferenceDay, boolean expectedOnOrBefore) {
+		Visit visit = createAVisitOn(REFERENCE_DAY.plusDays(daysFromReferenceDay));
+
+		assertThat(visit.isDateOnOrBefore(REFERENCE_DAY)).isEqualTo(expectedOnOrBefore);
+	}
+
+	@Test
+	void theVisitShouldLeaveAMissingDateUnjudged() {
+		Visit visit = createAVisitOn(null);
+
+		assertThat(visit.isDateOnOrBefore(REFERENCE_DAY)).isFalse();
+	}
+
+	private static Visit createAVisitOn(LocalDate date) {
+		Visit visit = new Visit();
+		visit.setDate(date);
+		return visit;
+	}
+
+}
