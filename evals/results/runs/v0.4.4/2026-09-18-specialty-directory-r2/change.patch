+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.Repository;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Read-only access to the clinic's {@link Specialty specialties}. Declares no write
+ * method: specialties change only outside the application.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve every {@link Specialty}, ordered by name and then by identifier, because
+	 * names carry no uniqueness constraint and the order must be stable.
+	 * @return all specialties in display order
+	 */
+	@Transactional(readOnly = true)
+	@Query("SELECT specialty FROM Specialty specialty ORDER BY specialty.name, specialty.id")
+	List<Specialty> findAllOrderedByName();
+
+}
