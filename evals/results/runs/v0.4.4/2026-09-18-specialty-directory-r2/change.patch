+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_DIRECTORY = "/specialties.html";
+
+	private static final String LINK_TO_SPECIALTY_DIRECTORY = "href=\"" + SPECIALTY_DIRECTORY + "\"";
+
+	private static final String SPECIALTY_DIRECTORY_VIEW = "vets/specialtyList";
+
+	private static final String[] SEEDED_SPECIALTIES_IN_NAME_ORDER = { "<td>dentistry</td>", "<td>radiology</td>",
+			"<td>surgery</td>" };
+
+	private static final String[] RADIOLOGY_THEN_ITS_HOLDERS_BY_FULL_NAME = { "<td>radiology</td>", "Helen Leary",
+			"Henry Stevens", "<td>surgery</td>" };
+
+	private static final String PAGINATION_LINK = "page=";
+
+	private static final String LINK_TO_OWNER_SEARCH = "href=\"/owners/find\"";
+
+	private static final String LINK_TO_VETERINARIAN_DIRECTORY = "href=\"/vets.html\"";
+
+	private static final String ANY_FORM = "<form";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByItsStoredNameOnOnePage() throws Exception {
+		String directory = mockMvc.perform(get(SPECIALTY_DIRECTORY))
+			.andExpect(status().isOk())
+			.andExpect(view().name(SPECIALTY_DIRECTORY_VIEW))
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+
+		assertThat(directory).containsSubsequence(SEEDED_SPECIALTIES_IN_NAME_ORDER).doesNotContain(PAGINATION_LINK);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderByFullNameUnderTheirSpecialty() throws Exception {
+		String directory = render(SPECIALTY_DIRECTORY);
+
+		assertThat(directory).containsSubsequence(RADIOLOGY_THEN_ITS_HOLDERS_BY_FULL_NAME);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderIdenticallyWhenOpenedTwice() throws Exception {
+		String firstRender = mockMvc.perform(get(SPECIALTY_DIRECTORY)).andReturn().getResponse().getContentAsString();
+
+		String secondRender = mockMvc.perform(get(SPECIALTY_DIRECTORY)).andReturn().getResponse().getContentAsString();
+
+		assertThat(secondRender).isEqualTo(firstRender);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheSharedNavigationAndNoWayToChangeAnything() throws Exception {
+		String directory = render(SPECIALTY_DIRECTORY);
+
+		assertThat(directory).contains(LINK_TO_OWNER_SEARCH, LINK_TO_VETERINARIAN_DIRECTORY).doesNotContain(ANY_FORM);
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { "/", "/owners/find", "/owners?lastName=", "/owners/1", "/owners/new", "/owners/1/edit",
+			"/owners/1/pets/new", "/owners/1/pets/1/edit", "/owners/1/pets/1/visits/new", "/vets.html" })
+	void theNavigationShouldCarryNoEntryForTheSpecialtyDirectory(String page) throws Exception {
+		String renderedPage = render(page);
+
+		assertThat(renderedPage).doesNotContain(LINK_TO_SPECIALTY_DIRECTORY);
+	}
+
+	private String render(String page) throws Exception {
+		return mockMvc.perform(get(page)).andExpect(status().isOk()).andReturn().getResponse().getContentAsString();
+	}
+
+}
