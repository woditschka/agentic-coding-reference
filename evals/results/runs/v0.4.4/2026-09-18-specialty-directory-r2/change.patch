+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Every specialty the clinic knows, each paired with the veterinarians holding it. A
+ * specialty held by no veterinarian keeps its place with no holders; a veterinarian
+ * holding no specialty appears nowhere.
+ *
+ * @param listings one listing per specialty, in the order the specialties were given
+ */
+public record SpecialtyDirectory(List<Listing> listings) {
+
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	/**
+	 * Pairs each specialty with its holders. Holders are matched by specialty identifier,
+	 * because cached veterinarians carry specialty instances from an earlier session that
+	 * are distinct objects from the ones given here.
+	 * @param specialties the specialties to list, already in display order
+	 * @param vets every veterinarian of the clinic, in any order
+	 * @return the directory, with holders ordered by last name, first name, then
+	 * identifier
+	 */
+	public static SpecialtyDirectory of(List<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = groupHoldersBySpecialtyId(vets);
+		return new SpecialtyDirectory(specialties.stream()
+			.map(specialty -> new Listing(specialty, holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList());
+	}
+
+	private static Map<Integer, List<Vet>> groupHoldersBySpecialtyId(Collection<Vet> vets) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet vet : vets.stream().sorted(HOLDER_ORDER).toList()) {
+			for (Specialty specialty : vet.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(vet);
+			}
+		}
+		return holdersBySpecialtyId;
+	}
+
+	/**
+	 * One specialty with the veterinarians holding it.
+	 *
+	 * @param specialty the specialty listed
+	 * @param holders the veterinarians holding it, possibly none
+	 */
+	public record Listing(Specialty specialty, List<Vet> holders) {
+
+		public Listing {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+}
