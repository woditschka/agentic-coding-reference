+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Listing;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class SpecialtyDirectoryTests {
+
+	private static final AtomicInteger NEXT_ID = new AtomicInteger(1);
+
+	private static final String ANY_FIRST_NAME = "Any";
+
+	private static final String SHARED_SPECIALTY_NAME = "dentistry";
+
+	private static final String EARLIER_LAST_NAME = "Adams";
+
+	private static final String LATER_LAST_NAME = "Baker";
+
+	private static final String EARLIER_FIRST_NAME = "Ann";
+
+	private static final String LATER_FIRST_NAME = "Ben";
+
+	private static final String LATEST_FIRST_NAME = "Zoe";
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderUnderTheirSpecialty() {
+		Specialty radiology = createASpecialty();
+		Vet holder = createAVetHolding(radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(holder));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(List.of(new Listing(radiology, List.of(holder)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty();
+		Vet holder = createAVetHolding(radiology);
+		Vet vetWithoutSpecialty = createAVetHolding();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(holder, vetWithoutSpecialty));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(List.of(new Listing(radiology, List.of(holder)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty dentistry = createASpecialty();
+		Specialty surgery = createASpecialty();
+		Vet holderOfBoth = createAVetHolding(dentistry, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, surgery), List.of(holderOfBoth));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(
+				List.of(new Listing(dentistry, List.of(holderOfBoth)), new Listing(surgery, List.of(holderOfBoth)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		Specialty unheld = createASpecialty();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(unheld), List.of(createAVetHolding()));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(List.of(new Listing(unheld, List.of()))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentSpecialtiesAndHoldersInAStableOrder() {
+		Specialty first = createASpecialty(SHARED_SPECIALTY_NAME);
+		Specialty second = createASpecialty(SHARED_SPECIALTY_NAME);
+		Vet adams = createAVetHolding(LATEST_FIRST_NAME, EARLIER_LAST_NAME, first);
+		Vet bakerAnn = createAVetHolding(EARLIER_FIRST_NAME, LATER_LAST_NAME, first);
+		Vet bakerBen = createAVetHolding(LATER_FIRST_NAME, LATER_LAST_NAME, first);
+		Vet bakerBenLater = createAVetHolding(LATER_FIRST_NAME, LATER_LAST_NAME, first);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(first, second),
+				List.of(bakerBenLater, bakerBen, bakerAnn, adams));
+
+		assertThat(directory).isEqualTo(
+				new SpecialtyDirectory(List.of(new Listing(first, List.of(adams, bakerAnn, bakerBen, bakerBenLater)),
+						new Listing(second, List.of()))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchHoldersToASpecialtyByIdentifier() {
+		Specialty listed = createASpecialty();
+		Specialty heldCopy = copyOf(listed);
+		Vet holder = createAVetHolding(heldCopy);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(listed), List.of(holder));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(List.of(new Listing(listed, List.of(holder)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotChangeWhenItsSourceListChanges() {
+		Specialty radiology = createASpecialty();
+		List<Listing> source = new ArrayList<>(List.of(new Listing(radiology, List.of())));
+		SpecialtyDirectory directory = new SpecialtyDirectory(source);
+
+		source.clear();
+
+		assertThat(directory.listings()).containsExactly(new Listing(radiology, List.of()));
+	}
+
+	private static Specialty createASpecialty() {
+		return createASpecialty("any-specialty-" + NEXT_ID.get());
+	}
+
+	private static Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(NEXT_ID.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Specialty copyOf(Specialty specialty) {
+		Specialty copy = new Specialty();
+		copy.setId(specialty.getId());
+		copy.setName(specialty.getName());
+		return copy;
+	}
+
+	private static Vet createAVetHolding(Specialty... specialties) {
+		int id = NEXT_ID.getAndIncrement();
+		return createAVetHolding(ANY_FIRST_NAME, "AnyLastName" + id, id, specialties);
+	}
+
+	private static Vet createAVetHolding(String firstName, String lastName, Specialty... specialties) {
+		return createAVetHolding(firstName, lastName, NEXT_ID.getAndIncrement(), specialties);
+	}
+
+	private static Vet createAVetHolding(String firstName, String lastName, int id, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
