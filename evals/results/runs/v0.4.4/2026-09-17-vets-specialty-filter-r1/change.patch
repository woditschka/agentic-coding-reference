+
+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Collection;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * Tests the matching semantics of the specialty filter against the seeded clinic data. A
+ * stubbed repository cannot demonstrate them, so the real query runs against the real
+ * database.
+ */
+@DataJpaTest
+// Ensure that if the mysql profile is active we connect to the real database:
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VetRepositoryTests {
+
+	private static final String SPECIALTY_TWO_VETS_HOLD = "surgery";
+
+	private static final List<String> LAST_NAMES_OF_VETS_HOLDING_IT = List.of("Douglas", "Ortega");
+
+	private static final String SPECIALTY_NO_VET_HOLDS = "cardiology";
+
+	private static final int ONE_VET_PER_PAGE = 1;
+
+	private static final int FIRST_PAGE = 0;
+
+	@Autowired
+	private VetRepository vets;
+
+	@Test
+	void theSpecialtyFilterShouldMatchEveryVetHoldingThatSpecialty() {
+		Collection<Vet> holders = this.vets.findBySpecialtiesNameIgnoreCase(SPECIALTY_TWO_VETS_HOLD);
+
+		assertThat(holders).extracting(Person::getLastName)
+			.containsExactlyInAnyOrderElementsOf(LAST_NAMES_OF_VETS_HOLDING_IT);
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { "SURGERY", "Surgery", "sUrGeRy" })
+	void theSpecialtyFilterShouldIgnoreLetterCase(String differentlyCasedSpecialty) {
+		Collection<Vet> holders = this.vets.findBySpecialtiesNameIgnoreCase(differentlyCasedSpecialty);
+
+		assertThat(holders).extracting(Person::getLastName)
+			.containsExactlyInAnyOrderElementsOf(LAST_NAMES_OF_VETS_HOLDING_IT);
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { "surg", "urgery", "surgeryy" })
+	void theSpecialtyFilterShouldNotMatchPartOfASpecialtyName(String partOfASpecialtyName) {
+		Collection<Vet> holders = this.vets.findBySpecialtiesNameIgnoreCase(partOfASpecialtyName);
+
+		assertThat(holders).isEmpty();
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { " surgery", "surgery ", " surgery " })
+	void theSpecialtyFilterShouldNotIgnoreSurroundingSpaces(String paddedSpecialty) {
+		Collection<Vet> holders = this.vets.findBySpecialtiesNameIgnoreCase(paddedSpecialty);
+
+		assertThat(holders).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyFilterShouldMatchNoVetWhenNoneHoldsThatSpecialty() {
+		Collection<Vet> holders = this.vets.findBySpecialtiesNameIgnoreCase(SPECIALTY_NO_VET_HOLDS);
+
+		assertThat(holders).isEmpty();
+	}
+
+	@Test
+	void theFilteredVetPageShouldCountOnlyVetsHoldingThatSpecialty() {
+		Page<Vet> firstPage = this.vets.findBySpecialtiesNameIgnoreCase(SPECIALTY_TWO_VETS_HOLD,
+				PageRequest.of(FIRST_PAGE, ONE_VET_PER_PAGE));
+
+		assertThat(firstPage.getTotalElements()).isEqualTo(LAST_NAMES_OF_VETS_HOLDING_IT.size());
+		assertThat(firstPage.getTotalPages()).isEqualTo(LAST_NAMES_OF_VETS_HOLDING_IT.size() / ONE_VET_PER_PAGE);
+		assertThat(firstPage.getContent()).extracting(Person::getLastName)
+			.hasSize(ONE_VET_PER_PAGE)
+			.isSubsetOf(LAST_NAMES_OF_VETS_HOLDING_IT);
+	}
+
+}
