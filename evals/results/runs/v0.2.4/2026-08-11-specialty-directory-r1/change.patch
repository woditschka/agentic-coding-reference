+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.springframework.dao.DataAccessException;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.Repository;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Repository class for <code>Specialty</code> domain objects. The surface is read-only:
+ * specialties are seeded data, not managed through the application.
+ * <p>
+ * The reads are deliberately uncached. The <code>vets</code> cache already holds
+ * <code>VetRepository.findAll()</code> under the empty key a no-argument method produces,
+ * so reusing it here would read a collection of veterinarians back as a collection of
+ * specialties. Caching specialties would need a cache of its own.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve all {@link Specialty}s from the data store, ordered by name.
+	 * @return a <code>List</code> of {@link Specialty}s in name order
+	 */
+	@Transactional(readOnly = true)
+	@Query("SELECT specialty FROM Specialty specialty ORDER BY specialty.name")
+	List<Specialty> findSpecialties() throws DataAccessException;
+
+}
