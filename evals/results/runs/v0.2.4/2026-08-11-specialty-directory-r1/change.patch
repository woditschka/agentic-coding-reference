--- /dev/null
+++ b/src/main/resources/templates/vets/specialtyList.html
@@ -0,0 +1,35 @@
+<!DOCTYPE html>
+
+<!-- The menu argument matches no navigation item on purpose: the page carries the shared
+     navigation but is not reachable from it (REQ-SPEC-001). -->
+<html xmlns:th="https://www.thymeleaf.org"
+  th:replace="~{fragments/layout :: layout (~{::body},'specialties')}">
+
+<body>
+
+  <h2 th:text="#{specialties}">Specialties</h2>
+
+  <table id="specialties" class="table table-striped" th:unless="${directory.entries.empty}">
+    <thead>
+      <tr>
+        <th th:text="#{name}">Name</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="entry : ${directory.entries}">
+        <td th:text="${entry.specialty.name}"></td>
+        <td>
+          <span th:each="holder : ${entry.holders}"
+            th:text="${holder.firstName + ' ' + holder.lastName + ' '}" /> <span
+            th:if="${entry.holders.empty}" th:text="#{none}">none</span>
+        </td>
+      </tr>
+    </tbody>
+  </table>
+
+  <p th:if="${directory.entries.empty}" th:text="#{noSpecialties}">There are no specialties on record.</p>
+
+</body>
+
+</html>
