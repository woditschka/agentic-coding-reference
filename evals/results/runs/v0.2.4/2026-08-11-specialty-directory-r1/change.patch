+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.tuple;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the fold behind the specialty directory
+ * page.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int DENTISTRY_ID = 3;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, "radiology");
+		Specialty surgery = createSpecialty(SURGERY_ID, "surgery");
+		Specialty dentistry = createSpecialty(DENTISTRY_ID, "dentistry");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology),
+				List.of(createVetHolding("Helen", "Leary", radiology, dentistry)));
+
+		assertThat(directory.entries()).extracting(entry -> entry.specialty().getName())
+			.containsExactly("surgery", "dentistry", "radiology");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowAnUnheldSpecialtyAsHeldByNone() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, "radiology");
+		Specialty surgeryHeldByNobody = createSpecialty(SURGERY_ID, "surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgeryHeldByNobody),
+				List.of(createVetHolding("Helen", "Leary", radiology)));
+
+		assertThat(directory.entries())
+			.extracting(entry -> entry.specialty().getName(), entry -> entry.holders().size())
+			.containsExactly(tuple("radiology", 1), tuple("surgery", 0));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianWithoutASpecialty() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, "radiology");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(createVetHolding("Helen", "Leary", radiology), createVetHolding("James", "Carter")));
+
+		assertThat(directory.entries()).flatExtracting(SpecialtyDirectory.Entry::holders)
+			.extracting(Vet::getLastName)
+			.containsExactly("Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, "radiology");
+		Specialty surgery = createSpecialty(SURGERY_ID, "surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery),
+				List.of(createVetHolding("Rafael", "Ortega", radiology, surgery)));
+
+		assertThat(directory.entries())
+			.extracting(entry -> entry.specialty().getName(), entry -> entry.holders().getFirst().getLastName())
+			.containsExactly(tuple("radiology", "Ortega"), tuple("surgery", "Ortega"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderHoldersByLastNameThenFirstName() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, "radiology");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(createVetHolding("Sharon", "Jenkins", radiology),
+						createVetHolding("Zack", "Douglas", radiology), createVetHolding("Amy", "Jenkins", radiology)));
+
+		assertThat(directory.entries().getFirst().holders()).extracting(Vet::getFirstName)
+			.containsExactly("Zack", "Amy", "Sharon");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldHoldNoEntriesWhenTheClinicKnowsNoSpecialty() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(createVetHolding("James", "Carter")));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	private static Specialty createSpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	/**
+	 * Builds a veterinarian holding its own copies of the given specialties. The copies
+	 * are deliberate: the persistence entities inherit neither {@code equals} nor
+	 * {@code hashCode}, and in production the instances hanging off a veterinarian need
+	 * not be the instances the specialty read returns. A directory matching by object
+	 * identity would report every specialty as held by none and still pass against shared
+	 * instances.
+	 */
+	private static Vet createVetHolding(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(createSpecialty(specialty.getId(), specialty.getName()));
+		}
+		return vet;
+	}
+
+}
