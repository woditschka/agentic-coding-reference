+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+/**
+ * The rows of the specialty directory page: every specialty the clinic knows, each with
+ * the veterinarians holding it.
+ * <p>
+ * The fold runs before the view does, so the page never touches a repository or a lazily
+ * loaded association.
+ *
+ * @param entries one row per specialty, in the order the specialties were given
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Vet> BY_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Folds the clinic's specialties and veterinarians into the directory's rows.
+	 * <p>
+	 * Holders are matched to specialties by identifier: the persistence entities inherit
+	 * no value equality, and the instances hanging off a veterinarian need not be the
+	 * instances the specialty read returned.
+	 * @param specialties every specialty the clinic knows, in the order to list them
+	 * @param veterinarians every veterinarian; one holding no specialty appears in no row
+	 * @return a row per specialty, each row's holders ordered by last name then first
+	 * name
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = veterinarians.stream()
+			.flatMap(vet -> vet.getSpecialties().stream().map(specialty -> Map.entry(specialty.getId(), vet)))
+			.collect(Collectors.groupingBy(Map.Entry::getKey,
+					Collectors.mapping(Map.Entry::getValue, Collectors.toList())));
+
+		return new SpecialtyDirectory(specialties.stream()
+			.map(specialty -> new Entry(specialty,
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of()).stream().sorted(BY_NAME).toList()))
+			.toList());
+	}
+
+	/**
+	 * One row of the directory.
+	 *
+	 * @param specialty the specialty, shown under its stored name
+	 * @param holders the veterinarians holding it, possibly none
+	 */
+	public record Entry(Specialty specialty, List<Vet> holders) {
+
+		public Entry {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+}
