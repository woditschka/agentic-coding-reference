+	/**
+	 * Retrieve the <code>Vet</code>s holding the named specialty from the data store. The
+	 * name is matched in full, ignoring case; case is folded by the query rather than by
+	 * the column, so the match is the same on every supported database.
+	 * <p>
+	 * Deliberately not <code>@Cacheable</code>: the name comes from a request parameter,
+	 * so caching would let any caller mint an unbounded number of entries in a cache that
+	 * has no size limit.
+	 * @param specialtyName the specialty name to match in full, ignoring case
+	 * @return a <code>Collection</code> of the matching <code>Vet</code>s, empty if no
+	 * <code>Vet</code> holds the specialty
+	 */
+	@Transactional(readOnly = true)
+	Collection<Vet> findBySpecialtiesNameIgnoreCase(String specialtyName) throws DataAccessException;
+
+	/**
+	 * Retrieve in Pages the <code>Vet</code>s holding the named specialty, matched as
+	 * {@link #findBySpecialtiesNameIgnoreCase(String)} matches. Deliberately not
+	 * <code>@Cacheable</code>, for the same reason.
+	 * @param specialtyName the specialty name to match in full, ignoring case
+	 * @param pageable the page to retrieve
+	 * @return a <code>Page</code> of the matching <code>Vet</code>s, empty if no
+	 * <code>Vet</code> holds the specialty
