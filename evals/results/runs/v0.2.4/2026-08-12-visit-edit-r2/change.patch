+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link Pet}
+ */
+class PetTests {
+
+	private static final int RECORDED_VISIT_ID = 7;
+
+	private static final int UNKNOWN_VISIT_ID = 99;
+
+	private Pet pet;
+
+	private Visit recordedVisit;
+
+	private Visit unsavedVisit;
+
+	@BeforeEach
+	void init() {
+		this.pet = new Pet();
+		this.recordedVisit = new Visit();
+		this.recordedVisit.setId(RECORDED_VISIT_ID);
+		this.unsavedVisit = new Visit();
+		this.pet.addVisit(this.recordedVisit);
+		this.pet.addVisit(this.unsavedVisit);
+	}
+
+	@Test
+	void theRecordedVisitShouldBeFoundByItsId() {
+		assertThat(this.pet.getVisit(RECORDED_VISIT_ID)).isSameAs(this.recordedVisit);
+	}
+
+	@Test
+	void anUnsavedVisitShouldNeverBeFoundByAMissingId() {
+		assertThat(this.pet.getVisit(null)).isNull();
+	}
+
+	@Test
+	void anIdMatchingNoVisitShouldFindNothing() {
+		assertThat(this.pet.getVisit(UNKNOWN_VISIT_ID)).isNull();
+	}
+
+}
