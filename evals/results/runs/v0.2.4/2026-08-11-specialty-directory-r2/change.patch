+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.tuple;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the read model behind the specialty
+ * directory page.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final List<Vet> NO_VETERINARIANS = List.of();
+
+	private static final List<Specialty> NO_SPECIALTIES = List.of();
+
+	private int nextId = 1;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByItsStoredName() {
+		Specialty radiology = specialty("radiology");
+		Specialty surgery = specialty("surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), NO_VETERINARIANS);
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::name)
+			.containsExactly("radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachVeterinarianByFirstThenLastName() {
+		Specialty radiology = specialty("radiology");
+		Vet helen = vet("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory.entries()).flatExtracting(SpecialtyDirectory.Entry::veterinarianNames)
+			.containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = specialty("radiology");
+		Vet helen = vet("Helen", "Leary", radiology);
+		Vet jamesHoldingNoSpecialty = vet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(helen, jamesHoldingNoSpecialty));
+
+		assertThat(directory.entries()).flatExtracting(SpecialtyDirectory.Entry::veterinarianNames)
+			.containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = specialty("radiology");
+		Specialty surgeryHeldByNobody = specialty("surgery");
+		Vet helen = vet("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgeryHeldByNobody), List.of(helen));
+
+		assertThat(directory.entries())
+			.extracting(SpecialtyDirectory.Entry::name, SpecialtyDirectory.Entry::veterinarianNames)
+			.containsExactly(tuple("radiology", List.of("Helen Leary")), tuple("surgery", List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastThenFirstName() {
+		Specialty radiology = specialty("radiology");
+		Vet helenLeary = vet("Helen", "Leary", radiology);
+		Vet sharonJenkins = vet("Sharon", "Jenkins", radiology);
+		Vet alanJenkins = vet("Alan", "Jenkins", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(helenLeary, sharonJenkins, alanJenkins));
+
+		assertThat(directory.entries()).flatExtracting(SpecialtyDirectory.Entry::veterinarianNames)
+			.containsExactly("Alan Jenkins", "Sharon Jenkins", "Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldHoldNoEntryWhenTheClinicHoldsNoSpecialty() {
+		Vet jamesHoldingNoSpecialty = vet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(NO_SPECIALTIES, List.of(jamesHoldingNoSpecialty));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	private Specialty specialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet vet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
