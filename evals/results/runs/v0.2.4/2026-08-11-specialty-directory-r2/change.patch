+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+/**
+ * Read model behind the specialty directory page: every stored specialty with the
+ * veterinarians holding it.
+ * <p>
+ * The stored association runs the other way — {@link Vet} owns it and {@link Specialty}
+ * carries no back-reference — so this type inverts it. Specialties keep the order they
+ * arrive in, which is the order the repository read imposes; veterinarians are ordered by
+ * last name, then first name. Two veterinarians sharing both names render identically, so
+ * no further tiebreak is observable on the page.
+ * <p>
+ * Recorded as ADR "Read Models Carry Derived Page State"
+ * (docs/adr/2026-08-11-read-models-for-derived-page-state.md).
+ *
+ * @param entries one entry per stored specialty, held in presentation order
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Build the directory from what the repositories return.
+	 * @param specialties every stored specialty, in the order they should be listed
+	 * @param veterinarians every stored veterinarian; one holding no specialty appears in
+	 * no entry
+	 * @return the directory, holding one entry per stored specialty
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> veterinariansBySpecialtyId = veterinarians.stream()
+			.flatMap(vet -> vet.getSpecialties().stream().map(specialty -> Map.entry(specialty.getId(), vet)))
+			.collect(Collectors.groupingBy(Map.Entry::getKey,
+					Collectors.mapping(Map.Entry::getValue, Collectors.toList())));
+
+		return new SpecialtyDirectory(specialties.stream()
+			.map(specialty -> new Entry(specialty.getName(),
+					fullNames(veterinariansBySpecialtyId.getOrDefault(specialty.getId(), List.of()))))
+			.toList());
+	}
+
+	private static List<String> fullNames(List<Vet> veterinarians) {
+		return veterinarians.stream()
+			.sorted(BY_LAST_THEN_FIRST_NAME)
+			.map(vet -> vet.getFirstName() + " " + vet.getLastName())
+			.toList();
+	}
+
+	/**
+	 * One stored specialty with the veterinarians holding it.
+	 *
+	 * @param name the specialty's stored name
+	 * @param veterinarianNames the full name of each veterinarian holding the specialty,
+	 * first name then last name; empty when no veterinarian holds it
+	 */
+	public record Entry(String name, List<String> veterinarianNames) {
+
+		public Entry {
+			veterinarianNames = List.copyOf(veterinarianNames);
+		}
+
+	}
+
+}
