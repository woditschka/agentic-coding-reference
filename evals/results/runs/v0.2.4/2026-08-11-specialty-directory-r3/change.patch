+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * The clinic's specialties seen from the specialty side: every stored specialty with the
+ * veterinarians holding it, and separately the veterinarians holding none. Built by
+ * {@link #of(Collection, Collection)} from a specialty read and a veterinarian read, it
+ * inverts the veterinarian-to-specialty association the {@link Vet} entity carries, so
+ * the page that renders it holds no rule of its own.
+ * <p>
+ * The two groups stay separate members rather than one list with a sentinel entry: the
+ * heading for the veterinarians holding none is wording, which belongs to the message
+ * bundles and the template, not to this model.
+ */
+public record SpecialtyDirectory(List<HeldSpecialty> heldSpecialties, List<Vet> veterinariansWithoutSpecialty) {
+
+	private static final Comparator<Specialty> BY_NAME = Comparator.comparing(NamedEntity::getName);
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Person::getFirstName);
+
+	public SpecialtyDirectory {
+		heldSpecialties = List.copyOf(heldSpecialties);
+		veterinariansWithoutSpecialty = List.copyOf(veterinariansWithoutSpecialty);
+	}
+
+	/**
+	 * Invert the given veterinarians onto the given specialties.
+	 * @param specialties every specialty the clinic stores; one held specialty results
+	 * from each, whether or not a veterinarian holds it
+	 * @param veterinarians the veterinarians to place under the specialties they hold,
+	 * those holding none gathered into their own group
+	 * @return the directory, specialties ordered by name and veterinarians by last name
+	 * then first name, so that repeated reads present the same order
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+		List<HeldSpecialty> heldSpecialties = specialties.stream()
+			.sorted(BY_NAME)
+			.map(specialty -> new HeldSpecialty(specialty.getName(),
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+		List<Vet> withoutSpecialty = veterinarians.stream()
+			.filter(veterinarian -> veterinarian.getNrOfSpecialties() == 0)
+			.sorted(BY_LAST_THEN_FIRST_NAME)
+			.toList();
+		return new SpecialtyDirectory(heldSpecialties, withoutSpecialty);
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty specialty : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		holders.values().forEach(held -> held.sort(BY_LAST_THEN_FIRST_NAME));
+		return holders;
+	}
+
+	/**
+	 * One specialty of the directory, under the name it is stored with, together with the
+	 * veterinarians holding it.
+	 */
+	public record HeldSpecialty(String name, List<Vet> veterinarians) {
+
+		public HeldSpecialty {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+}
