+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.HeldSpecialty;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the read model behind the specialty
+ * directory page.
+ */
+class SpecialtyDirectoryTests {
+
+	/** Ids are irrelevant to every outcome here, beyond being distinct per entity. */
+	private int nextId = 1;
+
+	private Specialty specialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet veterinarian(String firstName, String lastName, Specialty... specialtiesHeld) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialtiesHeld) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private static List<Vet> veterinariansUnder(SpecialtyDirectory directory, String specialtyName) {
+		return directory.heldSpecialties()
+			.stream()
+			.filter(heldSpecialty -> heldSpecialty.name().equals(specialtyName))
+			.findFirst()
+			.orElseThrow(() -> new AssertionError("the directory has no held specialty for " + specialtyName))
+			.veterinarians();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachSpecialtyWithTheVeterinariansHoldingIt() {
+		Specialty dentistry = specialty("dentistry");
+		Specialty surgery = specialty("surgery");
+		Vet linda = veterinarian("Linda", "Douglas", dentistry);
+		Vet rafael = veterinarian("Rafael", "Ortega", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, surgery), List.of(linda, rafael));
+
+		assertThat(directory.heldSpecialties()).extracting(HeldSpecialty::name).containsExactly("dentistry", "surgery");
+		assertThat(veterinariansUnder(directory, "dentistry")).containsExactly(linda);
