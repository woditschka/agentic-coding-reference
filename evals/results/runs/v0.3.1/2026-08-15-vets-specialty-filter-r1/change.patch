+	@Transactional(readOnly = true)
+	Collection<Vet> findBySpecialtiesNameIgnoreCase(String name) throws DataAccessException;
+
+	/**
+	 * Retrieve in pages every <code>Vet</code> holding the named specialty, matched as in
+	 * {@link #findBySpecialtiesNameIgnoreCase(String)}. Paging covers only the matching
+	 * <code>Vet</code>s.
+	 * <p>
+	 * Deliberately not <code>@Cacheable</code>, for the reason given on that method.
+	 * @param name the whole specialty name to match, ignoring case
+	 * @param pageable the page to retrieve
