+package org.springframework.samples.petclinic.vet;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int SOME_VET_ID = 1;
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@MockitoBean
+	private SpecialtyRepository specialties;
+
+	@MockitoBean
+	private VetRepository vets;
+
+	@BeforeEach
+	void setup() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty surgeryNobodyHolds = createASpecialty(SURGERY_ID, SURGERY);
+		given(this.specialties.findAll()).willReturn(List.of(radiology, surgeryNobodyHolds));
+		given(this.vets.findAll()).willReturn(List.of(createAVet(SOME_VET_ID, "Helen", "Leary", radiology)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryPageShouldPublishTheDirectory() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(model().attributeExists("specialtyDirectory"))
+			.andExpect(view().name("vets/specialtyList"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameHoldersByFirstThenLastName() throws Exception {
+		mockMvc.perform(get("/specialties.html")).andExpect(content().string(containsString("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEverySpecialtyOnOnePage() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString(RADIOLOGY)))
+			.andExpect(content().string(containsString(SURGERY)))
+			.andExpect(content().string(not(containsString("/specialties.html?page="))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowNoNameUnderASpecialtyNoVeterinarianHolds() throws Exception {
+		mockMvc.perform(get("/specialties.html")).andExpect(content().string(containsString(">none<")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeLinkedFromNoPage() throws Exception {
+		try (Stream<Path> templates = Files.walk(Path.of("src/main/resources/templates"))) {
+			List<Path> linking = templates.filter(Files::isRegularFile)
+				.filter(SpecialtyControllerTests::linksToPage)
+				.toList();
+
+			assertThat(linking).isEmpty();
+		}
+	}
+
+	private static boolean linksToPage(Path template) {
+		try {
+			return Files.readString(template).contains("/specialties.html");
+		}
+		catch (IOException failedToRead) {
+			throw new UncheckedIOException(failedToRead);
+		}
+	}
+
+	private Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(int id, String firstName, String lastName, Specialty... specialtiesHeld) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(specialtiesHeld).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+}
