+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the grouping and ordering rules behind the
+ * specialty directory page.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final int SOME_SPECIALTY_ID = 1;
+
+	private static final int SOME_VET_ID = 1;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		Specialty dentistry = createASpecialty(1, DENTISTRY);
+		Specialty radiology = createASpecialty(2, RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, radiology), List.of());
+
+		assertThat(specialtyNamesIn(directory)).containsExactly(DENTISTRY, RADIOLOGY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameAVeterinarianUnderEachSpecialtyHeld() {
+		Specialty radiology = createASpecialty(1, RADIOLOGY);
+		Specialty surgery = createASpecialty(2, SURGERY);
+		Vet linda = createAVet("Linda", "Douglas", radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(linda));
+
+		assertThat(holderNamesUnder(directory, RADIOLOGY)).containsExactly("Linda Douglas");
+		assertThat(holderNamesUnder(directory, SURGERY)).containsExactly("Linda Douglas");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(SOME_SPECIALTY_ID, RADIOLOGY);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+		Vet jamesHoldingNothing = createAVet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, jamesHoldingNothing));
+
+		assertThat(holderNamesUnder(directory, RADIOLOGY)).containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty surgeryNobodyHolds = createASpecialty(SOME_SPECIALTY_ID, SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgeryNobodyHolds),
+				List.of(createAVet("James", "Carter")));
+
+		assertThat(specialtyNamesIn(directory)).containsExactly(SURGERY);
+		assertThat(holderNamesUnder(directory, SURGERY)).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchHoldersByStoredIdentityRatherThanObjectEquality() {
+		Specialty radiologyAsStored = createASpecialty(SOME_SPECIALTY_ID, RADIOLOGY);
+		Specialty radiologyAsHeld = createASpecialty(SOME_SPECIALTY_ID, RADIOLOGY);
+		Vet helen = createAVet("Helen", "Leary", radiologyAsHeld);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiologyAsStored), List.of(helen));
+
+		assertThat(holderNamesUnder(directory, RADIOLOGY)).containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyForAClinicThatKnowsNoSpecialty() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(createAVet("James", "Carter")));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByName() {
+		Specialty surgery = createASpecialty(1, SURGERY);
+		Specialty dentistry = createASpecialty(2, DENTISTRY);
+		Specialty radiology = createASpecialty(3, RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology), List.of());
+
+		assertThat(specialtyNamesIn(directory)).containsExactly(DENTISTRY, RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderHoldersByLastNameThenFirstNameThenIdentity() {
+		Specialty radiology = createASpecialty(SOME_SPECIALTY_ID, RADIOLOGY);
+		Vet secondSharonJenkins = createAVet(4, "Sharon", "Jenkins", radiology);
+		Vet rafaelOrtega = createAVet(3, "Rafael", "Ortega", radiology);
+		Vet firstSharonJenkins = createAVet(2, "Sharon", "Jenkins", radiology);
+		Vet henryJenkins = createAVet(1, "Henry", "Jenkins", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(secondSharonJenkins, rafaelOrtega, firstSharonJenkins, henryJenkins));
+
+		assertThat(holderNamesUnder(directory, RADIOLOGY)).containsExactly("Henry Jenkins", "Sharon Jenkins",
+				"Sharon Jenkins", "Rafael Ortega");
+		assertThat(holderIdsUnder(directory, RADIOLOGY)).containsExactly(1, 2, 4, 3);
+	}
+
+	private Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(String firstName, String lastName, Specialty... specialtiesHeld) {
+		return createAVet(SOME_VET_ID, firstName, lastName, specialtiesHeld);
+	}
+
+	private Vet createAVet(int id, String firstName, String lastName, Specialty... specialtiesHeld) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(specialtiesHeld).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private List<String> specialtyNamesIn(SpecialtyDirectory directory) {
+		return directory.entries().stream().map(entry -> entry.specialty().getName()).toList();
+	}
+
+	private List<String> holderNamesUnder(SpecialtyDirectory directory, String specialtyName) {
+		return holdersUnder(directory, specialtyName).map(vet -> vet.getFirstName() + " " + vet.getLastName()).toList();
+	}
+
+	private List<Integer> holderIdsUnder(SpecialtyDirectory directory, String specialtyName) {
+		return holdersUnder(directory, specialtyName).map(Vet::getId).toList();
+	}
+
+	private Stream<Vet> holdersUnder(SpecialtyDirectory directory, String specialtyName) {
+		return directory.entries()
+			.stream()
+			.filter(entry -> entry.specialty().getName().equals(specialtyName))
+			.flatMap(entry -> entry.holders().stream());
+	}
+
+}
