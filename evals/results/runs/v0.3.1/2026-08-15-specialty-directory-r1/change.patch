+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+import org.springframework.samples.petclinic.model.BaseEntity;
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * The veterinarian directory read the other way round: every specialty the clinic knows,
+ * each with the veterinarians holding it.
+ * <p>
+ * The directory is derived rather than persisted. It is composed from the stored
+ * specialties and the veterinarian roster, because a specialty no veterinarian holds must
+ * still be listed and cannot be reached from the roster alone.
+ * <p>
+ * A veterinarian is matched to a specialty by persisted identity, not by object equality:
+ * the domain entities inherit no {@code equals} from {@link BaseEntity}, so the same
+ * stored specialty reached through two reads is two unequal objects.
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Specialty> BY_NAME = Comparator.comparing(NamedEntity::getName);
+
+	private static final Comparator<Vet> BY_LAST_NAME_THEN_FIRST_NAME_THEN_IDENTITY = Comparator
+		.<Vet, String>comparing(Person::getLastName)
+		.thenComparing(Person::getFirstName)
+		.thenComparing(BaseEntity::getId);
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Pair every known specialty with the veterinarians holding it.
+	 * @param specialties every specialty the clinic knows, in any order
+	 * @param vets the veterinarian roster, in any order
+	 * @return the directory, specialties ordered by name and the holders under each
+	 * ordered by last name, then first name, then persisted identity
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_NAME)
+			.map(specialty -> new Entry(specialty, holdersOf(specialty, vets)))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream()
+			.filter(vet -> holds(vet, specialty))
+			.sorted(BY_LAST_NAME_THEN_FIRST_NAME_THEN_IDENTITY)
+			.toList();
+	}
+
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> specialty.getId().equals(held.getId()));
+	}
+
+	/**
+	 * One specialty of the directory, with the veterinarians holding it.
+	 *
+	 * @param specialty the specialty, under its stored name
+	 * @param holders the veterinarians holding it, possibly none
+	 */
+	public record Entry(Specialty specialty, List<Vet> holders) {
+
+		public Entry {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+}
