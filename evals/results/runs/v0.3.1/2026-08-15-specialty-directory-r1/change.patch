+ * specialties are maintained outside this application, so no write method belongs on the
+ * interface.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve all <code>Specialty</code>s from the data store.
+	 * @return a <code>Collection</code> of <code>Specialty</code>s, in no particular
+	 * order; {@link SpecialtyDirectory} orders them for presentation
+	 */
+	@Transactional(readOnly = true)
+	Collection<Specialty> findAll() throws DataAccessException;
+
+}
