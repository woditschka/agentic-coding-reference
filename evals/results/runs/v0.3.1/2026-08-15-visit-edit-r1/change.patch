+ */
+package org.springframework.samples.petclinic.owner;
+
+import java.time.LocalDate;
+
+import org.springframework.validation.Errors;
+import org.springframework.validation.Validator;
+
+/**
+ * <code>Validator</code> for <code>Visit</code> forms.
+ * <p>
+ * A visit is always booked or corrected for a day still to come. That rule compares the
+ * submitted date against the clock, which no field constraint on {@link Visit} can
+ * express, so it lives here. The field's own constraints still apply: this validator is
+ * added to the binder alongside bean validation rather than replacing it, and it stays
+ * silent about an absent date so that only one complaint reaches the form.
+ * </p>
+ */
+public class VisitValidator implements Validator {
+
+	private static final String NOT_IN_FUTURE = "typeMismatch.visitDate";
+
+	@Override
+	public void validate(Object obj, Errors errors) {
+		Visit visit = (Visit) obj;
+		LocalDate date = visit.getDate();
+		if (date != null && !date.isAfter(LocalDate.now())) {
+			errors.rejectValue("date", NOT_IN_FUTURE);
+		}
+	}
+
+	/**
+	 * This Validator validates *just* Visit instances
+	 */
+	@Override
+	public boolean supports(Class<?> clazz) {
+		return Visit.class.isAssignableFrom(clazz);
+	}
+
+}
