+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.validation.BeanPropertyBindingResult;
+import org.springframework.validation.Errors;
+import org.springframework.validation.FieldError;
+
+/**
+ * Test class for {@link VisitValidator}
+ */
+class VisitValidatorTests {
+
+	private static final String VISIT_DATE_NOT_IN_FUTURE = "typeMismatch.visitDate";
+
+	private final VisitValidator validator = new VisitValidator();
+
+	@ParameterizedTest
+	@ValueSource(longs = { 0, -1, -365 })
+	void theVisitDateShouldBeRejectedWhenItIsNotLaterThanToday(long daysFromToday) {
+		Visit visit = visitOn(LocalDate.now().plusDays(daysFromToday));
+
+		Errors errors = validate(visit);
+
+		assertThat(errors.getFieldError("date")).isNotNull()
+			.extracting(FieldError::getCode)
+			.isEqualTo(VISIT_DATE_NOT_IN_FUTURE);
+	}
+
+	@Test
+	void theVisitDateShouldBeAcceptedWhenItIsLaterThanToday() {
+		Visit visit = visitOn(LocalDate.now().plusDays(1));
+
+		Errors errors = validate(visit);
+
+		assertThat(errors.hasErrors()).isFalse();
+	}
+
+	@Test
+	void theMissingVisitDateShouldBeLeftToTheFieldsOwnConstraints() {
+		Visit visit = visitOn(null);
+
+		Errors errors = validate(visit);
+
+		assertThat(errors.hasErrors()).isFalse();
+	}
+
+	@Test
+	void theValidatorShouldApplyToVisitsOnly() {
+		assertThat(validator.supports(Visit.class)).isTrue();
+		assertThat(validator.supports(Pet.class)).isFalse();
+	}
+
+	private Visit visitOn(LocalDate date) {
+		Visit visit = new Visit();
+		visit.setDate(date);
+		return visit;
+	}
+
+	private Errors validate(Visit visit) {
+		Errors errors = new BeanPropertyBindingResult(visit, "visit");
+		this.validator.validate(visit, errors);
+		return errors;
+	}
+
+}
