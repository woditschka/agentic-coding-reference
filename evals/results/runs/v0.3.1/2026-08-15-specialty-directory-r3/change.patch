+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.SpecialtyEntry;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.tuple;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the projection behind the specialty
+ * directory page.
+ */
+class SpecialtyDirectoryTests {
+
+	private int nextId = 1;
+
+	private Specialty createSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createVeterinarian(String firstName, String lastName, Specialty... held) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(this.nextId++);
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		List.of(held).forEach(veterinarian::addSpecialty);
+		return veterinarian;
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldGroupEachVeterinarianUnderEverySpecialtyTheyHold() {
+		Specialty radiology = createSpecialty("radiology");
+		Specialty surgery = createSpecialty("surgery");
+		Vet holderOfBoth = createVeterinarian("Linda", "Douglas", radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(holderOfBoth));
+
+		assertThat(directory.entries()).extracting(entry -> entry.specialty().getName(), SpecialtyEntry::holders)
+			.containsExactly(tuple("radiology", List.of(holderOfBoth)), tuple("surgery", List.of(holderOfBoth)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldLeaveASpecialtyNoVeterinarianHoldsWithoutHolders() {
+		Specialty heldByNobody = createSpecialty("dentistry");
+		Specialty radiology = createSpecialty("radiology");
+		Vet radiologist = createVeterinarian("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(heldByNobody, radiology), List.of(radiologist));
+
+		assertThat(directory.entries()).extracting(entry -> entry.specialty().getName(), SpecialtyEntry::holders)
+			.containsExactly(tuple("dentistry", List.of()), tuple("radiology", List.of(radiologist)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByStoredName() {
+		Specialty surgery = createSpecialty("surgery");
+		Specialty dentistry = createSpecialty("dentistry");
+		Specialty radiology = createSpecialty("radiology");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology), List.of());
+
+		assertThat(directory.entries()).extracting(entry -> entry.specialty().getName())
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderHoldersByLastNameThenFirstName() {
+		Specialty radiology = createSpecialty("radiology");
+		Vet learyHelen = createVeterinarian("Helen", "Leary", radiology);
+		Vet carterAda = createVeterinarian("Ada", "Carter", radiology);
+		Vet carterJames = createVeterinarian("James", "Carter", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(learyHelen, carterJames, carterAda));
+
+		assertThat(directory.entries()).flatExtracting(SpecialtyEntry::holders)
+			.containsExactly(carterAda, carterJames, learyHelen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRejectAChangeToTheListItHandsOut() {
+		Specialty radiology = createSpecialty("radiology");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of());
+
+		assertThat(directory.entries()).isUnmodifiable();
+	}
+
+}
