+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * The clinic's specialties, each paired with the veterinarians holding it. Assembled per
+ * request from a specialty read and a veterinarian read; never persisted.
+ *
+ * <p>
+ * Order is decided here in Java rather than by a database <code>ORDER BY</code>, so that
+ * the page reads the same whatever collation the store happens to use.
+ */
+public record SpecialtyDirectory(List<SpecialtyEntry> entries) {
+
+	private static final Comparator<Specialty> BY_STORED_NAME = Comparator.comparing(NamedEntity::getName);
+
+	private static final Comparator<Vet> BY_HOLDER_NAME = Comparator.<Vet, String>comparing(Person::getLastName)
+		.thenComparing(Person::getFirstName)
+		.thenComparing(Vet::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it. The holder list is empty when no
+	 * veterinarian holds the specialty.
+	 */
+	public record SpecialtyEntry(Specialty specialty, List<Vet> holders) {
+
+		public SpecialtyEntry {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+	/**
+	 * Pair every known specialty with its holders.
+	 * @param specialties every specialty the clinic stores, held or not
+	 * @param veterinarians the clinic's veterinarians; one holding no specialty
+	 * contributes nothing to the directory
+	 * @return the directory, specialties ordered by stored name and holders by last name
+	 * then first name
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = groupHoldersBySpecialtyId(veterinarians);
+		List<SpecialtyEntry> entries = specialties.stream()
+			.sorted(BY_STORED_NAME)
+			.map(specialty -> new SpecialtyEntry(specialty, holdersOf(specialty, holdersBySpecialtyId)))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static Map<Integer, List<Vet>> groupHoldersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holdersBySpecialtyId;
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Map<Integer, List<Vet>> holdersBySpecialtyId) {
+		return holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of()).stream().sorted(BY_HOLDER_NAME).toList();
+	}
+
+}
