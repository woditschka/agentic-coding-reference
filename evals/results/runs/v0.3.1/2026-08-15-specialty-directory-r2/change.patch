+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * The clinic's specialties, each with the veterinarians holding it. A read model derived
+ * from the stored specialties and veterinarians; it holds no persistent state of its own
+ * and is immutable once built.
+ *
+ * <p>
+ * Entries are ordered by specialty name, and the veterinarians under each by last name
+ * then first name, so repeated requests over unchanged data present the same page.
+ *
+ * <p>
+ * As a value object it carries no identity of its own: two directories are equal when
+ * they hold equal entries in the same order.
+ */
+public final class SpecialtyDirectory {
+
+	private static final Comparator<Specialty> BY_SPECIALTY_NAME = Comparator.comparing(NamedEntity::getName,
+			Comparator.nullsLast(Comparator.naturalOrder()));
+
+	private static final Comparator<Vet> BY_VETERINARIAN_NAME = Comparator
+		.<Vet, String>comparing(Person::getLastName, Comparator.nullsLast(Comparator.naturalOrder()))
+		.thenComparing(Person::getFirstName, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	private final List<Entry> entries;
+
+	private SpecialtyDirectory(List<Entry> entries) {
+		this.entries = entries;
+	}
+
+	/**
+	 * Group the given veterinarians under the given specialties.
+	 * @param specialties every specialty the clinic knows; one entry is produced per
+	 * specialty, whether or not a veterinarian holds it
+	 * @param veterinarians the veterinarians to group; one holding no specialty appears
+	 * in no entry
+	 * @return a directory over defensive copies of both collections
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Objects.requireNonNull(specialties, "specialties must not be null");
+		Objects.requireNonNull(veterinarians, "veterinarians must not be null");
+
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_SPECIALTY_NAME)
+			.map(specialty -> new Entry(specialty, holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	/**
+	 * Veterinarians are matched to specialties by stored identity rather than by object
+	 * equality, which the persistence entities do not define.
+	 */
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new LinkedHashMap<>();
+		veterinarians.stream()
+			.sorted(BY_VETERINARIAN_NAME)
+			.forEach(vet -> vet.getSpecialties()
+				.forEach(specialty -> holders.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(vet)));
+		return holders;
+	}
+
+	/**
+	 * @return one entry per specialty, ordered by specialty name
+	 */
+	public List<Entry> getEntries() {
+		return this.entries;
+	}
+
+	@Override
+	public boolean equals(Object other) {
+		if (this == other) {
+			return true;
+		}
+		if (!(other instanceof SpecialtyDirectory that)) {
+			return false;
+		}
+		return this.entries.equals(that.entries);
+	}
+
+	@Override
+	public int hashCode() {
+		return this.entries.hashCode();
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it.
+	 *
+	 * <p>
+	 * Two entries are equal when they hold the same specialty and the same veterinarians
+	 * in the same order. The persistence entities define no equality of their own, so
+	 * they are compared as the stored records they stand for: the same row read twice
+	 * yields two objects that are not equal.
+	 */
+	public static final class Entry {
+
+		private final Specialty specialty;
+
+		private final List<Vet> veterinarians;
+
+		private Entry(Specialty specialty, List<Vet> veterinarians) {
+			this.specialty = specialty;
+			this.veterinarians = List.copyOf(veterinarians);
+		}
+
+		public Specialty getSpecialty() {
+			return this.specialty;
+		}
+
+		/**
+		 * @return the veterinarians holding this specialty, ordered by last name then
+		 * first name; empty when none holds it
+		 */
+		public List<Vet> getVeterinarians() {
+			return this.veterinarians;
+		}
+
+		@Override
+		public boolean equals(Object other) {
+			if (this == other) {
+				return true;
+			}
+			if (!(other instanceof Entry that)) {
+				return false;
+			}
+			return Objects.equals(this.specialty, that.specialty) && this.veterinarians.equals(that.veterinarians);
+		}
+
+		@Override
+		public int hashCode() {
+			return Objects.hash(this.specialty, this.veterinarians);
+		}
+
+	}
+
+}
