+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString(DENTISTRY)))
+			.andExpect(content().string(containsString(RADIOLOGY)))
+			.andExpect(content().string(containsString(SURGERY)))
+			.andExpect(content().string(not(containsString("specialties.html?page="))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachVeterinarianInFull() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString("Helen Leary")))
+			.andExpect(content().string(containsString("Linda Douglas")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowASpecialtyHeldByNoneAsHavingNoVeterinarians() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(stringContainsInOrder(SURGERY, NONE_WORDING)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() throws Exception {
+		this.mockMvc.perform(get("/specialties.html")).andExpect(content().string(not(containsString("James Carter"))));
+	}
+
+	@Test
+	void theSiteNavigationShouldNotLeadToTheSpecialtyDirectory() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(not(containsString("href=\"/specialties.html\""))));
+	}
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		Arrays.stream(specialties).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	@TestConfiguration
+	static class StubRepositories {
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return () -> List.of(DENTISTRY_SPECIALTY, RADIOLOGY_SPECIALTY, SURGERY_HELD_BY_NONE);
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new StubVetRepository();
+		}
+
+	}
+
+	private static class StubVetRepository implements VetRepository {
+
+		@Override
+		public Collection<Vet> findAll() {
+			return List.of(HELEN_LEARY, LINDA_DOUGLAS, JAMES_CARTER_WITHOUT_A_SPECIALTY);
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("the specialty directory reads veterinarians unpaged");
+		}
+
+	}
+
+}
