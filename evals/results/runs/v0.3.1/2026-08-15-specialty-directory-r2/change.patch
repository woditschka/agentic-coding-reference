+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the grouping of veterinarians under the
+ * specialties they hold.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private int nextId = 1;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyKnownToTheClinic() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of());
+
+		assertThat(specialtyNamesOf(directory)).containsExactly(RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet helen = createAVet("Helen", "Leary", radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(veterinariansUnder(directory, RADIOLOGY)).containsExactly(helen);
+		assertThat(veterinariansUnder(directory, SURGERY)).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+		Vet jamesWithoutASpecialty = createAVet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(helen, jamesWithoutASpecialty));
+
+		assertThat(directory.getEntries()).flatExtracting(SpecialtyDirectory.Entry::getVeterinarians)
+			.containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowASpecialtyHeldByNoneAsHavingNoVeterinarians() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgeryHeldByNone = createASpecialty(SURGERY);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgeryHeldByNone), List.of(helen));
+
+		assertThat(specialtyNamesOf(directory)).containsExactly(RADIOLOGY, SURGERY);
+		assertThat(veterinariansUnder(directory, SURGERY)).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentEntriesInAStableOrder() {
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet helenLeary = createAVet("Helen", "Leary", surgery);
+		Vet lindaDouglas = createAVet("Linda", "Douglas", surgery);
+
+		SpecialtyDirectory oneOrdering = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology),
+				List.of(helenLeary, lindaDouglas));
+		SpecialtyDirectory theReverseOrdering = SpecialtyDirectory.of(List.of(radiology, dentistry, surgery),
+				List.of(lindaDouglas, helenLeary));
+
+		assertThat(specialtyNamesOf(oneOrdering)).containsExactly(DENTISTRY, RADIOLOGY, SURGERY)
+			.isEqualTo(specialtyNamesOf(theReverseOrdering));
+		assertThat(veterinariansUnder(oneOrdering, SURGERY)).containsExactly(lindaDouglas, helenLeary)
+			.isEqualTo(veterinariansUnder(theReverseOrdering, SURGERY));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotChangeWhenTheCollectionsItWasBuiltFromChange() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+		List<Specialty> specialties = new ArrayList<>(List.of(radiology));
+		List<Vet> veterinarians = new ArrayList<>(List.of(helen));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, veterinarians);
+		specialties.add(createASpecialty(SURGERY));
+		veterinarians.clear();
+
+		assertThat(specialtyNamesOf(directory)).containsExactly(RADIOLOGY);
+		assertThat(veterinariansUnder(directory, RADIOLOGY)).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldEqualADirectoryGroupingTheSameVeterinariansUnderTheSameSpecialties() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet helenLeary = createAVet("Helen", "Leary", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helenLeary));
+		SpecialtyDirectory theSameDirectoryBuiltAgain = SpecialtyDirectory.of(List.of(surgery, radiology),
+				List.of(helenLeary));
+
+		assertThat(directory).isEqualTo(theSameDirectoryBuiltAgain).hasSameHashCodeAs(theSameDirectoryBuiltAgain);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotEqualADirectoryOverAnotherSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of());
+		SpecialtyDirectory aDirectoryOverAnotherSpecialty = SpecialtyDirectory.of(List.of(surgery), List.of());
+
+		assertThat(directory).isNotEqualTo(aDirectoryOverAnotherSpecialty);
+	}
+
+	@Test
+	void theSpecialtyDirectoryEntryShouldEqualAnEntryHoldingTheSameSpecialtyAndVeterinarians() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helenLeary = createAVet("Helen", "Leary", radiology);
+
+		SpecialtyDirectory.Entry entry = onlyEntryOf(SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary)));
+		SpecialtyDirectory.Entry theSameEntryBuiltAgain = onlyEntryOf(
+				SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary)));
+
+		assertThat(entry).isEqualTo(theSameEntryBuiltAgain).hasSameHashCodeAs(theSameEntryBuiltAgain);
+	}
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		Arrays.stream(specialties).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private List<String> specialtyNamesOf(SpecialtyDirectory directory) {
+		return directory.getEntries().stream().map(entry -> entry.getSpecialty().getName()).toList();
+	}
+
+	private SpecialtyDirectory.Entry onlyEntryOf(SpecialtyDirectory directory) {
+		assertThat(directory.getEntries()).hasSize(1);
+		return directory.getEntries().get(0);
+	}
+
+	private List<Vet> veterinariansUnder(SpecialtyDirectory directory, String specialtyName) {
+		return directory.getEntries()
+			.stream()
+			.filter(entry -> specialtyName.equals(entry.getSpecialty().getName()))
+			.findFirst()
+			.orElseThrow(() -> new AssertionError("no entry for specialty " + specialtyName))
+			.getVeterinarians();
+	}
+
+}
