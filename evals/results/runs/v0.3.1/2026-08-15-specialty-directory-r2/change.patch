+<!DOCTYPE html>
+
+<html xmlns:th="https://www.thymeleaf.org" th:replace="~{fragments/layout :: layout (~{::body},'specialties')}">
+
+<body>
+
+  <h2 th:text="#{specialties}">Specialties</h2>
+
+  <table id="specialties" class="table table-striped">
+    <thead>
+      <tr>
+        <th th:text="#{name}">Name</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="entry : ${specialtyDirectory.entries}">
+        <td th:text="${entry.specialty.name}"></td>
+        <td>
+          <span th:each="vet : ${entry.veterinarians}" th:text="${vet.firstName + ' ' + vet.lastName + ' '}" /> <span
+            th:if="${#lists.isEmpty(entry.veterinarians)}" th:text="#{none}">none</span>
+        </td>
+      </tr>
+    </tbody>
+  </table>
+</body>
+
+</html>
