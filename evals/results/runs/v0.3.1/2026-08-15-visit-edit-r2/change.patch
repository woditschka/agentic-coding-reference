+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link Pet}, covering the lookup a correction relies on to reach the one
+ * visit named in its path.
+ */
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	private static final int LATER_BOOKED_VISIT_ID = 2;
+
+	private static final int VISIT_ID_OF_ANOTHER_PET = 99;
+
+	@Test
+	void theLookupShouldReturnTheVisitCarryingTheGivenId() {
+		Pet pet = new Pet();
+		Visit bookedVisit = addVisitTo(pet, BOOKED_VISIT_ID);
+		addVisitTo(pet, LATER_BOOKED_VISIT_ID);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void theLookupShouldFindNothingForAnIdThisPetDoesNotCarry() {
+		Pet pet = new Pet();
+		addVisitTo(pet, BOOKED_VISIT_ID);
+
+		assertThat(pet.getVisit(VISIT_ID_OF_ANOTHER_PET)).isNull();
+	}
+
+	// A booking still being filled in is already attached to the pet but carries no id
+	// yet, so it must not answer a lookup that also names no id.
+	@Test
+	void theLookupShouldSkipAVisitThatHasNeverBeenSaved() {
+		Pet pet = new Pet();
+		pet.addVisit(new Visit());
+		Integer idOfAnUnsavedVisit = null;
+
+		assertThat(pet.getVisit(idOfAnUnsavedVisit)).isNull();
+	}
+
+	// Pet.addVisit keeps the instance it is handed, so the id can be assigned before or
+	// after the visit joins the pet; assigning it first keeps the visit saved-looking
+	// throughout.
+	private static Visit addVisitTo(Pet pet, int visitId) {
+		Visit visit = new Visit();
+		visit.setId(visitId);
+		pet.addVisit(visit);
+		return visit;
+	}
+
+}
