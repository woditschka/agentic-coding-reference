+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * One specialty paired with the veterinarians who hold it.
+ *
+ * @param holders the veterinarians holding the specialty; empty when none does
+ */
+record SpecialtyHolders(Specialty specialty, List<Vet> holders) {
+
+	SpecialtyHolders {
+		Objects.requireNonNull(specialty, "specialty must not be null");
+		holders = List.copyOf(holders);
+	}
+
+	/**
+	 * Pairs every listed specialty with its holders, including specialties nobody holds.
+	 * A held specialty is matched to a listed one by id, because the veterinarians and
+	 * the specialties are loaded separately and share no instances.
+	 * @param specialties every specialty to list
+	 * @param vets the veterinarians whose specialties are matched
+	 * @return one entry per listed specialty, in the order the specialties are given
+	 */
+	static List<SpecialtyHolders> forEverySpecialty(Collection<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet vet : vets) {
+			for (Specialty held : vet.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(vet);
+			}
+		}
+		return specialties.stream()
+			.map(specialty -> new SpecialtyHolders(specialty,
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+	}
+
+}
