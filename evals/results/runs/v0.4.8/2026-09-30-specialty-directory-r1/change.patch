+class SpecialtyHoldersTests {
+
+	private static final AtomicInteger NEXT_ID = new AtomicInteger(1);
+
+	@Test
+	void theSpecialtyHoldersShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty radiology = createASpecialty();
+		Specialty surgery = createASpecialty();
+		Vet holderOfBoth = createAVetHolding(radiology, surgery);
+
+		List<SpecialtyHolders> result = SpecialtyHolders.forEverySpecialty(List.of(radiology, surgery),
+				List.of(holderOfBoth));
+
+		assertThat(result).containsExactlyInAnyOrder(holdersOf(radiology, holderOfBoth),
+				holdersOf(surgery, holderOfBoth));
+	}
+
+	@Test
+	void theSpecialtyHoldersShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty held = createASpecialty();
+		Specialty unheld = createASpecialty();
+		Vet holder = createAVetHolding(held);
+
+		List<SpecialtyHolders> result = SpecialtyHolders.forEverySpecialty(List.of(held, unheld), List.of(holder));
+
+		assertThat(result).containsExactlyInAnyOrder(holdersOf(held, holder), holdersOf(unheld));
+	}
+
+	@Test
+	void theSpecialtyHoldersShouldOmitVeterinariansHoldingNoSpecialty() {
+		Specialty held = createASpecialty();
+		Vet holder = createAVetHolding(held);
+		Vet holdingNothing = createAVetHolding();
+
+		List<SpecialtyHolders> result = SpecialtyHolders.forEverySpecialty(List.of(held),
+				List.of(holder, holdingNothing));
+
+		assertThat(result).containsExactly(holdersOf(held, holder));
+	}
+
+	@Test
+	void theSpecialtyHoldersShouldMatchAHeldSpecialtyToTheListedOneByIdentityNotInstance() {
+		Specialty listed = createASpecialty();
+		Vet holder = createAVetHolding(listed);
+
+		List<SpecialtyHolders> result = SpecialtyHolders.forEverySpecialty(List.of(listed), List.of(holder));
+
+		assertThat(holder.getSpecialties()).doesNotContain(listed);
+		assertThat(result).containsExactly(holdersOf(listed, holder));
+	}
+
+	@Test
+	void theSpecialtyHoldersShouldRejectAMissingSpecialty() {
+		assertThatNullPointerException().isThrownBy(() -> holdersOf(null)).withMessageContaining("specialty");
+	}
+
+	private static Specialty createASpecialty() {
+		int id = NEXT_ID.getAndIncrement();
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName("any-specialty-" + id);
+		return specialty;
+	}
+
+	/**
+	 * Holds a distinct instance of each listed specialty with the same id, as a vet
+	 * loaded through the vet cache does.
+	 */
+	private static Vet createAVetHolding(Specialty... listed) {
+		int id = NEXT_ID.getAndIncrement();
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName("AnyFirstName" + id);
+		vet.setLastName("AnyLastName" + id);
+		for (Specialty specialty : listed) {
+			vet.addSpecialty(aSeparatelyLoadedCopyOf(specialty));
+		}
+		return vet;
+	}
+
+	private static Specialty aSeparatelyLoadedCopyOf(Specialty specialty) {
+		Specialty copy = new Specialty();
+		copy.setId(specialty.getId());
+		copy.setName(specialty.getName());
+		return copy;
+	}
+
+	private static SpecialtyHolders holdersOf(Specialty specialty, Vet... holders) {
+		return new SpecialtyHolders(specialty, List.of(holders));
+	}
+
+}
