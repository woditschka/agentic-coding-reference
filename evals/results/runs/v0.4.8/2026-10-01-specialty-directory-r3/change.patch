+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Entry;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Unit tests for the grouping and ordering rules of {@link SpecialtyDirectory}.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final int SOME_ID = 99;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderByFirstThenLastName() {
+		Specialty radiology = createASpecialty(1, RADIOLOGY);
+		Vet helen = createAVet(2, "Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory.entries()).containsExactly(new Entry(RADIOLOGY, List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(1, RADIOLOGY);
+		Vet holder = createAVet(2, "Helen", "Leary", radiology);
+		Vet nonHolder = createAVet(SOME_ID, "James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(nonHolder, holder));
+
+		assertThat(directory.entries()).containsExactly(new Entry(RADIOLOGY, List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty unheld = createASpecialty(1, DENTISTRY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(unheld), List.of());
+
+		assertThat(directory.entries()).containsExactly(new Entry(DENTISTRY, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyHeld() {
+		Specialty radiology = createASpecialty(1, RADIOLOGY);
+		Specialty surgery = createASpecialty(2, SURGERY);
+		Vet linda = createAVet(3, "Linda", "Douglas", radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(linda));
+
+		assertThat(directory.entries()).containsExactly(new Entry(RADIOLOGY, List.of("Linda Douglas")),
+				new Entry(SURGERY, List.of("Linda Douglas")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchHoldersByIdentityAcrossPersistenceContexts() {
+		Specialty listed = createASpecialty(1, RADIOLOGY);
+		Specialty reachedThroughVet = createASpecialty(1, RADIOLOGY);
+		Vet helen = createAVet(2, "Helen", "Leary", reachedThroughVet);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(listed), List.of(helen));
+
+		assertThat(directory.entries()).containsExactly(new Entry(RADIOLOGY, List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentEntriesInAStableOrder() {
+		Specialty surgery = createASpecialty(1, SURGERY);
+		Specialty radiology = createASpecialty(2, RADIOLOGY);
+		Specialty secondRadiology = createASpecialty(3, RADIOLOGY);
+		Vet smithB = createAVet(4, "Bea", "Smith", radiology);
+		Vet smithA = createAVet(5, "Al", "Smith", radiology);
+		Vet adams = createAVet(6, "Zed", "Adams", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(secondRadiology, surgery, radiology),
+				List.of(smithB, adams, smithA));
+
+		assertThat(directory.entries()).containsExactly(
+				new Entry(RADIOLOGY, List.of("Zed Adams", "Al Smith", "Bea Smith")), new Entry(RADIOLOGY, List.of()),
+				new Entry(SURGERY, List.of()));
+	}
+
+}
