+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.springframework.dao.DataAccessException;
+import org.springframework.data.repository.Repository;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Read-only repository for <code>Specialty</code> lookup values.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve every <code>Specialty</code>, including those no veterinarian holds.
+	 * @return all specialties, in no guaranteed order
+	 */
+	@Transactional(readOnly = true)
+	List<Specialty> findAll() throws DataAccessException;
+
+}
