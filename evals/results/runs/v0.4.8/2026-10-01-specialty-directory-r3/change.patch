+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * Every specialty with the full names of the veterinarians holding it. Specialties are
+ * ordered by name and holders by last name, then first name; identity breaks ties, so the
+ * order is stable whatever order the store returns.
+ *
+ * @param entries the specialties in presentation order
+ */
+record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Group the veterinarians under the specialties they hold. Matching is by identity,
+	 * since specialties read separately from veterinarians are distinct instances.
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		List<Entry> entries = specialties.stream()
+			.sorted(SPECIALTY_ORDER)
+			.map(specialty -> new Entry(specialty.getName(), holderNames(specialty, vets)))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static List<String> holderNames(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream()
+			.filter(vet -> holds(vet, specialty))
+			.sorted(HOLDER_ORDER)
+			.map(vet -> vet.getFirstName() + " " + vet.getLastName())
+			.toList();
+	}
+
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> held.getId().equals(specialty.getId()));
+	}
+
+	/**
+	 * One specialty by its stored name, with its holders' full names.
+	 */
+	record Entry(String specialtyName, List<String> holderNames) {
+
+		Entry {
+			holderNames = List.copyOf(holderNames);
+		}
+
+	}
+
+}
