+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int OWN_VISIT_ID = 1;
+
+	private static final int OTHER_PETS_VISIT_ID = 2;
+
+	@Test
+	void thePetShouldResolveItsOwnSavedVisitByIdentity() {
+		Visit ownVisit = createASavedVisit(OWN_VISIT_ID);
+		Pet pet = createAPetWith(ownVisit);
+
+		assertThat(pet.getVisit(OWN_VISIT_ID)).isSameAs(ownVisit);
+	}
+
+	@Test
+	void thePetShouldNotResolveAVisitBelongingToAnotherPet() {
+		Pet pet = createAPetWith(createASavedVisit(OWN_VISIT_ID));
+		createAPetWith(createASavedVisit(OTHER_PETS_VISIT_ID));
+
+		assertThat(pet.getVisit(OTHER_PETS_VISIT_ID)).isNull();
+	}
+
+	@Test
+	void thePetShouldNotResolveAnUnsavedVisit() {
+		Visit unsavedVisit = new Visit();
+		Pet pet = createAPetWith(unsavedVisit);
+
+		assertThat(pet.getVisit(unsavedVisit.getId())).isNull();
+	}
+
+	private static Pet createAPetWith(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+	private static Visit createASavedVisit(int id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+}
