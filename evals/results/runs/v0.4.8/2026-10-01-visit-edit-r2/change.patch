+package org.springframework.samples.petclinic.owner;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class PetTests {
+
+	private static final Integer BOOKED_VISIT_ID = 7;
+
+	private static final Integer UNKNOWN_VISIT_ID = 99;
+
+	private static final Integer NO_ID = null;
+
+	@Test
+	void thePetShouldFindABookedVisitByItsId() {
+		Visit bookedVisit = createAVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWith(bookedVisit);
+
+		Visit found = pet.getVisit(BOOKED_VISIT_ID);
+
+		assertThat(found).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldFindNoVisitForAnIdItDoesNotOwn() {
+		Pet pet = createAPetWith(createAVisit(BOOKED_VISIT_ID));
+
+		Visit found = pet.getVisit(UNKNOWN_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	@Test
+	void thePetShouldNeverReturnAnUnsavedVisitForAMissingId() {
+		Pet pet = createAPetWith(createAVisit(NO_ID));
+
+		Visit found = pet.getVisit(NO_ID);
+
+		assertThat(found).isNull();
+	}
+
+	private static Visit createAVisit(Integer id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Pet createAPetWith(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+}
