+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.samples.petclinic.vet.VetTestData.createASpecialty;
+import static org.springframework.samples.petclinic.vet.VetTestData.createAVet;
+
+/**
+ * Tests the rules of the {@link SpecialtyDirectory} with real entities and no doubles.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final Specialty RADIOLOGY = createASpecialty(1, "radiology");
+
+	private static final Specialty SURGERY = createASpecialty(2, "surgery");
+
+	private static final Specialty DENTISTRY = createASpecialty(3, "dentistry");
+
+	private static final Vet HELEN_LEARY = createAVet(1, "Helen", "Leary", RADIOLOGY);
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyWithTheVeterinariansHoldingIt() {
+		Vet linda = createAVet(2, "Linda", "Douglas", SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(RADIOLOGY, SURGERY), List.of(HELEN_LEARY, linda));
+
+		assertThat(directory.entries()).containsExactly(new Entry("radiology", List.of("Helen Leary")),
+				new Entry("surgery", List.of("Linda Douglas")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Vet james = createAVet(2, "James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(RADIOLOGY), List.of(james, HELEN_LEARY));
+
+		assertThat(directory.entries()).containsExactly(new Entry("radiology", List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEverySpecialtyHeld() {
+		Vet rafael = createAVet(2, "Rafael", "Ortega", SURGERY, RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(RADIOLOGY, SURGERY), List.of(rafael));
+
+		assertThat(directory.entries()).containsExactly(new Entry("radiology", List.of("Rafael Ortega")),
+				new Entry("surgery", List.of("Rafael Ortega")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(DENTISTRY, RADIOLOGY), List.of(HELEN_LEARY));
+
+		assertThat(directory.entries()).containsExactly(new Entry("dentistry", List.of()),
+				new Entry("radiology", List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByNameAndVeterinariansByLastThenFirstName() {
+		Vet zoe = createAVet(2, "Zoe", "Adams", RADIOLOGY);
+		Vet abe = createAVet(3, "Abe", "Leary", RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(SURGERY, RADIOLOGY),
+				List.of(HELEN_LEARY, abe, zoe));
+
+		assertThat(directory.entries()).containsExactly(
+				new Entry("radiology", List.of("Zoe Adams", "Abe Leary", "Helen Leary")),
+				new Entry("surgery", List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowASpecialtyNameAsStored() {
+		Specialty stored = createASpecialty(4, "Dental Surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(stored), List.of());
+
+		assertThat(directory.entries()).containsExactly(new Entry("Dental Surgery", List.of()));
+	}
+
+}
