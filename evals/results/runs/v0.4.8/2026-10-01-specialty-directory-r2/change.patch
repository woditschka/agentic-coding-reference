+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * Read model answering which veterinarians hold each specialty. Lists every specialty,
+ * including one no veterinarian holds, and omits a veterinarian holding none.
+ */
+public final class SpecialtyDirectory {
+
+	private static final Comparator<Vet> BY_LAST_FIRST_NAME_THEN_ID = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	private final List<Entry> entries;
+
+	private SpecialtyDirectory(List<Entry> entries) {
+		this.entries = List.copyOf(entries);
+	}
+
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		List<Vet> orderedVets = vets.stream().sorted(BY_LAST_FIRST_NAME_THEN_ID).toList();
+		List<Entry> entries = specialties.stream()
+			.sorted(Comparator.comparing(Specialty::getName).thenComparing(Specialty::getId))
+			.map(specialty -> entryFor(specialty, orderedVets))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static Entry entryFor(Specialty specialty, List<Vet> orderedVets) {
+		List<String> holders = orderedVets.stream()
+			.filter(vet -> vet.getSpecialties().stream().anyMatch(held -> held.getId().equals(specialty.getId())))
+			.map(vet -> vet.getFirstName() + " " + vet.getLastName())
+			.toList();
+		return new Entry(specialty.getName(), holders);
+	}
+
+	public List<Entry> entries() {
+		return this.entries;
+	}
+
+	@Override
+	public boolean equals(Object other) {
+		return other instanceof SpecialtyDirectory directory && this.entries.equals(directory.entries);
+	}
+
+	@Override
+	public int hashCode() {
+		return this.entries.hashCode();
+	}
+
+	/**
+	 * One specialty by its stored name with the full names of its veterinarians.
+	 */
+	public record Entry(String specialtyName, List<String> veterinarians) {
+
+		public Entry {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+}
