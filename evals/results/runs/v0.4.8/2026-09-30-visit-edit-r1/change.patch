+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	private static final int OTHER_VISIT_ID = 2;
+
+	private static final int UNKNOWN_VISIT_ID = 99;
+
+	@Test
+	void thePetShouldFindItsVisitById() {
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWithVisits(createABookedVisit(OTHER_VISIT_ID), bookedVisit);
+
+		Visit found = pet.getVisit(BOOKED_VISIT_ID);
+
+		assertThat(found).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldFindNoVisitForAnUnknownId() {
+		Pet pet = createAPetWithVisits(createABookedVisit(BOOKED_VISIT_ID));
+
+		Visit found = pet.getVisit(UNKNOWN_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	@Test
+	void thePetShouldNeverFindAnUnsavedVisit() {
+		Pet pet = createAPetWithVisits(createAnUnsavedVisit());
+
+		Visit found = pet.getVisit(null);
+
+		assertThat(found).isNull();
+	}
+
+	private static Pet createAPetWithVisits(Visit... visits) {
+		Pet pet = new Pet();
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+	private static Visit createABookedVisit(int id) {
+		Visit visit = createAnUnsavedVisit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+}
