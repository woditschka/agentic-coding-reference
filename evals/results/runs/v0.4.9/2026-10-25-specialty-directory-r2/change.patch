+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Import;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageImpl;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.containsString;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+@WebMvcTest(VetController.class)
+@Import(SpecialtyDirectoryPageTests.Clinic.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyDirectoryPageTests {
+
+	private static final String SPECIALTY_DIRECTORY_ROUTE = "/specialties.html";
+
+	private static final Path TEMPLATES = Path.of("src/main/resources/templates");
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private Clinic clinic;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyWithTheVeterinariansHoldingIt() throws Exception {
+		Specialty radiology = createASpecialty(1, "radiology");
+		clinic.stock(List.of(radiology), List.of(createAVet(1, "Helen", "Leary", radiology)));
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ROUTE))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(content().string(containsString("radiology")))
+			.andExpect(content().string(containsString("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowASpecialtyHeldByNoVeterinarianAsHeldByNone() throws Exception {
+		clinic.stock(List.of(createASpecialty(1, "dentistry")), List.of());
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ROUTE))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("dentistry")))
+			.andExpect(content().string(containsString("held by none")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldWordTheHeldByNoneMarkerInTheReadersLanguage() throws Exception {
+		clinic.stock(List.of(createASpecialty(1, "dentistry")), List.of());
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ROUTE).param("lang", "de"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("dentistry")))
+			.andExpect(content().string(containsString("von niemandem vertreten")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAllSpecialtiesOnOnePage() throws Exception {
+		int moreSpecialtiesThanAnyPageSize = 12;
+		List<Specialty> specialties = IntStream.rangeClosed(1, moreSpecialtiesThanAnyPageSize)
+			.mapToObj(id -> createASpecialty(id, "specialty-" + id))
+			.toList();
+		clinic.stock(specialties, List.of());
+
+		String page = mockMvc.perform(get(SPECIALTY_DIRECTORY_ROUTE))
+			.andExpect(status().isOk())
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+
+		assertThat(specialties).allSatisfy(specialty -> assertThat(page).contains(specialty.getName()));
+		assertThat(page).doesNotContain("page=");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderWhenTheClinicHasNoSpecialties() throws Exception {
+		clinic.stock(List.of(), List.of(createAVet(1, "James", "Carter")));
+
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ROUTE))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"));
+	}
+
+	@Test
+	void theOtherPagesShouldCarryNoLinkToTheSpecialtyDirectory() throws IOException {
+		Path ownTemplate = TEMPLATES.resolve("vets/specialtyList.html");
+
+		List<Path> linking;
+		try (Stream<Path> templates = Files.walk(TEMPLATES)) {
+			linking = templates.filter(path -> path.toString().endsWith(".html"))
+				.filter(path -> !path.equals(ownTemplate))
+				.filter(SpecialtyDirectoryPageTests::mentionsRoute)
+				.toList();
+		}
+
+		assertThat(linking).isEmpty();
+	}
+
+	private static boolean mentionsRoute(Path template) {
+		try {
+			return Files.readString(template).contains(SPECIALTY_DIRECTORY_ROUTE);
+		}
+		catch (IOException e) {
+			throw new IllegalStateException(e);
+		}
+	}
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	@TestConfiguration
+	static class Clinic {
+
+		private List<Specialty> specialties = List.of();
+
+		private List<Vet> vets = List.of();
+
+		void stock(List<Specialty> specialties, List<Vet> vets) {
+			this.specialties = specialties;
+			this.vets = vets;
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new VetRepository() {
+				@Override
+				public Collection<Vet> findAll() {
+					return vets;
+				}
+
+				@Override
+				public Page<Vet> findAll(Pageable pageable) {
+					return new PageImpl<>(vets);
+				}
+			};
+		}
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return () -> specialties;
+		}
+
+	}
+
+}
