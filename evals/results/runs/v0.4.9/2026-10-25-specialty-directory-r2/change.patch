+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Listing;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class SpecialtyDirectoryTests {
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private int nextId = 1;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyWithTheVeterinariansHoldingIt() {
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+		Vet linda = createAVet("Linda", "Douglas", dentistry, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, radiology), List.of(helen, linda));
+
+		assertThat(directory).isEqualTo(
+				directoryOf(listing(DENTISTRY, "Linda Douglas"), listing(RADIOLOGY, "Linda Douglas", "Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachVeterinarianByFirstNameThenLastName() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory).isEqualTo(directoryOf(listing(RADIOLOGY, "Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet linda = createAVet("Linda", "Douglas", dentistry, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, surgery), List.of(linda));
+
+		assertThat(directory)
+			.isEqualTo(directoryOf(listing(DENTISTRY, "Linda Douglas"), listing(SURGERY, "Linda Douglas")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+		Vet james = createAVet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(james, helen));
+
+		assertThat(directory).isEqualTo(directoryOf(listing(RADIOLOGY, "Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepASpecialtyHeldByNoVeterinarianWithNoHolders() {
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVet("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, radiology), List.of(helen));
+
+		assertThat(directory).isEqualTo(directoryOf(listing(DENTISTRY), listing(RADIOLOGY, "Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenTheClinicHasNoSpecialties() {
+		Vet james = createAVet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(james));
+
+		assertThat(directory).isEqualTo(directoryOf());
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByNameAndVeterinariansByLastThenFirstName() {
+		Specialty surgery = createASpecialty(SURGERY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Vet carterRose = createAVet("Rose", "Carter", surgery);
+		Vet carterAnn = createAVet("Ann", "Carter", surgery);
+		Vet adams = createAVet("Zoe", "Adams", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry),
+				List.of(carterRose, adams, carterAnn));
+
+		assertThat(directory)
+			.isEqualTo(directoryOf(listing(DENTISTRY), listing(SURGERY, "Zoe Adams", "Ann Carter", "Rose Carter")));
+	}
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private static Listing listing(String specialty, String... veterinarians) {
+		return new Listing(specialty, List.of(veterinarians));
+	}
+
+	private static SpecialtyDirectory directoryOf(Listing... listings) {
+		return new SpecialtyDirectory(List.of(listings));
+	}
+
+}
