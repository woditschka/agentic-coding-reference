+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * Every {@link Specialty} with the {@link Vet}s holding it. Specialties order by name and
+ * veterinarians by last then first name; identity breaks ties, so the order never depends
+ * on the order the store returns. A specialty held by no veterinarian is kept with no
+ * holders; a veterinarian holding no specialty does not appear.
+ *
+ * @param listings one per specialty, in display order
+ */
+record SpecialtyDirectory(List<Listing> listings) {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId, Comparator.nullsFirst(Comparator.naturalOrder()));
+
+	private static final Comparator<Vet> VETERINARIAN_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId, Comparator.nullsFirst(Comparator.naturalOrder()));
+
+	SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		List<Vet> orderedVets = vets.stream().sorted(VETERINARIAN_ORDER).toList();
+		List<Listing> listings = specialties.stream().sorted(SPECIALTY_ORDER).map(specialty -> {
+			List<String> holders = orderedVets.stream()
+				.filter(vet -> vet.getSpecialties().contains(specialty))
+				.map(vet -> vet.getFirstName() + " " + vet.getLastName())
+				.toList();
+			return new Listing(specialty.getName(), holders);
+		}).toList();
+		return new SpecialtyDirectory(listings);
+	}
+
+	/**
+	 * One specialty and the full names of its holders.
+	 *
+	 * @param specialty the specialty name as stored
+	 * @param veterinarians holders by first name then last name, in display order
+	 */
+	record Listing(String specialty, List<String> veterinarians) {
+
+		Listing {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+}
