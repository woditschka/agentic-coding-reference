+
+  <table id="specialtyDirectory" class="table table-striped">
+    <thead>
+      <tr>
+        <th th:text="#{specialties}">Specialties</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="listing : ${directory.listings}">
+        <td th:text="${listing.specialty}"></td>
+        <td>
+          <div th:each="veterinarian : ${listing.veterinarians}" th:text="${veterinarian}"></div>
+          <span th:if="${listing.veterinarians.isEmpty()}" th:text="#{heldByNone}">held by none</span>
+        </td>
+      </tr>
+    </tbody>
+  </table>
+</body>
+
+</html>
