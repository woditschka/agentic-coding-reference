+package org.springframework.samples.petclinic.vet;
+
+import static java.util.stream.Collectors.groupingBy;
+import static java.util.stream.Collectors.mapping;
+import static java.util.stream.Collectors.toList;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Every specialty the clinic knows, each with the full names of the veterinarians holding
+ * it. Specialties appear in name order and holders by last name, then first name;
+ * identity breaks remaining ties so the order never depends on how the inputs were
+ * iterated.
+ *
+ * @param entries one entry per specialty, in presentation order
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Specialty> BY_SPECIALTY_NAME = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> BY_HOLDER_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Holders are matched by specialty id: {@link Specialty} has no value equality, and
+	 * the instances inside each vet are not the ones the specialty read returns.
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = vets.stream()
+			.flatMap(vet -> vet.getSpecialties().stream().map(specialty -> Map.entry(specialty.getId(), vet)))
+			.collect(groupingBy(Map.Entry::getKey, mapping(Map.Entry::getValue, toList())));
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_SPECIALTY_NAME)
+			.map(specialty -> new Entry(specialty.getName(),
+					holderNames(holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of()))))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static List<String> holderNames(List<Vet> holders) {
+		return holders.stream().sorted(BY_HOLDER_NAME).map(SpecialtyDirectory::fullName).toList();
+	}
+
+	private static String fullName(Vet vet) {
+		return vet.getFirstName() + " " + vet.getLastName();
+	}
+
+	/**
+	 * One specialty and its holders.
+	 *
+	 * @param specialtyName the specialty's stored name
+	 * @param holderNames holders' full names, first name then last name; empty when no
+	 * veterinarian holds the specialty
+	 */
+	public record Entry(String specialtyName, List<String> holderNames) {
+
+		public Entry {
+			holderNames = List.copyOf(holderNames);
+		}
+
+	}
+
+}
