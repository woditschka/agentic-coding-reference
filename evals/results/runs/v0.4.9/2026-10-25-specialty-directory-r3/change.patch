+<!DOCTYPE html>
+
+<html xmlns:th="https://www.thymeleaf.org" th:replace="~{fragments/layout :: layout (~{::body},'specialties')}">
+
+<body>
+
+  <h2 th:text="#{specialtyDirectory}">Specialty Directory</h2>
+
+  <table id="specialties" class="table table-striped">
+    <thead>
+      <tr>
+        <th th:text="#{specialty}">Specialty</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="entry : ${specialtyDirectory.entries}">
+        <td th:text="${entry.specialtyName}"></td>
+        <td>
+          <span th:each="holderName, holder : ${entry.holderNames}"
+            th:text="${holder.last ? holderName : holderName + ', '}" /> <span
+            th:if="${entry.holderNames.isEmpty()}" th:text="#{none}">none</span>
+        </td>
+      </tr>
+    </tbody>
+  </table>
+</body>
+
+</html>
