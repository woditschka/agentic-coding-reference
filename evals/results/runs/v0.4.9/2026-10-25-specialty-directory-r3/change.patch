+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class SpecialtyDirectoryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int DENTISTRY_ID = 3;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String HOLDER_FIRST_NAME = "Helen";
+
+	private static final String HOLDER_LAST_NAME = "Leary";
+
+	private static final String HOLDER_FULL_NAME = "Helen Leary";
+
+	private static final String ANY_FIRST_NAME = "Any";
+
+	private static final String ANY_LAST_NAME = "Vet";
+
+	private static final String EARLIEST_LAST_NAME = "Douglas";
+
+	private static final String SHARED_LAST_NAME = "Leary";
+
+	private static final String LATEST_LAST_NAME = "Ortega";
+
+	private static final String EARLIER_FIRST_NAME = "Helen";
+
+	private static final String LATER_FIRST_NAME = "Sharon";
+
+	private final AtomicInteger nextVetId = new AtomicInteger();
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderByFullNameUnderTheirSpecialty() {
+		Vet holderOfBoth = aVet(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, radiology(), surgery());
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology(), surgery()), List.of(holderOfBoth));
+
+		assertThat(directory).isEqualTo(
+				directoryOf(entry(RADIOLOGY, List.of(HOLDER_FULL_NAME)), entry(SURGERY, List.of(HOLDER_FULL_NAME))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() {
+		Vet holder = aVet(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, radiology());
+		Vet holderOfNone = aVet(ANY_FIRST_NAME, ANY_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology()), List.of(holder, holderOfNone));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(RADIOLOGY, List.of(HOLDER_FULL_NAME))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowASpecialtyWithNoHoldersAsHavingNone() {
+		Vet radiologist = aVet(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, radiology());
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology(), surgery()), List.of(radiologist));
+
+		assertThat(directory)
+			.isEqualTo(directoryOf(entry(RADIOLOGY, List.of(HOLDER_FULL_NAME)), entry(SURGERY, List.of())));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentEntriesInAStableOrder() {
+		List<Specialty> specialtiesUnsorted = List.of(surgery(), dentistry(), radiology());
+		List<Vet> holdersUnsorted = List.of(aVet(ANY_FIRST_NAME, LATEST_LAST_NAME, surgery()),
+				aVet(LATER_FIRST_NAME, SHARED_LAST_NAME, surgery()),
+				aVet(EARLIER_FIRST_NAME, SHARED_LAST_NAME, surgery()),
+				aVet(ANY_FIRST_NAME, EARLIEST_LAST_NAME, surgery()));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialtiesUnsorted, holdersUnsorted);
+
+		assertThat(directory).isEqualTo(directoryOf(entry(DENTISTRY, List.of()), entry(RADIOLOGY, List.of()),
+				entry(SURGERY, List.of(fullName(ANY_FIRST_NAME, EARLIEST_LAST_NAME),
+						fullName(EARLIER_FIRST_NAME, SHARED_LAST_NAME), fullName(LATER_FIRST_NAME, SHARED_LAST_NAME),
+						fullName(ANY_FIRST_NAME, LATEST_LAST_NAME)))));
+	}
+
+	private static String fullName(String firstName, String lastName) {
+		return firstName + " " + lastName;
+	}
+
+	// Each call returns a fresh instance sharing the id, as the specialty read and the
+	// cached vets do; Specialty has no value equality, so matching must be by id.
+	private static Specialty radiology() {
+		return aSpecialty(RADIOLOGY_ID, RADIOLOGY);
+	}
+
+	private static Specialty surgery() {
+		return aSpecialty(SURGERY_ID, SURGERY);
+	}
+
+	private static Specialty dentistry() {
+		return aSpecialty(DENTISTRY_ID, DENTISTRY);
+	}
+
+	private static Specialty aSpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet aVet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(nextVetId.incrementAndGet());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(specialties).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static SpecialtyDirectory directoryOf(SpecialtyDirectory.Entry... entries) {
+		return new SpecialtyDirectory(List.of(entries));
+	}
+
+	private static SpecialtyDirectory.Entry entry(String specialtyName, List<String> holderNames) {
+		return new SpecialtyDirectory.Entry(specialtyName, holderNames);
+	}
+
+}
