+
+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.stream.IntStream;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.boot.jpa.test.autoconfigure.TestEntityManager;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.data.domain.Pageable;
+
+/**
+ * Tests the specialty matching rule of {@link VetRepository} against the real database.
+ * Fixture specialties use names absent from the seed data, so seeded vets never match.
+ */
+@DataJpaTest
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VetRepositoryTests {
+
+	private static final String FIXTURE_SPECIALTY = "oncology";
+
+	private static final String FIXTURE_SPECIALTY_IN_OTHER_CASE = "Oncology";
+
+	private static final String OTHER_SPECIALTY = "cardiology";
+
+	private static final String UNHELD_SPECIALTY = "dermatology";
+
+	private static final String ANY_FURTHER_SPECIALTY = "acupuncture";
+
+	private static final int PAGE_SIZE = 5;
+
+	private static final AtomicInteger uniqueSuffix = new AtomicInteger();
+
+	@Autowired
+	private VetRepository vets;
+
+	@Autowired
+	private TestEntityManager entityManager;
+
+	@Test
+	void theSpecialtyFilterShouldListOnlyVetsHoldingTheRequestedSpecialty() {
+		Specialty requested = createASpecialty(FIXTURE_SPECIALTY);
+		Vet holder = createAVet(requested);
+		Vet holderOfSeveral = createAVet(requested, createASpecialty(ANY_FURTHER_SPECIALTY));
+		createAVet(createASpecialty(OTHER_SPECIALTY));
+		createAVet();
+
+		Collection<Vet> found = this.vets.findBySpecialty(FIXTURE_SPECIALTY);
+
+		assertThat(found).containsExactlyInAnyOrder(holder, holderOfSeveral);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldMatchOnlyTheWholeNameIgnoringCase() {
+		Vet holder = createAVet(createASpecialty(FIXTURE_SPECIALTY));
+		String nameInOtherCase = FIXTURE_SPECIALTY.toUpperCase(Locale.ROOT);
+		String prefixOfName = FIXTURE_SPECIALTY.substring(0, FIXTURE_SPECIALTY.length() - 1);
+
+		Collection<Vet> foundByOtherCase = this.vets.findBySpecialty(nameInOtherCase);
+		Collection<Vet> foundByPrefix = this.vets.findBySpecialty(prefixOfName);
+		Page<Vet> pageFoundByOtherCase = this.vets.findBySpecialty(nameInOtherCase, PageRequest.of(0, PAGE_SIZE));
+		Page<Vet> pageFoundByPrefix = this.vets.findBySpecialty(prefixOfName, PageRequest.of(0, PAGE_SIZE));
+
+		assertThat(foundByOtherCase).containsExactly(holder);
+		assertThat(foundByPrefix).isEmpty();
+		assertThat(pageFoundByOtherCase.getContent()).containsExactly(holder);
+		assertThat(pageFoundByOtherCase.getTotalElements()).isEqualTo(1);
+		assertThat(pageFoundByPrefix).isEmpty();
+		assertThat(pageFoundByPrefix.getTotalElements()).isZero();
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { "onco%", "oncolog_", "%", "_%" })
+	void theSpecialtyFilterShouldTreatWildcardCharactersLiterally(String wildcardName) {
+		createAVet(createASpecialty(FIXTURE_SPECIALTY));
+
+		Collection<Vet> found = this.vets.findBySpecialty(wildcardName);
+		Page<Vet> foundPage = this.vets.findBySpecialty(wildcardName, PageRequest.of(0, PAGE_SIZE));
+
+		assertThat(found).isEmpty();
+		assertThat(foundPage).isEmpty();
+		assertThat(foundPage.getTotalElements()).isZero();
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { UNHELD_SPECIALTY, "no-such-specialty" })
+	void theSpecialtyFilterShouldYieldAnEmptyVetListWhenNoVetHoldsTheSpecialty(String unheldName) {
+		createASpecialty(UNHELD_SPECIALTY);
+		createAVet(createASpecialty(FIXTURE_SPECIALTY));
+
+		Collection<Vet> found = this.vets.findBySpecialty(unheldName);
+		Page<Vet> foundPage = this.vets.findBySpecialty(unheldName, PageRequest.of(0, PAGE_SIZE));
+
+		assertThat(found).isEmpty();
+		assertThat(foundPage).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyFilterShouldListEachMatchingVetOnce() {
+		Vet holderOfBothSpellings = createAVet(createASpecialty(FIXTURE_SPECIALTY),
+				createASpecialty(FIXTURE_SPECIALTY_IN_OTHER_CASE));
+
+		Collection<Vet> found = this.vets.findBySpecialty(FIXTURE_SPECIALTY);
+		Page<Vet> foundPage = this.vets.findBySpecialty(FIXTURE_SPECIALTY, PageRequest.of(0, PAGE_SIZE));
+
+		assertThat(found).containsExactly(holderOfBothSpellings);
+		assertThat(foundPage.getContent()).containsExactly(holderOfBothSpellings);
+		assertThat(foundPage.getTotalElements()).isEqualTo(found.size());
+	}
+
+	@Test
+	void theVetDirectoryShouldPaginateTheFilteredList() {
+		Specialty requested = createASpecialty(FIXTURE_SPECIALTY);
+		List<Vet> holders = createVetsHolding(requested, PAGE_SIZE + 1);
+		createAVet(createASpecialty(OTHER_SPECIALTY));
+		Pageable secondPage = PageRequest.of(1, PAGE_SIZE);
+
+		Page<Vet> found = this.vets.findBySpecialty(FIXTURE_SPECIALTY, secondPage);
+
+		assertThat(found.getTotalElements()).isEqualTo(holders.size());
+		assertThat(found.getContent()).containsExactly(holders.get(PAGE_SIZE));
+	}
+
+	private List<Vet> createVetsHolding(Specialty specialty, int count) {
+		return IntStream.range(0, count).mapToObj(ignored -> createAVet(specialty)).toList();
+	}
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return this.entityManager.persist(specialty);
+	}
+
+	private Vet createAVet(Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setFirstName("AnyFirstName" + uniqueSuffix.incrementAndGet());
+		vet.setLastName("AnyLastName" + uniqueSuffix.incrementAndGet());
+		Arrays.stream(specialties).forEach(vet::addSpecialty);
+		return this.entityManager.persist(vet);
+	}
+
+}
