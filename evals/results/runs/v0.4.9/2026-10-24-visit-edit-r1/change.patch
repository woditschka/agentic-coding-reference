+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	// Outside the Integer cache, so a reference comparison of ids would miss the match.
+	private static final int BOOKED_VISIT_ID = 1000;
+
+	private static final int OTHER_VISIT_ID = 1001;
+
+	private static final int MISSING_VISIT_ID = 1002;
+
+	@Test
+	void thePetShouldFindItsPersistedVisitById() {
+		Visit bookedVisit = createAPersistedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWith(createAPersistedVisit(OTHER_VISIT_ID), bookedVisit);
+
+		assertThat(pet.getVisit(Integer.valueOf(BOOKED_VISIT_ID))).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldFindNoVisitForAnIdItDoesNotHave() {
+		Pet pet = createAPetWith(createAPersistedVisit(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(MISSING_VISIT_ID)).isNull();
+	}
+
+	@Test
+	void thePetShouldNotFindAnUnsavedVisit() {
+		Pet pet = createAPetWith(createAnUnsavedVisit());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	private static Pet createAPetWith(Visit... visits) {
+		Pet pet = new Pet();
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+	private static Visit createAPersistedVisit(int id) {
+		Visit visit = createAnUnsavedVisit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+}
