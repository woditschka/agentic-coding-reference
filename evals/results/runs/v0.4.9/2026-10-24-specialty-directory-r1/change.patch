+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Every stored {@link Specialty}, each with the veterinarians holding it, in the order
+ * the specialty directory page shows them.
+ *
+ * <p>
+ * Veterinarians join a specialty by its identity, because the veterinarians come from a
+ * cached read whose {@link Specialty} instances differ from the freshly read ones. A held
+ * specialty missing from the stored specialties is skipped, so the directory lists only
+ * stored specialties even when the veterinarian cache is stale. Identity breaks name ties
+ * so the order is stable.
+ *
+ * @param listings one entry per stored specialty, ordered by specialty name
+ */
+public record SpecialtyDirectory(List<Listing> listings) {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> VET_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(vets);
+		List<Listing> listings = specialties.stream()
+			.sorted(SPECIALTY_ORDER)
+			.map(specialty -> Listing.of(specialty, holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+		return new SpecialtyDirectory(listings);
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> vets) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet vet : vets) {
+			for (Specialty held : vet.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(vet);
+			}
+		}
+		return holders;
+	}
+
+	/**
+	 * One specialty as the directory shows it.
+	 *
+	 * @param specialtyName the stored specialty name
+	 * @param vetNames full names ("first last") of the veterinarians holding it, ordered
+	 * by last name, then first name
+	 */
+	public record Listing(String specialtyName, List<String> vetNames) {
+
+		public Listing {
+			vetNames = List.copyOf(vetNames);
+		}
+
+		private static Listing of(Specialty specialty, List<Vet> holders) {
+			List<String> vetNames = holders.stream().sorted(VET_ORDER).map(Listing::fullName).toList();
+			return new Listing(specialty.getName(), vetNames);
+		}
+
+		private static String fullName(Vet vet) {
+			return vet.getFirstName() + " " + vet.getLastName();
+		}
+
+	}
+
+}
