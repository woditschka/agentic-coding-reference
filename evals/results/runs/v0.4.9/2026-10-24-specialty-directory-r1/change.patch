+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Listing;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class SpecialtyDirectoryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final int SURGERY_ID = 2;
+
+	private static final String SURGERY = "surgery";
+
+	private static final int DENTISTRY_ID = 3;
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final int HELEN_ID = 1;
+
+	private static final String HELEN_FIRST_NAME = "Helen";
+
+	private static final String HELEN_LAST_NAME = "Leary";
+
+	private static final String HELEN_FULL_NAME = HELEN_FIRST_NAME + " " + HELEN_LAST_NAME;
+
+	private static final int JAMES_ID = 2;
+
+	private static final String JAMES_FIRST_NAME = "James";
+
+	private static final String JAMES_LAST_NAME = "Carter";
+
+	private static final String JAMES_FULL_NAME = JAMES_FIRST_NAME + " " + JAMES_LAST_NAME;
+
+	private static final String ANY_SPECIALTY_NAME = "anesthesia";
+
+	private static final int ANY_VET_ID = 11;
+
+	private static final int ANY_OTHER_VET_ID = 12;
+
+	private static final int ANY_THIRD_VET_ID = 13;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEveryStoredSpecialtyByItsStoredName() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY_ID, SURGERY);
+		Vet helen = createAVet(HELEN_ID, HELEN_FIRST_NAME, HELEN_LAST_NAME, radiology);
+		Vet james = createAVet(JAMES_ID, JAMES_FIRST_NAME, JAMES_LAST_NAME, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen, james));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(List.of(new Listing(RADIOLOGY, List.of(HELEN_FULL_NAME)),
+				new Listing(SURGERY, List.of(JAMES_FULL_NAME)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListVetUnderEachHeldSpecialtyByFullName() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY_ID, SURGERY);
+		Vet helen = createAVet(HELEN_ID, HELEN_FIRST_NAME, HELEN_LAST_NAME, radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(List.of(new Listing(RADIOLOGY, List.of(HELEN_FULL_NAME)),
+				new Listing(SURGERY, List.of(HELEN_FULL_NAME)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVetHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet helen = createAVet(HELEN_ID, HELEN_FIRST_NAME, HELEN_LAST_NAME, radiology);
+		Vet james = createAVet(JAMES_ID, JAMES_FIRST_NAME, JAMES_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, james));
+
+		assertThat(directory)
+			.isEqualTo(new SpecialtyDirectory(List.of(new Listing(RADIOLOGY, List.of(HELEN_FULL_NAME)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListSpecialtyHeldByNoVetWithNoVetUnderIt() {
+		Specialty dentistry = createASpecialty(DENTISTRY_ID, DENTISTRY);
+		Vet james = createAVet(JAMES_ID, JAMES_FIRST_NAME, JAMES_LAST_NAME);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry), List.of(james));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(List.of(new Listing(DENTISTRY, List.of()))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByNameThenIdentity() {
+		int lowerId = 4;
+		int higherId = 5;
+		Specialty surgery = createASpecialty(SURGERY_ID, SURGERY);
+		Specialty radiologyWithHigherId = createASpecialty(higherId, RADIOLOGY);
+		Specialty radiologyWithLowerId = createASpecialty(lowerId, RADIOLOGY);
+		Vet helen = createAVet(HELEN_ID, HELEN_FIRST_NAME, HELEN_LAST_NAME, radiologyWithHigherId);
+		Vet james = createAVet(JAMES_ID, JAMES_FIRST_NAME, JAMES_LAST_NAME, radiologyWithLowerId);
+
+		SpecialtyDirectory directory = SpecialtyDirectory
+			.of(List.of(surgery, radiologyWithHigherId, radiologyWithLowerId), List.of(helen, james));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(List.of(new Listing(RADIOLOGY, List.of(JAMES_FULL_NAME)),
+				new Listing(RADIOLOGY, List.of(HELEN_FULL_NAME)), new Listing(SURGERY, List.of()))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVetsByLastNameThenFirstName() {
+		String sharedLastName = "Douglas";
+		String earlierFirstName = "Henry";
+		String laterFirstName = "Linda";
+		String laterLastName = "Jenkins";
+		String earliestFirstName = "Alice";
+		Specialty surgery = createASpecialty(SURGERY_ID, SURGERY);
+		Vet linda = createAVet(ANY_VET_ID, laterFirstName, sharedLastName, surgery);
+		Vet alice = createAVet(ANY_OTHER_VET_ID, earliestFirstName, laterLastName, surgery);
+		Vet henry = createAVet(ANY_THIRD_VET_ID, earlierFirstName, sharedLastName, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery), List.of(linda, alice, henry));
+
+		assertThat(directory).isEqualTo(
+				new SpecialtyDirectory(List.of(new Listing(SURGERY, List.of(earlierFirstName + " " + sharedLastName,
+						laterFirstName + " " + sharedLastName, earliestFirstName + " " + laterLastName)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchHeldSpecialtyByIdentityNotByInstance() {
+		Specialty storedRadiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty heldRadiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet helen = createAVet(HELEN_ID, HELEN_FIRST_NAME, HELEN_LAST_NAME, heldRadiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(storedRadiology), List.of(helen));
+
+		assertThat(directory)
+			.isEqualTo(new SpecialtyDirectory(List.of(new Listing(RADIOLOGY, List.of(HELEN_FULL_NAME)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldIgnoreHeldSpecialtyMissingFromStoredSpecialties() {
+		int unstoredSpecialtyId = 9;
+		Specialty radiology = createASpecialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty unstored = createASpecialty(unstoredSpecialtyId, ANY_SPECIALTY_NAME);
+		Vet helen = createAVet(HELEN_ID, HELEN_FIRST_NAME, HELEN_LAST_NAME, radiology, unstored);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory)
+			.isEqualTo(new SpecialtyDirectory(List.of(new Listing(RADIOLOGY, List.of(HELEN_FULL_NAME)))));
+	}
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(int id, String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
