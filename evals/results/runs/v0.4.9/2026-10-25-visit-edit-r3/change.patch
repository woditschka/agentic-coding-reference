+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 7;
+
+	private static final int SOME_OTHER_VISIT_ID = 8;
+
+	private static final int UNKNOWN_VISIT_ID = 99;
+
+	@Test
+	void thePetShouldResolveItsPersistedVisitByIdentity() {
+		Visit bookedVisit = createAPersistedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWith(createAPersistedVisit(SOME_OTHER_VISIT_ID), bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldResolveNoVisitForAnUnknownIdentity() {
+		Pet pet = createAPetWith(createAPersistedVisit(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(UNKNOWN_VISIT_ID)).isNull();
+	}
+
+	@Test
+	void thePetShouldNotResolveAnUnsavedVisit() {
+		Pet pet = createAPetWith(createAnUnsavedVisit());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	private static Pet createAPetWith(Visit... visits) {
+		Pet pet = new Pet();
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+	private static Visit createAPersistedVisit(int id) {
+		Visit visit = createAnUnsavedVisit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+}
