--- a/src/main/java/org/springframework/samples/petclinic/vet/VetRepository.java
+++ b/src/main/java/org/springframework/samples/petclinic/vet/VetRepository.java
@@ -55,4 +55,27 @@ public interface VetRepository extends Repository<Vet, Integer> {
 	@Cacheable("vets")
 	Page<Vet> findAll(Pageable pageable) throws DataAccessException;
 
+	/**
+	 * Retrieve the {@link Vet}s holding the named specialty, matching the whole name
+	 * regardless of letter case. Each vet appears once, with all its specialties.
+	 * <p>
+	 * Not cached: the specialty is caller-supplied text, and keying the unbounded
+	 * {@code vets} cache on it would let callers grow the cache at will.
+	 * @param specialty the specialty name to match
+	 * @return the matching vets, or an empty collection if none holds the specialty
+	 */
+	@Transactional(readOnly = true)
+	Collection<Vet> findDistinctBySpecialtiesNameIgnoreCase(String specialty) throws DataAccessException;
+
+	/**
+	 * Retrieve one page of the {@link Vet}s holding the named specialty, matching as
+	 * {@link #findDistinctBySpecialtiesNameIgnoreCase(String)} does; the page count
+	 * covers the matching vets only. Not cached, for the same reason.
+	 * @param specialty the specialty name to match
+	 * @param pageable the page to retrieve
+	 * @return the requested page of matching vets
+	 */
+	@Transactional(readOnly = true)
+	Page<Vet> findDistinctBySpecialtiesNameIgnoreCase(String specialty, Pageable pageable) throws DataAccessException;
+
 }
