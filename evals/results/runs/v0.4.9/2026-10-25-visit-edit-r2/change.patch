+
+	private static Visit createASavedVisit(int id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+	@Test
+	void thePetsVisitLookupShouldReturnTheSavedVisitWithTheGivenId() {
+		Visit bookedVisit = createASavedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWithVisit(bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetsVisitLookupShouldFindNothingForAnIdTheVisitsDoNotCarry() {
+		Pet pet = createAPetWithVisit(createASavedVisit(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(UNKNOWN_VISIT_ID)).isNull();
+	}
+
+	@Test
+	void thePetsVisitLookupShouldSkipAnUnsavedVisit() {
+		Pet pet = createAPetWithVisit(createAnUnsavedVisit());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+}
