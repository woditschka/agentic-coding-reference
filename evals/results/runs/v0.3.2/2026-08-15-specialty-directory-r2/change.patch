+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * The clinic's specialties, each with the veterinarians holding it.
+ *
+ * <p>
+ * The veterinarian-to-specialty association is mapped in one direction only, so this
+ * directory answers the inverse question by pairing the two collections in memory.
+ */
+public final class SpecialtyDirectory {
+
+	private static final Comparator<Specialty> BY_NAME = Comparator.comparing(NamedEntity::getName);
+
+	private static final Comparator<Vet> BY_LAST_NAME = Comparator.<Vet, String>comparing(Person::getLastName)
+		.thenComparing(Person::getFirstName);
+
+	private final List<Entry> entries;
+
+	private SpecialtyDirectory(List<Entry> entries) {
+		this.entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Pairs every specialty with the veterinarians holding it.
+	 * @param specialties the specialties the clinic knows
+	 * @param veterinarians the veterinarians whose specialties are paired against them
+	 * @return a directory listing every given specialty in name order, whether or not a
+	 * veterinarian holds it
+	 * @throws IllegalArgumentException if a specialty carries no stored identity, which
+	 * the pairing needs to recognize it
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		// Both collections are read elsewhere and the veterinarians are shared through a
+		// cache, so ordering happens on copies and never on the arguments themselves.
+		List<Specialty> orderedSpecialties = new ArrayList<>(specialties);
+		orderedSpecialties.sort(BY_NAME);
+		List<Entry> entries = new ArrayList<>();
+		for (Specialty specialty : orderedSpecialties) {
+			requireStoredIdentity(specialty);
+			entries.add(new Entry(specialty, holdersOf(specialty, veterinarians)));
+		}
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static void requireStoredIdentity(Specialty specialty) {
+		if (specialty.getId() == null) {
+			throw new IllegalArgumentException(
+					"Specialty '" + specialty.getName() + "' has no id, so no veterinarian can be paired against it");
+		}
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> veterinarians) {
+		List<Vet> holders = new ArrayList<>();
+		for (Vet veterinarian : veterinarians) {
+			if (holds(veterinarian, specialty)) {
+				holders.add(veterinarian);
+			}
+		}
+		holders.sort(BY_LAST_NAME);
+		return holders;
+	}
+
+	private static boolean holds(Vet veterinarian, Specialty specialty) {
+		return veterinarian.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+	public List<Entry> getEntries() {
+		return this.entries;
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it.
+	 */
+	public static final class Entry {
+
+		private final Specialty specialty;
+
+		private final List<Vet> veterinarians;
+
+		private Entry(Specialty specialty, List<Vet> veterinarians) {
+			this.specialty = specialty;
+			this.veterinarians = List.copyOf(veterinarians);
+		}
+
+		public Specialty getSpecialty() {
+			return this.specialty;
+		}
+
+		public List<Vet> getVeterinarians() {
+			return this.veterinarians;
+		}
+
+	}
+
+}
