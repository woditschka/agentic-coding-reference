+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatIllegalArgumentException;
+
+/**
+ * Test class for {@link SpecialtyDirectory}.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int DENTISTRY_ID = 3;
+
+	@Test
+	void theSpecialtyDirectoryShouldPairASpecialtyWithTheVeterinariansHoldingTheSameStoredSpecialty() {
+		// The specialties and the veterinarians come from two separate reads, so the same
+		// stored specialty arrives as two instances that share only their row id.
+		Specialty radiologyAsRead = specialty(RADIOLOGY_ID, "radiology");
+		Vet helen = veterinarian("Helen", "Leary", specialty(RADIOLOGY_ID, "radiology"));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiologyAsRead), List.of(helen));
+
+		assertThat(directory.getEntries()).hasSize(1);
+		SpecialtyDirectory.Entry entry = directory.getEntries().get(0);
+		assertThat(entry.getSpecialty()).isSameAs(radiologyAsRead);
+		assertThat(entry.getVeterinarians()).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByNameAndTheirVeterinariansByLastName() {
+		Specialty surgery = specialty(SURGERY_ID, "surgery");
+		List<Specialty> outOfOrder = List.of(surgery, specialty(RADIOLOGY_ID, "radiology"),
+				specialty(DENTISTRY_ID, "dentistry"));
+		Vet ortega = veterinarian("Rafael", "Ortega", specialty(SURGERY_ID, "surgery"));
+		Vet douglas = veterinarian("Linda", "Douglas", specialty(SURGERY_ID, "surgery"));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(outOfOrder, List.of(ortega, douglas));
+
+		assertThat(directory.getEntries()).extracting(entry -> entry.getSpecialty().getName())
+			.containsExactly("dentistry", "radiology", "surgery");
+		assertThat(entryFor(directory, surgery).getVeterinarians()).containsExactly(douglas, ortega);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHoldsWithNoVeterinarians() {
+		Specialty dentistry = specialty(DENTISTRY_ID, "dentistry");
+		Vet holderOfAnotherSpecialty = veterinarian("Helen", "Leary", specialty(RADIOLOGY_ID, "radiology"));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry), List.of(holderOfAnotherSpecialty));
+
+		assertThat(entryFor(directory, dentistry).getVeterinarians()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPlaceAVeterinarianHoldingNoSpecialtyUnderNoEntry() {
+		Specialty radiology = specialty(RADIOLOGY_ID, "radiology");
+		Vet holderOfNoSpecialty = veterinarian("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(holderOfNoSpecialty));
+
+		assertThat(entryFor(directory, radiology).getVeterinarians()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenTheClinicKnowsNoSpecialties() {
+		Vet onlyVeterinarianOnStaff = veterinarian("Helen", "Leary", specialty(RADIOLOGY_ID, "radiology"));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(onlyVeterinarianOnStaff));
+
+		assertThat(directory.getEntries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldLeaveTheGivenCollectionsInTheOrderTheyArrivedIn() {
+		// The veterinarian collection is the shared cached read: ordering it in place
+		// would corrupt the cache entry for every later request.
+		Specialty surgery = specialty(SURGERY_ID, "surgery");
+		Specialty radiology = specialty(RADIOLOGY_ID, "radiology");
+		Vet ortega = veterinarian("Rafael", "Ortega", specialty(SURGERY_ID, "surgery"));
+		Vet douglas = veterinarian("Linda", "Douglas", specialty(SURGERY_ID, "surgery"));
+		List<Specialty> cachedSpecialties = new ArrayList<>(List.of(surgery, radiology));
+		List<Vet> cachedVeterinarians = new ArrayList<>(List.of(ortega, douglas));
+
+		SpecialtyDirectory.of(cachedSpecialties, cachedVeterinarians);
+
+		assertThat(cachedSpecialties).containsExactly(surgery, radiology);
+		assertThat(cachedVeterinarians).containsExactly(ortega, douglas);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRefuseASpecialtyThatCarriesNoStoredIdentity() {
+		Specialty unsaved = new Specialty();
+		unsaved.setName("radiology");
+
+		assertThatIllegalArgumentException()
+			.isThrownBy(() -> SpecialtyDirectory.of(List.of(unsaved), List.of(veterinarian("Helen", "Leary"))))
+			.withMessageContaining("radiology");
+	}
+
+	private static SpecialtyDirectory.Entry entryFor(SpecialtyDirectory directory, Specialty specialty) {
+		return directory.getEntries()
+			.stream()
+			.filter(entry -> entry.getSpecialty().getName().equals(specialty.getName()))
+			.findFirst()
+			.orElseThrow();
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet veterinarian(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
