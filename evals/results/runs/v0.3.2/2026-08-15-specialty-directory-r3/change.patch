+          <span th:each="vet : ${holders.veterinarians}"
+            th:text="${vet.firstName + ' ' + vet.lastName + ' '}" /> <span
+            th:if="${#lists.isEmpty(holders.veterinarians)}" th:text="#{none}">none</span>
