+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import static org.mockito.BDDMockito.given;
+
+/**
+ * Test class for the {@link SpecialtyController}, driving the specialty directory page
+ * through the MVC machinery that serves it.
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_DIRECTORY_ADDRESS = "/specialties.html";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String HELD_BY_NOBODY = "dentistry";
+
+	private static final String HOLDS_NO_SPECIALTY_FIRST_NAME = "James";
+
+	private static final String HOLDS_NO_SPECIALTY_LAST_NAME = "Carter";
+
+	private static final String RADIOLOGY_HOLDER_FIRST_NAME = "Helen";
+
+	private static final String RADIOLOGY_HOLDER_LAST_NAME = "Leary";
+
+	private static final String SURGERY_HOLDER_FIRST_NAME = "Rafael";
+
+	private static final String SURGERY_HOLDER_LAST_NAME = "Ortega";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@MockitoBean
+	private SpecialtyRepository specialties;
+
+	@MockitoBean
+	private VetRepository vets;
+
+	private static int nextId = 1;
+
+	private static Specialty createSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createVetHolding(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	@BeforeEach
+	void clinicKnowsThreeSpecialtiesAndThreeVeterinarians() {
+		Specialty radiology = createSpecialty(RADIOLOGY);
+		Specialty surgery = createSpecialty(SURGERY);
+		Specialty dentistry = createSpecialty(HELD_BY_NOBODY);
+		given(this.specialties.findSpecialties()).willReturn(List.of(dentistry, radiology, surgery));
+		given(this.vets.findAll())
+			.willReturn(List.of(createVetHolding(HOLDS_NO_SPECIALTY_FIRST_NAME, HOLDS_NO_SPECIALTY_LAST_NAME),
+					createVetHolding(RADIOLOGY_HOLDER_FIRST_NAME, RADIOLOGY_HOLDER_LAST_NAME, radiology),
+					createVetHolding(SURGERY_HOLDER_FIRST_NAME, SURGERY_HOLDER_LAST_NAME, surgery)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeServedAtItsOwnAddress() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(model().attributeExists("specialtyDirectory"))
+			.andExpect(view().name("vets/specialtyList"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheStandardNavigationWithoutAnEntryOfItsOwn() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("/owners/find")))
+			.andExpect(content().string(containsString("/vets.html")))
+			.andExpect(content().string(not(containsString(SPECIALTY_DIRECTORY_ADDRESS))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(RADIOLOGY)))
+			.andExpect(content().string(containsString(SURGERY)))
+			.andExpect(content().string(containsString(HELD_BY_NOBODY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHolderByFullName() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(RADIOLOGY_HOLDER_FIRST_NAME + " " + RADIOLOGY_HOLDER_LAST_NAME)))
+			.andExpect(content().string(containsString(SURGERY_HOLDER_FIRST_NAME + " " + SURGERY_HOLDER_LAST_NAME)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString(HOLDS_NO_SPECIALTY_LAST_NAME))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(HELD_BY_NOBODY)))
+			.andExpect(content().string(containsString("none")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEverySpecialtyOnOnePage() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(RADIOLOGY)))
+			.andExpect(content().string(containsString(SURGERY)))
+			.andExpect(content().string(containsString(HELD_BY_NOBODY)))
+			.andExpect(content().string(not(containsString("page="))));
+	}
+
+}
