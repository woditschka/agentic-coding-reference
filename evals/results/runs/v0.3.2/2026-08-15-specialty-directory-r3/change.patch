+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the projection pairing each specialty with
+ * the veterinarians holding it.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static int nextId = 1;
+
+	private static Specialty createSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createVetHolding(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private static Specialty createAnUnsavedSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVetHoldingNoSpecialty() {
+		return createVetHolding("Some", "Veterinarian");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPairEachSpecialtyWithTheVeterinariansHoldingIt() {
+		Specialty radiology = createSpecialty(RADIOLOGY);
+		Specialty surgery = createSpecialty(SURGERY);
+		Vet helen = createVetHolding("Helen", "Leary", radiology);
+		Vet rafael = createVetHolding("Rafael", "Ortega", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen, rafael));
+
+		assertThat(directory.specialties()).satisfiesExactly(
+				holders -> assertThat(holders.specialty().getName()).isEqualTo(RADIOLOGY),
+				holders -> assertThat(holders.specialty().getName()).isEqualTo(SURGERY));
+		assertThat(directory.specialties().get(0).veterinarians()).containsExactly(helen);
+		assertThat(directory.specialties().get(1).veterinarians()).containsExactly(rafael);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHoldsWithNoVeterinarians() {
+		Specialty heldByNobody = createSpecialty(SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(heldByNobody),
+				List.of(createAVetHoldingNoSpecialty()));
+
+		assertThat(directory.specialties()).singleElement()
+			.satisfies(holders -> assertThat(holders.veterinarians()).isEmpty());
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldTreatAnUnsavedSpecialtyAsHeldByNobody() {
+		Specialty neverStored = createAnUnsavedSpecialty(RADIOLOGY);
+		Vet helen = createVetHolding("Helen", "Leary", createSpecialty(RADIOLOGY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(neverStored), List.of(helen));
+
+		assertThat(directory.specialties()).singleElement()
+			.satisfies(holders -> assertThat(holders.veterinarians()).isEmpty());
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldLeaveOutAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createSpecialty(RADIOLOGY);
+		Vet helen = createVetHolding("Helen", "Leary", radiology);
+		Vet holdsNothing = createAVetHoldingNoSpecialty();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, holdsNothing));
+
+		assertThat(directory.specialties()).singleElement()
+			.satisfies(holders -> assertThat(holders.veterinarians()).containsExactly(helen));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastNameThenFirstName() {
+		Specialty radiology = createSpecialty(RADIOLOGY);
+		Vet lindaDouglas = createVetHolding("Linda", "Douglas", radiology);
+		Vet helenLeary = createVetHolding("Helen", "Leary", radiology);
+		Vet adamLeary = createVetHolding("Adam", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(helenLeary, adamLeary, lindaDouglas));
+
+		assertThat(directory.specialties()).singleElement()
+			.satisfies(holders -> assertThat(holders.veterinarians()).containsExactly(lindaDouglas, adamLeary,
+					helenLeary));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepTheSpecialtyOrderItIsGiven() {
+		Specialty first = createSpecialty(SURGERY);
+		Specialty second = createSpecialty(RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(first, second), List.of());
+
+		assertThat(directory.specialties()).extracting(holders -> holders.specialty().getName())
+			.containsExactly(SURGERY, RADIOLOGY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotChangeWhenTheCollectionsItWasBuiltFromChange() {
+		Specialty radiology = createSpecialty(RADIOLOGY);
+		List<Specialty> specialties = new ArrayList<>(List.of(radiology));
+		List<Vet> veterinarians = new ArrayList<>(List.of(createVetHolding("Helen", "Leary", radiology)));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, veterinarians);
+		specialties.add(createSpecialty(SURGERY));
+		veterinarians.clear();
+
+		assertThat(directory.specialties()).singleElement()
+			.satisfies(holders -> assertThat(holders.veterinarians()).hasSize(1));
+	}
+
+}
