+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * The clinic's specialty directory: every {@link Specialty} the clinic knows, each paired
+ * with the {@link Vet}s holding it. A specialty no veterinarian holds is part of the
+ * directory with no veterinarians under it; a veterinarian holding no specialty is part
+ * of no pairing.
+ * <p>
+ * The directory is assembled in memory from a specialty listing and a veterinarian
+ * listing, because {@code Vet} maps the relationship one way only and an unheld specialty
+ * is therefore unreachable from the veterinarian side. See
+ * {@code docs/adr/2026-08-15-specialty-directory-in-memory-projection.md}.
+ *
+ * @param specialties every specialty, in the order it was given, each with its holders
+ */
+public record SpecialtyDirectory(List<SpecialtyHolders> specialties) {
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator
+		.<Vet, String>comparing(Person::getLastName)
+		.thenComparing(Person::getFirstName);
+
+	public SpecialtyDirectory {
+		specialties = List.copyOf(specialties);
+	}
+
+	/**
+	 * Assemble the directory by pairing each specialty with the veterinarians holding it.
+	 * @param specialties every specialty the clinic knows, in the order the page presents
+	 * them
+	 * @param veterinarians the veterinarians to draw the holders from, in any order
+	 * @return the assembled directory, holders ordered by last name then first name
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		List<SpecialtyHolders> pairings = specialties.stream()
+			.map(specialty -> new SpecialtyHolders(specialty, holdersOf(specialty, veterinarians)))
+			.toList();
+		return new SpecialtyDirectory(pairings);
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> veterinarians) {
+		return veterinarians.stream()
+			.filter(veterinarian -> holds(veterinarian, specialty))
+			.sorted(BY_LAST_THEN_FIRST_NAME)
+			.toList();
+	}
+
+	/**
+	 * A specialty is identified by the identity the store assigned it. A specialty with
+	 * no identity yet is held by nobody rather than by everybody, so an unsaved instance
+	 * cannot draw the whole roster under it.
+	 */
+	private static boolean holds(Vet veterinarian, Specialty specialty) {
+		if (specialty.getId() == null) {
+			return false;
+		}
+		return veterinarian.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it.
+	 *
+	 * @param specialty the specialty, presented under its stored name
+	 * @param veterinarians the veterinarians holding it, possibly none
+	 */
+	public record SpecialtyHolders(Specialty specialty, List<Vet> veterinarians) {
+
+		public SpecialtyHolders {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+}
