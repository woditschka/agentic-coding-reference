+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+/**
+ * One line of the specialty directory: a specialty and the veterinarians holding it.
+ * <p>
+ * {@link Vet} maps its specialties one way only, so this inverse view is assembled for
+ * rendering rather than mapped.
+ *
+ * @param specialty the specialty, shown by the name the clinic has stored for it
+ * @param veterinarians the veterinarians holding it, empty when none does
+ */
+public record SpecialtyDirectoryEntry(Specialty specialty, List<Vet> veterinarians) {
+
+	public SpecialtyDirectoryEntry {
+		veterinarians = List.copyOf(veterinarians);
+	}
+
+}
