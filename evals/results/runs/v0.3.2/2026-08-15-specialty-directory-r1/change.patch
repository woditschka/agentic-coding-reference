+	private List<SpecialtyDirectoryEntry> listSpecialtiesWithVeterinarians() {
+		Map<Integer, List<Vet>> vetsBySpecialtyId = new HashMap<>();
+		for (Vet vet : this.vetRepository.findAll()) {
+			for (Specialty specialty : vet.getSpecialties()) {
+				// Keyed on the id and never on the Specialty itself: BaseEntity compares
+				// by identity, and the cached vet read yields instances distinct from
+				// those the specialty read returns.
+				vetsBySpecialtyId.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(vet);
+			}
+		}
+
+		List<SpecialtyDirectoryEntry> entries = new ArrayList<>();
+		for (Specialty specialty : this.specialtyRepository.findSpecialties()) {
+			List<Vet> holders = vetsBySpecialtyId.getOrDefault(specialty.getId(), List.of());
+			entries.add(new SpecialtyDirectoryEntry(specialty, holders.stream().sorted(BY_NAME).toList()));
+		}
+		return entries;
+	}
