+	 * @return a <code>Page</code> of matching <code>Vet</code>s (empty if none match)
+	 * @throws DataAccessException if the read fails
+	 */
+	@Transactional(readOnly = true)
+	Page<Vet> findDistinctBySpecialtiesNameIgnoreCase(String specialtyName, Pageable pageable)
+			throws DataAccessException;
+
+	/**
+	 * Retrieve all <code>Vet</code>s holding the named specialty. Matching and caching
+	 * follow the same two rules as the paged read above.
