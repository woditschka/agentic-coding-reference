+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link Pet}.
+ */
+class PetTests {
+
+	private static final int RECORDED_VISIT_ID = 1;
+
+	private static final int UNKNOWN_VISIT_ID = 99;
+
+	@Test
+	void theRecordedVisitShouldBeFoundByItsId() {
+		Pet pet = new Pet();
+		Visit recordedVisit = createARecordedVisit();
+		pet.addVisit(recordedVisit);
+
+		// Identity, not equality: a correction mutates the instance the lookup returns.
+		assertThat(pet.getVisit(RECORDED_VISIT_ID)).isSameAs(recordedVisit);
+	}
+
+	@Test
+	void noVisitShouldBeFoundForAnIdThePetDoesNotHave() {
+		Pet pet = new Pet();
+		pet.addVisit(createARecordedVisit());
+
+		assertThat(pet.getVisit(UNKNOWN_VISIT_ID)).isNull();
+	}
+
+	@Test
+	void aVisitThatIsNotYetRecordedShouldNotBeFoundByAnyId() {
+		Pet pet = new Pet();
+		// A visit being booked is held on the pet before it is saved, so it has no id
+		// yet and must not answer an id lookup.
+		pet.addVisit(new Visit());
+
+		assertThat(pet.getVisit(RECORDED_VISIT_ID)).isNull();
+	}
+
+	private static Visit createARecordedVisit() {
+		Visit visit = new Visit();
+		visit.setId(RECORDED_VISIT_ID);
+		return visit;
+	}
+
+}
