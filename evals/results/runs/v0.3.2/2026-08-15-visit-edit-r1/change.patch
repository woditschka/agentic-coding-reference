+	 * Visit itself because a persisted visit stays valid as its date passes.
+	 */
+	private void rejectDateNotInTheFuture(Visit visit, BindingResult result) {
+		if (visit.getDate() != null && !visit.getDate().isAfter(LocalDate.now())) {
+			result.rejectValue("date", "typeMismatch.visitDate");
+		}
+	}
+
 }
