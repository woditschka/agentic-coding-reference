+		return Stream.of(arguments(named("no specialty parameter", VetListSurface.DIRECTORY.withoutSpecialty())),
+				arguments(named("empty specialty", VetListSurface.DIRECTORY.withSpecialty(EMPTY))),
+				arguments(named("whitespace-only specialty", VetListSurface.DIRECTORY.withSpecialty(WHITESPACE_ONLY))));
+	}
+
+	private void insertVetsHolding(String specialty, int holderCount) {
+		jdbcTemplate.update("INSERT INTO specialties (name) VALUES (?)", specialty);
+		for (int holder = 0; holder < holderCount; holder++) {
+			jdbcTemplate.update("INSERT INTO vets (first_name, last_name) VALUES (?, ?)", ANY_FIRST_NAME,
+					INSERTED_HOLDER_LAST_NAME);
+		}
+		jdbcTemplate
+			.update("INSERT INTO vet_specialties (vet_id, specialty_id) SELECT v.id, s.id FROM vets v, specialties s"
+					+ " WHERE v.last_name = ? AND s.name = ?", INSERTED_HOLDER_LAST_NAME, specialty);
+	}
+
+	private static List<String> pageLinksOn(MvcResult page) throws UnsupportedEncodingException {
+		return PAGE_LINK.matcher(page.getResponse().getContentAsString())
+			.results()
+			.map(link -> HtmlUtils.htmlUnescape(link.group(1)))
+			.toList();
+	}
+
+	private static List<String> specialtiesIn(String link) {
+		return UriComponentsBuilder.fromUriString(link)
+			.build()
+			.getQueryParams()
+			.getOrDefault("specialty", List.of())
+			.stream()
+			.map(specialty -> UriUtils.decode(specialty, StandardCharsets.UTF_8))
+			.toList();
+	}
+
+	/**
+	 * The two routes publishing the veterinarian list. Each narrowing rule holds on both,
+	 * so the rule tests run once per surface and read the listing back the way that
+	 * surface exposes it.
+	 */
+	enum VetListSurface {
+
+		DIRECTORY("/vets.html", MediaType.TEXT_HTML) {
+			@Override
+			List<String> lastNamesListed(MvcResult result) {
+				return vetsListedOnDirectory(result).stream().map(Vet::getLastName).toList();
+			}
+
+			@Override
+			List<String> specialtyNamesListed(MvcResult result) {
+				return vetsListedOnDirectory(result).stream()
+					.flatMap(vet -> vet.getSpecialties().stream())
+					.map(Specialty::getName)
+					.toList();
+			}
+
+			@SuppressWarnings("unchecked")
+			private static List<Vet> vetsListedOnDirectory(MvcResult result) {
+				return (List<Vet>) result.getModelAndView().getModel().get("listVets");
+			}
+		},
+
+		RESOURCE_LIST("/vets", MediaType.APPLICATION_JSON) {
+			@Override
+			List<String> lastNamesListed(MvcResult result) throws UnsupportedEncodingException {
+				return JsonPath.read(result.getResponse().getContentAsString(), "$.vetList[*].lastName");
+			}
+
+			@Override
+			List<String> specialtyNamesListed(MvcResult result) throws UnsupportedEncodingException {
+				return JsonPath.read(result.getResponse().getContentAsString(), "$.vetList[*].specialties[*].name");
+			}
+		};
+
+		private final String path;
+
+		private final MediaType mediaType;
+
+		VetListSurface(String path, MediaType mediaType) {
+			this.path = path;
+			this.mediaType = mediaType;
+		}
+
+		RequestBuilder withSpecialty(String specialty) {
+			return get(this.path).param("specialty", specialty).accept(this.mediaType);
+		}
+
+		RequestBuilder withoutSpecialty() {
+			return get(this.path).accept(this.mediaType);
+		}
+
+		abstract List<String> lastNamesListed(MvcResult result) throws UnsupportedEncodingException;
+
+		abstract List<String> specialtyNamesListed(MvcResult result) throws UnsupportedEncodingException;
+
 	}
 
