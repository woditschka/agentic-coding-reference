+ * limitations under the License.
+ */
+
+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.assertj.core.api.InstanceOfAssertFactories.type;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.redirectedUrlTemplate;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+import org.springframework.web.servlet.ModelAndView;
+
+/**
+ * Visit correction against the real {@link OwnerRepository} on the embedded database.
+ * <p>
+ * No test-managed transaction wraps a request: every stored-state assertion re-reads the
+ * owner, so it observes the store rather than the instance the request bound.
+ * </p>
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+class VisitControllerIntegrationTests {
+
+	private static final String CORRECTION_URL = "/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit";
+
+	private static final String VISIT_FORM = "pets/createOrUpdateVisitForm";
+
+	private static final String OWNER_RECORD_URL = "/owners/{ownerId}";
+
+	private static final String VISIT_ATTRIBUTE = "visit";
+
+	private static final String DATE_FIELD = "date";
+
+	private static final String DESCRIPTION_FIELD = "description";
+
+	private static final LocalDate BOOKED_DATE = LocalDate.now().plusDays(7);
+
+	private static final String BOOKED_DESCRIPTION = "rabies shot";
+
+	private static final LocalDate CORRECTED_DATE = BOOKED_DATE.plusDays(7);
+
+	private static final String CORRECTED_DESCRIPTION = "neutered";
+
+	private static final LocalDate TODAY = LocalDate.now();
+
+	private static final LocalDate A_PAST_DATE = TODAY.minusDays(1);
+
+	private static final String BLANK_DESCRIPTION = "";
+
+	private static final int NO_SUCH_VISIT_ID = Integer.MAX_VALUE;
+
+	private static final String ANY_FIRST_NAME = "Any";
+
+	private static final String ANY_LAST_NAME = "Owner";
+
+	private static final String ANY_ADDRESS = "1 Any Street";
+
+	private static final String ANY_CITY = "Anytown";
+
+	private static final String ANY_TELEPHONE = "0123456789";
+
+	private static final String ANY_PET_NAME = "Any Pet";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private OwnerRepository owners;
+
+	@Autowired
+	private PetTypeRepository petTypes;
+
+	private final List<Integer> arrangedOwnerIds = new ArrayList<>();
+
+	@AfterEach
+	void removeArrangedOwners() {
+		this.arrangedOwnerIds.forEach(this.owners::deleteById);
+	}
+
+	@Test
+	void theVisitCorrectionFormShouldShowTheVisitsCurrentDateAndDescription() throws Exception {
+		VisitPath booked = bookAVisit();
+
+		ModelAndView shown = mockMvc.perform(get(CORRECTION_URL, booked.ownerId(), booked.petId(), booked.visitId()))
+			.andExpect(status().isOk())
+			.andExpect(view().name(VISIT_FORM))
+			.andReturn()
+			.getModelAndView();
+
+		assertThat(shown.getModel().get(VISIT_ATTRIBUTE)).asInstanceOf(type(Visit.class))
+			.extracting(Visit::getId, Visit::getDate, Visit::getDescription)
+			.containsExactly(booked.visitId(), BOOKED_DATE, BOOKED_DESCRIPTION);
+	}
+
+	@Test
+	void theVisitCorrectionShouldUpdateTheVisitAndShowTheOwnerRecord() throws Exception {
+		VisitPath booked = bookAVisit();
+
+		submitCorrection(booked, CORRECTED_DATE, CORRECTED_DESCRIPTION).andExpect(status().is3xxRedirection())
+			.andExpect(redirectedUrlTemplate(OWNER_RECORD_URL, booked.ownerId()));
+
+		assertStoredVisitReads(booked, CORRECTED_DATE, CORRECTED_DESCRIPTION);
+	}
+
+	@Test
+	void theVisitCorrectionShouldNotAddAVisitToThePet() throws Exception {
+		VisitPath booked = bookAVisit();
+
+		submitCorrection(booked, CORRECTED_DATE, CORRECTED_DESCRIPTION);
+
+		assertThat(storedPet(booked).getVisits()).extracting(Visit::getId).containsExactly(booked.visitId());
+	}
+
+	@ParameterizedTest(name = "{0}")
+	@MethodSource("rejectedCorrections")
+	void theVisitCorrectionShouldRedisplayTheFormAndKeepTheStoredVisitWhenValidationFails(String scenario,
+			LocalDate date, String description, String rejectedField) throws Exception {
+		VisitPath booked = bookAVisit();
+
+		submitCorrection(booked, date, description).andExpect(status().isOk())
+			.andExpect(view().name(VISIT_FORM))
+			.andExpect(model().attributeHasFieldErrors(VISIT_ATTRIBUTE, rejectedField));
+
+		assertStoredVisitReads(booked, BOOKED_DATE, BOOKED_DESCRIPTION);
+	}
+
+	static Stream<Arguments> rejectedCorrections() {
+		return Stream.of(Arguments.of("a blank description", CORRECTED_DATE, BLANK_DESCRIPTION, DESCRIPTION_FIELD),
+				Arguments.of("today", TODAY, CORRECTED_DESCRIPTION, DATE_FIELD),
+				Arguments.of("a past date", A_PAST_DATE, CORRECTED_DESCRIPTION, DATE_FIELD));
+	}
+
+	@Test
+	void theVisitCorrectionShouldBeRefusedForAVisitNotBelongingToTheNamedPetAndOwner() {
+		VisitPath named = bookAVisit();
+		VisitPath elsewhere = bookAVisit();
+
+		assertThatThrownBy(
+				() -> submitCorrection(named.withVisitId(elsewhere.visitId()), CORRECTED_DATE, CORRECTED_DESCRIPTION))
+			.hasRootCauseInstanceOf(IllegalArgumentException.class);
+
+		assertStoredVisitReads(elsewhere, BOOKED_DATE, BOOKED_DESCRIPTION);
+	}
+
+	@Test
+	void theVisitCorrectionShouldBeRefusedForAVisitThatDoesNotExist() {
+		VisitPath booked = bookAVisit();
+
+		assertThatThrownBy(
+				() -> submitCorrection(booked.withVisitId(NO_SUCH_VISIT_ID), CORRECTED_DATE, CORRECTED_DESCRIPTION))
+			.hasRootCauseInstanceOf(IllegalArgumentException.class);
+
+		assertThat(storedPet(booked).getVisits()).extracting(Visit::getId).containsExactly(booked.visitId());
+	}
+
+	private ResultActions submitCorrection(VisitPath path, LocalDate date, String description) throws Exception {
+		return mockMvc.perform(
+				post(CORRECTION_URL, path.ownerId(), path.petId(), path.visitId()).param(DATE_FIELD, date.toString())
+					.param(DESCRIPTION_FIELD, description));
+	}
+
+	private Pet storedPet(VisitPath path) {
+		return this.owners.findById(path.ownerId()).orElseThrow().getPet(path.petId());
+	}
+
+	private void assertStoredVisitReads(VisitPath path, LocalDate date, String description) {
+		assertThat(storedPet(path).getVisit(path.visitId())).extracting(Visit::getDate, Visit::getDescription)
+			.containsExactly(date, description);
+	}
+
+	private VisitPath bookAVisit() {
+		Visit visit = createABookedVisit();
+		Pet pet = createAPet();
+		pet.addVisit(visit);
+		Owner owner = createAnOwner();
+		owner.addPet(pet);
+
+		Owner saved = this.owners.save(owner);
+		this.arrangedOwnerIds.add(saved.getId());
+		return new VisitPath(saved.getId(), pet.getId(), visit.getId());
+	}
+
+	private static Visit createABookedVisit() {
+		Visit visit = new Visit();
+		visit.setDate(BOOKED_DATE);
+		visit.setDescription(BOOKED_DESCRIPTION);
+		return visit;
+	}
+
+	private Pet createAPet() {
+		Pet pet = new Pet();
+		pet.setName(ANY_PET_NAME);
+		pet.setType(this.petTypes.findPetTypes().stream().findFirst().orElseThrow());
+		return pet;
+	}
+
+	private static Owner createAnOwner() {
+		Owner owner = new Owner();
+		owner.setFirstName(ANY_FIRST_NAME);
+		owner.setLastName(ANY_LAST_NAME);
+		owner.setAddress(ANY_ADDRESS);
+		owner.setCity(ANY_CITY);
+		owner.setTelephone(ANY_TELEPHONE);
+		return owner;
+	}
+
+	/**
+	 * The identifiers a correction URL names: an owner, one of the owner's pets, and a
+	 * visit.
+	 */
+	private record VisitPath(int ownerId, int petId, int visitId) {
+
+		VisitPath withVisitId(int otherVisitId) {
+			return new VisitPath(this.ownerId, this.petId, otherVisitId);
+		}
+
+	}
+
+}
