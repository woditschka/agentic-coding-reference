+
+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.springframework.validation.BeanPropertyBindingResult;
+import org.springframework.validation.Errors;
+import org.springframework.validation.FieldError;
+
+class VisitValidatorTests {
+
+	private static final LocalDate TODAY = LocalDate.of(2026, 9, 11);
+
+	private static final LocalDate A_DATE_AFTER_TODAY = TODAY.plusDays(1);
+
+	private static final String DATE_FIELD = "date";
+
+	private static final String ANY_OBJECT_NAME = "visit";
+
+	private static final String NON_FUTURE_VISIT_DATE_CODE = "typeMismatch.visitDate";
+
+	private static final String ANY_DESCRIPTION = "any description";
+
+	private final VisitValidator validator = new VisitValidator(TODAY);
+
+	@Test
+	void theVisitValidatorShouldAcceptAVisitDatedAfterToday() {
+		Visit visit = createAVisitOn(A_DATE_AFTER_TODAY);
+
+		Errors errors = validate(visit);
+
+		assertThat(errors.hasErrors()).isFalse();
+	}
+
+	@ParameterizedTest(name = "{0}")
+	@CsvSource({ "today, 0", "a past date, 1" })
+	void theVisitValidatorShouldRejectTheDateOfAVisitDatedTodayOrEarlier(String scenario, long daysBeforeToday) {
+		Visit visit = createAVisitOn(TODAY.minusDays(daysBeforeToday));
+
+		Errors errors = validate(visit);
+
+		assertThat(errors.getFieldError(DATE_FIELD)).extracting(FieldError::getCode)
+			.isEqualTo(NON_FUTURE_VISIT_DATE_CODE);
+	}
+
+	@Test
+	void theVisitValidatorShouldLeaveAVisitWithoutADateToTheOtherFormRules() {
+		Visit visit = createAVisitOn(null);
+
+		Errors errors = validate(visit);
+
+		assertThat(errors.hasErrors()).isFalse();
+	}
+
+	@Test
+	void theVisitValidatorShouldSupportVisitsOnly() {
+		assertThat(validator.supports(Visit.class)).isTrue();
+		assertThat(validator.supports(Pet.class)).isFalse();
+	}
+
+	private Errors validate(Visit visit) {
+		Errors errors = new BeanPropertyBindingResult(visit, ANY_OBJECT_NAME);
+		validator.validate(visit, errors);
+		return errors;
+	}
+
+	private static Visit createAVisitOn(LocalDate date) {
+		Visit visit = new Visit();
+		visit.setDate(date);
+		visit.setDescription(ANY_DESCRIPTION);
+		return visit;
+	}
+
+}
