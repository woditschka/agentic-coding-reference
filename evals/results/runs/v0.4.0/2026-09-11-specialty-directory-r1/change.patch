+		public List<Specialty> findAll() {
+			return specialties;
+		}
+
+	}
+
+	static class InMemoryVetRepository implements VetRepository {
+
+		private List<Vet> vets = List.of();
+
+		void replaceWith(Vet... vets) {
+			this.vets = List.of(vets);
+		}
+
+		@Override
+		public Collection<Vet> findAll() {
+			return vets;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("the specialty directory reads every vet unpaged");
+		}
+
+	}
+
+}
