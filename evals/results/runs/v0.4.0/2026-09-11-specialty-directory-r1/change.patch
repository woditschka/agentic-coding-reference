+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Every specialty the clinic records, each with the veterinarians holding it. A
+ * veterinarian holding no specialty is absent; a specialty held by no veterinarian is
+ * present with no holders.
+ * <p>
+ * The order is fixed here rather than taken from storage, because neither repository
+ * orders its read and specialty names are not unique: specialties by name, then identity;
+ * holders by last name, first name, then identity.
+ */
+record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Matches a held specialty to a listed one by identity: the vets and the specialties
+	 * are read separately, so the instances differ and carry no value equality.
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<Holder>> holdersBySpecialtyId = new HashMap<>();
+		vets.stream().sorted(HOLDER_ORDER).forEach(vet -> {
+			for (Specialty held : vet.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(held.getId(), id -> new ArrayList<>())
+					.add(new Holder(vet.getFirstName(), vet.getLastName()));
+			}
+		});
+		List<Entry> entries = specialties.stream()
+			.sorted(SPECIALTY_ORDER)
+			.map(specialty -> new Entry(specialty.getName(),
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	record Entry(String specialtyName, List<Holder> holders) {
+
+		Entry {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+	record Holder(String firstName, String lastName) {
+
+	}
+
+}
