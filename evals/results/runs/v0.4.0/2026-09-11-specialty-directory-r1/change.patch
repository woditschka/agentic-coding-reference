+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Entry;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Holder;
+
+class SpecialtyDirectoryTests {
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SHARED_SPECIALTY_NAME = "surgery";
+
+	private static final String LINDA = "Linda";
+
+	private static final String DOUGLAS = "Douglas";
+
+	private static final String HELEN = "Helen";
+
+	private static final String LEARY = "Leary";
+
+	private static final String JAMES = "James";
+
+	private static final String CARTER = "Carter";
+
+	private static final String RAFAEL = "Rafael";
+
+	private static final String SHARED_LAST_NAME = "Ortega";
+
+	private static final String SOME_FIRST_NAME = "Some";
+
+	private static final String SOME_LAST_NAME = "Radiologist";
+
+	private static final AtomicInteger NEXT_ID = new AtomicInteger();
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVetUnderEverySpecialtyTheyHold() {
+		Specialty surgery = aSpecialty(SURGERY);
+		Specialty dentistry = aSpecialty(DENTISTRY);
+		Vet linda = aVet(LINDA, DOUGLAS, surgery, dentistry);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry), List.of(linda));
+
+		assertThat(directory.entries()).containsExactlyInAnyOrder(entry(SURGERY, holder(LINDA, DOUGLAS)),
+				entry(DENTISTRY, holder(LINDA, DOUGLAS)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVetsHoldingNoSpecialty() {
+		Specialty radiology = aSpecialty(RADIOLOGY);
+		Vet helen = aVet(HELEN, LEARY, radiology);
+		Vet james = aVet(JAMES, CARTER);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, james));
+
+		assertThat(directory.entries()).containsExactly(entry(RADIOLOGY, holder(HELEN, LEARY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVet() {
+		Specialty radiology = aSpecialty(RADIOLOGY);
+		Specialty surgery = aSpecialty(SURGERY);
+		Vet radiologist = aVet(SOME_FIRST_NAME, SOME_LAST_NAME, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(radiologist));
+
+		assertThat(directory.entries()).contains(entry(SURGERY));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListSpecialtiesAndHoldersInAStableOrder() {
+		Specialty firstOfSharedName = aSpecialty(SHARED_SPECIALTY_NAME);
+		Specialty secondOfSharedName = aSpecialty(SHARED_SPECIALTY_NAME);
+		Specialty dentistry = aSpecialty(DENTISTRY);
+		Vet helen = aVet(HELEN, LEARY, firstOfSharedName, dentistry);
+		Vet lindaWithSharedLastName = aVet(LINDA, SHARED_LAST_NAME, secondOfSharedName, dentistry);
+		Vet rafaelWithSharedLastName = aVet(RAFAEL, SHARED_LAST_NAME, dentistry);
+		List<Specialty> specialties = List.of(firstOfSharedName, secondOfSharedName, dentistry);
+		List<Vet> vets = List.of(helen, lindaWithSharedLastName, rafaelWithSharedLastName);
+
+		SpecialtyDirectory opened = SpecialtyDirectory.of(specialties, vets);
+		SpecialtyDirectory reopened = SpecialtyDirectory.of(inReverse(specialties), inReverse(vets));
+
+		assertThat(reopened).isEqualTo(opened);
+	}
+
+	private static <T> List<T> inReverse(List<T> items) {
+		List<T> reversed = new ArrayList<>(items);
+		Collections.reverse(reversed);
+		return reversed;
+	}
+
+	private static Specialty aSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(NEXT_ID.incrementAndGet());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet aVet(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(NEXT_ID.incrementAndGet());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		// Vets come from the cached vet read, so the specialties they hold are never the
+		// instances the specialty repository returns; only the identity is shared.
+		for (Specialty specialty : held) {
+			vet.addSpecialty(aCopyOf(specialty));
+		}
+		return vet;
+	}
+
+	private static Specialty aCopyOf(Specialty specialty) {
+		Specialty copy = new Specialty();
+		copy.setId(specialty.getId());
+		copy.setName(specialty.getName());
+		return copy;
+	}
+
+	private static Entry entry(String specialtyName, Holder... holders) {
+		return new Entry(specialtyName, List.of(holders));
+	}
+
+	private static Holder holder(String firstName, String lastName) {
+		return new Holder(firstName, lastName);
+	}
+
+}
