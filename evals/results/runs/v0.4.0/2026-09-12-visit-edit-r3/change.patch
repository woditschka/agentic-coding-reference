+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 7;
+
+	private static final int ANOTHER_PETS_VISIT_ID = 8;
+
+	@Test
+	void thePetVisitLookupShouldReturnThePetsVisitWithTheGivenId() {
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWith(bookedVisit);
+
+		Visit found = pet.getVisit(BOOKED_VISIT_ID);
+
+		assertThat(found).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetVisitLookupShouldFindNoVisitThePetDoesNotOwn() {
+		Pet pet = createAPetWith(createABookedVisit(BOOKED_VISIT_ID));
+
+		Visit found = pet.getVisit(ANOTHER_PETS_VISIT_ID);
+
+		assertThat(found).isNull();
+	}
+
+	@Test
+	void thePetVisitLookupShouldNotFindAVisitThatIsNotYetBooked() {
+		Visit unsavedVisit = createAnUnsavedVisit();
+		Pet pet = createAPetWith(unsavedVisit);
+
+		Visit found = pet.getVisit(unsavedVisit.getId());
+
+		assertThat(found).isNull();
+	}
+
+	private static Visit createABookedVisit(int id) {
+		Visit visit = createAnUnsavedVisit();
+		visit.setId(id);
+		return visit;
+	}
+
+	private static Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+	private static Pet createAPetWith(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+}
