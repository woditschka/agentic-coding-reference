+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+
+import org.springframework.data.repository.Repository;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Repository for {@link Specialty} lookup values, including specialties no veterinarian
+ * holds, which cannot be reached through {@link VetRepository}. Unordered and uncached:
+ * {@link SpecialtyListing} owns the listing order.
+ */
+interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	@Transactional(readOnly = true)
+	Collection<Specialty> findAll();
+
+}
