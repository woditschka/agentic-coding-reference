+package org.springframework.samples.petclinic.vet;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class SpecialtyListingTests {
+
+	private static final AtomicInteger UNIQUE = new AtomicInteger();
+
+	@Test
+	void theSpecialtyListingShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty dentistry = aSpecialty();
+		Specialty surgery = aSpecialty();
+		Vet holdingBoth = aVetHolding(dentistry, surgery);
+		Vet holdingNone = aVetHolding();
+
+		SpecialtyListing listing = SpecialtyListing.of(List.of(dentistry, surgery), List.of(holdingBoth, holdingNone));
+
+		assertThat(listing.getSpecialties()).containsExactlyInAnyOrder(listed(dentistry, holdingBoth),
+				listed(surgery, holdingBoth));
+	}
+
+	@Test
+	void theSpecialtyListingShouldOrderSpecialtiesAndVeterinariansAlphabetically() {
+		Specialty firstByName = aSpecialtyNamed("dentistry");
+		Specialty secondByName = aSpecialtyNamed("radiology");
+		Specialty lastByName = aSpecialtyNamed("surgery");
+		Vet firstHolder = aVetNamed("Adam", "Douglas", lastByName);
+		Vet secondHolder = aVetNamed("Linda", "Douglas", lastByName);
+		Vet lastHolderDespiteEarlierFirstName = aVetNamed("Helen", "Leary", lastByName);
+
+		SpecialtyListing listing = SpecialtyListing.of(List.of(lastByName, firstByName, secondByName),
+				List.of(lastHolderDespiteEarlierFirstName, secondHolder, firstHolder));
+
+		assertThat(listing.getSpecialties()).containsExactly(listed(firstByName), listed(secondByName),
+				listed(lastByName, firstHolder, secondHolder, lastHolderDespiteEarlierFirstName));
+	}
+
+	@Test
+	void theSpecialtyListingShouldKeepAnUnheldSpecialtyWithNoVeterinarians() {
+		Specialty unheld = aSpecialty();
+
+		SpecialtyListing listing = SpecialtyListing.of(List.of(unheld), List.of(aVetHolding()));
+
+		assertThat(listing.getSpecialties()).containsExactly(listed(unheld));
+	}
+
+	@Test
+	void theSpecialtyListingShouldMatchAHeldSpecialtyByIdentifierRatherThanInstance() {
+		Specialty radiology = aSpecialty();
+		Vet holder = aVetHolding(aSeparateInstanceOf(radiology));
+
+		SpecialtyListing listing = SpecialtyListing.of(List.of(radiology), List.of(holder));
+
+		assertThat(listing.getSpecialties()).containsExactly(listed(radiology, holder));
+	}
+
+	@Test
+	void theSpecialtyListingShouldEqualAListingOfTheSameSpecialtiesAndHolders() {
+		Specialty specialty = aSpecialty();
+		Vet holder = aVetHolding(specialty);
+
+		SpecialtyListing listing = SpecialtyListing.of(List.of(specialty), List.of(holder));
+		SpecialtyListing sameListing = SpecialtyListing.of(List.of(specialty), List.of(holder));
+
+		assertThat(listing).isEqualTo(sameListing).hasSameHashCodeAs(sameListing);
+	}
+
+	@Test
+	void theSpecialtyListingShouldDifferFromAListingWhereTheSpecialtyHasDifferentHolders() {
+		Specialty specialty = aSpecialty();
+		Vet holder = aVetHolding(specialty);
+
+		SpecialtyListing listing = SpecialtyListing.of(List.of(specialty), List.of(holder));
+		SpecialtyListing listingWithoutTheHolder = SpecialtyListing.of(List.of(specialty), List.of());
+
+		assertThat(listing).isNotEqualTo(listingWithoutTheHolder);
+	}
+
+	private static Specialty aSpecialty() {
+		return aSpecialtyNamed("any specialty " + UNIQUE.incrementAndGet());
+	}
+
+	private static Specialty aSpecialtyNamed(String name) {
+		return specialty(UNIQUE.incrementAndGet(), name);
+	}
+
+	// The listing's specialties and a vet's specialties come from separate loads, so the
+	// same stored specialty reaches the listing as two distinct objects.
+	private static Specialty aSeparateInstanceOf(Specialty specialty) {
+		return specialty(specialty.getId(), specialty.getName());
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet aVetHolding(Specialty... held) {
+		int unique = UNIQUE.incrementAndGet();
+		return aVetNamed("any first name " + unique, "any last name " + unique, held);
+	}
+
+	private static Vet aVetNamed(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		Arrays.stream(held).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static SpecialtyListing.ListedSpecialty listed(Specialty specialty, Vet... holders) {
+		return new SpecialtyListing.ListedSpecialty(specialty, List.of(holders));
+	}
+
+}
