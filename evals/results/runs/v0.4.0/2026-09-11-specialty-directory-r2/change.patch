+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Every specialty the clinic knows, each with the veterinarians holding it. Specialties
+ * are in name order and the veterinarians under each in last-name-then-first-name order.
+ * A specialty nobody holds is kept with no veterinarians, and a veterinarian holding
+ * several specialties is listed under each of them.
+ * <p>
+ * Public because {@code PetClinicRuntimeHints} registers it for the native image: only
+ * the specialty listing template reads it, reflectively.
+ */
+public final class SpecialtyListing {
+
+	private static final Comparator<Specialty> BY_NAME = Comparator.comparing(Specialty::getName);
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	private final List<ListedSpecialty> specialties;
+
+	private SpecialtyListing(List<ListedSpecialty> specialties) {
+		this.specialties = specialties;
+	}
+
+	public static SpecialtyListing of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		List<ListedSpecialty> listed = specialties.stream()
+			.sorted(BY_NAME)
+			.map(specialty -> new ListedSpecialty(specialty, holdersOf(specialty, vets)))
+			.toList();
+		return new SpecialtyListing(listed);
+	}
+
+	public List<ListedSpecialty> getSpecialties() {
+		return this.specialties;
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream().filter(vet -> holds(vet, specialty)).sorted(BY_LAST_THEN_FIRST_NAME).toList();
+	}
+
+	// By identifier, never by instance: the specialties and the veterinarians are loaded
+	// separately, so one stored specialty arrives as two objects, and entities do not
+	// define equality.
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+	@Override
+	public boolean equals(Object other) {
+		return other instanceof SpecialtyListing listing && this.specialties.equals(listing.specialties);
+	}
+
+	@Override
+	public int hashCode() {
+		return this.specialties.hashCode();
+	}
+
+	/**
+	 * One specialty with the veterinarians holding it, in listing order.
+	 */
+	public record ListedSpecialty(Specialty specialty, List<Vet> vets) {
+
+		public ListedSpecialty {
+			vets = List.copyOf(vets);
+		}
+
+	}
+
+}
