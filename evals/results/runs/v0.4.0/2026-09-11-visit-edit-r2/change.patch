+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int HELD_VISIT_ID = 3;
+
+	private static final int UNHELD_VISIT_ID = 4;
+
+	private static final Integer NO_VISIT_ID = null;
+
+	@Test
+	void thePetShouldResolveAVisitItHoldsByItsIdentity() {
+		Visit heldVisit = createAPersistedVisit(HELD_VISIT_ID);
+		Pet pet = createAPetHolding(heldVisit);
+
+		Visit resolved = pet.getVisit(HELD_VISIT_ID);
+
+		assertThat(resolved).isSameAs(heldVisit);
+	}
+
+	@Test
+	void thePetShouldResolveNothingForAVisitItDoesNotHold() {
+		Pet pet = createAPetHolding(createAPersistedVisit(HELD_VISIT_ID));
+
+		Visit resolved = pet.getVisit(UNHELD_VISIT_ID);
+
+		assertThat(resolved).isNull();
+	}
+
+	@Test
+	void thePetShouldNotResolveAnUnsavedVisit() {
+		Pet pet = createAPetHolding(createAnUnsavedVisit());
+
+		Visit resolved = pet.getVisit(NO_VISIT_ID);
+
+		assertThat(resolved).isNull();
+	}
+
+	private static Pet createAPetHolding(Visit visit) {
+		Pet pet = new Pet();
+		pet.addVisit(visit);
+		return pet;
+	}
+
+	private static Visit createAPersistedVisit(int visitId) {
+		Visit visit = createAnUnsavedVisit();
+		visit.setId(visitId);
+		return visit;
+	}
+
+	private static Visit createAnUnsavedVisit() {
+		return new Visit();
+	}
+
+}
