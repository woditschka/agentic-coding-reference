+
+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Unit tests for the grouping, matching and ordering rules of {@link SpecialtyDirectory}.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final AtomicInteger NEXT_ANONYMOUS_ID = new AtomicInteger();
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String HELEN = "Helen";
+
+	private static final String ANNA = "Anna";
+
+	private static final String LEARY = "Leary";
+
+	private static final String LINDA = "Linda";
+
+	private static final String DOUGLAS = "Douglas";
+
+	private static final String JAMES = "James";
+
+	private static final String CARTER = "Carter";
+
+	private static final String HELEN_LEARY = HELEN + " " + LEARY;
+
+	private static final String ANNA_LEARY = ANNA + " " + LEARY;
+
+	private static final String LINDA_DOUGLAS = LINDA + " " + DOUGLAS;
+
+	private static final int SHARED_SPECIALTY_ID = 1;
+
+	private static final int LOWER_SPECIALTY_ID = 2;
+
+	private static final int HIGHER_SPECIALTY_ID = 3;
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEverySpecialtyTheyHold() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+		Vet helen = createAVet(HELEN, LEARY, radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helen));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(RADIOLOGY, HELEN_LEARY), entry(SURGERY, HELEN_LEARY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldLeaveOutAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVet(HELEN, LEARY, radiology);
+		Vet james = createAVet(JAMES, CARTER);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, james));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(RADIOLOGY, HELEN_LEARY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepASpecialtyNoVeterinarianHoldsWithNobodyUnderIt() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+		Vet helen = createAVet(HELEN, LEARY, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, dentistry), List.of(helen));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(DENTISTRY), entry(RADIOLOGY, HELEN_LEARY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenTheClinicKnowsNoSpecialty() {
+		Vet james = createAVet(JAMES, CARTER);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(james));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchAHeldSpecialtyToTheListedOneByIdentityNotByInstance() {
+		Specialty listedRadiology = createASpecialty(SHARED_SPECIALTY_ID, RADIOLOGY);
+		Specialty separatelyLoadedRadiology = createASpecialty(SHARED_SPECIALTY_ID, RADIOLOGY);
+		Vet helen = createAVet(HELEN, LEARY, separatelyLoadedRadiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(listedRadiology), List.of(helen));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(RADIOLOGY, HELEN_LEARY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByName() {
+		Specialty surgery = createASpecialty(SURGERY);
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty dentistry = createASpecialty(DENTISTRY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, radiology, dentistry), List.of());
+
+		assertThat(directory).isEqualTo(directoryOf(entry(DENTISTRY), entry(RADIOLOGY), entry(SURGERY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesSharingANameByIdentity() {
+		Specialty higherIdRadiology = createASpecialty(HIGHER_SPECIALTY_ID, RADIOLOGY);
+		Specialty lowerIdRadiology = createASpecialty(LOWER_SPECIALTY_ID, RADIOLOGY);
+		Vet helen = createAVet(HELEN, LEARY, higherIdRadiology);
+		Vet linda = createAVet(LINDA, DOUGLAS, lowerIdRadiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(higherIdRadiology, lowerIdRadiology),
+				List.of(helen, linda));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(RADIOLOGY, LINDA_DOUGLAS), entry(RADIOLOGY, HELEN_LEARY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastNameThenFirstName() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Vet helen = createAVet(HELEN, LEARY, radiology);
+		Vet linda = createAVet(LINDA, DOUGLAS, radiology);
+		Vet anna = createAVet(ANNA, LEARY, radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, linda, anna));
+
+		assertThat(directory).isEqualTo(directoryOf(entry(RADIOLOGY, LINDA_DOUGLAS, ANNA_LEARY, HELEN_LEARY)));
+	}
+
+	private static Specialty createASpecialty(String name) {
+		return createASpecialty(NEXT_ANONYMOUS_ID.incrementAndGet(), name);
+	}
+
+	private static Specialty createASpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVet(String firstName, String lastName, Specialty... heldSpecialties) {
+		Vet vet = new Vet();
+		vet.setId(NEXT_ANONYMOUS_ID.incrementAndGet());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(heldSpecialties).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static SpecialtyDirectory.Entry entry(String specialtyName, String... veterinarianNames) {
+		return new SpecialtyDirectory.Entry(specialtyName, List.of(veterinarianNames));
+	}
+
+	private static SpecialtyDirectory directoryOf(SpecialtyDirectory.Entry... entries) {
+		return new SpecialtyDirectory(List.of(entries));
+	}
+
+}
