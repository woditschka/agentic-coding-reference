+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * Every specialty the clinic knows, each with the full names of the veterinarians holding
+ * it. A specialty no veterinarian holds is still listed; a veterinarian holding no
+ * specialty appears nowhere.
+ *
+ * <p>
+ * Specialties are ordered by name and veterinarians by last name, then first name, so the
+ * page reads the same on every request. Entries hold strings rather than entities so the
+ * directory stays immutable once built.
+ *
+ * @param entries one entry per specialty, in directory order
+ */
+record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> VETERINARIAN_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Builds the directory from every specialty the clinic knows and every veterinarian.
+	 * @param specialties every specialty, including those no veterinarian holds
+	 * @param veterinarians every veterinarian, whether or not they hold a specialty
+	 * @return the directory in its stable order
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		return new SpecialtyDirectory(specialties.stream()
+			.sorted(SPECIALTY_ORDER)
+			.map(specialty -> entryFor(specialty, veterinarians))
+			.toList());
+	}
+
+	private static Entry entryFor(Specialty specialty, Collection<Vet> veterinarians) {
+		List<String> veterinarianNames = veterinarians.stream()
+			.filter(veterinarian -> holds(veterinarian, specialty))
+			.sorted(VETERINARIAN_ORDER)
+			.map(veterinarian -> veterinarian.getFirstName() + " " + veterinarian.getLastName())
+			.toList();
+		return new Entry(specialty.getName(), veterinarianNames);
+	}
+
+	// Matched by id: the cached veterinarians and the listed specialties are loaded
+	// separately, and the entities do not define equality.
+	private static boolean holds(Vet veterinarian, Specialty specialty) {
+		return veterinarian.getSpecialties().stream().anyMatch(held -> specialty.getId().equals(held.getId()));
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it.
+	 *
+	 * @param specialtyName the specialty's stored name
+	 * @param veterinarianNames each holder's full name, first name then last name, in
+	 * directory order; empty when no veterinarian holds the specialty
+	 */
+	record Entry(String specialtyName, List<String> veterinarianNames) {
+
+		Entry {
+			veterinarianNames = List.copyOf(veterinarianNames);
+		}
+
+	}
+
+}
