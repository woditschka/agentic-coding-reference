+package org.springframework.samples.petclinic.vet;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.cache.annotation.Cacheable;
+
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Tests for the declared shape of {@link VetRepository}. The repository has no behavior
+ * of its own to exercise here: its queries are derived by Spring Data and are covered
+ * against a real database by {@code ClinicServiceTests}.
+ */
+class VetRepositoryTests {
+
+	/**
+	 * A read narrowed by a caller-supplied specialty must never carry
+	 * {@code @Cacheable("vets")}. The specialty arrives as an unauthenticated query
+	 * parameter, so the caller chooses the cache key, and the {@code vets} cache is
+	 * configured with neither an eviction policy nor an entry limit: caching a narrowed
+	 * read would let anyone grow that cache without bound. See
+	 * {@code docs/adr/2026-08-31-narrowed-vet-reads-bypass-the-vets-cache.md}.
+	 * <p>
+	 * The check is structural rather than a list of the two overloads that exist today,
+	 * so a narrowed read added later is defended without anyone remembering to extend
+	 * this test. A read that takes the caller's specialty text is a narrowed read; the
+	 * unnarrowed reads take no argument or a {@code Pageable} alone, and stay cacheable.
+	 */
+	@Test
+	void aReadNarrowedByACallerSuppliedSpecialtyShouldNotBeCacheable() {
+		List<Method> narrowedReads = Arrays.stream(VetRepository.class.getMethods())
+			.filter(method -> Arrays.asList(method.getParameterTypes()).contains(String.class))
+			.toList();
+
+		assertThat(narrowedReads).as("reads on VetRepository taking a caller-supplied specialty").isNotEmpty();
+		assertThat(narrowedReads).allSatisfy(method -> assertThat(method.getAnnotation(Cacheable.class))
+			.as("@Cacheable on narrowed read %s", method.getName())
+			.isNull());
+	}
+
+}
