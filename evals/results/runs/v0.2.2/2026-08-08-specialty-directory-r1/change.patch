+package org.springframework.samples.petclinic.vet;
+
+/**
+ * Shared test vocabulary for the vet package: builders for the persistent entities whose
+ * setters tests would otherwise call by hand.
+ */
+final class VetFixtures {
+
+	private VetFixtures() {
+	}
+
+	/**
+	 * A stored specialty, identified as the database would identify it.
+	 * @param id the stored identifier
+	 * @param name the specialty name
+	 * @return the specialty
+	 */
+	static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	/**
+	 * A veterinarian holding the given specialties.
+	 * @param firstName the given name
+	 * @param lastName the family name
+	 * @param specialties the specialties held, if any
+	 * @return the veterinarian
+	 */
+	static Vet vet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
