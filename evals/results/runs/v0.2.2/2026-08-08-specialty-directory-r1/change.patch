+
+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Entry;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Holder;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatIllegalArgumentException;
+import static org.springframework.samples.petclinic.vet.VetFixtures.specialty;
+import static org.springframework.samples.petclinic.vet.VetFixtures.vet;
+
+/**
+ * Test class for the {@link SpecialtyDirectory} read model, which inverts the
+ * unidirectional veterinarian-to-specialty association in memory.
+ */
+class SpecialtyDirectoryTests {
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology(), surgery(), dentistry()), List.of());
+
+		assertThat(directory.entries()).extracting(Entry::name)
+			.containsExactlyInAnyOrder("radiology", "surgery", "dentistry");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderByFirstAndLastName() {
+		Specialty radiology = radiology();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(vet("Helen", "Leary", radiology), vet("Linda", "Douglas", radiology)));
+
+		assertThat(directory.entries()).singleElement()
+			.satisfies(entry -> assertThat(entry.holders()).containsExactly(new Holder("Linda", "Douglas"),
+					new Holder("Helen", "Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = radiology();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery()),
+				List.of(vet("Helen", "Leary", radiology)));
+
+		assertThat(directory.entries()).filteredOn(entry -> entry.name().equals("surgery"))
+			.singleElement()
+			.satisfies(entry -> assertThat(entry.holders()).isEmpty());
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = radiology();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(vet("James", "Carter"), vet("Helen", "Leary", radiology)));
+
+		assertThat(directory.entries()).flatExtracting(Entry::holders).containsExactly(new Holder("Helen", "Leary"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesAndHoldersStably() {
+		Specialty radiology = radiology();
+		Specialty surgery = surgery();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry(), radiology),
+				List.of(vet("Helen", "Leary", radiology, surgery), vet("Rafael", "Ortega", surgery),
+						vet("Linda", "Douglas", surgery)));
+
+		assertThat(directory.entries()).extracting(Entry::name).containsExactly("dentistry", "radiology", "surgery");
+		assertThat(directory.entries().get(2).holders()).containsExactly(new Holder("Linda", "Douglas"),
+				new Holder("Helen", "Leary"), new Holder("Rafael", "Ortega"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenTheClinicKnowsNoSpecialty() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(vet("James", "Carter")));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRefuseASpecialtyThatWasNeverStored() {
+		Specialty unsaved = new Specialty();
+		unsaved.setName("nutrition");
+
+		assertThatIllegalArgumentException().isThrownBy(() -> SpecialtyDirectory.of(List.of(unsaved), List.of()))
+			.withMessageContaining("nutrition");
+	}
+
+	private static Specialty radiology() {
+		return specialty(1, "radiology");
+	}
+
+	private static Specialty surgery() {
+		return specialty(2, "surgery");
+	}
+
+	private static Specialty dentistry() {
+		return specialty(3, "dentistry");
+	}
+
+}
