+import java.util.Collection;
+
+/**
+ * Repository class for <code>Specialty</code> domain objects. The surface is deliberately
+ * minimal: the specialty directory reads every specialty and nothing else writes them.
+ * <p>
+ * Unlike <code>VetRepository</code> this read is not cached, because veterinarian-cache
+ * eviction is still an open question and a second cache would widen it.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve all <code>Specialty</code>s from the data store.
+	 * @return a <code>Collection</code> of <code>Specialty</code>s
+	 */
+	@Transactional(readOnly = true)
+	Collection<Specialty> findAll() throws DataAccessException;
+
+}
