+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Immutable read model listing every specialty with the veterinarians holding it.
+ * <p>
+ * {@link Vet} owns the association to {@link Specialty} and {@code Specialty} knows
+ * nothing of {@code Vet}, so the inverse view is assembled in memory from the two
+ * collections the application already reads rather than queried. A specialty no
+ * veterinarian holds keeps an empty holder list; a veterinarian holding no specialty
+ * appears nowhere, because grouping is driven by the specialties each one holds.
+ * <p>
+ * Order is fixed here rather than in SQL, so all database vendors present the same page:
+ * specialties by name, then holders by last name and first name.
+ * <p>
+ * Recorded in {@code docs/adr/2026-08-08-specialty-directory-read-model.md}.
+ */
+record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Entry> BY_SPECIALTY_NAME = Comparator.comparing(Entry::name);
+
+	private static final Comparator<Holder> BY_HOLDER_NAME = Comparator.comparing(Holder::lastName)
+		.thenComparing(Holder::firstName);
+
+	SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Group the given veterinarians under the given specialties.
+	 * @param specialties every specialty the clinic knows; each one becomes an entry
+	 * @param vets every veterinarian; those holding no specialty are left out
+	 * @return the grouped, ordered directory
+	 * @throws IllegalArgumentException if any specialty carries no stored identifier,
+	 * since its holders cannot be resolved; one such specialty fails the whole call
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<Holder>> holdersBySpecialtyId = holdersBySpecialtyId(vets);
+		return new SpecialtyDirectory(specialties.stream()
+			.map(specialty -> entryFor(specialty, holdersBySpecialtyId))
+			.sorted(BY_SPECIALTY_NAME)
+			.toList());
+	}
+
+	private static Map<Integer, List<Holder>> holdersBySpecialtyId(Collection<Vet> vets) {
+		Map<Integer, List<Holder>> holders = new HashMap<>();
+		for (Vet vet : vets) {
+			Holder holder = new Holder(vet.getFirstName(), vet.getLastName());
+			for (Specialty held : vet.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(holder);
+			}
+		}
+		return holders;
+	}
+
+	private static Entry entryFor(Specialty specialty, Map<Integer, List<Holder>> holdersBySpecialtyId) {
+		Integer id = specialty.getId();
+		if (id == null) {
+			throw new IllegalArgumentException(
+					"Specialty '" + specialty.getName() + "' has no identifier, so its holders cannot be resolved");
+		}
+		List<Holder> holders = holdersBySpecialtyId.getOrDefault(id, List.of());
+		return new Entry(specialty.getName(), holders.stream().sorted(BY_HOLDER_NAME).toList());
+	}
+
+	/**
+	 * One specialty, shown by its stored name, with the veterinarians holding it.
+	 */
+	record Entry(String name, List<Holder> holders) {
+
+		Entry {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+	/**
+	 * A veterinarian holding a specialty, named as the directory shows them.
+	 */
+	record Holder(String firstName, String lastName) {
+	}
+
+}
