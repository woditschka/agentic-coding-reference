+	@Test
+	void theSpecialtyDirectoryShouldSeparateTheNamesOfVeterinariansSharingASpecialty() throws Exception {
+		givenTheClinicKnows(List.of(createSpecialty(RADIOLOGY_ID, "radiology")),
+				List.of(createVet(1, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, "radiology")),
+						createVet(2, "Rafael", "Ortega", createSpecialty(RADIOLOGY_ID, "radiology"))));
+
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString("Helen Leary, Rafael Ortega")));
+	}
+
+	private void givenTheClinicKnows(List<Specialty> knownSpecialties, List<Vet> employedVets) {
+		given(this.specialties.findAll()).willReturn(knownSpecialties);
+		given(this.vets.findAll()).willReturn(employedVets);
+	}
+
+}
