+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.net.URL;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.regex.Pattern;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Guards the product decision that the specialty directory is reachable by its address
+ * alone: no page of the application offers a navigation entry or a link to it.
+ *
+ * The application's pages are its Thymeleaf templates, so the assertions read the
+ * templates the running application serves rather than crawling a live server.
+ */
+class SpecialtyDirectoryLinkageTests {
+
+	private static final String SPECIALTY_DIRECTORY_ROUTE = "/specialties.html";
+
+	private static final String SHARED_LAYOUT = "fragments/layout.html";
+
+	/**
+	 * Matches a navigation entry in the shared layout, capturing the link it points at.
+	 * Entries read {@code ~{::menuItem ('/vets.html','vets', ...)}}; the quote after the
+	 * opening parenthesis keeps the fragment's own declaration out of the results.
+	 */
+	private static final Pattern NAVIGATION_ENTRY = Pattern.compile("menuItem\\s*\\(\\s*'([^']*)'");
+
+	@Test
+	void theSpecialtyDirectoryShouldNotBeLinkedFromAnyPage() throws Exception {
+		assertThat(navigationLinksOfSharedLayout()).as("navigation entries in %s", SHARED_LAYOUT)
+			.doesNotContain(SPECIALTY_DIRECTORY_ROUTE);
+
+		assertThat(templatesReferencing(SPECIALTY_DIRECTORY_ROUTE))
+			.as("templates linking to the specialty directory at %s", SPECIALTY_DIRECTORY_ROUTE)
+			.isEmpty();
+	}
+
+	private static List<String> navigationLinksOfSharedLayout() throws Exception {
+		String layout = contentOf(templateDirectory().resolve(SHARED_LAYOUT));
+		return NAVIGATION_ENTRY.matcher(layout).results().map(entry -> entry.group(1)).toList();
+	}
+
+	private static List<String> templatesReferencing(String route) throws Exception {
+		Path templates = templateDirectory();
+		try (Stream<Path> files = Files.walk(templates)) {
+			return files.filter(file -> file.getFileName().toString().endsWith(".html"))
+				.filter(file -> contentOf(file).contains(route))
+				.map(file -> templates.relativize(file).toString())
+				.toList();
+		}
+	}
+
+	private static Path templateDirectory() throws Exception {
+		URL templates = SpecialtyDirectoryLinkageTests.class.getClassLoader().getResource("templates");
+		assertThat(templates).as("the application's templates must be on the test classpath").isNotNull();
+		return Path.of(templates.toURI());
+	}
+
+	private static String contentOf(Path template) {
+		try {
+			return Files.readString(template);
+		}
+		catch (IOException unreadable) {
+			throw new UncheckedIOException("cannot read template " + template, unreadable);
+		}
+	}
+
+}
