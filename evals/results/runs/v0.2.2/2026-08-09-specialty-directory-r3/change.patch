+package org.springframework.samples.petclinic.vet;
+
+/**
+ * Shared factories for the vet package's test data, so that tests across the package
+ * build veterinarians and specialties the same way instead of copying the setter
+ * sequences.
+ */
+final class VetTestFixtures {
+
+	private VetTestFixtures() {
+	}
+
+	static Specialty createSpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	static Vet createVet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
