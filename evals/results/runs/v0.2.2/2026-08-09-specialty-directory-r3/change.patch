+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatExceptionOfType;
+import static org.springframework.samples.petclinic.vet.VetTestFixtures.createSpecialty;
+import static org.springframework.samples.petclinic.vet.VetTestFixtures.createVet;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the projection behind the specialty
+ * directory page.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int DENTISTRY_ID = 3;
+
+	private static final int SOME_VET_ID = 100;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByItsStoredName() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, "radiology");
+		Specialty surgery = createSpecialty(SURGERY_ID, "surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of());
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::specialtyName)
+			.containsExactly("radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachVeterinarianByFullName() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, "radiology");
+		Vet helen = createVet(1, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, "radiology"));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory.entries()).singleElement()
+			.extracting(SpecialtyDirectory.Entry::veterinarianNames)
+			.isEqualTo(List.of("Helen Leary"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, "radiology");
+		Vet helen = createVet(1, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, "radiology"));
+		Vet james = createVet(2, "James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, james));
+
+		assertThat(directory.entries()).flatExtracting(SpecialtyDirectory.Entry::veterinarianNames)
+			.containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		Specialty dentistry = createSpecialty(DENTISTRY_ID, "dentistry");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry), List.of());
+
+		assertThat(directory.entries()).singleElement().satisfies(entry -> {
+			assertThat(entry.specialtyName()).isEqualTo("dentistry");
+			assertThat(entry.veterinarianNames()).isEmpty();
+		});
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderWhenTheClinicKnowsNoSpecialties() {
+		Vet james = createVet(SOME_VET_ID, "James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(james));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldGroupOnTheSpecialtyIdentifierRatherThanTheInstance() {
+		Specialty storedRadiology = createSpecialty(RADIOLOGY_ID, "radiology");
+		Vet helen = createVet(1, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, "radiology"));
+		Vet linda = createVet(2, "Linda", "Douglas", createSpecialty(RADIOLOGY_ID, "radiology"));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(storedRadiology), List.of(helen, linda));
+
+		assertThat(directory.entries()).singleElement()
+			.extracting(SpecialtyDirectory.Entry::veterinarianNames)
+			.isEqualTo(List.of("Linda Douglas", "Helen Leary"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByNameIgnoringCase() {
+		Specialty surgery = createSpecialty(SURGERY_ID, "Surgery");
+		Specialty dentistry = createSpecialty(DENTISTRY_ID, "dentistry");
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, "radiology");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology), List.of());
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::specialtyName)
+			.containsExactly("dentistry", "radiology", "Surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesSharingANameByIdentifier() {
+		int lowerId = 1;
+		int higherId = 2;
+		Specialty higherRadiology = createSpecialty(higherId, "radiology");
+		Specialty lowerRadiology = createSpecialty(lowerId, "radiology");
+		Vet helen = createVet(1, "Helen", "Leary", createSpecialty(lowerId, "radiology"));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(higherRadiology, lowerRadiology), List.of(helen));
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::veterinarianNames)
+			.containsExactly(List.of("Helen Leary"), List.of());
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastNameThenFirstName() {
+		Specialty radiology = createSpecialty(RADIOLOGY_ID, "radiology");
+		Vet helenLeary = createVet(1, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, "radiology"));
+		Vet rafaelOrtega = createVet(2, "Rafael", "Ortega", createSpecialty(RADIOLOGY_ID, "radiology"));
+		Vet anneLeary = createVet(3, "Anne", "Leary", createSpecialty(RADIOLOGY_ID, "radiology"));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(rafaelOrtega, helenLeary, anneLeary));
+
+		assertThat(directory.entries()).singleElement()
+			.extracting(SpecialtyDirectory.Entry::veterinarianNames)
+			.isEqualTo(List.of("Anne Leary", "Helen Leary", "Rafael Ortega"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRejectAModificationOfItsEntries() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(createSpecialty(RADIOLOGY_ID, "radiology")),
+				List.of());
+
+		assertThatExceptionOfType(UnsupportedOperationException.class).isThrownBy(() -> directory.entries().clear());
+	}
+
+}
