+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The clinic's specialties, each with the veterinarians holding it, ready to render.
+ * <p>
+ * An immutable projection built from the two reads that feed the specialty directory
+ * page. It owns three rules the page depends on: veterinarians are grouped under a
+ * specialty by the specialty's identifier (never by instance, since entities compare by
+ * identity, and never by name, since stored names are not unique); a veterinarian is
+ * named first name then last name; and both the specialties and the veterinarians within
+ * each appear in a stable order. Ordering is applied here in Java rather than in SQL, so
+ * every database vendor yields the order the tests observe.
+ */
+record SpecialtyDirectory(List<Entry> entries) {
+
+	/**
+	 * Orders specialties by name ignoring case, then by identifier so that two
+	 * specialties sharing a stored name still order stably.
+	 */
+	private static final Comparator<Specialty> BY_NAME_THEN_ID = Comparator
+		.comparing(Specialty::getName, String.CASE_INSENSITIVE_ORDER)
+		.thenComparing(Specialty::getId);
+
+	/**
+	 * Orders veterinarians by last name, then first name, both ignoring case, then by
+	 * identifier so that two namesakes still order stably.
+	 */
+	private static final Comparator<Vet> BY_LAST_NAME_THEN_FIRST_NAME = Comparator
+		.comparing(Vet::getLastName, String.CASE_INSENSITIVE_ORDER)
+		.thenComparing(Vet::getFirstName, String.CASE_INSENSITIVE_ORDER)
+		.thenComparing(Vet::getId);
+
+	SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * One specialty and the full names of the veterinarians holding it, in the order they
+	 * are rendered. A specialty held by no veterinarian carries an empty list.
+	 */
+	record Entry(String specialtyName, List<String> veterinarianNames) {
+
+		Entry {
+			veterinarianNames = List.copyOf(veterinarianNames);
+		}
+
+	}
+
+	/**
+	 * Builds the directory from every specialty the clinic knows and every veterinarian
+	 * it employs.
+	 * @param specialties every specialty, including those no veterinarian holds
+	 * @param veterinarians every veterinarian; one holding no specialty is left out of
+	 * the directory entirely
+	 * @return the specialties in rendering order, each with its holders
+	 */
+	static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<String>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_NAME_THEN_ID)
+			.map(specialty -> new Entry(specialty.getName(),
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static Map<Integer, List<String>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<String>> holders = new LinkedHashMap<>();
+		veterinarians.stream().sorted(BY_LAST_NAME_THEN_FIRST_NAME).forEach(vet -> {
+			for (Specialty specialty : vet.getSpecialties()) {
+				holders.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(fullNameOf(vet));
+			}
+		});
+		return holders;
+	}
+
+	private static String fullNameOf(Vet vet) {
+		return vet.getFirstName() + " " + vet.getLastName();
+	}
+
+}
