+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * The clinic's specialties, each with the veterinarians holding it: the inverse view of
+ * the veterinarian directory.
+ * <p>
+ * Every known specialty is listed, including one no veterinarian holds; a veterinarian
+ * holding no specialty is listed nowhere. Both levels carry a total order so the listing
+ * is stable across reads and across database vendors, which is why the order is imposed
+ * here rather than by a query.
+ * <p>
+ * A specialty name is stored data, not interface wording, so it is carried through
+ * exactly as stored and is never translated.
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	/** Stored name ascending, ignoring case, with the stored identity breaking ties. */
+	private static final Comparator<Specialty> BY_STORED_NAME = Comparator
+		.comparing(Specialty::getName, Comparator.nullsLast(String.CASE_INSENSITIVE_ORDER))
+		.thenComparing(Specialty::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	/** Last name, then first name, both ignoring case, with identity breaking ties. */
+	private static final Comparator<Vet> BY_HOLDER_NAME = Comparator
+		.comparing(Vet::getLastName, Comparator.nullsLast(String.CASE_INSENSITIVE_ORDER))
+		.thenComparing(Vet::getFirstName, Comparator.nullsLast(String.CASE_INSENSITIVE_ORDER))
+		.thenComparing(Vet::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(Objects.requireNonNull(entries, "entries"));
+	}
+
+	/**
+	 * Project the clinic's specialties and veterinarians into the directory listing.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians every veterinarian on the roster
+	 * @return one entry per specialty, in stable order
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Objects.requireNonNull(specialties, "specialties must not be null");
+		Objects.requireNonNull(veterinarians, "veterinarians must not be null");
+		List<Vet> roster = veterinarians.stream().sorted(BY_HOLDER_NAME).toList();
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_STORED_NAME)
+			.map(specialty -> new Entry(specialty.getName(), holdersOf(specialty, roster)))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static List<String> holdersOf(Specialty specialty, List<Vet> roster) {
+		return roster.stream()
+			.filter(veterinarian -> holds(veterinarian, specialty))
+			.map(veterinarian -> veterinarian.getFirstName() + " " + veterinarian.getLastName())
+			.toList();
+	}
+
+	/**
+	 * The specialties a veterinarian holds and the specialties the clinic knows are read
+	 * separately, so the same stored specialty arrives as two distinct instances. They
+	 * are matched on stored identity; a specialty never stored has no recorded holder.
+	 */
+	private static boolean holds(Vet veterinarian, Specialty specialty) {
+		Integer storedIdentity = specialty.getId();
+		return storedIdentity != null
+				&& veterinarian.getSpecialties().stream().anyMatch(held -> storedIdentity.equals(held.getId()));
+	}
+
+	/**
+	 * One listed specialty.
+	 *
+	 * @param name the specialty's stored name
+	 * @param holders the full names of the veterinarians holding it, in stable order
+	 */
+	public record Entry(String name, List<String> holders) {
+
+		public Entry {
+			holders = List.copyOf(Objects.requireNonNull(holders, "holders"));
+		}
+
+	}
+
+}
