+
+	@Test
+	void theSpecialtyDirectoryShouldRejectMissingSpecialties() {
+		assertThatNullPointerException().isThrownBy(() -> SpecialtyDirectory.of(null, NO_VETERINARIANS))
+			.withMessageContaining("specialties");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRejectMissingVeterinarians() {
+		assertThatNullPointerException().isThrownBy(() -> SpecialtyDirectory.of(List.of(), null))
+			.withMessageContaining("veterinarians");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderByFullName() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet helenLeary = veterinarian(2, "Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary));
+
+		assertThat(directory.entries().get(0).holders()).containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = specialty(1, "radiology");
+		Vet helenLeary = veterinarian(2, "Helen", "Leary", radiology);
+		Vet jamesCarter = veterinarian(1, "James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(jamesCarter, helenLeary));
+
+		assertThat(directory.entries()).flatExtracting(SpecialtyDirectory.Entry::holders)
+			.containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = specialty(1, "radiology");
+		Specialty surgery = specialty(2, "surgery");
+		Vet helenLeary = veterinarian(2, "Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(helenLeary));
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::name)
+			.containsExactly("radiology", "surgery");
+		assertThat(directory.entries().get(1).holders()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderHoldersByLastNameThenFirstName() {
+		Specialty surgery = specialty(1, "surgery");
+		Vet rafaelOrtega = veterinarian(3, "Rafael", "Ortega", surgery);
+		Vet lindaDouglas = veterinarian(4, "Linda", "Douglas", surgery);
+		Vet henryDouglas = veterinarian(5, "Henry", "Douglas", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery),
+				List.of(rafaelOrtega, lindaDouglas, henryDouglas));
+
+		assertThat(directory.entries().get(0).holders()).containsExactly("Henry Douglas", "Linda Douglas",
+				"Rafael Ortega");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchHoldersToSpecialtiesReadSeparately() {
+		Specialty storedRadiology = specialty(1, "radiology");
+		Specialty radiologyReachedThroughTheVet = specialty(1, "radiology");
+		Vet helenLeary = veterinarian(2, "Helen", "Leary", radiologyReachedThroughTheVet);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(storedRadiology), List.of(helenLeary));
+
+		assertThat(directory.entries().get(0).holders()).containsExactly("Helen Leary");
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet veterinarian(int id, String firstName, String lastName, Specialty... held) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(id);
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		for (Specialty specialty : held) {
+			veterinarian.addSpecialty(specialty);
+		}
+		return veterinarian;
+	}
+
+}
