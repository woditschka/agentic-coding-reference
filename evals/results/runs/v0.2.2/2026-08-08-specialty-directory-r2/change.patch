+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatNullPointerException;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the projection behind the specialty
+ * directory page.
+ */
+class SpecialtyDirectoryTests {
+
+	/**
+	 * The veterinarian directory shows this many veterinarians per page; the specialty
+	 * directory lists everything it knows on one page instead.
+	 */
+	private static final int VETERINARIAN_DIRECTORY_PAGE_SIZE = 5;
+
+	private static final List<Vet> NO_VETERINARIANS = List.of();
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		Specialty radiology = specialty(1, "radiology");
+		Specialty surgery = specialty(2, "surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), NO_VETERINARIANS);
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::name)
+			.containsExactly("radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByStoredNameIgnoringCase() {
+		Specialty surgery = specialty(1, "surgery");
+		Specialty dentistry = specialty(2, "Dentistry");
+		Specialty radiology = specialty(3, "radiology");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology), NO_VETERINARIANS);
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::name)
+			.containsExactly("Dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderEquallyNamedSpecialtiesByStoredIdentity() {
+		Specialty lowerCaseSurgery = specialty(7, "surgery");
+		Specialty upperCaseSurgery = specialty(4, "Surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(lowerCaseSurgery, upperCaseSurgery),
+				NO_VETERINARIANS);
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::name)
+			.containsExactly("Surgery", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenTheClinicKnowsNoSpecialty() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), NO_VETERINARIANS);
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAllSpecialtiesWithoutPaging() {
+		int storedSpecialties = VETERINARIAN_DIRECTORY_PAGE_SIZE + 3;
+		List<Specialty> specialties = IntStream.rangeClosed(1, storedSpecialties)
+			.mapToObj(id -> specialty(id, "specialty " + id))
+			.toList();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, NO_VETERINARIANS);
+
+		assertThat(directory.entries()).hasSize(storedSpecialties);
