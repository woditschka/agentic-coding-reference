+
+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Import;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageImpl;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.hamcrest.Matchers.stringContainsInOrder;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for {@link SpecialtyController} and the page it renders.
+ * <p>
+ * The repositories are hand-written stand-ins over a fixed clinic rather than mocks.
+ * {@link StubVetRepository} applies the same restriction the real join-fetch query
+ * carries — only veterinarians holding a specialty — which
+ * {@code SpecialtyDirectoryRepositoryTests} pins against a database.
+ */
+@WebMvcTest(SpecialtyController.class)
+@Import(SpecialtyControllerTests.TheClinicsDirectory.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final Specialty RADIOLOGY = specialty(1, "radiology");
+
+	private static final Specialty SURGERY = specialty(2, "surgery");
+
+	/** The specialty no veterinarian in this clinic holds. */
+	private static final Specialty DENTISTRY = specialty(3, "dentistry");
+
+	/** The veterinarian who holds nothing, and so belongs on no page of the directory. */
+	private static final Vet JAMES_CARTER = vet(1, "James", "Carter");
+
+	private static final List<Specialty> THE_CLINICS_SPECIALTIES = List.of(SURGERY, RADIOLOGY, DENTISTRY);
+
+	private static final List<Vet> THE_CLINICS_VETS = List.of(JAMES_CARTER, vet(2, "Helen", "Leary", RADIOLOGY),
+			vet(3, "Linda", "Douglas", SURGERY), vet(4, "Rafael", "Ortega", SURGERY));
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private StubSpecialtyRepository specialties;
+
+	@BeforeEach
+	void restoreTheClinicsSpecialties() {
+		this.specialties.storing(THE_CLINICS_SPECIALTIES);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attributeExists("specialtyDirectory"))
+			.andExpect(content().string(containsString("radiology")))
+			.andExpect(content().string(containsString("surgery")))
+			.andExpect(content().string(containsString("dentistry")))
+			.andExpect(result -> assertThat(result.getResponse().getContentAsString()).doesNotContain("page="));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHolderByFullName() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString("Helen Leary")))
+			.andExpect(content().string(containsString("Linda Douglas")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() throws Exception {
+		this.mockMvc.perform(get("/specialties.html")).andExpect(content().string(not(containsString("Carter"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(stringContainsInOrder("dentistry", "none", "radiology")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentSpecialtiesInAStableOrder() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(stringContainsInOrder("dentistry", "radiology", "surgery")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentTheHoldersOfASpecialtyInAStableOrder() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(stringContainsInOrder("Linda Douglas", "Rafael Ortega")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOpenWhenNoSpecialtyIsStored() throws Exception {
+		this.specialties.storing(List.of());
+
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attribute("specialtyDirectory", List.of()))
+			.andExpect(content().string(not(containsString("Helen Leary"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryWordingShouldComeFromTheMessageBundles() throws Exception {
+		this.mockMvc.perform(get("/specialties.html").param("lang", "de"))
+			// "Fachgebiete" and "keine" are the German bundle's values for the keys the
+			// page uses; neither string appears in the template.
+			.andExpect(content().string(containsString("Fachgebiete")))
+			.andExpect(content().string(containsString("keine")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheStandardSiteNavigation() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(stringContainsInOrder("navbar", "/vets.html")));
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet vet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	@TestConfiguration(proxyBeanMethods = false)
+	static class TheClinicsDirectory {
+
+		@Bean
+		StubSpecialtyRepository specialtyRepository() {
+			return new StubSpecialtyRepository();
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new StubVetRepository();
+		}
+
+	}
+
+	/** A specialty store whose contents each test sets. */
+	static class StubSpecialtyRepository implements SpecialtyRepository {
+
+		private List<Specialty> stored = List.of();
+
+		void storing(List<Specialty> specialties) {
+			this.stored = specialties;
+		}
+
+		@Override
+		public Collection<Specialty> findAll() {
+			return this.stored;
+		}
+
+	}
+
+	/** The clinic's veterinarians, fixed. */
+	static class StubVetRepository implements VetRepository {
+
+		@Override
+		public Collection<Vet> findAll() {
+			return THE_CLINICS_VETS;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			return new PageImpl<>(new ArrayList<>(THE_CLINICS_VETS));
+		}
+
+		@Override
+		public Collection<Vet> findAllHoldingASpecialty() {
+			return THE_CLINICS_VETS.stream().filter(vet -> vet.getNrOfSpecialties() > 0).toList();
+		}
+
+	}
+
+}
