+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * One line of the specialty directory: a {@link Specialty} together with the {@link Vet
+ * veterinarians} holding it, in the order the page presents them.
+ * <p>
+ * There is one entry per <em>stored</em> specialty. Two specialties that happen to share
+ * a name are two entries, because the grouping keys on the specialty identifier and never
+ * on its name.
+ *
+ * @param specialty the stored specialty this entry presents
+ * @param holders the veterinarians holding it, possibly none, ordered by last name, first
+ * name, then identifier
+ */
+public record SpecialtyDirectoryEntry(Specialty specialty, List<Vet> holders) {
+
+	/**
+	 * Specialties are presented by name, then by identifier. The identifier tiebreak is
+	 * what gives two specialties sharing one name a total order instead of an arbitrary
+	 * one.
+	 */
+	private static final Comparator<Specialty> BY_NAME_THEN_ID = Comparator
+		.<Specialty, String>comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	/** Holders are presented by last name, then first name, then identifier. */
+	private static final Comparator<Vet> BY_LAST_NAME_THEN_FIRST_NAME_THEN_ID = Comparator
+		.<Vet, String>comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyDirectoryEntry {
+		holders = List.copyOf(holders);
+	}
+
+	/**
+	 * Builds the whole directory: every stored specialty, each with the veterinarians
+	 * holding it.
+	 * <p>
+	 * The order is computed here rather than by a SQL {@code ORDER BY}, so that the page
+	 * reads the same under every supported database vendor — see
+	 * {@code docs/adr/2026-08-28-in-memory-ordering-for-unpaged-listings.md}. That holds
+	 * only because the directory is unpaged and therefore loads its full result set.
+	 * @param specialties every specialty the clinic stores
+	 * @param specialtyHolders the veterinarians holding at least one specialty, with
+	 * their specialties loaded. A veterinarian holding none contributes nothing even if
+	 * passed in.
+	 * @return one entry per stored specialty, ordered for presentation
+	 */
+	public static List<SpecialtyDirectoryEntry> directoryOf(Collection<Specialty> specialties,
+			Collection<Vet> specialtyHolders) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet holder : specialtyHolders) {
+			for (Specialty held : holder.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(holder);
+			}
+		}
+		return specialties.stream()
+			.sorted(BY_NAME_THEN_ID)
+			.map(specialty -> new SpecialtyDirectoryEntry(specialty,
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())
+						.stream()
+						.sorted(BY_LAST_NAME_THEN_FIRST_NAME_THEN_ID)
+						.toList()))
+			.toList();
+	}
+
+}
