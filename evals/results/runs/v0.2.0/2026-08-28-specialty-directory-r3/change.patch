+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatExceptionOfType;
+
+/**
+ * Test class for {@link SpecialtyDirectoryEntry}, the read model behind the specialty
+ * directory page. It exercises the grouping and the presentation order without a database
+ * and without the web layer.
+ */
+class SpecialtyDirectoryEntryTests {
+
+	private static final Specialty DENTISTRY = specialty(3, "dentistry");
+
+	private static final Specialty RADIOLOGY = specialty(1, "radiology");
+
+	private static final Specialty SURGERY = specialty(2, "surgery");
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() {
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry
+			.directoryOf(List.of(RADIOLOGY, SURGERY, DENTISTRY), List.of());
+
+		assertThat(directory).extracting(entry -> entry.specialty().getName())
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHolderUnderEverySpecialtyTheyHold() {
+		Vet linda = vet(3, "Linda", "Douglas", SURGERY, DENTISTRY);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(SURGERY, DENTISTRY),
+				List.of(linda));
+
+		assertThat(directory).extracting(SpecialtyDirectoryEntry::holders)
+			.containsExactly(List.of(linda), List.of(linda));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Vet james = vet(1, "James", "Carter");
+		Vet helen = vet(2, "Helen", "Leary", RADIOLOGY);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(RADIOLOGY),
+				List.of(james, helen));
+
+		assertThat(directory).singleElement().extracting(SpecialtyDirectoryEntry::holders).isEqualTo(List.of(helen));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(DENTISTRY), List.of());
+
+		assertThat(directory).singleElement().satisfies(entry -> {
+			assertThat(entry.specialty()).isEqualTo(DENTISTRY);
+			assertThat(entry.holders()).isEmpty();
+		});
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenNoSpecialtyIsStored() {
+		assertThat(SpecialtyDirectoryEntry.directoryOf(List.of(), List.of())).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentSpecialtiesInAStableOrder() {
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry
+			.directoryOf(List.of(SURGERY, DENTISTRY, RADIOLOGY), List.of());
+
+		assertThat(directory).extracting(entry -> entry.specialty().getId()).containsExactly(3, 1, 2);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentHoldersInAStableOrder() {
+		Vet helenLeary = vet(2, "Helen", "Leary", RADIOLOGY);
+		Vet lindaDouglas = vet(3, "Linda", "Douglas", RADIOLOGY);
+		Vet adaDouglas = vet(4, "Ada", "Douglas", RADIOLOGY);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(RADIOLOGY),
+				List.of(helenLeary, lindaDouglas, adaDouglas));
+
+		assertThat(directory).singleElement()
+			.extracting(SpecialtyDirectoryEntry::holders)
+			.isEqualTo(List.of(adaDouglas, lindaDouglas, helenLeary));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBreakATieOnMatchingHolderNamesByIdentifier() {
+		Vet lindaDouglasTheElder = vet(3, "Linda", "Douglas", RADIOLOGY);
+		Vet lindaDouglasTheYounger = vet(7, "Linda", "Douglas", RADIOLOGY);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directoryOf(List.of(RADIOLOGY),
+				List.of(lindaDouglasTheYounger, lindaDouglasTheElder));
+
+		assertThat(directory.getFirst().holders()).extracting(Vet::getId).containsExactly(3, 7);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListTwoSpecialtiesSharingOneNameSeparately() {
+		Specialty surgeryOnFloorOne = specialty(2, "surgery");
+		Specialty surgeryOnFloorTwo = specialty(9, "surgery");
+		Vet helen = vet(2, "Helen", "Leary", surgeryOnFloorTwo);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry
+			.directoryOf(List.of(surgeryOnFloorTwo, surgeryOnFloorOne), List.of(helen));
+
+		assertThat(directory).extracting(entry -> entry.specialty().getId()).containsExactly(2, 9);
+		assertThat(directory).extracting(SpecialtyDirectoryEntry::holders).containsExactly(List.of(), List.of(helen));
+	}
+
+	@Test
+	void aDirectoryEntryShouldNotLetItsHolderListBeChanged() {
+		Vet helen = vet(2, "Helen", "Leary", RADIOLOGY);
+		SpecialtyDirectoryEntry entry = SpecialtyDirectoryEntry.directoryOf(List.of(RADIOLOGY), List.of(helen))
+			.getFirst();
+
+		assertThatExceptionOfType(UnsupportedOperationException.class).isThrownBy(() -> entry.holders().clear());
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet vet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
