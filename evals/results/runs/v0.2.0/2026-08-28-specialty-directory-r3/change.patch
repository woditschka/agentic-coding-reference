+
+package org.springframework.samples.petclinic.vet;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Pins the specialty directory's reachability: it is a directly addressed page, and no
+ * template links to it.
+ * <p>
+ * The check reads the templates from disk rather than a rendered response, so that a link
+ * added to any page — not only the pages a controller test happens to render — fails the
+ * build. That needs no Spring context, so this test carries none.
+ */
+class SpecialtyDirectoryNavigationTests {
+
+	private static final Path TEMPLATES = Path.of("src/main/resources/templates");
+
+	private static final String THE_SPECIALTY_DIRECTORY_ADDRESS = "specialties.html";
+
+	@Test
+	void theSiteNavigationShouldCarryNoLinkToTheSpecialtyDirectory() throws Exception {
+		List<Path> templatesMentioningTheDirectoryAddress;
+		try (Stream<Path> templates = Files.walk(TEMPLATES)) {
+			templatesMentioningTheDirectoryAddress = templates.filter(path -> path.toString().endsWith(".html"))
+				.filter(SpecialtyDirectoryNavigationTests::mentionsTheSpecialtyDirectoryAddress)
+				.toList();
+		}
+
+		assertThat(templatesMentioningTheDirectoryAddress).isEmpty();
+	}
+
+	private static boolean mentionsTheSpecialtyDirectoryAddress(Path template) {
+		try {
+			return Files.readString(template).contains(THE_SPECIALTY_DIRECTORY_ADDRESS);
+		}
+		catch (IOException couldNotRead) {
+			throw new IllegalStateException("Could not read template " + template, couldNotRead);
+		}
+	}
+
+}
