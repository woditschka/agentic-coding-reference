+ * limitations under the License.
+ */
+
+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Integration test for the two queries behind the specialty directory: one for every
+ * stored specialty, one for the veterinarians that hold any.
+ */
+@DataJpaTest
+// Ensure that if the mysql profile is active we connect to the real database:
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class SpecialtyDirectoryRepositoryTests {
+
+	@Autowired
+	private SpecialtyRepository specialties;
+
+	@Autowired
+	private VetRepository vets;
+
+	@Test
+	void everyStoredSpecialtyShouldBeRetrievable() {
+		assertThat(this.specialties.findAll()).extracting(Specialty::getName)
+			.containsExactlyInAnyOrder("radiology", "surgery", "dentistry");
+	}
+
+	@Test
+	void theSpecialtyHoldersQueryShouldReturnOnlyVeterinariansHoldingASpecialty() {
+		Collection<Vet> holders = this.vets.findAllHoldingASpecialty();
+
+		assertThat(holders).isNotEmpty()
+			.allSatisfy(holder -> assertThat(holder.getSpecialties()).isNotEmpty())
+			.hasSize((int) this.vets.findAll().stream().filter(vet -> vet.getNrOfSpecialties() > 0).count());
+	}
+
+	@Test
+	void theSpecialtyHoldersQueryShouldReturnEachHolderOnceHoweverManySpecialtiesTheyHold() {
+		Collection<Vet> holders = this.vets.findAllHoldingASpecialty();
+
+		assertThat(holders).anySatisfy(holder -> assertThat(holder.getNrOfSpecialties()).isGreaterThan(1))
+			.extracting(Vet::getId)
+			.doesNotHaveDuplicates();
+	}
+
+}
