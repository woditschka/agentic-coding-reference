+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.springframework.samples.petclinic.model.BaseEntity;
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * Immutable read model pairing every stored {@link Specialty} with the {@link Vet}s
+ * holding it. {@code Vet} owns the association and {@code Specialty} carries no reference
+ * back, so the pairing exists nowhere in the persisted model and is assembled here from
+ * two independent whole reads.
+ * <p>
+ * A specialty no veterinarian holds keeps an entry with an empty veterinarian list; a
+ * veterinarian holding no specialty appears in no entry.
+ * <p>
+ * The presentation order is imposed here rather than by the query, so the directory reads
+ * the same on every supported database vendor regardless of its collation. See ADR
+ * 2026-08-04, "Specialty Directory Assembled in a Read Model".
+ */
+public final class SpecialtyDirectory {
+
+	/**
+	 * Specialties are presented by name; the entity id breaks a tie between namesakes so
+	 * the order is total.
+	 */
+	private static final Comparator<Specialty> BY_SPECIALTY_NAME = Comparator
+		.<Specialty, String>comparing(NamedEntity::getName, Comparator.nullsLast(Comparator.naturalOrder()))
+		.thenComparing(BaseEntity::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	/**
+	 * Veterinarians beneath a specialty are presented by last name then first name; the
+	 * entity id breaks a tie between namesakes so the order is total.
+	 */
+	private static final Comparator<Vet> BY_VETERINARIAN_NAME = Comparator
+		.<Vet, String>comparing(Person::getLastName, Comparator.nullsLast(Comparator.naturalOrder()))
+		.thenComparing(Person::getFirstName, Comparator.nullsLast(Comparator.naturalOrder()))
+		.thenComparing(BaseEntity::getId, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	private final List<Entry> entries;
+
+	private SpecialtyDirectory(List<Entry> entries) {
+		this.entries = entries;
+	}
+
+	/**
+	 * Pair a whole read of specialties with a whole read of veterinarians.
+	 * @param specialties every stored specialty, in any order
+	 * @param veterinarians every stored veterinarian, in any order
+	 * @return the directory, ordered for presentation
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_SPECIALTY_NAME)
+			.map(specialty -> new Entry(specialty, holdersOf(specialty, holdersBySpecialtyId)))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	/**
+	 * Index the veterinarians by the id of each specialty they hold. The two reads return
+	 * distinct object graphs, so the specialty id — not object identity — is what pairs
+	 * them.
+	 */
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holders;
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Map<Integer, List<Vet>> holdersBySpecialtyId) {
+		return holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())
+			.stream()
+			.sorted(BY_VETERINARIAN_NAME)
+			.toList();
+	}
+
+	/**
+	 * @return one entry per stored specialty, ordered for presentation
+	 */
+	public List<Entry> getEntries() {
+		return this.entries;
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it, both ready to render.
+	 *
+	 * @param specialty the stored specialty
+	 * @param veterinarians its holders, ordered for presentation; empty when no
+	 * veterinarian holds the specialty
+	 */
+	public record Entry(Specialty specialty, List<Vet> veterinarians) {
+	}
+
+}
