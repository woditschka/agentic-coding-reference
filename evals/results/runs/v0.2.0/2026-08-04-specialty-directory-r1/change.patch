+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+/**
+ * Test class for the {@link SpecialtyDirectory} read model. The directory's rules are
+ * exercised against real {@link Vet} and {@link Specialty} instances, with no HTTP
+ * surface and no database.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final Specialty RADIOLOGY = specialty(1, "radiology");
+
+	private static final Specialty SURGERY = specialty(2, "surgery");
+
+	private static final Specialty DENTISTRY = specialty(3, "dentistry");
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(RADIOLOGY, SURGERY, DENTISTRY), List.of());
+
+		assertThat(directory.getEntries()).extracting(entry -> entry.specialty().getName())
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachHolderAsFirstThenLastName() {
+		Vet helenLeary = vet(1, "Helen", "Leary", RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(RADIOLOGY), List.of(helenLeary));
+
+		assertThat(entryFor(directory, "radiology").veterinarians())
+			.extracting(vet -> vet.getFirstName() + " " + vet.getLastName())
+			.containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Vet helenLeary = vet(1, "Helen", "Leary", RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(RADIOLOGY, SURGERY), List.of(helenLeary));
+
+		assertThat(entryFor(directory, "surgery").veterinarians()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Vet jamesCarter = vet(1, "James", "Carter");
+		Vet helenLeary = vet(2, "Helen", "Leary", RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(RADIOLOGY), List.of(jamesCarter, helenLeary));
+
+		assertThat(directory.getEntries()).flatExtracting(SpecialtyDirectory.Entry::veterinarians)
+			.doesNotContain(jamesCarter);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEverySpecialtyOnOnePage() {
+		List<Specialty> everySpecialty = List.of(RADIOLOGY, SURGERY, DENTISTRY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(everySpecialty, List.of());
+
+		assertThat(directory.getEntries()).hasSameSizeAs(everySpecialty);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameAVeterinarianBeneathEverySpecialtyTheyHold() {
+		Vet lindaDouglas = vet(1, "Linda", "Douglas", DENTISTRY, SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(DENTISTRY, SURGERY), List.of(lindaDouglas));
+
+		assertThat(entryFor(directory, "dentistry").veterinarians()).containsExactly(lindaDouglas);
+		assertThat(entryFor(directory, "surgery").veterinarians()).containsExactly(lindaDouglas);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastThenFirstName() {
+		Vet rafaelOrtega = vet(1, "Rafael", "Ortega", SURGERY);
+		Vet henryStevens = vet(2, "Henry", "Stevens", SURGERY);
+		Vet lindaDouglas = vet(3, "Linda", "Douglas", SURGERY);
+		Vet adaDouglas = vet(4, "Ada", "Douglas", SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(SURGERY),
+				List.of(rafaelOrtega, henryStevens, lindaDouglas, adaDouglas));
+
+		assertThat(entryFor(directory, "surgery").veterinarians()).containsExactly(adaDouglas, lindaDouglas,
+				rafaelOrtega, henryStevens);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderNamesakesByEntityId() {
+		Specialty firstSurgery = specialty(10, "surgery");
+		Specialty secondSurgery = specialty(9, "surgery");
+		Vet elderJamesCarter = vet(7, "James", "Carter", firstSurgery, secondSurgery);
+		Vet youngerJamesCarter = vet(6, "James", "Carter", firstSurgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(firstSurgery, secondSurgery),
+				List.of(elderJamesCarter, youngerJamesCarter));
+
+		assertThat(directory.getEntries()).extracting(entry -> entry.specialty().getId()).containsExactly(9, 10);
+		assertThat(directory.getEntries().get(1).veterinarians()).containsExactly(youngerJamesCarter, elderJamesCarter);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRejectStructuralChangeAfterConstruction() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(RADIOLOGY), List.of());
+
+		assertThatThrownBy(() -> directory.getEntries().clear()).isInstanceOf(UnsupportedOperationException.class);
+		assertThatThrownBy(() -> directory.getEntries().get(0).veterinarians().clear())
+			.isInstanceOf(UnsupportedOperationException.class);
+	}
+
+	private static SpecialtyDirectory.Entry entryFor(SpecialtyDirectory directory, String specialtyName) {
+		return directory.getEntries()
+			.stream()
+			.filter(entry -> specialtyName.equals(entry.specialty().getName()))
+			.findFirst()
+			.orElseThrow(() -> new AssertionError("no directory entry for specialty '" + specialtyName + "'"));
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet vet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
