+package org.springframework.samples.petclinic.vet;
+
+/**
+ * The specialty a request narrows the veterinarian directory by, if it names one at all.
+ * <p>
+ * A request that supplies no specialty, an empty one, or one made only of whitespace
+ * narrows nothing: the directory then lists every <code>Vet</code>. Any other value is
+ * carried through exactly as supplied — surrounding whitespace included — and matched
+ * against the whole specialty name.
+ * <p>
+ * Both veterinarian directory routes decide through this type, so the rule is stated once
+ * and is testable without the web layer.
+ *
+ * @param specialtyName the specialty name to narrow by, or <code>null</code> when the
+ * request named none and the filter narrows nothing
+ */
+record SpecialtyFilter(String specialtyName) {
+
+	SpecialtyFilter {
+		if (specialtyName != null && specialtyName.isBlank()) {
+			specialtyName = null;
+		}
+	}
+
+	/**
+	 * Whether this filter narrows the directory at all.
+	 * @return <code>true</code> when a specialty was named, in which case
+	 * {@link #specialtyName()} is the name to match; <code>false</code> when every
+	 * <code>Vet</code> is listed
+	 */
+	boolean narrows() {
+		return this.specialtyName != null;
+	}
+
+}
