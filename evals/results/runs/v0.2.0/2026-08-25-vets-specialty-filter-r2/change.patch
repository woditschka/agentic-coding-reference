+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.NullSource;
+import org.junit.jupiter.params.provider.ValueSource;
+
+/**
+ * Test class for {@link SpecialtyFilter}, the rule deciding whether a request names a
+ * specialty at all.
+ */
+class SpecialtyFilterTests {
+
+	private static final String HELD_SPECIALTY = "radiology";
+
+	private SpecialtyFilter createFilterFor(String requestedSpecialty) {
+		return new SpecialtyFilter(requestedSpecialty);
+	}
+
+	@ParameterizedTest
+	@NullSource
+	@ValueSource(strings = { "", "   ", "\t" })
+	void theBlankSpecialtyShouldNarrowNothing(String blankSpecialty) {
+		SpecialtyFilter filter = createFilterFor(blankSpecialty);
+
+		assertThat(filter.narrows()).isFalse();
+		assertThat(filter.specialtyName()).isNull();
+	}
+
+	@Test
+	void theNamedSpecialtyShouldNarrowToThatName() {
+		SpecialtyFilter filter = createFilterFor(HELD_SPECIALTY);
+
+		assertThat(filter.narrows()).isTrue();
+		assertThat(filter.specialtyName()).isEqualTo(HELD_SPECIALTY);
+	}
+
+	@Test
+	void theSpecialtyNameShouldBeCarriedExactlyAsSupplied() {
+		String specialtyWithSurroundingSpaces = " " + HELD_SPECIALTY + " ";
+
+		SpecialtyFilter filter = createFilterFor(specialtyWithSurroundingSpaces);
+
+		assertThat(filter.specialtyName()).isEqualTo(specialtyWithSurroundingSpaces);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldBeEqualByValue() {
+		assertThat(createFilterFor(HELD_SPECIALTY)).isEqualTo(createFilterFor(HELD_SPECIALTY));
+		assertThat(createFilterFor("")).isEqualTo(createFilterFor(null));
+	}
+
+}
