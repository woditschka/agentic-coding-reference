+	// to the same rules as a booking, and saving the owner cascades an update to that
+	// visit rather than inserting another one. As when booking, the owner is only the
+	// aggregate root to save through and its binding is suppressed.
+	@PostMapping("/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit")
+	public String processVisitCorrectionForm(@ModelAttribute(binding = false) Owner owner, @Valid Visit visit,
+			BindingResult result) {
+		rejectDateNotInFuture(visit, result);
+
+		if (result.hasErrors()) {
+			return "pets/createOrUpdateVisitForm";
+		}
+
+		this.owners.save(owner);
+		return "redirect:/owners/{ownerId}";
+	}
+
+	private void rejectDateNotInFuture(Visit visit, BindingResult result) {
+		if (visit.getDate() != null && !visit.getDate().isAfter(LocalDate.now())) {
+			result.rejectValue("date", "typeMismatch.visitDate");
+		}
+	}
+
 }
