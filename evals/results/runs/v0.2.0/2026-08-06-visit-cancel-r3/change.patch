+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link Pet}, covering the visit lookup and withdrawal that the
+ * cancellation walk resolves through (REQ-VIS-003).
+ */
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 10;
+
+	private static final int ANOTHER_BOOKED_VISIT_ID = 11;
+
+	private static final int UNKNOWN_VISIT_ID = 999;
+
+	@Test
+	void aPetShouldFindAVisitItHoldsById() {
+		Visit booked = aVisit(BOOKED_VISIT_ID);
+
+		assertThat(aPetHolding(booked).getVisit(BOOKED_VISIT_ID)).isSameAs(booked);
+	}
+
+	@Test
+	void aPetShouldNotFindAVisitItDoesNotHold() {
+		assertThat(aPetHolding(aVisit(BOOKED_VISIT_ID)).getVisit(UNKNOWN_VISIT_ID)).isNull();
+	}
+
+	/**
+	 * The new-visit form leaves an unsaved, id-less visit in play. Looking one up by its
+	 * (null) id must not reach it, or a cancellation could withdraw form backing.
+	 */
+	@Test
+	void anUnsavedVisitShouldNotBeReachableByLookup() {
+		Pet pet = aPetHolding(anUnsavedVisit());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	@Test
+	void withdrawingAVisitShouldTakeItOffThePetsRecord() {
+		Visit booked = aVisit(BOOKED_VISIT_ID);
+		Visit anotherBooked = aVisit(ANOTHER_BOOKED_VISIT_ID);
+		Pet pet = aPetHolding(booked, anotherBooked);
+
+		pet.removeVisit(booked);
+
+		assertThat(pet.getVisits()).containsExactly(anotherBooked);
+	}
+
+	private static Pet aPetHolding(Visit... visits) {
+		Pet pet = new Pet();
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+	private static Visit aVisit(int visitId) {
+		Visit visit = anUnsavedVisit();
+		visit.setId(visitId);
+		return visit;
+	}
+
+	private static Visit anUnsavedVisit() {
+		Visit visit = new Visit();
+		visit.setDate(LocalDate.now().plusDays(1));
+		return visit;
+	}
+
+}
