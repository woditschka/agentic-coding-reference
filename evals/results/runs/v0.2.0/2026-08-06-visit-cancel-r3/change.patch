+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatIllegalArgumentException;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link Owner}, covering the aggregate walk that makes visit ownership
+ * structural: a visit is reachable only through the pet that holds it (REQ-VIS-003).
+ */
+class OwnerTests {
+
+	private static final int PET_ID = 1;
+
+	private static final int OTHER_PET_ID = 2;
+
+	private static final int UNHELD_PET_ID = 999;
+
+	private static final int BOOKED_VISIT_ID = 10;
+
+	private static final int OTHER_PETS_VISIT_ID = 11;
+
+	@Test
+	void anOwnerShouldFindAVisitHeldByTheNamedPet() {
+		Owner owner = anOwner();
+		Visit booked = aVisit(BOOKED_VISIT_ID);
+		aPetOf(owner, PET_ID, booked);
+
+		assertThat(owner.getVisit(PET_ID, BOOKED_VISIT_ID)).isSameAs(booked);
+	}
+
+	@Test
+	void anOwnerShouldNotFindAVisitHeldByAnotherOfItsPets() {
+		Owner owner = anOwner();
+		aPetOf(owner, PET_ID, aVisit(BOOKED_VISIT_ID));
+		aPetOf(owner, OTHER_PET_ID, aVisit(OTHER_PETS_VISIT_ID));
+
+		assertThat(owner.getVisit(PET_ID, OTHER_PETS_VISIT_ID)).isNull();
+	}
+
+	/**
+	 * The walk starts at the owner's own pets, so a visit under a pet this owner does not
+	 * hold — another owner's pet included — is simply not found.
+	 */
+	@Test
+	void anOwnerShouldNotFindAVisitUnderAPetItDoesNotHold() {
+		Owner owner = anOwner();
+		aPetOf(owner, PET_ID, aVisit(BOOKED_VISIT_ID));
+
+		assertThat(owner.getVisit(UNHELD_PET_ID, BOOKED_VISIT_ID)).isNull();
+	}
+
+	@Test
+	void withdrawingAVisitShouldLeaveTheOtherPetsRecordAlone() {
+		Owner owner = anOwner();
+		Visit booked = aVisit(BOOKED_VISIT_ID);
+		Pet pet = aPetOf(owner, PET_ID, booked);
+		Visit otherPetsVisit = aVisit(OTHER_PETS_VISIT_ID);
+		Pet otherPet = aPetOf(owner, OTHER_PET_ID, otherPetsVisit);
+
+		owner.removeVisit(PET_ID, booked);
+
+		assertThat(pet.getVisits()).isEmpty();
+		assertThat(otherPet.getVisits()).containsExactly(otherPetsVisit);
+	}
+
+	@Test
+	void withdrawingAVisitUnderAPetTheOwnerDoesNotHoldShouldBeRejected() {
+		Owner owner = anOwner();
+		Visit booked = aVisit(BOOKED_VISIT_ID);
+		aPetOf(owner, PET_ID, booked);
+
+		assertThatIllegalArgumentException().isThrownBy(() -> owner.removeVisit(UNHELD_PET_ID, booked));
+	}
+
+	private static Owner anOwner() {
+		return new Owner();
+	}
+
+	/**
+	 * {@link Owner#addPet} takes a pet only while it is unsaved, so the identifier is
+	 * assigned once the pet has joined the owner.
+	 */
+	private static Pet aPetOf(Owner owner, int petId, Visit... visits) {
+		Pet pet = new Pet();
+		owner.addPet(pet);
+		pet.setId(petId);
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+	private static Visit aVisit(int visitId) {
+		Visit visit = new Visit();
+		visit.setDate(LocalDate.now().plusDays(1));
+		visit.setId(visitId);
+		return visit;
+	}
+
+}
