+/**
+ * Persistence-level test for the visit correction handled by {@link VisitController}.
+ * <p>
+ * {@link VisitControllerTests} drives the same handler with the repository replaced by a
+ * mock, so all it can observe is that no save was requested. That leaves the requirement
+ * "a refused correction leaves the stored visit unchanged" resting on mechanism no test
+ * exercises: {@code spring.jpa.open-in-view=false}, no {@code @Transactional} on the
+ * handler, and a save confined to the success path. This test books a visit against the
+ * running application, submits a correction the application must refuse, and re-reads the
+ * visit through the real repository. A change that left the owner graph managed across
+ * the request would flush the refused input to the database and fail here.
+ */
+@SpringBootTest(webEnvironment = RANDOM_PORT)
+@AutoConfigureTestRestTemplate
+class VisitControllerIntegrationTests {
+
+	/** Owner 1 of the seeded data owns pet 1, which starts out with no visits. */
+	private static final int TEST_OWNER_ID = 1;
+
+	private static final int TEST_PET_ID = 1;
+
+	private static final LocalDate BOOKED_VISIT_DATE = LocalDate.now().plusDays(3);
+
+	private static final String BOOKED_VISIT_DESCRIPTION = "Annual check-up";
+
+	/** Today is not in the future, so a correction carrying it must be refused. */
+	private static final LocalDate REFUSED_VISIT_DATE = LocalDate.now();
+
+	private static final String REFUSED_VISIT_DESCRIPTION = "Brought forward to today";
+
+	/**
+	 * Marks the field the redisplayed form reports in error; see fragments/inputField.
+	 */
+	private static final String FIELD_IN_ERROR_MARKER = "has-error";
+
+	@LocalServerPort
+	private int port;
+
+	@Autowired
+	private TestRestTemplate rest;
+
+	@Autowired
+	private OwnerRepository owners;
+
+	@Test
+	void theStoredVisitShouldBeUnchangedWhenTheCorrectionIsRefused() {
+		int visitId = bookAVisit();
+
+		ResponseEntity<String> response = submitCorrection(visitId, REFUSED_VISIT_DATE, REFUSED_VISIT_DESCRIPTION);
+
+		assertTheCorrectionWasRefused(response);
+
+		Visit storedVisit = readTheStoredVisit(visitId);
+		assertThat(storedVisit.getDate()).isEqualTo(BOOKED_VISIT_DATE);
+		assertThat(storedVisit.getDescription()).isEqualTo(BOOKED_VISIT_DESCRIPTION);
+	}
+
+	/**
+	 * Books the visit this test then tries to correct, through the application's own
+	 * booking form, so the row under test is one the application itself wrote.
+	 * @return the id the clinic recorded the booked visit under
+	 */
+	private int bookAVisit() {
+		submitVisitForm("/owners/{ownerId}/pets/{petId}/visits/new", BOOKED_VISIT_DATE, BOOKED_VISIT_DESCRIPTION,
+				TEST_OWNER_ID, TEST_PET_ID);
+
+		Collection<Visit> storedVisits = readTheStoredPet().getVisits();
+		assertThat(storedVisits).hasSize(1);
+		return storedVisits.iterator().next().getId();
+	}
+
+	/**
+	 * Asserts the application refused the correction and sent the user back to the form
+	 * to fix it. The status alone cannot say so, because the client follows the success
+	 * path's redirect and an accepted correction would answer 200 as well. The assertion
+	 * therefore reads the redisplayed form: a field marked in error, still carrying what
+	 * was submitted.
+	 */
+	private void assertTheCorrectionWasRefused(ResponseEntity<String> response) {
+		assertThat(response.getStatusCode().is2xxSuccessful()).isTrue();
+		assertThat(response.getBody()).contains(FIELD_IN_ERROR_MARKER).contains(REFUSED_VISIT_DESCRIPTION);
+	}
+
+	private ResponseEntity<String> submitCorrection(int visitId, LocalDate date, String description) {
+		return submitVisitForm("/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit", date, description, TEST_OWNER_ID,
+				TEST_PET_ID, visitId);
+	}
+
+	private ResponseEntity<String> submitVisitForm(String path, LocalDate date, String description,
+			Object... uriVariables) {
+		MultiValueMap<String, String> form = new LinkedMultiValueMap<>();
+		form.add("date", date.toString());
+		form.add("description", description);
+
+		HttpHeaders headers = new HttpHeaders();
+		headers.setContentType(MediaType.APPLICATION_FORM_URLENCODED);
+
+		return this.rest.postForEntity("http://localhost:" + this.port + path, new HttpEntity<>(form, headers),
+				String.class, uriVariables);
+	}
+
+	/**
+	 * Reads the visit back the way a later request would: a fresh repository lookup in
+	 * its own transaction, so what is asserted is the clinic's record of the visit and
+	 * not an instance the refused request left behind in memory.
+	 */
+	private Visit readTheStoredVisit(int visitId) {
+		Visit storedVisit = readTheStoredPet().getVisit(visitId);
+		assertThat(storedVisit).isNotNull();
+		return storedVisit;
+	}
+
+	private Pet readTheStoredPet() {
+		return this.owners.findById(TEST_OWNER_ID).orElseThrow().getPet(TEST_PET_ID);
+	}
+
+}
