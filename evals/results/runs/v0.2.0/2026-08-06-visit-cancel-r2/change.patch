@@ -173,4 +173,29 @@ public class Owner extends Person {
 		pet.addVisit(visit);
 	}
 
+	/**
+	 * Cancels the upcoming {@link Visit} with the given identifier on the {@link Pet}
+	 * with the given identifier, taking it off that pet's record for good.
+	 * <p>
+	 * The three refusals REQ-VIS-010 names share one outcome: the pet is not under this
+	 * owner, the visit is not on that pet, or the visit is no longer upcoming. Cancelling
+	 * the same visit twice is the second of those on the repeat attempt.
+	 * @param petId the identifier of the {@link Pet}, must not be {@literal null}.
+	 * @param visitId the identifier of the {@link Visit}, must not be {@literal null}.
+	 * @return whether a visit was cancelled
+	 */
+	public boolean cancelVisit(Integer petId, Integer visitId) {
+
+		Assert.notNull(petId, "Pet identifier must not be null!");
+		Assert.notNull(visitId, "Visit identifier must not be null!");
+
+		Pet pet = getPet(petId);
+
+		if (pet == null) {
+			return false;
+		}
+
+		return pet.getVisits().removeIf(visit -> Objects.equals(visit.getId(), visitId) && visit.isUpcoming());
+	}
+
 }
