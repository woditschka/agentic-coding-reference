+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Tests for {@link Visit}, in particular the upcoming rule of REQ-VIS-010: a visit dated
+ * today or later is upcoming.
+ */
+class VisitTests {
+
+	@Test
+	void theVisitDatedTodayShouldBeUpcoming() {
+		Visit visitToday = createAVisitDated(LocalDate.now());
+
+		assertThat(visitToday.isUpcoming()).isTrue();
+	}
+
+	@Test
+	void theVisitDatedAfterTodayShouldBeUpcoming() {
+		Visit visitTomorrow = createAVisitDated(LocalDate.now().plusDays(1));
+
+		assertThat(visitTomorrow.isUpcoming()).isTrue();
+	}
+
+	@Test
+	void theVisitDatedBeforeTodayShouldNotBeUpcoming() {
+		Visit visitYesterday = createAVisitDated(LocalDate.now().minusDays(1));
+
+		assertThat(visitYesterday.isUpcoming()).isFalse();
+	}
+
+	@Test
+	void theVisitWithoutADateShouldNotBeUpcoming() {
+		Visit visitWithoutDate = createAVisitDated(null);
+
+		assertThat(visitWithoutDate.isUpcoming()).isFalse();
+	}
+
+	/**
+	 * Only the date decides whether a visit is upcoming, so it is the one field the
+	 * caller supplies.
+	 */
+	private Visit createAVisitDated(LocalDate date) {
+		Visit visit = new Visit();
+		visit.setDate(date);
+		visit.setDescription("visit dated " + date);
+		return visit;
+	}
+
+}
