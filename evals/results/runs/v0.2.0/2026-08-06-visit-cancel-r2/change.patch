+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.BDDMockito.given;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.flash;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.redirectedUrl;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import java.time.LocalDate;
+import java.util.Locale;
+import java.util.Optional;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.MessageSource;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+/**
+ * Test class for {@link VisitCancellationController} (REQ-VIS-010).
+ */
+@WebMvcTest(VisitCancellationController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class VisitCancellationControllerTests {
+
+	private static final int TEST_OWNER_ID = 1;
+
+	private static final int MAX_ID = 1;
+
+	private static final int LUCKY_ID = 2;
+
+	private static final int UPCOMING_VISIT_ID = 10;
+
+	private static final int PAST_VISIT_ID = 11;
+
+	private static final int OTHER_PET_VISIT_ID = 12;
+
+	private static final int TODAY_VISIT_ID = 13;
+
+	private static final String CANCEL_URL = "/owners/{ownerId}/pets/{petId}/visits/{visitId}/cancel";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private MessageSource messages;
+
+	@MockitoBean
+	private OwnerRepository owners;
+
+	private Owner george;
+
+	@BeforeEach
+	void setup() {
+		this.george = createAnOwnerNamed("George", "Franklin");
+
+		addAPetTo(this.george, MAX_ID, "Max", createAVisit(UPCOMING_VISIT_ID, LocalDate.now().plusDays(1)),
+				createAVisit(PAST_VISIT_ID, LocalDate.now().minusDays(1)),
+				createAVisit(TODAY_VISIT_ID, LocalDate.now()));
+
+		addAPetTo(this.george, LUCKY_ID, "Lucky", createAVisit(OTHER_PET_VISIT_ID, LocalDate.now().plusDays(2)));
+
+		given(this.owners.findById(TEST_OWNER_ID)).willReturn(Optional.of(this.george));
+	}
+
+	private Owner createAnOwnerNamed(String firstName, String lastName) {
+		Owner owner = new Owner();
+		owner.setId(TEST_OWNER_ID);
+		owner.setFirstName(firstName);
+		owner.setLastName(lastName);
+		return owner;
+	}
+
+	/**
+	 * {@link Owner#addPet} accepts a pet only while it is still new, so the identifier is
+	 * assigned after the pet has joined the owner.
+	 */
+	private Pet addAPetTo(Owner owner, int id, String name, Visit... visits) {
+		Pet pet = new Pet();
+		pet.setName(name);
+		owner.addPet(pet);
+		pet.setId(id);
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+	private Visit createAVisit(int id, LocalDate date) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		visit.setDate(date);
+		visit.setDescription("visit " + id);
+		return visit;
+	}
+
+	private boolean petHoldsVisit(int petId, int visitId) {
+		return this.george.getPet(petId).getVisits().stream().anyMatch(visit -> visit.getId().equals(visitId));
+	}
+
+	private String message(String key) {
+		return this.messages.getMessage(key, null, Locale.ENGLISH);
+	}
+
+	@Test
+	void theVisitCancellationShouldTakeTheVisitOffThePetRecord() throws Exception {
+		this.mockMvc.perform(post(CANCEL_URL, TEST_OWNER_ID, MAX_ID, UPCOMING_VISIT_ID))
+			.andExpect(status().is3xxRedirection())
+			.andExpect(redirectedUrl("/owners/" + TEST_OWNER_ID))
+			.andExpect(flash().attribute("message", message("visitCancellationConfirmed")));
+
+		verify(this.owners).save(this.george);
+		assertThat(petHoldsVisit(MAX_ID, UPCOMING_VISIT_ID)).isFalse();
+	}
+
+	@Test
+	void theVisitDatedTodayShouldStillBeCancellable() throws Exception {
+		this.mockMvc.perform(post(CANCEL_URL, TEST_OWNER_ID, MAX_ID, TODAY_VISIT_ID))
+			.andExpect(status().is3xxRedirection())
+			.andExpect(redirectedUrl("/owners/" + TEST_OWNER_ID));
+
+		verify(this.owners).save(this.george);
+		assertThat(petHoldsVisit(MAX_ID, TODAY_VISIT_ID)).isFalse();
+	}
+
+	@Test
+	void theVisitCancellationShouldLeaveEveryOtherVisitUnchanged() throws Exception {
+		this.mockMvc.perform(post(CANCEL_URL, TEST_OWNER_ID, MAX_ID, UPCOMING_VISIT_ID))
+			.andExpect(status().is3xxRedirection());
+
+		assertThat(petHoldsVisit(MAX_ID, PAST_VISIT_ID)).isTrue();
+		assertThat(petHoldsVisit(MAX_ID, TODAY_VISIT_ID)).isTrue();
+		assertThat(petHoldsVisit(LUCKY_ID, OTHER_PET_VISIT_ID)).isTrue();
+	}
+
+	@Test
+	void theVisitCancellationShouldBeRefusedForAPastVisit() throws Exception {
+		this.mockMvc.perform(post(CANCEL_URL, TEST_OWNER_ID, MAX_ID, PAST_VISIT_ID))
+			.andExpect(status().is3xxRedirection())
+			.andExpect(redirectedUrl("/owners/" + TEST_OWNER_ID))
+			.andExpect(flash().attribute("error", message("visitCancellationRefused")));
+
+		verify(this.owners, never()).save(any(Owner.class));
+		assertThat(petHoldsVisit(MAX_ID, PAST_VISIT_ID)).isTrue();
+	}
+
+	@Test
+	void theVisitCancellationShouldBeRefusedWhenTheVisitIsNotOnThatPetRecord() throws Exception {
+		this.mockMvc.perform(post(CANCEL_URL, TEST_OWNER_ID, MAX_ID, OTHER_PET_VISIT_ID))
+			.andExpect(status().is3xxRedirection())
+			.andExpect(redirectedUrl("/owners/" + TEST_OWNER_ID))
+			.andExpect(flash().attribute("error", message("visitCancellationRefused")));
+
+		verify(this.owners, never()).save(any(Owner.class));
+		assertThat(petHoldsVisit(LUCKY_ID, OTHER_PET_VISIT_ID)).isTrue();
+	}
+
+	@Test
+	void theSecondVisitCancellationShouldBeRefused() throws Exception {
+		this.mockMvc.perform(post(CANCEL_URL, TEST_OWNER_ID, MAX_ID, UPCOMING_VISIT_ID))
+			.andExpect(flash().attributeCount(1));
+
+		this.mockMvc.perform(post(CANCEL_URL, TEST_OWNER_ID, MAX_ID, UPCOMING_VISIT_ID))
+			.andExpect(status().is3xxRedirection())
+			.andExpect(flash().attribute("error", message("visitCancellationRefused")));
+	}
+
+}
