+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Tests for {@link Owner} as the aggregate root deciding whether a visit may be cancelled
+ * (REQ-VIS-010).
+ */
+class OwnerTests {
+
+	private static final int MAX_ID = 1;
+
+	private static final int LUCKY_ID = 2;
+
+	private static final int UPCOMING_VISIT_ID = 10;
+
+	private static final int PAST_VISIT_ID = 11;
+
+	private static final int OTHER_PET_VISIT_ID = 12;
+
+	private Owner george;
+
+	private Visit upcomingVisit;
+
+	private Visit pastVisit;
+
+	private Visit otherPetVisit;
+
+	@BeforeEach
+	void setup() {
+		this.george = createAnOwnerNamed("George", "Franklin");
+
+		this.upcomingVisit = createAVisit(UPCOMING_VISIT_ID, LocalDate.now());
+		this.pastVisit = createAVisit(PAST_VISIT_ID, LocalDate.now().minusDays(1));
+		addAPetTo(this.george, MAX_ID, "Max", this.upcomingVisit, this.pastVisit);
+
+		this.otherPetVisit = createAVisit(OTHER_PET_VISIT_ID, LocalDate.now().plusDays(3));
+		addAPetTo(this.george, LUCKY_ID, "Lucky", this.otherPetVisit);
+	}
+
+	private Owner createAnOwnerNamed(String firstName, String lastName) {
+		Owner owner = new Owner();
+		owner.setFirstName(firstName);
+		owner.setLastName(lastName);
+		return owner;
+	}
+
+	/**
+	 * {@link Owner#addPet} accepts a pet only while it is still new, so the identifier is
+	 * assigned after the pet has joined the owner.
+	 */
+	private Pet addAPetTo(Owner owner, int id, String name, Visit... visits) {
+		Pet pet = new Pet();
+		pet.setName(name);
+		owner.addPet(pet);
+		pet.setId(id);
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+	private Visit createAVisit(int id, LocalDate date) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		visit.setDate(date);
+		visit.setDescription("visit " + id);
+		return visit;
+	}
+
+	@Test
+	void theUpcomingVisitShouldBeTakenOffThePetRecord() {
+		boolean cancelled = this.george.cancelVisit(MAX_ID, UPCOMING_VISIT_ID);
+
+		assertThat(cancelled).isTrue();
+		assertThat(this.george.getPet(MAX_ID).getVisits()).doesNotContain(this.upcomingVisit);
+	}
+
+	@Test
+	void theVisitCancellationShouldLeaveEveryOtherVisitUnchanged() {
+		this.george.cancelVisit(MAX_ID, UPCOMING_VISIT_ID);
+
+		assertThat(this.george.getPet(MAX_ID).getVisits()).containsExactly(this.pastVisit);
+		assertThat(this.george.getPet(LUCKY_ID).getVisits()).containsExactly(this.otherPetVisit);
+	}
+
+	@Test
+	void theVisitCancellationShouldBeRefusedForAPastVisit() {
+		boolean cancelled = this.george.cancelVisit(MAX_ID, PAST_VISIT_ID);
+
+		assertThat(cancelled).isFalse();
+		assertThat(this.george.getPet(MAX_ID).getVisits()).contains(this.pastVisit);
+	}
+
+	@Test
+	void theVisitCancellationShouldBeRefusedWhenTheVisitIsNotOnThatPetRecord() {
+		boolean cancelled = this.george.cancelVisit(MAX_ID, OTHER_PET_VISIT_ID);
+
+		assertThat(cancelled).isFalse();
