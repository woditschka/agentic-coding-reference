+package org.springframework.samples.petclinic.owner;
+
+import java.util.Locale;
+
+import org.springframework.context.MessageSource;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.servlet.mvc.support.RedirectAttributes;
+
+/**
+ * Accepts the cancel submission from the owner's record (REQ-VIS-010).
+ * <p>
+ * Cancellation is served by its own controller rather than by {@link VisitController},
+ * whose model-attribute method attaches a blank visit to the loaded pet before every
+ * handler in that class and would cascade-persist it on save.
+ * <p>
+ * Whether a given visit may be cancelled is decided by {@link Owner}; this handler binds
+ * the identifiers, delegates, and chooses which of the two flash slots the owner's record
+ * already renders to fill.
+ */
+@Controller
+class VisitCancellationController {
+
+	private static final String CANCELLATION_CONFIRMED = "visitCancellationConfirmed";
+
+	private static final String CANCELLATION_REFUSED = "visitCancellationRefused";
+
+	private final OwnerRepository owners;
+
+	private final MessageSource messages;
+
+	public VisitCancellationController(OwnerRepository owners, MessageSource messages) {
+		this.owners = owners;
+		this.messages = messages;
+	}
+
+	/**
+	 * A refusal redirects with an explanation rather than throwing: a stale page or a
+	 * double submission is a routine outcome here, not a fault.
+	 */
+	@PostMapping("/owners/{ownerId}/pets/{petId}/visits/{visitId}/cancel")
+	public String processVisitCancellation(@PathVariable("ownerId") int ownerId, @PathVariable("petId") int petId,
+			@PathVariable("visitId") int visitId, Locale locale, RedirectAttributes redirectAttributes) {
+
+		Owner owner = this.owners.findById(ownerId)
+			.orElseThrow(() -> new IllegalArgumentException(
+					"Owner not found with id: " + ownerId + ". Please ensure the ID is correct "));
+
+		if (owner.cancelVisit(petId, visitId)) {
+			this.owners.save(owner);
+			redirectAttributes.addFlashAttribute("message", message(CANCELLATION_CONFIRMED, locale));
+		}
+		else {
+			redirectAttributes.addFlashAttribute("error", message(CANCELLATION_REFUSED, locale));
+		}
+
+		return "redirect:/owners/{ownerId}";
+	}
+
+	private String message(String key, Locale locale) {
+		return this.messages.getMessage(key, null, locale);
+	}
+
+}
