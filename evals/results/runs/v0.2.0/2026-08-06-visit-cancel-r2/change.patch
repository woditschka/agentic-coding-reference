+	/**
+	 * REQ-VIS-010: cancelling an upcoming visit deletes its row rather than leaving it
+	 * behind with a null pet reference. Only a persistence-level assertion can tell the
+	 * two apart — an orphaned row disappears from the pet's record just as a deleted one
+	 * does.
+	 */
+	@Test
+	@Transactional
+	void shouldDeleteTheRowOfACancelledVisit() {
+		Optional<Owner> optionalOwner = this.owners.findById(6);
+		assertThat(optionalOwner).isPresent();
+		Owner owner6 = optionalOwner.get();
+		Pet pet7 = owner6.getPet(7);
+		int visitsBeforeBooking = pet7.getVisits().size();
+
+		Visit visit = createAVisitDescribedAs("wrong day");
+		owner6.addVisit(pet7.getId(), visit);
+		this.owners.saveAndFlush(owner6);
+		// saving merges the graph, so the persisted visit is read back off the pet rather
+		// than off the instance handed in
+		Integer cancelledVisitId = idOfVisitDescribedAs(pet7, "wrong day");
+		assertThat(cancelledVisitId).isNotNull();
+
+		boolean cancelled = owner6.cancelVisit(pet7.getId(), cancelledVisitId);
+		this.owners.saveAndFlush(owner6);
+		this.entityManager.clear();
+
+		assertThat(cancelled).isTrue();
+		assertThat(countVisitRows(cancelledVisitId)).isZero();
+		Pet reloadedPet7 = this.owners.findById(6).orElseThrow().getPet(7);
+		assertThat(reloadedPet7.getVisits()).hasSize(visitsBeforeBooking)
+			.noneMatch(remaining -> cancelledVisitId.equals(remaining.getId()));
+	}
+
+	/**
+	 * The description is the only field the caller supplies: {@link Visit} defaults its
+	 * date to tomorrow, which already makes the visit upcoming and so cancellable.
+	 */
+	private Visit createAVisitDescribedAs(String description) {
+		Visit visit = new Visit();
+		visit.setDescription(description);
+		return visit;
+	}
+
+	private Integer idOfVisitDescribedAs(Pet pet, String description) {
+		return pet.getVisits()
+			.stream()
+			.filter(visit -> description.equals(visit.getDescription()))
+			.findFirst()
+			.orElseThrow()
+			.getId();
+	}
+
+	private long countVisitRows(Integer visitId) {
+		Number count = (Number) this.entityManager.createNativeQuery("SELECT COUNT(*) FROM visits WHERE id = ?1")
+			.setParameter(1, visitId)
+			.getSingleResult();
+		return count.longValue();
+	}
