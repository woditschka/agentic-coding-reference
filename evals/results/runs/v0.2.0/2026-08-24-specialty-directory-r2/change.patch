+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for the {@link SpecialtyDirectory} read model.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final AtomicInteger NEXT_ID = new AtomicInteger(1);
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(NEXT_ID.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(NEXT_ID.getAndIncrement());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(specialties).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		Specialty radiology = createASpecialty("radiology");
+		Specialty surgery = createASpecialty("surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of());
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::name)
+			.containsExactly("radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHolderByFullName() {
+		Specialty radiology = createASpecialty("radiology");
+		Vet helen = createAVet("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory.entries())
+			.containsExactly(new SpecialtyDirectory.Entry("radiology", List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty("radiology");
+		Vet helen = createAVet("Helen", "Leary", radiology);
+		Vet jamesWhoHoldsNothing = createAVet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, jamesWhoHoldsNothing));
+
+		assertThat(directory.entries()).flatExtracting(SpecialtyDirectory.Entry::holders)
+			.containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty dentistry = createASpecialty("dentistry");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry), List.of());
+
+		assertThat(directory.entries()).containsExactly(new SpecialtyDirectory.Entry("dentistry", List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOpenWithAnEmptyListWhenNoSpecialtiesExist() {
+		Vet jamesWhoHoldsNothing = createAVet("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(jamesWhoHoldsNothing));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderItsEntriesStably() {
+		Specialty surgery = createASpecialty("surgery");
+		Specialty dentistry = createASpecialty("dentistry");
+		Specialty radiology = createASpecialty("radiology");
+		Vet rafael = createAVet("Rafael", "Ortega", surgery);
+		Vet linda = createAVet("Linda", "Douglas", surgery, dentistry);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology),
+				List.of(rafael, linda));
+
+		assertThat(directory.entries()).containsExactly(
+				new SpecialtyDirectory.Entry("dentistry", List.of("Linda Douglas")),
+				new SpecialtyDirectory.Entry("radiology", List.of()),
+				new SpecialtyDirectory.Entry("surgery", List.of("Linda Douglas", "Rafael Ortega")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotChangeWhenItsSourceCollectionsDo() {
+		Specialty radiology = createASpecialty("radiology");
+		List<Specialty> specialties = new ArrayList<>(List.of(radiology));
+		List<Vet> vets = new ArrayList<>(List.of(createAVet("Helen", "Leary", radiology)));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, vets);
+		specialties.add(createASpecialty("surgery"));
+		vets.add(createAVet("Henry", "Stevens", radiology));
+
+		assertThat(directory.entries())
+			.containsExactly(new SpecialtyDirectory.Entry("radiology", List.of("Helen Leary")));
+	}
+
+}
