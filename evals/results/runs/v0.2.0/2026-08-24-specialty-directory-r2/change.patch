+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Read model for the specialty directory page: every {@link Specialty} the clinic knows,
+ * each with the full names of the {@link Vet}s holding it.
+ * <p>
+ * The {@code Vet}–{@code Specialty} association is mapped on {@code Vet} alone, so this
+ * model inverts it in memory rather than through a second mapping. It holds no entity
+ * reference, which keeps rendering safe while {@code spring.jpa.open-in-view} is
+ * disabled. Ordering and name formatting live here rather than in the template.
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	/** Specialties are listed by name; the id breaks ties between equal names. */
+	private static final Comparator<Specialty> BY_SPECIALTY_NAME = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	/**
+	 * Holders are listed by last name, then first name, with the id as final tiebreak.
+	 */
+	private static final Comparator<Vet> BY_HOLDER_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * One directory line: a specialty under its stored name, and the holders' full names.
+	 * A specialty no veterinarian holds carries an empty holder list.
+	 */
+	public record Entry(String name, List<String> holders) {
+
+		public Entry {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+	/**
+	 * Build the directory from a specialty collection and a veterinarian collection.
+	 * @param specialties every specialty the clinic knows
+	 * @param vets every veterinarian; those holding no specialty contribute no line
+	 * @return the directory, ordered and formatted for display
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(vets);
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_SPECIALTY_NAME)
+			.map(specialty -> new Entry(specialty.getName(),
+					fullNames(holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of()))))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> vets) {
+		Map<Integer, List<Vet>> holders = new HashMap<>();
+		for (Vet vet : vets) {
+			for (Specialty held : vet.getSpecialties()) {
+				holders.computeIfAbsent(held.getId(), id -> new ArrayList<>()).add(vet);
+			}
+		}
+		return holders;
+	}
+
+	private static List<String> fullNames(List<Vet> holders) {
+		return holders.stream()
+			.sorted(BY_HOLDER_NAME)
+			.map(vet -> vet.getFirstName() + " " + vet.getLastName())
+			.toList();
+	}
+
+}
