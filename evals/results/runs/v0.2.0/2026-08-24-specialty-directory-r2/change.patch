+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import java.util.Locale;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.context.MessageSource;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Test class for the {@link SpecialtyController}, driven against the seeded database and
+ * the real templates so the rendered page itself is under test.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+class SpecialtyControllerTests {
+
+	private static final String UNHELD_SPECIALTY_NAME = "oncology";
+
+	private static final Locale READER_LOCALE = Locale.ENGLISH;
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private SpecialtyRepository specialties;
+
+	@Autowired
+	private MessageSource messages;
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private String renderSpecialtyDirectory() throws Exception {
+		return mockMvc.perform(get("/specialties.html").locale(READER_LOCALE))
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+	}
+
+	/**
+	 * The text a reader sees on the page: markup stripped, whitespace collapsed.
+	 * Assertions on wording belong against this rather than against the template's
+	 * markup, which may change (attributes, tag choice, indentation) without any change
+	 * in what is shown.
+	 */
+	private String readerTextOf(String page) {
+		return page.replaceAll("(?s)<[^>]*>", " ").replaceAll("\\s+", " ").trim();
+	}
+
+	/**
+	 * The wording the page shows for a specialty whose holder list is empty, resolved
+	 * from the message bundle the application itself renders with.
+	 */
+	private String heldByNoOneText() {
+		return this.messages.getMessage("none", null, READER_LOCALE);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEverySpecialtyOnOnePage() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attributeExists("specialtyDirectory"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySeededSpecialtyWithItsHolders() throws Exception {
+		String page = renderSpecialtyDirectory();
+
+		assertThat(page).contains("dentistry", "radiology", "surgery")
+			.contains("Linda Douglas", "Helen Leary", "Henry Stevens", "Rafael Ortega");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() throws Exception {
+		String page = renderSpecialtyDirectory();
+
+		assertThat(page).doesNotContain("Sharon Jenkins").doesNotContain("James Carter");
+	}
+
+	@Test
+	@Transactional
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() throws Exception {
+		this.specialties.saveAndFlush(createASpecialty(UNHELD_SPECIALTY_NAME));
+
+		String page = renderSpecialtyDirectory();
+
+		assertThat(readerTextOf(page)).contains(UNHELD_SPECIALTY_NAME + " " + heldByNoOneText());
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryNoNavigationEntryOfItsOwn() throws Exception {
+		String page = renderSpecialtyDirectory();
+
+		assertThat(page).doesNotContain("/specialties.html\"");
+	}
+
+}
