+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+
+/**
+ * Repository class for <code>Specialty</code> domain objects.
+ * <p>
+ * Deliberately uncached: the veterinarian read it is combined with is already cached, and
+ * a second cache would widen the eviction question that cache leaves open.
+ */
+public interface SpecialtyRepository extends JpaRepository<Specialty, Integer> {
+
+	/**
+	 * Retrieve all {@link Specialty}s from the data store.
+	 * @return a List of {@link Specialty}s, ordered by name.
+	 */
+	@Query("SELECT specialty FROM Specialty specialty ORDER BY specialty.name")
+	List<Specialty> findSpecialties();
+
+}
