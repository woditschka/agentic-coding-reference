+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.Repository;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Repository class for <code>Specialty</code> domain objects.
+ * <p>
+ * A specialty no veterinarian holds is unreachable through {@link Vet}, which owns the
+ * only side of the association, so the specialty directory reads the specialties here
+ * rather than collecting them from the veterinarians.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve all <code>Specialty</code>s from the data store, name order first.
+	 * <p>
+	 * The read is deliberately uncached: {@link VetRepository} caches its no-argument
+	 * <code>findAll</code> under <code>vets</code>, and a second no-argument method in
+	 * that cache would share the key and serve veterinarians in answer to this query.
+	 * @return a <code>List</code> of <code>Specialty</code>s ordered by name, including
+	 * those no veterinarian holds
+	 */
+	@Transactional(readOnly = true)
+	@Query("SELECT specialty FROM Specialty specialty ORDER BY specialty.name")
+	List<Specialty> findAll();
+
+}
