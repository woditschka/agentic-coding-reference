+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * One specialty paired with the veterinarians holding it.
+ * <p>
+ * {@link Vet} holds the association to {@link Specialty} and nothing points back, so a
+ * specialty no veterinarian holds is unreachable from the veterinarian side. This value
+ * type inverts the association: it is driven from the specialty list, so every specialty
+ * is listed and a veterinarian holding none appears in no entry.
+ */
+public record SpecialtyDirectoryEntry(Specialty specialty, List<Vet> vets) {
+
+	/**
+	 * Veterinarians are read as an unordered collection, so the entry fixes their order
+	 * itself: last name, then first name, then the identity the store assigned, which
+	 * keeps two veterinarians of the same name in a repeatable order.
+	 */
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.<Vet, String>comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId, Comparator.nullsLast(Comparator.<Integer>naturalOrder()));
+
+	public SpecialtyDirectoryEntry {
+		vets = List.copyOf(vets);
+	}
+
+	/**
+	 * Pair each of the given specialties with the veterinarians holding it.
+	 * @param specialties the specialties to list, in the order they should be listed
+	 * @param vets the veterinarians to distribute over those specialties
+	 * @return one entry per given specialty, in the given order
+	 */
+	public static List<SpecialtyDirectoryEntry> directory(List<Specialty> specialties, Collection<Vet> vets) {
+		return specialties.stream()
+			.map(specialty -> new SpecialtyDirectoryEntry(specialty, holdersOf(specialty, vets)))
+			.toList();
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream().filter(vet -> holds(vet, specialty)).sorted(HOLDER_ORDER).toList();
+	}
+
+	/**
+	 * The veterinarians are read through a cache and the specialties are not, so the two
+	 * sides need not be the same instances: the association is matched on the identity
+	 * the store assigned, never on object identity. A specialty the store has not saved
+	 * holds no identity and therefore no veterinarians.
+	 */
+	private static boolean holds(Vet vet, Specialty specialty) {
+		Integer specialtyId = specialty.getId();
+		return specialtyId != null && vet.getSpecialties().stream().anyMatch(held -> specialtyId.equals(held.getId()));
+	}
+
+}
