+		Vet jamesCarter = createAVet("James", "Carter", radiology);
+		Vet almaCarter = createAVet("Alma", "Carter", radiology);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directory(List.of(radiology),
+				List.of(helenLeary, jamesCarter, almaCarter));
