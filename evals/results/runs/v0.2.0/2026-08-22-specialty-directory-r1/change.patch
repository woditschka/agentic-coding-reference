+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directory(List.of(unsavedRadiology),
+				List.of(holderOfAnotherUnsavedSpecialty));
+
+		assertThat(entryFor(directory, RADIOLOGY).vets()).isEmpty();
+	}
+
+}
