+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Test class for {@link SpecialtyDirectoryEntry}, the projection that inverts the
+ * one-directional veterinarian-to-specialty association.
+ */
+class SpecialtyDirectoryEntryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String SOME_FIRST_NAME = "Helen";
+
+	private static final String SOME_LAST_NAME = "Leary";
+
+	private int nextId = 1;
+
+	private Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId++);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Specialty createAnUnsavedSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createAVet(String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId++);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		List.of(held).forEach(vet::addSpecialty);
+		return vet;
+	}
+
+	private static SpecialtyDirectoryEntry entryFor(List<SpecialtyDirectoryEntry> directory, String specialtyName) {
+		return directory.stream()
+			.filter(entry -> specialtyName.equals(entry.specialty().getName()))
+			.findFirst()
+			.orElseThrow(() -> new AssertionError("the directory carries no entry for " + specialtyName));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		Specialty radiology = createASpecialty(RADIOLOGY);
+		Specialty surgery = createASpecialty(SURGERY);
+
+		List<SpecialtyDirectoryEntry> directory = SpecialtyDirectoryEntry.directory(List.of(radiology, surgery),
