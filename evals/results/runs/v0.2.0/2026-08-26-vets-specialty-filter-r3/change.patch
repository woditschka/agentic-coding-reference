+	 * none holds the specialty
+	 */
+	@Transactional(readOnly = true)
+	Collection<Vet> findDistinctBySpecialtiesNameIgnoreCase(String name) throws DataAccessException;
+
+	/**
+	 * Retrieve in Pages the <code>Vet</code>s holding the named specialty. Matching is as
+	 * in {@link #findDistinctBySpecialtiesNameIgnoreCase(String)}, and the page counts
