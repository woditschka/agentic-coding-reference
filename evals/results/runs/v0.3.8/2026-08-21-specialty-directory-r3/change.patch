+
+package org.springframework.samples.petclinic.vet;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.annotation.Bean;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}.
+ * <p>
+ * The clinic behind the page stores three specialties, one of which no veterinarian
+ * holds, and employs three veterinarians, one of whom holds no specialty.
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SPECIALTY_NOBODY_HOLDS = "surgery";
+
+	private static final String TEMPLATE_DIRECTORY = "src/main/resources/templates";
+
+	private static final String DIRECTORY_ADDRESS = "/specialties.html";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyWithTheVeterinariansHoldingIt() throws Exception {
+		String page = openTheDirectory();
+
+		assertThat(page).containsSubsequence(cellHolding(DENTISTRY), cellHolding(RADIOLOGY),
+				cellHolding(SPECIALTY_NOBODY_HOLDS));
+		assertThat(rowFor(page, RADIOLOGY)).contains("Helen Leary", "Linda Douglas");
+		assertThat(rowFor(page, DENTISTRY)).contains("Linda Douglas");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachVeterinarianInFull() throws Exception {
+		String page = openTheDirectory();
+
+		assertThat(rowFor(page, RADIOLOGY)).contains("Helen Leary").doesNotContain("Leary Helen");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() throws Exception {
+		String page = openTheDirectory();
+
+		assertThat(page).doesNotContain("Carter");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() throws Exception {
+		String page = openTheDirectory();
+
+		assertThat(rowFor(page, SPECIALTY_NOBODY_HOLDS)).doesNotContain("Leary", "Douglas", "Carter");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEverySpecialtyOnOnePage() throws Exception {
+		MvcResult result = this.mockMvc.perform(get(DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attributeExists("directory"))
+			.andExpect(model().attributeDoesNotExist("currentPage", "totalPages", "totalItems"))
+			.andReturn();
+
+		assertThat(result.getResponse().getContentAsString()).doesNotContain("?page=");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheSameNavigationAsEveryOtherPage() throws Exception {
+		String page = openTheDirectory();
+
+		assertThat(page).contains("/vets.html", "/owners/find");
+		assertThat(page).doesNotContain("nav-link active");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotBeLinkedFromAnyOtherPage() throws Exception {
+		try (Stream<Path> templates = Files.walk(Path.of(TEMPLATE_DIRECTORY))) {
+			List<Path> linkingTemplates = templates.filter(template -> template.toString().endsWith(".html"))
+				.filter(SpecialtyControllerTests::linksToTheDirectory)
+				.toList();
+
+			assertThat(linkingTemplates).isEmpty();
+		}
+	}
+
+	private String openTheDirectory() throws Exception {
+		return this.mockMvc.perform(get(DIRECTORY_ADDRESS))
+			.andExpect(status().isOk())
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+	}
+
+	private static boolean linksToTheDirectory(Path template) {
+		try {
+			return Files.readString(template).contains(DIRECTORY_ADDRESS);
+		}
+		catch (Exception ex) {
+			throw new AssertionError("cannot read template " + template, ex);
+		}
+	}
+
+	private static String cellHolding(String text) {
+		return ">" + text + "<";
+	}
+
+	/**
+	 * The rendered table row naming the given specialty, so that an assertion can tell
+	 * who is named <em>under</em> it rather than merely somewhere on the page.
+	 */
+	private static String rowFor(String page, String specialtyName) {
+		return Arrays.stream(page.split("<tr"))
+			.filter(row -> row.contains(cellHolding(specialtyName)))
+			.findFirst()
+			.orElseThrow(() -> new AssertionError("the page names no specialty " + specialtyName));
+	}
+
+	@TestConfiguration
+	static class ClinicStubs {
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return new StoredSpecialties(List.of(radiology(), dentistry(), specialtyNobodyHolds()));
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new EmployedVeterinarians(List.of(helenLeary(), lindaDouglas(), veterinarianHoldingNoSpecialty()));
+		}
+
+		private static Specialty radiology() {
+			return specialty(1, RADIOLOGY);
+		}
+
+		private static Specialty dentistry() {
+			return specialty(2, DENTISTRY);
+		}
+
+		private static Specialty specialtyNobodyHolds() {
+			return specialty(3, SPECIALTY_NOBODY_HOLDS);
+		}
+
+		private static Specialty specialty(int id, String name) {
+			Specialty specialty = new Specialty();
+			specialty.setId(id);
+			specialty.setName(name);
+			return specialty;
+		}
+
+		private static Vet helenLeary() {
+			return vet(1, "Helen", "Leary", radiology());
+		}
+
+		private static Vet lindaDouglas() {
+			return vet(2, "Linda", "Douglas", radiology(), dentistry());
+		}
+
+		private static Vet veterinarianHoldingNoSpecialty() {
+			return vet(3, "James", "Carter");
+		}
+
+		private static Vet vet(int id, String firstName, String lastName, Specialty... specialties) {
+			Vet vet = new Vet();
+			vet.setId(id);
+			vet.setFirstName(firstName);
+			vet.setLastName(lastName);
+			for (Specialty specialty : specialties) {
+				vet.addSpecialty(specialty);
+			}
+			return vet;
+		}
+
+	}
+
+	/**
+	 * Stands in for the specialties table, honouring the repository's contract of
+	 * returning every stored specialty in name order.
+	 */
+	private static final class StoredSpecialties implements SpecialtyRepository {
+
+		private final List<Specialty> stored;
+
+		private StoredSpecialties(List<Specialty> stored) {
+			this.stored = List.copyOf(stored);
+		}
+
+		@Override
+		public List<Specialty> findSpecialties() {
+			return this.stored.stream().sorted(Comparator.comparing(NamedEntity::getName)).toList();
+		}
+
+	}
+
+	/**
+	 * Stands in for the vets table. The specialty directory never pages, so the paged
+	 * query is left unsupported.
+	 */
+	private static final class EmployedVeterinarians implements VetRepository {
+
+		private final List<Vet> employed;
+
+		private EmployedVeterinarians(List<Vet> employed) {
+			this.employed = List.copyOf(employed);
+		}
+
+		@Override
+		public Collection<Vet> findAll() {
+			return this.employed;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("the specialty directory does not page over veterinarians");
+		}
+
+	}
+
+}
