+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+
+/**
+ * Immutable read model pairing every specialty the clinic stores with the veterinarians
+ * holding it. Assembled per request from the stored specialties and the veterinarian
+ * collection; it is not persisted and holds no state of its own beyond the pairing.
+ * <p>
+ * The listing is driven by the specialties, not by the veterinarians: a specialty nobody
+ * holds is present with an empty list of veterinarians, and a veterinarian holding no
+ * specialty appears in no entry.
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Specialty> BY_STORED_NAME = Comparator.comparing(NamedEntity::getName);
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName);
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it.
+	 */
+	public record Entry(Specialty specialty, List<Vet> veterinarians) {
+
+		public Entry {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+	/**
+	 * Join the stored specialties with the veterinarians holding them.
+	 * @param specialties every specialty the clinic stores
+	 * @param veterinarians the veterinarians to name under them
+	 * @return a directory ordered by stored specialty name, each specialty's
+	 * veterinarians ordered by last name then first name
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		List<Vet> sortedVeterinarians = veterinarians.stream().sorted(BY_LAST_THEN_FIRST_NAME).toList();
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_STORED_NAME)
+			.map(specialty -> new Entry(specialty, holdersOf(specialty, sortedVeterinarians)))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, List<Vet> veterinarians) {
+		return veterinarians.stream().filter(veterinarian -> holds(veterinarian, specialty)).toList();
+	}
+
+	/**
+	 * Matching is by identifier: the persisted types define no value equality, and a
+	 * veterinarian's specialty instances need not be the instances the specialty query
+	 * returned. A specialty without an identifier is not stored, so nobody holds it.
+	 */
+	private static boolean holds(Vet veterinarian, Specialty specialty) {
+		Integer specialtyId = specialty.getId();
+		if (specialtyId == null) {
+			return false;
+		}
+		return veterinarian.getSpecialties().stream().anyMatch(held -> specialtyId.equals(held.getId()));
+	}
+
+}
