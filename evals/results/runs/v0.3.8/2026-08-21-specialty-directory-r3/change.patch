+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatExceptionOfType;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the read model behind the specialty
+ * directory page.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private final AtomicInteger nextId = new AtomicInteger(1);
+
+	@Test
+	void theSpecialtyDirectoryShouldListEveryStoredSpecialtyUnderItsStoredName() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Specialty surgery = aSpecialtyNamed(SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery),
+				List.of(aVetNamed("Helen", "Leary", radiology)));
+
+		assertThat(specialtyNames(directory)).containsExactly(RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEveryVeterinarianHoldingASpecialtyUnderIt() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Vet helen = aVetNamed("Helen", "Leary", radiology);
+		Vet rafael = aVetNamed("Rafael", "Ortega", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen, rafael));
+
+		assertThat(veterinarianNamesUnder(directory, RADIOLOGY)).containsExactly("Helen Leary", "Rafael Ortega");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Vet holdingNothing = aVetNamed("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(holdingNothing, aVetNamed("Helen", "Leary", radiology)));
+
+		assertThat(veterinarianNamesUnder(directory, RADIOLOGY)).containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHoldsWithNobodyUnderIt() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Specialty heldByNobody = aSpecialtyNamed(SURGERY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, heldByNobody),
+				List.of(aVetNamed("Helen", "Leary", radiology)));
+
+		assertThat(specialtyNames(directory)).contains(SURGERY);
+		assertThat(veterinarianNamesUnder(directory, SURGERY)).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameAVeterinarianUnderEverySpecialtyTheyHold() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Specialty surgery = aSpecialtyNamed(SURGERY);
+		Vet holdingBoth = aVetNamed("Linda", "Douglas", radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(holdingBoth));
+
+		assertThat(veterinarianNamesUnder(directory, RADIOLOGY)).containsExactly("Linda Douglas");
+		assertThat(veterinarianNamesUnder(directory, SURGERY)).containsExactly("Linda Douglas");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeEmptyWhenTheClinicKnowsNoSpecialty() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(aVetNamed("James", "Carter")));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesByStoredName() {
+		Specialty surgery = aSpecialtyNamed(SURGERY);
+		Specialty dentistry = aSpecialtyNamed(DENTISTRY);
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology), List.of());
+
+		assertThat(specialtyNames(directory)).containsExactly(DENTISTRY, RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansByLastNameThenFirstName() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		Vet lindaDouglas = aVetNamed("Linda", "Douglas", radiology);
+		Vet annaDouglas = aVetNamed("Anna", "Douglas", radiology);
+		Vet jamesCarter = aVetNamed("James", "Carter", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(lindaDouglas, annaDouglas, jamesCarter));
+
+		assertThat(veterinarianNamesUnder(directory, RADIOLOGY)).containsExactly("James Carter", "Anna Douglas",
+				"Linda Douglas");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchSpecialtiesByIdentifierRatherThanObjectIdentity() {
+		Specialty storedRadiology = aSpecialtyNamed(RADIOLOGY);
+		Specialty sameRadiologyLoadedSeparately = aSeparatelyLoadedCopyOf(storedRadiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(storedRadiology),
+				List.of(aVetNamed("Helen", "Leary", sameRadiologyLoadedSeparately)));
+
+		assertThat(veterinarianNamesUnder(directory, RADIOLOGY)).containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotBeChangeableThroughTheListsItReturns() {
+		Specialty radiology = aSpecialtyNamed(RADIOLOGY);
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(aVetNamed("Helen", "Leary", radiology)));
+
+		assertThatExceptionOfType(UnsupportedOperationException.class).isThrownBy(() -> directory.entries().clear());
+		assertThatExceptionOfType(UnsupportedOperationException.class)
+			.isThrownBy(() -> directory.entries().get(0).veterinarians().clear());
+	}
+
+	private Specialty aSpecialtyNamed(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(this.nextId.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	/**
+	 * A distinct instance carrying the same identifier, as the cached vet collection and
+	 * a fresh specialty query produce for one and the same stored specialty.
+	 */
+	private Specialty aSeparatelyLoadedCopyOf(Specialty specialty) {
+		Specialty copy = new Specialty();
+		copy.setId(specialty.getId());
+		copy.setName(specialty.getName());
+		return copy;
+	}
+
+	private Vet aVetNamed(String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(this.nextId.getAndIncrement());
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	private List<String> specialtyNames(SpecialtyDirectory directory) {
+		return directory.entries().stream().map(entry -> entry.specialty().getName()).toList();
+	}
+
+	private List<String> veterinarianNamesUnder(SpecialtyDirectory directory, String specialtyName) {
+		return entryFor(directory, specialtyName).veterinarians()
+			.stream()
+			.map(vet -> vet.getFirstName() + " " + vet.getLastName())
+			.toList();
+	}
+
+	private SpecialtyDirectory.Entry entryFor(SpecialtyDirectory directory, String specialtyName) {
+		return directory.entries()
+			.stream()
+			.filter(entry -> specialtyName.equals(entry.specialty().getName()))
+			.findFirst()
+			.orElseThrow(() -> new AssertionError("no directory entry for specialty " + specialtyName));
+	}
+
+}
