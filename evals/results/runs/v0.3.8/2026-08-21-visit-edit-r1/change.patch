+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+
+import java.time.LocalDate;
+
+/**
+ * Test class for {@link Pet}
+ */
+@DisabledInNativeImage
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 2;
+
+	private static final String BOOKED_VISIT_DESCRIPTION = "Rabies booster";
+
+	private static final LocalDate BOOKED_VISIT_DATE = LocalDate.now().plusDays(3);
+
+	@Test
+	void theBookedVisitShouldBeFoundByItsId() {
+		Pet pet = new Pet();
+		Visit bookedVisit = bookedVisit();
+		pet.addVisit(bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void anIdHeldByNoVisitOfThePetShouldFindNothing() {
+		Pet pet = new Pet();
+		pet.addVisit(bookedVisit());
+		int visitIdOfAnotherPet = BOOKED_VISIT_ID + 1;
+
+		assertThat(pet.getVisit(visitIdOfAnotherPet)).isNull();
+	}
+
+	@Test
+	void aVisitNotYetSavedShouldBeSkippedEvenWhenItsIdWouldMatch() {
+		Pet pet = new Pet();
+		// a visit being booked carries no id yet, so a null-id lookup would match it were
+		// unsaved visits not skipped
+		pet.addVisit(new Visit());
+		pet.addVisit(bookedVisit());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	private static Visit bookedVisit() {
+		Visit visit = new Visit();
+		visit.setId(BOOKED_VISIT_ID);
+		visit.setDate(BOOKED_VISIT_DATE);
+		visit.setDescription(BOOKED_VISIT_DESCRIPTION);
+		return visit;
+	}
+
+}
