+package org.springframework.samples.petclinic.vet;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.regex.Pattern;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.fail;
+
+/**
+ * The specialty directory is reachable by typing its URL and by nothing else: no page of
+ * the clinic offers a way to navigate to it. This test guards that absence, which no
+ * request against the page itself can observe.
+ */
+class SpecialtyDirectoryLinkAbsenceTests {
+
+	private static final Path TEMPLATE_ROOT = Path.of("src/main/resources/templates");
+
+	/**
+	 * Matches any mention of the specialty directory's route. The pattern deliberately
+	 * looks wider than {@code href}/{@code th:href}: navigation entries in this
+	 * application pass their target to the {@code menuItem} fragment as an argument
+	 * rather than writing an anchor, so a nav link would carry the route outside any
+	 * attribute an href-shaped pattern would see.
+	 */
+	private static final Pattern SPECIALTY_DIRECTORY_ROUTE = Pattern.compile("specialties\\.html");
+
+	@Test
+	void theSpecialtyDirectoryShouldBeLinkedFromNoPage() throws Exception {
+		List<Path> templates;
+		try (Stream<Path> stream = Files.walk(TEMPLATE_ROOT)) {
+			templates = stream.filter(path -> path.toString().endsWith(".html")).toList();
+		}
+
+		StringBuilder report = new StringBuilder();
+
+		for (Path template : templates) {
+			List<String> lines = Files.readAllLines(template);
+			for (int i = 0; i < lines.size(); i++) {
+				if (SPECIALTY_DIRECTORY_ROUTE.matcher(lines.get(i)).find()) {
+					report.append(template)
+						.append(" line ")
+						.append(i + 1)
+						.append(": ")
+						.append(lines.get(i).trim())
+						.append("\n");
+				}
+			}
+		}
+
+		if (!report.isEmpty()) {
+			fail("The specialty directory is meant to be unlinked, but templates point at it:\n" + report);
+		}
+	}
+
+}
