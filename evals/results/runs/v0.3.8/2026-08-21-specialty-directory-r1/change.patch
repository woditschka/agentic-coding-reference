+package org.springframework.samples.petclinic.vet;
+
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.GetMapping;
+
+/**
+ * Serves the specialty directory: every specialty the clinic knows, each with the
+ * veterinarians holding it. The association is mapped on {@link Vet} only, so the inverse
+ * view is assembled here rather than navigated - see
+ * docs/adr/2026-08-21-unidirectional-vet-specialty-association.md.
+ */
+@Controller
+class SpecialtyController {
+
+	private static final Comparator<Vet> BY_LAST_NAME_THEN_FIRST_NAME_THEN_ID = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	private final SpecialtyRepository specialtyRepository;
+
+	private final VetRepository vetRepository;
+
+	public SpecialtyController(SpecialtyRepository specialtyRepository, VetRepository vetRepository) {
+		this.specialtyRepository = specialtyRepository;
+		this.vetRepository = vetRepository;
+	}
+
+	@GetMapping("/specialties.html")
+	public String showSpecialtyList(Model model) {
+		List<Specialty> specialties = this.specialtyRepository.findSpecialties();
+		List<Vet> vets = this.vetRepository.findAll().stream().sorted(BY_LAST_NAME_THEN_FIRST_NAME_THEN_ID).toList();
+		model.addAttribute("vetsBySpecialty", groupHoldersBySpecialty(specialties, vets));
+		return "vets/specialtyList";
+	}
+
+	/**
+	 * Maps each specialty to the veterinarians holding it, preserving the order of both
+	 * arguments. A specialty no veterinarian holds maps to an empty list rather than
+	 * being left out.
+	 */
+	private Map<Specialty, List<Vet>> groupHoldersBySpecialty(List<Specialty> specialties, List<Vet> vets) {
+		Map<Specialty, List<Vet>> holdersBySpecialty = new LinkedHashMap<>();
+		for (Specialty specialty : specialties) {
+			holdersBySpecialty.put(specialty, vets.stream().filter(vet -> holds(vet, specialty)).toList());
+		}
+		return holdersBySpecialty;
+	}
+
+	/**
+	 * Compares by identity rather than by instance: the veterinarians and the specialties
+	 * are read through two repositories, so the same specialty arrives as two objects.
+	 */
+	private boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+}
