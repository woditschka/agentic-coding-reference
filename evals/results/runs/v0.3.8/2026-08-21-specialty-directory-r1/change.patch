+			.andExpect(content().string(containsString("dentistry")))
+			.andExpect(content().string(containsString("radiology")))
+			.andExpect(content().string(containsString("surgery")))
+			.andExpect(content().string(not(containsString("page="))))
+			.andExpect(model().attributeDoesNotExist("totalPages"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOfferNoWayToChangeASpecialtyOrAVeterinarian() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString("<form"))))
+			.andExpect(content().string(not(containsString("<input"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListTheHoldersOfASpecialtyByLastNameThenFirstName() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(content().string(stringContainsInOrder("radiology", "Linda Douglas", "Helen Leary", "surgery",
+					"Linda Douglas", "Alan Jenkins", "Carla Jenkins")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderWhenTheClinicKnowsNoSpecialty() throws Exception {
+		given(this.specialties.findSpecialties()).willReturn(List.of());
+		given(this.vets.findAll()).willReturn(List.of());
+
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(content().string(containsString("id=\"specialties\"")))
+			.andExpect(content().string(not(containsString("<td"))));
+	}
+
+}
