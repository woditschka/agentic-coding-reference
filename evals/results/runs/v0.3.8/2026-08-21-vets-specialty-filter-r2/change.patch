+			.andExpect(status().isOk())
+			.andExpect(model().attribute("totalPages", 3))
+			.andExpect(content().string(aPaginationLinkTo(narrowedFirstPage, "fa-fast-backward")))
+			.andExpect(content().string(aPaginationLinkTo(narrowedFirstPage, "fa-step-backward")));
