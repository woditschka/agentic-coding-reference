+package org.springframework.samples.petclinic.vet;
+
+import java.util.Optional;
+
+import org.springframework.util.Assert;
+
+/**
+ * The specialty a caller asked the veterinarian directory to be narrowed to.
+ * <p>
+ * Both directory surfaces read their request parameter through {@link #from(String)}, so
+ * neither can drift from the other on what a caller's text means: surrounding space is
+ * dropped, and a value that names no specialty at all narrows nothing.
+ *
+ * @param name the specialty name to match, never blank and free of surrounding space
+ */
+record RequestedSpecialty(String name) {
+
+	RequestedSpecialty {
+		Assert.hasText(name, "A requested specialty must name a specialty");
+		name = name.strip();
+	}
+
+	/**
+	 * Read the specialty a request asks the directory to be narrowed to.
+	 * @param requested the raw request parameter, absent as {@code null}
+	 * @return the requested specialty, or empty when the request narrows nothing - an
+	 * absent, empty, or whitespace-only value asks for the whole directory
+	 */
+	static Optional<RequestedSpecialty> from(String requested) {
+		if (requested == null || requested.isBlank()) {
+			return Optional.empty();
+		}
+		return Optional.of(new RequestedSpecialty(requested));
+	}
+
+}
