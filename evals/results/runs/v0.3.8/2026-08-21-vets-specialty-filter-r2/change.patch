+ * asked the veterinarian directory to be narrowed to.
+ */
+class RequestedSpecialtyTests {
+
+	private static final String A_SPECIALTY = "radiology";
+
+	private Optional<RequestedSpecialty> readFromRequest(String requested) {
+		return RequestedSpecialty.from(requested);
+	}
+
+	private RequestedSpecialty createRequestFor(String specialtyName) {
+		return new RequestedSpecialty(specialtyName);
+	}
+
+	@Test
+	void theRequestShouldNarrowToTheSpecialtyItNames() {
+		assertThat(readFromRequest(A_SPECIALTY)).contains(createRequestFor(A_SPECIALTY));
+	}
+
+	@ParameterizedTest
+	@NullSource
+	@ValueSource(strings = { "", " ", "\t", "   " })
+	void theRequestShouldNarrowNothingWhenNoSpecialtyIsNamed(String requested) {
+		assertThat(readFromRequest(requested)).isEmpty();
+	}
+
+	@Test
+	void theRequestShouldIgnoreSpaceAroundTheSpecialtyName() {
+		assertThat(readFromRequest("  " + A_SPECIALTY + "  ")).contains(createRequestFor(A_SPECIALTY));
+	}
+
+	@Test
+	void twoRequestsForTheSameSpecialtyShouldBeEqual() {
+		assertThat(createRequestFor(A_SPECIALTY)).isEqualTo(createRequestFor(A_SPECIALTY))
+			.hasSameHashCodeAs(createRequestFor(A_SPECIALTY));
+	}
+
+	@Test
+	void aRequestShouldRefuseToNameNoSpecialtyAtAll() {
+		assertThatIllegalArgumentException().isThrownBy(() -> createRequestFor(" "));
+	}
+
+}
