+	/**
+	 * Matches a page whose backward or forward pagination link bearing {@code iconClass}
+	 * points at {@code href}. The icon class is the only thing that tells the five link
+	 * forms apart: every one of their targets also appears as a numbered link, so a bare
+	 * href assertion cannot say which form carries it.
+	 */
+	private static Matcher<String> aPaginationLinkTo(String href, String iconClass) {
+		return matchesRegex("(?s).*<a href=\"" + Pattern.quote(href) + "\"[^>]*class=\"fa " + iconClass + "\".*");
+	}
