+
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.test.web.servlet.MockMvc;
+
+/**
+ * Integration test for correcting a booked visit, exercised against the real
+ * {@link OwnerRepository} rather than a stand-in.
+ * <p>
+ * A refused correction must leave the stored visit as it stands. Only a real store can
+ * show that: the form binder writes the submitted values onto the loaded visit before
+ * validation refuses them, so an assertion against that same in-memory object would read
+ * back the refused values. Reloading the owner in a later transaction asks the store
+ * instead.
+ * <p>
+ * The fixture is the seeded visit of a seeded pet. A refused correction writes nothing,
+ * so the test leaves the shared store exactly as it found it and needs no rollback.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+@DisabledInNativeImage
+class VisitCorrectionIntegrationTests {
+
+	private static final int SEEDED_OWNER_ID = 6;
+
+	private static final int SEEDED_PET_ID = 7;
+
+	private static final String CORRECTED_VISIT_DESCRIPTION = "Rabies booster shot";
+
+	private static final String BLANK_DESCRIPTION = "";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private OwnerRepository owners;
+
+	private static Stream<Arguments> refusedCorrections() {
+		return Stream.of(arguments("blank description", futureDate().toString(), BLANK_DESCRIPTION),
+				arguments("date no later than today", LocalDate.now().toString(), CORRECTED_VISIT_DESCRIPTION));
+	}
+
+	@ParameterizedTest(name = "refused for a {0}")
+	@MethodSource("refusedCorrections")
+	void shouldLeaveTheStoredVisitUnchangedWhenTheCorrectionIsRefused(String refusalReason, String submittedDate,
+			String submittedDescription) throws Exception {
+		Visit bookedVisit = storedVisitOfSeededPet();
+		Integer bookedVisitId = bookedVisit.getId();
+		LocalDate bookedDate = bookedVisit.getDate();
+		String bookedDescription = bookedVisit.getDescription();
+
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit", SEEDED_OWNER_ID, SEEDED_PET_ID,
+					bookedVisitId)
+				.param("date", submittedDate)
+				.param("description", submittedDescription))
+			.andExpect(status().isOk())
+			.andExpect(view().name("pets/createOrUpdateVisitForm"));
+
+		Visit storedVisit = reloadStoredVisit(bookedVisitId);
+		assertThat(storedVisit.getDate()).isEqualTo(bookedDate);
+		assertThat(storedVisit.getDescription()).isEqualTo(bookedDescription);
+	}
+
+	private static LocalDate futureDate() {
+		return LocalDate.now().plusDays(14);
+	}
+
+	private Visit storedVisitOfSeededPet() {
+		return seededPet().getVisits().iterator().next();
+	}
+
+	private Visit reloadStoredVisit(Integer visitId) {
+		return seededPet().getVisit(visitId);
+	}
+
+	private Pet seededPet() {
+		Owner owner = this.owners.findById(SEEDED_OWNER_ID)
+			.orElseThrow(() -> new IllegalStateException("Seeded owner " + SEEDED_OWNER_ID + " is missing"));
+		return owner.getPet(SEEDED_PET_ID);
+	}
+
+}
