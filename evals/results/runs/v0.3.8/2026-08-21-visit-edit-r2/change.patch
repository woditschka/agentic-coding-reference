+ * Test class for {@link Pet}, covering the by-identity visit lookup a correction address
+ * resolves against.
+ */
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	private static final int ANOTHER_BOOKED_VISIT_ID = 2;
+
+	private static final int VISIT_ID_OF_NO_VISIT = 99;
+
+	@Test
+	void shouldFindTheBookedVisitCarryingTheGivenIdentifier() {
+		Pet pet = new Pet();
+		pet.addVisit(bookedVisit(BOOKED_VISIT_ID));
+		pet.addVisit(bookedVisit(ANOTHER_BOOKED_VISIT_ID));
+
+		Visit found = pet.getVisit(ANOTHER_BOOKED_VISIT_ID);
+
+		assertThat(found.getId()).isEqualTo(ANOTHER_BOOKED_VISIT_ID);
+	}
+
+	@Test
+	void shouldFindNoVisitWhenNoneCarriesTheGivenIdentifier() {
+		Pet pet = new Pet();
+		pet.addVisit(bookedVisit(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(VISIT_ID_OF_NO_VISIT)).isNull();
+	}
+
+	@Test
+	void shouldFindNoVisitAmongVisitsThatWereNeverBooked() {
+		Pet pet = new Pet();
+		Visit unbookedVisit = new Visit();
+		pet.addVisit(unbookedVisit);
+
+		// An unbooked visit carries no identifier, so a lookup that carries none must
+		// not match it by their shared absence.
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	/**
+	 * A visit that has been booked, which is to say one that carries an identifier. Date
+	 * and description play no part in the lookup and are left at their defaults.
+	 */
+	private static Visit bookedVisit(int id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+}
