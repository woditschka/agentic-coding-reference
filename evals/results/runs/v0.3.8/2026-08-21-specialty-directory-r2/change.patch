+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.samples.petclinic.vet.VetTestFixtures.createSpecialty;
+import static org.springframework.samples.petclinic.vet.VetTestFixtures.createVeterinarian;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the read-side view model behind the
+ * specialty directory page (REQ-SPEC-001).
+ */
+class SpecialtyDirectoryTests {
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() {
+		Specialty dentistry = createSpecialty("dentistry");
+		Specialty radiology = createSpecialty("radiology");
+		Specialty surgery = createSpecialty("surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, radiology, surgery),
+				List.of(createVeterinarian("Helen", "Leary", radiology)));
+
+		assertThat(directory.listings()).extracting(SpecialtyDirectory.Listing::specialtyName)
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListHoldersByFirstAndLastName() {
+		Specialty radiology = createSpecialty("radiology");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(createVeterinarian("Helen", "Leary", radiology)));
+
+		assertThat(directory.listings()).containsExactly(listingOf("radiology", "Helen Leary"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() {
+		Specialty radiology = createSpecialty("radiology");
+		Vet holdsNoSpecialty = createVeterinarian("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(holdsNoSpecialty, createVeterinarian("Helen", "Leary", radiology)));
+
+		assertThat(directory.listings()).containsExactly(listingOf("radiology", "Helen Leary"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty heldByNobody = createSpecialty("surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(heldByNobody),
+				List.of(createVeterinarian("James", "Carter")));
+
+		assertThat(directory.listings()).containsExactly(listingOf("surgery"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentSpecialtiesInAStableOrder() {
+		Specialty surgery = createSpecialty("surgery");
+		Specialty dentistry = createSpecialty("dentistry");
+		Specialty radiology = createSpecialty("radiology");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery, dentistry, radiology),
+				List.of(createVeterinarian("Helen", "Leary", radiology)));
+
+		assertThat(directory.listings()).extracting(SpecialtyDirectory.Listing::specialtyName)
+			.containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentHoldersOfOneSpecialtyInAStableOrder() {
+		Specialty surgery = createSpecialty("surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(surgery),
+				List.of(createVeterinarian("Rafael", "Ortega", surgery),
+						createVeterinarian("Linda", "Douglas", surgery), createVeterinarian("Ada", "Ortega", surgery)));
+
+		assertThat(directory.listings())
+			.containsExactly(listingOf("surgery", "Linda Douglas", "Ada Ortega", "Rafael Ortega"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldEqualAnotherDirectoryDerivedFromTheSameClinic() {
+		Specialty radiology = createSpecialty("radiology");
+		Vet helen = createVeterinarian("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory).isEqualTo(SpecialtyDirectory.of(List.of(radiology), List.of(helen)));
+	}
+
+	private SpecialtyDirectory.Listing listingOf(String specialtyName, String... veterinarianNames) {
+		return new SpecialtyDirectory.Listing(specialtyName, List.of(veterinarianNames));
+	}
+
+}
