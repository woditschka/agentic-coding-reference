+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * What the specialty directory page shows: every specialty the clinic knows, each with
+ * the veterinarians holding it.
+ * <p>
+ * The {@link Vet}-to-{@link Specialty} association is mapped one way only, so this
+ * content has to be derived by inverting it. The derivation lives here rather than in the
+ * controller, and the directory carries the displayed names rather than the mapped
+ * entities, so it is equal by value and exercisable without a framework context. See
+ * {@code docs/adr/2026-08-21-read-side-view-model-for-the-specialty-directory.md}.
+ *
+ * @param listings one entry per specialty, in specialty-name order
+ */
+public record SpecialtyDirectory(List<Listing> listings) {
+
+	private static final Comparator<Vet> BY_LAST_THEN_FIRST_NAME = Comparator
+		.comparing((Vet veterinarian) -> veterinarian.getLastName())
+		.thenComparing(Person::getFirstName);
+
+	public SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	/**
+	 * Derive the directory from every specialty the clinic knows and every veterinarian
+	 * it employs.
+	 * <p>
+	 * A specialty no veterinarian holds keeps its entry, with no veterinarian against it.
+	 * A veterinarian holding no specialty appears in no entry: the directory lists
+	 * specialties, not the veterinarian roster.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians every veterinarian the clinic employs
+	 * @return the page's content, ordered by specialty name and, within each specialty,
+	 * by the veterinarian's last name then first name
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<String, List<String>> holderNamesBySpecialtyName = holderNamesBySpecialtyName(veterinarians);
+		List<Listing> listings = specialties.stream()
+			.map(NamedEntity::getName)
+			.sorted()
+			.map(specialtyName -> new Listing(specialtyName,
+					holderNamesBySpecialtyName.getOrDefault(specialtyName, List.of())))
+			.toList();
+		return new SpecialtyDirectory(listings);
+	}
+
+	private static Map<String, List<String>> holderNamesBySpecialtyName(Collection<Vet> veterinarians) {
+		return veterinarians.stream()
+			.sorted(BY_LAST_THEN_FIRST_NAME)
+			.flatMap(veterinarian -> specialtyNamesOf(veterinarian).stream()
+				.map(specialtyName -> Map.entry(specialtyName, displayNameOf(veterinarian))))
+			.collect(Collectors.groupingBy(Map.Entry::getKey,
+					Collectors.mapping(Map.Entry::getValue, Collectors.toList())));
+	}
+
+	private static Set<String> specialtyNamesOf(Vet veterinarian) {
+		return veterinarian.getSpecialties().stream().map(NamedEntity::getName).collect(Collectors.toSet());
+	}
+
+	private static String displayNameOf(Vet veterinarian) {
+		return veterinarian.getFirstName() + " " + veterinarian.getLastName();
+	}
+
+	/**
+	 * One specialty as the page shows it.
+	 *
+	 * @param specialtyName the specialty's stored name
+	 * @param veterinarianNames the veterinarians holding it, by first name then last
+	 * name, in last-then-first-name order; empty when no veterinarian holds it
+	 */
+	public record Listing(String specialtyName, List<String> veterinarianNames) {
+
+		public Listing {
+			veterinarianNames = List.copyOf(veterinarianNames);
+		}
+
+	}
+
+}
