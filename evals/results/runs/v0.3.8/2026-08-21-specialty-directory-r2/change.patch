+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.samples.petclinic.vet.VetTestFixtures.createSpecialty;
+import static org.springframework.samples.petclinic.vet.VetTestFixtures.createVeterinarian;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController} (REQ-SPEC-001).
+ * <p>
+ * The directory's content rules are decided in {@link SpecialtyDirectoryTests} against
+ * real objects; what is left here is what only the web layer can answer.
+ */
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String HELD_SPECIALTY = "radiology";
+
+	private static final String UNHELD_SPECIALTY = "surgery";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@MockitoBean
+	private SpecialtyRepository specialties;
+
+	@MockitoBean
+	private VetRepository vets;
+
+	@BeforeEach
+	void setup() {
+		Specialty radiology = createSpecialty(HELD_SPECIALTY);
+		given(this.specialties.findSpecialties()).willReturn(List.of(radiology, createSpecialty(UNHELD_SPECIALTY)));
+		given(this.vets.findAll()).willReturn(
+				List.of(createVeterinarian("Helen", "Leary", radiology), createVeterinarian("James", "Carter")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeServedAtItsOwnAddress() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attributeExists("specialtyDirectory"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryPageShouldShowEachSpecialtyWithItsHolders() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString(HELD_SPECIALTY)))
+			.andExpect(content().string(containsString("Helen Leary")))
+			.andExpect(content().string(containsString(UNHELD_SPECIALTY)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryPageShouldOmitVeterinariansHoldingNoSpecialty() throws Exception {
+		mockMvc.perform(get("/specialties.html")).andExpect(content().string(not(containsString("James Carter"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryPageShouldCarryTheStandardNavigation() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(containsString("/owners/find")))
+			.andExpect(content().string(containsString("/vets.html")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryPageShouldMarkNoNavigationEntryAsTheCurrentPage() throws Exception {
+		mockMvc.perform(get("/specialties.html")).andExpect(content().string(not(containsString("nav-link active"))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotBeLinkedFromTheNavigationEveryPageCarries() throws Exception {
+		mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(not(containsString("href=\"/specialties.html\""))));
+	}
+
+}
