+package org.springframework.samples.petclinic.vet;
+
+/**
+ * Factory vocabulary for veterinarian tests: builds the real domain objects the vet
+ * package's tests assert against, so no test has to spell out setter sequences.
+ */
+final class VetTestFixtures {
+
+	private VetTestFixtures() {
+	}
+
+	static Specialty createSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return specialty;
+	}
+
+	static Vet createVeterinarian(String firstName, String lastName, Specialty... specialties) {
+		Vet veterinarian = new Vet();
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			veterinarian.addSpecialty(specialty);
+		}
+		return veterinarian;
+	}
+
