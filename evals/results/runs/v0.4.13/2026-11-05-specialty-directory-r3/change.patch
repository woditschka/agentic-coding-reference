+
+<body>
+
+  <h2 th:text="#{specialties}">Specialties</h2>
+
+  <table id="specialties" class="table table-striped">
+    <thead>
+      <tr>
+        <th th:text="#{name}">Name</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="specialty : ${specialtyDirectory.specialties}">
+        <td th:text="${specialty.name}"></td>
+        <td>
+          <div th:each="holderName : ${specialty.holderNames}" th:text="${holderName}"></div>
+          <span th:if="${#lists.isEmpty(specialty.holderNames)}" th:text="#{none}">none</span>
+        </td>
+      </tr>
+    </tbody>
+  </table>
+</body>
+
+</html>
