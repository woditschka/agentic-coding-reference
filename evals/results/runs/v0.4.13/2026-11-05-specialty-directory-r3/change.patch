+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.SpecialtyHolders;
+
+class SpecialtyDirectoryTests {
+
+	private static final AtomicInteger NEXT_ID = new AtomicInteger(1);
+
+	private static final String ANY_FIRST_NAME = "Any";
+
+	private static final String ANY_LAST_NAME = "Vet";
+
+	private static final String ANY_SPECIALTY_NAME = "any specialty";
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHoldingVeterinarianByFirstThenLastName() {
+		String firstName = "Helen";
+		String lastName = "Leary";
+		Specialty radiology = aSpecialty();
+		Vet helen = aVet();
+		helen.setFirstName(firstName);
+		helen.setLastName(lastName);
+		helen.addSpecialty(loadedSeparately(radiology));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.from(List.of(radiology), List.of(helen));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(
+				List.of(new SpecialtyHolders(radiology.getName(), List.of(firstName + " " + lastName)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEverySpecialtyTheyHold() {
+		Specialty radiology = aSpecialty();
+		Specialty surgery = aSpecialty();
+		Vet holderOfBoth = aVet();
+		holderOfBoth.addSpecialty(loadedSeparately(radiology));
+		holderOfBoth.addSpecialty(loadedSeparately(surgery));
+		String holderName = fullNameOf(holderOfBoth);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.from(List.of(radiology, surgery), List.of(holderOfBoth));
+
+		assertThat(directory)
+			.isEqualTo(new SpecialtyDirectory(List.of(new SpecialtyHolders(radiology.getName(), List.of(holderName)),
+					new SpecialtyHolders(surgery.getName(), List.of(holderName)))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = aSpecialty();
+		Vet holder = aVet();
+		holder.addSpecialty(loadedSeparately(radiology));
+		Vet nonHolder = aVet();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.from(List.of(radiology), List.of(holder, nonHolder));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(
+				List.of(new SpecialtyHolders(radiology.getName(), List.of(fullNameOf(holder))))));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentSpecialtiesAndVeterinariansInAStableOrder() {
+		Specialty surgery = aSpecialty();
+		Specialty radiology = aSpecialty();
+		Vet bobBaker = aHolderOf(surgery, "Bob", "Baker");
+		Vet zedAdams = aHolderOf(surgery, "Zed", "Adams");
+		Vet amyAdams = aHolderOf(surgery, "Amy", "Adams");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.from(List.of(surgery, radiology),
+				List.of(bobBaker, zedAdams, amyAdams));
+
+		assertThat(directory).isEqualTo(new SpecialtyDirectory(List.of(
+				new SpecialtyHolders(surgery.getName(),
+						List.of(fullNameOf(amyAdams), fullNameOf(zedAdams), fullNameOf(bobBaker))),
+				new SpecialtyHolders(radiology.getName(), List.of()))));
+	}
+
+	private static String fullNameOf(Vet vet) {
+		return vet.getFirstName() + " " + vet.getLastName();
+	}
+
+	private static Vet aHolderOf(Specialty specialty, String firstName, String lastName) {
+		Vet holder = aVet();
+		holder.setFirstName(firstName);
+		holder.setLastName(lastName);
+		holder.addSpecialty(loadedSeparately(specialty));
+		return holder;
+	}
+
+	private static Specialty aSpecialty() {
+		Specialty specialty = new Specialty();
+		int id = NEXT_ID.getAndIncrement();
+		specialty.setId(id);
+		specialty.setName(ANY_SPECIALTY_NAME + " " + id);
+		return specialty;
+	}
+
+	private static Vet aVet() {
+		Vet vet = new Vet();
+		vet.setId(NEXT_ID.getAndIncrement());
+		vet.setFirstName(ANY_FIRST_NAME);
+		vet.setLastName(ANY_LAST_NAME);
+		return vet;
+	}
+
+	// The vets and the specialties come from separate queries, so a held specialty is a
+	// distinct instance that shares only its persisted identity with the listed one.
+	private static Specialty loadedSeparately(Specialty specialty) {
+		Specialty held = new Specialty();
+		held.setId(specialty.getId());
+		held.setName(specialty.getName());
+		return held;
+	}
+
+}
