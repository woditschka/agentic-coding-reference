+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.Repository;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Repository for {@link Specialty} lookup values.
+ */
+public interface SpecialtyRepository extends Repository<Specialty, Integer> {
+
+	/**
+	 * Retrieve every stored {@link Specialty}, ordered by name with identity breaking
+	 * ties between equal names so the order is stable.
+	 * @return the specialties in name order
+	 */
+	@Transactional(readOnly = true)
+	@Query("SELECT specialty FROM Specialty specialty ORDER BY specialty.name, specialty.id")
+	List<Specialty> findAllOrderedByName();
+
+}
