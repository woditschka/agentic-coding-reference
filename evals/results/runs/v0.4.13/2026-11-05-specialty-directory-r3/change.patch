+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * Every specialty the clinic knows, each paired with the full names of the veterinarians
+ * holding it. Public because the view template reads it reflectively.
+ *
+ * @param specialties the specialties in the order they are presented
+ */
+public record SpecialtyDirectory(List<SpecialtyHolders> specialties) {
+
+	// Identity breaks ties between equal names so the order is stable across requests.
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyDirectory {
+		specialties = List.copyOf(specialties);
+	}
+
+	/**
+	 * Builds the directory from the specialties in presentation order and every
+	 * veterinarian, inverting the veterinarian-to-specialty association.
+	 */
+	static SpecialtyDirectory from(List<Specialty> specialties, Collection<Vet> vets) {
+		return new SpecialtyDirectory(specialties.stream()
+			.map(specialty -> new SpecialtyHolders(specialty.getName(), holdersOf(specialty, vets)))
+			.toList());
+	}
+
+	private static List<String> holdersOf(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream()
+			.filter(vet -> holds(vet, specialty))
+			.sorted(HOLDER_ORDER)
+			.map(SpecialtyDirectory::fullName)
+			.toList();
+	}
+
+	// The vets and the specialties are loaded by separate queries and the entities define
+	// no equality, so a held specialty matches a listed one by persisted identity only.
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> specialty.getId().equals(held.getId()));
+	}
+
+	private static String fullName(Vet vet) {
+		return vet.getFirstName() + " " + vet.getLastName();
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it; an empty list means none holds it.
+	 *
+	 * @param name the specialty's stored name
+	 * @param holderNames the full names of the holding veterinarians
+	 */
+	public record SpecialtyHolders(String name, List<String> holderNames) {
+
+		public SpecialtyHolders {
+			holderNames = List.copyOf(holderNames);
+		}
+
+	}
+
+}
