+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class GroupHoldersBySpecialtyTests {
+
+	private static final int ANY_ID = 99;
+
+	private static final String ANY_NAME = "any";
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final int SURGERY_ID = 2;
+
+	private static final String SURGERY = "surgery";
+
+	private static final int EARLIER_ID = 10;
+
+	private static final int LATER_ID = 20;
+
+	private static final String EARLIER_FIRST_NAME = "Helen";
+
+	private static final String LATER_FIRST_NAME = "James";
+
+	private static final String EARLIER_LAST_NAME = "Carter";
+
+	private static final String LATER_LAST_NAME = "Leary";
+
+	@Test
+	void theSpecialtyPageShouldOmitVeterinariansHoldingNoSpecialty() {
+		Specialty radiology = aSpecialty();
+		radiology.setId(RADIOLOGY_ID);
+		radiology.setName(RADIOLOGY);
+		Vet holder = aVet();
+		holder.addSpecialty(radiology);
+		Vet holdingNone = aVet();
+
+		List<SpecialtyHolders> grouped = GroupHoldersBySpecialty.apply(List.of(radiology),
+				List.of(holder, holdingNone));
+
+		assertThat(grouped).containsExactly(new SpecialtyHolders(radiology, List.of(holder)));
+	}
+
+	@Test
+	void theSpecialtyPageShouldListAVeterinarianUnderEverySpecialtyHeld() {
+		Specialty radiology = aSpecialty();
+		radiology.setId(RADIOLOGY_ID);
+		Specialty surgery = aSpecialty();
+		surgery.setId(SURGERY_ID);
+		Vet holderOfBoth = aVet();
+		holderOfBoth.addSpecialty(radiology);
+		holderOfBoth.addSpecialty(surgery);
+
+		List<SpecialtyHolders> grouped = GroupHoldersBySpecialty.apply(List.of(radiology, surgery),
+				List.of(holderOfBoth));
+
+		assertThat(grouped).containsExactly(new SpecialtyHolders(radiology, List.of(holderOfBoth)),
+				new SpecialtyHolders(surgery, List.of(holderOfBoth)));
+	}
+
+	@Test
+	void theGroupingShouldMatchAHeldSpecialtyByIdentityRatherThanByObjectReference() {
+		Specialty storedRadiology = aSpecialty();
+		storedRadiology.setId(RADIOLOGY_ID);
+		Specialty heldRadiology = aSpecialty();
+		heldRadiology.setId(RADIOLOGY_ID);
+		Vet holder = aVet();
+		holder.addSpecialty(heldRadiology);
+
+		List<SpecialtyHolders> grouped = GroupHoldersBySpecialty.apply(List.of(storedRadiology), List.of(holder));
+
+		assertThat(grouped).containsExactly(new SpecialtyHolders(storedRadiology, List.of(holder)));
+	}
+
+	@Test
+	void theGroupingShouldKeepASpecialtyNobodyHoldsWithNoHolders() {
+		Specialty heldByNone = aSpecialty();
+
+		List<SpecialtyHolders> grouped = GroupHoldersBySpecialty.apply(List.of(heldByNone), List.of(aVet()));
+
+		assertThat(grouped).containsExactly(new SpecialtyHolders(heldByNone, List.of()));
+	}
+
+	@Test
+	void theSpecialtyPageShouldPresentSpecialtiesAndHoldersInStableOrder() {
+		Specialty surgery = aSpecialty();
+		surgery.setId(SURGERY_ID);
+		surgery.setName(SURGERY);
+		Specialty laterRadiology = aSpecialty();
+		laterRadiology.setId(LATER_ID);
+		laterRadiology.setName(RADIOLOGY);
+		Specialty earlierRadiology = aSpecialty();
+		earlierRadiology.setId(EARLIER_ID);
+		earlierRadiology.setName(RADIOLOGY);
+		Vet leary = aVet();
+		leary.setLastName(LATER_LAST_NAME);
+		leary.addSpecialty(surgery);
+		Vet laterJamesCarter = aVet();
+		laterJamesCarter.setId(LATER_ID);
+		laterJamesCarter.setFirstName(LATER_FIRST_NAME);
+		laterJamesCarter.setLastName(EARLIER_LAST_NAME);
+		laterJamesCarter.addSpecialty(surgery);
+		Vet earlierJamesCarter = aVet();
+		earlierJamesCarter.setId(EARLIER_ID);
+		earlierJamesCarter.setFirstName(LATER_FIRST_NAME);
+		earlierJamesCarter.setLastName(EARLIER_LAST_NAME);
+		earlierJamesCarter.addSpecialty(surgery);
+		Vet helenCarter = aVet();
+		helenCarter.setFirstName(EARLIER_FIRST_NAME);
+		helenCarter.setLastName(EARLIER_LAST_NAME);
+		helenCarter.addSpecialty(surgery);
+
+		List<SpecialtyHolders> grouped = GroupHoldersBySpecialty.apply(
+				List.of(surgery, laterRadiology, earlierRadiology),
+				List.of(leary, laterJamesCarter, earlierJamesCarter, helenCarter));
+
+		List<Vet> orderedHolders = List.of(helenCarter, earlierJamesCarter, laterJamesCarter, leary);
+		assertThat(grouped).containsExactly(new SpecialtyHolders(earlierRadiology, List.of()),
+				new SpecialtyHolders(laterRadiology, List.of()), new SpecialtyHolders(surgery, orderedHolders));
+	}
+
+	private static Specialty aSpecialty() {
+		Specialty specialty = new Specialty();
+		specialty.setId(ANY_ID);
+		specialty.setName(ANY_NAME);
+		return specialty;
+	}
+
+	private static Vet aVet() {
+		Vet vet = new Vet();
+		vet.setId(ANY_ID);
+		vet.setFirstName(ANY_NAME);
+		vet.setLastName(ANY_NAME);
+		return vet;
+	}
+
+}
