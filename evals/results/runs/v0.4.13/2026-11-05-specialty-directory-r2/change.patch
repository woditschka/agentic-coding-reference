+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.List;
+import java.util.Locale;
+
+import org.junit.jupiter.api.Nested;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.MessageSource;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Import;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.context.NestedTestConfiguration;
+import org.springframework.test.context.NestedTestConfiguration.EnclosingConfiguration;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.hamcrest.Matchers.stringContainsInOrder;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+@WebMvcTest(SpecialtyController.class)
+@Import(SpecialtyControllerTests.ClinicWithOneHeldAndOneUnheldSpecialty.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_PAGE = "/specialties.html";
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final int SURGERY_ID = 2;
+
+	private static final String SURGERY = "surgery";
+
+	private static final String HOLDER_FIRST_NAME = "Helen";
+
+	private static final String HOLDER_LAST_NAME = "Leary";
+
+	private static final String HOLDER_FIRST_THEN_LAST_NAME = HOLDER_FIRST_NAME + " " + HOLDER_LAST_NAME;
+
+	private static final int ANY_VET_ID = 99;
+
+	private static final String HELD_BY_NONE_KEY = "none";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private MessageSource messages;
+
+	@Test
+	void theSpecialtyPageShouldListEverySpecialtyByStoredNameOnOnePage() throws Exception {
+		mockMvc.perform(get(SPECIALTY_PAGE))
+			.andExpect(status().isOk())
+			.andExpect(content().string(stringContainsInOrder(elementText(RADIOLOGY), elementText(SURGERY))));
+	}
+
+	@Test
+	void theSpecialtyPageShouldListEachHolderByFirstNameThenLastName() throws Exception {
+		mockMvc.perform(get(SPECIALTY_PAGE))
+			.andExpect(content().string(containsString(elementText(HOLDER_FIRST_THEN_LAST_NAME))));
+	}
+
+	@Test
+	void theSpecialtyPageShouldShowASpecialtyNobodyHoldsAsHeldByNone() throws Exception {
+		String heldByNone = messages.getMessage(HELD_BY_NONE_KEY, null, Locale.ENGLISH);
+
+		mockMvc.perform(get(SPECIALTY_PAGE).locale(Locale.ENGLISH))
+			.andExpect(content().string(stringContainsInOrder(elementText(SURGERY), elementText(heldByNone))));
+	}
+
+	private static String elementText(String wholeText) {
+		return ">" + wholeText + "<";
+	}
+
+	/**
+	 * The no-link check renders every other page from the real seed data, so it needs the
+	 * full application rather than this class's single-controller slice.
+	 */
+	@Nested
+	@NestedTestConfiguration(EnclosingConfiguration.OVERRIDE)
+	@SpringBootTest
+	@AutoConfigureMockMvc
+	class AcrossTheApplication {
+
+		@Autowired
+		private MockMvc mockMvc;
+
+		@ParameterizedTest(name = "{0} carries no link to the specialty page")
+		@ValueSource(strings = { "/", "/owners/find", "/owners?lastName=", "/owners/new", "/owners/1", "/owners/1/edit",
+				"/owners/1/pets/new", "/owners/1/pets/1/edit", "/owners/1/pets/1/visits/new", "/vets.html" })
+		void theOtherPagesShouldCarryNoLinkToTheSpecialtyPage(String otherPage) throws Exception {
+			mockMvc.perform(get(otherPage))
+				.andExpect(status().isOk())
+				.andExpect(content().string(not(containsString(SPECIALTY_PAGE))));
+		}
+
+	}
+
+	@TestConfiguration
+	static class ClinicWithOneHeldAndOneUnheldSpecialty {
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return new InMemorySpecialtyRepository(List.of(radiology(), surgery()));
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			Vet holder = new Vet();
+			holder.setId(ANY_VET_ID);
+			holder.setFirstName(HOLDER_FIRST_NAME);
+			holder.setLastName(HOLDER_LAST_NAME);
+			holder.addSpecialty(radiology());
+			return new InMemoryVetRepository(List.of(holder));
+		}
+
+		private static Specialty radiology() {
+			Specialty radiology = new Specialty();
+			radiology.setId(RADIOLOGY_ID);
+			radiology.setName(RADIOLOGY);
+			return radiology;
+		}
+
+		private static Specialty surgery() {
+			Specialty surgery = new Specialty();
+			surgery.setId(SURGERY_ID);
+			surgery.setName(SURGERY);
+			return surgery;
+		}
+
+	}
+
+	private record InMemorySpecialtyRepository(List<Specialty> stored) implements SpecialtyRepository {
+
+		@Override
+		public List<Specialty> findAll() {
+			return stored;
+		}
+
+	}
+
+	private record InMemoryVetRepository(Collection<Vet> stored) implements VetRepository {
+
+		@Override
+		public Collection<Vet> findAll() {
+			return stored;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("the specialty page reads every veterinarian unpaged");
+		}
+
+	}
+
+}
