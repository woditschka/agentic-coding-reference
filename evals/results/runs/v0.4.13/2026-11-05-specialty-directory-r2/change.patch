+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+/**
+ * One specialty paired with the veterinarians holding it; the list is empty when no
+ * veterinarian holds the specialty.
+ */
+record SpecialtyHolders(Specialty specialty, List<Vet> holders) {
+
+	SpecialtyHolders {
+		holders = List.copyOf(holders);
+	}
+
+}
