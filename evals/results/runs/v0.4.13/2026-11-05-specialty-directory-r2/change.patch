+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+/**
+ * Inverts veterinarians into the specialties they hold: one {@link SpecialtyHolders} per
+ * specialty, matched by specialty identity.
+ *
+ * <p>
+ * It owns the page's order. Stored names are not unique and the reads carry no ordering,
+ * so each order ends on identity to stay stable across databases.
+ */
+final class GroupHoldersBySpecialty {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> HOLDER_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	private GroupHoldersBySpecialty() {
+	}
+
+	static List<SpecialtyHolders> apply(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = holdersBySpecialtyId(veterinarians);
+		return specialties.stream()
+			.sorted(SPECIALTY_ORDER)
+			.map(specialty -> new SpecialtyHolders(specialty,
+					holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of())))
+			.toList();
+	}
+
+	private static Map<Integer, List<Vet>> holdersBySpecialtyId(Collection<Vet> veterinarians) {
+		return veterinarians.stream()
+			.sorted(HOLDER_ORDER)
+			.flatMap(vet -> vet.getSpecialties().stream().map(specialty -> Map.entry(specialty.getId(), vet)))
+			.collect(Collectors.groupingBy(Map.Entry::getKey,
+					Collectors.mapping(Map.Entry::getValue, Collectors.toList())));
+	}
+
+}
