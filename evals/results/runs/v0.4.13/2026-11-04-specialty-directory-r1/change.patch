+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.samples.petclinic.vet.VetFixtures.aSpecialty;
+import static org.springframework.samples.petclinic.vet.VetFixtures.aVet;
+
+class SpecialtyDirectoryTests {
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private static final int DENTISTRY_ID = 3;
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = aSpecialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet holder(String firstName, String lastName, Specialty... held) {
+		Vet vet = aVet();
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListUnderEachSpecialtyTheVeterinariansHoldingItByFirstNameThenLastName() {
+		Specialty radiology = specialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet helen = holder("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helen));
+
+		assertThat(directory.specialties())
+			.containsExactly(new SpecialtyDirectory.Listing(RADIOLOGY, List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchHoldersToSpecialtiesByIdentifierNotByInstance() {
+		Vet helen = holder("Helen", "Leary", specialty(RADIOLOGY_ID, RADIOLOGY));
+		Specialty listedRadiology = specialty(RADIOLOGY_ID, RADIOLOGY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(listedRadiology), List.of(helen));
+
+		assertThat(directory.specialties())
+			.containsExactly(new SpecialtyDirectory.Listing(RADIOLOGY, List.of("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListNoVeterinarianWhoHoldsNoSpecialty() {
+		Specialty radiology = specialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet james = holder("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(james));
+
+		assertThat(directory.specialties()).containsExactly(new SpecialtyDirectory.Listing(RADIOLOGY, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHoldsAsHeldByNone() {
+		Specialty dentistry = specialty(DENTISTRY_ID, DENTISTRY);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry), List.of());
+
+		assertThat(directory.specialties()).containsExactly(new SpecialtyDirectory.Listing(DENTISTRY, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty radiology = specialty(RADIOLOGY_ID, RADIOLOGY);
+		Specialty surgery = specialty(SURGERY_ID, SURGERY);
+		Vet linda = holder("Linda", "Douglas", radiology, surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery), List.of(linda));
+
+		assertThat(directory.specialties()).containsExactly(
+				new SpecialtyDirectory.Listing(RADIOLOGY, List.of("Linda Douglas")),
+				new SpecialtyDirectory.Listing(SURGERY, List.of("Linda Douglas")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListSpecialtiesByNameThenIdentifier() {
+		Specialty laterSurgery = specialty(SURGERY_ID, SURGERY);
+		Specialty earlierSurgery = specialty(RADIOLOGY_ID, SURGERY);
+		Specialty dentistry = specialty(DENTISTRY_ID, DENTISTRY);
+		Vet holdsLater = holder("Linda", "Douglas", laterSurgery);
+		Vet holdsEarlier = holder("Helen", "Leary", earlierSurgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(laterSurgery, earlierSurgery, dentistry),
+				List.of(holdsLater, holdsEarlier));
+
+		assertThat(directory.specialties()).containsExactly(new SpecialtyDirectory.Listing(DENTISTRY, List.of()),
+				new SpecialtyDirectory.Listing(SURGERY, List.of("Helen Leary")),
+				new SpecialtyDirectory.Listing(SURGERY, List.of("Linda Douglas")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListVeterinariansByLastNameThenFirstName() {
+		Specialty radiology = specialty(RADIOLOGY_ID, RADIOLOGY);
+		Vet zoeSmith = holder("Zoe", "Smith", radiology);
+		Vet annSmith = holder("Ann", "Smith", radiology);
+		Vet jamesCarter = holder("James", "Carter", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology),
+				List.of(zoeSmith, annSmith, jamesCarter));
+
+		assertThat(directory.specialties()).containsExactly(
+				new SpecialtyDirectory.Listing(RADIOLOGY, List.of("James Carter", "Ann Smith", "Zoe Smith")));
+	}
+
+}
