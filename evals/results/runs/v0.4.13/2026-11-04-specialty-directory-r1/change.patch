+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * Every {@link Specialty} with the {@link Vet}s holding it, inverting the association
+ * that only {@code Vet} navigates. Specialties are ordered by name then identifier, the
+ * veterinarians under each by last name, first name, then identifier.
+ *
+ * @param specialties one listing per specialty, in display order
+ */
+public record SpecialtyDirectory(List<Listing> specialties) {
+
+	private static final Comparator<Specialty> SPECIALTY_ORDER = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	private static final Comparator<Vet> VET_ORDER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	public SpecialtyDirectory {
+		specialties = List.copyOf(specialties);
+	}
+
+	/**
+	 * One specialty and the full names of its holders.
+	 *
+	 * @param name the specialty's stored name
+	 * @param veterinarians holders as "first name last name", empty when none holds it
+	 */
+	public record Listing(String name, List<String> veterinarians) {
+
+		public Listing {
+			veterinarians = List.copyOf(veterinarians);
+		}
+
+	}
+
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		List<Vet> orderedVets = vets.stream().sorted(VET_ORDER).toList();
+		return new SpecialtyDirectory(specialties.stream().sorted(SPECIALTY_ORDER).map(specialty -> {
+			List<String> holders = orderedVets.stream()
+				.filter(vet -> holds(vet, specialty))
+				.map(vet -> vet.getFirstName() + " " + vet.getLastName())
+				.toList();
+			return new Listing(specialty.getName(), holders);
+		}).toList());
+	}
+
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> held.getId().equals(specialty.getId()));
+	}
+
+}
