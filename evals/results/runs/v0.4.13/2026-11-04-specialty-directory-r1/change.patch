+package org.springframework.samples.petclinic.vet;
+
+/**
+ * Named defaults for the persistence entities, whose entry point is the no-argument
+ * constructor plus setters; a test sets the attributes that matter on the default.
+ */
+final class VetFixtures {
+
+	private static final String SOME_SPECIALTY_NAME = "some-specialty";
+
+	private static final String SOME_FIRST_NAME = "Some";
+
+	private static final String SOME_LAST_NAME = "Vet";
+
+	private VetFixtures() {
+	}
+
+	static Specialty aSpecialty() {
+		Specialty specialty = new Specialty();
+		specialty.setId(1);
+		specialty.setName(SOME_SPECIALTY_NAME);
+		return specialty;
+	}
+
+	static Vet aVet() {
+		Vet vet = new Vet();
+		vet.setId(1);
+		vet.setFirstName(SOME_FIRST_NAME);
+		vet.setLastName(SOME_LAST_NAME);
+		return vet;
+	}
+
+}
