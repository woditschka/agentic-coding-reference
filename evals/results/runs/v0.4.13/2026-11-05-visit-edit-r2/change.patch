+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Tests the visit lookup a {@link Pet} owns.
+ */
+class PetTests {
+
+	private static final int FIRST_VISIT_ID = 1;
+
+	private static final int SECOND_VISIT_ID = 2;
+
+	private static final int OTHER_PETS_VISIT_ID = 3;
+
+	@Test
+	void thePetShouldFindItsVisitByIdentityAmongSeveral() {
+		Visit secondVisit = aVisit(SECOND_VISIT_ID);
+		Pet pet = aPet();
+		pet.addVisit(aVisit(FIRST_VISIT_ID));
+		pet.addVisit(secondVisit);
+
+		assertThat(pet.getVisit(SECOND_VISIT_ID)).containsSame(secondVisit);
+	}
+
+	@Test
+	void thePetShouldFindNoVisitWhenItHasNone() {
+		assertThat(aPet().getVisit(FIRST_VISIT_ID)).isEmpty();
+	}
+
+	@Test
+	void thePetShouldFindNoVisitThatBelongsToAnotherPet() {
+		Pet pet = aPet();
+		pet.addVisit(aVisit(FIRST_VISIT_ID));
+		Pet otherPet = aPet();
+		otherPet.addVisit(aVisit(OTHER_PETS_VISIT_ID));
+
+		assertThat(pet.getVisit(OTHER_PETS_VISIT_ID)).isEmpty();
+	}
+
+	private static Pet aPet() {
+		return new Pet();
+	}
+
+	private static Visit aVisit(int id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+}
