+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Unit tests for the visit lookup of {@link Pet}.
+ */
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 7;
+
+	private static final int UNKNOWN_VISIT_ID = 99;
+
+	@Test
+	void thePetShouldReturnThePersistedVisitWithTheGivenId() {
+		Pet pet = new Pet();
+		Visit bookedVisit = aVisitWithId(BOOKED_VISIT_ID);
+		pet.addVisit(bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void thePetShouldReturnNullForAnUnknownVisitId() {
+		Pet pet = new Pet();
+		pet.addVisit(aVisitWithId(BOOKED_VISIT_ID));
+
+		assertThat(pet.getVisit(UNKNOWN_VISIT_ID)).isNull();
+	}
+
+	@Test
+	void thePetShouldNeverMatchAVisitThatIsNotYetSaved() {
+		Pet pet = new Pet();
+		pet.addVisit(new Visit());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+	private static Visit aVisitWithId(int id) {
+		Visit visit = new Visit();
+		visit.setId(id);
+		return visit;
+	}
+
+}
