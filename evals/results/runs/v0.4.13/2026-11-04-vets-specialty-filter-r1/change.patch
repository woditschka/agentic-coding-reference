+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.InstanceOfAssertFactories.list;
+
+import java.util.List;
+import java.util.stream.Stream;
+
+import org.assertj.core.api.AbstractListAssert;
+import org.assertj.core.api.ObjectArrayAssert;
+import org.assertj.core.api.ObjectAssert;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.http.MediaType;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.test.web.servlet.assertj.MockMvcTester;
+import org.springframework.test.web.servlet.assertj.MvcTestResult;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Specialty narrowing of both veterinarian lists, driven against the seeded database: the
+ * matching rules live in the repository query, so only real data can show them.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+class VetControllerIntegrationTests {
+
+	private static final String DIRECTORY_PAGE = "/vets.html";
+
+	private static final String DIRECTORY_VIEW = "vets/vetList";
+
+	private static final String JSON_LIST = "/vets";
+
+	private static final String SPECIALTY = "specialty";
+
+	private static final String PAGE = "page";
+
+	private static final String LISTED_VETS = "listVets";
+
+	private static final String LISTED_VET_COUNT = "totalItems";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	// Douglas holds dentistry alongside surgery.
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String[] PAGE_CONTROL_TAGS = { "<form", "<select", "<input" };
+
+	private static final String RADIOLOGY_IN_MIXED_CASE = "RaDiOlOgY";
+
+	private static final String RADIOLOGY_PREFIX = "radio";
+
+	private static final String SPECIALTY_NO_VET_HOLDS = "cardiology";
+
+	private static final String LEARY = "Leary";
+
+	private static final String STEVENS = "Stevens";
+
+	private static final String CARTER = "Carter";
+
+	private static final String DOUGLAS = "Douglas";
+
+	private static final String ORTEGA = "Ortega";
+
+	private static final String JENKINS = "Jenkins";
+
+	// Enough radiologists that the narrowed list spills past one directory page.
+	private static final List<String> HIRED_RADIOLOGISTS = List.of("Roentgen", "Curie", "Becquerel", "Hounsfield");
+
+	private static final String ANY_FIRST_NAME = "Hired";
+
+	private static final String FIRST_PAGE = "1";
+
+	private static final String SECOND_PAGE = "2";
+
+	// The seeded six vets fill two directory pages, so the second page is the last.
+	private static final String LAST_PAGE = SECOND_PAGE;
+
+	private static final String PAGE_BEFORE_FIRST = "0";
+
+	private static final String PAGE_AFTER_LAST = "3";
+
+	@Autowired
+	private MockMvcTester mvc;
+
+	@Autowired
+	private JdbcTemplate jdbc;
+
+	@Test
+	void theVetDirectoryPageShouldListOnlyVetsHoldingTheRequestedSpecialty() {
+		MvcTestResult page = directoryPageNarrowedTo(RADIOLOGY);
+
+		assertThatVetsOn(page).containsExactlyInAnyOrder(LEARY, STEVENS);
+	}
+
+	@Test
+	void theVetJsonListShouldReturnOnlyVetsHoldingTheRequestedSpecialty() {
+		MvcTestResult json = jsonListNarrowedTo(RADIOLOGY);
+
+		assertThatVetsIn(json).containsExactlyInAnyOrder(LEARY, STEVENS);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldMatchRegardlessOfLetterCase() {
+		MvcTestResult page = directoryPageNarrowedTo(RADIOLOGY_IN_MIXED_CASE);
+		MvcTestResult json = jsonListNarrowedTo(RADIOLOGY_IN_MIXED_CASE);
+
+		assertThatVetsOn(page).containsExactlyInAnyOrder(LEARY, STEVENS);
+		assertThatVetsIn(json).containsExactlyInAnyOrder(LEARY, STEVENS);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldNotMatchASpecialtyNamePrefix() {
+		MvcTestResult page = directoryPageNarrowedTo(RADIOLOGY_PREFIX);
+		MvcTestResult json = jsonListNarrowedTo(RADIOLOGY_PREFIX);
+
+		assertThatVetsOn(page).isEmpty();
+		assertThatVetsIn(json).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyNoVetHoldsShouldYieldAnEmptyListOnTheDirectoryPageAndTheJsonList() {
+		MvcTestResult page = directoryPageNarrowedTo(SPECIALTY_NO_VET_HOLDS);
+		MvcTestResult json = jsonListNarrowedTo(SPECIALTY_NO_VET_HOLDS);
+
+		assertThat(page).hasViewName(DIRECTORY_VIEW);
+		assertThatVetsOn(page).isEmpty();
+		assertThatVetsIn(json).isEmpty();
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { "", "   " })
+	void theEmptyOrWhitespaceSpecialtyShouldListEveryVetOnTheDirectoryPageAndTheJsonList(String blankSpecialty)
+			throws Exception {
+		String unnarrowedPage = mvc.get().uri(DIRECTORY_PAGE).exchange().getResponse().getContentAsString();
+		String unnarrowedJson = jsonList().exchange().getResponse().getContentAsString();
+
+		MvcTestResult page = directoryPageNarrowedTo(blankSpecialty);
+		MvcTestResult json = jsonListNarrowedTo(blankSpecialty);
+
+		assertThat(page).hasStatusOk().bodyText().isEqualTo(unnarrowedPage);
+		assertThat(json).hasStatusOk().bodyText().isEqualTo(unnarrowedJson);
+	}
+
+	@Test
+	void theVetJsonListShouldReturnEveryVetWhenNoSpecialtyIsGiven() {
+		MvcTestResult json = jsonList().exchange();
+
+		assertThatVetsIn(json).containsExactlyInAnyOrder(CARTER, LEARY, DOUGLAS, ORTEGA, STEVENS, JENKINS);
+	}
+
+	@Test
+	@Transactional
+	void theVetDirectoryPageShouldPageOverTheNarrowedList() {
+		hireRadiologists();
+
+		MvcTestResult secondPage = mvc.get()
+			.uri(DIRECTORY_PAGE)
+			.param(SPECIALTY, RADIOLOGY)
+			.param(PAGE, SECOND_PAGE)
+			.exchange();
+
+		assertThat(secondPage).model().containsEntry(LISTED_VET_COUNT, (long) radiologistsAfterHiring().size());
+		assertThatVetsOn(secondPage).isNotEmpty().isSubsetOf(radiologistsAfterHiring());
+	}
+
+	@Test
+	@Transactional
+	void theVetDirectoryPaginationLinksShouldCarryTheSpecialty() {
+		hireRadiologists();
+
+		MvcTestResult firstPage = directoryPageNarrowedTo(RADIOLOGY);
+
+		assertThat(firstPage).hasStatusOk()
+			.bodyText()
+			.contains("href=\"%s?%s=%s&amp;%s=%s\"".formatted(DIRECTORY_PAGE, PAGE, SECOND_PAGE, SPECIALTY, RADIOLOGY))
+			.doesNotContainPattern("href=\"/vets\\.html\\?page=\\d+\"");
+	}
+
+	@Test
+	void theVetDirectoryPaginationLinksShouldCarryNoSpecialtyWhenNoneIsGiven() {
+		MvcTestResult firstPage = mvc.get().uri(DIRECTORY_PAGE).exchange();
+
+		assertThat(firstPage).hasStatusOk()
+			.bodyText()
+			.contains("href=\"%s?%s=%s\"".formatted(DIRECTORY_PAGE, PAGE, SECOND_PAGE))
+			.doesNotContain(SPECIALTY + "=");
+	}
+
+	@Test
+	void theFirstDirectoryPageShouldLinkNeitherToItselfNorToAPageBeforeIt() {
+		MvcTestResult firstPage = mvc.get().uri(DIRECTORY_PAGE).param(PAGE, FIRST_PAGE).exchange();
+
+		assertThat(firstPage).hasStatusOk()
+			.bodyText()
+			.doesNotContain(hrefToPage(FIRST_PAGE), hrefToPage(PAGE_BEFORE_FIRST));
+	}
+
+	@Test
+	void theLastDirectoryPageShouldLinkNeitherToItselfNorToAPageAfterIt() {
+		MvcTestResult lastPage = mvc.get().uri(DIRECTORY_PAGE).param(PAGE, LAST_PAGE).exchange();
+
+		assertThat(lastPage).hasStatusOk()
+			.bodyText()
+			.doesNotContain(hrefToPage(LAST_PAGE), hrefToPage(PAGE_AFTER_LAST));
+	}
+
+	@Test
+	void aVetHoldingSeveralSpecialtiesShouldBeListedWhenAnyOfThemMatches() {
+		MvcTestResult page = directoryPageNarrowedTo(DENTISTRY);
+
+		assertThatVetsOn(page).containsExactly(DOUGLAS);
+	}
+
+	@Test
+	void aVetHoldingNoSpecialtyShouldNeverAppearInANarrowedList() {
+		MvcTestResult page = directoryPageNarrowedTo(SURGERY);
+
+		assertThatVetsOn(page).isNotEmpty().doesNotContain(CARTER, JENKINS);
+	}
+
+	@Test
+	void theVetDirectoryPageShouldOfferNoSpecialtyControl() {
+		MvcTestResult page = directoryPageNarrowedTo(RADIOLOGY);
+
+		assertThat(page).hasStatusOk().bodyText().doesNotContain(PAGE_CONTROL_TAGS);
+	}
+
+	private void hireRadiologists() {
+		jdbc.batchUpdate("INSERT INTO vets (first_name, last_name) VALUES (?, ?)",
+				HIRED_RADIOLOGISTS.stream().map(lastName -> new Object[] { ANY_FIRST_NAME, lastName }).toList());
+		jdbc.update("""
+				INSERT INTO vet_specialties (vet_id, specialty_id)
+				SELECT v.id, s.id FROM vets v, specialties s
+				WHERE v.first_name = ? AND s.name = ?""", ANY_FIRST_NAME, RADIOLOGY);
+	}
+
+	private static List<String> radiologistsAfterHiring() {
+		return Stream.concat(Stream.of(LEARY, STEVENS), HIRED_RADIOLOGISTS.stream()).toList();
+	}
+
+	private static String hrefToPage(String page) {
+		return "href=\"%s?%s=%s\"".formatted(DIRECTORY_PAGE, PAGE, page);
+	}
+
+	private MvcTestResult directoryPageNarrowedTo(String specialty) {
+		return mvc.get().uri(DIRECTORY_PAGE).param(SPECIALTY, specialty).exchange();
+	}
+
+	private MvcTestResult jsonListNarrowedTo(String specialty) {
+		return jsonList().param(SPECIALTY, specialty).exchange();
+	}
+
+	private MockMvcTester.MockMvcRequestBuilder jsonList() {
+		return mvc.get().uri(JSON_LIST).accept(MediaType.APPLICATION_JSON);
+	}
+
+	private static ObjectArrayAssert<Object> assertThatVetsIn(MvcTestResult jsonList) {
+		return assertThat(jsonList).hasStatusOk().bodyJson().extractingPath("$.vetList[*].lastName").asArray();
+	}
+
+	private static AbstractListAssert<?, List<? extends String>, String, ObjectAssert<String>> assertThatVetsOn(
+			MvcTestResult directoryPage) {
+		return assertThat(directoryPage).hasStatusOk()
+			.model()
+			.extractingByKey(LISTED_VETS, list(Vet.class))
+			.extracting(Vet::getLastName);
+	}
+
