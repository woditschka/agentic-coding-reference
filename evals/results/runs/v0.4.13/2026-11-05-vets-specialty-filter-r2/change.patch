+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.Map;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+import org.springframework.test.web.servlet.ResultActions;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.containsInAnyOrder;
+import static org.hamcrest.Matchers.hasSize;
+import static org.assertj.core.api.Assertions.tuple;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+/**
+ * Narrowing the veterinarian directory by Specialty, run against the seeded H2 database
+ * so the repository's real matching is what the tests observe.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+class VetDirectoryFilterIntegrationTests {
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String UNFILTERED_SECOND_PAGE_LINK = "href=\"/vets.html?page=2\"";
+
+	private static final long SEEDED_VET_COUNT = 6L;
+
+	private static final long SEEDED_RADIOLOGIST_COUNT = 2L;
+
+	private static final int ONE_PAGE = 1;
+
+	private static final String DOUGLAS = "Douglas";
+
+	private static final String ORTEGA = "Ortega";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	void theVetPageShouldListOnlyVetsHoldingTheRequestedSpecialty() throws Exception {
+		List<Vet> listed = listedOnVetPage(SURGERY);
+
+		assertThat(listed).extracting(Vet::getLastName, VetDirectoryFilterIntegrationTests::specialtyNames)
+			.containsExactlyInAnyOrder(tuple(DOUGLAS, List.of(DENTISTRY, SURGERY)), tuple(ORTEGA, List.of(SURGERY)));
+	}
+
+	@ParameterizedTest(name = "{0} lists every vet")
+	@ValueSource(strings = { "", "   " })
+	void theVetPageShouldTreatAnEmptyOrBlankSpecialtyAsAbsent(String blankSpecialty) throws Exception {
+		Map<String, Object> model = vetPage(blankSpecialty).getModelAndView().getModel();
+
+		assertThat(model).containsEntry("totalItems", SEEDED_VET_COUNT).doesNotContainKey("specialty");
+	}
+
+	@Test
+	void theVetPageShouldPaginateTheNarrowedListOnly() throws Exception {
+		Map<String, Object> model = vetPage(RADIOLOGY).getModelAndView().getModel();
+
+		assertThat(model).containsEntry("totalItems", SEEDED_RADIOLOGIST_COUNT).containsEntry("totalPages", ONE_PAGE);
+	}
+
+	@Test
+	void theVetListShouldReturnOnlyVetsHoldingTheRequestedSpecialty() throws Exception {
+		vetList(SURGERY).andExpect(status().isOk())
+			.andExpect(jsonPath("$.vetList[*].lastName", containsInAnyOrder(DOUGLAS, ORTEGA)))
+			.andExpect(jsonPath("$.vetList[*].specialties[*].name", containsInAnyOrder(DENTISTRY, SURGERY, SURGERY)));
+	}
+
+	@ParameterizedTest(name = "{0} lists every vet")
+	@ValueSource(strings = { "", "   " })
+	void theVetListShouldTreatAnEmptyOrBlankSpecialtyAsAbsent(String blankSpecialty) throws Exception {
+		vetList(blankSpecialty).andExpect(jsonPath("$.vetList", hasSize((int) SEEDED_VET_COUNT)));
+	}
+
+	@Test
+	void theUnfilteredVetPageShouldLinkItsPagesWithoutASpecialty() throws Exception {
+		String body = mockMvc.perform(get("/vets.html")).andReturn().getResponse().getContentAsString();
+
+		assertThat(body).contains(UNFILTERED_SECOND_PAGE_LINK).doesNotContain("specialty=");
+	}
+
+	private ResultActions vetList(String specialty) throws Exception {
+		return mockMvc.perform(get("/vets").param("specialty", specialty).accept(MediaType.APPLICATION_JSON));
+	}
+
+	private MvcResult vetPage(String specialty) throws Exception {
+		return mockMvc.perform(get("/vets.html").param("specialty", specialty)).andReturn();
+	}
+
+	@SuppressWarnings("unchecked")
+	private List<Vet> listedOnVetPage(String specialty) throws Exception {
+		return (List<Vet>) vetPage(specialty).getModelAndView().getModel().get("listVets");
+	}
+
+	private static List<String> specialtyNames(Vet vet) {
+		return vet.getSpecialties().stream().map(Specialty::getName).toList();
+	}
+
+}
