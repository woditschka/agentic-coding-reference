+	private List<UriComponents> paginationLinks(String page) {
+		return PAGINATION_LINK.matcher(page)
+			.results()
+			.map(link -> UriComponentsBuilder.fromUriString(HtmlUtils.htmlUnescape(link.group(1))).build())
+			.toList();
+	}
+
+	private String specialtyCarriedBy(UriComponents link) {
+		return UriUtils.decode(link.getQueryParams().getFirst("specialty"), StandardCharsets.UTF_8);
+	}
