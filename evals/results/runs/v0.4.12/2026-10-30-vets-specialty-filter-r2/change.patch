+	@ParameterizedTest
+	@ValueSource(strings = { "oral surgery", "ear&nose", "ear+nose", "%41", "o'neil", "say\"hi" })
+	void theVetListPaginationLinksShouldCarryTheSpecialtyWithSpacesAndReservedCharactersAsPlainText(String specialty)
+			throws Exception {
+		int middleOfFivePages = 3;
+		int fivePagesOfVets = 4 * VETS_PER_PAGE + 1;
+		List<String> numberedLinkPages = List.of("1", "2", "4", "5");
+		List<String> firstPreviousNextLastPages = List.of("1", "2", "4", "5");
+		given(this.vets.findDistinctBySpecialtiesNameIgnoreCase(eq(specialty), any(Pageable.class))).willReturn(
+				new PageImpl<>(List.of(aVet()), PageRequest.of(middleOfFivePages - 1, VETS_PER_PAGE), fivePagesOfVets));
+
+		String page = mockMvc
+			.perform(get("/vets.html").param("page", String.valueOf(middleOfFivePages)).param("specialty", specialty))
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+
+		assertThat(paginationLinks(page)).extracting(link -> link.getQueryParams().getFirst("page"))
+			.containsExactlyElementsOf(
+					Stream.of(numberedLinkPages, firstPreviousNextLastPages).flatMap(List::stream).toList());
+		assertThat(paginationLinks(page)).extracting(this::specialtyCarriedBy).containsOnly(specialty);
+		assertThat(page).doesNotContain("specialty=" + specialty);
+	}
