+		assertThatThrownBy(() -> mockMvc.perform(aValidCorrectionOf(TEST_PET_ID, UNKNOWN_VISIT_ID)))
+			.hasRootCauseInstanceOf(IllegalArgumentException.class);
+
+		assertTheStoredVisitIsUnchanged();
+	}
+
+	@Test
+	void theVisitEditShouldRefuseAPetNotBelongingToTheOwner() {
+		assertThatThrownBy(
+				() -> mockMvc.perform(get(VISIT_EDIT_URL, TEST_OWNER_ID, PET_OF_ANOTHER_OWNER_ID, TEST_VISIT_ID)))
+			.hasRootCauseInstanceOf(IllegalArgumentException.class);
+		assertThatThrownBy(() -> mockMvc.perform(aValidCorrectionOf(PET_OF_ANOTHER_OWNER_ID, TEST_VISIT_ID)))
+			.hasRootCauseInstanceOf(IllegalArgumentException.class);
+
+		assertTheStoredVisitIsUnchanged();
+	}
+
+	@Test
+	void theVisitEditShouldChangeOnlyTheDateAndDescription() throws Exception {
+		this.owner.setAddress(STORED_ADDRESS);
+		this.pet.setName(STORED_PET_NAME);
+
+		mockMvc
+			.perform(aValidCorrectionOf(TEST_PET_ID, TEST_VISIT_ID).param("id", String.valueOf(SIBLING_PET_VISIT_ID))
+				.param("address", SOME_TAMPERED_VALUE)
+				.param("pets[0].name", SOME_TAMPERED_VALUE))
+			.andExpect(status().is3xxRedirection());
+
+		assertThat(this.storedVisit.getId()).isEqualTo(TEST_VISIT_ID);
+		assertThat(this.owner.getAddress()).isEqualTo(STORED_ADDRESS);
+		assertThat(this.pet.getName()).isEqualTo(STORED_PET_NAME);
+		assertThat(this.pet.getVisits()).singleElement().isSameAs(this.storedVisit);
+	}
+
+	private static MockHttpServletRequestBuilder aValidCorrectionOf(int petId, int visitId) {
+		return post(VISIT_EDIT_URL, TEST_OWNER_ID, petId, visitId).param("date", CORRECTED_DATE.toString())
+			.param("description", CORRECTED_DESCRIPTION);
+	}
+
+	private void assertTheStoredVisitIsUnchanged() {
+		assertThat(this.storedVisit).usingRecursiveComparison().isEqualTo(aStoredVisit());
+		verify(this.owners, never()).save(any());
+	}
+
 }
