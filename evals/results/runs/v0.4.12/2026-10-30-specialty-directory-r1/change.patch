+ * limitations under the License.
+ */
+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.List;
+
+/**
+ * The read-only view answering which veterinarians hold each specialty.
+ *
+ * @param listings one entry per specialty the clinic knows
+ */
+public record SpecialtyDirectory(List<Listing> listings) {
+
+	public SpecialtyDirectory {
+		listings = List.copyOf(listings);
+	}
+
+	/**
+	 * Maps from the specialties rather than from the veterinarians alone, because a
+	 * specialty no veterinarian holds must still be listed.
+	 */
+	static SpecialtyDirectory fromSpecialtiesAndVets(Collection<Specialty> specialties, Collection<Vet> vets) {
+		return new SpecialtyDirectory(specialties.stream()
+			.map(specialty -> new Listing(specialty.getName(), holdersOf(specialty, vets)))
+			.toList());
+	}
+
+	private static List<String> holdersOf(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream().filter(vet -> holds(vet, specialty)).map(Vet::fullName).toList();
+	}
+
+	/**
+	 * Compares identifiers because entities define no value equality, so a cached
+	 * veterinarian's specialty is a different instance from the repository's, and names
+	 * carry no unique constraint.
+	 */
+	private static boolean holds(Vet vet, Specialty specialty) {
+		return vet.getSpecialties().stream().anyMatch(held -> specialty.getId().equals(held.getId()));
+	}
+
+	/**
+	 * One specialty with the veterinarians holding it.
+	 *
+	 * @param specialtyName the name as stored
+	 * @param holders the Full Name of each veterinarian holding the specialty
+	 */
+	public record Listing(String specialtyName, List<String> holders) {
+
+		public Listing {
+			holders = List.copyOf(holders);
+		}
+
+	}
+
+}
