+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.aot.hint.MemberCategory;
+import org.springframework.aot.hint.RuntimeHints;
+import org.springframework.aot.hint.predicate.RuntimeHintsPredicates;
+import org.springframework.samples.petclinic.PetClinicRuntimeHints;
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.Listing;
+
+/**
+ * Tests for the mapping behind the {@link SpecialtyDirectory}.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String SOME_SPECIALTY_NAME = "some specialty";
+
+	private static final String SOME_FIRST_NAME = "Some";
+
+	private static final String SOME_LAST_NAME = "Veterinarian";
+
+	private static final AtomicInteger NEXT_ID = new AtomicInteger();
+
+	private static Specialty aSpecialty() {
+		Specialty specialty = new Specialty();
+		specialty.setId(NEXT_ID.incrementAndGet());
+		specialty.setName(SOME_SPECIALTY_NAME);
+		return specialty;
+	}
+
+	private static Vet aVet() {
+		Vet vet = new Vet();
+		vet.setId(NEXT_ID.incrementAndGet());
+		vet.setFirstName(SOME_FIRST_NAME);
+		vet.setLastName(SOME_LAST_NAME);
+		return vet;
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByItsStoredName() {
+		String storedName = "Soft Tissue SURGERY";
+		String otherStoredName = "radiology";
+		Specialty specialty = aSpecialty();
+		specialty.setName(storedName);
+		Specialty otherSpecialty = aSpecialty();
+		otherSpecialty.setName(otherStoredName);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.fromSpecialtiesAndVets(List.of(specialty, otherSpecialty),
+				List.of());
+
+		assertThat(directory.listings()).containsExactlyInAnyOrder(new Listing(storedName, List.of()),
+				new Listing(otherStoredName, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHoldingVeterinarianByFullName() {
+		String firstName = "Helen";
+		String lastName = "Leary";
+		String fullName = "Helen Leary";
+		Specialty specialty = aSpecialty();
+		Vet holder = aVet();
+		holder.setFirstName(firstName);
+		holder.setLastName(lastName);
+		holder.addSpecialty(specialty);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.fromSpecialtiesAndVets(List.of(specialty), List.of(holder));
+
+		assertThat(directory.listings()).containsExactly(new Listing(SOME_SPECIALTY_NAME, List.of(fullName)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		String firstName = "first specialty";
+		String secondName = "second specialty";
+		Specialty first = aSpecialty();
+		first.setName(firstName);
+		Specialty second = aSpecialty();
+		second.setName(secondName);
+		Vet holder = aVet();
+		holder.addSpecialty(first);
+		holder.addSpecialty(second);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.fromSpecialtiesAndVets(List.of(first, second),
+				List.of(holder));
+
+		assertThat(directory.listings()).containsExactlyInAnyOrder(new Listing(firstName, List.of(holder.fullName())),
+				new Listing(secondName, List.of(holder.fullName())));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldLeaveOutVeterinariansHoldingNoSpecialty() {
+		Specialty specialty = aSpecialty();
+		Vet holder = aVet();
+		holder.addSpecialty(specialty);
+		Vet nonHolder = aVet();
+
+		SpecialtyDirectory directory = SpecialtyDirectory.fromSpecialtiesAndVets(List.of(specialty),
+				List.of(holder, nonHolder));
+
+		assertThat(directory.listings()).containsExactly(new Listing(SOME_SPECIALTY_NAME, List.of(holder.fullName())));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		String heldName = "held specialty";
+		String unheldName = "unheld specialty";
+		Specialty held = aSpecialty();
+		held.setName(heldName);
+		Specialty unheld = aSpecialty();
+		unheld.setName(unheldName);
+		Vet holder = aVet();
+		holder.addSpecialty(held);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.fromSpecialtiesAndVets(List.of(held, unheld),
+				List.of(holder));
+
+		assertThat(directory.listings()).containsExactlyInAnyOrder(new Listing(heldName, List.of(holder.fullName())),
+				new Listing(unheldName, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldMatchAHeldSpecialtyByIdentifierAcrossInstances() {
+		Specialty fromRepository = aSpecialty();
+		Specialty heldCopy = aSpecialty();
+		heldCopy.setId(fromRepository.getId());
+		Vet holder = aVet();
+		holder.addSpecialty(heldCopy);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.fromSpecialtiesAndVets(List.of(fromRepository),
+				List.of(holder));
+
+		assertThat(directory.listings()).containsExactly(new Listing(SOME_SPECIALTY_NAME, List.of(holder.fullName())));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepSpecialtiesSharingANameApart() {
+		Specialty held = aSpecialty();
+		Specialty unheldNamesake = aSpecialty();
+		Vet holder = aVet();
+		holder.addSpecialty(held);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.fromSpecialtiesAndVets(List.of(held, unheldNamesake),
+				List.of(holder));
+
+		assertThat(directory.listings()).containsExactlyInAnyOrder(
+				new Listing(SOME_SPECIALTY_NAME, List.of(holder.fullName())),
+				new Listing(SOME_SPECIALTY_NAME, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldStayUnchangedWhenItsSourceListsChange() {
+		String holderName = "Some Holder";
+		List<String> holders = new ArrayList<>(List.of(holderName));
+		List<Listing> listings = new ArrayList<>(List.of(new Listing(SOME_SPECIALTY_NAME, holders)));
+		SpecialtyDirectory directory = new SpecialtyDirectory(listings);
+
+		holders.clear();
+		listings.clear();
+
+		assertThat(directory)
+			.isEqualTo(new SpecialtyDirectory(List.of(new Listing(SOME_SPECIALTY_NAME, List.of(holderName)))));
+	}
+
+	@Test
+	void theNativeImageHintsShouldOpenTheSpecialtyDirectoryToTemplates() {
+		RuntimeHints hints = new RuntimeHints();
+
+		new PetClinicRuntimeHints().registerHints(hints, getClass().getClassLoader());
+
+		assertThat(RuntimeHintsPredicates.reflection()
+			.onType(SpecialtyDirectory.class)
+			.withMemberCategory(MemberCategory.INVOKE_PUBLIC_METHODS)).accepts(hints);
+		assertThat(RuntimeHintsPredicates.reflection()
+			.onType(Listing.class)
+			.withMemberCategory(MemberCategory.INVOKE_PUBLIC_METHODS)).accepts(hints);
+	}
+
+}
