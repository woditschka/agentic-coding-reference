+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.Collection;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.context.MessageSource;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Import;
+import org.springframework.core.io.support.PathMatchingResourcePatternResolver;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder;
+
+/**
+ * Tests {@link SpecialtyController} and its template over the in-process MVC harness,
+ * with in-memory repositories.
+ */
+@WebMvcTest(SpecialtyController.class)
+@Import(SpecialtyControllerTests.InMemoryRepositories.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String DIRECTORY_URL = "/specialties.html";
+
+	private static final String DIRECTORY_ROUTE_STEM = "/specialties";
+
+	private static final String DIRECTORY_VIEW = "vets/specialtyDirectory";
+
+	private static final String SOME_SPECIALTY_NAME = "some specialty";
+
+	private static final String SOME_FIRST_NAME = "Some";
+
+	private static final String SOME_LAST_NAME = "Veterinarian";
+
+	private static final String PAGE_LINK_PARAMETER = "page=";
+
+	private static final String LANGUAGE_PARAMETER = "lang";
+
+	private static final String HEADING_MESSAGE_KEY = "specialties";
+
+	private static final String FORM_TAG = "<form";
+
+	private static final String INPUT_TAG = "<input";
+
+	private static final String TEMPLATES_PATTERN = "classpath:templates/**/*.html";
+
+	private static final String OWNER_SEARCH_LINK = "href=\"/owners/find\"";
+
+	private static final String VETERINARIAN_LIST_LINK = "href=\"/vets.html\"";
+
+	private static final String ACTIVE_NAVIGATION_ITEM = "nav-link active";
+
+	private static final int MORE_THAN_A_VET_LIST_PAGE = 7;
+
+	private static final AtomicInteger NEXT_ID = new AtomicInteger();
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private MessageSource messages;
+
+	@Autowired
+	private InMemorySpecialties specialties;
+
+	@Autowired
+	private InMemoryVets vets;
+
+	private static Specialty aSpecialty() {
+		Specialty specialty = new Specialty();
+		specialty.setId(NEXT_ID.incrementAndGet());
+		specialty.setName(SOME_SPECIALTY_NAME);
+		return specialty;
+	}
+
+	private static Vet aVet() {
+		Vet vet = new Vet();
+		vet.setId(NEXT_ID.incrementAndGet());
+		vet.setFirstName(SOME_FIRST_NAME);
+		vet.setLastName(SOME_LAST_NAME + vet.getId());
+		return vet;
+	}
+
+	private String renderedPage(MockHttpServletRequestBuilder request) throws Exception {
+		return this.mockMvc.perform(request)
+			.andExpect(status().isOk())
+			.andExpect(view().name(DIRECTORY_VIEW))
+			.andReturn()
+			.getResponse()
+			.getContentAsString(StandardCharsets.UTF_8);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEverySpecialtyAndHoldingVeterinarianOnOnePage() throws Exception {
+		String heldName = "held specialty";
+		String unheldName = "unheld specialty";
+		Specialty held = aSpecialty();
+		held.setName(heldName);
+		Specialty unheld = aSpecialty();
+		unheld.setName(unheldName);
+		List<Vet> holders = Stream.generate(SpecialtyControllerTests::aVet).limit(MORE_THAN_A_VET_LIST_PAGE).toList();
+		holders.forEach(holder -> holder.addSpecialty(held));
+		this.specialties.stored = List.of(held, unheld);
+		this.vets.stored = holders;
+
+		String page = renderedPage(get(DIRECTORY_URL));
+
+		assertThat(page).contains(heldName, unheldName)
+			.contains(holders.stream().map(Vet::fullName).toList())
+			.doesNotContain(PAGE_LINK_PARAMETER);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowAStoredNameUnchangedInAnotherLanguage() throws Exception {
+		String storedName = "Soft Tissue SURGERY";
+		Specialty specialty = aSpecialty();
+		specialty.setName(storedName);
+		this.specialties.stored = List.of(specialty);
+		this.vets.stored = List.of();
+
+		String page = renderedPage(get(DIRECTORY_URL).param(LANGUAGE_PARAMETER, Locale.GERMAN.getLanguage()));
+
+		assertThat(page).contains(storedName)
+			.contains(this.messages.getMessage(HEADING_MESSAGE_KEY, null, Locale.GERMAN));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldEscapeMarkupInAStoredName() throws Exception {
+		String markupName = "<script>alert(1)</script>";
+		String escapedName = "&lt;script&gt;";
+		Specialty specialty = aSpecialty();
+		specialty.setName(markupName);
+		this.specialties.stored = List.of(specialty);
+		this.vets.stored = List.of();
+
+		String page = renderedPage(get(DIRECTORY_URL));
+
+		assertThat(page).doesNotContain(markupName).contains(escapedName);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOfferNoWayToChangeARecord() throws Exception {
+		this.specialties.stored = List.of(aSpecialty());
+		this.vets.stored = List.of();
+
+		String page = renderedPage(get(DIRECTORY_URL));
+
+		assertThat(page).doesNotContainIgnoringCase(FORM_TAG).doesNotContainIgnoringCase(INPUT_TAG);
+		this.mockMvc.perform(post(DIRECTORY_URL)).andExpect(status().isMethodNotAllowed());
+	}
+
+	@Test
+	void theOtherPagesShouldCarryNoEntryToTheSpecialtyDirectory() throws IOException {
+		var templates = new PathMatchingResourcePatternResolver().getResources(TEMPLATES_PATTERN);
+
+		assertThat(templates).isNotEmpty()
+			.allSatisfy(template -> assertThat(template.getContentAsString(StandardCharsets.UTF_8))
+				.doesNotContain(DIRECTORY_ROUTE_STEM));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheStandardNavigation() throws Exception {
+		this.specialties.stored = List.of();
+		this.vets.stored = List.of();
+
+		String page = renderedPage(get(DIRECTORY_URL));
+
+		assertThat(page).contains(OWNER_SEARCH_LINK, VETERINARIAN_LIST_LINK).doesNotContain(ACTIVE_NAVIGATION_ITEM);
+	}
+
+	static class InMemorySpecialties implements SpecialtyRepository {
+
+		private List<Specialty> stored = List.of();
+
+		@Override
+		public List<Specialty> findAllByOrderByNameAsc() {
+			return this.stored;
+		}
+
+	}
+
+	static class InMemoryVets implements VetRepository {
+
+		private Collection<Vet> stored = List.of();
+
+		@Override
+		public Collection<Vet> findAll() {
+			return this.stored;
+		}
+
+		@Override
+		public Page<Vet> findAll(Pageable pageable) {
+			throw new UnsupportedOperationException("the specialty directory reads veterinarians unpaged");
+		}
+
+	}
+
+	@TestConfiguration(proxyBeanMethods = false)
+	static class InMemoryRepositories {
+
+		@Bean
+		InMemorySpecialties specialties() {
+			return new InMemorySpecialties();
+		}
+
+		@Bean
+		InMemoryVets vets() {
+			return new InMemoryVets();
+		}
+
+	}
+
+}
