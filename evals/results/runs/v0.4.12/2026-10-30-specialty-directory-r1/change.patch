+package org.springframework.samples.petclinic.vet;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+
+/**
+ * Tests {@link SpecialtyRepository} against the seeded database.
+ */
+@DataJpaTest
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class SpecialtyRepositoryTests {
+
+	private static final String FIRST_SEEDED_NAME = "dentistry";
+
+	private static final String SECOND_SEEDED_NAME = "radiology";
+
+	private static final String THIRD_SEEDED_NAME = "surgery";
+
+	@Autowired
+	private SpecialtyRepository specialties;
+
+	@Test
+	void theSpecialtyRepositoryShouldReturnEverySpecialtyInNameOrder() {
+		assertThat(this.specialties.findAllByOrderByNameAsc()).extracting(Specialty::getName)
+			.containsExactly(FIRST_SEEDED_NAME, SECOND_SEEDED_NAME, THIRD_SEEDED_NAME);
+	}
+
+}
