+import static org.assertj.core.api.Assertions.tuple;
+import static org.junit.jupiter.params.provider.Arguments.argumentSet;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import java.time.LocalDate;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.web.servlet.MockMvc;
+
+/**
+ * Drives the correction routes against the real {@link OwnerRepository}. Deliberately not
+ * transactional: a test transaction would keep loaded entities managed, and a refused
+ * correction would flush, which production never does.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+@DisabledInNativeImage
+@DisabledInAotMode
+class VisitCorrectionIntegrationTests {
+
+	private static final String CORRECTION_URL = "/owners/{ownerId}/pets/{petId}/visits/{visitId}/edit";
+
+	private static final LocalDate PAST_DATE = LocalDate.now().minusDays(30);
+
+	private static final LocalDate CORRECTED_DATE = LocalDate.now().plusDays(30);
+
+	private static final String BOOKED_DESCRIPTION = "booked description";
+
+	private static final String CORRECTED_DESCRIPTION = "corrected description";
+
+	private static final String DATELESS_DESCRIPTION = "dateless description";
+
+	private static final String BLANK = "";
+
+	private static final String OWNER_LAST_NAME = "Franklin";
+
+	private static final String TAMPERED_LAST_NAME = "Tampered";
+
+	private static final String SOME_FIRST_NAME = "George";
+
+	private static final String SOME_ADDRESS = "110 W. Liberty St.";
+
+	private static final String SOME_CITY = "Madison";
+
+	private static final String SOME_TELEPHONE = "6085551023";
+
+	private static final String SOME_PET_NAME = "Leo";
+
+	private static final LocalDate SOME_BIRTH_DATE = LocalDate.of(2010, 9, 7);
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private OwnerRepository owners;
+
+	@Autowired
+	private PetTypeRepository types;
+
+	private int ownerId;
+
+	private int petId;
+
+	private int visitId;
+
+	@BeforeEach
+	void storeABookedVisit() {
+		Visit visit = aPastVisit();
+		Pet pet = aPet();
+		pet.addVisit(visit);
+		Owner owner = anOwner();
+		owner.addPet(pet);
+		this.owners.save(owner);
+		this.ownerId = owner.getId();
+		this.petId = pet.getId();
+		this.visitId = visit.getId();
+	}
+
+	@AfterEach
+	void deleteTheOwner() {
+		this.owners.deleteById(this.ownerId);
+	}
+
+	private static Visit aPastVisit() {
+		Visit visit = new Visit();
+		visit.setDate(PAST_DATE);
+		visit.setDescription(BOOKED_DESCRIPTION);
+		return visit;
+	}
+
+	private Pet aPet() {
+		Pet pet = new Pet();
+		pet.setName(SOME_PET_NAME);
+		pet.setBirthDate(SOME_BIRTH_DATE);
+		pet.setType(this.types.findPetTypes().getFirst());
+		return pet;
+	}
+
+	private static Owner anOwner() {
+		Owner owner = new Owner();
+		owner.setFirstName(SOME_FIRST_NAME);
+		owner.setLastName(OWNER_LAST_NAME);
+		owner.setAddress(SOME_ADDRESS);
+		owner.setCity(SOME_CITY);
+		owner.setTelephone(SOME_TELEPHONE);
+		return owner;
+	}
+
+	private Owner storedOwner() {
+		return this.owners.findById(this.ownerId).orElseThrow();
+	}
+
+	private Pet storedPet() {
+		return storedOwner().getPet(this.petId);
+	}
+
+	private Visit storedVisit() {
+		return storedPet().findVisit(this.visitId).orElseThrow();
+	}
+
+	@Test
+	void theVisitCorrectionShouldUpdateTheVisitAndRedirectToTheOwnerRecord() throws Exception {
+		this.mockMvc
+			.perform(post(CORRECTION_URL, this.ownerId, this.petId, this.visitId)
+				.param("date", CORRECTED_DATE.toString())
+				.param("description", CORRECTED_DESCRIPTION))
+			.andExpect(status().is3xxRedirection())
+			.andExpect(view().name("redirect:/owners/{ownerId}"));
+
+		assertThat(storedVisit()).returns(CORRECTED_DATE, Visit::getDate)
+			.returns(CORRECTED_DESCRIPTION, Visit::getDescription);
+	}
+
+	@Test
+	void theVisitCorrectionShouldNotAddAVisitToThePet() throws Exception {
+		this.mockMvc
+			.perform(post(CORRECTION_URL, this.ownerId, this.petId, this.visitId)
+				.param("date", CORRECTED_DATE.toString())
+				.param("description", CORRECTED_DESCRIPTION))
+			.andExpect(status().is3xxRedirection());
+
+		assertThat(storedPet().getVisits()).extracting(Visit::getId).containsExactly(this.visitId);
+	}
+
+	@ParameterizedTest
+	@MethodSource("refusedCorrections")
+	void theRefusedVisitCorrectionShouldLeaveTheStoredVisitUnchanged(String date, String description) throws Exception {
+		this.mockMvc
+			.perform(post(CORRECTION_URL, this.ownerId, this.petId, this.visitId).param("date", date)
+				.param("description", description))
+			.andExpect(status().isOk());
+
+		assertThat(storedVisit()).returns(PAST_DATE, Visit::getDate).returns(BOOKED_DESCRIPTION, Visit::getDescription);
+	}
+
+	static Stream<Arguments> refusedCorrections() {
+		return Stream.of(argumentSet("a blank description", CORRECTED_DATE.toString(), BLANK),
+				argumentSet("a date of today", LocalDate.now().toString(), CORRECTED_DESCRIPTION),
+				argumentSet("an empty date", BLANK, CORRECTED_DESCRIPTION));
+	}
+
+	@Test
+	void theVisitBookingShouldRecordAVisitSubmittedWithNoDate() throws Exception {
+		this.mockMvc
+			.perform(post("/owners/{ownerId}/pets/{petId}/visits/new", this.ownerId, this.petId).param("date", BLANK)
+				.param("description", DATELESS_DESCRIPTION))
+			.andExpect(status().is3xxRedirection());
+
+		assertThat(storedPet().getVisits()).extracting(Visit::getDate, Visit::getDescription)
+			.contains(tuple(null, DATELESS_DESCRIPTION));
+	}
+
+	@Test
+	void theVisitCorrectionShouldLeaveOwnerFieldsInTheRequestUnbound() throws Exception {
+		this.mockMvc
+			.perform(post(CORRECTION_URL, this.ownerId, this.petId, this.visitId)
+				.param("date", CORRECTED_DATE.toString())
+				.param("description", CORRECTED_DESCRIPTION)
+				.param("lastName", TAMPERED_LAST_NAME))
+			.andExpect(status().is3xxRedirection());
+
+		assertThat(storedOwner().getLastName()).isEqualTo(OWNER_LAST_NAME);
+	}
+
+}
