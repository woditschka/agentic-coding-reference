+package org.springframework.samples.petclinic.owner;
+
+import java.time.LocalDate;
+
+import org.springframework.validation.Errors;
+import org.springframework.validation.Validator;
+
+/**
+ * <code>Validator</code> for the date of a <code>Visit</code> form, on booking and
+ * correction alike: a date, when there is one, is later than today.
+ */
+class VisitValidator implements Validator {
+
+	private static final String DATE = "date";
+
+	private final LocalDate today;
+
+	VisitValidator(LocalDate today) {
+		this.today = today;
+	}
+
+	@Override
+	public void validate(Object obj, Errors errors) {
+		if (errors.hasFieldErrors(DATE)) {
+			return;
+		}
+		LocalDate date = ((Visit) obj).getDate();
+		if (date != null && !date.isAfter(this.today)) {
+			errors.rejectValue(DATE, "typeMismatch.visitDate");
+		}
+	}
+
+	@Override
+	public boolean supports(Class<?> clazz) {
+		return Visit.class.isAssignableFrom(clazz);
+	}
+
+}
