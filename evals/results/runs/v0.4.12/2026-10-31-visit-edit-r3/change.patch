+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class PetTests {
+
+	private static final int VISIT_ID = 1;
+
+	private static final int OTHER_VISIT_ID = 2;
+
+	private static final int UNKNOWN_VISIT_ID = 3;
+
+	private final Pet pet = aPet();
+
+	private static Pet aPet() {
+		return new Pet();
+	}
+
+	private static Visit aVisit() {
+		return new Visit();
+	}
+
+	@Test
+	void theFoundVisitShouldBeTheOneWithTheGivenId() {
+		Visit otherVisit = aVisit();
+		otherVisit.setId(OTHER_VISIT_ID);
+		Visit visit = aVisit();
+		visit.setId(VISIT_ID);
+		this.pet.addVisit(otherVisit);
+		this.pet.addVisit(visit);
+
+		assertThat(this.pet.findVisit(VISIT_ID)).containsSame(visit);
+	}
+
+	@Test
+	void thePetWithNoVisitsShouldFindNone() {
+		assertThat(this.pet.findVisit(VISIT_ID)).isEmpty();
+	}
+
+	@Test
+	void theUnknownVisitIdShouldFindNone() {
+		Visit visit = aVisit();
+		visit.setId(VISIT_ID);
+		this.pet.addVisit(visit);
+
+		assertThat(this.pet.findVisit(UNKNOWN_VISIT_ID)).isEmpty();
+	}
+
+	@Test
+	void theUnsavedVisitShouldNotHideASavedVisit() {
+		Visit unsavedVisit = aVisit();
+		Visit savedVisit = aVisit();
+		savedVisit.setId(VISIT_ID);
+		this.pet.addVisit(unsavedVisit);
+		this.pet.addVisit(savedVisit);
+
+		assertThat(this.pet.findVisit(VISIT_ID)).containsSame(savedVisit);
+	}
+
+}
