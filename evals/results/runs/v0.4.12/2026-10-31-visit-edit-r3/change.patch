+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.time.LocalDate;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.validation.BeanPropertyBindingResult;
+import org.springframework.validation.Errors;
+import org.springframework.validation.FieldError;
+
+class VisitValidatorTests {
+
+	private static final LocalDate TODAY = LocalDate.of(2030, 6, 15);
+
+	private static final String NOT_LATER_THAN_TODAY = "typeMismatch.visitDate";
+
+	private static final String BINDING_ERROR = "typeMismatch";
+
+	private final VisitValidator validator = new VisitValidator(TODAY);
+
+	private final Visit visit = aVisit();
+
+	private final Errors errors = new BeanPropertyBindingResult(this.visit, "visit");
+
+	private static Visit aVisit() {
+		return new Visit();
+	}
+
+	@Test
+	void theVisitValidatorShouldAcceptTheDayAfterToday() {
+		this.visit.setDate(TODAY.plusDays(1));
+
+		this.validator.validate(this.visit, this.errors);
+
+		assertThat(this.errors.hasErrors()).isFalse();
+	}
+
+	@ParameterizedTest
+	@ValueSource(longs = { 0, 1 })
+	void theVisitValidatorShouldRefuseTodayAndYesterday(long daysBeforeToday) {
+		this.visit.setDate(TODAY.minusDays(daysBeforeToday));
+
+		this.validator.validate(this.visit, this.errors);
+
+		assertThat(this.errors.getFieldErrors("date")).extracting(FieldError::getCode)
+			.containsExactly(NOT_LATER_THAN_TODAY);
+	}
+
+	@Test
+	void theVisitValidatorShouldLeaveAMissingDateUnrefused() {
+		this.visit.setDate(null);
+
+		this.validator.validate(this.visit, this.errors);
+
+		assertThat(this.errors.hasErrors()).isFalse();
+	}
+
+	@Test
+	void theVisitValidatorShouldLeaveAnUnparseableDateToItsBindingError() {
+		this.visit.setDate(null);
+		this.errors.rejectValue("date", BINDING_ERROR);
+
+		this.validator.validate(this.visit, this.errors);
+
+		assertThat(this.errors.getFieldErrors("date")).extracting(FieldError::getCode).containsExactly(BINDING_ERROR);
+	}
+
+	@Test
+	void theVisitValidatorShouldApplyToVisitsAlone() {
+		assertThat(this.validator.supports(Visit.class)).isTrue();
+		assertThat(this.validator.supports(Pet.class)).isFalse();
+	}
+
+}
