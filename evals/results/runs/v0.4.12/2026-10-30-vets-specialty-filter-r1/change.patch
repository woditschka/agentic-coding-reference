+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.data.domain.Pageable;
+
+/**
+ * Drives the specialty filter's query against the seeded veterinarians on the real
+ * database, where radiology is held by Leary and Stevens, and dentistry only by Douglas,
+ * who also holds surgery.
+ */
+@DataJpaTest
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+class VetRepositoryTests {
+
+	private static final String RADIOLOGY_IN_MIXED_CASE = "RaDiOlOgY";
+
+	private static final String RADIOLOGY_PREFIX = "radio";
+
+	private static final String RADIOLOGY_WITH_SPACES = " radiology ";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String RADIOLOGY_HOLDER = "Leary";
+
+	private static final String OTHER_RADIOLOGY_HOLDER = "Stevens";
+
+	private static final String RADIOLOGY_WITH_LEADING_SPACES = "  radiology";
+
+	private static final String RADIOLOGY_WITH_TRAILING_SPACES = "radiology  ";
+
+	private static final String STORED_ONCOLOGY = "Oncology";
+
+	private static final String ONCOLOGY_IN_LOWER_CASE = "oncology";
+
+	private static final String ONCOLOGIST = "Osler";
+
+	private static final String STORED_CARDIOLOGY = "Cardiology";
+
+	private static final String STORED_ONCOLOGY_IN_CAPITALS = "ONCOLOGY";
+
+	private static final String SECOND_ONCOLOGIST = "Paget";
+
+	private static final String THIRD_ONCOLOGIST = "Virchow";
+
+	private static final int TWO_HOLDERS_PER_PAGE = 2;
+
+	private static final Pageable FIRST_PAGE_OF_TWO = PageRequest.of(0, TWO_HOLDERS_PER_PAGE);
+
+	private static final long ONCOLOGIST_COUNT = 3;
+
+	private static final int ONCOLOGIST_PAGE_COUNT = 2;
+
+	private static final String ANY_FIRST_NAME = "Ann";
+
+	private static final String ANY_LAST_NAME = "Lee";
+
+	private static final Pageable ROOMY_PAGE = PageRequest.of(0, 20);
+
+	@Autowired
+	private VetRepository vets;
+
+	@Autowired
+	private TestEntityManager entityManager;
+
+	static Stream<Arguments> specialtyValuesAndTheirHolders() {
+		return Stream.of(Arguments.of(ONCOLOGY_IN_LOWER_CASE, List.of(ONCOLOGIST)),
+				Arguments.of(RADIOLOGY_IN_MIXED_CASE, List.of(RADIOLOGY_HOLDER, OTHER_RADIOLOGY_HOLDER)),
+				Arguments.of(RADIOLOGY_PREFIX, List.of()), Arguments.of(RADIOLOGY_WITH_LEADING_SPACES, List.of()),
+				Arguments.of(RADIOLOGY_WITH_TRAILING_SPACES, List.of()),
+				Arguments.of(RADIOLOGY_WITH_SPACES, List.of()));
+	}
+
+	@ParameterizedTest
+	@MethodSource("specialtyValuesAndTheirHolders")
+	void theFilteredVetPageShouldMatchDisregardingLetterCaseButNeverAPrefixOrASpacePaddedName(String value,
+			List<String> holders) {
+		aPersistedHolder(ONCOLOGIST, aPersistedSpecialty(STORED_ONCOLOGY));
+
+		assertThat(this.vets.findBySpecialtyName(value, ROOMY_PAGE)).extracting(Vet::getLastName)
+			.containsExactlyElementsOf(holders);
+	}
+
+	@Test
+	void theVetDirectoryPageShouldPaginateTheFilteredList() {
+		Specialty oncology = aPersistedSpecialty(STORED_ONCOLOGY);
+		aPersistedHolder(ONCOLOGIST, oncology);
+		aPersistedHolder(SECOND_ONCOLOGIST, oncology);
+		aPersistedHolder(THIRD_ONCOLOGIST, oncology);
+
+		Page<Vet> firstPage = this.vets.findBySpecialtyName(ONCOLOGY_IN_LOWER_CASE, FIRST_PAGE_OF_TWO);
+
+		assertThat(firstPage).extracting(Vet::getLastName).containsExactly(ONCOLOGIST, SECOND_ONCOLOGIST);
+		assertThat(firstPage.getTotalElements()).isEqualTo(ONCOLOGIST_COUNT);
+		assertThat(firstPage.getTotalPages()).isEqualTo(ONCOLOGIST_PAGE_COUNT);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldListAMatchingVetOnceAcrossPages() {
+		Specialty oncology = aPersistedSpecialty(STORED_ONCOLOGY);
+		Specialty oncologyInCapitals = aPersistedSpecialty(STORED_ONCOLOGY_IN_CAPITALS);
+		Specialty cardiology = aPersistedSpecialty(STORED_CARDIOLOGY);
+		aPersistedHolder(ONCOLOGIST, oncology, oncologyInCapitals, cardiology);
+		aPersistedHolder(SECOND_ONCOLOGIST, oncology);
+		aPersistedHolder(THIRD_ONCOLOGIST, oncology);
+
+		Page<Vet> firstPage = this.vets.findBySpecialtyName(ONCOLOGY_IN_LOWER_CASE, FIRST_PAGE_OF_TWO);
+		Page<Vet> secondPage = this.vets.findBySpecialtyName(ONCOLOGY_IN_LOWER_CASE, firstPage.nextPageable());
+
+		assertThat(Stream.concat(firstPage.stream(), secondPage.stream())).extracting(Vet::getLastName)
+			.containsExactly(ONCOLOGIST, SECOND_ONCOLOGIST, THIRD_ONCOLOGIST);
+		assertThat(firstPage.getContent().getFirst().getSpecialties()).extracting(Specialty::getName)
+			.containsExactly(STORED_CARDIOLOGY, STORED_ONCOLOGY_IN_CAPITALS, STORED_ONCOLOGY);
+		assertThat(secondPage.isLast()).isTrue();
+	}
+
+	@Test
+	void theSpecialtyFilterShouldDisregardLetterCase() {
+		assertThat(this.vets.findBySpecialtyName(RADIOLOGY_IN_MIXED_CASE)).extracting(Vet::getLastName)
+			.containsExactly(RADIOLOGY_HOLDER, OTHER_RADIOLOGY_HOLDER);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldNotMatchOnAPrefix() {
+		assertThat(this.vets.findBySpecialtyName(RADIOLOGY_PREFIX)).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyFilterShouldListAllSpecialtiesOfAMatchingVet() {
+		assertThat(this.vets.findBySpecialtyName(DENTISTRY)).singleElement()
+			.extracting(Vet::getSpecialties, list(Specialty.class))
+			.extracting(Specialty::getName)
+			.containsExactly(DENTISTRY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldNotIgnoreSpacesAroundTheName() {
+		assertThat(this.vets.findBySpecialtyName(RADIOLOGY_WITH_SPACES)).isEmpty();
+	}
+
+	private Specialty aPersistedSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return this.entityManager.persist(specialty);
+	}
+
+	private Vet aVet() {
+		Vet vet = new Vet();
+		vet.setFirstName(ANY_FIRST_NAME);
+		vet.setLastName(ANY_LAST_NAME);
+		return vet;
+	}
+
+	private void aPersistedHolder(String lastName, Specialty... specialties) {
+		Vet vet = aVet();
+		vet.setLastName(lastName);
+		Arrays.stream(specialties).forEach(vet::addSpecialty);
+		this.entityManager.persist(vet);
+	}
+
+}
