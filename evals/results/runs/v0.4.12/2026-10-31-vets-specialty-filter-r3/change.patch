+/**
+ * Drives the Veterinarian directory over the real repository, cache, and template. The
+ * filter's matching lives in a query, so a stubbed repository could not prove it.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+@Transactional
+@DisabledInNativeImage
+@DisabledInAotMode
+class VetDirectoryIntegrationTests {
+
+	private static final String DIRECTORY_PATH = "/vets.html";
+
+	private static final String SPECIALTY_PARAMETER = "specialty";
+
+	private static final String PAGE_PARAMETER = "page";
+
+	private static final String VETS_CACHE = "vets";
+
+	private static final String LISTED_VETS_ATTRIBUTE = "listVets";
+
+	private static final String TOTAL_PAGES_ATTRIBUTE = "totalPages";
+
+	private static final String TOTAL_ITEMS_ATTRIBUTE = "totalItems";
+
+	private static final String CURRENT_PAGE_ATTRIBUTE = "currentPage";
+
+	private static final String LINK_GROUP = "link";
+
+	private static final int LISTED_ONCE = 1;
+
+	private static final String SECOND_PAGE_LINK = DIRECTORY_PATH + "?page=2";
+
+	private static final Pattern PAGINATION_LINK = Pattern.compile("href=\"(?<link>" + DIRECTORY_PATH + "\\?[^\"]*)\"");
+
+	private static final int FIRST_PAGE = 1;
+
+	private static final int SECOND_PAGE = 2;
+
+	private static final int HOLDERS_SPANNING_TWO_PAGES = 6;
+
+	private static final String MIXED_CASE_NAME = "Mixed Case Specialty";
+
+	private static final String BEGINNING_OF_A_SEEDED_NAME = "radiolog";
+
+	private static final String SPACE_PADDED_SEEDED_NAME = " radiology ";
+
+	private static final String UNKNOWN_NAME = "no such specialty";
+
+	private static final String NUL_CHARACTER = "\0";
+
+	private static final String UNFILTERED_URI = DIRECTORY_PATH;
+
+	private static final String EMPTY_VALUE_URI = DIRECTORY_PATH + "?specialty=";
+
+	private static final String WHITESPACE_VALUE_URI = DIRECTORY_PATH + "?specialty=%20%20";
+
+	private static final int PAGE_BEYOND_THE_END = 99;
+
+	private static final int HOLDERS_SPANNING_THREE_PAGES = 11;
+
+	private static final int LINKS_ON_A_MIDDLE_PAGE = 6;
+
+	private static final String RESERVED_CHARACTERS_NAME = "a&b=c+d#e%f/g?h i";
+
+	private static final String WORD_SHOWN_FOR_NO_SPECIALTY = "none";
+
+	private static final String SOME_FIRST_NAME = "Some";
+
+	private static final String SOME_LAST_NAME = "Veterinarian";
+
+	private static final String SOME_SPECIALTY_NAME = "some specialty ";
+
+	private static final String UPPER_CASE_VARIANT = "MIXED CASE SPECIALTY";
+
+	private static final String LOWER_CASE_VARIANT = "mixed case specialty";
+
+	private static final String JSON_PATH = "/vets";
+
+	private static final String VET_IDS_JSON_PATH = "$.vetList[*].id";
+
+	private static final String SPECIALTY_NAMES_JSON_PATH = "$.vetList[*].specialties[*].name";
+
+	private static final int HOLDERS_BEYOND_ONE_PAGE = 6;
+
+	private static final String JSON_UNFILTERED_URI = JSON_PATH;
+
+	private static final String JSON_EMPTY_VALUE_URI = JSON_PATH + "?specialty=";
+
+	private static final String JSON_WHITESPACE_VALUE_URI = JSON_PATH + "?specialty=%20%20";
+
+	private static final AtomicInteger uniqueSuffix = new AtomicInteger();
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private VetRepository vetRepository;
+
+	@Autowired
+	private EntityManager entityManager;
+
+	@Autowired
+	private CacheManager cacheManager;
+
+	@BeforeEach
+	@AfterEach
+	void clearVetsCache() {
+		cacheManager.getCache(VETS_CACHE).clear();
+	}
+
+	@Test
+	void theVetDirectoryShouldShowOnlyVeterinariansHoldingTheRequestedSpecialty() throws Exception {
+		var requestedSpecialty = persistedSpecialty();
+		var holder = persistedVetHolding(requestedSpecialty);
+		persistedVetHolding(persistedSpecialty());
+
+		var directory = directoryFilteredBy(requestedSpecialty.getName());
+
+		assertThat(listedVetIds(directory)).containsExactly(holder.getId());
+	}
+
+	@Test
+	void theVetDirectoryShouldPaginateTheFilteredList() throws Exception {
+		var specialty = persistedSpecialty();
+		var holderIds = persistedVetIdsHolding(specialty, HOLDERS_SPANNING_TWO_PAGES);
+
+		var firstPage = directoryFilteredBy(specialty.getName(), FIRST_PAGE);
+		var secondPage = directoryFilteredBy(specialty.getName(), SECOND_PAGE);
+
+		assertThat(firstPage).containsEntry(TOTAL_PAGES_ATTRIBUTE, SECOND_PAGE);
+		assertThat(Stream.concat(listedVetIds(firstPage).stream(), listedVetIds(secondPage).stream()))
+			.containsExactlyElementsOf(holderIds);
+	}
+
+	@Test
+	void theSpecialtyFilterShouldMatchIgnoringLetterCaseUnderEverySupportedDatabase() throws Exception {
+		var holder = persistedVetHolding(persistedSpecialtyNamed(MIXED_CASE_NAME));
+
+		var directory = directoryFilteredBy(MIXED_CASE_NAME.toUpperCase());
+
+		assertThat(listedVetIds(directory)).containsExactly(holder.getId());
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { BEGINNING_OF_A_SEEDED_NAME, SPACE_PADDED_SEEDED_NAME, UNKNOWN_NAME, NUL_CHARACTER })
+	void theVetDirectoryShouldShowAnEmptyListForAPrefixASpacePaddedNameAnUnknownNameOrANulCharacter(
+			String unmatchedValue) throws Exception {
+		var directory = directoryFilteredBy(unmatchedValue);
+
+		assertThat(listedVets(directory)).isEmpty();
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { UNFILTERED_URI, EMPTY_VALUE_URI, WHITESPACE_VALUE_URI })
+	void theVetDirectoryShouldListEveryVeterinarianWithoutTheParameterOrWithAnEmptyOrWhitespaceOnlyValue(
+			String directoryUri) throws Exception {
+		var response = mockMvc.perform(get(URI.create(directoryUri))).andExpect(status().isOk()).andReturn();
+
+		assertThat(response.getModelAndView().getModel())
+			.containsEntry(TOTAL_ITEMS_ATTRIBUTE, (long) vetRepository.findAll().size())
+			.doesNotContainKey(SPECIALTY_PARAMETER);
+		assertThat(paginationLinks(response.getResponse().getContentAsString())).containsOnly(SECOND_PAGE_LINK);
+	}
+
+	@Test
+	void thePaginationLinksShouldCarryTheSpecialtyFilterPreservingReservedCharacters() throws Exception {
+		var specialty = persistedSpecialtyNamed(RESERVED_CHARACTERS_NAME);
+		var holderIds = persistedVetIdsHolding(specialty, HOLDERS_SPANNING_THREE_PAGES);
+		var middlePage = get(DIRECTORY_PATH).param(SPECIALTY_PARAMETER, RESERVED_CHARACTERS_NAME)
+			.param(PAGE_PARAMETER, String.valueOf(SECOND_PAGE));
+
+		var links = paginationLinks(mockMvc.perform(middlePage).andReturn().getResponse().getContentAsString());
+
+		assertThat(links).hasSize(LINKS_ON_A_MIDDLE_PAGE)
+			.allSatisfy(link -> assertThat(listedVetIds(directory(get(URI.create(link))))).isNotEmpty()
+				.isSubsetOf(holderIds));
+	}
+
+	@Test
+	void theSpecialtyFilterShouldKeepEachRequestsOwnResult() throws Exception {
+		var firstSpecialty = persistedSpecialty();
+		var secondSpecialty = persistedSpecialty();
+		var firstHolder = persistedVetHolding(firstSpecialty);
+		var secondHolder = persistedVetHolding(secondSpecialty);
+
+		var firstDirectory = directoryFilteredBy(firstSpecialty.getName());
+		var secondDirectory = directoryFilteredBy(secondSpecialty.getName());
+
+		assertThat(listedVetIds(firstDirectory)).containsExactly(firstHolder.getId());
+		assertThat(listedVetIds(secondDirectory)).containsExactly(secondHolder.getId());
+	}
+
+	@Test
+	void theSpecialtyFilterShouldListAVeterinarianOnceWithEverySpecialtyTheyHold() throws Exception {
+		var requestedSpecialty = persistedSpecialty();
+		var otherSpecialty = persistedSpecialty();
+		persistedVetHolding(requestedSpecialty, otherSpecialty);
+
+		var directory = directoryFilteredBy(requestedSpecialty.getName());
+
+		assertThat(listedVets(directory)).hasSize(LISTED_ONCE)
+			.flatExtracting(Vet::getSpecialties)
+			.extracting(Specialty::getName)
+			.containsExactlyInAnyOrder(requestedSpecialty.getName(), otherSpecialty.getName());
+	}
+
+	@Test
+	void theSpecialtyFilterShouldNotMatchAVeterinarianHoldingNoSpecialty() throws Exception {
+		persistedVetHolding();
+
+		var directory = directoryFilteredBy(WORD_SHOWN_FOR_NO_SPECIALTY);
+
+		assertThat(listedVets(directory)).isEmpty();
+	}
+
+	@Test
+	void theFilteredDirectoryShouldTreatAPageBeyondTheEndLikeTheUnfilteredDirectory() throws Exception {
+		var specialty = persistedSpecialty();
+		persistedVetIdsHolding(specialty, HOLDERS_SPANNING_TWO_PAGES);
+
+		var filtered = directoryFilteredBy(specialty.getName(), PAGE_BEYOND_THE_END);
+		var unfiltered = directory(get(DIRECTORY_PATH).param(PAGE_PARAMETER, String.valueOf(PAGE_BEYOND_THE_END)));
+
+		assertThat(listedVets(filtered)).isEmpty();
+		assertThat(listedVets(unfiltered)).isEmpty();
+		assertThat(filtered).containsEntry(CURRENT_PAGE_ATTRIBUTE, unfiltered.get(CURRENT_PAGE_ATTRIBUTE))
+			.containsEntry(TOTAL_ITEMS_ATTRIBUTE, (long) HOLDERS_SPANNING_TWO_PAGES);
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { JSON_UNFILTERED_URI, JSON_EMPTY_VALUE_URI, JSON_WHITESPACE_VALUE_URI })
+	void theVetJsonDocumentShouldListEveryVeterinarianWithTheirSpecialtiesAtOnceWithoutTheParameterOrWithAnEmptyOrWhitespaceOnlyValue(
+			String jsonUri) throws Exception {
+		var document = jsonDocument(get(URI.create(jsonUri)));
+
+		assertThat(document.<List<Integer>>read(VET_IDS_JSON_PATH))
+			.containsExactlyElementsOf(vetRepository.findAll().stream().map(Vet::getId).toList());
+		assertThat(document.<List<String>>read(SPECIALTY_NAMES_JSON_PATH))
+			.containsExactlyInAnyOrderElementsOf(vetRepository.findAll()
+				.stream()
+				.flatMap(vet -> vet.getSpecialties().stream())
+				.map(Specialty::getName)
+				.toList());
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { MIXED_CASE_NAME, UPPER_CASE_VARIANT, LOWER_CASE_VARIANT })
+	void theVetJsonDocumentShouldCarryOnlyHoldersOfTheRequestedSpecialtyForAnExactOrLetterCaseVariantValueWithoutPaging(
+			String requestedName) throws Exception {
+		var requestedSpecialty = persistedSpecialtyNamed(MIXED_CASE_NAME);
+		var holderIds = persistedVetIdsHolding(requestedSpecialty, HOLDERS_BEYOND_ONE_PAGE);
+		persistedVetHolding(persistedSpecialty());
+
+		var document = jsonDocument(jsonFilteredBy(requestedName));
+
+		assertThat(document.<List<Integer>>read(VET_IDS_JSON_PATH)).containsExactlyElementsOf(holderIds);
+	}
+
+	@Test
+	void theVetJsonDocumentShouldListAFilteredVeterinarianOnceWithEverySpecialtyTheyHold() throws Exception {
+		var requestedSpecialty = persistedSpecialty();
+		var otherSpecialty = persistedSpecialty();
+		var holder = persistedVetHolding(requestedSpecialty, otherSpecialty);
+
+		var document = jsonDocument(jsonFilteredBy(requestedSpecialty.getName()));
+
+		assertThat(document.<List<Integer>>read(VET_IDS_JSON_PATH)).containsExactly(holder.getId());
+		assertThat(document.<List<String>>read(SPECIALTY_NAMES_JSON_PATH))
+			.containsExactlyInAnyOrder(requestedSpecialty.getName(), otherSpecialty.getName());
+	}
+
+	@ParameterizedTest
+	@ValueSource(strings = { BEGINNING_OF_A_SEEDED_NAME, SPACE_PADDED_SEEDED_NAME, UNKNOWN_NAME, NUL_CHARACTER })
+	void theVetJsonDocumentShouldCarryAnEmptyListForAPrefixASpacePaddedNameAnUnknownNameOrANulCharacter(
+			String unmatchedValue) throws Exception {
+		var document = jsonDocument(jsonFilteredBy(unmatchedValue));
+
+		assertThat(document.<List<Integer>>read(VET_IDS_JSON_PATH)).isEmpty();
+	}
+
+	@Test
+	void theVetJsonDocumentShouldKeepEachRequestsOwnResult() throws Exception {
+		var firstSpecialty = persistedSpecialty();
+		var secondSpecialty = persistedSpecialty();
+		var firstHolder = persistedVetHolding(firstSpecialty);
+		var secondHolder = persistedVetHolding(secondSpecialty);
+
+		var firstDocument = jsonDocument(jsonFilteredBy(firstSpecialty.getName()));
+		var secondDocument = jsonDocument(jsonFilteredBy(secondSpecialty.getName()));
+
+		assertThat(firstDocument.<List<Integer>>read(VET_IDS_JSON_PATH)).containsExactly(firstHolder.getId());
+		assertThat(secondDocument.<List<Integer>>read(VET_IDS_JSON_PATH)).containsExactly(secondHolder.getId());
+	}
+
+	private MockHttpServletRequestBuilder jsonFilteredBy(String specialty) {
+		return get(JSON_PATH).param(SPECIALTY_PARAMETER, specialty);
+	}
+
+	private DocumentContext jsonDocument(MockHttpServletRequestBuilder request) throws Exception {
+		var body = mockMvc.perform(request.accept(MediaType.APPLICATION_JSON))
+			.andExpect(status().isOk())
+			.andReturn()
+			.getResponse()
+			.getContentAsString();
+		return JsonPath.parse(body);
+	}
+
+	private ModelMap directoryFilteredBy(String specialty) throws Exception {
+		return directory(get(DIRECTORY_PATH).param(SPECIALTY_PARAMETER, specialty));
+	}
+
+	private ModelMap directoryFilteredBy(String specialty, int page) throws Exception {
+		return directory(
+				get(DIRECTORY_PATH).param(SPECIALTY_PARAMETER, specialty).param(PAGE_PARAMETER, String.valueOf(page)));
+	}
+
+	private ModelMap directory(RequestBuilder request) throws Exception {
+		return mockMvc.perform(request).andExpect(status().isOk()).andReturn().getModelAndView().getModelMap();
+	}
+
+	private static List<Vet> listedVets(ModelMap directory) {
+		return ((List<?>) directory.get(LISTED_VETS_ATTRIBUTE)).stream().map(Vet.class::cast).toList();
+	}
+
+	private static List<Integer> listedVetIds(ModelMap directory) {
+		return listedVets(directory).stream().map(Vet::getId).toList();
+	}
+
+	private static List<String> paginationLinks(String page) {
+		return PAGINATION_LINK.matcher(page)
+			.results()
+			.map(link -> HtmlUtils.htmlUnescape(link.group(LINK_GROUP)))
+			.toList();
+	}
+
+	private Specialty persistedSpecialty() {
+		var specialty = aSpecialty();
+		entityManager.persist(specialty);
+		return specialty;
+	}
+
+	private Specialty persistedSpecialtyNamed(String name) {
+		var specialty = aSpecialty();
+		specialty.setName(name);
+		entityManager.persist(specialty);
+		return specialty;
+	}
+
+	private List<Integer> persistedVetIdsHolding(Specialty specialty, int vetCount) {
+		return IntStream.range(0, vetCount).mapToObj(vet -> persistedVetHolding(specialty).getId()).toList();
+	}
+
+	private Vet persistedVetHolding(Specialty... specialties) {
+		var vet = aVet();
+		Arrays.stream(specialties).forEach(vet::addSpecialty);
+		entityManager.persist(vet);
+		entityManager.flush();
+		entityManager.clear();
+		return vet;
+	}
+
+	private static Specialty aSpecialty() {
+		var specialty = new Specialty();
+		specialty.setName(SOME_SPECIALTY_NAME + uniqueSuffix.incrementAndGet());
+		return specialty;
+	}
+
+	private static Vet aVet() {
+		var vet = new Vet();
+		vet.setFirstName(SOME_FIRST_NAME);
+		vet.setLastName(SOME_LAST_NAME);
+		return vet;
+	}
+
+}
