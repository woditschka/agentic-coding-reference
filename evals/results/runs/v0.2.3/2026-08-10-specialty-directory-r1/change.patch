+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}, the specialty directory page.
+ * <p>
+ * The repositories are hand-written stubs rather than mocks: the page reads two fixed
+ * collections and asserts on what is rendered, so a stub says everything a mock would.
+ * Without a mocked bean the context survives AOT processing, so unlike the neighbouring
+ * slice tests this one needs no <code>@DisabledInAotMode</code>: <code>gradlew
+ * processTestAot</code> processes this context rather than skipping it, and succeeds.
+ */
+@WebMvcTest(SpecialtyController.class)
+@Import(SpecialtyControllerTests.ClinicWithOneUnheldSpecialty.class)
+@DisabledInNativeImage
+class SpecialtyControllerTests {
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEverySpecialtyOnOnePage() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attributeExists("specialtyListings"))
+			.andExpect(content().string(stringContainsInOrder("acupuncture", "radiology", "surgery")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowEachHolderUnderItsSpecialty() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(stringContainsInOrder("radiology", "Helen Leary", "surgery", "Rafael Ortega")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowNoHolderForASpecialtyNoVeterinarianHolds() throws Exception {
+		this.mockMvc.perform(get("/specialties.html"))
+			.andExpect(content().string(stringContainsInOrder("acupuncture", "none", "radiology")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotShowAVeterinarianHoldingNoSpecialty() throws Exception {
+		this.mockMvc.perform(get("/specialties.html")).andExpect(content().string(not(containsString("James Carter"))));
+	}
+
+	/**
+	 * A clinic knowing three specialties, one of them held by no veterinarian, and one
+	 * veterinarian holding no specialty.
+	 */
+	static class ClinicWithOneUnheldSpecialty {
+
+		private static final Specialty ACUPUNCTURE = specialty(4, "acupuncture");
+
+		private static final Specialty RADIOLOGY = specialty(1, "radiology");
+
+		private static final Specialty SURGERY = specialty(2, "surgery");
+
+		@Bean
+		SpecialtyRepository specialtyRepository() {
+			return () -> List.of(ACUPUNCTURE, RADIOLOGY, SURGERY);
+		}
+
+		@Bean
+		VetRepository vetRepository() {
+			return new VetRepository() {
+				@Override
+				public Collection<Vet> findAll() {
+					return List.of(vet(1, "Helen", "Leary", RADIOLOGY), vet(2, "Rafael", "Ortega", SURGERY),
+							vet(3, "James", "Carter"));
+				}
+
+				@Override
+				public Page<Vet> findAll(Pageable pageable) {
+					return new PageImpl<>(List.copyOf(findAll()), pageable, findAll().size());
+				}
+			};
+		}
+
+		private static Specialty specialty(int id, String name) {
+			Specialty specialty = new Specialty();
+			specialty.setId(id);
+			specialty.setName(name);
+			return specialty;
+		}
+
+		private static Vet vet(int id, String firstName, String lastName, Specialty... specialties) {
+			Vet vet = new Vet();
+			vet.setId(id);
+			vet.setFirstName(firstName);
+			vet.setLastName(lastName);
+			for (Specialty specialty : specialties) {
+				vet.addSpecialty(specialty);
+			}
+			return vet;
+		}
+
+	}
+
+}
