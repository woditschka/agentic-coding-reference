+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.tuple;
+
+/**
+ * Test class for {@link SpecialtyListing}, the specialty-to-holders inversion behind the
+ * specialty directory page.
+ */
+class SpecialtyListingTests {
+
+	private static final Specialty RADIOLOGY = specialty(1, "radiology");
+
+	private static final Specialty SURGERY = specialty(2, "surgery");
+
+	private static final Specialty DENTISTRY = specialty(3, "dentistry");
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		List<SpecialtyListing> listings = SpecialtyListing.of(List.of(DENTISTRY, RADIOLOGY, SURGERY),
+				List.of(vet(1, "Helen", "Leary", RADIOLOGY), vet(2, "Linda", "Douglas", DENTISTRY, SURGERY)));
+
+		assertThat(listings).extracting(SpecialtyListing::getName).containsExactly("dentistry", "radiology", "surgery");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEachHolderByFirstAndLastName() {
+		Vet helen = vet(1, "Helen", "Leary", RADIOLOGY);
+		Vet rafael = vet(2, "Rafael", "Ortega", SURGERY);
+
+		List<SpecialtyListing> listings = SpecialtyListing.of(List.of(RADIOLOGY, SURGERY), List.of(helen, rafael));
+
+		assertThat(listings).extracting(SpecialtyListing::getName, SpecialtyListing::getHolders)
+			.containsExactly(tuple("radiology", List.of(helen)), tuple("surgery", List.of(rafael)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAHolderWhoseSpecialtyIsADistinctInstanceOfTheSameRow() {
+		Specialty radiologyAsReadWithTheVet = specialty(RADIOLOGY.getId(), RADIOLOGY.getName());
+		Vet helen = vet(1, "Helen", "Leary", radiologyAsReadWithTheVet);
+
+		List<SpecialtyListing> listings = SpecialtyListing.of(List.of(RADIOLOGY), List.of(helen));
+
+		assertThat(radiologyAsReadWithTheVet).isNotSameAs(RADIOLOGY);
+		assertThat(listings).flatExtracting(SpecialtyListing::getHolders).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Vet helen = vet(1, "Helen", "Leary", RADIOLOGY);
+		Vet jamesHoldingNoSpecialty = vet(2, "James", "Carter");
+
+		List<SpecialtyListing> listings = SpecialtyListing.of(List.of(RADIOLOGY, SURGERY),
+				List.of(helen, jamesHoldingNoSpecialty));
+
+		assertThat(listings).flatExtracting(SpecialtyListing::getHolders).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty acupuncture = specialty(4, "acupuncture");
+
+		List<SpecialtyListing> listings = SpecialtyListing.of(List.of(acupuncture, RADIOLOGY),
+				List.of(vet(1, "Helen", "Leary", RADIOLOGY)));
+
+		assertThat(listings).extracting(SpecialtyListing::getName).containsExactly("acupuncture", "radiology");
+		assertThat(listings.get(0).getHolders()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesAndHoldersStably() {
+		Vet lindaDouglas = vet(1, "Linda", "Douglas", SURGERY);
+		Vet helenLeary = vet(2, "Helen", "Leary", SURGERY);
+		Vet lindaAlvarez = vet(3, "Linda", "Alvarez", SURGERY);
+
+		List<SpecialtyListing> listings = SpecialtyListing.of(List.of(DENTISTRY, RADIOLOGY, SURGERY),
+				List.of(lindaDouglas, helenLeary, lindaAlvarez));
+
+		assertThat(listings).extracting(SpecialtyListing::getName).containsExactly("dentistry", "radiology", "surgery");
+		assertThat(listings.get(2).getHolders()).containsExactly(helenLeary, lindaAlvarez, lindaDouglas);
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet vet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
