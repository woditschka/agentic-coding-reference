+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * One specialty and the veterinarians holding it, as the specialty directory page shows
+ * them.
+ * <p>
+ * The <code>Vet</code> to <code>Specialty</code> association is unidirectional, so the
+ * inversion is driven from the veterinarian side: {@link #of(Collection, Collection)}
+ * walks the veterinarians and files each one under every specialty it holds. A
+ * veterinarian holding no specialty is therefore filed nowhere, and a specialty no
+ * veterinarian holds still yields a listing with no holders.
+ */
+class SpecialtyListing {
+
+	/**
+	 * Holders appear in the order the page displays them: first name, then last name.
+	 */
+	private static final Comparator<Vet> BY_DISPLAYED_NAME = Comparator.comparing(Vet::getFirstName)
+		.thenComparing(Vet::getLastName);
+
+	private final String name;
+
+	private final List<Vet> holders;
+
+	private SpecialtyListing(String name, List<Vet> holders) {
+		this.name = name;
+		this.holders = List.copyOf(holders);
+	}
+
+	/**
+	 * Invert the given veterinarians onto the given specialties.
+	 * @param specialties every specialty to list, in the order the page lists them; the
+	 * repository supplies them in stored-name order
+	 * @param vets the veterinarians to file under those specialties
+	 * @return one listing per given specialty, in the given order, each with its holders
+	 * ordered by first name then last name
+	 */
+	static List<SpecialtyListing> of(Collection<Specialty> specialties, Collection<Vet> vets) {
+		List<SpecialtyListing> listings = new ArrayList<>(specialties.size());
+		for (Specialty specialty : specialties) {
+			listings.add(new SpecialtyListing(specialty.getName(), holdersOf(specialty, vets)));
+		}
+		return List.copyOf(listings);
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> vets) {
+		return vets.stream().filter(vet -> holds(vet, specialty)).sorted(BY_DISPLAYED_NAME).toList();
+	}
+
+	/**
+	 * Matched by id rather than by object identity: the specialties and the veterinarians
+	 * are read in separate transactions, so the same specialty arrives as two distinct
+	 * instances, and <code>Specialty</code> inherits no value equality. An unsaved
+	 * specialty has no id and is held by nobody.
+	 */
+	private static boolean holds(Vet vet, Specialty specialty) {
+		Integer specialtyId = specialty.getId();
+		return specialtyId != null && vet.getSpecialties().stream().anyMatch(held -> specialtyId.equals(held.getId()));
+	}
+
+	/**
+	 * @return the specialty's name, as stored
+	 */
+	public String getName() {
+		return this.name;
+	}
+
+	/**
+	 * @return the veterinarians holding the specialty, ordered by first name then last
+	 * name; empty when no veterinarian holds it
+	 */
+	public List<Vet> getHolders() {
+		return this.holders;
+	}
+
+}
