+<body>
+
+  <h2 th:text="#{specialties}">Specialties</h2>
+
+  <table id="specialties" class="table table-striped">
+    <thead>
+      <tr>
+        <th th:text="#{name}">Name</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="specialty : ${specialtyListings}">
+        <td th:text="${specialty.name}"></td>
+        <td>
+          <span th:each="holder : ${specialty.holders}"
+            th:text="${holder.firstName + ' ' + holder.lastName + ' '}" /> <span
+            th:if="${specialty.holders.isEmpty()}" th:text="#{none}">none</span>
+        </td>
+      </tr>
+    </tbody>
+  </table>
+</body>
+
+</html>
