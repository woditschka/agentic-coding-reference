+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the read model that inverts the
+ * veterinarian-to-specialty association.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByItsStoredName() {
+		List<Specialty> unordered = List.of(specialty(1, SURGERY), specialty(2, DENTISTRY), specialty(3, RADIOLOGY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(unordered, List.of());
+
+		assertThat(directory.getEntries()).extracting(entry -> entry.getSpecialty().getName())
+			.containsExactly(DENTISTRY, RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListAVeterinarianUnderEachSpecialtyTheyHold() {
+		Specialty dentistry = specialty(1, DENTISTRY);
+		Specialty surgery = specialty(2, SURGERY);
+		Vet lindaDouglas = vet(1, "Linda", "Douglas", dentistry, surgery);
+		Vet rafaelOrtega = vet(2, "Rafael", "Ortega", surgery);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(dentistry, surgery),
+				List.of(rafaelOrtega, lindaDouglas));
+
+		assertThat(directory.getEntries()).satisfiesExactly(
+				dentistryEntry -> assertThat(dentistryEntry.getVeterinarians()).extracting(Vet::getLastName)
+					.containsExactly("Douglas"),
+				surgeryEntry -> assertThat(surgeryEntry.getVeterinarians()).extracting(Vet::getLastName)
+					.containsExactly("Douglas", "Ortega"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		Specialty radiology = specialty(1, RADIOLOGY);
+		Vet unrelatedVet = vet(2, "Linda", "Douglas", specialty(2, SURGERY));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(unrelatedVet));
+
+		assertThat(directory.getEntries()).singleElement().satisfies(entry -> {
+			assertThat(entry.getSpecialty().getName()).isEqualTo(RADIOLOGY);
+			assertThat(entry.getVeterinarians()).isEmpty();
+		});
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = specialty(1, RADIOLOGY);
+		Vet helenLeary = vet(1, "Helen", "Leary", radiology);
+		Vet jamesCarter = vet(2, "James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary, jamesCarter));
+
+		assertThat(directory.getEntries()).flatExtracting(SpecialtyDirectory.Entry::getVeterinarians)
+			.containsExactly(helenLeary);
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet vet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
