+
+package org.springframework.samples.petclinic.vet;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * The specialty directory is reachable by its address alone: no navigation entry names it
+ * and no page links to it. This walks the templates rather than one rendered page,
+ * because the guarantee is about every page of the system.
+ */
+class SpecialtyDirectoryLinkAbsenceTests {
+
+	private static final Path TEMPLATE_ROOT = Path.of("src/main/resources/templates");
+
+	private static final String DIRECTORY_ROUTE = "/specialties.html";
+
+	@Test
+	void noPageShouldLinkToTheSpecialtyDirectory() throws IOException {
+		List<Path> templates;
+		try (Stream<Path> files = Files.walk(TEMPLATE_ROOT)) {
+			templates = files.filter(path -> path.toString().endsWith(".html")).toList();
+		}
+		assertThat(templates).isNotEmpty();
+
+		for (Path template : templates) {
+			assertThat(Files.readString(template)).as("template %s must not link to the specialty directory", template)
+				.doesNotContain(DIRECTORY_ROUTE);
+		}
+	}
+
+}
