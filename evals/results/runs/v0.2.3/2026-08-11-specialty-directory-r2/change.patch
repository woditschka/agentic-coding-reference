+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+import org.springframework.samples.petclinic.model.NamedEntity;
+import org.springframework.samples.petclinic.model.Person;
+
+/**
+ * Immutable read model listing every specialty with the veterinarians holding it.
+ * <p>
+ * The persisted association runs from {@link Vet} to {@link Specialty} only, so the
+ * specialty-major shape is built here rather than queried. Ordering is fixed in Java so
+ * that it does not depend on the database collation, which diverges across the supported
+ * vendors.
+ * <p>
+ * The type declares no value equality. What it holds are persisted entities, which are
+ * equal by identity, so a value-based {@code equals} here would promise more than its
+ * contents can deliver.
+ */
+public final class SpecialtyDirectory {
+
+	private static final Comparator<Specialty> BY_SPECIALTY_NAME = Comparator.comparing(NamedEntity::getName);
+
+	private static final Comparator<Vet> BY_VETERINARIAN_NAME = Comparator
+		.comparing((Vet veterinarian) -> veterinarian.getLastName())
+		.thenComparing(Person::getFirstName);
+
+	private final List<Entry> entries;
+
+	private SpecialtyDirectory(List<Entry> entries) {
+		this.entries = entries;
+	}
+
+	/**
+	 * Pair every specialty with the veterinarians holding it.
+	 * @param specialties every specialty the clinic knows, in any order
+	 * @param veterinarians every veterinarian, in any order
+	 * @return a directory ordered by specialty name
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		List<Entry> entries = specialties.stream()
+			.sorted(BY_SPECIALTY_NAME)
+			.map(specialty -> new Entry(specialty, holdersOf(specialty, veterinarians)))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, Collection<Vet> veterinarians) {
+		return veterinarians.stream()
+			.filter(veterinarian -> holds(veterinarian, specialty))
+			.sorted(BY_VETERINARIAN_NAME)
+			.toList();
+	}
+
+	/**
+	 * A veterinarian holds a specialty when one of its own specialties is the same
+	 * persisted row. The two sides are read separately — the veterinarians from a cached
+	 * repository call — so they are distinct instances of a type that inherits no value
+	 * equality, and the stored name carries no uniqueness constraint. Persisted identity
+	 * is what remains.
+	 */
+	private static boolean holds(Vet veterinarian, Specialty specialty) {
+		return veterinarian.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+	/**
+	 * @return one entry per specialty, ordered by specialty name
+	 */
+	public List<Entry> getEntries() {
+		return this.entries;
+	}
+
+	/**
+	 * One specialty together with the veterinarians holding it.
+	 */
+	public static final class Entry {
+
+		private final Specialty specialty;
+
+		private final List<Vet> veterinarians;
+
+		private Entry(Specialty specialty, List<Vet> veterinarians) {
+			this.specialty = specialty;
+			this.veterinarians = veterinarians;
+		}
+
+		public Specialty getSpecialty() {
+			return this.specialty;
+		}
+
+		/**
+		 * @return the veterinarians holding this specialty, empty when none does
+		 */
+		public List<Vet> getVeterinarians() {
+			return this.veterinarians;
+		}
+
+	}
+
+}
