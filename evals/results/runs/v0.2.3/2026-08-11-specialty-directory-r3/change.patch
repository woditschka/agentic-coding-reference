+package org.springframework.samples.petclinic.vet;
+
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * One entry of the specialty directory: a specialty under its stored name, together with
+ * the veterinarians holding it.
+ *
+ * @param name the specialty's stored name
+ * @param veterinarians the veterinarians holding the specialty, ordered by last name,
+ * then first name, then id; empty when no veterinarian holds it
+ */
+record SpecialtyListing(String name, List<Vet> veterinarians) {
+
+	/**
+	 * Specialties read in the order the directory presents them: by stored name, then by
+	 * id. The <code>specialties</code> table indexes name without a unique constraint, so
+	 * the id keeps the order total when two specialties share a name.
+	 */
+	private static final Comparator<Specialty> BY_STORED_NAME = Comparator.comparing(Specialty::getName)
+		.thenComparing(Specialty::getId);
+
+	/**
+	 * Veterinarians read in the order each listing presents them. The id keeps the order
+	 * total when two veterinarians share a name.
+	 */
+	private static final Comparator<Vet> BY_VETERINARIAN_NAME = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	SpecialtyListing {
+		veterinarians = List.copyOf(veterinarians);
+	}
+
+	/**
+	 * Assemble the specialty directory: every given specialty, in presentation order,
+	 * each with the veterinarians holding it.
+	 * <p>
+	 * A veterinarian holds a specialty when it carries the same id. Specialties are
+	 * matched by id rather than by instance or by name because the two collections are
+	 * read through separate persistence contexts — the {@link Specialty} instances
+	 * reachable from a {@link Vet} are not the instances the specialty read returns — and
+	 * because a name is not unique.
+	 * @param specialties every specialty the clinic knows, in any order
+	 * @param veterinarians every veterinarian, in any order; one holding no specialty
+	 * ends up in no listing
+	 * @return one listing per given specialty, ordered by stored name
+	 */
+	static List<SpecialtyListing> directoryOf(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		List<Vet> ordered = veterinarians.stream().sorted(BY_VETERINARIAN_NAME).toList();
+		return specialties.stream()
+			.sorted(BY_STORED_NAME)
+			.map(specialty -> new SpecialtyListing(specialty.getName(), holdersOf(specialty, ordered)))
+			.toList();
+	}
+
+	private static List<Vet> holdersOf(Specialty specialty, List<Vet> orderedVeterinarians) {
+		return orderedVeterinarians.stream().filter(vet -> holds(vet, specialty)).toList();
+	}
+
+	private static boolean holds(Vet veterinarian, Specialty specialty) {
+		return veterinarian.getSpecialties().stream().anyMatch(held -> Objects.equals(held.getId(), specialty.getId()));
+	}
+
+}
