+/**
+ * Test class for the specialty directory assembly in {@link SpecialtyListing}.
+ */
+class SpecialtyListingTests {
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final int SOME_ID = 99;
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		Specialty radiology = specialty(1, RADIOLOGY);
+		Specialty dentistry = specialty(2, DENTISTRY);
+
+		List<SpecialtyListing> directory = SpecialtyListing.directoryOf(List.of(radiology, dentistry),
+				List.of(aVetHolding(radiology)));
+
+		assertThat(directory).extracting(SpecialtyListing::name).containsExactly(DENTISTRY, RADIOLOGY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		Specialty radiology = specialty(1, RADIOLOGY);
+		Specialty surgery = specialty(2, SURGERY);
+
+		List<SpecialtyListing> directory = SpecialtyListing.directoryOf(List.of(radiology, surgery),
+				List.of(aVetHolding(radiology)));
+
+		assertThat(listingOf(directory, SURGERY).veterinarians()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() {
+		Specialty radiology = specialty(1, RADIOLOGY);
+		Vet helen = vet(1, "Helen", "Leary", radiology);
+		Vet unspecialized = vet(2, "James", "Carter");
+
+		List<SpecialtyListing> directory = SpecialtyListing.directoryOf(List.of(radiology),
+				List.of(helen, unspecialized));
+
+		assertThat(directory).flatExtracting(SpecialtyListing::veterinarians).containsExactly(helen);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldShowAVeterinarianUnderEachSpecialtyHeld() {
+		Specialty radiology = specialty(1, RADIOLOGY);
+		Specialty surgery = specialty(2, SURGERY);
+		Vet linda = vet(1, "Linda", "Douglas", radiology, surgery);
+
+		List<SpecialtyListing> directory = SpecialtyListing.directoryOf(List.of(radiology, surgery), List.of(linda));
+
+		assertThat(listingOf(directory, RADIOLOGY).veterinarians()).containsExactly(linda);
+		assertThat(listingOf(directory, SURGERY).veterinarians()).containsExactly(linda);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderSpecialtiesAndVeterinariansStably() {
+		Specialty radiology = specialty(1, RADIOLOGY);
+		Specialty dentistry = specialty(2, DENTISTRY);
+		Specialty surgery = specialty(3, SURGERY);
+		Vet secondHelenLeary = vet(4, "Helen", "Leary", surgery);
+		Vet firstHelenLeary = vet(3, "Helen", "Leary", surgery);
+		Vet annaLeary = vet(2, "Anna", "Leary", surgery);
+		Vet rafaelCarter = vet(1, "Rafael", "Carter", surgery);
+
+		List<SpecialtyListing> directory = SpecialtyListing.directoryOf(List.of(surgery, radiology, dentistry),
+				List.of(secondHelenLeary, annaLeary, rafaelCarter, firstHelenLeary));
+
+		assertThat(directory).extracting(SpecialtyListing::name).containsExactly(DENTISTRY, RADIOLOGY, SURGERY);
+		assertThat(listingOf(directory, SURGERY).veterinarians()).containsExactly(rafaelCarter, annaLeary,
+				firstHelenLeary, secondHelenLeary);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyOnOnePage() {
+		List<Specialty> manySpecialties = IntStream.rangeClosed(1, 12)
+			.mapToObj(id -> specialty(id, "specialty-" + id))
+			.toList();
+
+		List<SpecialtyListing> directory = SpecialtyListing.directoryOf(manySpecialties, List.of());
+
+		assertThat(directory).hasSameSizeAs(manySpecialties);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListNoSpecialtyWhenTheClinicKnowsNone() {
+		List<SpecialtyListing> directory = SpecialtyListing.directoryOf(List.of(), List.of(aVetHolding()));
+
+		assertThat(directory).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldGroupVeterinariansBySpecialtyIdRatherThanName() {
+		Specialty storedSurgery = specialty(1, SURGERY);
+		Specialty sameNamedOtherSurgery = specialty(2, SURGERY);
+		Vet helen = vet(1, "Helen", "Leary", specialty(2, SURGERY));
+
+		List<SpecialtyListing> directory = SpecialtyListing.directoryOf(List.of(storedSurgery, sameNamedOtherSurgery),
+				List.of(helen));
+
+		assertThat(directory).hasSize(2);
+		assertThat(directory.get(0).veterinarians()).isEmpty();
+		assertThat(directory.get(1).veterinarians()).containsExactly(helen);
+	}
+
+	private static SpecialtyListing listingOf(List<SpecialtyListing> directory, String specialtyName) {
+		return directory.stream()
+			.filter(listing -> listing.name().equals(specialtyName))
+			.findFirst()
+			.orElseThrow(() -> new AssertionError("no listing for specialty " + specialtyName));
+	}
+
+	private static Specialty specialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet aVetHolding(Specialty... held) {
+		return vet(SOME_ID, "Helen", "Leary", held);
+	}
+
+	private static Vet vet(int id, String firstName, String lastName, Specialty... held) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : held) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+}
