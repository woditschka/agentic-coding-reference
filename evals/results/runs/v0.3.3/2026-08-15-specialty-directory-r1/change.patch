+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * Immutable read projection pairing every specialty the clinic knows with the
+ * veterinarians holding it. A specialty no veterinarian holds keeps an entry with no
+ * veterinarian against it; a veterinarian holding no listed specialty appears in no
+ * entry.
+ * <p>
+ * Entries follow the order of the specialty listing the directory is given — the listing
+ * is what decides which specialties exist and in which order they read. Veterinarians
+ * under an entry are ordered by last name, then first name, then identifier.
+ * <p>
+ * Veterinarians are matched to a specialty by {@link Specialty} identifier rather than by
+ * object equality: persisted types compare by object identity, and the two sides of this
+ * projection are read separately, so the same specialty row can arrive as two distinct
+ * instances.
+ */
+public class SpecialtyDirectory {
+
+	private static final Comparator<Vet> BY_NAME_THEN_IDENTIFIER = Comparator.comparing(Vet::getLastName)
+		.thenComparing(Vet::getFirstName)
+		.thenComparing(Vet::getId);
+
+	private final List<SpecialtyEntry> entries;
+
+	public SpecialtyDirectory(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = groupHoldersBySpecialtyId(veterinarians);
+		List<SpecialtyEntry> collected = new ArrayList<>();
+		for (Specialty specialty : specialties) {
+			List<Vet> holders = holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of());
+			collected.add(new SpecialtyEntry(specialty.getName(), holders));
+		}
+		this.entries = List.copyOf(collected);
+	}
+
+	private static Map<Integer, List<Vet>> groupHoldersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty specialty : veterinarian.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		holdersBySpecialtyId.values().forEach(holders -> holders.sort(BY_NAME_THEN_IDENTIFIER));
+		return holdersBySpecialtyId;
+	}
+
+	public List<SpecialtyEntry> getEntries() {
+		return this.entries;
+	}
+
+	/**
+	 * One specialty of the directory, named as the clinic stores it, with the
+	 * veterinarians holding it.
+	 */
+	public static final class SpecialtyEntry {
+
+		private final String name;
+
+		private final List<Vet> veterinarians;
+
+		SpecialtyEntry(String name, List<Vet> veterinarians) {
+			this.name = name;
+			this.veterinarians = List.copyOf(veterinarians);
+		}
+
+		public String getName() {
+			return this.name;
+		}
+
+		public List<Vet> getVeterinarians() {
+			return this.veterinarians;
+		}
+
+		@Override
+		public boolean equals(Object other) {
+			if (this == other) {
+				return true;
+			}
+			if (!(other instanceof SpecialtyEntry entry)) {
+				return false;
+			}
+			return Objects.equals(this.name, entry.name) && this.veterinarians.equals(entry.veterinarians);
+		}
+
+		@Override
+		public int hashCode() {
+			return Objects.hash(this.name, this.veterinarians);
+		}
+
+	}
+
+}
