+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final int RADIOLOGY_ID = 1;
+
+	private static final int SURGERY_ID = 2;
+
+	private int nextVetId = 1;
+
+	private Specialty createSpecialty(int id, String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(id);
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet createVet(String firstName, String lastName, Specialty... specialties) {
+		return createVet(this.nextVetId++, firstName, lastName, specialties);
+	}
+
+	private Vet createVet(int id, String firstName, String lastName, Specialty... specialties) {
+		Vet vet = new Vet();
+		vet.setId(id);
+		vet.setFirstName(firstName);
+		vet.setLastName(lastName);
+		for (Specialty specialty : specialties) {
+			vet.addSpecialty(specialty);
+		}
+		return vet;
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldGroupVeterinariansBySpecialtyIdentifierRatherThanInstance() {
+		Vet helen = createVet("Helen", "Leary", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+
+		SpecialtyDirectory directory = new SpecialtyDirectory(List.of(createSpecialty(RADIOLOGY_ID, RADIOLOGY)),
+				List.of(helen));
+
+		assertThat(directory.getEntries())
+			.containsExactly(new SpecialtyDirectory.SpecialtyEntry(RADIOLOGY, List.of(helen)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOrderVeterinariansUnderASpecialtyByLastNameThenFirstName() {
+		Vet linda = createVet("Linda", "Douglas", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+		Vet helen = createVet("Helen", "Leary", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+		Vet rafael = createVet("Rafael", "Ortega", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+
+		SpecialtyDirectory directory = new SpecialtyDirectory(List.of(createSpecialty(RADIOLOGY_ID, RADIOLOGY)),
+				List.of(rafael, helen, linda));
+
+		assertThat(directory.getEntries()).flatExtracting(SpecialtyDirectory.SpecialtyEntry::getVeterinarians)
+			.containsExactly(linda, helen, rafael);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBreakATieBetweenIdenticallyNamedVeterinariansByIdentifier() {
+		int lowerId = 1;
+		int higherId = 2;
+		Vet firstNamesake = createVet(lowerId, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+		Vet secondNamesake = createVet(higherId, "Helen", "Leary", createSpecialty(RADIOLOGY_ID, RADIOLOGY));
+
+		SpecialtyDirectory directory = new SpecialtyDirectory(List.of(createSpecialty(RADIOLOGY_ID, RADIOLOGY)),
+				List.of(secondNamesake, firstNamesake));
+
+		assertThat(directory.getEntries()).flatExtracting(SpecialtyDirectory.SpecialtyEntry::getVeterinarians)
+			.containsExactly(firstNamesake, secondNamesake);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepTheOrderOfTheSpecialtyListingItWasGiven() {
+		SpecialtyDirectory directory = new SpecialtyDirectory(
+				List.of(createSpecialty(SURGERY_ID, SURGERY), createSpecialty(RADIOLOGY_ID, RADIOLOGY)), List.of());
+
+		assertThat(directory.getEntries()).extracting(SpecialtyDirectory.SpecialtyEntry::getName)
+			.containsExactly(SURGERY, RADIOLOGY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldHoldNoEntryWhenTheClinicKnowsNoSpecialty() {
+		SpecialtyDirectory directory = new SpecialtyDirectory(List.of(),
+				List.of(createVet("Helen", "Leary", createSpecialty(RADIOLOGY_ID, RADIOLOGY))));
+
+		assertThat(directory.getEntries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldKeepItsEntriesWhenTheCallerChangesTheListingItWasGiven() {
+		List<Specialty> listing = new ArrayList<>(List.of(createSpecialty(RADIOLOGY_ID, RADIOLOGY)));
+		SpecialtyDirectory directory = new SpecialtyDirectory(listing, List.of());
+
+		listing.add(createSpecialty(SURGERY_ID, SURGERY));
+
+		assertThat(directory.getEntries()).extracting(SpecialtyDirectory.SpecialtyEntry::getName)
+			.containsExactly(RADIOLOGY);
+	}
+
+}
