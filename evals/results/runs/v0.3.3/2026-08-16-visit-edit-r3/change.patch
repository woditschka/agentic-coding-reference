+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+import java.time.LocalDate;
+
+/**
+ * Test class for {@link Pet}
+ */
+class PetTests {
+
+	private static final int BOOKED_VISIT_ID = 1;
+
+	private static final LocalDate ANY_VISIT_DATE = LocalDate.now().plusDays(7);
+
+	private static Pet createAPetWithVisits(Visit... visits) {
+		Pet pet = new Pet();
+		for (Visit visit : visits) {
+			pet.addVisit(visit);
+		}
+		return pet;
+	}
+
+	private static Visit createABookedVisit(int visitId) {
+		Visit visit = new Visit();
+		visit.setId(visitId);
+		visit.setDate(ANY_VISIT_DATE);
+		return visit;
+	}
+
+	private static Visit createAVisitThatWasNeverBooked() {
+		return new Visit();
+	}
+
+	@Test
+	void aPetShouldReturnTheVisitBookedUnderTheGivenId() {
+		Visit bookedVisit = createABookedVisit(BOOKED_VISIT_ID);
+		Pet pet = createAPetWithVisits(createAVisitThatWasNeverBooked(), bookedVisit);
+
+		assertThat(pet.getVisit(BOOKED_VISIT_ID)).isSameAs(bookedVisit);
+	}
+
+	@Test
+	void aPetShouldNeverOfferAVisitThatWasNeverBooked() {
+		Pet pet = createAPetWithVisits(createAVisitThatWasNeverBooked());
+
+		assertThat(pet.getVisit(null)).isNull();
+	}
+
+}
