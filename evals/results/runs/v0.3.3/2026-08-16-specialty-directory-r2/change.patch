+	}
+
+	private static boolean contains(Path template, String url) {
+		try {
+			return Files.readString(template).contains(url);
+		}
+		catch (IOException failedToRead) {
+			throw new UncheckedIOException("Could not read template " + template, failedToRead);
+		}
+	}
+
+	@BeforeEach
+	void setup() {
+		Specialty radiology = createASpecialty("radiology");
+		Specialty dentistry = createASpecialty("dentistry");
+		given(this.specialties.findSpecialties()).willReturn(List.of(dentistry, radiology));
+		given(this.vets.findAll()).willReturn(List.of(createAVeterinarian("Helen", "Leary", radiology)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEverySpecialtyOnOnePage() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_URL))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyList"))
+			.andExpect(model().attributeExists("specialtyDirectory"))
+			.andExpect(model().attributeDoesNotExist("totalPages"))
+			.andExpect(content().string(containsString("dentistry")))
+			.andExpect(content().string(containsString("radiology")))
+			.andExpect(content().string(containsString("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldCarryTheNavigationEveryPageCarries() throws Exception {
+		mockMvc.perform(get(SPECIALTY_DIRECTORY_URL))
+			.andExpect(content().string(containsString("/owners/find")))
+			.andExpect(content().string(containsString("/vets.html")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNotBeLinkedFromAnyPage() throws Exception {
+		assertThat(templatesLinkingTo(SPECIALTY_DIRECTORY_URL)).isEmpty();
+	}
+
+}
