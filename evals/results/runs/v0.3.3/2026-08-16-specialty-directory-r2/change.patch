+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+
+import org.springframework.samples.petclinic.vet.SpecialtyDirectory.SpecialtyEntry;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}, the read model behind the specialty
+ * directory page.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final List<Vet> NO_VETERINARIANS = List.of();
+
+	private static final AtomicInteger NEXT_STORED_ID = new AtomicInteger(1);
+
+	private static Specialty createASpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setId(NEXT_STORED_ID.getAndIncrement());
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private static Vet createAVeterinarian(String firstName, String lastName, Specialty... specialties) {
+		Vet veterinarian = new Vet();
+		veterinarian.setId(NEXT_STORED_ID.getAndIncrement());
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		Stream.of(specialties).forEach(veterinarian::addSpecialty);
+		return veterinarian;
+	}
+
+	/**
+	 * The directory joins two independent reads, so a veterinarian's specialty is a
+	 * different instance from the one the specialty read returned.
+	 */
+	private static Specialty aSeparatelyLoadedCopyOf(Specialty specialty) {
+		Specialty copy = new Specialty();
+		copy.setId(specialty.getId());
+		copy.setName(specialty.getName());
+		return copy;
+	}
+
+	private static SpecialtyEntry anEntryFor(Specialty specialty, String... veterinarianNames) {
+		return new SpecialtyEntry(specialty.getName(), List.of(veterinarianNames));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByItsStoredName() {
+		Specialty dentistry = createASpecialty("dentistry");
+		Specialty radiology = createASpecialty("radiology");
+		Specialty surgery = createASpecialty("surgery");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, surgery, dentistry), NO_VETERINARIANS);
+
+		assertThat(directory.entries()).extracting(SpecialtyEntry::specialtyName)
+			.containsExactly(dentistry.getName(), radiology.getName(), surgery.getName());
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachVeterinarianByFirstAndLastName() {
+		Specialty radiology = createASpecialty("radiology");
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", radiology);
+		Vet lindaDouglas = createAVeterinarian("Linda", "Douglas", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary, lindaDouglas));
+
+		assertThat(directory.entries()).singleElement()
+			.extracting(SpecialtyEntry::veterinarianNames)
+			.isEqualTo(List.of("Linda Douglas", "Helen Leary"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyHeldByNoVeterinarian() {
+		Specialty radiology = createASpecialty("radiology");
+		Specialty cardiology = createASpecialty("cardiology");
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", radiology);
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology, cardiology), List.of(helenLeary));
+
+		assertThat(directory.entries()).containsExactly(anEntryFor(cardiology), anEntryFor(radiology, "Helen Leary"));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitAVeterinarianHoldingNoSpecialty() {
+		Specialty radiology = createASpecialty("radiology");
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", radiology);
+		Vet jamesCarter = createAVeterinarian("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary, jamesCarter));
+
+		assertThat(directory.entries()).flatExtracting(SpecialtyEntry::veterinarianNames)
+			.containsExactly("Helen Leary");
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldPresentSpecialtiesInAStableOrder() {
+		Specialty radiology = createASpecialty("radiology");
+		Specialty dentistry = createASpecialty("dentistry");
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", radiology, dentistry);
+		Vet lindaDouglas = createAVeterinarian("Linda", "Douglas", radiology, dentistry);
+
+		SpecialtyDirectory firstRequest = SpecialtyDirectory.of(List.of(radiology, dentistry),
+				List.of(helenLeary, lindaDouglas));
+		SpecialtyDirectory repeatedRequest = SpecialtyDirectory.of(List.of(dentistry, radiology),
+				List.of(lindaDouglas, helenLeary));
+
+		assertThat(repeatedRequest).isEqualTo(firstRequest);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldGroupHoldersWhenTheSpecialtyCameFromASeparateRead() {
+		Specialty radiology = createASpecialty("radiology");
+		Vet helenLeary = createAVeterinarian("Helen", "Leary", aSeparatelyLoadedCopyOf(radiology));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(radiology), List.of(helenLeary));
+
+		assertThat(directory.entries()).containsExactly(anEntryFor(radiology, "Helen Leary"));
+	}
+
+}
