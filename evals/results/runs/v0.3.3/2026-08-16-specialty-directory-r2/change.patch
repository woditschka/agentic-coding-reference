+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * Immutable read model pairing every specialty the clinic knows with the veterinarians
+ * holding it.
+ * <p>
+ * The directory is assembled per request from a specialty read and the cached
+ * veterinarian read, because the association is unidirectional and a specialty no
+ * veterinarian holds is unreachable from the veterinarian side.
+ *
+ * @param entries one entry per stored specialty, ordered by stored name
+ */
+public record SpecialtyDirectory(List<SpecialtyEntry> entries) {
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Assemble the directory from the stored specialties and the veterinarians holding
+	 * them.
+	 * @param specialties every specialty the clinic knows
+	 * @param veterinarians every veterinarian; those holding no specialty do not appear
+	 * @return the assembled directory, in a presentation order fixed by the stored values
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Objects.requireNonNull(specialties, "specialties");
+		Objects.requireNonNull(veterinarians, "veterinarians");
+		Map<Integer, List<Vet>> holdersBySpecialtyId = indexHoldersBySpecialtyId(veterinarians);
+		List<SpecialtyEntry> entries = specialties.stream()
+			.sorted(Comparator.comparing(Specialty::getName))
+			.map(specialty -> new SpecialtyEntry(specialty.getName(),
+					displayNamesOf(holdersBySpecialtyId.getOrDefault(specialty.getId(), List.of()))))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	/**
+	 * Group the veterinarians by the identifier of each specialty they hold. The join is
+	 * by stored identifier rather than by object equality, because the persistence
+	 * superclass overrides neither {@code equals} nor {@code hashCode} and identity
+	 * comparison against separately loaded instances would silently yield empty groups.
+	 */
+	private static Map<Integer, List<Vet>> indexHoldersBySpecialtyId(Collection<Vet> veterinarians) {
+		Map<Integer, List<Vet>> holdersBySpecialtyId = new HashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty specialty : veterinarian.getSpecialties()) {
+				holdersBySpecialtyId.computeIfAbsent(specialty.getId(), id -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holdersBySpecialtyId;
+	}
+
+	private static List<String> displayNamesOf(List<Vet> holders) {
+		return holders.stream()
+			.sorted(Comparator.comparing(Vet::getLastName).thenComparing(Vet::getFirstName))
+			.map(holder -> holder.getFirstName() + " " + holder.getLastName())
+			.toList();
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it.
+	 *
+	 * @param specialtyName the specialty's stored name
+	 * @param veterinarianNames the holders' display names, empty when no veterinarian
+	 * holds the specialty
+	 */
+	public record SpecialtyEntry(String specialtyName, List<String> veterinarianNames) {
+
+		public SpecialtyEntry {
+			Objects.requireNonNull(specialtyName, "specialtyName");
+			veterinarianNames = List.copyOf(veterinarianNames);
+		}
+
+	}
+
+}
