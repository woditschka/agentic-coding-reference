+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Read model pairing every specialty the clinic knows with the veterinarians holding it.
+ * <p>
+ * The {@link Vet} to {@link Specialty} association runs one way, so a specialty cannot
+ * reach its holders and a specialty nobody holds is unreachable from the veterinarian
+ * rows alone. The directory is therefore composed in memory from two independent reads,
+ * as decided in ADR 2026-08-16. It carries names rather than entity references, which is
+ * what gives it equality by value.
+ * <p>
+ * Both edge cases the specialty directory has to serve fall out of that shape rather than
+ * a branch: iterating the specialties lists one nobody holds, and grouping by specialty
+ * never reaches a veterinarian who holds none.
+ *
+ * @param entries one entry per specialty, in the order the specialties were supplied
+ */
+public record SpecialtyDirectory(List<Entry> entries) {
+
+	private static final Comparator<Vet> BY_LAST_NAME_THEN_FIRST_NAME = Comparator
+		.comparing(Vet::getLastName, Comparator.nullsLast(Comparator.naturalOrder()))
+		.thenComparing(Vet::getFirstName, Comparator.nullsLast(Comparator.naturalOrder()));
+
+	public SpecialtyDirectory {
+		entries = List.copyOf(entries);
+	}
+
+	/**
+	 * Compose a directory from every specialty the clinic knows and every veterinarian.
+	 * <p>
+	 * Specialties keep the order they are supplied in, which the repository establishes.
+	 * A veterinarian holding a specialty the clinic does not know is not named, and one
+	 * holding no specialty at all is not named either.
+	 * @param specialties every specialty to list, in the order they should be listed
+	 * @param veterinarians every veterinarian to consider as a holder, in any order
+	 * @return the composed directory
+	 */
+	public static SpecialtyDirectory of(Collection<Specialty> specialties, Collection<Vet> veterinarians) {
+		Map<String, List<Vet>> holders = holdersBySpecialtyName(veterinarians);
+		List<Entry> entries = specialties.stream()
+			.map(specialty -> new Entry(specialty.getName(),
+					fullNames(holders.getOrDefault(specialty.getName(), List.of()))))
+			.toList();
+		return new SpecialtyDirectory(entries);
+	}
+
+	private static Map<String, List<Vet>> holdersBySpecialtyName(Collection<Vet> veterinarians) {
+		Map<String, List<Vet>> holders = new LinkedHashMap<>();
+		for (Vet veterinarian : veterinarians) {
+			for (Specialty held : veterinarian.getSpecialties()) {
+				holders.computeIfAbsent(held.getName(), specialtyName -> new ArrayList<>()).add(veterinarian);
+			}
+		}
+		return holders;
+	}
+
+	private static List<String> fullNames(List<Vet> veterinarians) {
+		return veterinarians.stream().sorted(BY_LAST_NAME_THEN_FIRST_NAME).map(SpecialtyDirectory::fullName).toList();
+	}
+
+	private static String fullName(Vet veterinarian) {
+		return veterinarian.getFirstName() + " " + veterinarian.getLastName();
+	}
+
+	/**
+	 * One specialty and the veterinarians holding it.
+	 *
+	 * @param specialtyName the specialty's stored name
+	 * @param veterinarianNames the full name of each holder, first name then last name,
+	 * ordered by last name then first name; empty when nobody holds the specialty
+	 */
+	public record Entry(String specialtyName, List<String> veterinarianNames) {
+
+		public Entry {
+			veterinarianNames = List.copyOf(veterinarianNames);
+		}
+
+	}
+
+}
