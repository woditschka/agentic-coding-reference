+package org.springframework.samples.petclinic.vet;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for {@link SpecialtyDirectory}.
+ */
+class SpecialtyDirectoryTests {
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	private static final String DENTISTRY = "dentistry";
+
+	private static final String HOLDER_FIRST_NAME = "Helen";
+
+	private static final String HOLDER_LAST_NAME = "Leary";
+
+	private int veterinarianCount;
+
+	private Specialty aSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet aVeterinarianNamed(String firstName, String lastName, String... heldSpecialtyNames) {
+		Vet veterinarian = new Vet();
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		for (String heldSpecialtyName : heldSpecialtyNames) {
+			veterinarian.addSpecialty(aSpecialty(heldSpecialtyName));
+		}
+		return veterinarian;
+	}
+
+	private Vet someVeterinarianHolding(String... heldSpecialtyNames) {
+		this.veterinarianCount++;
+		return aVeterinarianNamed("Some" + this.veterinarianCount, "Veterinarian" + this.veterinarianCount,
+				heldSpecialtyNames);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListEverySpecialtyByStoredName() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(aSpecialty(RADIOLOGY), aSpecialty(SURGERY)),
+				List.of(someVeterinarianHolding(RADIOLOGY)));
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::specialtyName)
+			.containsExactly(RADIOLOGY, SURGERY);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameEachHoldingVeterinarianInFull() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(aSpecialty(RADIOLOGY)),
+				List.of(aVeterinarianNamed(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, RADIOLOGY)));
+
+		assertThat(directory.entries()).containsExactly(
+				new SpecialtyDirectory.Entry(RADIOLOGY, List.of(HOLDER_FIRST_NAME + " " + HOLDER_LAST_NAME)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldOmitVeterinariansHoldingNoSpecialty() {
+		Vet holdingNothing = aVeterinarianNamed("James", "Carter");
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(aSpecialty(RADIOLOGY)),
+				List.of(holdingNothing, aVeterinarianNamed(HOLDER_FIRST_NAME, HOLDER_LAST_NAME, RADIOLOGY)));
+
+		assertThat(directory.entries()).containsExactly(
+				new SpecialtyDirectory.Entry(RADIOLOGY, List.of(HOLDER_FIRST_NAME + " " + HOLDER_LAST_NAME)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldListASpecialtyNoVeterinarianHolds() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(aSpecialty(RADIOLOGY), aSpecialty(DENTISTRY)),
+				List.of(someVeterinarianHolding(RADIOLOGY)));
+
+		assertThat(directory.entries()).contains(new SpecialtyDirectory.Entry(DENTISTRY, List.of()));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldHoldNoEntryWhenTheClinicKnowsNoSpecialty() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(), List.of(someVeterinarianHolding()));
+
+		assertThat(directory.entries()).isEmpty();
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameHoldingVeterinariansByLastNameThenFirstName() {
+		SpecialtyDirectory directory = SpecialtyDirectory.of(List.of(aSpecialty(SURGERY)),
+				List.of(aVeterinarianNamed("Rafael", "Ortega", SURGERY),
+						aVeterinarianNamed("Linda", "Douglas", SURGERY),
+						aVeterinarianNamed("Ada", "Douglas", SURGERY)));
+
+		assertThat(directory.entries()).containsExactly(
+				new SpecialtyDirectory.Entry(SURGERY, List.of("Ada Douglas", "Linda Douglas", "Rafael Ortega")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldBeUnaffectedByLaterChangesToItsSource() {
+		List<Specialty> specialties = new ArrayList<>(List.of(aSpecialty(RADIOLOGY)));
+
+		SpecialtyDirectory directory = SpecialtyDirectory.of(specialties, List.of());
+		specialties.add(aSpecialty(DENTISTRY));
+
+		assertThat(directory.entries()).extracting(SpecialtyDirectory.Entry::specialtyName).containsExactly(RADIOLOGY);
+	}
+
+}
