+<!DOCTYPE html>
+
+<html xmlns:th="https://www.thymeleaf.org"
+  th:replace="~{fragments/layout :: layout (~{::body},'specialtyDirectory')}">
+
+<body>
+
+  <h2 th:text="#{specialtyDirectory}">Specialty Directory</h2>
+
+  <table id="specialties" class="table table-striped">
+    <thead>
+      <tr>
+        <th th:text="#{specialty}">Specialty</th>
+        <th th:text="#{vets}">Veterinarians</th>
+      </tr>
+    </thead>
+    <tbody>
+      <tr th:each="entry : ${specialtyDirectory.entries}">
+        <td th:text="${entry.specialtyName}"></td>
+        <td>
+          <span th:each="veterinarianName : ${entry.veterinarianNames}" th:text="${veterinarianName + ' '}" /> <span
+            th:if="${entry.veterinarianNames.empty}" th:text="#{noVeterinarians}">no veterinarians</span>
+        </td>
+      </tr>
+    </tbody>
+  </table>
+</body>
+
+</html>
