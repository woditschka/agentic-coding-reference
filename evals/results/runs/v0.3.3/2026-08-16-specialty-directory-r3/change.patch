+package org.springframework.samples.petclinic.vet;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.DisabledInNativeImage;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.test.context.aot.DisabledInAotMode;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.not;
+import static org.mockito.BDDMockito.given;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.model;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+/**
+ * Test class for the {@link SpecialtyController}
+ */
+
+@WebMvcTest(SpecialtyController.class)
+@DisabledInNativeImage
+@DisabledInAotMode
+class SpecialtyControllerTests {
+
+	private static final String SPECIALTY_DIRECTORY_PATH = "/specialties.html";
+
+	private static final String RADIOLOGY = "radiology";
+
+	private static final String SURGERY = "surgery";
+
+	/** The default-locale rendering of the {@code noVeterinarians} message key. */
+	private static final String NO_VETERINARIANS_PLACEHOLDER = "no veterinarians";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@MockitoBean
+	private SpecialtyRepository specialties;
+
+	@MockitoBean
+	private VetRepository vets;
+
+	private Specialty aSpecialty(String name) {
+		Specialty specialty = new Specialty();
+		specialty.setName(name);
+		return specialty;
+	}
+
+	private Vet aVeterinarianNamed(String firstName, String lastName, String... heldSpecialtyNames) {
+		Vet veterinarian = new Vet();
+		veterinarian.setFirstName(firstName);
+		veterinarian.setLastName(lastName);
+		for (String heldSpecialtyName : heldSpecialtyNames) {
+			veterinarian.addSpecialty(aSpecialty(heldSpecialtyName));
+		}
+		return veterinarian;
+	}
+
+	private void givenTheClinicKnows(List<Specialty> knownSpecialties, List<Vet> employedVeterinarians) {
+		given(this.specialties.findSpecialties()).willReturn(knownSpecialties);
+		given(this.vets.findAll()).willReturn(employedVeterinarians);
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderEverySpecialtyOnOnePage() throws Exception {
+		givenTheClinicKnows(List.of(aSpecialty(RADIOLOGY), aSpecialty(SURGERY)),
+				List.of(aVeterinarianNamed("Helen", "Leary", RADIOLOGY)));
+
+		this.mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(view().name("vets/specialtyDirectory"))
+			.andExpect(model().attributeExists("specialtyDirectory"))
+			.andExpect(model().attributeDoesNotExist("currentPage", "totalPages"))
+			.andExpect(content().string(containsString(RADIOLOGY)))
+			.andExpect(content().string(containsString(SURGERY)))
+			.andExpect(content().string(containsString("Helen Leary")));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldNameNoVeterinarianUnderASpecialtyNobodyHolds() throws Exception {
+		givenTheClinicKnows(List.of(aSpecialty(RADIOLOGY), aSpecialty(SURGERY)),
+				List.of(aVeterinarianNamed("Helen", "Leary", RADIOLOGY)));
+
+		this.mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(content().string(containsString(NO_VETERINARIANS_PLACEHOLDER)));
+	}
+
+	@Test
+	void theSpecialtyDirectoryShouldRenderWhenTheClinicKnowsNoSpecialty() throws Exception {
+		givenTheClinicKnows(List.of(), List.of(aVeterinarianNamed("James", "Carter")));
+
+		this.mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString("James Carter"))));
+	}
+
+	@Test
+	void theSiteNavigationShouldNotNameTheSpecialtyDirectory() throws Exception {
+		givenTheClinicKnows(List.of(aSpecialty(RADIOLOGY)), List.of());
+
+		this.mockMvc.perform(get(SPECIALTY_DIRECTORY_PATH))
+			.andExpect(status().isOk())
+			.andExpect(content().string(not(containsString("href=\"" + SPECIALTY_DIRECTORY_PATH + "\""))));
+	}
+
+}
