+package org.springframework.samples.petclinic.vet;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Test class for the reading {@link VetController} gives a submitted specialty before it
+ * narrows the directory by it.
+ */
+class VetControllerSpecialtyNameTests {
+
+	/**
+	 * A specialty a vet actually holds, so a passing test cannot be read as the name
+	 * having been discarded.
+	 */
+	private static final String RADIOLOGY = "radiology";
+
+	@Test
+	void theSubmittedSpecialtyShouldNarrowByItsName() {
+		assertThat(VetController.namedSpecialtyOf(RADIOLOGY)).isEqualTo(RADIOLOGY);
+	}
+
+	@Test
+	void theSubmittedSpecialtyShouldLoseTheSpacesAroundIt() {
+		String specialtyWithSurroundingSpaces = "  " + RADIOLOGY + "  ";
+
+		assertThat(VetController.namedSpecialtyOf(specialtyWithSurroundingSpaces)).isEqualTo(RADIOLOGY);
+	}
+
+	@Test
+	void aSpacesOnlySpecialtyShouldNameNoSpecialty() {
+		String spacesOnly = "   ";
+
+		assertThat(VetController.namedSpecialtyOf(spacesOnly)).isNull();
+	}
+
+	@Test
+	void anEmptySpecialtyShouldNameNoSpecialty() {
+		String empty = "";
+
+		assertThat(VetController.namedSpecialtyOf(empty)).isNull();
+	}
+
+	@Test
+	void anAbsentSpecialtyShouldNameNoSpecialty() {
+		assertThat(VetController.namedSpecialtyOf(null)).isNull();
+	}
+
+}
