+	/**
+	 * Retrieve in Pages the <code>Vet</code>s holding the named specialty. The whole name
+	 * must match, disregarding letter case; the comparison is made by the query rather
+	 * than by column collation, so it does not vary by database vendor.
+	 * <p>
+	 * Deliberately not <code>@Cacheable</code>: the key would be caller-supplied text of
+	 * unbounded cardinality in a cache with no eviction and no size limit. See
+	 * <code>docs/adr/2026-08-16-uncached-specialty-filtered-vet-reads.md</code>.
+	 * @param name the whole specialty name to match
+	 * @param pageable the page to retrieve
+	 * @return a <code>Page</code> of matching <code>Vet</code>s, each carrying every
+	 * specialty it holds
+	 */
+	@Transactional(readOnly = true)
+	Page<Vet> findDistinctBySpecialtiesNameIgnoreCase(String name, Pageable pageable) throws DataAccessException;
+
+	/**
+	 * Retrieve all <code>Vet</code>s holding the named specialty, matched as above and
+	 * uncached for the same reason.
+	 * @param name the whole specialty name to match
+	 * @return a <code>Collection</code> of matching <code>Vet</code>s, each carrying
+	 * every specialty it holds
+	 */
+	@Transactional(readOnly = true)
+	Collection<Vet> findDistinctBySpecialtiesNameIgnoreCase(String name) throws DataAccessException;
+
 }
